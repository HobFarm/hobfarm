# Hashed assets (Astro build fingerprints JS/CSS)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images on the site itself (not CDN, but any local images)
/*.png
  Cache-Control: public, max-age=86400
/*.jpg
  Cache-Control: public, max-age=86400
/*.jpeg
  Cache-Control: public, max-age=86400
/*.webp
  Cache-Control: public, max-age=86400
/*.avif
  Cache-Control: public, max-age=86400
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Search index: loaded only when the search modal opens
/search-index.json
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff

# Static aggregate API snapshots
/api/grimoire/snapshot
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff

# HTML pages: short cache, revalidate
/*
  Cache-Control: public, max-age=0, must-revalidate
  Link: </sitemap.xml>; rel="sitemap"; type="application/xml"
  Link: </llms.txt>; rel="alternate"; type="text/plain"; title="HobFarm agent index"
  Link: </.well-known/agent-skills/index.json>; rel="service-desc"; type="application/json"; title="HobFarm Agent Skills"
  Content-Signal: ai-train=no, search=yes, ai-input=yes
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob: https://hob.farm https://cdn.hob.farm https://upload.wikimedia.org https://tile.loc.gov; media-src 'self' https://cdn.hob.farm https://archive.org https://*.archive.org; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://challenges.cloudflare.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self'; connect-src 'self' https://grimoire.damp-violet-bf89.workers.dev https://challenges.cloudflare.com https://cloudflareinsights.com https://static.cloudflareinsights.com; frame-src https://challenges.cloudflare.com https://open.spotify.com https://www.youtube.com https://www.youtube-nocookie.com; form-action 'self'; manifest-src 'self'; upgrade-insecure-requests
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Agent Skill discovery
/.well-known/agent-skills/index.json
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff

/.well-known/agent-skills/*/SKILL.md
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400
  Content-Type: text/markdown; charset=utf-8
  X-Content-Type-Options: nosniff

# Protected or non-corpus paths
/api/*
  Cache-Control: no-store
  Pragma: no-cache
  Content-Signal: ai-train=no, search=no, ai-input=no
  X-Robots-Tag: noindex, nofollow

/.well-known/security.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
  X-Content-Type-Options: nosniff

/account*
  Content-Signal: ai-train=no, search=no, ai-input=no
  X-Robots-Tag: noindex, nofollow

/login*
  Content-Signal: ai-train=no, search=no, ai-input=no
  X-Robots-Tag: noindex, nofollow

# Prevent pages.dev from being indexed (keep hob.farm as canonical)
https://:project.pages.dev/*
  X-Robots-Tag: noindex
