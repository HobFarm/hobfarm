{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "order": {
      "type": "number"
    },
    "tier": {
      "type": "string",
      "enum": [
        "1",
        "2",
        "3"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "live",
        "active",
        "planned",
        "paused"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "tool",
        "content",
        "service",
        "collaboration",
        "game",
        "research",
        "education"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "tool",
        "game",
        "content",
        "service",
        "research",
        "education"
      ]
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "oneLiner": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "updatedDate": {
      "type": "string",
      "format": "date-time"
    },
    "liveUrl": {
      "type": "string"
    },
    "repoUrl": {
      "type": "string"
    },
    "heroVideo": {
      "type": "string"
    },
    "heroImage": {
      "type": "string"
    },
    "logo": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "alt"
      ],
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "alt"
      ],
      "additionalProperties": false
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "alt"
        ],
        "additionalProperties": false
      }
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "ctas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "external": {
            "type": "boolean"
          }
        },
        "required": [
          "label",
          "href"
        ],
        "additionalProperties": false
      }
    },
    "featuresTitle": {
      "type": "string"
    },
    "primaryCta": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "href"
      ],
      "additionalProperties": false
    },
    "secondaryCta": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "href"
      ],
      "additionalProperties": false
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "order",
    "tier",
    "status",
    "category",
    "title",
    "subtitle",
    "description",
    "pubDate"
  ],
  "additionalProperties": false
}