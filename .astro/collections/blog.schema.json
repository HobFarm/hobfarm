{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "author": {
      "default": "d00d",
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "technical",
        "magazine-time-machine",
        "cultural-thread",
        "grimoire",
        "stylefusion",
        "hobbot",
        "business",
        "research"
      ]
    },
    "hero": {
      "type": "string"
    },
    "heroAlt": {
      "type": "string"
    },
    "arrangement": {
      "type": "string"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "excerpt",
    "author",
    "tags",
    "publishedAt",
    "featured",
    "draft"
  ],
  "additionalProperties": false
}