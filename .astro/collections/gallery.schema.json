{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "fashion",
        "character-dev",
        "before-and-after",
        "cute-corrupted",
        "compilation",
        "scene",
        "asset-lab",
        "model-lab",
        "video-workflow",
        "premium-showcase"
      ]
    },
    "summary": {
      "type": "string"
    },
    "folder": {
      "type": "string"
    },
    "hero": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "image"
            },
            "file": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "file",
            "alt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "video"
            },
            "file": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            },
            "poster": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "file",
            "alt",
            "poster"
          ],
          "additionalProperties": false
        }
      ]
    },
    "heroAspect": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "thumb": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        }
      },
      "required": [
        "file",
        "alt"
      ],
      "additionalProperties": false
    },
    "media": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          },
          "file": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "reference",
              "variant",
              "failure",
              "preview",
              "process"
            ]
          },
          "provider": {
            "type": "string"
          },
          "poster": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "file"
        ],
        "additionalProperties": false
      }
    },
    "mediaSections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "media": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "image",
                    "video"
                  ]
                },
                "file": {
                  "type": "string"
                },
                "alt": {
                  "type": "string"
                },
                "caption": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "primary",
                    "reference",
                    "variant",
                    "failure",
                    "preview",
                    "process"
                  ]
                },
                "provider": {
                  "type": "string"
                },
                "poster": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "file"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "media"
        ],
        "additionalProperties": false
      }
    },
    "irFile": {
      "type": "string"
    },
    "infoModules": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "comparison": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "image",
            "text",
            "multimodal",
            "video"
          ]
        },
        "testedModels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "promptSummary": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failureModes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bestFor": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "processNotes": {
      "type": "string"
    },
    "externalLinks": {
      "type": "object",
      "properties": {
        "deviantArt": {
          "type": "string",
          "format": "uri"
        },
        "deviantArtPremium": {
          "type": "string",
          "format": "uri"
        },
        "kofi": {
          "type": "string",
          "format": "uri"
        },
        "patreon": {
          "type": "string",
          "format": "uri"
        },
        "course": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedProcess": {
      "type": "string"
    },
    "concept": {
      "type": "object",
      "properties": {
        "thesis": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "seedInputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "growthStages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reusablePattern": {
          "type": "string"
        },
        "usefulFor": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "fieldNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "visualDNA": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "workflowSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "win",
              "lesson",
              "fail"
            ]
          }
        },
        "required": [
          "label",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "lockedTraits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flexibleTraits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "specimenSheet": {
      "type": "object",
      "properties": {
        "specimenId": {
          "type": "string"
        },
        "subjectName": {
          "type": "string"
        },
        "subjectRole": {
          "type": "string"
        },
        "edition": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "creator": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "dropDate": {
          "type": "string",
          "format": "date-time"
        },
        "dimensions": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "colorChemistry": {
      "type": "object",
      "properties": {
        "palette": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "hex": {
                "type": "string"
              },
              "finish": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "hex"
            ],
            "additionalProperties": false
          }
        },
        "mood": {
          "type": "string"
        },
        "contrast": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "wardrobeGrammar": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "materials": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "item"
        ],
        "additionalProperties": false
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accessories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "styleProfile": {
      "type": "object",
      "properties": {
        "anchors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "arrangement": {
          "type": "string"
        },
        "register": {
          "type": "string"
        },
        "weight": {
          "type": "string"
        },
        "era": {
          "type": "string"
        },
        "hardness": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "type",
    "summary",
    "folder",
    "hero",
    "featured",
    "draft",
    "tags",
    "media",
    "infoModules"
  ],
  "additionalProperties": false
}