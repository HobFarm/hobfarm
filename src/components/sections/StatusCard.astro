---
// Card with a dot + uppercase mono status label, body, and action links.
// Canonical card pattern for the Workshop (/projects) and About pages. The
// status dot color is derived from `statusClass` (text-* -> bg-*), so a single
// class drives both. This is the one dot+label status style; do not add another.
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";

type Cta = { label: string; href: string; external?: boolean; variant?: "green" | "muted" };

interface Props {
  title: string;
  status: string;
  statusClass: string;
  body: string;
  ctas?: Cta[];
}

const { title, status, statusClass, body, ctas = [] } = Astro.props;
const dotClass = statusClass.replace("text-", "bg-");
---

<div class="flex flex-col p-6 lg:p-8 rounded-xl border border-base-800 bg-base-900/50 hover:border-accent-500/40 transition-colors duration-300">
  <div class="flex items-start justify-between gap-3 mb-3">
    <Text tag="h3" variant="textLG" class="text-white font-medium">
      {title}
    </Text>
    <div class="flex items-center gap-1.5 flex-shrink-0 mt-1">
      <div class:list={["w-1.5 h-1.5 rounded-full", dotClass]}></div>
      <span class:list={["text-[10px] font-mono tracking-wider uppercase whitespace-nowrap", statusClass]}>
        {status}
      </span>
    </div>
  </div>
  <Text tag="p" variant="textBase" class="text-base-400 leading-relaxed flex-1">
    {body}
  </Text>
  {ctas.length > 0 && (
    <div class="mt-6 flex flex-wrap items-center gap-3">
      {ctas.map((cta) =>
        cta.external ? (
          <Button isLink size="sm" variant={cta.variant ?? "muted"} href={cta.href} target="_blank" rel="noopener noreferrer">
            {cta.label}
          </Button>
        ) : (
          <Button isLink size="sm" variant={cta.variant ?? "muted"} href={cta.href}>
            {cta.label}
          </Button>
        )
      )}
    </div>
  )}
</div>
