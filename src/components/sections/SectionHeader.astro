---
// Numbered section header: small mono number + display heading + optional note
// + a hairline divider that fills the row. Extracted from the Workshop
// (/projects) page so About and future sections share one header pattern.
import Text from "@/components/fundations/elements/Text.astro";

interface Props {
  eyebrow: string;
  heading: string;
  note?: string;
}

const { eyebrow, heading, note } = Astro.props;
---

<div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-8">
  <Text tag="span" variant="textSM" class="text-base-500 font-mono">
    {eyebrow}
  </Text>
  <Text tag="h2" variant="displaySM" class="text-white font-display text-balance sm:whitespace-nowrap">
    {heading}
  </Text>
  {note && <span class="text-sm text-base-500 hidden sm:inline">{note}</span>}
  <div class="min-w-16 flex-1 h-px bg-base-800"></div>
</div>
