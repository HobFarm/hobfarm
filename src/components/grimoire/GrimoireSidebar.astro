---
// Grimoire Sidebar Navigation
// Category-grouped collapsible nav with active-state highlighting
import { getCollection } from "astro:content";

const allDocs = await getCollection("grimoire", ({ data }) => !data.draft);

// Group by category
const grouped = allDocs.reduce(
  (acc, doc) => {
    const cat = doc.data.category;
    if (!acc[cat]) acc[cat] = [];
    acc[cat].push({
      id: doc.id,
      title: doc.data.title,
      order: doc.data.order ?? 999,
    });
    return acc;
  },
  {} as Record<string, Array<{ id: string; title: string; order: number }>>
);

// Sort within categories
for (const cat of Object.keys(grouped)) {
  grouped[cat].sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));
}

// Category display config
const categoryMeta: Record<string, { label: string; order: number }> = {
  "getting-started": { label: "Getting Started", order: 1 },
  "guides": { label: "Guides", order: 2 },
  "reference": { label: "Reference", order: 3 },
  "examples": { label: "Examples", order: 4 },
  "recipes": { label: "Recipes", order: 5 },
};

const sortedCategories = Object.keys(grouped).sort((a, b) => {
  const orderA = categoryMeta[a]?.order ?? 999;
  const orderB = categoryMeta[b]?.order ?? 999;
  return orderA - orderB;
});

const currentPath = Astro.url.pathname;
---

<!-- Mobile sidebar toggle -->
<button
  id="grimoire-sidebar-toggle"
  class="fixed top-24 left-3 z-30 lg:hidden p-2 rounded-lg bg-base-800 text-base-300 hover:bg-base-700 transition-colors border border-base-700"
  aria-label="Toggle navigation"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M3 12h18M3 6h18M3 18h18" />
  </svg>
</button>

<!-- Mobile backdrop -->
<div
  id="grimoire-sidebar-backdrop"
  class="fixed inset-0 z-40 hidden bg-black/50 lg:hidden"
></div>

<!-- Sidebar -->
<aside
  id="grimoire-sidebar"
  class="fixed inset-y-0 left-0 z-50 w-72 bg-base-900 border-r border-base-700 transform -translate-x-full transition-transform duration-300 ease-in-out lg:translate-x-0 lg:sticky lg:top-20 lg:h-[calc(100svh-5rem)] overflow-y-auto"
>
  <div class="flex flex-col h-full">
    <!-- Header -->
    <div class="px-6 py-4 border-b border-base-700">
      <a href="/grimoire/" class="flex items-center gap-2 text-base-100 hover:text-accent-400 transition-colors">
        <span class="text-lg">&#x1F56F;</span>
        <span class="text-sm font-semibold tracking-wide uppercase font-sans">Grimoire</span>
      </a>
    </div>

    <!-- Nav links -->
    <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
      {sortedCategories.map((catKey) => {
        const meta = categoryMeta[catKey];
        const docs = grouped[catKey];
        const hasActive = docs.some(
          (doc) => currentPath === `/grimoire/${doc.id}` || currentPath === `/grimoire/${doc.id}/`
        );

        return (
          <div class="grimoire-accordion" data-open={hasActive ? "true" : "false"}>
            <button
              class={`w-full text-left px-4 py-2 text-xs font-medium rounded-md transition-colors duration-200 ${
                hasActive
                  ? "text-base-100 bg-base-800"
                  : "text-base-400 hover:text-base-200 hover:bg-base-800/50"
              }`}
              data-accordion-trigger
              aria-expanded={hasActive}
            >
              {meta?.label || catKey}
            </button>
            <div
              class="overflow-hidden transition-all duration-300 ease-in-out"
              style={hasActive ? "max-height: 500px; opacity: 1;" : "max-height: 0; opacity: 0;"}
              data-accordion-content
            >
              <div class="flex flex-col py-1">
                {docs.map((doc) => {
                  const href = `/grimoire/${doc.id}`;
                  const isActive = currentPath === href || currentPath === `${href}/`;
                  return (
                    <a
                      href={href}
                      class={`block px-4 ml-4 py-1.5 text-xs transition-colors duration-200 border-l ${
                        isActive
                          ? "border-l-accent-400 text-accent-400 font-medium"
                          : "border-l-base-700 text-base-400 hover:text-base-200 hover:border-l-base-500"
                      }`}
                    >
                      {doc.title}
                    </a>
                  );
                })}
              </div>
            </div>
          </div>
        );
      })}
    </nav>

    <!-- Back link -->
    <div class="px-6 py-4 border-t border-base-700">
      <a
        href="/"
        class="text-xs text-base-500 hover:text-base-300 transition-colors"
      >
        &larr; Back to hob.farm
      </a>
    </div>
  </div>
</aside>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Accordion behavior
    document.querySelectorAll("[data-accordion-trigger]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const section = trigger.closest(".grimoire-accordion");
        if (!section) return;
        const content = section.querySelector("[data-accordion-content]") as HTMLElement;
        if (!content) return;

        const isOpen = trigger.getAttribute("aria-expanded") === "true";

        if (isOpen) {
          content.style.maxHeight = "0";
          content.style.opacity = "0";
          trigger.setAttribute("aria-expanded", "false");
        } else {
          content.style.maxHeight = content.scrollHeight + "px";
          content.style.opacity = "1";
          trigger.setAttribute("aria-expanded", "true");
        }
      });
    });

    // Mobile toggle
    const toggle = document.getElementById("grimoire-sidebar-toggle");
    const sidebar = document.getElementById("grimoire-sidebar");
    const backdrop = document.getElementById("grimoire-sidebar-backdrop");

    if (toggle && sidebar && backdrop) {
      toggle.addEventListener("click", () => {
        sidebar.classList.toggle("-translate-x-full");
        backdrop.classList.toggle("hidden");
      });
      backdrop.addEventListener("click", () => {
        sidebar.classList.add("-translate-x-full");
        backdrop.classList.add("hidden");
      });
    }
  });
</script>
