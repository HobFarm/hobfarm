---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const blocks = [
  { tag: "D1",          name: "Structured storage",  note: "Atoms, composites, correspondences, run logs." },
  { tag: "R2",          name: "Reference assets",    note: "Source images and large binaries." },
  { tag: "KV",          name: "Hot state",           note: "Health, gates, lookups read on every request." },
  { tag: "Vectorize",   name: "Semantic index",      note: "Similarity search across atoms and chunks." },
  { tag: "Workers",     name: "Compute fabric",      note: "Edge-resident routes, classifiers, pipelines." },
  { tag: "Queues",      name: "Async work",          note: "Batched extraction, retagging, vectorization." },
  { tag: "AI Gateway",  name: "Provider routing",    note: "Multi-provider mediation with retries and caching." },
  { tag: "Surfaces",    name: "Downstream",          note: "StyleFusion, HobBot, hob.farm consume the substrate." },
];

const patterns = [
  {
    name: "Generate",
    note: "Substrate context shapes a prompt. The agent produces an output. The output is logged and linked back to its source atoms.",
  },
  {
    name: "Filter",
    note: "Existing references and atoms are matched against constraints. The substrate narrows the search space before any model runs.",
  },
  {
    name: "Control",
    note: "Composites and correspondences enforce identity, palette, and arrangement across providers. Same character everywhere.",
  },
  {
    name: "Replay",
    note: "Every run carries its inputs and schema version. A past output can be regenerated, audited, or compared on demand.",
  },
];
---

<section class="relative overflow-hidden border-t border-base-800/50">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/3 right-1/4 w-[420px] h-[420px] rounded-full bg-accent-500/5 blur-[150px]"></div>
  </div>

  <Wrapper variant="standard" class="relative z-10 py-20 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-16 items-start mb-12">
      <div class="lg:col-span-1">
        <Text tag="span" variant="textSM" class="text-accent-500 font-mono tracking-wider uppercase">
          System architecture
        </Text>
        <Text tag="h2" variant="displayLG" class="mt-6 text-white text-balance font-display">
          Edge-native substrate.
        </Text>
      </div>
      <div class="lg:col-span-2">
        <Text tag="p" variant="textBase" class="text-base-400 leading-relaxed text-pretty">
          Grimoire is built on a Cloudflare-native stack. Structured storage and indexes hold
          the durable parts of the system. Edge compute reads them on demand, routes through a
          provider gateway, and writes new runs back into the substrate. Downstream surfaces
          consume the same shape.
        </Text>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-16">
      {blocks.map((b) => (
        <div class="rounded-md border border-base-800 bg-base-900/60 p-5">
          <span class="inline-block text-[10px] font-mono text-accent-500 uppercase tracking-wider border border-accent-500/30 rounded px-1.5 py-0.5">
            {b.tag}
          </span>
          <p class="mt-3 text-sm text-white font-medium">{b.name}</p>
          <p class="mt-1 text-xs text-base-400 leading-relaxed">{b.note}</p>
        </div>
      ))}
    </div>

    <div class="flex items-center gap-4 mb-8">
      <Text tag="h3" variant="displayXS" class="text-white font-display whitespace-nowrap">
        Workflow patterns
      </Text>
      <div class="flex-1 h-px bg-base-800"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3">
      {patterns.map((p, i) => (
        <div class="rounded-md border border-base-800 bg-base-900/60 p-5">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-[10px] font-mono text-base-500 tracking-wider">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="text-xs font-mono text-spot-green uppercase tracking-wider">
              {p.name}
            </span>
          </div>
          <p class="text-xs text-base-400 leading-relaxed">{p.note}</p>
        </div>
      ))}
    </div>
  </Wrapper>
</section>
