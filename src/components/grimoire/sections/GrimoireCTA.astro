---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const ctas = [
  {
    eyebrow: "Build logs",
    title: "Read system notes",
    desc: "Changelog entries on substrate evolution and pipeline changes.",
    href: "/changelog/grimoire-knowledge-base",
  },
  {
    eyebrow: "Project page",
    title: "Grimoire overview",
    desc: "Architecture, goals, and current state of the project.",
    href: "/grimoire/",
  },
  {
    eyebrow: "Downstream",
    title: "Explore StyleFusion",
    desc: "Prompt compilation tool that consumes the substrate directly.",
    href: "/projects/stylefusion",
  },
  {
    eyebrow: "Direct line",
    title: "Contact HobFarm",
    desc: "For questions, research collaboration, or substrate access requests.",
    href: "/contact/",
  },
];
---

<section class="border-t border-base-800/50">
  <Wrapper variant="standard" class="py-20 lg:py-24">
    <div class="flex items-center gap-4 mb-10">
      <Text tag="h2" variant="displaySM" class="text-white font-display whitespace-nowrap">
        Follow the build
      </Text>
      <div class="flex-1 h-px bg-base-800"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {ctas.map((c) => (
        <a
          href={c.href}
          class="group block rounded-xl border border-base-800 bg-base-900/50 p-6 hover:border-accent-500/40 hover:bg-base-900 transition-colors"
        >
          <span class="text-[10px] font-mono text-accent-500 uppercase tracking-wider">
            {c.eyebrow}
          </span>
          <p class="mt-3 text-base text-white font-medium group-hover:text-accent-400 transition-colors">
            {c.title} <span aria-hidden="true" class="text-base-500 group-hover:text-accent-400">&rarr;</span>
          </p>
          <p class="mt-2 text-xs text-base-400 leading-relaxed">{c.desc}</p>
        </a>
      ))}
    </div>
  </Wrapper>
</section>
