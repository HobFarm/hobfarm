---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import { aboutHeroActions } from "@/data/about";
import type { MediaRecord } from "@/data/media-registry";
import { imageSrcset, transformImageUrl } from "@/lib/media-transforms";

interface Props {
  image: MediaRecord;
  caption: string;
  srcset?: string;
}

const { image, caption, srcset: suppliedSrcset } = Astro.props;
const imageSrc = transformImageUrl(image.src, { width: 1400, quality: 84, fit: "cover" });
const srcset =
  suppliedSrcset ??
  (image.src.startsWith("https://cdn.hob.farm/")
    ? imageSrcset(image.src, [640, 960, 1400], { quality: 84, fit: "cover" })
    : undefined);
---

<header class="about-hero" aria-labelledby="about-title">
  <Wrapper variant="standard" class="about-hero__inner">
    <div class="about-hero__copy">
      <p class="about-kicker">Kris Reynolds</p>
      <p class="about-role">Publisher / Digital media / Production systems</p>
      <h1 id="about-title">I build and run HobFarm.</h1>
      <p class="about-deck">
        HobFarm is an independent publication and working studio for research, web publishing,
        visual media, and production systems. It is where questions, source material, unfinished
        ideas, and practical production problems become articles, images, video, applications,
        and reusable workflows.
      </p>
      <div class="about-actions" aria-label="Primary About page links">
        {aboutHeroActions.map((action) => (
          <Button
            isLink
            size="sm"
            variant={action.primary ? "green" : "muted"}
            href={action.href}
            data-event={action.event}
            {...(action.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            {action.label}
          </Button>
        ))}
      </div>
      <p class="about-location">
        <span aria-hidden="true"></span>
        Las Vegas, Nevada
      </p>
    </div>

    <figure class="about-hero__figure">
      <div class="about-hero__image-frame">
        <img
          src={imageSrc}
          srcset={srcset}
          sizes="(min-width: 1024px) 48vw, 100vw"
          alt={image.alt}
          width={image.width ?? 1672}
          height={image.height ?? 941}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="about-hero__route" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </div>
      </div>
      <figcaption>{caption}</figcaption>
    </figure>
  </Wrapper>
</header>
