---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContactForm from "@/components/ContactForm";
import KofiCta from "@/components/KofiCta.astro";
---

<section id="contact" class="border-t border-base-800/50">
  <Wrapper variant="standard" class="py-20 lg:py-24">
    <Text tag="h2" variant="displaySM" class="text-white font-display">
      Get in Touch
    </Text>

    <div class="mt-4 space-y-1">
      <Text tag="p" variant="textBase" class="text-base-400 text-pretty leading-relaxed">
        Building something that needs AI coordination?
      </Text>
      <Text tag="p" variant="textBase" class="text-base-400 text-pretty leading-relaxed">
        Looking for a creative technologist?
      </Text>
      <Text tag="p" variant="textBase" class="text-base-400 text-pretty leading-relaxed">
        Just want to talk shop?
      </Text>
    </div>

    <div class="mt-8 max-w-xl border border-base-800 bg-base-900/40 p-5">
      <Text tag="h3" variant="textSM" class="text-white font-mono uppercase tracking-widest">
        Direct support and drops
      </Text>
      <Text tag="p" variant="textSM" class="mt-3 text-base-400 text-pretty leading-relaxed">
        Ko-fi is the direct support channel for HobFarm, including digital downloads, supporter extras, process files, and smaller releases that may later expand into full gallery pages or product lines.
      </Text>
      <div class="mt-4">
        <KofiCta variant="logo" />
      </div>
    </div>

    {/* Contact form */}
    <div class="mt-10 max-w-xl">
      <ContactForm client:load />
    </div>

    {/* Social links */}
    <div class="mt-12">
      <Text tag="p" variant="textSM" class="text-base-500 font-mono mb-4">
        Or find me elsewhere:
      </Text>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {/* Email */}
        <a
          href="/contact/"
          class="group flex items-center gap-4 p-5 rounded-xl border border-base-800 bg-base-900/50 hover:border-accent-500/40 hover:bg-base-900 transition-all duration-300"
        >
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-base-800 flex items-center justify-center group-hover:bg-accent-500/10 transition-colors duration-300">
            <svg class="w-5 h-5 text-accent-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
          </div>
          <div>
            <p class="text-sm text-white font-medium group-hover:text-accent-500 transition-colors duration-200">Email</p>
            <p class="text-xs text-base-500">Send a message</p>
          </div>
        </a>

        {/* GitHub */}
        <a
          href="https://github.com/HobFarm"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-4 p-5 rounded-xl border border-base-800 bg-base-900/50 hover:border-accent-500/40 hover:bg-base-900 transition-all duration-300"
        >
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-base-800 flex items-center justify-center group-hover:bg-accent-500/10 transition-colors duration-300">
            <svg class="w-5 h-5 text-accent-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
          </div>
          <div>
            <p class="text-sm text-white font-medium group-hover:text-accent-500 transition-colors duration-200">GitHub</p>
            <p class="text-xs text-base-500">HobFarm</p>
          </div>
        </a>

        {/* X / Twitter */}
        <a
          href="https://x.com/hobdotfarm"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-4 p-5 rounded-xl border border-base-800 bg-base-900/50 hover:border-accent-500/40 hover:bg-base-900 transition-all duration-300"
        >
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-base-800 flex items-center justify-center group-hover:bg-accent-500/10 transition-colors duration-300">
            <svg class="w-5 h-5 text-accent-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </div>
          <div>
            <p class="text-sm text-white font-medium group-hover:text-accent-500 transition-colors duration-200">X / Twitter</p>
            <p class="text-xs text-base-500">@hobdotfarm</p>
          </div>
        </a>

        {/* Etsy */}
        <a
          href="https://www.etsy.com/shop/hobfarm"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-4 p-5 rounded-xl border border-base-800 bg-base-900/50 hover:border-accent-500/40 hover:bg-base-900 transition-all duration-300"
        >
          <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-base-800 flex items-center justify-center group-hover:bg-accent-500/10 transition-colors duration-300">
            <svg class="w-5 h-5 text-accent-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8.559 2.445c0-.325.033-.52.59-.52h7.465c1.3 0 2.02 1.11 2.54 3.193l.42 1.666h1.27c.23-4.728.43-6.784.43-6.784s-3.196.36-5.09.36H6.635L1.521.196v1.37l1.725.326c1.21.24 1.5.496 1.6 1.606 0 0 .11 3.27.11 8.64 0 5.385-.09 8.61-.09 8.61 0 .973-.39 1.333-1.59 1.573l-1.722.33V24l5.13-.165h8.55c1.935 0 6.39.165 6.39.165.105-1.17.75-6.48.855-7.064h-1.2l-1.284 2.91c-1.005 2.28-2.476 2.445-4.11 2.445h-4.906c-1.63 0-2.415-.64-2.415-2.05V12.8s3.62 0 4.79.096c.912.064 1.463.325 1.76 1.598l.39 1.695h1.41l-.09-4.278.192-4.305h-1.391l-.45 1.89c-.283 1.244-.48 1.47-1.754 1.6-1.666.17-4.815.14-4.815.14V2.45h-.05z" />
            </svg>
          </div>
          <div>
            <p class="text-sm text-white font-medium group-hover:text-accent-500 transition-colors duration-200">Etsy</p>
            <p class="text-xs text-base-500">Shop</p>
          </div>
        </a>
      </div>
    </div>
  </Wrapper>
</section>
