---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import SectionHeader from "@/components/sections/SectionHeader.astro";

type Lane = {
  num: string;
  title: string;
  body: string;
  cta: { label: string; href: string };
};

const lanes: Lane[] = [
  {
    num: "01",
    title: "Creative Services",
    body: "Creative and technical support for projects that need structure, direction, and execution: visual direction, character concepts, content planning, AI-assisted production workflows, website and page planning, research systems, media strategy, writing, prompts, image and video pipelines, and practical project organization. The focus is making rough ideas clearer, stronger, and easier to build.",
    cta: { label: "Hire HobFarm", href: "/contact/" },
  },
  {
    num: "02",
    title: "Projects",
    body: "Original projects across media, design, research, and entertainment. Current and developing areas include character worlds, visual style systems, HobFarm TV, film-history formats, gallery collections, research tools, digital experiments, and recurring series like 3 Degrees of Dick Miller. Projects can become videos, articles, digital products, artwork, collections, prompts, tools, or physical releases.",
    cta: { label: "See the projects", href: "/projects" },
  },
  {
    num: "03",
    title: "Products",
    body: "Both original and found products. Original products may include character designs, digital downloads, art packs, prints, POD items, creative assets, and limited releases. Found products may include DVDs, media, collectibles, electronics, tools, auction lots, vintage objects, and gear. The inventory is not fixed because the sourcing is not fixed: auction finds, estate lots, and one-off items are part of the model.",
    cta: { label: "Visit the shop", href: "/shop/" },
  },
];
---

<section class="border-t border-base-800/50">
  <Wrapper variant="standard" class="py-20 lg:py-24">
    <SectionHeader eyebrow="What HobFarm does" heading="Services, projects, and products" note="One brand, several lines of work." />

    <Text tag="p" variant="textBase" class="text-base-400 max-w-2xl mb-12 text-pretty leading-relaxed">
      HobFarm is not one narrow category. It is a working system for making, finding, testing, selling, and documenting things. The three lines of work feed each other.
    </Text>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {lanes.map((lane) => (
        <div class="flex flex-col p-6 lg:p-8 rounded-xl border border-base-800 bg-base-900/50">
          <span class="text-[10px] font-mono uppercase tracking-wider text-base-500 mb-3">
            {lane.num}
          </span>
          <Text tag="h3" variant="textXL" class="text-white font-medium mb-4">
            {lane.title}
          </Text>
          <Text tag="p" variant="textBase" class="text-base-400 leading-relaxed flex-1">
            {lane.body}
          </Text>
          <a
            href={lane.cta.href}
            class="mt-6 inline-flex items-center gap-2 text-sm font-mono text-accent-violet-bright hover:text-white transition-colors duration-200"
          >
            <span>{lane.cta.label}</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      ))}
    </div>

    <Text tag="p" variant="textBase" class="text-base-400 max-w-3xl mt-12 text-pretty leading-relaxed">
      Creative services keep the project practical. Original projects keep it interesting. Products and resale keep it moving. Media turns the process into something people can follow.
    </Text>
  </Wrapper>
</section>
