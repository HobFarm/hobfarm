---
interface Lesson {
  label: string;
  text: string;
  kind?: "win" | "lesson" | "fail";
}

interface Props {
  lessons: Lesson[];
}

const { lessons } = Astro.props;

const iconTone: Record<"win" | "lesson" | "fail", string> = {
  win: "text-green-400 border-green-700/40 bg-green-700/10",
  lesson: "text-accent-400 border-accent-500/40 bg-accent-500/10",
  fail: "text-red-400 border-red-700/40 bg-red-700/10",
};

const labelTone: Record<"win" | "lesson" | "fail", string> = {
  win: "text-green-300",
  lesson: "text-accent-300",
  fail: "text-red-300",
};
---

{lessons.length > 0 && (
  <section class="border-t border-base-800 pt-8">
    <h2 class="text-base-500 font-mono uppercase tracking-wider text-xs mb-6">Lessons</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {lessons.map((lesson) => {
        const kind = lesson.kind ?? "lesson";
        return (
          <div class:list={["border p-4 flex gap-3 items-start", iconTone[kind]]}>
            <span class="flex-shrink-0 mt-0.5" aria-hidden="true">
              {kind === "win" && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              )}
              {kind === "fail" && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 6 6 18M6 6l12 12" />
                </svg>
              )}
              {kind === "lesson" && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              )}
            </span>
            <div class="flex-1">
              <h3 class:list={["text-[10px] font-mono uppercase tracking-wider mb-1", labelTone[kind]]}>
                {lesson.label}
              </h3>
              <p class="text-sm text-base-200 leading-relaxed">{lesson.text}</p>
            </div>
          </div>
        );
      })}
    </div>
  </section>
)}
