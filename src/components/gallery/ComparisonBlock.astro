---
interface Comparison {
  mode?: "image" | "text" | "multimodal" | "video";
  testedModels?: string[];
  promptSummary?: string;
  findings?: string[];
  failureModes?: string[];
  bestFor?: string[];
}

interface Props {
  comparison: Comparison;
}

const { comparison } = Astro.props;

const modeLabel = comparison.mode
  ? comparison.mode.charAt(0).toUpperCase() + comparison.mode.slice(1)
  : null;
---

<section class="border border-base-800 bg-base-950/40 p-6 lg:p-8">
  <header class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <h3 class="text-base-500 font-mono uppercase tracking-wider text-xs">
      Model Field Test
    </h3>
    {modeLabel && (
      <span class="inline-flex items-center px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider rounded-full border border-blue-700/40 text-blue-300 bg-blue-700/10">
        {modeLabel}
      </span>
    )}
  </header>

  {comparison.testedModels && comparison.testedModels.length > 0 && (
    <div class="mb-6">
      <h4 class="text-xs font-mono uppercase tracking-wider text-base-500 mb-2">Tested</h4>
      <div class="flex flex-wrap gap-2">
        {comparison.testedModels.map((m) => (
          <span class="px-2 py-1 text-xs font-mono text-white bg-base-900 border border-base-700">
            {m}
          </span>
        ))}
      </div>
    </div>
  )}

  {comparison.promptSummary && (
    <div class="mb-6">
      <h4 class="text-xs font-mono uppercase tracking-wider text-base-500 mb-2">Prompt</h4>
      <p class="text-sm text-base-300 leading-relaxed">{comparison.promptSummary}</p>
    </div>
  )}

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {comparison.findings && comparison.findings.length > 0 && (
      <div>
        <h4 class="text-xs font-mono uppercase tracking-wider text-accent-500 mb-2">Findings</h4>
        <ul class="space-y-1.5">
          {comparison.findings.map((f) => (
            <li class="text-sm text-base-300 flex gap-2">
              <span class="text-accent-500 mt-0.5">→</span>
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {comparison.failureModes && comparison.failureModes.length > 0 && (
      <div>
        <h4 class="text-xs font-mono uppercase tracking-wider text-red-400 mb-2">Failure Modes</h4>
        <ul class="space-y-1.5">
          {comparison.failureModes.map((f) => (
            <li class="text-sm text-base-300 flex gap-2">
              <span class="text-red-400 mt-0.5">×</span>
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {comparison.bestFor && comparison.bestFor.length > 0 && (
      <div>
        <h4 class="text-xs font-mono uppercase tracking-wider text-green-400 mb-2">Best For</h4>
        <ul class="space-y-1.5">
          {comparison.bestFor.map((b) => (
            <li class="text-sm text-base-300 flex gap-2">
              <span class="text-green-400 mt-0.5">✓</span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
