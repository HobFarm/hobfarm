---
interface Step {
  label: string;
  text: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

{steps.length > 0 && (
  <section>
    <h2 class="text-base-500 font-mono uppercase tracking-wider text-xs mb-6">How it's made</h2>
    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      {steps.map((step, i) => (
        <li class="relative bg-base-900 border border-base-800 p-4 flex flex-col gap-2">
          <span class="absolute -top-2 left-3 px-1.5 py-0.5 text-[9px] font-mono text-base-950 bg-accent-500 rounded">
            {String(i + 1).padStart(2, "0")}
          </span>
          <h3 class="text-xs font-mono uppercase tracking-wider text-accent-300">{step.label}</h3>
          <p class="text-sm text-base-300 leading-relaxed">{step.text}</p>
          {i < steps.length - 1 && (
            <span class="hidden lg:flex absolute -right-3 top-1/2 -translate-y-1/2 w-6 h-6 items-center justify-center text-accent-500" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
          )}
        </li>
      ))}
    </ol>
  </section>
)}
