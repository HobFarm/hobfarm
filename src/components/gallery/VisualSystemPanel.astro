---
interface DnaItem {
  label: string;
  value: string;
}

interface Props {
  visualDNA?: DnaItem[];
  locked?: string[];
  flexible?: string[];
}

const { visualDNA = [], locked = [], flexible = [] } = Astro.props;
const hasVisualDNA = visualDNA.length > 0;
const hasLocked = locked.length > 0;
const hasFlexible = flexible.length > 0;
const hasTraits = hasLocked || hasFlexible;
---

{(hasVisualDNA || hasTraits) && (
  <section class="overflow-hidden border border-base-800 bg-base-950/50">
    <div class="border-b border-base-800 bg-base-900/35 px-5 py-4 lg:px-6">
      <h3 class="font-mono text-xs uppercase tracking-wider text-base-400">Visual System</h3>
    </div>

    <div class:list={[
      "grid",
      hasVisualDNA && hasTraits ? "lg:grid-cols-[minmax(0,1.1fr)_minmax(22rem,0.9fr)]" : "lg:grid-cols-1",
    ]}>
      {hasVisualDNA && (
        <div class="p-5 lg:p-6">
          <div class="flex items-center gap-2">
            <span class="h-px w-6 bg-accent-cyan/70" aria-hidden="true"></span>
            <h4 class="font-mono text-[10px] uppercase tracking-widest text-accent-cyan">
              Visual DNA
            </h4>
          </div>
          <dl class="mt-4 grid gap-x-5 sm:grid-cols-2">
            {visualDNA.map((item) => (
              <div class="border-t border-base-800/80 py-3">
                <dt class="font-mono text-[10px] uppercase tracking-wider text-base-500">
                  {item.label}
                </dt>
                <dd class="mt-1 text-sm leading-snug text-base-100">{item.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )}

      {hasTraits && (
        <div class:list={[
          "border-t border-base-800 bg-base-950/45 p-5 lg:p-6",
          hasVisualDNA && "lg:border-l lg:border-t-0",
        ]}>
          <div class="flex items-center gap-2">
            <span class="h-px w-6 bg-accent-magenta/70" aria-hidden="true"></span>
            <h4 class="font-mono text-[10px] uppercase tracking-widest text-accent-magenta-bright">
              Trait Lock
            </h4>
          </div>

          <div class="mt-4 grid gap-5">
            {hasLocked && (
              <div>
                <p class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-wider text-accent-magenta-bright">
                  <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                  </svg>
                  Locked
                </p>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {locked.map((trait) => (
                    <li class="rounded-full border border-accent-magenta/35 bg-accent-magenta/10 px-2.5 py-1 font-mono text-[11px] leading-tight text-accent-magenta-bright">
                      {trait}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {hasFlexible && (
              <div>
                <p class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-wider text-accent-cyan-bright">
                  <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 9.9-1" />
                  </svg>
                  Flexible
                </p>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {flexible.map((trait) => (
                    <li class="rounded-full border border-accent-cyan/35 bg-accent-cyan/10 px-2.5 py-1 font-mono text-[11px] leading-tight text-accent-cyan-bright">
                      {trait}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  </section>
)}
