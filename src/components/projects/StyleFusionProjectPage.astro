---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Breadcrumbs from "@/components/global/Breadcrumbs.astro";
import { getMedia } from "@/data/media-registry";

interface Props {
  project: CollectionEntry<"workshop">;
}

const { project } = Astro.props;

const hero = getMedia("stylefusion.current.psychedelic.hero");
const variants = [
  {
    media: getMedia("stylefusion.current.psychedelic.variant-a"),
    label: "Grok variation A",
    caption: "The trailer, black silhouette, high viewpoint, and psychedelic surface language all stay in the frame.",
  },
  {
    media: getMedia("stylefusion.current.psychedelic.variant-b"),
    label: "Grok variation B",
    caption: "A tighter interpretation keeps the same subject, setting, palette pressure, and fisheye camera logic.",
  },
];
const motionStudies = [
  {
    media: getMedia("stylefusion.current.psychedelic.motion-a"),
    label: "Motion pass A",
    caption: "The photographic lane moves through changing pose and camera distance.",
  },
  {
    media: getMedia("stylefusion.current.psychedelic.motion-b"),
    label: "Motion pass B",
    caption: "The psychedelic lane extends the same world into motion.",
  },
];
const moduleRevision = {
  grok: getMedia("stylefusion.current.psychedelic.full-body.grok"),
  chatgpt: getMedia("stylefusion.current.psychedelic.full-body.chatgpt"),
  motion: getMedia("stylefusion.current.psychedelic.full-body.motion"),
};
const poseTransfer = {
  subjectA: [
    { media: getMedia("stylefusion.current.pose-transfer.subject-a.chatgpt"), label: "ChatGPT" },
    { media: getMedia("stylefusion.current.pose-transfer.subject-a.grok"), label: "Grok" },
  ],
  subjectB: [
    { media: getMedia("stylefusion.current.pose-transfer.subject-b.chatgpt"), label: "ChatGPT" },
    { media: getMedia("stylefusion.current.pose-transfer.subject-b.grok"), label: "Grok" },
  ],
};
const modularLoop = getMedia("stylefusion.current.modular-loop");
const recentSets = [
  {
    media: getMedia("stylefusion.current.flame"),
    title: "Flame Character",
    stats: "3 references · 5 modules · 3,832-character handoff",
    caption: "A molten character, black volcanic armor, and burned desert architecture arrive as one directed scene.",
  },
  {
    media: getMedia("stylefusion.current.fire-dancer"),
    title: "Purple Fire Dancer",
    stats: "3 references · 5 modules · 2,920-character handoff",
    caption: "The pose module carries the two opposite fire anchors while style and environment do their own jobs.",
  },
];
const providerComparisons = [
  { media: getMedia("stylefusion.current.portrait.grok"), label: "Grok" },
  { media: getMedia("stylefusion.current.portrait.gemini"), label: "Gemini" },
  { media: getMedia("stylefusion.current.portrait.qwen-pro"), label: "Qwen Image Pro" },
  { media: getMedia("stylefusion.current.portrait.flux-max"), label: "FLUX Max" },
  { media: getMedia("stylefusion.current.portrait.seedream"), label: "Seedream" },
];

const roles = [
  {
    number: "01",
    title: "Subject",
    body: "Who or what belongs in the picture: identity, design, clothing, objects, and any visible pose or placement worth preserving.",
  },
  {
    number: "02",
    title: "Style",
    body: "How the picture should be rendered: palette, line, surface, material, lighting treatment, and visual rhythm.",
  },
  {
    number: "03",
    title: "Composition",
    body: "Where the picture happens and how we see it: environment, shot, framing, lens behavior, scale, and camera position.",
  },
];

const workflow = [
  ["Add", "one to six references"],
  ["Assign", "a simple job to each"],
  ["Build", "the modular pack"],
  ["Inspect", "the assembled prompt"],
  ["Choose", "an image model"],
  ["Make", "the picture"],
];

const packFiles = [
  ["assembly.json", "composition and module bindings"],
  ["subject.json", "identity, design, clothing, objects"],
  ["pose.json / placement.json", "body action or object position, when useful"],
  ["style.json", "rendering, palette, surface, light"],
  ["environment.json", "setting and spatial facts"],
  ["shot.json", "framing, viewpoint, lens behavior"],
  ["prompt.txt", "the exact positive prose sent downstream"],
];

const faqs = [
  {
    question: "Is StyleFusion a negative-prompt tool?",
    answer: "No. The pack records what the picture should contain and how those parts should relate. It does not build its direction from a list of unwanted nouns.",
  },
  {
    question: "Does the image generator receive my reference images?",
    answer: "In the current workflow, the references build the pack. The selected image model receives the completed stored prose prompt, not the original reference pixels.",
  },
  {
    question: "Is one image model part of the schema?",
    answer: "No. The StyleFusion pack is the canonical visual record. The generator is a downstream choice, which makes same-pack comparisons possible.",
  },
  {
    question: "Can I download the result?",
    answer: "Yes. A project can be downloaded as a .stylefusion.zip pack containing its assembly, useful modules, manifest, and prompt.",
  },
  {
    question: "Can I use the output commercially?",
    answer: "That depends on your rights to the references and the terms of the model you choose. StyleFusion structures the work; it does not replace licenses or copyright obligations.",
  },
];

const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const pageUrl = `${siteOrigin}/workshop/stylefusion/`;
const appUrl = "https://sf.hob.farm/";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": `${pageUrl}#application`,
      name: "StyleFusion",
      applicationCategory: "MultimediaApplication",
      operatingSystem: "Web",
      url: appUrl,
      description: project.data.description,
      image: hero.src,
      creator: {
        "@type": "Organization",
        "@id": `${siteOrigin}/#organization`,
        name: "HobFarm",
        url: `${siteOrigin}/`,
      },
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      name: "StyleFusion",
      url: pageUrl,
      mainEntity: { "@id": `${pageUrl}#application` },
    },
    {
      "@type": "CreativeWork",
      "@id": `${pageUrl}#untitled-blend-study`,
      name: "Untitled blend StyleFusion study",
      description: "A three-reference StyleFusion pack demonstrated through finished stills, targeted module revision, pose transfer between subjects, provider variations, and motion passes.",
      image: [
        hero.src,
        ...variants.map(({ media }) => media.src),
        moduleRevision.grok.src,
        moduleRevision.chatgpt.src,
        ...poseTransfer.subjectA.map(({ media }) => media.src),
        ...poseTransfer.subjectB.map(({ media }) => media.src),
      ],
      video: modularLoop.src,
      isPartOf: { "@id": `${pageUrl}#application` },
      creator: { "@id": `${siteOrigin}/#organization` },
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title="StyleFusion | Build reusable visual direction from reference images"
  description={project.data.description}
  canonical="/workshop/stylefusion/"
  image={hero.src}
  palette="magenta-cyan"
  structuredData={structuredData}
>
  <div class="stylefusion-page bg-noise overflow-hidden">
    <section class="hero-shell">
      <Wrapper variant="standard" class="relative py-8 sm:py-12 lg:py-16">
        <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Workshop", href: "/workshop/" }, { label: "StyleFusion" }]} />

        <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,.92fr)_minmax(28rem,1.08fr)] lg:items-center">
          <div class="relative z-10 max-w-3xl">
            <p class="eyebrow">Working application · pack-native workflow</p>
            <h1 class="mt-4 font-display text-5xl leading-[.94] text-white sm:text-6xl lg:text-7xl">
              Give every reference one job.
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-base-200 sm:text-xl">
              StyleFusion turns a small set of images into a reusable visual pack, assembles the useful parts into clear positive prose, and hands that same direction to whichever image model fits the job.
            </p>
            <p class="mt-5 max-w-2xl text-base leading-7 text-base-400">
              The concept is deliberately simple: decide which image supplies the subject, which supplies the style, and which supplies the composition. StyleFusion does the structural work between those decisions and the final prompt.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              <Button isLink size="lg" variant="green" href={appUrl} target="_blank" rel="noopener noreferrer">
                Open StyleFusion
              </Button>
              <Button isLink size="lg" variant="muted" href="#latest-study">
                See the latest set
              </Button>
              <Button isLink size="lg" variant="link" href="/articles/gary-and-the-fork/" class="px-2 text-base-300 hover:text-white">
                Why I stopped naming the failure →
              </Button>
            </div>
          </div>

          <figure class="hero-figure">
            <img
              src={hero.src}
              alt={hero.alt}
              width={hero.width}
              height={hero.height}
              loading="eager"
              fetchpriority="high"
            />
            <figcaption>
              <span>Untitled blend · recovered current pack</span>
              <strong>3 references → 5 useful modules → 1 positive handoff</strong>
            </figcaption>
          </figure>
        </div>
      </Wrapper>
    </section>

    <section class="section-block" aria-labelledby="simple-heading">
      <Wrapper variant="standard">
        <div class="section-intro">
          <p class="eyebrow">The simple part is the point</p>
          <h2 id="simple-heading">Three jobs are enough to start.</h2>
          <p>
            A reference can carry one role or combine roles. The labels are ordinary on purpose. They tell the builder what evidence belongs to the subject, what belongs to the rendering, and what belongs to the camera and world around it.
          </p>
        </div>
        <div class="mt-8 grid gap-4 lg:grid-cols-3">
          {roles.map((role) => (
            <article class="role-card">
              <span>{role.number}</span>
              <h3>{role.title}</h3>
              <p>{role.body}</p>
            </article>
          ))}
        </div>

        <ol class="workflow-strip" aria-label="StyleFusion workflow">
          {workflow.map(([verb, detail], index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{verb}</strong>
              <p>{detail}</p>
            </li>
          ))}
        </ol>
      </Wrapper>
    </section>

    <section class="section-block pt-0" aria-labelledby="pack-heading">
      <Wrapper variant="standard">
        <div class="pack-panel">
          <div class="section-intro">
            <p class="eyebrow">What the files actually do</p>
            <h2 id="pack-heading">A small pack keeps the visual decisions separate.</h2>
            <p>
              The <code>.stylefusion.zip</code> file is the reusable source of truth. It emits only the modules a project needs, then an assembly file says how they belong together. The model-authored prompt is derived from that pack and stored beside it.
            </p>
            <p class="mt-4 text-sm text-base-500">
              This public view shows the shape of the method, not the full module fields or the private working recipe inside the supplied pack.
            </p>
          </div>
          <div class="file-stack" aria-label="Example StyleFusion pack contents">
            <div class="zip-label"><span>.stylefusion.zip</span><small>portable project pack</small></div>
            {packFiles.map(([file, purpose]) => (
              <div class="file-row">
                <code>{file}</code>
                <span>{purpose}</span>
              </div>
            ))}
          </div>
        </div>
      </Wrapper>
    </section>

    <section class="section-block direction-section" aria-labelledby="direction-heading">
      <Wrapper variant="standard">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,.9fr)_minmax(24rem,1.1fr)] lg:items-start">
          <div class="section-intro">
            <p class="eyebrow">Positive direction</p>
            <h2 id="direction-heading">Describe the picture you want in the room.</h2>
            <p>
              I stopped putting bans in the source file. Every forbidden noun is still another noun in the context. If I do not want a fork, repeating “fork” keeps the fork in the room.
            </p>
            <p class="mt-4">
              StyleFusion records the replacement instead: what the hands are doing, what is on the table, where the camera sits, what materials catch the light. The pack gives the model a scene to build rather than a failure to rehearse.
            </p>
            <a class="text-link" href="/articles/gary-and-the-fork/">Read Gary and the Fork →</a>
          </div>
          <div class="direction-cards">
            <div class="direction-card dimmed">
              <span>A negative list keeps naming the failure</span>
              <p>no fork · no silverware · no utensil · do not hold a fork</p>
            </div>
            <div class="direction-arrow" aria-hidden="true">↓</div>
            <div class="direction-card positive">
              <span>The pack names the intended scene</span>
              <p>hands relaxed and visible · empty tabletop · ceramic cup at frame left · attention directed toward the open book</p>
            </div>
          </div>
        </div>
      </Wrapper>
    </section>

    <section id="latest-study" class="section-block" aria-labelledby="latest-heading">
      <Wrapper variant="standard">
        <div class="section-intro max-w-4xl">
          <p class="eyebrow">Latest recovered set · September 2026</p>
          <h2 id="latest-heading">Three references. One coherent world.</h2>
          <p>
            “Untitled blend” assigns one reference to subject and pose, one to style, and one to environment and shot. The builder emits five useful modules plus assembly, then translates the pack into a 3,382-character positive prompt. The images below are finished interpretations—not a disclosure of the source files inside the pack.
          </p>
        </div>

        <div class="study-stats" aria-label="Untitled blend pack statistics">
          <div><strong>3</strong><span>reference jobs</span></div>
          <div><strong>5</strong><span>useful modules</span></div>
          <div><strong>3,382</strong><span>prompt characters</span></div>
          <div><strong>2</strong><span>motion passes</span></div>
        </div>

        <div class="lead-gallery">
          <figure class="lead-selected">
            <img src={hero.src} alt={hero.alt} width={hero.width} height={hero.height} loading="lazy" />
            <figcaption><strong>Selected still</strong><span>High fisheye viewpoint, painted trailer, black silhouette, and desert debris remain legible together.</span></figcaption>
          </figure>
          <div class="lead-variants">
            {variants.map(({ media, label, caption }) => (
              <figure>
                <img src={media.src} alt={media.alt} width={media.width} height={media.height} loading="lazy" />
                <figcaption><strong>{label}</strong><span>{caption}</span></figcaption>
              </figure>
            ))}
          </div>
        </div>

        <div class="mt-12">
          <div class="section-intro max-w-3xl">
            <p class="eyebrow">From still pack to moving scene</p>
            <h3 class="text-3xl text-white sm:text-4xl">The visual direction survives the next step.</h3>
          </div>
          <div class="motion-grid">
            {motionStudies.map(({ media, label, caption }) => (
              <figure>
                <video controls muted playsinline preload="metadata" poster={media.poster} aria-label={media.alt}>
                  <source src={media.src} type="video/mp4" />
                </video>
                <figcaption><strong>{label}</strong><span>{caption}</span></figcaption>
              </figure>
            ))}
          </div>
        </div>
      </Wrapper>
    </section>

    <section class="section-block module-revision-section" aria-labelledby="module-revision-heading">
      <Wrapper variant="standard">
        <div class="module-revision-heading">
          <div class="section-intro max-w-4xl">
            <p class="eyebrow">Targeted module rewrite · current build study</p>
            <h2 id="module-revision-heading">The reference stopped at the waist. I changed the part that decided what happened next.</h2>
            <p>
              The source portrait supplied identity, hair, jewelry, clothing, and a strong crop. It did not supply lower-body evidence, and the first interpretations kept ending the figure with it. That failure led me to separate observed reference coverage from the coverage I want in the finished image.
            </p>
            <p class="mt-4">
              The new local build records what the source actually shows, lets Shot request a full figure, then gives Subject and Pose the geometry, clothing, support, and contacts needed to complete the missing regions. Body direction, head return, gaze, expression, crop, and frame position no longer have to fight over the same sentence.
            </p>
          </div>
          <p class="development-badge"><span aria-hidden="true"></span>Deploying update</p>
        </div>

        <div class="module-map" aria-label="What stayed fixed and what changed in the full-body test">
          <article>
            <small>Kept</small>
            <h3>Identity + world</h3>
            <p>Black hair, sunglasses, jewelry, dark clothing, the painted trailer, psychedelic surface language, and hard daylight.</p>
          </article>
          <article class="changed">
            <small>Rewritten</small>
            <h3>Pose + shot</h3>
            <p>A complete standing figure, both feet grounded on the ramp, and a steep 10–14mm-equivalent overhead fisheye view.</p>
          </article>
          <article>
            <small>Result</small>
            <h3>A new assembly</h3>
            <p>The recognizable world survives, but the model now has explicit positive direction for everything below the portrait crop.</p>
          </article>
        </div>

        <blockquote class="prompt-excerpt">
          <span>Public prompt excerpt</span>
          <p>“Treat the source portrait as reference for her identity … not as a crop boundary.”</p>
        </blockquote>

        <div class="study-stats revision-stats" aria-label="Full-body module revision study statistics">
          <div><strong>1</strong><span>targeted rewrite</span></div>
          <div><strong>2</strong><span>image models</span></div>
          <div><strong>3×</strong><span>video extensions</span></div>
          <div><strong>18s</strong><span>moving scene</span></div>
        </div>

        <div class="revision-stills">
          <figure>
            <img src={moduleRevision.grok.src} alt={moduleRevision.grok.alt} width={moduleRevision.grok.width} height={moduleRevision.grok.height} loading="lazy" />
            <figcaption>
              <strong>Grok · full-body interpretation</strong>
              <span>The complete figure holds the ramp geometry while the psychedelic environment pushes harder around the frame.</span>
            </figcaption>
          </figure>
          <figure>
            <img src={moduleRevision.chatgpt.src} alt={moduleRevision.chatgpt.alt} width={moduleRevision.chatgpt.width} height={moduleRevision.chatgpt.height} loading="lazy" />
            <figcaption>
              <strong>ChatGPT · same rewritten prompt</strong>
              <span>The same direction lands in a more photographic lane, with the full stance, overhead camera, trailer, and color system still intact.</span>
            </figcaption>
          </figure>
        </div>

        <div class="revision-motion">
          <div class="section-intro">
            <p class="eyebrow">From correction to continuation</p>
            <h3>The resolved body gave the video somewhere to go.</h3>
            <p>
              The Grok still became a six-second shot, then I extended it three times to eighteen seconds. She turns, crosses the porch, and reaches the trailer doorway. The useful result is not only that the legs appeared; the body and location were coherent enough to support a longer action.
            </p>
            <p class="experiment-note">
              This experiment led directly to the new scene-structure controls. They are implemented and tested locally; the application deployment is in progress.
            </p>
          </div>
          <figure>
            <video controls muted playsinline preload="metadata" poster={moduleRevision.motion.poster} aria-label={moduleRevision.motion.alt}>
              <source src={moduleRevision.motion.src} type="video/mp4" />
            </video>
            <figcaption>
              <strong>Grok · 18-second extended motion study</strong>
              <span>One generated still, followed through three extensions from the original six-second shot.</span>
            </figcaption>
          </figure>
        </div>

        <div class="pose-transfer-study">
          <div class="section-intro max-w-4xl">
            <p class="eyebrow">Pose as a reusable element</p>
            <h3>One pose. Two subjects. Four interpretations.</h3>
            <p>
              I took the character from the portrait comparison and applied the structured kneeling pose. Then I replaced the Subject with a completely different creature while keeping the Pose: knees and shins as primary support, low hips, a forward torso, and both palms as a light brace.
            </p>
            <p class="mt-4">
              The images are not supposed to match pixel for pixel. The reusable part is the relationship. StyleFusion can build that structure from reference images, and the Build controls let me change coverage, body direction, head position, gaze, expression, or frame placement without rewriting the unrelated parts of the scene.
            </p>
          </div>

          <div class="transfer-routes" aria-label="The same pose transferred between two subjects">
            <div><small>Subject A</small><strong>Portrait character</strong></div>
            <b aria-hidden="true">+</b>
            <div class="shared"><small>Shared module</small><strong>Hands-braced kneel</strong></div>
            <b aria-hidden="true">→</b>
            <div><small>Outputs</small><strong>ChatGPT + Grok</strong></div>
            <div><small>Subject B</small><strong>Lattice creature</strong></div>
            <b aria-hidden="true">+</b>
            <div class="shared"><small>Same module</small><strong>Hands-braced kneel</strong></div>
            <b aria-hidden="true">→</b>
            <div><small>Outputs</small><strong>ChatGPT + Grok</strong></div>
          </div>

          <div class="pose-transfer-groups">
            <section aria-labelledby="subject-a-heading">
              <div class="pose-group-heading">
                <small>Subject A</small>
                <h4 id="subject-a-heading">The portrait character takes the pose.</h4>
              </div>
              <div class="pose-pair">
                {poseTransfer.subjectA.map(({ media, label }) => (
                  <figure>
                    <img src={media.src} alt={media.alt} width={media.width} height={media.height} loading="lazy" />
                    <figcaption>
                      <strong>{label}</strong>
                      <span>The portrait identity moves into the low, forward, hands-braced kneel.</span>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </section>
            <section aria-labelledby="subject-b-heading">
              <div class="pose-group-heading">
                <small>Subject B</small>
                <h4 id="subject-b-heading">A different character keeps it.</h4>
              </div>
              <div class="pose-pair">
                {poseTransfer.subjectB.map(({ media, label }) => (
                  <figure>
                    <img src={media.src} alt={media.alt} width={media.width} height={media.height} loading="lazy" />
                    <figcaption>
                      <strong>{label}</strong>
                      <span>The body design and environment change while the support and contact pattern remains legible.</span>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </section>
          </div>
        </div>

        <p class="module-payoff">
          That is the modular payoff: the hard work goes into the system. The next piece of content becomes a focused change to the part that needs new direction, not a rebuild of everything that already works.
        </p>
      </Wrapper>
    </section>

    <section id="modular-loop" class="section-block loop-section" aria-labelledby="loop-heading">
      <Wrapper variant="standard">
        <div class="loop-layout">
          <div class="loop-copy">
            <div class="section-intro">
              <p class="eyebrow">The 66-second explainer · edited loop</p>
              <h2 id="loop-heading">An image does not have to be one indivisible prompt.</h2>
              <p>
                I edited four generated sequences into one continuous demonstration. The piece keeps a few visual relationships legible while the subject, environment, pose, camera, and rendering language change around them.
              </p>
              <p>
                The transitions partially mutate one character and world into the next. Instead of stopping to explain modular image direction from outside the work, the generated characters speak from inside it.
              </p>
            </div>

            <ol class="loop-sequence" aria-label="The four movements in the StyleFusion loop">
              <li>
                <span>01</span>
                <div><strong>Pose + camera</strong><p>A green goth character establishes the low kneel, forward engagement, and circular fisheye field.</p></div>
              </li>
              <li>
                <span>02</span>
                <div><strong>Subject swap</strong><p>A lattice creature replaces the human figure while the grounded structure and centered hierarchy remain readable.</p></div>
              </li>
              <li>
                <span>03</span>
                <div><strong>Style + scene</strong><p>The black-haired trailer character carries the world into a different rendering lane and a new performance.</p></div>
              </li>
              <li>
                <span>04</span>
                <div><strong>Rendering + return</strong><p>A cat character pushes the image into another visual language before the edit feeds back into its opening frame.</p></div>
              </li>
            </ol>
          </div>

          <figure class="loop-film">
            <video controls loop playsinline preload="metadata" poster={modularLoop.poster} aria-label={modularLoop.alt}>
              <source src={modularLoop.src} type="video/mp4" />
            </video>
            <figcaption>
              <strong>StyleFusion clip 1 · 65.8-second edited loop</strong>
              <span>Four generated sequences joined by recurring pose, forward camera engagement, centered subject hierarchy, and circular framing. Sound on for the characters.</span>
            </figcaption>
          </figure>
        </div>

        <div class="loop-bookend">
          <strong>Keep what works. Swap what doesn’t. Build the next image from the pieces.</strong>
          <p>The edit follows the same logic as the system: preserve a useful relationship, replace the module that needs to change, and let the result become the start of the next composition.</p>
        </div>
      </Wrapper>
    </section>

    <section class="section-block recent-section" aria-labelledby="recent-heading">
      <Wrapper variant="standard">
        <div class="section-intro max-w-4xl">
          <p class="eyebrow">Recent packs</p>
          <h2 id="recent-heading">The schema is doing more than one kind of picture.</h2>
          <p>
            These are current application results with the same modular build logic. The useful module count stays compact even when the visual problem changes completely.
          </p>
        </div>
        <div class="recent-grid">
          {recentSets.map(({ media, title, stats, caption }) => (
            <figure>
              <img src={media.src} alt={media.alt} width={media.width} height={media.height} loading="lazy" />
              <figcaption>
                <strong>{title}</strong>
                <small>{stats}</small>
                <span>{caption}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </Wrapper>
    </section>

    <section class="section-block" aria-labelledby="provider-heading">
      <Wrapper variant="standard">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,.7fr)_minmax(0,1.3fr)] lg:items-end">
          <div class="section-intro">
            <p class="eyebrow">Same pack, different image models</p>
            <h2 id="provider-heading">Nine models received the same 2,871-character handoff.</h2>
          </div>
          <p class="max-w-2xl text-base leading-7 text-base-400 lg:justify-self-end">
            Five of those results are shown here. Each model makes different rendering decisions, but the black hair, cyan-violet emphasis, bat jewelry, corset structure, and close portrait framing keep returning. The pack stays canonical; the provider remains replaceable.
          </p>
        </div>
        <div class="provider-grid">
          {providerComparisons.map(({ media, label }) => (
            <figure>
              <img src={media.src} alt={media.alt} width={media.width} height={media.height} loading="lazy" />
