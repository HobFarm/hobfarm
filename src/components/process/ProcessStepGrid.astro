---
import type { ProcessPipeline } from "@/data/processPipelines";
import { getProcessAssetUrl } from "@/data/processPipelines";
import { transformImageUrl } from "@/lib/media-transforms";

interface Props {
  pipeline: ProcessPipeline;
}

const { pipeline } = Astro.props;
const sectionCopy = pipeline.progression ?? {
  eyebrow: "Progression",
  title: "Signal to Package",
  description:
    "The fashion signal moves through outfit logic, identity stabilization, presentation, and a final character sheet.",
};
const gridColumnsClass = pipeline.steps.length === 4 ? "lg:grid-cols-4" : "lg:grid-cols-5";
---

<section id="progression" class="border-t border-base-800/70 pt-12 lg:pt-16">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="font-mono text-sm uppercase tracking-widest text-accent-500">{sectionCopy.eyebrow}</p>
      <h2 class="mt-4 text-3xl font-display text-white sm:text-4xl">{sectionCopy.title}</h2>
    </div>
    <p class="max-w-xl text-sm leading-relaxed text-base-400">
      {sectionCopy.description}
    </p>
  </div>

  <div class={`mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 ${gridColumnsClass}`}>
    {pipeline.steps.map((step) => {
      const mediaUrl = getProcessAssetUrl(pipeline, step.media);
      return (
      <article class="group/card overflow-hidden rounded-lg border border-base-800 bg-base-900/70 transition-colors hover:border-accent-500/40">
        <button
          type="button"
          class="relative block aspect-[2/3] w-full cursor-zoom-in overflow-hidden bg-base-950 text-left"
          data-lightbox={mediaUrl}
          data-lightbox-caption={`${step.label}: ${step.title}`}
          data-lightbox-alt={step.alt}
          aria-label={`Open ${step.title} in a larger view`}
        >
          <img
            src={transformImageUrl(mediaUrl, { width: 640, quality: 84, fit: "cover" })}
            alt={step.alt}
            width="640"
            height="800"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-500 group-hover/card:scale-105"
          />
          <span class="absolute bottom-3 right-3 flex size-9 items-center justify-center rounded-full border border-base-700/70 bg-base-950/75 text-base-200 shadow-lg shadow-black/40 backdrop-blur-sm transition-colors group-hover/card:border-accent-500/60 group-hover/card:text-white">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
              <path d="M11 8v6"></path>
              <path d="M8 11h6"></path>
            </svg>
          </span>
        </button>
        <div class="p-4">
          <p class="font-mono text-[10px] uppercase tracking-widest text-accent-500">{step.label}</p>
          <h3 class="mt-2 text-base font-display text-white">{step.title}</h3>
          <p class="mt-2 text-xs leading-relaxed text-base-400">{step.description}</p>
        </div>
      </article>
      );
    })}
  </div>
</section>
