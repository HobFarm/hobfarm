---
import type { ProcessPipeline } from "@/data/processPipelines";

interface Props {
  pipeline: ProcessPipeline;
}

const { pipeline } = Astro.props;
const chain = pipeline.editorialChain;
---

{chain && (
  <section id="editorial-chain" class="border-t border-base-800/70 pt-12 lg:pt-16">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="font-mono text-sm uppercase tracking-widest text-accent-500">{chain.eyebrow}</p>
        <h2 class="mt-4 text-3xl font-display text-white sm:text-4xl">{chain.title}</h2>
      </div>
      <p class="max-w-2xl text-sm leading-relaxed text-base-400">{chain.description}</p>
    </div>

    <ol class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {chain.steps.map((step, index) => (
        <li class="rounded-lg border border-base-800 bg-base-900/70 p-4">
          <p class="font-mono text-[10px] uppercase tracking-widest text-accent-500">
            {String(index + 1).padStart(2, "0")}
          </p>
          <p class="mt-3 text-sm leading-relaxed text-base-300">{step}</p>
        </li>
      ))}
    </ol>
  </section>
)}
