---
import type { ProcessPipeline } from "@/data/processPipelines";
import { getProcessAssetUrl, getProcessVideoType } from "@/data/processPipelines";
import { transformImageUrl } from "@/lib/media-transforms";

interface Props {
  pipeline: ProcessPipeline;
}

const { pipeline } = Astro.props;
const loop = pipeline.loopReel;
const notes = pipeline.notes;
const videoUrl = getProcessAssetUrl(pipeline, pipeline.media.video);
const posterUrl = getProcessAssetUrl(pipeline, pipeline.media.poster);
const videoType = getProcessVideoType(pipeline.media.video);
---

{loop && (
  <section id="loop-reel" class="border-t border-base-800/70 pt-12 lg:pt-16">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(280px,0.55fr)] lg:items-start">
      <div>
        <p class="font-mono text-sm uppercase tracking-widest text-accent-500">{loop.eyebrow}</p>
        <h2 class="mt-4 text-3xl font-display text-white sm:text-4xl">{loop.title}</h2>
        <p class="mt-5 max-w-2xl text-sm leading-relaxed text-base-400">{loop.description}</p>

        {notes && (
          <div class="mt-8 rounded-lg border border-base-800 bg-base-900/70 p-5 sm:p-6">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="font-mono text-[10px] uppercase tracking-widest text-accent-500">{notes.eyebrow}</p>
                <h3 class="mt-3 text-2xl font-display text-white">{notes.title}</h3>
              </div>
              <p class="max-w-sm text-xs leading-relaxed text-base-400">{notes.description}</p>
            </div>

            <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
              {notes.items.map((item) => (
                <div class="rounded-md border border-accent-500/20 bg-accent-500/10 p-3">
                  <p class="text-xs leading-relaxed text-base-200">{item}</p>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="relative mx-auto w-full max-w-sm overflow-hidden rounded-lg border border-base-800 bg-base-950">
        <video
          autoplay
          muted
          loop
          playsinline
          controls
          preload="metadata"
          poster={transformImageUrl(posterUrl, { width: 900, quality: 84, fit: "cover" })}
          class="aspect-[2/3] w-full object-cover"
        >
          <source src={videoUrl} type={videoType} />
          <img
            src={transformImageUrl(posterUrl, { width: 900, quality: 84, fit: "cover" })}
            alt={`${pipeline.title} loop reel poster`}
            class="h-full w-full object-cover"
          />
        </video>
        <button
          type="button"
          class="absolute right-4 top-4 flex size-11 items-center justify-center rounded-full border border-base-700/70 bg-base-950/75 text-base-200 shadow-lg shadow-black/40 backdrop-blur-sm transition-colors hover:border-accent-500/60 hover:text-white focus:outline-none focus:ring-2 focus:ring-accent-500/70"
          data-lightbox={videoUrl}
          data-lightbox-type="video"
          data-lightbox-caption={`${pipeline.eyebrow}: ${loop.title}`}
          data-lightbox-alt={`${pipeline.title} loop reel video`}
          aria-label={`Open ${pipeline.title} loop reel in a larger view`}
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
            <path d="M11 8v6"></path>
            <path d="M8 11h6"></path>
          </svg>
        </button>
      </div>
    </div>
  </section>
)}
