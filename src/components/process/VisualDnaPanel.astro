---
import type { ProcessPipeline } from "@/data/processPipelines";
import { getProcessAssetUrl } from "@/data/processPipelines";
import { transformImageUrl } from "@/lib/media-transforms";

interface Props {
  pipeline: ProcessPipeline;
}

const { pipeline } = Astro.props;
const heroFilename = pipeline.media.supportingStill ?? pipeline.media.hero;
const heroUrl = getProcessAssetUrl(pipeline, heroFilename);
const panelCopy = pipeline.visualPanel ?? {
  eyebrow: "Visual DNA + Grimoire",
  title: "Reusable Character Logic",
  description:
    "The package is built from identity anchors, material cues, palette pressure, style anchors, and the public Grimoire notes that explain the process.",
  relatedEyebrow: "Source-informed grammar",
  relatedTitle: "Related Grimoire",
  relatedDescription:
    "These notes explain the parts of the process that are public: character stability, visual atoms, and prompt compilation.",
  imageCaption: `${pipeline.title}: fashion grammar hero artifact`,
  imageAlt: `${pipeline.title} fashion grammar hero artifact`,
};
const relatedEyebrow = panelCopy.relatedEyebrow ?? "Source-informed grammar";
const relatedTitle = panelCopy.relatedTitle ?? "Related Grimoire";
const relatedDescription =
  panelCopy.relatedDescription ??
  "These notes explain the parts of the process that are public: character stability, visual atoms, and prompt compilation.";
const imageCaption = panelCopy.imageCaption ?? `${pipeline.title}: supporting artifact`;
const imageAlt = panelCopy.imageAlt ?? `${pipeline.title} supporting artifact`;
---

<section id="visual-dna" class="border-t border-base-800/70 pt-12 lg:pt-16">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="font-mono text-sm uppercase tracking-widest text-accent-500">{panelCopy.eyebrow}</p>
      <h2 class="mt-4 text-3xl font-display text-white sm:text-4xl">{panelCopy.title}</h2>
    </div>
    <p class="max-w-2xl text-sm leading-relaxed text-base-400">
      {panelCopy.description}
    </p>
  </div>

  <div class="mt-8 grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1.15fr)_minmax(300px,0.85fr)]">
    <div class="rounded-lg border border-base-800 bg-base-900/70 p-5 sm:p-6">
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        <div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-base-500">Identity anchors</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {pipeline.visualDna.identity.map((item) => (
              <span class="rounded-full border border-base-700 bg-base-950/70 px-3 py-1.5 text-[11px] text-base-300">
                {item}
              </span>
            ))}
          </div>
        </div>

        <div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-base-500">Material cues</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {pipeline.visualDna.materials.map((item) => (
              <span class="rounded-full border border-base-700 bg-base-950/70 px-3 py-1.5 text-[11px] text-base-300">
                {item}
              </span>
            ))}
          </div>
        </div>
      </div>

      <div class="mt-6 border-t border-base-800 pt-5">
        <p class="font-mono text-[10px] uppercase tracking-widest text-base-500">Palette</p>
        <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-5">
          {pipeline.visualDna.palette.map((color) => {
            const swatchClass = color.hex ? "" : color.swatchClass ?? "bg-base-700";
            const swatchStyle = color.hex ? `background-color: ${color.hex};` : undefined;
            return (
            <div class="rounded-md border border-base-800 bg-base-950/70 p-3">
              <span class={`block h-7 rounded border border-white/10 ${swatchClass}`} style={swatchStyle}></span>
              <p class="mt-2 text-xs text-white">{color.name}</p>
              {color.hex && <p class="mt-1 font-mono text-[10px] uppercase tracking-wider text-base-500">{color.hex}</p>}
            </div>
            );
          })}
        </div>
      </div>

      <div class="mt-6 border-t border-base-800 pt-5">
        <p class="font-mono text-[10px] uppercase tracking-widest text-base-500">Style anchors</p>
        <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
          {pipeline.visualDna.styleAnchors.map((item) => (
            <div class="rounded-md border border-accent-500/20 bg-accent-500/10 px-3 py-2 text-sm text-base-200">
              {item}
            </div>
          ))}
        </div>
      </div>
    </div>

    <aside class="rounded-lg border border-base-800 bg-base-900/70 p-5 sm:p-6">
      <p class="font-mono text-[10px] uppercase tracking-widest text-accent-500">{relatedEyebrow}</p>
      <h3 class="mt-3 text-2xl font-display text-white">{relatedTitle}</h3>
      <p class="mt-3 text-sm leading-relaxed text-base-400">
        {relatedDescription}
      </p>

      <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-[minmax(0,1fr)_12rem] lg:grid-cols-1 xl:grid-cols-[minmax(0,1fr)_12rem]">
        <div class="space-y-2">
          {pipeline.relatedGrimoire.map((link) => (
            <a
              href={link.href}
              class="block rounded-md border border-base-800 bg-base-950/60 p-3 transition-colors hover:border-accent-500/50"
            >
              <p class="font-mono text-[10px] uppercase tracking-widest text-accent-500">{link.label}</p>
              <p class="mt-1.5 text-xs leading-relaxed text-base-400">{link.description}</p>
            </a>
          ))}
        </div>

        <button
          type="button"
          class="group/hero relative mx-auto block w-full max-w-xs cursor-zoom-in overflow-hidden rounded-lg border border-base-800 bg-base-950 text-left transition-colors hover:border-accent-500/40 focus:outline-none focus:ring-2 focus:ring-accent-500/70 sm:max-w-none"
          data-lightbox={heroUrl}
          data-lightbox-caption={imageCaption}
          data-lightbox-alt={imageAlt}
          aria-label={`Open ${pipeline.title} supporting artifact in a larger view`}
        >
          <img
            src={transformImageUrl(heroUrl, { width: 520, quality: 84, fit: "cover" })}
            alt={imageAlt}
            width="520"
            height="780"
            loading="lazy"
            decoding="async"
            class="aspect-[2/3] w-full object-cover transition-transform duration-500 group-hover/hero:scale-105"
          />
          <span class="absolute bottom-3 right-3 flex size-9 items-center justify-center rounded-full border border-base-700/70 bg-base-950/75 text-base-200 shadow-lg shadow-black/40 backdrop-blur-sm transition-colors group-hover/hero:border-accent-500/60 group-hover/hero:text-white">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
              <path d="M11 8v6"></path>
              <path d="M8 11h6"></path>
            </svg>
          </span>
        </button>
      </div>
    </aside>
  </div>
</section>
