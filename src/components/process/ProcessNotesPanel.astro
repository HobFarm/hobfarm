---
import type { ProcessPipeline } from "@/data/processPipelines";

interface Props {
  pipeline: ProcessPipeline;
}

const { pipeline } = Astro.props;
const notes = pipeline.notes;
---

{notes && (
  <section id={`${pipeline.identifier}-notes`} class="border-t border-base-800/70 pt-12 lg:pt-16">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="font-mono text-sm uppercase tracking-widest text-accent-500">{notes.eyebrow}</p>
        <h2 class="mt-4 text-3xl font-display text-white sm:text-4xl">{notes.title}</h2>
      </div>
      <p class="max-w-xl text-sm leading-relaxed text-base-400">{notes.description}</p>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {notes.items.map((item) => (
        <div class="rounded-lg border border-accent-500/20 bg-accent-500/10 p-4">
          <p class="text-sm leading-relaxed text-base-200">{item}</p>
        </div>
      ))}
    </div>
  </section>
)}
