---
import type { ProcessPipeline } from "@/data/processPipelines";
import { getProcessAssetUrl, getProcessVideoType } from "@/data/processPipelines";
import { transformImageUrl } from "@/lib/media-transforms";

interface Props {
  pipeline: ProcessPipeline;
}

const { pipeline } = Astro.props;
const videoUrl = getProcessAssetUrl(pipeline, pipeline.media.video);
const posterUrl = getProcessAssetUrl(pipeline, pipeline.media.poster);
const videoType = getProcessVideoType(pipeline.media.video);
---

<article class="group overflow-hidden rounded-lg border border-base-800 bg-base-900/70 transition-colors hover:border-accent-500/50">
  <button
    type="button"
    class="relative block aspect-[2/3] w-full cursor-zoom-in overflow-hidden bg-base-950 text-left focus:outline-none focus:ring-2 focus:ring-accent-500/70"
    data-lightbox={videoUrl}
    data-lightbox-type="video"
    data-lightbox-caption={`${pipeline.eyebrow}: ${pipeline.title}`}
    data-lightbox-alt={`${pipeline.title} process video`}
    aria-label={`Open ${pipeline.title} process video in a larger view`}
  >
    <video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={transformImageUrl(posterUrl, { width: 900, quality: 84, fit: "cover" })}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    >
      <source src={videoUrl} type={videoType} />
    </video>
    <span class="absolute inset-0 bg-gradient-to-t from-base-950/70 via-transparent to-transparent"></span>
    <span class="absolute left-4 top-4 rounded-full border border-accent-500/30 bg-base-950/70 px-3 py-1 text-[10px] font-mono uppercase tracking-widest text-accent-400">
      process
    </span>
    <span class="absolute bottom-4 right-4 flex size-10 items-center justify-center rounded-full border border-base-700/70 bg-base-950/75 text-base-200 shadow-lg shadow-black/40 backdrop-blur-sm transition-colors group-hover:border-accent-500/60 group-hover:text-white">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
        <path d="M11 8v6"></path>
        <path d="M8 11h6"></path>
      </svg>
    </span>
  </button>

  <div class="p-5">
    <p class="font-mono text-[10px] uppercase tracking-widest text-accent-500">{pipeline.eyebrow}</p>
    <h3 class="mt-3 text-2xl font-display text-white">{pipeline.title}</h3>
    <p class="mt-3 text-sm leading-relaxed text-base-400">{pipeline.shortDescription}</p>
    <div class="mt-5 rounded-md border border-base-800 bg-base-950/60 px-3 py-2">
      <p class="font-mono text-[11px] uppercase tracking-wider text-base-300">{pipeline.pipeline}</p>
    </div>
    <a href={pipeline.href} class="mt-5 inline-flex font-mono text-[11px] uppercase tracking-wider text-accent-500 transition-colors hover:text-white">
        Open process &rarr;
    </a>
  </div>

  {pipeline.relatedGrimoire.length > 0 && (
    <div class="border-t border-base-800 px-5 py-4">
      <p class="font-mono text-[10px] uppercase tracking-widest text-base-500">Related Grimoire</p>
      <div class="mt-3 space-y-2">
        {pipeline.relatedGrimoire.slice(0, 2).map((link) => (
          <a
            href={link.href}
            class="block rounded-md border border-base-800 bg-base-950/60 px-3 py-2 transition-colors hover:border-accent-500/40 hover:text-white"
          >
            <span class="text-xs font-mono uppercase tracking-wider text-accent-400">{link.label}</span>
            <span class="mt-1 block text-xs leading-relaxed text-base-500">{link.description}</span>
          </a>
        ))}
      </div>
    </div>
  )}
</article>
