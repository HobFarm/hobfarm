---
interface Props {
  src: string;
  poster: string;
  label: string;
  caption?: string;
}

const { src, poster, label, caption } = Astro.props;
---

<figure class="ambient-video" data-ambient-video>
  <div class="ambient-video__frame">
    <video poster={poster} preload="none" controls playsinline aria-label={label} data-video-src={src}></video>
    <button type="button" data-video-play aria-label={`Load and play ${label}`}><span aria-hidden="true">&#9654;</span> Play preview</button>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
  <noscript><p><a href={src}>Open the video preview</a></p></noscript>
</figure>

<style>
  .ambient-video { margin: 0; }
  .ambient-video__frame { position: relative; overflow: hidden; aspect-ratio: 16 / 9; border: 1px solid #2c2440; border-radius: 1rem; background: #07060b; }
  video { width: 100%; height: 100%; object-fit: contain; }
  button { position: absolute; inset: 50% auto auto 50%; display: inline-flex; align-items: center; gap: .55rem; padding: .8rem 1rem; border: 1px solid #ece9f5; border-radius: 999px; transform: translate(-50%, -50%); background: rgba(7, 6, 11, .86); color: #fff; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
  button:focus-visible { outline: 3px solid #55d7ff; outline-offset: 4px; }
  figcaption { margin-top: .75rem; color: #9b96ad; font-size: .8rem; line-height: 1.55; }
  noscript p { margin: .75rem 0 0; }
  noscript a { color: #55d7ff; }
</style>

<script>
  function initAmbientVideo(root: HTMLElement) {
    if (root.dataset.videoBound === "true") return;
    root.dataset.videoBound = "true";
    const video = root.querySelector<HTMLVideoElement>("video[data-video-src]");
    const button = root.querySelector<HTMLButtonElement>("[data-video-play]");
    if (!video || !button) return;
    button.addEventListener("click", async () => {
      if (!video.src && video.dataset.videoSrc) {
        video.src = video.dataset.videoSrc;
        video.load();
      }
      button.hidden = true;
      try { await video.play(); } catch { button.hidden = false; }
    });
    video.addEventListener("play", () => { button.hidden = true; });
  }
  function initAmbientVideos() { document.querySelectorAll<HTMLElement>("[data-ambient-video]").forEach(initAmbientVideo); }
  initAmbientVideos();
  document.addEventListener("astro:page-load", initAmbientVideos);
</script>
