---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Lightbox from "@/components/gallery/Lightbox";
import CharacterLookChapter from "@/components/workshop/CharacterLookChapter.astro";
import {
  characterLooks,
  characterMannequinPage,
  type MediaRef,
} from "@/data/character-mannequin";
import { workshopPrograms } from "@/data/site-hierarchy";
import { imageSrcset, transformImageUrl } from "@/lib/media-transforms";

const page = characterMannequinPage;
const preview = (media: MediaRef, width = 1200) =>
  transformImageUrl(media.src, { width, quality: 82, fit: "scale-down" });
const srcset = (media: MediaRef) =>
  imageSrcset(media.src, [480, 768, 1000, 1280, 1600], { quality: 82, fit: "scale-down" });

const sheetPanels = [
  { index: "01", label: "Portrait", description: "Records the face, hair, makeup, and details that identify the mannequin." },
  { index: "02", label: "Front", description: "Shows the silhouette and the way an outfit sits on the body." },
  { index: "03", label: "Back", description: "Keeps rear construction and hair shape from becoming guesswork." },
  { index: "04", label: "Three-quarter", description: "Shows depth, overlap, and proportions that flat views can hide." },
] as const;

const storySteps = [
  { label: "Clean base", description: "Begin with a generic figure and a repeatable four-view sheet." },
  { label: "Dress / Blonde", description: "Apply one outfit and aesthetic to the blonde mannequin, then carry it into a scene." },
  { label: "Black leather / Blonde", description: "Change the outfit and setting while keeping the same mannequin recognizable." },
  { label: "Black leather / Green", description: "Move the same look to a different mannequin and rendering style." },
] as const;

const sheetExamples = [
  { media: page.cleanBaseSheet, label: "Clean Base 001", note: "Neutral starting point" },
  { media: page.baseSheet, label: "Blonde mannequin", note: "First identity" },
  { media: page.alternateSheet, label: "Green mannequin", note: "Different identity and rendering style" },
] as const;

const sameMannequin = [
  "blonde face and platinum hair",
  "black hair clip and eye-makeup identifier",
  "body proportions and silhouette",
  "the same reference-sheet views",
] as const;
const transferredLook = [
  "lace-up black leather top and shorts",
  "tall lace-up boots",
  "black bag, fan, jewelry, and dark accessories",
  "the outfit's hard black palette and attitude",
] as const;

const blondeBlack = characterLooks[1].character;
const greenBlack = characterLooks[2].character;

const relatedRoutes = [
  { eyebrow: "Academy", title: "Learn the mechanics", description: "Platform-specific setup and instruction belong in a course when there is a stable workflow worth teaching.", href: page.academyUrl, action: "Visit the Academy" },
  { eyebrow: "Workshop study", title: "Alter Ego", description: "See one source split into separate public identities.", href: "/workshop/alter-ego/", action: "Open the study" },
  { eyebrow: "Character index", title: "Visual systems", description: "Follow recurring identities, variants, and finished character records.", href: page.characterIndexUrl, action: "Open the index" },
] as const;
---

<div class="character-page">
  <section class="character-hero" aria-labelledby="character-page-title">
    <Wrapper variant="standard" class="hero-wrapper">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <a href="/workshop/">Workshop</a><span aria-hidden="true">/</span>
        <span>Character / Mannequin</span>
      </nav>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Character / Mannequin Workshop</p>
          <h1 id="character-page-title">Start with the base.</h1>
          <p class="hero-deck">The clean sheet begins as a generic figure. A blonde mannequin then carries two different outfit-and-scene systems. The black leather look moves once more onto a green mannequin, where the body and rendering style change but the look stays recognizable.</p>
          <div class="hero-actions">
            <a href="#the-base" class="button button--primary" data-event="character_page_primary_cta">See the starting point</a>
            <a href="#the-sequence" class="button button--secondary">Follow the sequence</a>
          </div>
        </div>
        <figure class="hero-art">
          <a
            href={page.heroGraphic.src}
            data-lightbox={page.heroGraphic.src}
            data-lightbox-group="character-base-hero"
            data-lightbox-alt={page.heroGraphic.alt}
            data-lightbox-caption={page.heroGraphic.caption}
            aria-label="Open Clean Base 001 in the image viewer"
          >
            <img
              src={preview(page.heroGraphic, 1600)}
              srcset={srcset(page.heroGraphic)}
              sizes="(min-width: 1000px) 58vw, 100vw"
              alt={page.heroGraphic.alt}
              width={page.heroGraphic.width}
              height={page.heroGraphic.height}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </a>
          <figcaption>{page.heroGraphic.caption} / open in the image viewer</figcaption>
        </figure>
      </div>
    </Wrapper>
  </section>

  <section id="the-base" class="base-section" aria-labelledby="base-heading">
    <Wrapper variant="standard" class="section-space">
      <header class="section-intro section-intro--split">
        <div><p class="eyebrow">The starting point</p><h2 id="base-heading">A neutral sheet gives every change the same place to begin.</h2></div>
        <p>The clean base is deliberately generic. Portrait, front, back, and three-quarter views make the figure easy to compare after an identity, outfit, or style has been applied.</p>
      </header>

      <figure class="sheet-hero">
        <a
          href={page.cleanBaseSheet.src}
          data-lightbox={page.cleanBaseSheet.src}
          data-lightbox-group="character-clean-base"
          data-lightbox-alt={page.cleanBaseSheet.alt}
          data-lightbox-caption={page.cleanBaseSheet.caption}
          aria-label="Open Clean Base 001 in the image viewer"
        >
          <img src={preview(page.cleanBaseSheet, 1600)} srcset={srcset(page.cleanBaseSheet)} sizes="(min-width:1100px) 1120px,100vw" alt={page.cleanBaseSheet.alt} width={page.cleanBaseSheet.width} height={page.cleanBaseSheet.height} loading="lazy" decoding="async" />
        </a>
        <figcaption>{page.cleanBaseSheet.caption} / open in the image viewer</figcaption>
      </figure>

      <ol class="panel-breakdown">
        {sheetPanels.map((panel) => <li><span>{panel.index}</span><h3>{panel.label}</h3><p>{panel.description}</p></li>)}
      </ol>

      <ol class="story-ribbon" aria-label="Mannequin and outfit demonstration sequence">
        {storySteps.map((step, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><h3>{step.label}</h3><p>{step.description}</p></li>)}
      </ol>

      <div class="sheet-library" aria-label="The base and two mannequin identities">
        {sheetExamples.map((entry) => (
          <figure>
            <a
              href={entry.media.src}
              data-lightbox={entry.media.src}
              data-lightbox-group="character-sheet-library"
              data-lightbox-alt={entry.media.alt}
              data-lightbox-caption={`${entry.label} / ${entry.note}`}
              aria-label={`Open ${entry.label} in the image viewer`}
            ><img src={preview(entry.media, 800)} alt={entry.media.alt} width={entry.media.width} height={entry.media.height} loading="lazy" decoding="async" /></a>
            <figcaption><strong>{entry.label}</strong><span>{entry.note}</span></figcaption>
          </figure>
        ))}
      </div>
    </Wrapper>
  </section>

  <section id="the-sequence" class="sequence-section" aria-labelledby="sequence-heading">
    <Wrapper variant="standard" class="section-space">
      <header class="section-intro section-intro--split">
        <div><p class="eyebrow">The demonstration</p><h2 id="sequence-heading">Two styles on one mannequin. One style on two mannequins.</h2></div>
        <p>The dress and black leather examples show how far wardrobe, setting, and aesthetic can move while the blonde mannequin stays visible underneath. The final example reverses the test: the mannequin changes while the black leather look stays.</p>
      </header>

      <nav class="look-index" aria-label="Mannequin and outfit sequence">
        {characterLooks.map((look) => <a href={`#${look.id}`} data-look-index={look.id}><span>{look.index}</span><strong>{look.title}</strong><small>{look.axis === "identity" ? "different mannequin" : "same mannequin"}</small></a>)}
      </nav>
      <div class="look-chapters">{characterLooks.map((look) => <CharacterLookChapter look={look} />)}</div>
    </Wrapper>
  </section>

  <section id="the-transfer" class="transfer-section" aria-labelledby="transfer-heading">
    <Wrapper variant="standard" class="section-space">
      <header class="section-intro section-intro--split">
        <div><p class="eyebrow">What carries through</p><h2 id="transfer-heading">The look survives without producing the same picture.</h2></div>
        <p>The blonde and green figures do not share a body, face, palette, or rendering style. The black leather outfit remains legible because its garment shapes, accessories, palette, and attitude move together.</p>
      </header>

      <div class="transfer-pair">
        {[
          { media: blondeBlack, label: "Black leather / Blonde mannequin" },
          { media: greenBlack, label: "Black leather / Green mannequin" },
        ].map((entry) => <figure><a href={entry.media.src} data-lightbox={entry.media.src} data-lightbox-group="black-look-transfer" data-lightbox-alt={entry.media.alt} data-lightbox-caption={entry.label} aria-label={`Open ${entry.label} in the image viewer`}><img src={preview(entry.media, 1000)} srcset={srcset(entry.media)} sizes="(min-width:800px) 50vw,100vw" alt={entry.media.alt} width={entry.media.width} height={entry.media.height} loading="lazy" decoding="async" /></a><figcaption>{entry.label}</figcaption></figure>)}
      </div>

      <dl class="continuity-record">
        <div><dt>Same mannequin, different looks</dt>{sameMannequin.map((item) => <dd>{item}</dd>)}</div>
        <div><dt>Different mannequin, same look</dt>{transferredLook.map((item) => <dd>{item}</dd>)}</div>
      </dl>
    </Wrapper>
  </section>

  <section class="related-section" aria-labelledby="related-heading">
    <Wrapper variant="standard" class="section-space">
      <header class="section-intro section-intro--split">
        <div><p class="eyebrow">Workshop and Academy</p><h2 id="related-heading">This page shows the result. A course can teach the mechanics.</h2></div>
        <p>The Workshop record stays with the visible comparison. Platform-specific setup, instruction, retries, and limitations belong in Academy material built for that platform.</p>
      </header>
      <nav class="relationship-rail" aria-label="Related Workshop, character, and Academy routes">{relatedRoutes.map((item) => <a href={item.href}><span>{item.eyebrow}</span><h3>{item.title}</h3><p>{item.description}</p><strong>{item.action} &rarr;</strong></a>)}</nav>
      <nav class="program-nav" aria-label="Workshop programs">{workshopPrograms.filter((entry) => entry.inNav !== false).map((entry) => <a class:list={[entry.id === "character-mannequin" && "active"]} href={entry.href}>{entry.name}</a>)}</nav>
    </Wrapper>
  </section>
</div>

<Lightbox client:only="react" />

<script>
  const chapters = Array.from(document.querySelectorAll<HTMLElement>("[data-look-chapter]"));
  chapters.forEach((chapter) => {
    chapter.classList.add("is-enhanced");
    const tabs = Array.from(chapter.querySelectorAll<HTMLButtonElement>("[data-stage-tab]"));
    const panels = Array.from(chapter.querySelectorAll<HTMLElement>("[data-stage-panel]"));
    const activate = (selected: HTMLButtonElement, moveFocus = false) => {
      const stage = selected.dataset.stage;
      tabs.forEach((tab) => { const active = tab === selected; tab.setAttribute("aria-selected", String(active)); tab.tabIndex = active ? 0 : -1; });
      panels.forEach((panel) => panel.classList.toggle("is-active", panel.dataset.stage === stage));
      if (moveFocus) selected.focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event) => {
        let nextIndex = index;
        if (event.key === "ArrowRight" || event.key === "ArrowDown") nextIndex = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft" || event.key === "ArrowUp") nextIndex = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === "Home") nextIndex = 0;
        else if (event.key === "End") nextIndex = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(tabs[nextIndex], true);
      });
    });
  });
  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>("[data-character-video]"));
  videos.forEach((video) => {
    video.addEventListener("play", () => videos.forEach((other) => { if (other !== video && !other.paused) other.pause(); }));
  });
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (!entry.isIntersecting && entry.target instanceof HTMLVideoElement) entry.target.pause(); }), { threshold: .1 });
    videos.forEach((video) => observer.observe(video));
  }
</script>

<style>
  .character-page{--ink:#07060a;--panel:#0d0a12;--line:#30283b;--paper:#f0eadd;--muted:#aaa5b8;--cyan:#87e9ff;--pink:#ff3da9;background:var(--ink);color:#ece9f5;overflow:hidden}.character-page :global(.hero-wrapper),.character-page :global(.section-space){padding-top:clamp(3.5rem,8vw,7rem);padding-bottom:clamp(3.5rem,8vw,7rem)}
  .character-hero,.base-section,.sequence-section,.transfer-section,.related-section{border-bottom:1px solid var(--line)}.character-hero{background:radial-gradient(circle at 78% 30%,rgb(255 61 169 / 12%),transparent 31rem),linear-gradient(140deg,#0b0811,#050406)}.base-section{background:#09070d}.sequence-section{background:linear-gradient(165deg,#0b0810,#07060a)}.transfer-section{background:#08080d}.related-section{background:#09070d}
  .breadcrumbs{display:flex;flex-wrap:wrap;gap:.55rem;color:#777184;font-family:var(--font-mono);font-size:.62rem;text-transform:uppercase}.breadcrumbs a{color:#aaa5b8;text-decoration:none}.hero-grid{display:grid;gap:2rem;margin-top:2.5rem}.hero-copy{align-self:center}.eyebrow{margin:0;color:var(--cyan);font-family:var(--font-mono);font-size:.62rem;letter-spacing:.16em;text-transform:uppercase}.hero-copy h1{max-width:10ch;margin:.8rem 0 0;color:var(--paper);font-family:var(--font-display);font-size:clamp(4rem,10vw,8.5rem);font-weight:300;letter-spacing:-.065em;line-height:.82}.hero-deck{max-width:42rem;margin:1.4rem 0 0;color:#c1bdca;font-size:clamp(1rem,1.6vw,1.2rem);line-height:1.7}.hero-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.6rem}.button{display:inline-flex;align-items:center;justify-content:center;min-height:2.8rem;padding:.65rem 1rem;border:1px solid var(--line);color:#fff;font-family:var(--font-mono);font-size:.64rem;letter-spacing:.08em;text-decoration:none;text-transform:uppercase}.button--primary{border-color:var(--pink);background:var(--pink);color:#07060a}.button--secondary{background:#0d0a12}
  .hero-art,.sheet-hero,.sheet-library figure,.transfer-pair figure{margin:0;border:1px solid var(--line);background:#f4f2ed}.hero-art img,.sheet-hero img,.sheet-library img,.transfer-pair img{display:block;width:100%;height:auto}.hero-art figcaption,.sheet-hero figcaption,.sheet-library figcaption,.transfer-pair figcaption{padding:.75rem 1rem;border-top:1px solid var(--line);background:#0b0910;color:#8f899c;font-family:var(--font-mono);font-size:.6rem;letter-spacing:.07em;line-height:1.5;text-transform:uppercase}.hero-art a:focus-visible,.sheet-hero a:focus-visible,.sheet-library a:focus-visible,.transfer-pair a:focus-visible,.button:focus-visible{outline:2px solid var(--cyan);outline-offset:4px}
  .section-intro{max-width:72rem}.section-intro--split{display:grid;gap:1.25rem}.section-intro h2{margin:.75rem 0 0;color:var(--paper);font-family:var(--font-display);font-size:clamp(2.8rem,6vw,5.5rem);font-weight:300;letter-spacing:-.05em;line-height:.92;text-wrap:balance}.section-intro>p{max-width:44rem;margin:1.2rem 0 0;color:var(--muted);line-height:1.75}
  .sheet-hero{margin-top:2.5rem}.panel-breakdown,.story-ribbon{display:grid;gap:1px;margin:1.5rem 0 0;padding:1px;background:var(--line);list-style:none}.panel-breakdown li,.story-ribbon li{min-width:0;padding:1rem;background:#0d0a12}.panel-breakdown span,.story-ribbon span{color:var(--pink);font-family:var(--font-mono);font-size:.58rem}.panel-breakdown h3,.story-ribbon h3{margin:.55rem 0 0;color:#fff;font-size:1rem}.panel-breakdown p,.story-ribbon p{margin:.55rem 0 0;color:#9690a1;font-size:.78rem;line-height:1.6}.story-ribbon{margin-top:2.5rem}.sheet-library{display:grid;gap:1rem;margin-top:2.5rem}.sheet-library figure{min-width:0}.sheet-library figcaption{display:grid;gap:.25rem}.sheet-library strong{color:#ece9f5}.sheet-library span{color:#777184}
  .look-index{display:grid;gap:1px;margin-top:2rem;padding:1px;background:var(--line)}.look-index a{display:grid;grid-template-columns:2rem minmax(0,1fr);gap:.35rem .75rem;padding:1rem;background:#09070d;color:#fff;text-decoration:none}.look-index span,.look-index small{color:#8a8395;font-family:var(--font-mono);font-size:.58rem;text-transform:uppercase}.look-index strong{font-size:.86rem}.look-index small{grid-column:2}.look-index a:hover strong{color:var(--cyan)}.look-chapters{display:grid;gap:clamp(3rem,8vw,7rem);margin-top:clamp(3rem,7vw,6rem)}
  .transfer-pair{display:grid;gap:1rem;margin-top:2.5rem}.transfer-pair img{aspect-ratio:1152/2048;object-fit:contain}.continuity-record{display:grid;gap:1px;margin:1.5rem 0 0;padding:1px;background:var(--line)}.continuity-record>div{padding:1.25rem;background:#0d0a12}.continuity-record dt{margin-bottom:.8rem;color:var(--cyan);font-family:var(--font-mono);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase}.continuity-record dd{margin:.45rem 0 0;color:#aaa5b8;font-size:.82rem}.continuity-record dd::before{content:"+";margin-right:.55rem;color:var(--pink);font-family:var(--font-mono)}
  .relationship-rail{display:grid;gap:1px;margin-top:2rem;padding:1px;background:var(--line)}.relationship-rail a{display:flex;min-width:0;flex-direction:column;padding:1.2rem;background:#0d0a12;color:#fff;text-decoration:none}.relationship-rail span{color:var(--cyan);font-family:var(--font-mono);font-size:.56rem;text-transform:uppercase}.relationship-rail h3{margin:.65rem 0 0;font-size:1.15rem}.relationship-rail p{margin:.55rem 0 0;color:#9690a1;font-size:.78rem;line-height:1.55}.relationship-rail strong{margin-top:auto;padding-top:1rem;color:var(--pink);font-family:var(--font-mono);font-size:.58rem;text-transform:uppercase}.program-nav{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:2rem}.program-nav a{padding:.55rem .7rem;border:1px solid var(--line);color:#8f899c;font-family:var(--font-mono);font-size:.58rem;text-decoration:none;text-transform:uppercase}.program-nav a.active{border-color:var(--cyan);color:#fff}
  @media(min-width:700px){.panel-breakdown,.transfer-pair,.continuity-record{grid-template-columns:repeat(2,minmax(0,1fr))}.story-ribbon{grid-template-columns:repeat(2,minmax(0,1fr))}.sheet-library,.look-index,.relationship-rail{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(min-width:960px){.hero-grid{grid-template-columns:minmax(18rem,.72fr) minmax(0,1.28fr);align-items:center}.section-intro--split{grid-template-columns:minmax(16rem,.75fr) minmax(0,1.25fr);gap:clamp(2rem,6vw,6rem);align-items:start}.story-ribbon{grid-template-columns:repeat(4,minmax(0,1fr))}}
  @media(max-width:520px){.character-page :global(.hero-wrapper),.character-page :global(.section-space){padding-top:3.5rem;padding-bottom:3.5rem}.hero-copy h1{font-size:3.75rem}.panel-breakdown{grid-template-columns:1fr}.sheet-library figcaption{font-size:.55rem}}
</style>
