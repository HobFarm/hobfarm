---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import CharacterLookChapter from "@/components/workshop/CharacterLookChapter.astro";
import CharacterOfferShelf from "@/components/workshop/CharacterOfferShelf.astro";
import DesignDecisionMatrix from "@/components/workshop/DesignDecisionMatrix.astro";
import AffiliateDisclosure from "@/components/legal/AffiliateDisclosure.astro";
import {
  characterLooks,
  characterMannequinPage,
  characterOffers,
  designDecisions,
  themedCharacter,
  type MediaRef,
} from "@/data/character-mannequin";
import { workshopPrograms } from "@/data/site-hierarchy";
import { getMedia } from "@/data/media-registry";
import type { ProductEntry } from "@/lib/products";
import { imageSrcset, transformImageUrl } from "@/lib/media-transforms";

interface Props {
  relatedProducts?: ProductEntry[];
}

const { relatedProducts = [] } = Astro.props;
const page = characterMannequinPage;
const workflowFilm = getMedia("workshop.character-mannequin.workflow-film");
const workflowFilmPoster = getMedia("workshop.character-mannequin.workflow-film-poster");
const heroArrangement = page.heroGraphic.width >= page.heroGraphic.height ? "horizontal" : "vertical";
const preview = (media: MediaRef, width = 1200, fit: "cover" | "scale-down" = "scale-down") =>
  transformImageUrl(media.src, { width, quality: 82, fit });
const srcset = (media: MediaRef, fit: "cover" | "scale-down" = "scale-down") =>
  imageSrcset(media.src, [480, 768, 1000, 1280, 1600], { quality: 82, fit });

const processStages = [
  { label: "Base", description: "Choose proportions, silhouette, joint logic, and the neutral body that later profiles must fit." },
  { label: "Profile slots", description: "Define where face, key features, hair, palette, and other identity decisions can change." },
  { label: "Wardrobe", description: "Set garment categories, footwear, accessories, and material rules before staging a look." },
  { label: "Direction", description: "Test wide, mid, close, and detail cameras alongside lighting, mood, location, and styling." },
  { label: "Proof", description: "Check idle, walk, pose, and action before the approved base carries a finished character." },
] as const;

const mannequinChecks = [
  { label: "Fixed geometry", description: "Proportions, silhouette, joint placement, and range of motion." },
  { label: "Identity slots", description: "Face, key features, hair, palette, markings, and other profile decisions." },
  { label: "Wardrobe system", description: "Tops, outer layers, bottoms, footwear, accessories, and material behavior." },
  { label: "Camera coverage", description: "Wide, mid, close, and detail views that expose continuity drift early." },
  { label: "Scene direction", description: "Lighting, mood, location, and styling choices kept separate from the base." },
  { label: "Motion proof", description: "Idle, walk, pose, and action tests before a named character takes over." },
] as const;

const relatedRoutes = [
  { eyebrow: "Workshop study", title: "Alter Ego", description: "See one base split into separate public identities.", href: "/workshop/alter-ego/", action: "Open the study" },
  { eyebrow: "Shop", title: "Character packs and drops", description: "Browse verified product records and future character-file releases.", href: page.shopUrl, action: "Browse the Shop" },
  { eyebrow: "Character index", title: "Visual systems", description: "Follow recurring mannequins, variants, and finished media packets.", href: page.characterIndexUrl, action: "Open the index" },
  { eyebrow: "Academy / in development", title: "Learn the full method", description: "The future course will hold guided lessons, templates, and protected course files. This Workshop page remains the public process record.", href: page.academyUrl, action: "Visit the Academy" },
] as const;
---

<div class="character-page">
  <section class="character-hero" aria-labelledby="character-page-title">
    <Wrapper variant="standard" class="hero-wrapper">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <a href="/workshop/">Workshop</a><span aria-hidden="true">/</span>
        <span>Character / Mannequin</span>
      </nav>
      <div class:list={["hero-grid", `hero-grid--${heroArrangement}`]}>
        <div class="hero-copy">
          <p class="eyebrow">Character / Mannequin Workshop</p>
          <h1 id="character-page-title">Build the mannequin before the character.</h1>
          <p class="hero-deck">A character profile needs somewhere stable to land. I define the neutral body, identity slots, wardrobe categories, camera coverage, scene variables, and motion tests first. Once the base holds together, it can carry a specific face, role, look, and world.</p>
          <div class="hero-actions">
            <a href="#assembly" class="button button--primary" data-event="character_page_primary_cta">Explore the process</a>
            <a href={page.commissionUrl} class="button button--secondary" data-event="character_page_commission_cta">Commission a character</a>
          </div>
        </div>
        <figure class="hero-art">
          <img
            src={preview(page.heroGraphic, 1600)}
            srcset={srcset(page.heroGraphic)}
            sizes={heroArrangement === "horizontal" ? "(min-width: 1280px) 1216px, 100vw" : "(min-width: 1000px) 56vw, 100vw"}
            alt={page.heroGraphic.alt}
            width={page.heroGraphic.width}
            height={page.heroGraphic.height}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <figcaption>{page.heroGraphic.caption}</figcaption>
        </figure>
      </div>
    </Wrapper>
  </section>

  <section class="process-overview" aria-labelledby="process-overview-heading">
    <Wrapper variant="standard" class="section-space">
      <div class="section-intro section-intro--split">
        <div>
          <p class="eyebrow">Before the profile</p>
          <h2 id="process-overview-heading">The neutral base is a production decision.</h2>
        </div>
        <p>The mannequin is not a blank character waiting for random decoration. It is the approved geometry and test plan beneath later identities. Each decision stays visible so a weak face, garment, camera, or motion pass can be replaced without rebuilding everything.</p>
      </div>
      <ol class="process-ribbon">
        {processStages.map((stage, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{stage.label}</h3>
            <p>{stage.description}</p>
          </li>
        ))}
      </ol>
      <div class="mannequin-checks" aria-label="What the neutral mannequin establishes before character design">
        {mannequinChecks.map((check, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{check.label}</h3>
            <p>{check.description}</p>
          </article>
        ))}
      </div>
      <figure class="overview-graphic">
        <img
          src={preview(page.workflowGraphic)}
          srcset={srcset(page.workflowGraphic)}
          sizes="(min-width: 1100px) 1120px, 100vw"
          alt={page.workflowGraphic.alt}
          width={page.workflowGraphic.width}
          height={page.workflowGraphic.height}
          loading="lazy"
          decoding="async"
        />
        <figcaption>{page.workflowGraphic.caption}. This is what the approved base can become after a profile is attached.</figcaption>
      </figure>
      <section class="workflow-film" aria-labelledby="workflow-film-heading">
        <div class="workflow-film__copy">
          <p class="eyebrow">Motion proof / 16 seconds</p>
          <h3 id="workflow-film-heading">Lock the base. Change the layers. Prove the output.</h3>
          <p id="workflow-film-description">This is the system before a named character arrives. The film locks the canonical mannequin, separates face, hair, palette, and wardrobe as identity layers, then tests the same base through camera, scene, and motion.</p>
        </div>
        <figure class="workflow-film__media">
          <video
            controls
            muted
            playsinline
            preload="none"
            poster={workflowFilm.poster}
            aria-describedby="workflow-film-description"
          >
            <source src={workflowFilm.src} type="video/mp4" />
            Your browser cannot play this video. The static continuity board remains available above.
          </video>
          <img
            class="workflow-film__still"
            src={workflowFilmPoster.src}
            alt={workflowFilmPoster.alt}
            width={workflowFilmPoster.width}
            height={workflowFilmPoster.height}
            loading="lazy"
            decoding="async"
          />
          <figcaption>A HyperFrames demonstration built only from the supplied workflow board. Reduced-motion visitors receive this final static proof instead.</figcaption>
        </figure>
      </section>
    </Wrapper>
  </section>

  <section class="identity-section" aria-labelledby="identity-heading">
    <Wrapper variant="standard" class="section-space">
      <div class="section-intro section-intro--split">
        <div>
          <p class="eyebrow">Identity anchor</p>
          <h2 id="identity-heading">The face stays. The job changes.</h2>
        </div>
        <div>
          <p>The mannequin began as a single portrait. My first production move was turning that portrait into a clean front, back, and three-quarter sheet. That sheet became the reference layer for every outfit and scene below.</p>
          <p>The sheet does not make every later image identical. It gives each revision a known face, silhouette, and set of proportions to return to.</p>
        </div>
      </div>
      <div class="identity-media">
        <figure class="identity-portrait">
          <img
            src={preview(page.basePortrait, 900)}
            srcset={srcset(page.basePortrait)}
            sizes="(min-width: 900px) 34vw, 100vw"
            alt={page.basePortrait.alt}
            width={page.basePortrait.width}
            height={page.basePortrait.height}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{page.basePortrait.caption}</figcaption>
        </figure>
        <figure class="identity-sheet">
          <img
            src={preview(page.baseSheet, 1400)}
            srcset={srcset(page.baseSheet)}
            sizes="(min-width: 900px) 62vw, 100vw"
            alt={page.baseSheet.alt}
            width={page.baseSheet.width}
            height={page.baseSheet.height}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{page.baseSheet.caption}</figcaption>
        </figure>
      </div>
      <div class="identity-rules">
        <section>
          <p class="rule-label">Locked</p>
          <ul>
            <li>face and eye shape</li>
            <li>platinum pixie silhouette</li>
            <li>black hair clip</li>
            <li>body proportions</li>
            <li>eye-makeup identifier</li>
          </ul>
        </section>
        <section>
          <p class="rule-label">Variable</p>
          <ul>
            <li>garment construction</li>
            <li>jewelry, bag, footwear, and prop</li>
            <li>pose and camera</li>
            <li>scene and lighting</li>
            <li>motion treatment</li>
          </ul>
        </section>
      </div>
    </Wrapper>
  </section>

  <section id="assembly" class="assembly-section" aria-labelledby="assembly-heading">
    <Wrapper variant="standard" class="section-space">
      <header class="section-intro">
        <p class="eyebrow">The Character Assembly Line</p>
        <h2 id="assembly-heading">Three looks, kept open for inspection.</h2>
        <p>Each chapter defaults to the finished scene. Use the stage controls to move backward into the outfit and dressed character, or forward into the motion test. The source material stays close enough to check the decisions.</p>
      </header>
      <div class="assembly-grid">
        <aside class="identity-rail" data-identity-rail aria-label="Active mannequin and look index">
          <figure>
            <img
              src={preview(page.basePortrait, 700)}
              alt="Platinum mannequin identity anchor"
              width={page.basePortrait.width}
              height={page.basePortrait.height}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="identity-rail__copy">
            <p>Identity held through</p>
            <strong>face / pixie / clip / proportions / eye mark</strong>
          </div>
          <nav aria-label="Look chapters">
            {characterLooks.map((look) => (
              <a href={`#${look.id}`} data-look-index={look.id} style={`--index-accent:${look.accent}`}>
                <span>{String(look.displayOrder).padStart(2, "0")}</span>{look.shortTitle}
              </a>
            ))}
          </nav>
        </aside>
        <div class="look-chapters">
          {characterLooks.map((look, index) => (
            <>
              <CharacterLookChapter look={look} />
              {index === 1 && (
                <figure class="midpoint-graphic">
                  <img
                    src={preview(page.sceneTriptychGraphic)}
                    srcset={srcset(page.sceneTriptychGraphic)}
                    sizes="(min-width: 1180px) 54vw, 100vw"
                    alt={page.sceneTriptychGraphic.alt}
                    width={page.sceneTriptychGraphic.width}
                    height={page.sceneTriptychGraphic.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{page.sceneTriptychGraphic.caption}</figcaption>
                </figure>
              )}
            </>
          ))}
        </div>
      </div>
    </Wrapper>
  </section>

  <section class="new-identity-section" aria-labelledby="new-identity-heading">
    <Wrapper variant="standard" class="section-space">
      <div class="section-intro section-intro--split">
        <div>
          <p class="eyebrow">Beyond wardrobe</p>
          <h2 id="new-identity-heading">The same pipeline can build a new character.</h2>
        </div>
        <p>The green character is a separate identity, not the platinum mannequin with a filter. Skin, hair color, markings, makeup, and attitude change at the character-DNA level. The outfit, scene, and motion stages remain traceable.</p>
      </div>
      <div class="alternate-identity-media">
        <figure>
          <img
            src={preview(page.alternatePortrait, 800)}
            srcset={srcset(page.alternatePortrait)}
            sizes="(min-width: 900px) 32vw, 100vw"
            alt={page.alternatePortrait.alt}
            width={page.alternatePortrait.width}
            height={page.alternatePortrait.height}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{page.alternatePortrait.caption}</figcaption>
        </figure>
        <figure class="alternate-sheet">
          <img
            src={preview(page.alternateSheet, 1400)}
            srcset={srcset(page.alternateSheet)}
            sizes="(min-width: 900px) 64vw, 100vw"
            alt={page.alternateSheet.alt}
            width={page.alternateSheet.width}
            height={page.alternateSheet.height}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{page.alternateSheet.caption}</figcaption>
        </figure>
      </div>
      <figure class="themed-graphic">
        <img
          src={preview(page.themedCharacterGraphic)}
          srcset={srcset(page.themedCharacterGraphic)}
          sizes="(min-width: 1100px) 1120px, 100vw"
          alt={page.themedCharacterGraphic.alt}
          width={page.themedCharacterGraphic.width}
          height={page.themedCharacterGraphic.height}
          loading="lazy"
          decoding="async"
        />
        <figcaption>{page.themedCharacterGraphic.caption}</figcaption>
      </figure>
      <div class="themed-chapter"><CharacterLookChapter look={themedCharacter} compactHeader /></div>
    </Wrapper>
  </section>

  <section class="design-record" aria-labelledby="design-record-heading">
    <Wrapper variant="standard" class="section-space">
      <header class="section-intro section-intro--split">
        <div>
          <p class="eyebrow">The design record</p>
          <h2 id="design-record-heading">The picture is the output. The design record is the work.</h2>
        </div>
        <p>The tool can produce pixels. My job is deciding what belongs in the picture, what stays locked, what changes, what gets rejected, and how the same identity survives a new garment, location, camera, and motion pass. The finished scene sits beside its source material so the choices remain visible.</p>
      </header>
      <DesignDecisionMatrix decisions={designDecisions} />
    </Wrapper>
  </section>

  <section class="tool-note" aria-labelledby="tool-note-heading">
    <Wrapper variant="standard" class="section-space section-space--compact">
      <div class="tool-note__grid">
        <div>
          <p class="eyebrow">One method, different tools</p>
          <h2 id="tool-note-heading">The pipeline matters more than the app.</h2>
        </div>
        <div>
          <p>I used an ElevenLabs Flow to turn the original portrait into a production-ready character sheet, then a second Flow for the broader character workflow. Another image, video, or automation tool can fill those roles. The reusable part is the sequence, the identity locks, and the review record.</p>
          <div class="tool-links">
            <a href={page.elevenLabsCharacterSheetWorkflowUrl} target="_blank" rel="noopener noreferrer">Open the portrait-to-sheet Flow</a>
            <a href={page.elevenLabsAssemblyWorkflowUrl} target="_blank" rel="noopener noreferrer">Open the character workflow</a>
            <a href={page.elevenLabsAffiliateUrl} target="_blank" rel="sponsored nofollow noopener noreferrer">Try ElevenLabs (affiliate)</a>
          </div>
          <AffiliateDisclosure class="affiliate-disclosure" />
        </div>
      </div>
    </Wrapper>
  </section>

  <section class="offer-section" aria-labelledby="offer-heading">
    <Wrapper variant="standard" class="section-space">
      <div class="section-intro section-intro--split">
        <div>
          <p class="eyebrow">What can leave the Workshop</p>
          <h2 id="offer-heading">Buy the finished piece, or commission the whole build.</h2>
        </div>
        <p>The public page shows the process. Finished buyer files, approved licenses, and live prices belong in verified Shop records. Until those records exist, the shelf stays marked coming soon.</p>
      </div>
      <figure class="wardrobe-graphic">
        <img
          src={preview(page.wardrobeGraphic)}
          srcset={srcset(page.wardrobeGraphic)}
          sizes="(min-width: 1100px) 1120px, 100vw"
          alt={page.wardrobeGraphic.alt}
          width={page.wardrobeGraphic.width}
          height={page.wardrobeGraphic.height}
          loading="lazy"
          decoding="async"
        />
        <figcaption>{page.wardrobeGraphic.caption}</figcaption>
      </figure>
      <CharacterOfferShelf offers={characterOffers} products={relatedProducts} />
    </Wrapper>
  </section>

  <section class="commission-section" aria-labelledby="commission-heading">
    <Wrapper variant="standard" class="section-space section-space--compact">
      <div class="commission-block">
        <p class="eyebrow">Custom character work</p>
        <h2 id="commission-heading">Need a character that does not exist yet?</h2>
        <p>Bring a face, outfit, aesthetic, scene, story role, or rough reference pile. HobFarm can turn it into a locked character base, a finished scene, and an optional short video.</p>
        <a href={page.commissionUrl} class="button button--primary" data-event="character_page_commission_cta">Start a custom character brief</a>
      </div>
    </Wrapper>
  </section>

  <section class="related-section" aria-labelledby="related-heading">
    <Wrapper variant="standard" class="section-space">
      <header class="section-intro">
        <p class="eyebrow">Continue through HobFarm</p>
        <h2 id="related-heading">See the work, get the files, or learn the system.</h2>
      </header>
      <nav class="relationship-rail" aria-label="Related Workshop, Shop, character, and Academy routes">
        {relatedRoutes.map((item) => (
          <a href={item.href}>
            <span>{item.eyebrow}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <strong>{item.action} &rarr;</strong>
          </a>
        ))}
      </nav>
      <nav class="program-nav" aria-label="Workshop programs">
        {workshopPrograms.map((entry) => (
          <a class:list={[entry.id === "character-mannequin" && "active"]} href={entry.href}>{entry.name}</a>
        ))}
      </nav>
    </Wrapper>
  </section>
</div>

<script>
  const chapters = Array.from(document.querySelectorAll<HTMLElement>("[data-look-chapter]"));
  const assemblyChapters = Array.from(document.querySelectorAll<HTMLElement>("#assembly [data-look-chapter]"));

  chapters.forEach((chapter) => {
    chapter.classList.add("is-enhanced");
    const tabs = Array.from(chapter.querySelectorAll<HTMLButtonElement>("[data-stage-tab]"));
    const panels = Array.from(chapter.querySelectorAll<HTMLElement>("[data-stage-panel]"));

    const activate = (selected: HTMLButtonElement, moveFocus = false) => {
      const stage = selected.dataset.stage;
      tabs.forEach((tab) => {
        const active = tab === selected;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => panel.classList.toggle("is-active", panel.dataset.stage === stage));
      if (moveFocus) selected.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(tab));
      tab.addEventListener("keydown", (event) => {
        let nextIndex = index;
        if (event.key === "ArrowRight" || event.key === "ArrowDown") nextIndex = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft" || event.key === "ArrowUp") nextIndex = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === "Home") nextIndex = 0;
        else if (event.key === "End") nextIndex = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(tabs[nextIndex], true);
      });
    });
  });

  const videos = Array.from(document.querySelectorAll<HTMLVideoElement>("[data-character-video]"));
  videos.forEach((video) => {
    video.addEventListener("play", () => {
      videos.forEach((other) => {
        if (other !== video && !other.paused) other.pause();
      });
    });
  });

  if ("IntersectionObserver" in window) {
    const videoObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting && entry.target instanceof HTMLVideoElement) entry.target.pause();
      });
    }, { threshold: 0.1 });
    videos.forEach((video) => videoObserver.observe(video));

    const rail = document.querySelector<HTMLElement>("[data-identity-rail]");
    const indexLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-look-index]"));
    const setActiveLook = (chapter: HTMLElement) => {
      const id = chapter.dataset.lookId;
      const accent = chapter.style.getPropertyValue("--look-accent");
      if (rail && accent) rail.style.setProperty("--active-accent", accent);
      indexLinks.forEach((link) => {
        if (link.dataset.lookIndex === id) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      });
    };
    if (assemblyChapters[0]) setActiveLook(assemblyChapters[0]);
    const chapterObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && entry.target instanceof HTMLElement) setActiveLook(entry.target);
      });
    }, { rootMargin: "-22% 0px -58% 0px", threshold: 0 });
    assemblyChapters.forEach((chapter) => chapterObserver.observe(chapter));
  }
</script>

<style>
  .character-page { --ink: #07060b; --paper: #ece9f5; --muted: #aaa5b8; --line: #312a3e; overflow: clip; background: var(--ink); color: var(--paper); }
  .character-page :global(.hero-wrapper) { padding-top: clamp(2rem, 5vw, 4rem); padding-bottom: clamp(3rem, 8vw, 7rem); }
  .character-page :global(.section-space) { padding-top: clamp(4rem, 9vw, 8rem); padding-bottom: clamp(4rem, 9vw, 8rem); }
  .character-page :global(.section-space--compact) { padding-top: clamp(3rem, 6vw, 5rem); padding-bottom: clamp(3rem, 6vw, 5rem); }
  .character-hero { position: relative; border-bottom: 1px solid var(--line); background: radial-gradient(circle at 80% 10%, rgb(123 71 255 / .15), transparent 28rem), #08070d; }
  .character-hero::before { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(7 6 11 / .9), transparent 52%); content: ""; pointer-events: none; }
  .breadcrumbs { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: .55rem; color: #777184; font-family: var(--font-mono); font-size: .58rem; letter-spacing: .1em; text-transform: uppercase; }
  .breadcrumbs a { color: #aaa5b8; text-decoration: none; }
  .breadcrumbs a:hover { color: #fff; }
  .hero-grid { position: relative; z-index: 1; display: grid; gap: 2rem; align-items: center; margin-top: 2rem; }
  .hero-copy { max-width: 52rem; }
  .hero-grid--horizontal { align-items: start; gap: clamp(2rem, 4vw, 3.5rem); }
  .hero-grid--horizontal .hero-copy { max-width: none; }
  .hero-grid--horizontal .hero-copy h1 { width: 100%; max-width: none; font-size: clamp(3.4rem, 7.6vw, 7.5rem); line-height: .9; }
  .hero-grid--horizontal .hero-deck { max-width: 52rem; }
  .eyebrow { margin: 0; color: #65e1c2; font-family: var(--font-mono); font-size: .63rem; letter-spacing: .16em; text-transform: uppercase; }
  .hero-copy h1 { max-width: 13ch; margin: 1rem 0 0; color: #fff; font-family: var(--font-display); font-size: clamp(3.4rem, 8.2vw, 8.2rem); font-weight: 300; letter-spacing: -.065em; line-height: .86; text-wrap: balance; }
