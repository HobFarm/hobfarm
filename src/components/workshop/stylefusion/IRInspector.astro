---
type SlotSource = {
  slot: string;
  sourceReference: string;
  weight?: number;
  inheritance?: string;
  confidence?: number;
};

interface Props {
  styleAnchors: string[];
  slotSources: SlotSource[];
}

const { styleAnchors, slotSources } = Astro.props;
---

<section class="ir-inspector" aria-labelledby="ir-inspector-title">
  <header>
    <p>Intermediate Representation</p>
    <h3 id="ir-inspector-title">The IR keeps source lineage visible.</h3>
  </header>
  <div class="ir-inspector__grid">
    <div>
      <h4>Style anchors</h4>
      <ul class="ir-inspector__anchors">
        {styleAnchors.map((anchor) => <li>{anchor}</li>)}
      </ul>
    </div>
    <div>
      <h4>Compiled slot sources</h4>
      <div class="ir-inspector__table" role="table" aria-label="Compiled slot source metadata">
        <div class="ir-inspector__row is-heading" role="row">
          <span role="columnheader">Slot</span><span role="columnheader">Source</span><span role="columnheader">Weight</span><span role="columnheader">Confidence</span>
        </div>
        {slotSources.map((slot) => (
          <div class="ir-inspector__row" role="row">
            <span role="cell">{slot.slot}</span>
            <span role="cell">{slot.sourceReference}{slot.inheritance ? ` / inherited ${slot.inheritance}` : ""}</span>
            <span role="cell">{slot.weight ?? "n/a"}</span>
            <span role="cell">{slot.confidence === undefined ? "n/a" : slot.confidence.toFixed(2)}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .ir-inspector { padding: 1.25rem; border: 1px solid #2c2440; border-radius: .8rem; background: #0a0810; }
  header > p { margin: 0; color: #b78cff; font-family: var(--font-mono); font-size: .58rem; letter-spacing: .13em; text-transform: uppercase; }
  h3 { margin: .6rem 0 0; color: #fff; font-size: 1.25rem; font-weight: 500; }
  .ir-inspector__grid { display: grid; gap: 1.5rem; margin-top: 1.3rem; }
  h4 { margin: 0; color: #dcd8e6; font-family: var(--font-mono); font-size: .67rem; letter-spacing: .1em; text-transform: uppercase; }
  .ir-inspector__anchors { display: flex; flex-wrap: wrap; gap: .45rem; margin: .8rem 0 0; padding: 0; list-style: none; }
  .ir-inspector__anchors li { padding: .45rem .6rem; border: 1px solid #433559; border-radius: 999px; color: #bdb7c9; font-size: .68rem; }
  .ir-inspector__table { margin-top: .8rem; border: 1px solid #241d33; border-radius: .5rem; overflow: hidden; }
  .ir-inspector__row { display: grid; grid-template-columns: .8fr 1.5fr .65fr .75fr; gap: .4rem; padding: .65rem; border-top: 1px solid #241d33; color: #aaa5b8; font-family: var(--font-mono); font-size: .58rem; }
  .ir-inspector__row:first-child { border-top: 0; }
  .ir-inspector__row.is-heading { color: #7bdde7; background: #0e0b16; text-transform: uppercase; }
  .ir-inspector__row span { min-width: 0; overflow-wrap: anywhere; }
  @media (max-width: 560px) {
    .ir-inspector__row { grid-template-columns: 1fr 1.4fr; }
    .ir-inspector__row span:nth-child(3)::before { content: "weight "; color: #70697f; }
    .ir-inspector__row span:nth-child(4)::before { content: "confidence "; color: #70697f; }
    .ir-inspector__row.is-heading { display: none; }
  }
  @media (min-width: 940px) { .ir-inspector__grid { grid-template-columns: .7fr 1.3fr; } }
</style>
