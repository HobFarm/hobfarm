---
type CompiledDocument = {
  subject?: string;
  scene?: string;
  camera?: string;
  render?: string;
  style?: string;
  color?: string;
  texture?: string;
  lighting?: string;
  aspectRatio?: string;
};

interface Props {
  compiled: CompiledDocument;
  sourceDocument: string;
}

const { compiled, sourceDocument } = Astro.props;
const slots = [
  ["Subject", compiled.subject],
  ["Scene", compiled.scene],
  ["Camera", compiled.camera],
  ["Render", compiled.render],
  ["Style", compiled.style],
  ["Color", compiled.color],
  ["Texture", compiled.texture],
  ["Lighting", compiled.lighting],
  ["Aspect ratio", compiled.aspectRatio],
].filter((entry): entry is [string, string] => Boolean(entry[1]));
---

<section class="document-viewer" aria-labelledby="document-viewer-title">
  <header>
    <p>Compiled generation document</p>
    <h3 id="document-viewer-title">Readable slots, separate from the full diagnostic export.</h3>
  </header>
  <div class="document-viewer__slots">
    {slots.map(([label, value], index) => (
      <details open={index < 2}>
        <summary>{label}</summary>
        <p>{value}</p>
      </details>
    ))}
  </div>
  <details class="document-viewer__raw">
    <summary>Raw Complete Export status</summary>
    <div>
      <p><strong>Source document:</strong> {sourceDocument}</p>
      <p>The full source document stays local and is not copied into this page, linked as a download, or included in the initial HTML. This prototype shows a curated factual record only.</p>
    </div>
  </details>
</section>

<style>
  .document-viewer { padding: 1.25rem; border: 1px solid #2c2440; border-radius: .8rem; background: #0a0810; }
  header > p { margin: 0; color: #ff4fc3; font-family: var(--font-mono); font-size: .58rem; letter-spacing: .13em; text-transform: uppercase; }
  h3 { margin: .6rem 0 0; color: #fff; font-size: 1.25rem; font-weight: 500; line-height: 1.35; }
  .document-viewer__slots { display: grid; gap: .55rem; margin-top: 1.3rem; }
  details { border: 1px solid #241d33; border-radius: .5rem; background: #0e0b16; }
  summary { padding: .8rem; cursor: pointer; color: #dcd8e6; font-family: var(--font-mono); font-size: .67rem; letter-spacing: .08em; text-transform: uppercase; }
  summary:focus-visible { outline: 2px solid #55d7ff; outline-offset: 2px; }
  details > p, details > div { margin: 0; padding: 0 .8rem .9rem; color: #aaa5b8; font-size: .8rem; line-height: 1.65; }
  .document-viewer__raw { margin-top: 1rem; border-color: #5b466f; }
  .document-viewer__raw p { margin: .5rem 0 0; }
  .document-viewer__raw strong { color: #fff; }
  @media (min-width: 800px) { .document-viewer__slots { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
