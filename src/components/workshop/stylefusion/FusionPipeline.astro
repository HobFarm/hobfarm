---
type PipelineStep = {
  label: string;
  detail: string;
  boundary: "input" | "export" | "result" | "downstream";
};

interface Props {
  title?: string;
  steps: PipelineStep[];
}

const { title = "The application pipeline", steps } = Astro.props;
---

<div class="pipeline">
  <header>
    <p>Role-aware compilation</p>
    <h3>{title}</h3>
  </header>
  <ol>
    {steps.map((step, index) => (
      <li data-boundary={step.boundary}>
        <span>{String(index + 1).padStart(2, "0")} / {step.boundary}</span>
        <h4>{step.label}</h4>
        <p>{step.detail}</p>
      </li>
    ))}
  </ol>
</div>

<style>
  header > p { margin: 0; color: #ff4fc3; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .15em; text-transform: uppercase; }
  h3 { margin: .65rem 0 0; color: #fff; font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.6rem); font-weight: 300; letter-spacing: -.035em; line-height: 1; }
  ol { display: grid; gap: .75rem; margin: 1.75rem 0 0; padding: 0; list-style: none; }
  li { min-width: 0; min-height: 10rem; padding: 1rem; border: 1px solid #2c2440; border-top: 3px solid var(--step-accent, #55d7ff); border-radius: .45rem; background: #0e0b16; }
  li[data-boundary="export"] { --step-accent: #b78cff; }
  li[data-boundary="result"] { --step-accent: #ff4fc3; }
  li[data-boundary="downstream"] { --step-accent: #e6c15c; }
  li > span { color: var(--step-accent, #55d7ff); font-family: var(--font-mono); font-size: .56rem; letter-spacing: .1em; text-transform: uppercase; }
  h4 { margin: 2.1rem 0 0; color: #fff; font-size: .95rem; line-height: 1.3; }
  li > p { margin: .55rem 0 0; color: #9b96ad; font-size: .76rem; line-height: 1.55; }
  @media (min-width: 680px) { ol { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { ol { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
</style>
