---
type ReferenceRole = {
  id: string;
  role: string;
  label: string;
  weight?: number;
  notes?: string;
  image?: string;
  approvedForPublicDisplay: boolean;
};

interface Props {
  title?: string;
  references: ReferenceRole[];
}

const { title = "Reference roles", references } = Astro.props;
---

<div class="reference-deck">
  <header>
    <p class="eyebrow">Approved inputs</p>
    <h3>{title}</h3>
    <p>Each image has one explicit job. Private references stay outside the page until display approval is recorded.</p>
  </header>
  <ol>
    {references.map((reference, index) => {
      const publicImage = reference.approvedForPublicDisplay ? reference.image : undefined;
      return (
        <li>
          <div class="reference-deck__meta">
            <span>{String(index + 1).padStart(2, "0")} / {reference.role}</span>
            <span>weight {reference.weight ?? "not recorded"}</span>
          </div>
          {publicImage ? (
            <img src={publicImage} alt={reference.label} width="720" height="960" loading="lazy" decoding="async" />
          ) : (
            <p class="reference-deck__protected" role="note">
              Reference image withheld from the public page.
            </p>
          )}
          <h4>{reference.label}</h4>
          {reference.notes && <p>{reference.notes}</p>}
          <p class:list={["reference-deck__approval", reference.approvedForPublicDisplay && "is-approved"]}>
            {reference.approvedForPublicDisplay ? "Approved for public display" : "Private reference"}
          </p>
        </li>
      );
    })}
  </ol>
</div>

<style>
  .reference-deck > header { max-width: 48rem; }
  .eyebrow { margin: 0; color: #55d7ff; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .15em; text-transform: uppercase; }
  h3 { margin: .65rem 0 0; color: #fff; font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.6rem); font-weight: 300; letter-spacing: -.035em; line-height: 1; }
  header > p:last-child { margin: 1rem 0 0; color: #aaa5b8; line-height: 1.7; }
  ol { display: grid; gap: 1rem; margin: 1.75rem 0 0; padding: 0; list-style: none; }
  li { min-width: 0; padding: 1rem; border: 1px solid #2c2440; border-radius: .8rem; background: #0e0b16; }
  .reference-deck__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem; color: #7bdde7; font-family: var(--font-mono); font-size: .58rem; letter-spacing: .1em; text-transform: uppercase; }
  img { display: block; width: 100%; margin-top: 1rem; border-radius: .45rem; aspect-ratio: 3 / 4; object-fit: cover; }
  .reference-deck__protected { min-height: 8rem; margin: 1rem 0 0; padding: 1rem; display: flex; align-items: flex-end; border: 1px dashed #433559; border-radius: .5rem; color: #9b96ad; font-family: var(--font-mono); font-size: .7rem; line-height: 1.5; }
  h4 { margin: 1rem 0 0; color: #fff; font-size: 1rem; line-height: 1.35; }
  li > p:not(.reference-deck__protected,.reference-deck__approval) { margin: .55rem 0 0; color: #9b96ad; font-size: .8rem; line-height: 1.6; }
  .reference-deck__approval { margin: 1rem 0 0; color: #e49aa8; font-family: var(--font-mono); font-size: .6rem; letter-spacing: .1em; text-transform: uppercase; }
  .reference-deck__approval.is-approved { color: #8fe49f; }
  @media (min-width: 760px) { ol { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
