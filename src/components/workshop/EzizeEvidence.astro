---
import { getMedia } from "@/data/media-registry";

interface Props {
  priority?: boolean;
  compact?: boolean;
}

const { priority = false, compact = false } = Astro.props;
const app = getMedia("ezize.app.private-alpha");
const cake = getMedia("ezize.output.corrupted-cake");
---

<div class:list={["ezize-evidence", compact && "ezize-evidence--compact"]}>
  <figure class="ezize-evidence__app">
    <picture>
      <source srcset="/media/ezize/ezize-app-private-alpha-480.webp 480w, /media/ezize/ezize-app-private-alpha-640.webp 640w" sizes={compact ? "(min-width: 64rem) 36vw, 92vw" : "(min-width: 64rem) 32vw, 92vw"} />
      <img
        src={app.src}
        alt={app.alt}
        width={app.width}
        height={app.height}
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : undefined}
        decoding="async"
      />
    </picture>
    <figcaption><span>Application proof</span> Private-alpha probability machine, cropped to the public-safe generation window</figcaption>
  </figure>

  <figure class="ezize-evidence__output">
    <picture>
      <source srcset="/media/ezize/ezize-corrupted-cake-640.webp 640w, /media/ezize/ezize-corrupted-cake-1200.webp 1200w" sizes={compact ? "(min-width: 64rem) 48vw, 92vw" : "(min-width: 64rem) 42vw, 92vw"} />
      <img
        src={cake.src}
        alt={cake.alt}
        width={cake.width}
        height={cake.height}
        loading={priority ? "eager" : "lazy"}
        decoding="async"
      />
    </picture>
    <figcaption><span>Finished output</span> Corrupted Cake / deterministic development render</figcaption>
  </figure>
</div>

<style>
  .ezize-evidence {
    display: grid;
    gap: 0.8rem;
  }

  figure {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid #4b3f52;
    border-radius: 0.7rem;
    background: #09080a;
  }

  picture,
  img {
    display: block;
    width: 100%;
  }

  img {
    height: auto;
    background: #0e0d0c;
  }

  figcaption {
    padding: 0.75rem 0.85rem;
    border-top: 1px solid #342d38;
    color: #aaa3ae;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.03em;
    line-height: 1.55;
    text-transform: uppercase;
  }

  figcaption span {
    display: block;
    margin-bottom: 0.25rem;
    color: #dfff36;
  }

  @media (min-width: 48rem) {
    .ezize-evidence {
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
      align-items: start;
    }
  }

  @media (min-width: 64rem) {
    .ezize-evidence--compact {
      grid-template-columns: minmax(19rem, 0.7fr) minmax(0, 1.3fr);
    }
  }
</style>
