---
const stages = [
  { label: "Idea", detail: "Something seems worth investigating." },
  { label: "Build enough", detail: "Make the real thing, or enough of it to understand how it works." },
  { label: "Find the cost", detail: "APIs, hosting, production time, maintenance, distribution, and everything else become visible." },
  { label: "Decide what makes sense now", detail: "Keep developing it, use it privately, simplify it, publish what was learned, or park it for later." },
  { label: "Put it somewhere", detail: "Article, Workshop page, tool, image, video, project record, or another part of HobFarm." },
] as const;
---

<figure class="site-production" aria-labelledby="site-production-caption">
  <ol>
    {stages.map((stage, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><div><strong>{stage.label}</strong><p>{stage.detail}</p></div></li>)}
  </ol>
  <figcaption id="site-production-caption">The project does not have to become a business for the work to be useful.</figcaption>
</figure>

<style>
  .site-production { margin: 0; padding: 1rem; border: 1px solid #342b45; border-radius: .75rem; background: #09070e; }
  ol { display: grid; gap: .55rem; margin: 0; padding: 0; list-style: none; }
  li { position: relative; display: grid; grid-template-columns: 2.3rem 1fr; gap: .6rem; min-width: 0; padding: .8rem; border: 1px solid #342b45; background: #0e0b16; }
  li:not(:last-child)::after { position: absolute; right: 50%; bottom: -.6rem; z-index: 2; color: #55d7ff; content: "↓"; font-family: var(--font-mono); font-size: .7rem; }
  li > span { color: #55d7ff; font-family: var(--font-mono); font-size: .58rem; }
  li strong { color: #fff; font-size: .78rem; }
  li p { margin: .35rem 0 0; color: #9c96a7; font-size: .68rem; line-height: 1.5; }
  figcaption { margin-top: .75rem; padding: .65rem; border: 1px dashed #d04a93; color: #db71a9; font-family: var(--font-mono); font-size: .55rem; line-height: 1.55; text-align: center; text-transform: uppercase; }
  @media (min-width: 64rem) { ol { grid-template-columns: repeat(5, minmax(0, 1fr)); } li { grid-template-columns: 1fr; min-height: 10rem; } li:not(:last-child)::after { top: 1rem; right: -.65rem; bottom: auto; content: "→"; } }
</style>
