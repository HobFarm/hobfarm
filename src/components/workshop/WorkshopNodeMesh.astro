---
import { publicHobFarmEdges, publicHobFarmNodes } from "@/data/workshop-node-mesh";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const compactIds = new Set(["hobfarm-site", "articles", "workshop", "avatar-host", "future-carriage", "ezize", "other-alice", "presents"]);
const nodes = compact ? publicHobFarmNodes.filter((node) => compactIds.has(node.id)) : publicHobFarmNodes;
const visibleIds = new Set(nodes.map((node) => node.id));
const edges = publicHobFarmEdges.filter((edge) => visibleIds.has(edge.from) && visibleIds.has(edge.to));
const nodeById = new Map(nodes.map((node) => [node.id, node]));
---

<figure class:list={["node-mesh", compact && "node-mesh--compact"]} aria-labelledby={compact ? "compact-node-mesh-caption" : "node-mesh-caption"}>
  <ol class="node-mesh__nodes" aria-label="Curated HobFarm nodes">
    {nodes.map((node) => (
      <li class:list={[`kind-${node.kind}`, node.status && `status-${node.status}`]}>
        {node.href ? (
          <a href={node.href}><span>{node.kind}</span><strong>{node.label}</strong>{!compact && <p>{node.summary}</p>}</a>
        ) : (
          <div><span>{node.kind}</span><strong>{node.label}</strong>{!compact && <p>{node.summary}</p>}</div>
        )}
      </li>
    ))}
  </ol>
  <div class="node-mesh__relationships">
    <p>Relationships with jobs</p>
    <ul aria-label="Curated HobFarm relationships">
      {edges.map((edge) => {
        const from = nodeById.get(edge.from)!;
        const to = nodeById.get(edge.to)!;
        return (
          <li>
            {from.href ? <a href={from.href}>{from.label}</a> : <strong>{from.label}</strong>}
            <span>{edge.meaning}</span>
            {to.href ? <a href={to.href}>{to.label}</a> : <strong>{to.label}</strong>}
          </li>
        );
      })}
    </ul>
  </div>
  <figcaption id={compact ? "compact-node-mesh-caption" : "node-mesh-caption"}>
    {compact
      ? "A small preview of independently useful HobFarm work and the real relationships between it."
      : "This is a curated public view, not a registry of every page or file. Each relationship states the job it performs."}
  </figcaption>
</figure>

<style>
  .node-mesh { margin: 0; overflow: hidden; border: 1px solid #302744; border-radius: .8rem; background: radial-gradient(circle at 48% 18%, rgb(85 215 255 / .09), transparent 26rem), #09070e; }
  .node-mesh__nodes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; margin: 0; padding: 1rem; list-style: none; }
  .node-mesh__nodes li { min-width: 0; }
  .node-mesh__nodes a, .node-mesh__nodes li > div { display: flex; min-height: 8.5rem; flex-direction: column; padding: .85rem; border: 1px solid #393048; border-radius: .45rem; background: rgb(12 9 18 / .94); color: #f1edf6; text-decoration: none; }
  .node-mesh__nodes a:hover, .node-mesh__nodes a:focus-visible { border-color: #55d7ff; outline: 2px solid rgb(85 215 255 / .38); outline-offset: 2px; }
  .node-mesh__nodes span { color: #817b91; font-family: var(--font-mono); font-size: .5rem; letter-spacing: .1em; text-transform: uppercase; }
  .node-mesh__nodes strong { margin-top: .65rem; font-family: var(--font-display); font-size: clamp(1.15rem, 2vw, 1.7rem); font-weight: 400; line-height: 1; }
  .node-mesh__nodes p { margin: auto 0 0; padding-top: 1rem; color: #928c9e; font-size: .66rem; line-height: 1.5; }
  .kind-project a { border-color: #31505d; }
  .kind-workflow a { border-color: #5d4e31; }
  .kind-application a { border-color: #4f3b62; }
  .kind-infrastructure > div { border-style: dashed !important; border-color: #644365 !important; }
  .kind-record a { border-color: #5d4e31; }
  .node-mesh__relationships { border-top: 1px solid #302744; background: #0d0a13; }
  .node-mesh__relationships > p { margin: 0; padding: .8rem 1rem; color: #817b91; font-family: var(--font-mono); font-size: .52rem; letter-spacing: .1em; text-transform: uppercase; }
  .node-mesh__relationships ul { display: grid; gap: 1px; margin: 0; padding: 1px 0 0; background: #302744; list-style: none; }
  .node-mesh__relationships li { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: .7rem; align-items: center; padding: .7rem 1rem; background: #0d0a13; color: #c5c0cf; font-size: .66rem; }
  .node-mesh__relationships li strong:last-child, .node-mesh__relationships li a:last-child { text-align: right; }
  .node-mesh__relationships a { color: #e9e4f0; text-decoration-color: #514969; text-underline-offset: .2rem; }
  .node-mesh__relationships a:hover, .node-mesh__relationships a:focus-visible { color: #55d7ff; text-decoration-color: currentColor; }
  .node-mesh__relationships span { color: #55d7ff; font-family: var(--font-mono); font-size: .48rem; letter-spacing: .07em; text-align: center; text-transform: uppercase; }
  figcaption { padding: .8rem 1rem; border-top: 1px solid #302744; color: #8f899e; font-family: var(--font-mono); font-size: .56rem; line-height: 1.55; text-transform: uppercase; }
  .node-mesh--compact .node-mesh__nodes a, .node-mesh--compact .node-mesh__nodes li > div { min-height: 5rem; justify-content: space-between; }
  .node-mesh--compact .node-mesh__relationships li { font-size: .6rem; }
  @media (min-width: 48rem) {
    .node-mesh__nodes { grid-template-columns: repeat(4, minmax(0, 1fr)); padding: 1.5rem; }
    .node-mesh--compact .node-mesh__nodes { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .node-mesh__relationships ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 26rem) {
    .node-mesh__relationships li { grid-template-columns: 1fr; gap: .3rem; }
    .node-mesh__relationships li strong:last-child, .node-mesh__relationships li a:last-child { text-align: left; }
    .node-mesh__relationships span { text-align: left; }
  }
</style>
