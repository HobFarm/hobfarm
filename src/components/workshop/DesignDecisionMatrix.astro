---
import type { DesignDecision } from "@/data/character-mannequin";

interface Props {
  decisions: DesignDecision[];
}

const { decisions } = Astro.props;
---

<div class="decision-matrix">
  <div class="decision-matrix__header" aria-hidden="true">
    <span>Design layer</span>
    <span>Decision</span>
    <span>Visible result</span>
  </div>
  <ol>
    {decisions.map((row, index) => (
      <li>
        <div class="decision-label">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{row.label}</h3>
        </div>
        <p><strong>Decision</strong>{row.decision}</p>
        <p><strong>Visible result</strong>{row.result}</p>
      </li>
    ))}
  </ol>
</div>

<style>
  .decision-matrix { margin-top: 2rem; border-block: 1px solid #312a3e; }
  .decision-matrix__header { display: none; }
  .decision-matrix ol { margin: 0; padding: 0; list-style: none; }
  .decision-matrix li { display: grid; gap: 1rem; padding: 1.2rem 0; border-bottom: 1px solid #211c2b; }
  .decision-matrix li:last-child { border-bottom: 0; }
  .decision-label { display: grid; grid-template-columns: 2.2rem 1fr; gap: .5rem; align-items: baseline; }
  .decision-label span { color: #65e1c2; font-family: var(--font-mono); font-size: .58rem; }
  .decision-label h3 { margin: 0; color: #ece9f5; font-size: .95rem; font-weight: 500; }
  .decision-matrix p { margin: 0; color: #9f9aad; font-size: .82rem; line-height: 1.65; }
  .decision-matrix p strong { display: block; margin-bottom: .35rem; color: #6f697b; font-family: var(--font-mono); font-size: .56rem; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; }
  @media (min-width: 860px) {
    .decision-matrix__header { display: grid; grid-template-columns: minmax(12rem, .8fr) repeat(2, minmax(0, 1fr)); gap: 1.5rem; padding: .75rem 0; border-bottom: 1px solid #312a3e; color: #6f697b; font-family: var(--font-mono); font-size: .56rem; letter-spacing: .1em; text-transform: uppercase; }
    .decision-matrix li { grid-template-columns: minmax(12rem, .8fr) repeat(2, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
    .decision-matrix p strong { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
</style>
