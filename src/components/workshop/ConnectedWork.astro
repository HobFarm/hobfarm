---
interface Link {
  label: string;
  href: string;
  relationship: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  links: readonly Link[];
}

const { eyebrow = "Connected work", title = "Follow the useful relationship.", links } = Astro.props;
---

<aside class="connected-work" aria-labelledby="connected-work-heading">
  <div><p>{eyebrow}</p><h2 id="connected-work-heading">{title}</h2></div>
  <nav aria-label={eyebrow}>
    {links.map((link) => <a href={link.href}><span>{link.relationship}</span><strong>{link.label}</strong><b aria-hidden="true">&rarr;</b></a>)}
  </nav>
</aside>

<style>
  .connected-work { display: grid; gap: 1.3rem; padding: clamp(1rem, 3vw, 1.6rem); border: 1px solid #352b49; border-radius: .75rem; background: #0d0a13; }
  p { margin: 0; color: #55d7ff; font-family: var(--font-mono); font-size: .58rem; letter-spacing: .12em; text-transform: uppercase; }
  h2 { margin: .6rem 0 0; color: #fff; font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 3rem); font-weight: 300; line-height: 1; }
  nav { display: grid; gap: .5rem; }
  a { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .4rem 1rem; padding: .8rem; border: 1px solid #352b49; color: #eeeaf3; text-decoration: none; }
  a:hover, a:focus-visible { border-color: #55d7ff; outline: none; }
  a span { grid-column: 1; color: #918b9e; font-family: var(--font-mono); font-size: .52rem; letter-spacing: .06em; text-transform: uppercase; }
  a strong { grid-column: 1; font-size: .78rem; font-weight: 500; }
  a b { grid-column: 2; grid-row: 1 / 3; align-self: center; color: #55d7ff; font-weight: 400; }
  @media (min-width: 48rem) { .connected-work { grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); align-items: start; } }
</style>
