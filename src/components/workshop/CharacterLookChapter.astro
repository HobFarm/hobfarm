---
import type { CharacterLook, MediaRef } from "@/data/character-mannequin";
import { imageSrcset, transformImageUrl } from "@/lib/media-transforms";

interface Props {
  look: CharacterLook;
}

const { look } = Astro.props;
const accents: Record<string, string> = {
  "01": "#ffe768",
  "02": "#87e9ff",
  "03": "#65e1c2",
};
const stages = [
  { key: "outfit", label: "Outfit", media: look.outfit },
  { key: "character", label: "Character", media: look.character },
  { key: "scene", label: "Scene", media: look.scene },
  { key: "motion", label: "Motion", media: look.motion },
] as const;
const axisLabel = look.axis === "identity" ? "Different mannequin" : "Same mannequin";
const recordLabel = look.axis === "identity" ? "What changed and what stayed" : "What changed";
const preview = (media: MediaRef, width = 1100) =>
  transformImageUrl(media.src, { width, quality: 82, fit: "scale-down" });
const srcset = (media: MediaRef) =>
  imageSrcset(media.src, [480, 720, 960, 1200], { quality: 82, fit: "scale-down" });
---

<article
  id={look.id}
  class:list={["look-chapter", `look-chapter--${look.axis}`]}
  style={`--look-accent:${accents[look.index] ?? "#87e9ff"}`}
  data-look-chapter
  data-look-id={look.id}
  data-look-axis={look.axis}
>
  <header class="look-header">
    <p class="look-number">{look.index} / {axisLabel}</p>
    <h3>{look.title}</h3>
    <p>{look.dek}</p>
    {look.axis === "identity" && (
      <p class="axis-note">The first two examples restyle the blonde mannequin. This example keeps the black leather look and applies it to a different mannequin and rendering style.</p>
    )}
  </header>

  <div class="stage-tabs" role="tablist" aria-label={`${look.title} production stages`}>
    {stages.map((stage) => (
      <button
        id={`${look.id}-${stage.key}-tab`}
        type="button"
        role="tab"
        aria-selected={stage.key === "character" ? "true" : "false"}
        aria-controls={`${look.id}-${stage.key}-panel`}
        tabindex={stage.key === "character" ? "0" : "-1"}
        data-stage-tab
        data-stage={stage.key}
        data-event="character_look_stage_change"
        data-look-id={look.id}
      >
        {stage.label}
      </button>
    ))}
  </div>

  <div class="stage-panels">
    {stages.map((stage) => (
      <section
        id={`${look.id}-${stage.key}-panel`}
        class:list={["stage-panel", stage.key === "character" && "is-active"]}
        role="tabpanel"
        aria-labelledby={`${look.id}-${stage.key}-tab`}
        data-stage-panel
        data-stage={stage.key}
      >
        <div class="stage-label" aria-hidden="true">{stage.label}</div>
        <figure class="stage-media" style={`--media-ratio:${stage.media.width}/${stage.media.height}`}>
          {stage.key === "motion" ? (
            <video
              src={stage.media.src}
              poster={stage.media.poster ? preview({ ...stage.media, src: stage.media.poster }, 900) : undefined}
              controls
              muted
              playsinline
              preload="none"
              aria-label={stage.media.alt}
              data-character-video
              data-event="character_video_play"
              data-look-id={look.id}
            ></video>
          ) : (
            <img
              src={preview(stage.media)}
              srcset={srcset(stage.media)}
              sizes="(min-width: 1180px) 58vw, (min-width: 760px) 82vw, 100vw"
              alt={stage.media.alt}
              width={stage.media.width}
              height={stage.media.height}
              loading="lazy"
              decoding="async"
            />
          )}
          <figcaption>
            <span>{stage.media.caption}</span>
            {stage.key === "motion" && <small>{stage.media.alt}</small>}
          </figcaption>
        </figure>
      </section>
    ))}
  </div>

  <details class="look-record" data-event="character_process_notes_open" data-look-id={look.id}>
    <summary>{recordLabel}</summary>
    <div class="look-record__body">
      <ul>{look.changed.map((item) => <li>{item}</li>)}</ul>
      <p><strong>Continuity note.</strong> {look.productionNote}</p>
    </div>
  </details>
</article>

<style>
  .look-chapter { scroll-margin-top: 6rem; padding: clamp(1.1rem,3vw,2.25rem); border:1px solid color-mix(in srgb,var(--look-accent) 38%,#2c2440); background:linear-gradient(155deg,color-mix(in srgb,var(--look-accent) 7%,#0c0912),#08070c 48%); box-shadow:0 0 4rem color-mix(in srgb,var(--look-accent) 5%,transparent); }
  .look-chapter--identity { border-width:2px; }
  .look-header { max-width:48rem; }
  .look-number { margin:0; color:var(--look-accent); font-family:var(--font-mono); font-size:.62rem; letter-spacing:.16em; text-transform:uppercase; }
  .look-header h3 { margin:.75rem 0 0; color:#fff; font-family:var(--font-display); font-size:clamp(2.15rem,5.5vw,4.8rem); font-weight:300; letter-spacing:-.05em; line-height:.94; text-wrap:balance; }
  .look-header>p:not(.look-number) { max-width:40rem; margin:1rem 0 0; color:#c1bdca; line-height:1.7; }
  .axis-note { padding-left:1rem; border-left:2px solid var(--look-accent); }
  .stage-tabs { display:none; gap:.35rem; margin-top:1.5rem; padding:.3rem; border:1px solid #312a3e; background:#050407; }
  .is-enhanced .stage-tabs { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); }
  .stage-tabs button { min-height:2.9rem; border:1px solid transparent; background:transparent; color:#8e899b; cursor:pointer; font-family:var(--font-mono); font-size:.64rem; letter-spacing:.08em; text-transform:uppercase; }
  .stage-tabs button:hover { color:#fff; }
  .stage-tabs button[aria-selected="true"] { border-color:color-mix(in srgb,var(--look-accent) 55%,#312a3e); background:color-mix(in srgb,var(--look-accent) 10%,#0b0911); color:#fff; }
  .stage-tabs button:focus-visible,summary:focus-visible { outline:2px solid var(--look-accent); outline-offset:3px; }
  .stage-panels { margin-top:1rem; }
  .stage-panel+.stage-panel { margin-top:2rem; }
  .is-enhanced .stage-panel:not(.is-active) { display:none; }
  .is-enhanced .stage-panel+.stage-panel { margin-top:0; }
  .stage-label { margin-bottom:.55rem; color:var(--look-accent); font-family:var(--font-mono); font-size:.62rem; letter-spacing:.12em; text-transform:uppercase; }
  .is-enhanced .stage-label { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
  .stage-media { margin:0; overflow:hidden; border:1px solid #312a3e; background:#050407; }
  .stage-media img,.stage-media video { display:block; width:100%; height:auto; max-height:min(78svh,58rem); aspect-ratio:var(--media-ratio); object-fit:contain; background:#050407; }
  .stage-media figcaption { display:grid; gap:.25rem; padding:.8rem 1rem; border-top:1px solid #312a3e; color:#aaa5b8; font-family:var(--font-mono); font-size:.6rem; letter-spacing:.08em; line-height:1.5; text-transform:uppercase; }
  .stage-media figcaption small { color:#777184; font-family:var(--font-sans); font-size:.72rem; letter-spacing:0; text-transform:none; }
  .look-record { margin-top:1rem; border:1px solid #312a3e; background:#0a0810; }
  .look-record summary { min-height:3rem; padding:1rem; color:#ece9f5; cursor:pointer; font-family:var(--font-mono); font-size:.65rem; letter-spacing:.1em; text-transform:uppercase; }
  .look-record__body { display:grid; gap:1rem; padding:0 1rem 1rem; }
  .look-record ul { margin:0; padding-left:1.15rem; color:#aaa5b8; font-size:.82rem; line-height:1.7; }
  .look-record p { margin:0; padding-top:1rem; border-top:1px solid #312a3e; color:#aaa5b8; font-size:.82rem; line-height:1.7; }
  .look-record strong { color:#ece9f5; }
  @media(max-width:520px){.is-enhanced .stage-tabs{grid-template-columns:repeat(2,minmax(0,1fr));}}
  @media(prefers-reduced-motion:reduce){.stage-tabs button{transition:none;}}
</style>
