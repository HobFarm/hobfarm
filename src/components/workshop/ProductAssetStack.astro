---
import type { AssetManifestRef } from "@/lib/content-relationships";

interface Props {
  items: AssetManifestRef[];
  title?: string;
  description?: string;
}

const { items, title = "Product asset stack", description = "Public previews explain the packet without exposing buyer files." } = Astro.props;
const previewItems = items.filter((item) => item.preview);
---

<section class="asset-stack" aria-labelledby="asset-stack-title">
  <header><p>Preview boundary</p><h2 id="asset-stack-title">{title}</h2><span>{description}</span></header>
  <div class="asset-stack__stage">
    {previewItems.map((item, index) => (
      <figure style={`--layer:${index};--layers:${previewItems.length}`}>
        <img src={item.preview} alt={`${item.label} public preview`} loading="lazy" decoding="async" />
        <figcaption><span>{item.role}</span><strong>{item.label}</strong><code>{item.id}</code></figcaption>
      </figure>
    ))}
  </div>
  {items.some((item) => item.buyerFile) && <p class="asset-stack__boundary">Buyer-file entries are named in the manifest but never loaded into this page.</p>}
</section>

<style>
  .asset-stack header > p { margin: 0; color: #f0c96b; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; }
  .asset-stack h2 { margin: .6rem 0 0; color: #fff; font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 300; }
  .asset-stack header > span { display: block; max-width: 42rem; margin-top: .8rem; color: #9b96ad; line-height: 1.6; }
  .asset-stack__stage { display: grid; gap: .8rem; margin-top: 1.5rem; }
  figure { display: grid; grid-template-columns: minmax(8rem, .35fr) 1fr; min-width: 0; margin: 0; overflow: hidden; border: 1px solid #2c2440; border-radius: .8rem; background: #0e0b16; }
  img { width: 100%; height: 100%; min-height: 10rem; object-fit: cover; object-position: top; }
  figcaption { display: flex; min-width: 0; flex-direction: column; justify-content: center; padding: 1rem; }
  figcaption span { color: #f0c96b; font-family: var(--font-mono); font-size: .56rem; letter-spacing: .12em; text-transform: uppercase; }
  figcaption strong { margin-top: .55rem; color: #fff; font-weight: 500; }
  figcaption code { margin-top: .75rem; color: #6b6580; font-family: var(--font-mono); font-size: .65rem; }
  .asset-stack__boundary { margin: 1rem 0 0; color: #9b96ad; font-size: .78rem; }
  @media (min-width: 900px) { .asset-stack__stage { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
