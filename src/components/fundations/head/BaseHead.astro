---
import Seo from "@/components/fundations/head/Seo.astro";
import Meta from "@/components/fundations/head/Meta.astro";
import Fonts from "@/components/fundations/head/Fonts.astro";
import Favicons from "@/components/fundations/head/Favicons.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  type,
  publishedTime,
  modifiedTime,
  tags,
  structuredData,
  noindex,
} = Astro.props;
---

<Seo
  title={title}
  description={description}
  canonical={canonical}
  image={image}
  imageAlt={imageAlt}
  type={type}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  tags={tags}
  structuredData={structuredData}
  noindex={noindex}
/>
<Meta />
<Fonts />
<Favicons />
