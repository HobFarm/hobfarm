---
import { imageSrcset, transformImageUrl } from "@/lib/media-transforms";
import type { StoryPanel } from "@/data/homepage-systems";

interface Props {
  panel: StoryPanel;
  class?: string;
}

const { panel, class: className = "" } = Astro.props;

const accentClass = {
  cyan: {
    text: "text-accent-cyan",
    border: "border-accent-cyan/40",
    bg: "bg-accent-cyan/10",
    dot: "bg-accent-cyan",
    glow: "glow-green",
  },
  magenta: {
    text: "text-accent-magenta-bright",
    border: "border-accent-magenta/40",
    bg: "bg-accent-magenta/10",
    dot: "bg-accent-magenta",
    glow: "glow-violet",
  },
  green: {
    text: "text-accent-green",
    border: "border-accent-green/40",
    bg: "bg-accent-green/10",
    dot: "bg-accent-green",
    glow: "glow-green",
  },
  blue: {
    text: "text-accent-blue-bright",
    border: "border-accent-blue/40",
    bg: "bg-accent-blue/10",
    dot: "bg-accent-blue",
    glow: "glow-violet",
  },
  gold: {
    text: "text-accent-gold",
    border: "border-accent-gold/40",
    bg: "bg-accent-gold/10",
    dot: "bg-accent-gold",
    glow: "glow-violet",
  },
}[panel.accent];

function srcFor(src: string, width: number): string {
  return transformImageUrl(src, { width, quality: 82, fit: "cover" });
}

function srcsetFor(src: string): string {
  return imageSrcset(src, [320, 480, 720, 960], { quality: 82, fit: "cover" });
}
---

<figure
  class:list={[
    "overflow-hidden rounded-lg border border-base-800 bg-base-900/60 shadow-dimensional",
    className,
  ]}
>
  <div class="grid grid-cols-1 lg:grid-cols-[0.95fr_1.05fr]">
    <div class="border-b border-base-800 bg-base-950/55 p-4 sm:p-5 lg:border-b-0 lg:border-r">
      <div class="grid grid-cols-3 gap-2">
        {panel.images.map((image, index) => (
          <div
            class:list={[
              "group relative overflow-hidden rounded-md border border-base-800 bg-base-950",
              index === 0 ? "col-span-3 aspect-[16/7] sm:col-span-2 sm:row-span-2 sm:aspect-auto" : "aspect-square",
            ]}
          >
            <img
              src={srcFor(image.src, index === 0 ? 960 : 480)}
              srcset={srcsetFor(image.src)}
              sizes={index === 0 ? "(min-width: 1024px) 26rem, 100vw" : "12rem"}
              alt={image.alt}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover opacity-85 transition duration-700 group-hover:scale-[1.04] group-hover:opacity-100"
            />
            <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-base-950 via-base-950/70 to-transparent p-2">
              <span class:list={["font-mono text-[9px] uppercase tracking-widest", accentClass.text]}>
                {image.label}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="p-4 sm:p-5">
      <div class="flex items-center gap-3">
        <span class:list={["size-2 rounded-full shadow-[0_0_16px_currentColor]", accentClass.text, accentClass.dot]} aria-hidden="true"></span>
        <p class:list={["font-mono text-[10px] uppercase tracking-widest", accentClass.text]}>
          {panel.label}
        </p>
        <div class="h-px flex-1 bg-base-800"></div>
      </div>

      <h3 class="mt-4 font-display text-2xl leading-tight text-white sm:text-3xl">
        {panel.title}
      </h3>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-base-400">
        {panel.copy}
      </p>

      <div class="mt-5 grid grid-cols-1 gap-2 sm:grid-cols-3">
        {panel.callouts.map((item) => (
          <div class:list={["rounded-md border px-3 py-2", accentClass.border, accentClass.bg]}>
            <p class="font-mono text-[9px] uppercase tracking-widest text-base-400">{item.label}</p>
            <p class="mt-1 text-xs leading-snug text-base-100">{item.value}</p>
          </div>
        ))}
      </div>

      <div class="mt-5 rounded-md border border-base-800 bg-base-950/60 p-3">
        <p class="mb-3 font-mono text-[9px] uppercase tracking-widest text-base-400">Path through the system</p>
        <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center">
          {panel.flow.map((step, index) => (
            <>
              <span class="rounded-full border border-base-700 px-3 py-1.5 font-mono text-[10px] uppercase tracking-wider text-base-200">
                {step}
              </span>
              {index < panel.flow.length - 1 && (
                <span aria-hidden="true" class:list={["hidden font-mono text-xs sm:inline", accentClass.text]}>
                  &rarr;
                </span>
              )}
            </>
          ))}
        </div>
      </div>
    </div>
  </div>
</figure>
