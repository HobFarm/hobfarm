---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { editorialSections, editorialSectionPath } from "@/data/editorial-mesh";
import { articlePath, getArticleDate, getPublishedArticles } from "@/lib/articles";

const articles = await getPublishedArticles();
const sections = editorialSections.map((section) => {
  const posts = articles.filter((article) => article.data.mesh?.section === section.slug);
  return { ...section, posts, newest: posts[0] };
});
---

<section id="explore-editorial-sections" class="border-b border-base-800/70" aria-labelledby="explore-sections-heading">
  <Wrapper variant="standard" class="py-12 lg:py-16">
    <header class="max-w-3xl">
      <p class="font-mono text-[10px] uppercase tracking-[.16em] text-accent-magenta-bright">The Editorial map</p>
      <h2 id="explore-sections-heading" class="mt-2 font-display text-3xl font-light text-white">Explore by section</h2>
      <p class="mt-3 text-sm leading-relaxed text-base-400">Six primary sections organize the archive. Specials and subjects cut across them without becoming duplicate desks.</p>
    </header>

    <div class="section-overview">
      {sections.map((section, index) => (
        <article class:list={["section-overview__card", index === 0 || index === 3 ? "section-overview__card--wide" : ""]} style={`--section-accent:${section.accent}`}>
          <a href={editorialSectionPath(section.slug)} class="section-overview__main">
            <span>{section.posts.length} published</span>
            <h3>{section.label}</h3>
            <p>{section.blurb}</p>
            <strong>Open section &rarr;</strong>
          </a>
          {section.newest && (
            <a href={articlePath(section.newest)} class="section-overview__latest">
              <span>Newest</span>
              <strong>{section.newest.data.title}</strong>
              <time datetime={getArticleDate(section.newest).toISOString()}>
                {getArticleDate(section.newest).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}
              </time>
            </a>
          )}
        </article>
      ))}
    </div>
  </Wrapper>
</section>

<style>
  .section-overview { display: grid; gap: .75rem; margin-top: 1.5rem; }
  .section-overview__card { display: grid; border: 1px solid #2c2440; border-top: 2px solid var(--section-accent); border-radius: .75rem; overflow: hidden; background: #0e0b16a8; }
  .section-overview__main, .section-overview__latest { color: inherit; text-decoration: none; }
  .section-overview__main { display: flex; flex-direction: column; min-height: 14rem; padding: 1.25rem; }
  .section-overview__main > span, .section-overview__latest > span, .section-overview__latest time { color: #8f899f; font-family: var(--font-mono); font-size: .58rem; letter-spacing: .1em; text-transform: uppercase; }
  .section-overview__main h3 { margin: .8rem 0 0; color: #fff; font-family: var(--font-display); font-size: 1.55rem; font-weight: 300; }
  .section-overview__main p { margin: .7rem 0 0; color: #aaa5ba; font-size: .8rem; line-height: 1.55; }
  .section-overview__main > strong { margin-top: auto; padding-top: 1rem; color: var(--section-accent); font-family: var(--font-mono); font-size: .62rem; font-weight: 400; letter-spacing: .08em; text-transform: uppercase; }
  .section-overview__latest { display: grid; gap: .45rem; border-top: 1px solid #2c2440; padding: 1rem 1.25rem; }
  .section-overview__latest strong { color: #ece9f5; font-size: .82rem; font-weight: 400; line-height: 1.35; }
  .section-overview__card a:hover strong { color: #fff; }
  @media (min-width: 720px) { .section-overview { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .section-overview { grid-template-columns: repeat(4, 1fr); } .section-overview__card--wide { grid-column: span 2; } }
</style>
