---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import { getMedia } from "@/data/media-registry";
import { getWorkshopProject } from "@/data/workshop-projects";

const futureCarriage = getWorkshopProject("future-carriage")!;
const hero = getMedia("workshop.ami-legacy.hero");
const comparisons = [
  {
    label: "02 / Enclosed coach",
    title: "A diligence coach becomes an autonomous vehicle",
    description: "The orange cabin, lamps, four-wheel stance, and passenger compartment carry into the electric concept.",
    historical: getMedia("workshop.ami-legacy.history.diligence"),
    modern: getMedia("workshop.ami-legacy.autonomous-coach"),
    source: "PICRYL source / Public domain / CC0 1.0",
  },
  {
    label: "03 / Two-wheel gig",
    title: "Brewster No. 3917 becomes Model 3917",
    description: "The wheel, seat, shafts, and open silhouette stay visible while a robotic draft unit replaces the horse.",
    historical: getMedia("workshop.ami-legacy.history.gig-3917"),
    modern: getMedia("workshop.ami-legacy.model-3917.vehicle"),
    source: "The Met Open Access / Public domain",
  },
] as const;
const spokesperson = getMedia("workshop.ami-legacy.model-3917.ami");
---

<section class="future-carriage border-b border-base-800/70" aria-labelledby="future-carriage-heading">
  <Wrapper variant="standard" class="py-16 lg:py-24">
    <header class="future-carriage__heading">
      <div>
        <p>Flagship concept-to-campaign case</p>
        <h2 id="future-carriage-heading">A historical drawing becomes a modern vehicle, then a campaign.</h2>
      </div>
      <div>
        <p>
          Future Carriage starts with 19th-century carriage drawings and carries their useful operating and visual logic into electric, robotic, and autonomous concepts. Model 3917 then meets Ami, a spokesperson built through HobFarm's avatar workflow.
        </p>
        <strong>Self-directed HobFarm concept campaign. The vehicle and transport service do not exist.</strong>
      </div>
    </header>

    <figure class="future-carriage__hero">
      <span>01 / Legacy campaign hero</span>
      <div>
        <img
          src={hero.src}
          alt={hero.alt}
          width={hero.width}
          height={hero.height}
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption>Legacy carries the historical carriage language into a complete campaign image with Ami, the vehicle, and its robotic pulling system in one frame.</figcaption>
    </figure>

    <section class="future-carriage__comparisons" aria-labelledby="future-carriage-comparisons-heading">
      <header>
        <p>Source to product</p>
        <h3 id="future-carriage-comparisons-heading">The old drawing stays beside the new machine.</h3>
      </header>
      <div class="future-carriage__comparison-grid">
        {comparisons.map((comparison) => (
          <article class="future-carriage__comparison">
            <header>
              <span>{comparison.label}</span>
              <h4>{comparison.title}</h4>
              <p>{comparison.description}</p>
            </header>
            <div class="future-carriage__pair">
              <figure class="future-carriage__pair-source">
                <img
                  src={comparison.historical.src}
                  alt={comparison.historical.alt}
                  width={comparison.historical.width}
                  height={comparison.historical.height}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>Historical drawing <small>{comparison.source}</small></figcaption>
              </figure>
              <figure>
                <img
                  src={comparison.modern.src}
                  alt={comparison.modern.alt}
                  width={comparison.modern.width}
                  height={comparison.modern.height}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>Modern concept</figcaption>
              </figure>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="future-carriage__spokesperson" aria-labelledby="future-carriage-spokesperson-heading">
      <header>
        <p>04 / Avatar spokesperson</p>
        <h3 id="future-carriage-spokesperson-heading">Ami carries Model 3917 into the campaign.</h3>
        <p class="future-carriage__spokesperson-copy">The same avatar workflow used to build a repeatable character now gives the vehicle a recognizable host.</p>
      </header>
      <figure>
        <img
          src={spokesperson.src}
          alt={spokesperson.alt}
          width={spokesperson.width}
          height={spokesperson.height}
          loading="lazy"
          decoding="async"
        />
        <figcaption>Model 3917 with Ami as its campaign spokesperson</figcaption>
      </figure>
    </section>

    <div class="future-carriage__actions">
      <Button
        isLink
        size="md"
        variant="green"
        href={futureCarriage.destination}
        data-event="homepage_future_carriage_open"
      >
        Open the complete case study
      </Button>
      <Button
        isLink
        size="md"
        variant="muted"
        href="/contact/?subject=creative-project"
        data-event="homepage_project_inquiry_begin"
        data-source-placement="future-carriage"
      >
        Start a project
      </Button>
    </div>
  </Wrapper>
</section>

<style>
  .future-carriage {
    background:
      radial-gradient(circle at 85% 18%, rgb(197 147 75 / 0.16), transparent 32rem),
      #090807;
  }

  .future-carriage__heading {
    display: grid;
    gap: 1.5rem;
  }

  .future-carriage__heading > div:first-child > p {
    margin: 0;
    color: #d3a75f;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .future-carriage__heading h2 {
    max-width: 68rem;
    margin: 0.8rem 0 0;
    color: #f4f0e8;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 300;
    letter-spacing: -0.055em;
    line-height: 0.93;
  }

  .future-carriage__heading > div:last-child > p {
    max-width: 46rem;
    margin: 0;
    color: #b8b0a5;
    line-height: 1.75;
  }

  .future-carriage__heading > div:last-child > strong {
    display: block;
    max-width: 46rem;
    margin-top: 1rem;
    color: #e3c18f;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .future-carriage__hero,
  .future-carriage__comparison,
  .future-carriage__spokesperson figure {
    margin: 0;
    overflow: hidden;
    border: 1px solid #473b30;
    background: rgb(14 12 10 / 0.84);
  }

  .future-carriage__hero {
    margin-top: 2.5rem;
  }

  .future-carriage__hero > span,
  .future-carriage__comparison > header > span {
    display: block;
    padding: 0.75rem;
    border-bottom: 1px solid #473b30;
    color: #d3a75f;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .future-carriage__hero > div {
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .future-carriage__hero img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .future-carriage__hero figcaption {
    padding: 0.85rem 1rem;
    color: #a99f92;
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .future-carriage__comparisons,
  .future-carriage__spokesperson {
    margin-top: 3rem;
  }

  .future-carriage__comparisons > header > p,
  .future-carriage__spokesperson > header > p:first-child {
    margin: 0;
    color: #d3a75f;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .future-carriage__comparisons > header h3,
  .future-carriage__spokesperson > header h3 {
    max-width: 48rem;
    margin: 0.55rem 0 0;
    color: #f4f0e8;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .future-carriage__comparison-grid {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .future-carriage__comparison > header > span {
    padding: 0.65rem 0.8rem;
  }

  .future-carriage__comparison > header h4 {
    margin: 1rem 1rem 0;
    color: #f4f0e8;
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 350;
    line-height: 1.1;
  }

  .future-carriage__comparison > header p {
    margin: 0.6rem 1rem 1rem;
    color: #aaa195;
    font-size: 0.75rem;
    line-height: 1.55;
  }

  .future-carriage__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid #473b30;
  }

  .future-carriage__pair figure {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: #0a0908;
  }

  .future-carriage__pair figure + figure {
    border-left: 1px solid #473b30;
  }

  .future-carriage__pair img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .future-carriage__pair-source img {
    padding: 0.4rem;
    object-fit: contain;
    background: #eee8db;
  }

  .future-carriage__pair figcaption,
  .future-carriage__spokesperson figcaption {
    padding: 0.65rem 0.75rem;
    border-top: 1px solid #473b30;
    color: #d8d0c5;
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.06em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .future-carriage__pair figcaption small {
    display: block;
    margin-top: 0.25rem;
    color: #8f877d;
    font-size: 0.48rem;
    letter-spacing: 0.03em;
  }

  .future-carriage__spokesperson-copy {
    max-width: 48rem;
    margin: 0.75rem 0 0;
    color: #aaa195;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .future-carriage__spokesperson figure {
    margin-top: 1.25rem;
  }

  .future-carriage__spokesperson img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .future-carriage__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 64rem) {
    .future-carriage__heading {
      grid-template-columns: minmax(0, 1.15fr) minmax(24rem, 0.62fr);
      align-items: end;
    }

    .future-carriage__comparison-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

  }

  @media (max-width: 32rem) {
    .future-carriage__pair {
      grid-template-columns: 1fr;
    }

    .future-carriage__pair figure + figure {
      border-top: 1px solid #473b30;
      border-left: 0;
    }
  }
</style>
