---
// Recent videos strip for the homepage. Pulls gallery pieces whose hero is a
// video (or that live in the motion lane), so it stays in sync as new motion
// work is published. Links through to the full /video hub.
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import GalleryCard from "@/components/gallery/GalleryCard.astro";
import { getCollection } from "astro:content";

const clips = (await getCollection("gallery"))
  .filter((e) => !e.data.draft && (e.data.hero.type === "video" || e.data.type === "video-workflow"))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .slice(0, 4);
---

{clips.length > 0 && (
  <section class="border-b border-base-800/70">
    <Wrapper variant="standard" class="py-14 lg:py-16">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-accent-violet-bright">Video</p>
          <h2 class="mt-2 text-2xl font-display text-white">Recent videos</h2>
        </div>
        <a href="/presents/hobfarm-tv/" class="text-sm text-base-400 transition-colors hover:text-white">
          All video
        </a>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {clips.map((entry) => <GalleryCard entry={entry} />)}
      </div>
    </Wrapper>
  </section>
)}
