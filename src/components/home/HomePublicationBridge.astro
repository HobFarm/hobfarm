---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const circuit = [
  { label: "Source", detail: "archive, image, script, character, product, or reference pile" },
  { label: "Workshop", detail: "research, constraints, visual system, direction, and record" },
  { label: "Published work", detail: "story, world, campaign, film, application, or gallery" },
  { label: "Next form", detail: "course, product, new release, or the next project" },
] as const;
---

<section class="publication-bridge border-b border-base-800/70" aria-labelledby="publication-bridge-heading">
  <Wrapper variant="standard" class="py-14 lg:py-20">
    <div class="publication-bridge__intro">
      <div>
        <p>How HobFarm fits together</p>
        <h2 id="publication-bridge-heading">The publication is made in the Workshop.</h2>
      </div>
      <div class="publication-bridge__copy">
        <p>
          Some projects begin with an archive. Others begin with a photograph, a character, a script, a product, or a pile of references that almost makes sense.
        </p>
        <p>
          HobFarm researches the source, defines what must stay fixed, builds the visual system, directs the finished media, and keeps a record that can support the next release.
        </p>
      </div>
    </div>

    <ol class="publication-bridge__circuit" aria-label="How work moves through HobFarm">
      {circuit.map((item, index) => (
        <li>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{item.label}</strong>
          <p>{item.detail}</p>
        </li>
      ))}
    </ol>
  </Wrapper>
</section>

<style>
  .publication-bridge {
    background:
      radial-gradient(circle at 16% 40%, rgb(25 227 227 / 0.08), transparent 28rem),
      #09080e;
  }

  .publication-bridge__intro {
    display: grid;
    gap: 1.5rem;
  }

  .publication-bridge__intro > div:first-child > p {
    margin: 0;
    color: #19e3e3;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 54rem;
    margin: 0.75rem 0 0;
    color: #f0edf6;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 6vw, 5.4rem);
    font-weight: 300;
    letter-spacing: -0.05em;
    line-height: 0.96;
  }

  .publication-bridge__copy {
    max-width: 44rem;
  }

  .publication-bridge__copy p {
    margin: 0;
    color: #b2acb9;
    line-height: 1.75;
  }

  .publication-bridge__copy p + p {
    margin-top: 0.8rem;
  }

  .publication-bridge__circuit {
    display: grid;
    gap: 0.55rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .publication-bridge__circuit li {
    position: relative;
    min-height: 9rem;
    padding: 1rem;
    border: 1px solid #332a43;
    border-top: 2px solid #19e3e3;
    background: rgb(14 11 22 / 0.7);
  }

  .publication-bridge__circuit li:not(:last-child)::after {
    content: "→";
    position: absolute;
    right: -0.55rem;
    bottom: 0.55rem;
    z-index: 1;
    display: none;
    color: #19e3e3;
    font-family: var(--font-mono);
  }

  .publication-bridge__circuit span {
    color: #6a6472;
    font-family: var(--font-mono);
    font-size: 0.55rem;
  }

  .publication-bridge__circuit strong {
    display: block;
    margin-top: 1.2rem;
    color: #efeaf4;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .publication-bridge__circuit p {
    margin: 0.55rem 0 0;
    color: #9f99a7;
    font-size: 0.72rem;
    line-height: 1.55;
  }

  @media (min-width: 42rem) {
    .publication-bridge__circuit {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .publication-bridge__intro {
      grid-template-columns: minmax(0, 1.15fr) minmax(24rem, 0.65fr);
      align-items: end;
    }

    .publication-bridge__circuit {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .publication-bridge__circuit li:not(:last-child)::after {
      display: block;
    }
  }
</style>
