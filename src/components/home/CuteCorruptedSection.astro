---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import BeforeAfterCompare from "@/components/ui/BeforeAfterCompare.astro";
import { cuteCorrupted } from "@/data/homepage-systems";
import { getCuteCorruptedBranches } from "@/lib/cute-corrupted";

// Branches are built live from their gallery entries. An unfinished branch
// (no entry yet, e.g. cakes before assets land) is skipped automatically.
const branches = await getCuteCorruptedBranches();
const defaultKey = branches.some((b) => b.key === cuteCorrupted.defaultBranch)
  ? cuteCorrupted.defaultBranch
  : branches[0]?.key;
---

{branches.length > 0 && (
  <section id="cute-corrupted" class="border-b border-base-800/70">
    <Wrapper variant="standard" class="py-16 lg:py-20">
      <div class="max-w-2xl">
        <Text tag="span" variant="textSM" class="font-mono uppercase tracking-widest text-accent-cyan">
          {cuteCorrupted.eyebrow}
        </Text>
        <Text tag="h2" variant="displayLG" class="mt-5 font-display text-white">
          {cuteCorrupted.heading}
        </Text>
        <p class="mt-5 text-base leading-relaxed text-base-400">{cuteCorrupted.copy}</p>
      </div>

      <div
        class="mt-8 flex flex-wrap gap-2"
        role="tablist"
        aria-label="Cute and Corrupted branches"
        data-cc-tablist
      >
        {branches.map((branch) => (
          <button
            type="button"
            role="tab"
            id={`cc-tab-${branch.key}`}
            data-cc-tab={branch.key}
            aria-controls={`cc-panel-${branch.key}`}
            aria-selected={branch.key === defaultKey}
            tabindex={branch.key === defaultKey ? 0 : -1}
            class="rounded-full border border-base-700 px-4 py-2 font-mono text-[11px] uppercase tracking-widest text-base-400 transition-colors aria-selected:border-accent-cyan/50 aria-selected:bg-accent-cyan/10 aria-selected:text-accent-cyan hover:text-white"
          >
            {branch.label}
          </button>
        ))}
      </div>

      {branches.map((branch) => (
        <div
          id={`cc-panel-${branch.key}`}
          role="tabpanel"
          aria-labelledby={`cc-tab-${branch.key}`}
          data-cc-panel={branch.key}
          hidden={branch.key !== defaultKey}
          class="mt-6"
        >
          <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1.3fr_0.7fr] lg:items-start">
            <BeforeAfterCompare
              before={branch.before}
              after={branch.after}
              video={branch.video}
              fit="contain"
              aspect={branch.aspect}
              ariaLabel={`${branch.label}: cute and corrupted comparison`}
            />

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-1">
              <div class="rounded-lg border border-accent-cyan/30 bg-base-950/60 p-5">
                <p class="font-mono text-[10px] uppercase tracking-widest text-accent-cyan">Locked</p>
                <p class="mt-1 text-xs text-base-500">The same-subject read</p>
                <ul class="mt-4 space-y-2.5">
                  {branch.locked.map((trait) => (
                    <li class="flex items-start gap-2.5 text-sm leading-snug text-base-200">
                      <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent-cyan" aria-hidden="true"></span>
                      {trait}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="rounded-lg border border-accent-magenta/30 bg-base-950/60 p-5">
                <p class="font-mono text-[10px] uppercase tracking-widest text-accent-magenta-bright">Changed</p>
                <p class="mt-1 text-xs text-base-500">The surface language</p>
                <ul class="mt-4 space-y-2.5">
                  {branch.changed.map((trait) => (
                    <li class="flex items-start gap-2.5 text-sm leading-snug text-base-200">
                      <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-accent-magenta" aria-hidden="true"></span>
                      {trait}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <div class="mt-6 flex flex-col gap-4 border-t border-base-800/70 pt-5 sm:flex-row sm:items-center sm:justify-between">
            <p class="max-w-2xl text-sm leading-relaxed text-base-400">{branch.blurb}</p>
            <Button isLink size="sm" variant="green" href={branch.href} class="shrink-0">
              Open the {branch.label} page
            </Button>
          </div>
        </div>
      ))}

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="font-mono text-xs uppercase tracking-widest text-base-500">{cuteCorrupted.cta}</p>
        <a href={cuteCorrupted.landingHref} class="text-sm text-base-300 transition-colors hover:text-accent-cyan">
          Explore the full series
        </a>
      </div>
    </Wrapper>
  </section>
)}

<script>
  function initCuteCorrupted(root: HTMLElement) {
    if (root.dataset.ccBound === "true") return;
    root.dataset.ccBound = "true";

    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-cc-tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-cc-panel]"));
    if (!tabs.length) return;

    const select = (key: string, focus = false) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.ccTab === key;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.ccPanel !== key;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab.dataset.ccTab || ""));
      tab.addEventListener("keydown", (e) => {
        let next: number | null = null;
        if (e.key === "ArrowRight" || e.key === "ArrowDown") next = (index + 1) % tabs.length;
        else if (e.key === "ArrowLeft" || e.key === "ArrowUp") next = (index - 1 + tabs.length) % tabs.length;
        else if (e.key === "Home") next = 0;
        else if (e.key === "End") next = tabs.length - 1;
        if (next !== null) {
          e.preventDefault();
          select(tabs[next].dataset.ccTab || "", true);
        }
      });
    });
  }

  function initAllCuteCorrupted() {
    document.querySelectorAll<HTMLElement>("#cute-corrupted").forEach(initCuteCorrupted);
  }

  initAllCuteCorrupted();
  document.addEventListener("astro:page-load", initAllCuteCorrupted);
</script>
