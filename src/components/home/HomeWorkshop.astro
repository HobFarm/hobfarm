---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import WorkshopNodeMesh from "@/components/workshop/WorkshopNodeMesh.astro";
---

<section id="home-workshop" class="home-workshop" aria-labelledby="home-workshop-heading">
  <Wrapper variant="standard" class="py-16 lg:py-24">
    <header class="home-workshop__header">
      <div>
        <p class="eyebrow">How HobFarm works</p>
        <h2 id="home-workshop-heading">Useful work can stand alone and still connect.</h2>
      </div>
      <div class="home-workshop__copy">
        <p>HobFarm is built from Articles, projects, methods, applications, and media that can stand alone, connect to related work, or combine into something new.</p>
        <p>Articles are the largest public reading surface, so the homepage remains article-forward. The underlying system can begin anywhere, and each finished object keeps one canonical home.</p>
      </div>
    </header>

    <div class="mesh-preview"><WorkshopNodeMesh compact /></div>

    <div class="actions">
      <Button isLink size="md" variant="green" href="/workshop/" data-event="homepage_workshop_open">Explore the Workshop</Button>
      <Button isLink size="md" variant="muted" href="/workshop/projects/hobfarm/" data-event="homepage_projects_open">How the HobFarm system works</Button>
    </div>

  </Wrapper>
</section>

<style>
  .home-workshop { border-bottom: 1px solid #2c2440; background: radial-gradient(circle at 10% 8%, rgb(59 111 224 / .14), transparent 34rem), radial-gradient(circle at 92% 54%, rgb(224 33 138 / .08), transparent 38rem), #07060b; }
  .home-workshop__header { display: grid; gap: 1.5rem; }
  .eyebrow { margin: 0; color: #55d7ff; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .16em; text-transform: uppercase; }
  h2 { color: #f0edf6; font-family: var(--font-display); font-weight: 300; letter-spacing: -.055em; text-wrap: balance; }
  h2 { max-width: 68rem; margin: .8rem 0 0; font-size: clamp(3rem, 7.2vw, 6rem); line-height: .93; }
  .home-workshop__copy { max-width: 45rem; }
  .home-workshop__copy p { margin: 0; color: #b4afbc; line-height: 1.75; }
  .home-workshop__copy p + p { margin-top: .8rem; }
  .mesh-preview { margin-top: clamp(2.5rem, 6vw, 4.5rem); }
  .actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1rem; }
  @media (min-width: 64rem) {
    .home-workshop__header { grid-template-columns: minmax(0, 1.2fr) minmax(24rem, .62fr); align-items: end; }
  }
  @media (max-width: 34rem) {
    .actions :global(a) { width: 100%; justify-content: center; }
  }
</style>
