---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import WorkshopProjectGrid from "@/components/workshop/WorkshopProjectGrid.astro";
import WorkshopMethodStrip from "@/components/workshop/WorkshopMethodStrip.astro";
import WorkshopProcessFilm from "@/components/workshop/WorkshopProcessFilm.astro";
import { workshopProcessFilm } from "@/data/workshop-process-film";
---

<section
  id="home-workshop"
  class="home-workshop border-b border-base-800/70"
  aria-labelledby="home-workshop-heading"
>
  <Wrapper variant="standard" class="py-16 lg:py-24">
    <header class="home-workshop__header">
      <div>
        <p class="home-workshop__label">Workshop</p>
        <h2 id="home-workshop-heading">Start with an idea. Build the visual system that makes it work.</h2>
      </div>
      <p>
        Products, photographs, archives, characters, stories, and software all pass through the Workshop. Each project develops its own references, rules, production material, and finished media.
      </p>
    </header>

    <section class="home-workshop__projects" aria-labelledby="home-workshop-projects-heading">
      <div class="home-workshop__section-heading">
        <p class="home-workshop__label">Selected work</p>
        <h3 id="home-workshop-projects-heading">Five projects. Five different production problems.</h3>
      </div>
      <WorkshopProjectGrid surface="home" />

      <div class="home-workshop__process">
        <div class="home-workshop__process-film">
          <WorkshopProcessFilm
            manifest={workshopProcessFilm}
            variant="vertical"
            id="homepage-workshop-process"
            showTranscript={false}
            showReferenceStrip={false}
            showNavigator={false}
            autoplay={true}
            loop={true}
            compact={true}
          />
        </div>
        <div class="home-workshop__process-copy">
          <p class="home-workshop__label">Character process / Zima</p>
          <h3>One identity, from brief to motion.</h3>
          <p>
            The Zima film follows a written brief through a neutral mannequin, visual-language rules, wardrobe, camera direction, and a published avatar clip. It remains one character-production example inside the wider Workshop.
          </p>
          <a href="/workshop/#process-film" data-event="workshop_full_process_opened">
            Watch the full process and read the transcript <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <section class="home-workshop__method" aria-labelledby="home-workshop-method-heading">
      <div class="home-workshop__method-heading">
        <div>
          <p class="home-workshop__label">Compact method</p>
          <h3 id="home-workshop-method-heading">Research. Define. Build. Direct. Finish.</h3>
        </div>
        <p>
          AI tools can enter at several points. The durable work is the source record, brief, continuity rules, camera plan, edit, and delivery packet that keep the project usable.
        </p>
      </div>
      <WorkshopMethodStrip compact={true} />
    </section>

    <div class="home-workshop__actions">
      <Button isLink size="md" variant="green" href="/workshop/">Enter the Workshop</Button>
      <Button
        isLink
        size="md"
        variant="muted"
        href="/contact/?subject=creative-project"
        data-event="workshop_project_inquiry_clicked"
      >
        Start a project
      </Button>
    </div>
  </Wrapper>
</section>

<style>
  .home-workshop {
    background:
      radial-gradient(circle at 10% 8%, rgb(59 111 224 / 0.14), transparent 34rem),
      radial-gradient(circle at 92% 54%, rgb(224 33 138 / 0.08), transparent 38rem),
      #07060b;
  }

  .home-workshop__header,
  .home-workshop__method-heading {
    display: grid;
    gap: 1.5rem;
  }

  .home-workshop__label {
    margin: 0;
    color: #55d7ff;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .home-workshop__header h2 {
    max-width: 64rem;
    margin: 0.8rem 0 0;
    color: #f0edf6;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 7.5vw, 6.2rem);
    font-weight: 300;
    letter-spacing: -0.055em;
    line-height: 0.93;
    text-wrap: balance;
  }

  .home-workshop__header > p,
  .home-workshop__method-heading > p {
    max-width: 44rem;
    margin: 0;
    color: #b4afbc;
    line-height: 1.75;
  }

  .home-workshop__projects {
    margin-top: 4rem;
  }

  .home-workshop__section-heading {
    max-width: 54rem;
    margin-bottom: 1.5rem;
  }

  .home-workshop__section-heading h3,
  .home-workshop__process-copy h3,
  .home-workshop__method-heading h3 {
    margin: 0.65rem 0 0;
    color: #f0edf6;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    font-weight: 300;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .home-workshop__process {
    display: grid;
    gap: 1rem;
    align-items: center;
    max-width: 62rem;
    margin: 1.5rem auto 0;
    padding: 1rem;
    border: 1px solid #2c2440;
    border-left: 3px solid #3b6fe0;
    border-radius: 0.75rem;
    background: rgb(14 11 22 / 0.72);
  }

  .home-workshop__process-film {
    width: min(100%, 17rem);
    margin-inline: auto;
  }

  .home-workshop__process-copy > p:not(.home-workshop__label) {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: #aaa5b3;
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .home-workshop__process-copy a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-top: 1.2rem;
    color: #7bdde7;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .home-workshop__process-copy a:focus-visible {
    outline: 2px solid #55d7ff;
    outline-offset: 4px;
  }

  .home-workshop__method {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid #2c2440;
  }

  .home-workshop__method :global(.workshop-method-strip) {
    margin-top: 1.5rem;
  }

  .home-workshop__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 2rem;
  }

  @media (min-width: 48rem) {
    .home-workshop__process {
      grid-template-columns: minmax(12rem, 0.32fr) minmax(0, 1fr);
      padding: 1.25rem;
    }
  }

  @media (min-width: 64rem) {
    .home-workshop__header,
    .home-workshop__method-heading {
      grid-template-columns: minmax(0, 1.2fr) minmax(24rem, 0.62fr);
      align-items: end;
    }
  }
</style>
