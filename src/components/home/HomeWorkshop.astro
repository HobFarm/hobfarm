---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import WorkshopMethodStrip from "@/components/workshop/WorkshopMethodStrip.astro";
import { getWorkshopProject } from "@/data/workshop-projects";

const beforeAfter = getWorkshopProject("before-after")!;
const character = getWorkshopProject("character-mannequin")!;
const styleFusion = getWorkshopProject("stylefusion")!;
const otherAlice = getWorkshopProject("other-alice-world")!;

const evidenceLabels = [
  "Documentary / then",
  "Documentary / later",
  "Historical source",
  "Alternate future",
] as const;

const characterProofs = [
  {
    media: character.approvedAssets[0],
    label: "02 / Neutral system",
    description: "Proportions, identity slots, wardrobe categories, camera coverage, scene direction, and motion tests are designed around one base.",
  },
  {
    media: character.approvedAssets[1],
    label: "03 / Visual language",
    description: "Hair, palette, material, makeup, garment, and symbol choices become an inspectable board.",
  },
  {
    media: character.approvedAssets[2],
    label: "04 / Character profile",
    description: "A specific identity is applied after the underlying continuity rules are stable.",
  },
  {
    media: character.approvedAssets[3],
    label: "05 / Motion proof",
    description: "The same record carries into a directed film without hiding the handoffs that produced it.",
  },
] as const;

const stageLabel = (index: number) => String(index + 1).padStart(2, "0");
---

<section
  id="home-workshop"
  class="home-workshop border-b border-base-800/70"
  aria-labelledby="home-workshop-heading"
>
  <Wrapper variant="standard" class="py-16 lg:py-24">
    <header class="home-workshop__header">
      <div>
        <p class="home-workshop__eyebrow">Workshop capability overview</p>
        <h2 id="home-workshop-heading">Different source material. A production system built for each job.</h2>
      </div>
      <p>
        The Workshop builds around each project's source material. It identifies what must stay fixed, builds the evidence and continuity record, then develops the still, motion, story, interface, or campaign the project needs.
      </p>
    </header>

    <div class="capability-stack">
      <article class="capability capability--evidence" data-capability={beforeAfter.id}>
        <header class="capability__heading">
          <div>
            <p class="home-workshop__eyebrow">{beforeAfter.projectType}</p>
            <h3>{beforeAfter.title}</h3>
          </div>
          <p>{beforeAfter.promise}</p>
        </header>

        <div class="capability__body capability__body--evidence">
          <div class="evidence-board" aria-label="Before and After comparison modes">
            {beforeAfter.approvedAssets.map((asset, index) => (
              <figure class:list={[index > 1 && "evidence-board__speculative"]}>
                <img
                  src={asset.src}
                  alt={asset.alt}
                  width={asset.width}
                  height={asset.height}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{evidenceLabels[index]}</figcaption>
              </figure>
            ))}
          </div>
          <div class="capability__record">
            <dl>
              <div><dt>Starts with</dt><dd>{beforeAfter.startingMaterial}</dd></div>
              <div><dt>Production problem</dt><dd>{beforeAfter.productionProblem}</dd></div>
            </dl>
            <ol aria-label={`${beforeAfter.title} stages`}>
              {beforeAfter.stages.map((stage, index) => (
                <li><span>{stageLabel(index)}</span>{stage}</li>
              ))}
            </ol>
            <a href={beforeAfter.destination} data-event="homepage_capability_open" data-capability-id={beforeAfter.id}>
              Inspect the comparison record <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </article>

      <article class="capability capability--character" data-capability={character.id}>
        <header class="capability__heading">
          <div>
            <p class="home-workshop__eyebrow">{character.projectType}</p>
            <h3>{character.title}</h3>
          </div>
          <p>{character.promise}</p>
        </header>

        <ol class="production-rail" aria-label="Character production sequence">
          <li class="production-rail__brief">
            <span>01 / Brief or portrait</span>
            <p>Identity, role, age, proportions, and the traits that cannot drift.</p>
          </li>
          {characterProofs.map((proof) => (
            <li>
              <img
                src={proof.media.src}
                alt={proof.media.alt}
                width={proof.media.width}
                height={proof.media.height}
                loading="lazy"
                decoding="async"
              />
              <div>
                <span>{proof.label}</span>
                <p>{proof.description}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="capability__footer">
          <p><strong>Starts with:</strong> {character.startingMaterial}</p>
          <p><strong>Can become:</strong> {character.possibleOutputs.join(", ")}.</p>
          <a href={character.destination} data-event="homepage_capability_open" data-capability-id={character.id}>
            Open the character system <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </article>

      <article class="capability capability--compiler" data-capability={styleFusion.id}>
        <header class="capability__heading">
          <div>
            <p class="home-workshop__eyebrow">{styleFusion.projectType}</p>
            <h3>{styleFusion.title}</h3>
          </div>
          <p>{styleFusion.promise}</p>
        </header>

        <div class="compiler">
          <div class="compiler__references" aria-label="Approved references with assigned roles">
            {styleFusion.approvedAssets.slice(0, 2).map((asset, index) => (
              <figure>
                <img
                  src={asset.src}
                  alt={asset.alt}
                  width={asset.width}
                  height={asset.height}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{index === 0 ? "Role: interface and source record" : "Role: directed output"}</figcaption>
              </figure>
            ))}
          </div>
          <div class="compiler__spec">
            <p class="compiler__label">Analysis and specification</p>
            <dl>
              <div><dt>Subject</dt><dd>Observed identity and anatomy</dd></div>
              <div><dt>Style</dt><dd>Rendering evidence and exclusions</dd></div>
              <div><dt>Scene</dt><dd>Composition, camera, light, and environment</dd></div>
              <div><dt>Record</dt><dd>Roles, weighting, provenance, and decisions</dd></div>
            </dl>
          </div>
          <div class="compiler__diagnostic">
            <span>Diagnostic / corrected result</span>
            <strong>Subject extraction failed</strong>
            <p>A rejected result remains useful when the record explains what drifted and what must change.</p>
          </div>
        </div>

        <div class="capability__footer">
          <p><strong>Starts with:</strong> {styleFusion.startingMaterial}</p>
          <p><strong>Can become:</strong> {styleFusion.possibleOutputs.join(", ")}.</p>
          <a href={styleFusion.destination} data-event="homepage_capability_open" data-capability-id={styleFusion.id}>
            Inspect StyleFusion <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </article>

      <article class="capability capability--world" data-capability={otherAlice.id}>
        <div class="world-teaser">
          <figure>
            <img
              src={otherAlice.approvedAssets[0].src}
              alt={otherAlice.approvedAssets[0].alt}
              width={otherAlice.approvedAssets[0].width}
              height={otherAlice.approvedAssets[0].height}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="world-teaser__copy">
            <p class="home-workshop__eyebrow">{otherAlice.projectType}</p>
            <h3>{otherAlice.title}</h3>
            <p>{otherAlice.promise}</p>
            <ol aria-label="Other Alice world system">
              {otherAlice.stages.map((stage, index) => (
                <li><span>{stageLabel(index)}</span>{stage}</li>
              ))}
            </ol>
            <div class="world-teaser__actions">
              <a href="#wonder-machine">See the interactive proof below <span aria-hidden="true">&darr;</span></a>
              <a href={otherAlice.destination} data-event="homepage_capability_open" data-capability-id={otherAlice.id}>
                Open the world record <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </article>
    </div>

    <section class="home-workshop__method" aria-labelledby="home-workshop-method-heading">
      <div class="home-workshop__method-heading">
        <div>
          <p class="home-workshop__eyebrow">Five-stage method</p>
          <h3 id="home-workshop-method-heading">Research. Define. Build. Direct. Finish and deliver.</h3>
        </div>
        <p>
          Each stage produces something inspectable: source notes, constraints, production assets, directed media, and a delivery record. The two cases below show the method holding together a growing world and a concept campaign.
        </p>
      </div>
      <WorkshopMethodStrip compact={true} />
    </section>

    <div class="home-workshop__actions">
      <Button isLink size="md" variant="green" href="/workshop/" data-event="homepage_workshop_open">
        Explore the Workshop
      </Button>
      <Button
        isLink
        size="md"
        variant="muted"
        href="/contact/?subject=creative-project"
        data-event="homepage_project_inquiry_begin"
      >
        Start a project
      </Button>
    </div>
  </Wrapper>
</section>

<style>
  .home-workshop {
    background:
      radial-gradient(circle at 10% 8%, rgb(59 111 224 / 0.14), transparent 34rem),
      radial-gradient(circle at 92% 54%, rgb(224 33 138 / 0.08), transparent 38rem),
      #07060b;
  }

  .home-workshop__header,
  .home-workshop__method-heading,
  .capability__heading {
    display: grid;
    gap: 1.5rem;
  }

  .home-workshop__eyebrow {
    margin: 0;
    color: #55d7ff;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .home-workshop__header h2 {
    max-width: 70rem;
    margin: 0.8rem 0 0;
    color: #f0edf6;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 7.2vw, 6rem);
    font-weight: 300;
    letter-spacing: -0.055em;
    line-height: 0.93;
    text-wrap: balance;
  }

  .home-workshop__header > p,
  .home-workshop__method-heading > p,
  .capability__heading > p {
    max-width: 46rem;
    margin: 0;
    color: #b4afbc;
    line-height: 1.75;
  }

  .capability-stack {
    display: grid;
    gap: 1rem;
    margin-top: 4rem;
  }

  .capability {
    overflow: hidden;
    padding: clamp(1rem, 3vw, 2rem);
    border: 1px solid #2c2440;
    border-radius: 0.8rem;
    background: rgb(14 11 22 / 0.78);
  }

  .capability__heading h3,
  .world-teaser__copy h3,
  .home-workshop__method-heading h3 {
    margin: 0.65rem 0 0;
    color: #f0edf6;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 5vw, 4.4rem);
    font-weight: 300;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .capability__body {
    margin-top: 1.5rem;
  }

  .evidence-board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem;
  }

  .evidence-board figure,
  .compiler figure,
  .world-teaser figure {
    position: relative;
    overflow: hidden;
    margin: 0;
    border: 1px solid #332a43;
    background: #08070c;
  }

  .evidence-board figure {
    min-height: 10rem;
  }

  .evidence-board img,
  .compiler img,
  .world-teaser img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .evidence-board__speculative {
    border-style: dashed !important;
    border-color: #a06bff !important;
  }

  .evidence-board figcaption,
  .compiler figcaption {
    position: absolute;
    right: 0.45rem;
    bottom: 0.45rem;
    left: 0.45rem;
    padding: 0.45rem 0.55rem;
    background: rgb(7 6 11 / 0.9);
    color: #e9e5ef;
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .capability__record {
    display: grid;
    align-content: start;
    gap: 1.2rem;
  }

  dl,
  dd {
    margin: 0;
  }

  .capability__record dl {
    display: grid;
    gap: 0.7rem;
  }

  .capability__record dl div,
  .compiler__spec dl div {
    padding-bottom: 0.7rem;
    border-bottom: 1px solid #2c2440;
  }

  dt,
  .compiler__label {
    color: #7bdde7;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  dd {
    margin-top: 0.35rem;
    color: #b7b1c0;
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .capability__record ol,
  .world-teaser ol {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .capability__record li,
  .world-teaser li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.6rem;
    padding: 0.55rem;
    border: 1px solid #332a43;
    color: #d4cfda;
    font-size: 0.72rem;
    text-transform: capitalize;
  }

  .capability__record li span,
  .world-teaser li span {
    color: #6b93ed;
    font-family: var(--font-mono);
  }

  .capability a,
  .capability__footer a {
    color: #7bdde7;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .capability a:focus-visible {
    outline: 2px solid #55d7ff;
    outline-offset: 4px;
  }

  .production-rail {
    display: grid;
    gap: 0.45rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .production-rail li {
    position: relative;
    min-height: 13rem;
    overflow: hidden;
    border: 1px solid #332a43;
    background: #08070c;
  }

  .production-rail img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 13rem;
    object-fit: cover;
  }

  .production-rail li:nth-child(2) img {
    object-fit: contain;
    background: #eef0ef;
  }

  .production-rail li > div {
    position: absolute;
    right: 0.45rem;
    bottom: 0.45rem;
    left: 0.45rem;
    padding: 0.65rem;
    background: rgb(7 6 11 / 0.9);
  }

  .production-rail li > div span,
  .production-rail__brief > span {
    color: #eee9f3;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .production-rail li > div p {
    margin: 0.45rem 0 0;
    color: #aaa4b1;
    font-size: 0.66rem;
    line-height: 1.45;
  }

  .production-rail__brief {
    display: flex;
    min-height: 13rem;
    flex-direction: column;
    justify-content: end;
    padding: 1rem;
    background:
      linear-gradient(135deg, rgb(59 111 224 / 0.18), transparent),
      #0a0910 !important;
  }

  .production-rail__brief span {
    color: #6b93ed !important;
  }

  .production-rail__brief p {
    margin: 0.75rem 0 0;
    color: #c2bdc9;
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .capability__footer {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.2rem;
    padding-top: 1.2rem;
    border-top: 1px solid #2c2440;
  }

  .capability__footer p {
    margin: 0;
    color: #a9a3b2;
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .capability__footer strong {
    color: #ddd7e4;
    font-weight: 500;
  }

  .compiler {
    display: grid;
    gap: 0.55rem;
    margin-top: 1.5rem;
  }

  .compiler__references {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
  }

  .compiler figure {
    min-height: 15rem;
  }

  .compiler__spec,
  .compiler__diagnostic {
    padding: 1rem;
    border: 1px solid #332a43;
    background: #09080e;
  }

  .compiler__spec dl {
    display: grid;
    gap: 0.65rem;
    margin-top: 1rem;
  }

  .compiler__diagnostic {
    border-color: rgb(242 77 166 / 0.42);
  }

  .compiler__diagnostic span {
    color: #f24da6;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .compiler__diagnostic strong {
    display: block;
    margin-top: 1.2rem;
    color: #f0edf6;
    font-size: 1rem;
    font-weight: 500;
  }

  .compiler__diagnostic p {
    margin: 0.7rem 0 0;
    color: #a9a3b2;
    font-size: 0.76rem;
    line-height: 1.6;
  }

  .world-teaser {
    display: grid;
    gap: 1rem;
  }

  .world-teaser figure {
    aspect-ratio: 4 / 3;
    min-height: 0;
    background: #d6c29c;
  }

  .world-teaser figure img {
    object-fit: contain;
  }

  .world-teaser__copy {
    padding: clamp(0.2rem, 2vw, 1rem);
  }

  .world-teaser__copy > p:not(.home-workshop__eyebrow) {
    margin: 1rem 0 0;
    color: #b4afbc;
    line-height: 1.7;
  }

  .world-teaser ol {
    margin-top: 1.2rem;
  }

  .world-teaser__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.3rem;
  }

  .home-workshop__method {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid #2c2440;
  }

  .home-workshop__method :global(.workshop-method-strip) {
    margin-top: 1.5rem;
  }

  .home-workshop__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 2rem;
  }

  @media (min-width: 48rem) {
    .capability__body--evidence {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
      gap: 1rem;
    }

    .production-rail {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .compiler {
      grid-template-columns: minmax(0, 1.15fr) minmax(14rem, 0.55fr) minmax(14rem, 0.55fr);
    }

    .world-teaser {
      grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
      align-items: stretch;
    }
  }

  @media (min-width: 64rem) {
    .home-workshop__header,
    .home-workshop__method-heading,
    .capability__heading {
      grid-template-columns: minmax(0, 1.2fr) minmax(24rem, 0.62fr);
      align-items: end;
    }
  }

  @media (max-width: 47.99rem) {
    .evidence-board {
      grid-template-columns: 1fr;
    }

    .evidence-board figure {
      min-height: 13rem;
    }

    .compiler__references {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .capability *,
    .capability *::before,
    .capability *::after {
      scroll-behavior: auto;
      transition: none;
    }
  }
</style>
