---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import WorkshopMethodStrip from "@/components/workshop/WorkshopMethodStrip.astro";
import WorkshopNodeMesh from "@/components/workshop/WorkshopNodeMesh.astro";
import WorkshopProjectGrid from "@/components/workshop/WorkshopProjectGrid.astro";
---

<section id="home-workshop" class="home-workshop" aria-labelledby="home-workshop-heading">
  <Wrapper variant="standard" class="py-16 lg:py-24">
    <header class="home-workshop__header">
      <div><p class="eyebrow">Behind the work</p><h2 id="home-workshop-heading">The publication is made in the Workshop.</h2></div>
      <p>Different source material needs a production system built for the job. The Workshop keeps the sources, constraints, tools, decisions, tests, and finished routes connected without turning every project into the same thing.</p>
    </header>

    <div class="mesh-preview"><WorkshopNodeMesh compact /></div>

    <section class="project-preview" aria-labelledby="home-projects-heading">
      <div class="section-heading"><div><p class="eyebrow">Four project nodes</p><h3 id="home-projects-heading">Web, software, photography, and a concept campaign.</h3></div><p>HobFarm proves the publishing and code system. StyleFusion proves structured visual translation. Before &amp; After keeps source photography legible. Future Carriage carries historical research into a product and campaign.</p></div>
      <div class="project-grid"><WorkshopProjectGrid surface="home" /></div>
    </section>

    <section class="method" aria-labelledby="home-method-heading">
      <div class="section-heading"><div><p class="eyebrow">Five-stage method</p><h3 id="home-method-heading">Research. Define. Build. Direct. Finish and deliver.</h3></div><p>Every stage leaves something inspectable: source notes, constraints, production assets, directed media, and a delivery record that can support the next use.</p></div>
      <WorkshopMethodStrip compact={true} showMedia={true} />
    </section>

    <div class="actions">
      <Button isLink size="md" variant="green" href="/workshop/" data-event="homepage_workshop_open">Explore the Workshop</Button>
      <Button isLink size="md" variant="muted" href="/workshop/projects/" data-event="homepage_projects_open">Browse Projects</Button>
    </div>
  </Wrapper>
</section>

<style>
  .home-workshop { border-bottom: 1px solid #2c2440; background: radial-gradient(circle at 10% 8%, rgb(59 111 224 / .14), transparent 34rem), radial-gradient(circle at 92% 54%, rgb(224 33 138 / .08), transparent 38rem), #07060b; }
  .home-workshop__header, .section-heading { display: grid; gap: 1.5rem; }
  .eyebrow { margin: 0; color: #55d7ff; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .16em; text-transform: uppercase; }
  h2, h3 { color: #f0edf6; font-family: var(--font-display); font-weight: 300; letter-spacing: -.055em; text-wrap: balance; }
  h2 { max-width: 68rem; margin: .8rem 0 0; font-size: clamp(3rem, 7.2vw, 6rem); line-height: .93; }
  h3 { margin: .7rem 0 0; font-size: clamp(2.3rem, 5vw, 4.2rem); line-height: .96; }
  .home-workshop__header > p, .section-heading > p { max-width: 45rem; margin: 0; color: #b4afbc; line-height: 1.75; }
  .mesh-preview, .project-preview, .method { margin-top: clamp(3rem, 7vw, 5rem); }
  .project-preview, .method { padding-top: clamp(2.5rem, 5vw, 4rem); border-top: 1px solid #2c2440; }
  .project-grid, .method :global(.workshop-method-strip) { margin-top: 1.5rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 2rem; }
  @media (min-width: 64rem) { .home-workshop__header, .section-heading { grid-template-columns: minmax(0, 1.2fr) minmax(24rem, .62fr); align-items: end; } }
</style>
