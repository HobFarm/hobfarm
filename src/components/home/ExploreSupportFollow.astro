---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import KofiCta from "@/components/KofiCta.astro";
import { exploreLinks, supportLinks, followLinks } from "@/data/homepage-systems";
---

<section id="explore" class="relative overflow-hidden">
  <Wrapper variant="standard" class="py-16 lg:py-20">
    <div class="rounded-lg border border-base-800 bg-base-900/70 p-6 sm:p-8 lg:p-10">
      <div class="max-w-2xl">
        <Text tag="span" variant="textSM" class="font-mono uppercase tracking-widest text-accent-cyan">
          Next steps
        </Text>
        <Text tag="h2" variant="displayLG" class="mt-5 font-display text-white">
          Explore, support, follow
        </Text>
        <p class="mt-5 text-base leading-relaxed text-base-300">
          Find the finished visuals, read how the systems are built, learn the repeatable parts, hire HobFarm, or support the next set.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3">
        <!-- Explore -->
        <div class="rounded-lg border border-base-800 bg-base-950/50 p-5">
          <p class="font-mono text-[10px] uppercase tracking-widest text-base-400">Explore</p>
          <ul class="mt-4 space-y-2">
            {exploreLinks.map((link) => (
              <li>
                <a href={link.href} class="group flex items-center justify-between gap-3 rounded-md border border-base-800 bg-base-900/50 px-3 py-2.5 transition-colors hover:border-accent-cyan/50">
                  <span class="text-sm text-base-200 transition-colors group-hover:text-white">{link.label}</span>
                  <span class="flex items-center gap-2">
                    {link.soon && (
                      <span class="rounded-full border border-base-700 px-2 py-0.5 font-mono text-[9px] uppercase tracking-wider text-base-400">soon</span>
                    )}
                    <span class="font-mono text-[10px] uppercase tracking-wider text-base-400">{link.note}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Support -->
        <div class="rounded-lg border border-base-800 bg-base-950/50 p-5">
          <p class="font-mono text-[10px] uppercase tracking-widest text-base-400">Support</p>
          <p class="mt-3 text-sm leading-relaxed text-base-400">
            Support keeps the character systems, gallery drops, notes, courses, and tools moving: compute, storage, image generation, indexing, and publishing.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {supportLinks.map((link, index) => (
              <Button isLink size="sm" variant={index === 0 ? "green" : "muted"} href={link.href}>
                {link.label}
              </Button>
            ))}
          </div>
          <div class="mt-4">
            <KofiCta variant="logo" />
          </div>
        </div>

        <!-- Follow -->
        <div class="rounded-lg border border-base-800 bg-base-950/50 p-5">
          <p class="font-mono text-[10px] uppercase tracking-widest text-base-400">Follow</p>
          <ul class="mt-4 space-y-2">
            {followLinks.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between gap-3 rounded-md border border-base-800 bg-base-900/50 px-3 py-2.5 transition-colors hover:border-accent-magenta/50">
                  <span class="text-sm text-base-200 transition-colors group-hover:text-white">{link.label}</span>
                  <span aria-hidden="true" class="font-mono text-[11px] text-accent-magenta-bright">&nearr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </Wrapper>
</section>
