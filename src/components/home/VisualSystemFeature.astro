---
// Reusable homepage feature for a visual system. Defaults to the flagged
// featured system but accepts any system, so it is not hardcoded to Sophia/
// Stella. Self-suppresses when there is no active system to show.
// Preview-safe: every still is capped via mediaImageUrl; sheet crops carry no
// lightbox, and the full-resolution `-hd` originals are never emitted.
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import { mediaImageUrl, mediaUrl } from "@/lib/gallery";
import {
  featuredVisualSystem,
  visualSystemPath,
  type VisualSystem,
} from "@/data/visual-systems";

interface Props {
  system?: VisualSystem;
}

const { system = featuredVisualSystem } = Astro.props;

const fa = system?.featuredAssets;
const posterSrc = fa?.poster
  ? mediaImageUrl(fa.poster.folder, fa.poster.file, { width: 1000, quality: 84, fit: "cover" })
  : null;
const teaserSrc = fa?.teaserVideo ? mediaUrl(fa.teaserVideo.folder, fa.teaserVideo.file) : null;
const teaserPoster = fa?.teaserVideo
  ? mediaImageUrl(fa.teaserVideo.folder, fa.teaserVideo.poster, { width: 800, quality: 82, fit: "cover" })
  : null;

// One capped sheet crop per variant for the showroom teaser.
const crops = system
  ? system.variants
      .flatMap((v) => v.sheetPreviews.slice(0, 1))
      .map((s) => ({
        src: mediaImageUrl(s.folder, s.file, { width: 600, quality: 82, fit: "scale-down" }),
        alt: s.alt,
      }))
  : [];
---

{system && (
  <section id="visual-system-feature" class="border-b border-base-800/70">
    <Wrapper variant="standard" class="py-14 lg:py-20">
      <div class="max-w-2xl">
        <p class="font-mono text-[10px] uppercase tracking-widest text-accent-magenta-bright">
          Visual System
        </p>
        <Text tag="h2" variant="displayLG" class="mt-3 font-display text-white">
          {system.title}
        </Text>
        <p class="mt-4 text-base leading-relaxed text-base-300 text-pretty">
          {system.shortDescription}
        </p>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {posterSrc && (
            <img
              src={posterSrc}
              alt={fa!.poster!.alt}
              loading="lazy"
              decoding="async"
              class="aspect-[3/4] w-full max-h-[440px] border border-base-800 bg-base-950 object-contain sm:max-h-[560px]"
            />
          )}
          {teaserSrc && (
            <video
              src={teaserSrc}
              poster={teaserPoster ?? undefined}
              muted
              loop
              autoplay
              playsinline
              preload="metadata"
              aria-label={fa!.teaserVideo!.alt}
              class="aspect-[3/4] w-full max-h-[440px] border border-base-800 bg-base-950 object-contain sm:max-h-[560px]"
            ></video>
          )}
        </div>

        <div class="flex flex-col gap-4">
          <dl class="grid grid-cols-1 gap-2 sm:grid-cols-2">
            {system.aestheticRules.slice(0, 4).map((rule) => (
              <div class="rounded-md border border-base-800 bg-base-950/50 px-3 py-2">
                <dt class="font-mono text-[10px] uppercase tracking-wider text-base-400">{rule.label}</dt>
                <dd class="mt-0.5 text-xs leading-snug text-base-200">{rule.value}</dd>
              </div>
            ))}
          </dl>
          {crops.length > 0 && (
            <div class="grid grid-cols-2 gap-2">
              {crops.map((crop) => (
                <img
                  src={crop.src}
                  alt={crop.alt}
                  loading="lazy"
                  decoding="async"
                  class="w-full border border-base-800 bg-base-950 object-contain"
                />
              ))}
            </div>
          )}
          <div class="flex flex-wrap gap-2">
            <Button isLink size="sm" variant="green" href={visualSystemPath(system.slug)}>
              See the full system
            </Button>
            <Button isLink size="sm" variant="muted" href="/visual-systems/">
              Explore visual systems
            </Button>
          </div>
          <p class="text-xs text-base-500">
            The character sheet is the paid asset. The poster, hero, and video sell the world.
          </p>
        </div>
      </div>
    </Wrapper>
  </section>
)}
