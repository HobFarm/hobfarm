---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import StoryPanel from "@/components/home/infographics/StoryPanel.astro";
import { academy, storyPanels } from "@/data/homepage-systems";
import { getCollection, type CollectionEntry } from "astro:content";

const story = storyPanels.academy;

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const postMap = new Map<string, CollectionEntry<"blog">>();
allPosts.forEach((post) => {
  postMap.set(post.id, post);
  postMap.set(`${post.id}.md`, post);
  postMap.set(post.id.replace(/\.md$/, ""), post);
});

function isBlogPost(post: CollectionEntry<"blog"> | undefined): post is CollectionEntry<"blog"> {
  return Boolean(post);
}

// Prefer the curated set, then fill with the most recent posts so the row is
// always full even if a preferred id is renamed or removed.
const preferred = academy.featuredPostIds.map((id) => postMap.get(id)).filter(isBlogPost);
const recent = [...allPosts].sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime(),
);
const seen = new Set(preferred.map((p) => p.id));
const posts = [...preferred];
for (const p of recent) {
  if (posts.length >= 4) break;
  if (!seen.has(p.id)) {
    posts.push(p);
    seen.add(p.id);
  }
}
const featuredPosts = posts.slice(0, 4);
---

<section id="field-notes" class="border-b border-base-800/70">
  <Wrapper variant="standard" class="py-16 lg:py-20">
    <div class="max-w-2xl">
      <Text tag="span" variant="textSM" class="font-mono uppercase tracking-widest text-accent-violet-bright">
        {academy.eyebrow}
      </Text>
      <Text tag="h2" variant="displayLG" class="mt-5 font-display text-white">
        {academy.heading}
      </Text>
      <p class="mt-5 text-base leading-relaxed text-base-400">{academy.copy}</p>
    </div>

    <!-- Lesson map -->
    <div class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {academy.categories.map((category) => (
        <div class="rounded-md border border-base-800 bg-base-900/60 p-4">
          <p class="font-mono text-[10px] uppercase tracking-widest text-accent-cyan">{category.label}</p>
          <p class="mt-2 text-sm leading-relaxed text-base-400">{category.text}</p>
        </div>
      ))}
    </div>

    <!-- From the blog -->
    <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:items-start">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-widest text-base-400">From the field notes</p>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-base-400">
          Deeper notes live on the blog: how surfaces shape a look, how references become structure, and what it takes to run an independent studio.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <Button isLink size="sm" variant="muted" href="/blog/">Read the field notes</Button>
          <Button isLink size="sm" variant="muted" href="/academy/">Open the Academy</Button>
        </div>
      </div>

      <div class="space-y-5">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {featuredPosts.map((post) => (
            <a
              href={`/blog/posts/${post.id.replace(/\.md$/, "")}`}
              class="rounded-lg border border-base-800 bg-base-900/60 p-4 transition-colors hover:border-accent-cyan/50"
            >
              <p class="font-mono text-[10px] uppercase tracking-widest text-accent-cyan">
                {post.data.category ?? "process"}
              </p>
              <h3 class="mt-3 text-base font-display text-white">{post.data.title}</h3>
              <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-base-400">{post.data.excerpt}</p>
            </a>
          ))}
        </div>

        <div class="rounded-lg border border-base-800 bg-base-950/60 p-4">
          <p class="font-mono text-[10px] uppercase tracking-widest text-base-400">In the queue</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {academy.queuedNotes.map((note) => (
              <span class="rounded-full border border-base-700 px-3 py-1.5 text-[11px] text-base-300">{note}</span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <StoryPanel panel={story} class="mt-8" />
  </Wrapper>
</section>
