---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import ArticleCard from "@/components/articles/ArticleCard.astro";
import EditorialSectionRail from "@/components/articles/EditorialSectionRail.astro";
import KofiTipCard from "@/components/support/KofiTipCard.astro";
import {
  articlePath,
  getArticleDate,
  getArticleDek,
  getArticleHero,
  getArticleSectionLabel,
  getPublishedArticles,
} from "@/lib/articles";

const articles = await getPublishedArticles();
const coverStory = articles[0];
const recentArticles = coverStory ? articles.slice(1, 6) : articles.slice(0, 5);
const coverDate = coverStory ? getArticleDate(coverStory) : null;
const coverHero = coverStory ? getArticleHero(coverStory.data) : undefined;
const coverHref = coverStory ? articlePath(coverStory) : "/articles/";
---

<section id="magazine-front-page" class="publisher-front bg-noise border-b border-base-800/70">
  <Wrapper variant="standard" class="py-10 lg:py-14">
    <div class="publisher-front__hero">
      <div class="publisher-front__intro">
        <p>Independent publisher + creative studio</p>
        <h1>Articles, media, games, and creative systems.</h1>
        <p>
          HobFarm publishes original Editorial work, recurring stories, playable experiments, visual production, and the methods behind them.
        </p>
        <div class="publisher-front__actions">
          <Button isLink size="sm" variant="green" href={coverHref} data-event="homepage_hero_read">Read the latest</Button>
          <Button isLink size="sm" variant="muted" href="/presents/">Explore Presents</Button>
          <Button isLink size="sm" variant="muted" href="/workshop/" data-event="homepage_hero_workshop">Open the Workshop</Button>
        </div>
      </div>
      <div class="publisher-front__mark">
        <video autoplay muted loop playsinline preload="metadata" poster="https://cdn.hob.farm/brand/hobfarm-drip-logo.png" aria-label="Animated HobFarm logo" width="1440" height="1440">
          <source src="https://cdn.hob.farm/brand/hobfarm-rabbit-hole-logo.mp4" type="video/mp4" />
          <img src="https://cdn.hob.farm/brand/hobfarm-drip-logo.png" alt="HobFarm" width="1912" height="448" />
        </video>
        <KofiTipCard variant="hero" placement="homepage-hero" />
      </div>
    </div>

    <div class="mt-9"><EditorialSectionRail /></div>
  </Wrapper>
</section>

<section id="latest-at-hobfarm" class="border-b border-base-800/70" aria-labelledby="latest-at-hobfarm-heading">
  <Wrapper variant="standard" class="py-12 lg:py-16">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[.16em] text-accent-cyan">Current Editorial</p>
        <h2 id="latest-at-hobfarm-heading" class="mt-2 font-display text-3xl font-light text-white">Latest at HobFarm</h2>
      </div>
      <a href="/articles/" class="font-mono text-[10px] uppercase tracking-wider text-base-400 hover:text-white">All articles &rarr;</a>
    </header>

    {coverStory && (
      <a href={coverHref} class="group mt-7 grid overflow-hidden rounded-xl border border-base-800 bg-base-950/70 hover:border-accent-cyan/50 lg:grid-cols-[1.3fr_.7fr]" data-event="homepage_cover_story_open">
        {coverHero && <img src={coverHero} alt={coverStory.data.heroAlt || coverStory.data.title} class="aspect-video h-full w-full object-cover" loading="eager" decoding="async" />}
        <div class="flex flex-col justify-center p-6 lg:p-8">
          <div class="flex flex-wrap gap-3 font-mono text-[10px] uppercase tracking-wider text-base-500">
            <span class="text-accent-cyan">{getArticleSectionLabel(coverStory.data)}</span>
            {coverDate && <time datetime={coverDate.toISOString()}>{coverDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" })}</time>}
          </div>
          <h3 class="mt-3 font-display text-2xl font-light text-white sm:text-3xl">{coverStory.data.title}</h3>
          <p class="mt-4 text-sm leading-relaxed text-base-300">{getArticleDek(coverStory.data)}</p>
          <span class="mt-6 text-sm text-base-200 group-hover:text-accent-cyan">Read the feature &rarr;</span>
        </div>
      </a>
    )}

    {recentArticles.length > 0 && (
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {recentArticles.map((article) => <ArticleCard post={article} />)}
      </div>
    )}
  </Wrapper>
</section>

<style>
  .publisher-front { background: radial-gradient(circle at 12% 15%, #e0218a16, transparent 28rem), radial-gradient(circle at 88% 30%, #19e3e312, transparent 28rem), #07060b; }
  .publisher-front__hero { display: grid; align-items: center; gap: 2rem; }
  .publisher-front__intro > p:first-child { margin: 0; color: #55d7ff; font-family: var(--font-mono); font-size: .65rem; letter-spacing: .14em; text-transform: uppercase; }
  .publisher-front__intro h1 { max-width: 16ch; margin: .8rem 0 0; color: #fff; font-family: var(--font-display); font-size: clamp(2.35rem, 6vw, 4.6rem); font-weight: 300; line-height: .98; }
  .publisher-front__intro h1 + p { max-width: 44rem; margin: 1.1rem 0 0; color: #aaa5ba; font-size: .95rem; line-height: 1.65; }
  .publisher-front__actions { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.35rem; }
  .publisher-front__mark { display: grid; gap: .65rem; max-width: 17rem; justify-self: center; }
  .publisher-front__mark video { width: 100%; aspect-ratio: 1; border: 1px solid #2c2440; border-radius: .75rem; background: #090711; object-fit: cover; }
  @media (min-width: 900px) { .publisher-front__hero { grid-template-columns: minmax(0, 1fr) 17rem; } }
</style>
