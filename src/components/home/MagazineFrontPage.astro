---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import ArticleCard from "@/components/articles/ArticleCard.astro";
import EditorialSectionRail from "@/components/articles/EditorialSectionRail.astro";
import {
  articlePath,
  getArticleDate,
  getArticleDek,
  getArticleHero,
  getArticleSectionLabel,
  getPublishedArticles,
} from "@/lib/articles";
import { imageSrcset, transformImageUrl } from "@/lib/media-transforms";

const articles = await getPublishedArticles();
const coverStory = articles[0];
const recentArticles = coverStory ? articles.slice(1, 6) : articles.slice(0, 5);
const coverDate = coverStory ? getArticleDate(coverStory) : null;
const coverHero = coverStory ? getArticleHero(coverStory.data) : undefined;
const coverHref = coverStory ? `${articlePath(coverStory)}/` : "/articles/";
const coverHeroSrc = coverHero
  ? transformImageUrl(coverHero, { width: 960, quality: 84, fit: "cover" })
  : undefined;
const coverHeroSrcset = coverHero
  ? imageSrcset(coverHero, [480, 720, 960, 1280], { quality: 84, fit: "cover" })
  : undefined;
---

<section
  id="magazine-front-page"
  class="publisher-front bg-noise border-b border-base-800/70"
  aria-label="HobFarm front page"
>
  <Wrapper variant="standard" class="py-6 lg:py-8">
    <div class="publisher-masthead">
      <div class="publisher-front__intro">
        <p>Independent publisher + creative studio</p>
        <h1>Articles, media, games, and creative systems.</h1>
        <p>
          HobFarm publishes original Editorial work, recurring stories, playable experiments, visual production, and the methods behind them.
        </p>
        <div class="publisher-front__actions">
          <Button isLink size="sm" variant="green" href={coverHref} data-event="homepage_hero_read">Read the latest</Button>
          <Button isLink size="sm" variant="muted" href="/presents/">Explore Presents</Button>
          <a href="/workshop/" class="publisher-front__tertiary" data-event="homepage_hero_workshop">
            Open the Workshop <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      {coverStory && (
        <article class="publisher-feature" aria-labelledby="latest-at-hobfarm-heading">
          <a
            href={coverHref}
            class="publisher-feature__link"
            aria-label={`Read ${coverStory.data.title}`}
            data-event="homepage_cover_story_open"
          >
            {coverHero && (
              <div class="publisher-feature__media">
                <img
                  src={coverHeroSrc}
                  srcset={coverHeroSrcset}
                  sizes="(min-width: 1152px) 35vw, (min-width: 1024px) 55vw, 100vw"
                  alt={coverStory.data.heroAlt || coverStory.data.title}
                  width="1280"
                  height="720"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              </div>
            )}
            <div class="publisher-feature__copy">
              <div class="publisher-feature__topline">
                <p>Current Editorial</p>
                <span>Latest at HobFarm</span>
              </div>
              <div class="publisher-feature__meta">
                <span>{getArticleSectionLabel(coverStory.data)}</span>
                {coverDate && (
                  <time datetime={coverDate.toISOString()}>
                    {coverDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}
                  </time>
                )}
              </div>
              <h2 id="latest-at-hobfarm-heading">{coverStory.data.title}</h2>
              <p>{getArticleDek(coverStory.data)}</p>
              <strong>Read the feature <span aria-hidden="true">&rarr;</span></strong>
            </div>
          </a>
        </article>
      )}
    </div>

    <div class="publisher-front__rail"><EditorialSectionRail /></div>

    {recentArticles.length > 0 && (
      <section class="recent-stories" aria-labelledby="recent-stories-heading">
        <header>
          <h2 id="recent-stories-heading">Recent stories</h2>
          <a href="/articles/">All articles <span aria-hidden="true">&rarr;</span></a>
        </header>
        <div class="recent-stories__grid">
          {recentArticles.map((article) => <ArticleCard post={article} />)}
        </div>
      </section>
    )}
  </Wrapper>
</section>

<style>
  .publisher-front {
    background:
      radial-gradient(circle at 8% 12%, rgb(224 33 138 / 0.09), transparent 30rem),
      radial-gradient(circle at 90% 20%, rgb(25 227 227 / 0.08), transparent 30rem),
      #07060b;
  }

  .publisher-masthead {
    display: grid;
    gap: 1.25rem;
    align-items: stretch;
  }

  .publisher-front__intro {
    align-self: center;
    padding-block: 0.5rem;
  }

  .publisher-front__intro > p:first-child,
  .publisher-feature__topline p,
  .publisher-feature__topline span,
  .publisher-feature__meta,
  .recent-stories header {
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .publisher-front__intro > p:first-child {
    margin: 0;
    color: #55d7ff;
    font-size: 0.62rem;
    letter-spacing: 0.15em;
  }

  .publisher-front__intro h1 {
    max-width: none;
    margin: 0.65rem 0 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(2.65rem, 3.5vw, 3.8rem);
    font-weight: 300;
    letter-spacing: -0.045em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .publisher-front__intro h1 + p {
    max-width: none;
    margin: 0.9rem 0 0;
    color: #aaa5ba;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .publisher-front__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.1rem;
  }

  .publisher-front__tertiary {
    padding: 0.55rem 0.35rem;
    color: #9b96ad;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .publisher-front__tertiary:hover,
  .publisher-front__tertiary:focus-visible {
    color: #fff;
  }

  .publisher-feature {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #2c2440;
    border-top: 2px solid #19e3e3;
    border-radius: 0.75rem;
    background: rgb(14 11 22 / 0.78);
  }

  .publisher-feature__link {
    display: grid;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .publisher-feature__link:focus-visible {
    outline: 2px solid #55d7ff;
    outline-offset: -3px;
  }

  .publisher-feature__media {
    position: relative;
    min-height: 13rem;
    overflow: hidden;
    border-bottom: 1px solid #2c2440;
    background: #0e0b16;
  }

  .publisher-feature__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(145deg, transparent 48%, rgb(7 6 11 / 0.4));
    pointer-events: none;
  }

  .publisher-feature__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms ease;
  }

  .publisher-feature__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 1.15rem;
  }

  .publisher-feature__topline,
  .publisher-feature__meta,
  .recent-stories header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .publisher-feature__topline p,
  .publisher-feature__topline span {
    margin: 0;
    font-size: 0.55rem;
    letter-spacing: 0.13em;
  }

  .publisher-feature__topline p { color: #19e3e3; }
  .publisher-feature__topline span { color: #6b6580; }

  .publisher-feature__meta {
    justify-content: flex-start;
    margin-top: 1.25rem;
    color: #8f899f;
    font-size: 0.56rem;
    letter-spacing: 0.08em;
  }

  .publisher-feature__meta span { color: #55d7ff; }

  .publisher-feature h2 {
    margin: 0.5rem 0 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.2vw, 2.25rem);
    font-weight: 300;
    letter-spacing: -0.025em;
    line-height: 1.06;
    text-wrap: balance;
  }

  .publisher-feature h2 + p {
    display: -webkit-box;
    overflow: hidden;
    margin: 0.75rem 0 0;
    color: #aaa5ba;
    font-size: 0.78rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .publisher-feature strong {
    margin-top: auto;
    padding-top: 1rem;
    color: #d8d4e4;
    font-size: 0.75rem;
    font-weight: 400;
  }

  .publisher-feature__link:hover strong { color: #55d7ff; }

  .publisher-front__rail { margin-top: 1rem; }

  .recent-stories { margin-top: 0.9rem; }

  .recent-stories header h2,
  .recent-stories header a {
    margin: 0;
    color: #8f899f;
    font-size: 0.58rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-decoration: none;
  }

  .recent-stories header a:hover,
  .recent-stories header a:focus-visible { color: #fff; }

  .recent-stories__grid {
    display: grid;
    grid-auto-columns: minmax(15rem, 82vw);
    grid-auto-flow: column;
    gap: 0.7rem;
    overflow-x: auto;
    margin-top: 0.65rem;
    padding-bottom: 0.35rem;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .recent-stories__grid > :global(article) { scroll-snap-align: start; }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .publisher-feature__link:hover .publisher-feature__media img { transform: scale(1.025); }
  }

  @media (min-width: 40rem) {
    .recent-stories__grid {
      grid-auto-flow: initial;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      overflow: visible;
    }
  }

  @media (min-width: 64rem) {
    .publisher-masthead {
      grid-template-columns: minmax(20rem, 0.9fr) minmax(0, 1.1fr);
    }

    .publisher-front__intro { padding: 0.75rem 0; }

    .publisher-front__intro h1 { max-width: 20ch; }

    .publisher-front__intro h1 + p { max-width: 39rem; }

    .recent-stories__grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }

  @media (min-width: 72rem) {
    .publisher-feature__link { grid-template-columns: minmax(0, 1.08fr) minmax(17rem, 0.92fr); }
    .publisher-feature__media {
      min-height: 19rem;
      border-right: 1px solid #2c2440;
      border-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .publisher-feature__media img { transition: none; }
  }
</style>
