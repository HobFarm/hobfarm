---

<section class="relative py-10 lg:py-12 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4">
    <p class="text-center text-sm font-mono text-base-500 uppercase tracking-[0.2em] mb-8">
      Integrated Providers
    </p>
    <div class="flex flex-wrap items-center justify-center gap-x-7 gap-y-5">
      {providers.map((p) => (
        <a
          href={p.href}
          target="_blank"
          rel="noopener noreferrer"
          title={p.name}
          class="provider-mark flex items-center gap-1.5 select-none"
        >
          {p.icon ? (
            <svg
              class="w-4 h-4 shrink-0"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={p.icon} />
            </svg>
          ) : p.svgRaw ? (
            <Fragment set:html={p.svgRaw} />
          ) : null}
          <span class="text-[13px] font-display font-medium tracking-wide whitespace-nowrap">
            {p.name}
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .provider-mark {
    color: var(--color-base-600);
    opacity: 0.5;
    transition: opacity 0.3s ease, color 0.3s ease, filter 0.3s ease;
  }
  .provider-mark:hover {
    color: var(--color-white);
    opacity: 1;
    filter: drop-shadow(0 0 8px rgba(0, 255, 255, 0.2));
  }
</style>
