---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
---

<section id="shop-directory" class="border-b border-base-800/70">
  <Wrapper variant="standard" class="py-14 lg:py-16">
    <div class="grid gap-6 border border-base-800 bg-base-900/35 p-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-end lg:p-8">
      <div class="max-w-2xl">
        <p class="font-mono text-[10px] uppercase tracking-widest text-accent-magenta-bright">Shop</p>
        <Text tag="h2" variant="displaySM" class="mt-2 font-display text-white">
          Different work, different shelves.
        </Text>
        <p class="mt-3 text-sm leading-relaxed text-base-400">
          Digital packs, character releases, and one-off physical finds each have their own storefront.
        </p>
      </div>
      <Button isLink size="sm" variant="muted" href="/shop/">Find the right shop</Button>
    </div>
  </Wrapper>
</section>
