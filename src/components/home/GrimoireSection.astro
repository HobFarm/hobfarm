---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import MapColumn from "@/components/home/infographics/MapColumn.astro";
import StoryPanel from "@/components/home/infographics/StoryPanel.astro";
import GrimoireSynthesis from "@/components/home/GrimoireSynthesis.astro";
import ArchiveStrip from "@/components/home/ArchiveStrip";
import { grimoireFlow, coreSystems, storyPanels } from "@/data/homepage-systems";

const story = storyPanels.grimoire;
---

<section id="grimoire" class="border-b border-base-800/70">
  <Wrapper variant="standard" class="py-16 lg:py-20">
    <div class="max-w-2xl">
      <Text tag="span" variant="textSM" class="font-mono uppercase tracking-widest text-accent-magenta-bright">
        {grimoireFlow.eyebrow}
      </Text>
      <Text tag="h2" variant="displayLG" class="mt-5 font-display text-white">
        {grimoireFlow.heading}
      </Text>
      <p class="mt-5 text-base leading-relaxed text-base-400">{grimoireFlow.copy}</p>
    </div>

    <!-- Plain-language framing -->
    <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
      <div class="rounded-md border border-base-800 bg-base-950/60 p-4">
        <p class="font-mono text-[10px] uppercase tracking-widest text-base-400">Old book</p>
        <p class="mt-2 text-sm text-base-300">{grimoireFlow.plain.oldBook}</p>
      </div>
      <div class="rounded-md border border-accent-magenta/30 bg-accent-magenta/10 p-4">
        <p class="font-mono text-[10px] uppercase tracking-widest text-accent-magenta-bright">HobFarm version</p>
        <p class="mt-2 text-sm text-base-200">{grimoireFlow.plain.hobfarm}</p>
      </div>
    </div>

    <!-- Data flow: sources -> stages -> reusable pieces -->
    <div class="mt-6 rounded-lg border border-base-800 bg-base-900/50 p-4 sm:p-6">
      <p class="font-mono text-[10px] uppercase tracking-widest text-base-400">
        How material becomes reusable
      </p>
      <div class="mt-5 grid grid-cols-1 gap-3 lg:grid-cols-[1fr_auto_1fr_auto_1fr] lg:items-stretch lg:gap-2">
        <MapColumn title="Source material" items={grimoireFlow.sources} tone="cyan" />
        <span aria-hidden="true" class="flex items-center justify-center font-mono text-base text-accent-magenta-bright">
          <span class="lg:hidden">&darr;</span>
          <span class="hidden lg:inline">&rarr;</span>
        </span>
        <MapColumn title="Indexing" items={grimoireFlow.stages} tone="magenta" glow />
        <span aria-hidden="true" class="flex items-center justify-center font-mono text-base text-accent-cyan">
          <span class="lg:hidden">&darr;</span>
          <span class="hidden lg:inline">&rarr;</span>
        </span>
        <MapColumn title="Reusable pieces" items={grimoireFlow.reusable} tone="green" />
      </div>
    </div>

    <!-- Live daily synthesis feature -->
    <div class="mt-10">
      <p class="mb-4 font-mono text-[10px] uppercase tracking-widest text-accent-cyan">
        Live / today's synthesis
      </p>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-[1.5fr_1fr] lg:items-start">
        <GrimoireSynthesis id="daily-synthesis" />
        <ArchiveStrip client:idle />
      </div>
    </div>

    <!-- Core systems -->
    <div class="mt-10">
      <div class="flex items-center gap-4">
        <p class="font-mono text-[10px] uppercase tracking-widest text-base-400">Core systems</p>
        <div class="h-px flex-1 bg-base-800"></div>
      </div>
      <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-3">
        {coreSystems.map((system, index) => (
          <a
            href={system.href}
            class="group rounded-lg border border-base-800 bg-base-900/60 p-5 transition-colors hover:border-accent-magenta/50"
          >
            <p class="font-mono text-[10px] uppercase tracking-widest text-base-400">
              System {String(index + 1).padStart(2, "0")}
            </p>
            <h3 class="mt-3 font-display text-xl text-white transition-colors group-hover:text-accent-magenta-bright">
              {system.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-base-400">{system.body}</p>
            <p class="mt-5 font-mono text-[11px] uppercase tracking-wider text-accent-cyan">Open &rarr;</p>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button isLink size="sm" variant="muted" href="/grimoire/">Explore Grimoire</Button>
    </div>

    <StoryPanel panel={story} class="mt-8" />
  </Wrapper>
</section>
