---
import Text from "@/components/fundations/elements/Text.astro";
import type { LessonPreview } from "@/data/avatar-content-system";
import { lessonHref } from "@/data/avatar-content-system";

interface Props {
  lesson: LessonPreview;
  locked?: boolean;
}

const { lesson, locked = lesson.access === "paid" } = Astro.props;
const accessLabel = lesson.access === "free" ? "Free" : locked ? "Locked" : "Paid";
---

<a
  href={lessonHref(lesson.slug)}
  class="group block border border-base-800 bg-base-900/40 p-5 transition-colors hover:border-base-600 hover:bg-base-900/70"
>
  <div class="flex flex-wrap items-center gap-2">
    <span class="font-mono text-xs text-base-500">Lesson {lesson.number}</span>
    <span class:list={[
      "rounded-full border px-2 py-1 text-[11px] font-mono uppercase tracking-wider",
      lesson.access === "free"
        ? "border-accent-green/50 text-accent-green-bright"
        : "border-accent-violet/50 text-accent-violet-bright",
    ]}>
      {accessLabel}
    </span>
    {lesson.trackTags.map((tag) => (
      <span class="rounded-full border border-base-700 px-2 py-1 text-[11px] font-mono text-base-400">
        {tag}
      </span>
    ))}
  </div>
  <Text tag="h3" variant="textXL" class="mt-5 text-white font-display text-balance group-hover:text-accent-green-bright">
    {lesson.title}
  </Text>
  <p class="mt-3 text-sm leading-relaxed text-base-400">{lesson.preview}</p>
  <p class="mt-5 text-xs font-mono text-base-500">{lesson.moduleTitle}</p>
</a>
