---
import type { AcademyDownload } from "@/data/academy-courses";

interface Props {
  download: AcademyDownload;
  coursePath: string;
}

const { download, coursePath } = Astro.props;
---

<article class="download-card">
  <span>{download.format}</span>
  <h3>{download.label}</h3>
  <p>{download.description}</p>
  <div>
    <a href={download.href} download>Download source</a>
    {download.printable && (
      <a href={`${coursePath}worksheets/${download.slug}/`}>Print worksheet</a>
    )}
  </div>
</article>

<style>
  .download-card { padding: 1.25rem; border: 1px solid #2c2440; border-radius: .75rem; background: rgba(14, 11, 22, .72); }
  .download-card > span { color: #5cf0f0; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; }
  h3 { margin: .8rem 0 0; color: #fff; font-family: var(--font-display); font-size: 1.2rem; font-weight: 500; }
  p { margin: .65rem 0 0; color: #9b96ad; font-size: .8rem; line-height: 1.6; }
  div { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1rem; }
  a { color: #ece9f5; font-family: var(--font-mono); font-size: .65rem; letter-spacing: .06em; text-transform: uppercase; text-underline-offset: .25rem; }
  a:hover { color: #5cf0a6; }
</style>
