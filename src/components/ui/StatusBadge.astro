---
interface Props {
  status: 'live' | 'active' | 'planned' | 'paused';
  class?: string;
}
const { status, class: className = '' } = Astro.props;

const statusConfig: Record<string, { label: string; colorClass: string }> = {
  live: { label: 'Live', colorClass: 'bg-spot-green/10 text-spot-green ring-spot-green/30' },
  active: { label: 'In Development', colorClass: 'bg-spot-blue/10 text-spot-blue ring-spot-blue/30' },
  planned: { label: 'Planned', colorClass: 'bg-spot-purple/10 text-spot-purple ring-spot-purple/30' },
  paused: { label: 'Paused', colorClass: 'bg-base-600/10 text-base-400 ring-base-600/30' },
};

// Fallback for unexpected statuses during dev
const config = statusConfig[status] || { label: status, colorClass: 'bg-base-600/20 text-base-400 ring-base-600/30' };
---

<span class:list={[
  'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono font-medium ring-1 ring-inset tracking-wider uppercase',
  config.colorClass,
  className,
]}>
  {config.label}
</span>
