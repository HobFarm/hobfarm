---
import type { Adventure } from "@/lib/adventures";
import { adventurePath } from "@/lib/adventures";
import { imageSrcset, transformImageUrl } from "@/lib/media-transforms";

interface Props {
  adventure: Adventure;
}

const { adventure } = Astro.props;
const { number, title, teaser, cover, coverAlt } = adventure.data;
const src = transformImageUrl(cover, { width: 640, quality: 84, fit: "cover" });
const srcset = imageSrcset(cover, [320, 480, 640, 900], { quality: 84, fit: "cover" });
const adventureLabel = `Adventure No. ${String(number).padStart(2, "0")}`;
---

<a
  href={adventurePath(adventure)}
  class="group flex flex-col overflow-hidden rounded-lg border border-base-800 bg-base-900/50 transition-colors hover:border-accent-500/50"
>
  <div class="relative aspect-[2/3] overflow-hidden bg-base-950">
    <img
      src={src}
      srcset={srcset}
      sizes="(min-width: 1024px) 320px, (min-width: 640px) 50vw, 100vw"
      alt={coverAlt || title}
      class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
      loading="lazy"
      decoding="async"
    />
    <span class="absolute inset-0 bg-gradient-to-t from-base-950/80 via-transparent to-transparent"></span>
    <span class="absolute left-3 top-3 rounded-full border border-accent-500/30 bg-base-950/70 px-3 py-1 font-mono text-[10px] uppercase tracking-widest text-accent-400">
      {adventureLabel}
    </span>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-display text-lg text-white">{title}</h3>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-base-400">{teaser}</p>
    <span class="mt-5 font-mono text-[10px] uppercase tracking-wider text-base-400 group-hover:text-white">
      Read &rarr;
    </span>
  </div>
</a>
