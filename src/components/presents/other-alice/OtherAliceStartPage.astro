---
import type { StorySeries } from "@/data/story-series";
import type { Adventure } from "@/lib/adventures";
import { adventurePath } from "@/lib/adventures";
import Subscribe from "@/components/articles/Subscribe.astro";
import OaaProjectNav from "@/components/presents/other-alice/OaaProjectNav.astro";
import OaaRelationshipWeb from "@/components/presents/other-alice/OaaRelationshipWeb.astro";
import {
  OTHER_ALICE_HOUSES_PATH,
  OTHER_ALICE_WORLD_GUIDE_PATH,
  archiveRecords,
  courtDossiers,
  hatterWorldFeature,
  otherAliceCanon,
  otherAliceConceptArt,
  otherAliceResidents,
  politicalMapViews,
} from "@/data/other-alice-world-guide";

interface Props {
  series: StorySeries;
  adventures: Adventure[];
}

const { adventures } = Astro.props;
const currentAdventure = adventures[0];
const currentImage = currentAdventure?.data.heroMedia?.type === "image"
  ? currentAdventure.data.heroMedia.file
  : currentAdventure?.data.cover;
const currentImageAlt = currentAdventure?.data.heroMedia?.type === "image"
  ? currentAdventure.data.heroMedia.alt
  : currentAdventure?.data.coverAlt ?? currentAdventure?.data.title;
const alice = otherAliceResidents.find((resident) => resident.id === "other-alice")!;
const chester = otherAliceResidents.find((resident) => resident.id === "chester")!;
const hatter = otherAliceResidents.find((resident) => resident.id === "the-hatter")!;
const startRoutes = [
  {
    label: "Current story",
    title: currentAdventure?.data.title ?? "The first route record",
    note: currentAdventure?.data.teaser ?? "The first published route is still being prepared.",
    href: currentAdventure ? adventurePath(currentAdventure) : "#adventures",
    accent: "cyan",
  },
  {
    label: "Living atlas",
    title: "Court, lived, and dependency maps",
    note: "Three political readings occupy the same circular geography.",
    href: "#atlas",
    accent: "violet",
  },
  {
    label: "New dossier",
    title: "The Hatter and the Diamond Highlands",
    note: "A character, a regional economy, and a mystery that can rewrite a room.",
    href: "#hatter",
    accent: "yellow",
  },
  {
    label: "Power system",
    title: "Who actually rules Wonderland?",
    note: "Land, commodities, labor, and force belong to different Houses.",
    href: "#houses",
    accent: "magenta",
  },
];
---

<section class="oaa-start">
  <OaaProjectNav current="start" />

  <header class="oaa-hero">
    <img
      class="oaa-hero__art"
      src="/media/other-alice/other-alice-living-map-hero.webp"
      alt="Other Alice and Chester overlook a wet circular Wonderland where future systems glow through the living landscape."
      width="1536"
      height="1024"
      decoding="async"
      fetchpriority="high"
    />
    <div class="oaa-hero__veil" aria-hidden="true"></div>
    <div class="oaa-hero__copy">
      <p class="oaa-eyebrow">HobFarm Presents</p>
      <h1>Other Alice<br />Adventures</h1>
      <p class="oaa-hero__premise">
        Alice has lived in Wonderland for ten years. Outside, two centuries have passed. Now future systems are bleeding into Wonderland's dream logic, and its routes no longer match the official map.
      </p>
      <p class="oaa-hero__format">{otherAliceCanon.formatLine}</p>
      <div class="oaa-actions">
        {currentAdventure && <a class="oaa-action oaa-action--primary" href={adventurePath(currentAdventure)}>Enter the current story</a>}
        <a class="oaa-action" href="#atlas">Open the living map</a>
      </div>
      <dl class="oaa-chronology" aria-label="Other Alice chronology">
        <div><dt>Alice</dt><dd>18</dd></div>
        <div><dt>Arrived</dt><dd>8</dd></div>
        <div><dt>Wonderland</dt><dd>10 years</dd></div>
        <div><dt>Outside</dt><dd>200 years / circa 2070s</dd></div>
      </dl>
    </div>
    <a class="oaa-hero__continue" href="#routes">Choose an entry point</a>
  </header>

  <div class="oaa-shell">
    <section id="routes" class="oaa-routes" aria-labelledby="routes-heading">
      <header class="oaa-section-heading oaa-section-heading--compact">
        <p>Start here</p>
        <h2 id="routes-heading">Where do you want to begin?</h2>
      </header>
      <div class="oaa-routes__grid">
        {startRoutes.map((route, index) => (
          <a href={route.href} class={`oaa-route oaa-route--${route.accent}`}>
            <span>{String(index + 1).padStart(2, "0")} / {route.label}</span>
            <strong>{route.title}</strong>
            <p>{route.note}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="adventures" class="oaa-story" aria-labelledby="story-heading">
      <header class="oaa-section-heading">
        <p>Current adventure</p>
        <h2 id="story-heading">The story comes before the encyclopedia.</h2>
      </header>
      {currentAdventure ? (
        <article class="oaa-story__feature">
          <a class="oaa-story__image" href={adventurePath(currentAdventure)}>
            <img src={currentImage} alt={currentImageAlt} width="1200" height="1500" loading="lazy" decoding="async" />
          </a>
          <div class="oaa-story__copy">
            <p class="oaa-label">Adventure {String(currentAdventure.data.number).padStart(2, "0")} / {currentAdventure.data.region ?? "Route pending"}</p>
            <h3>{currentAdventure.data.title}</h3>
            <p>{currentAdventure.data.teaser}</p>
            <dl>
              <div><dt>Record</dt><dd>{currentAdventure.data.status}</dd></div>
              <div><dt>Pressure point</dt><dd>The official map cannot explain the evidence at its edge.</dd></div>
            </dl>
            <a class="oaa-text-link" href={adventurePath(currentAdventure)}>Read the current fragment</a>
          </div>
        </article>
      ) : (
        <p class="oaa-empty">The first published route record is still being prepared.</p>
      )}
    </section>

    <section id="atlas" class="oaa-atlas" aria-labelledby="atlas-heading">
      <header class="oaa-section-heading oaa-section-heading--split">
        <div>
          <p>Living atlas</p>
          <h2 id="atlas-heading">One realm. Three readings of power.</h2>
        </div>
        <p>The Court, the people who keep the realm running, and the systems they depend on all use the same geography. Their maps disagree because their interests do.</p>
      </header>
      <div class="oaa-atlas__stage">
        <figure>
          <img
            src="/media/other-alice/wonderland-circular-world-concept.webp"
            alt="Alternate aerial concept of circular Wonderland with the Heart city at its center and boundary mountains around its edge."
            width="1254"
            height="1254"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Concept record / one useful world view, not the only map</figcaption>
        </figure>
        <div class="oaa-atlas__interface">
          <div class="oaa-atlas__tabs" role="group" aria-label="Choose a political map reading">
            {politicalMapViews.map((view, index) => (
              <button
                type="button"
                data-map-tab
                data-title={view.title}
                data-description={view.description}
                data-shows={view.shows.join("|")}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                {view.label}
              </button>
            ))}
          </div>
          <div class="oaa-atlas__reading" aria-live="polite">
            <p class="oaa-label">Active reading</p>
            <h3 data-map-title>{politicalMapViews[0].title}</h3>
            <p data-map-description>{politicalMapViews[0].description}</p>
            <ul data-map-shows>
              {politicalMapViews[0].shows.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <a class="oaa-text-link" href={`${OTHER_ALICE_WORLD_GUIDE_PATH}#regions`}>Open the complete atlas</a>
        </div>
      </div>
    </section>

    <section id="cast" class="oaa-cast" aria-labelledby="cast-heading">
      <header class="oaa-section-heading oaa-section-heading--split">
        <div>
          <p>Character and world system</p>
          <h2 id="cast-heading">Build the world character by character.</h2>
        </div>
        <p>Each important resident gets a full dossier. It connects appearance, region, work, political pressure, relationships, artifacts, mysteries, and story routes.</p>
      </header>

      <article class="oaa-character oaa-character--alice">
        <figure>
          <img src={alice.image} alt={alice.imageAlt} width="1400" height="1050" loading="lazy" decoding="async" />
          <figcaption>Working canon sheet / silhouette, field clothes, motifs, and material detail</figcaption>
        </figure>
        <div class="oaa-character__copy">
          <p class="oaa-label">Alice / Age 18 / Unsuited</p>
          <h3>Curious. Composed. Unbound.</h3>
          <p>{alice.summary[1]}</p>
          <dl>
            <div><dt>Arrived</dt><dd>Age eight</dd></div>
            <div><dt>Time below</dt><dd>Ten years</dd></div>
            <div><dt>Outside elapsed</dt><dd>Two centuries</dd></div>
            <div><dt>Public role</dt><dd>Boundary-tester and field observer</dd></div>
          </dl>
          <a class="oaa-text-link" href={alice.href}>Open Alice's character guide</a>
        </div>
      </article>

      <article id="hatter" class="oaa-character oaa-character--hatter">
        <figure>
          <img src={hatterWorldFeature.image} alt={hatterWorldFeature.imageAlt} width="1122" height="1402" loading="lazy" decoding="async" />
          <figcaption>Working concept / the Hatter above the cultivated Diamond Highlands</figcaption>
        </figure>
        <div class="oaa-character__copy">
          <p class="oaa-label">{hatterWorldFeature.status} / Diamonds</p>
          <h3>The Hatter and the Diamond Highlands</h3>
          <p class="oaa-character__lead">{hatterWorldFeature.premise}</p>
          <p>{hatterWorldFeature.regionLogic}</p>
          <blockquote>{hatterWorldFeature.storyEngine}</blockquote>
          <ol class="oaa-power-chain">
            {hatterWorldFeature.powerChain.map((line) => <li>{line}</li>)}
          </ol>
          <details>
            <summary>Open canon questions</summary>
            <ul>{hatterWorldFeature.openQuestions.map((question) => <li>{question}</li>)}</ul>
          </details>
          <a class="oaa-text-link" href={hatter.href}>Open the Hatter's full dossier</a>
        </div>
      </article>

      <article class="oaa-character oaa-character--chester">
        <figure>
          <img src={chester.image} alt={chester.imageAlt} width="1400" height="1050" loading="lazy" decoding="async" />
          <figcaption>Canonical direction / normal cat, abnormal route knowledge</figcaption>
        </figure>
        <div class="oaa-character__copy">
          <p class="oaa-label">Chester / Unsuited / Route authority</p>
          <h3>Old, fat, lazy, and usually right.</h3>
          <p>{chester.summary[0]}</p>
          <ul class="oaa-rules">
            <li>If Chester refuses a route, Alice stops.</li>
            <li>If he sleeps beside a doorway, the passage is stable.</li>
            <li>If he stares at a blank wall, an opening exists there or soon will.</li>
          </ul>
          <a class="oaa-text-link" href={chester.href}>Open Chester's character guide</a>
        </div>
      </article>
    </section>

    <section id="houses" class="oaa-houses" aria-labelledby="houses-heading">
      <header class="oaa-section-heading oaa-section-heading--split">
        <div>
          <p>House machine</p>
          <h2 id="houses-heading">The Hearts own the map. The other Houses own the places on it.</h2>
        </div>
        <p>Wonderland separates legal ownership, commercial value, practical labor, and physical enforcement. Every region becomes a negotiation among all four.</p>
      </header>
      <div class="oaa-houses__grid">
        {courtDossiers.map((house) => (
          <article style={`--house:${house.accent}`}>
            <p>{house.sigil} / {house.powerForm}</p>
            <h3>{house.name}</h3>
            <strong>{house.materialControl}</strong>
            <dl>
              <div><dt>Needs</dt><dd>{house.needs}</dd></div>
              <div><dt>Can withhold</dt><dd>{house.canWithhold}</dd></div>
            </dl>
            <a href={`${OTHER_ALICE_HOUSES_PATH}#${house.id}`}>Open House record</a>
          </article>
        ))}
      </div>
    </section>

    <section class="oaa-web" aria-labelledby="web-heading">
      <header class="oaa-section-heading oaa-section-heading--split">
        <div>
          <p>Web of Wonderland</p>
          <h2 id="web-heading">A faction map made from evidence.</h2>
        </div>
        <p>Relationships are claims with sources. The web tracks authority, debt, labor, routes, affection, rivalry, and disputed testimony without pretending every connection is settled.</p>
      </header>
      <OaaRelationshipWeb compact />
    </section>

    <section id="archive" class="oaa-artbook" aria-labelledby="artbook-heading">
      <header class="oaa-section-heading oaa-section-heading--split">
        <div>
          <p>Concept art and evidence</p>
          <h2 id="artbook-heading">The world can hold several true views at once.</h2>
        </div>
        <p>These are working visual records. They establish useful canon without turning a single image into the only possible view of a person or place.</p>
      </header>
      <div class="oaa-artbook__grid">
        {otherAliceConceptArt.map((record, index) => (
          <figure class:list={[index === 0 && "oaa-artbook__wide"]}>
            <img src={record.image} alt={record.imageAlt} width={index === 1 ? "900" : index === 2 ? "1254" : "1400"} height={index === 1 ? "1350" : index === 2 ? "1254" : "1050"} loading="lazy" decoding="async" />
            <figcaption>
              <span>{record.kind}</span>
              <strong>{record.title}</strong>
              <p>{record.note}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="oaa-archive" aria-labelledby="archive-heading">
      <header class="oaa-section-heading oaa-section-heading--compact">
        <p>Archive fragments</p>
        <h2 id="archive-heading">Evidence first. Explanations can catch up later.</h2>
      </header>
      <div class="oaa-archive__grid">
        {archiveRecords.map((record) => (
          <article>
            <p>{record.recordClass} / {record.certainty}</p>
            <h3>{record.title}</h3>
            <span>{record.summary}</span>
            <dl><dt>Linked mystery</dt><dd>{record.linkedMystery}</dd></dl>
          </article>
        ))}
      </div>
      <a class="oaa-text-link" href={`${OTHER_ALICE_WORLD_GUIDE_PATH}#archive`}>Open the working archive</a>
    </section>
  </div>

  <section id="workshop" class="oaa-workshop" aria-labelledby="workshop-heading">
    <div class="oaa-shell oaa-workshop__grid">
      <div>
        <img src="/media/other-alice/melting-rabbit-project-mark.webp" alt="" width="512" height="512" loading="lazy" decoding="async" />
        <p class="oaa-label">Workshop and route bulletin</p>
        <h2 id="workshop-heading">Watch the world take shape.</h2>
        <p>New stories arrive beside character sheets, maps, regional economies, creatures, artifacts, moving fragments, and production notes.</p>
      </div>
      <Subscribe
        heading="Receive the route bulletin"
        description="New stories and evidence records arrive when the route is stable enough to publish."
      />
    </div>
  </section>

  <script>
    const mapTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-map-tab]"));
    const mapTitle = document.querySelector<HTMLElement>("[data-map-title]");
    const mapDescription = document.querySelector<HTMLElement>("[data-map-description]");
    const mapShows = document.querySelector<HTMLUListElement>("[data-map-shows]");

    mapTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        mapTabs.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === tab)));
        if (mapTitle) mapTitle.textContent = tab.dataset.title ?? "";
        if (mapDescription) mapDescription.textContent = tab.dataset.description ?? "";
        if (mapShows) {
          mapShows.replaceChildren(
            ...(tab.dataset.shows ?? "")
              .split("|")
              .filter(Boolean)
              .map((item) => Object.assign(document.createElement("li"), { textContent: item })),
          );
        }
      });
    });
  </script>
</section>

<style>
  .oaa-start {
    --oaa-bg: #050509;
    --oaa-panel: #0a0910;
    --oaa-line: rgb(221 207 255 / 18%);
    --oaa-text: #f3edf9;
    --oaa-muted: #a49bab;
    --oaa-violet: #b56bff;
    --oaa-cyan: #37dbe7;
    --oaa-magenta: #ff4da6;
    --oaa-yellow: #ead647;
    overflow: hidden;
    background: var(--oaa-bg);
    color: var(--oaa-text);
  }

  .oaa-shell {
    width: min(100%, 96rem);
    margin-inline: auto;
    padding-inline: clamp(1rem, 3.2vw, 3.5rem);
  }

  .oaa-hero {
    position: relative;
    min-height: clamp(46rem, calc(100svh - 4rem), 64rem);
    isolation: isolate;
    overflow: hidden;
    border-bottom: 1px solid var(--oaa-line);
    background: #050509;
  }

  .oaa-hero__art,
  .oaa-hero__veil {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .oaa-hero__art {
    z-index: -3;
    object-fit: cover;
    object-position: center;
  }

  .oaa-hero__veil {
    z-index: -2;
    background: linear-gradient(90deg, #050509 0%, rgb(5 5 9 / 96%) 23%, rgb(5 5 9 / 72%) 42%, rgb(5 5 9 / 8%) 72%), linear-gradient(0deg, rgb(5 5 9 / 82%) 0%, transparent 30%);
  }

  .oaa-hero__copy {
    display: flex;
    width: min(100%, 96rem);
    min-height: inherit;
    margin-inline: auto;
    flex-direction: column;
    justify-content: center;
    padding: clamp(5rem, 10vh, 8rem) clamp(1.25rem, 4vw, 4rem) 7rem;
  }

  .oaa-eyebrow,
  .oaa-label,
  .oaa-section-heading > p,
  .oaa-section-heading > div > p {
    margin: 0;
    color: var(--oaa-violet);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .oaa-hero h1 {
    max-width: 8ch;
    margin: 1rem 0 0;
    color: #eee4f8;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4.4rem, 9.4vw, 9.5rem);
    font-weight: 400;
    letter-spacing: -0.075em;
    line-height: 0.79;
    text-wrap: balance;
  }

  .oaa-hero__premise {
    max-width: 35rem;
    margin: 1.8rem 0 0;
    color: #d2cad8;
    font-size: clamp(1rem, 1.35vw, 1.24rem);
    line-height: 1.62;
  }

  .oaa-hero__format {
    max-width: 36rem;
    margin: 1.1rem 0 0;
    color: #c787ff;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.05rem, 1.55vw, 1.42rem);
    line-height: 1.45;
  }

  .oaa-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.8rem;
  }

  .oaa-action {
    display: inline-flex;
    min-height: 3.2rem;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.25rem;
    border: 1px solid #9f59e7;
    color: #eadff3;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .oaa-action--primary {
    border-color: #9550ee;
    background: #8f3fea;
    color: #fff;
  }

  .oaa-action:hover,
  .oaa-action:focus-visible {
    border-color: #f4eeff;
    background: #f4eeff;
    color: #09070d;
    outline: none;
  }

  .oaa-chronology {
    display: flex;
    max-width: 48rem;
    flex-wrap: wrap;
    gap: 0;
    margin: 2rem 0 0;
  }

  .oaa-chronology div {
    display: flex;
    gap: 0.35rem;
    align-items: baseline;
    padding: 0.25rem 0.8rem 0.25rem 0;
    margin-right: 0.8rem;
    border-right: 1px solid var(--oaa-line);
  }

  .oaa-chronology dt,
  .oaa-story dt,
  .oaa-character dt,
  .oaa-houses dt,
  .oaa-archive dt {
    color: #766e7e;
    font-family: var(--font-mono);
    font-size: 0.57rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .oaa-chronology dd {
    margin: 0;
    color: #d8d0df;
    font-family: var(--font-mono);
    font-size: 0.64rem;
  }

  .oaa-hero__continue {
    position: absolute;
    bottom: 1.5rem;
    left: clamp(1.25rem, 4vw, 4rem);
    color: #a59eac;
    font-family: var(--font-mono);
    font-size: 0.57rem;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .oaa-routes,
  .oaa-story,
  .oaa-atlas,
  .oaa-cast,
  .oaa-houses,
  .oaa-web,
  .oaa-artbook,
  .oaa-archive {
    padding-top: clamp(5rem, 10vw, 9rem);
    scroll-margin-top: 5rem;
  }

  .oaa-section-heading {
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--oaa-line);
  }

  .oaa-section-heading h2,
  .oaa-workshop h2 {
    max-width: 15ch;
    margin: 0.7rem 0 0;
    color: #f1eaf7;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.65rem, 5.4vw, 5.8rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .oaa-section-heading--compact h2 {
    max-width: 21ch;
    font-size: clamp(2.3rem, 4.2vw, 4.4rem);
  }

  .oaa-section-heading--split {
    display: grid;
    gap: 1.5rem;
    align-items: end;
  }

  .oaa-section-heading--split > p {
    max-width: 40rem;
    margin: 0;
    color: var(--oaa-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .oaa-routes__grid {
    display: grid;
    margin-top: 1rem;
    border-top: 1px solid var(--oaa-line);
  }

  .oaa-route {
    display: grid;
    gap: 0.55rem;
    min-height: 13rem;
    padding: 1.4rem 1rem 1.5rem 0;
    border-bottom: 1px solid var(--oaa-line);
    color: inherit;
    text-decoration: none;
  }

  .oaa-route span {
    color: var(--route-accent, var(--oaa-violet));
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .oaa-route strong {
    max-width: 18ch;
    color: #eee7f4;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.45rem;
    font-weight: 400;
    line-height: 1.05;
  }

  .oaa-route p {
    max-width: 31rem;
    margin: 0;
    color: #918998;
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .oaa-route:hover,
  .oaa-route:focus-visible {
    padding-left: 1rem;
