---
import OaaProjectNav from "./OaaProjectNav.astro";
import LivingAtlas from "./living-world/LivingAtlas.astro";
import RouteAtlas from "./living-world/RouteAtlas.astro";
import VisitorImprint from "./living-world/VisitorImprint.astro";
import HousePowerStack from "./living-world/HousePowerStack.astro";
import BoundaryRecord from "./living-world/BoundaryRecord.astro";
import WorkshopContactSheet from "./living-world/WorkshopContactSheet.astro";
import {
  OTHER_ALICE_HOUSES_PATH, OTHER_ALICE_WEB_PATH, OTHER_ALICE_WORLD_GUIDE_PATH,
  chronologyRail, otherAliceChronology, otherAliceResidents, archiveRecords, bestiaryRecords,
} from "@/data/other-alice-world-guide";
---
<div class="oaa-world">
 <OaaProjectNav current="start" />
 <header class="hero">
  <div class="hero-art" aria-hidden="true"><img src="https://cdn.hob.farm/pages/other-alice-adventures/other-alice-wonderland-wasteland-poster.webp" alt="" width="900" height="1350" sizes="(max-width: 780px) 100vw, 38vw" fetchpriority="high"/></div>
  <div class="hero-copy">
   <p class="eyebrow">HobFarm Presents</p>
   <h1>Other Alice Adventures</h1>
   <p class="deck">{otherAliceChronology.startDeck}</p>
   <p class="format">A graphic novel that escaped the book and began using the whole website.</p>
   <nav class="actions" aria-label="Explore Other Alice">
    <a href={OTHER_ALICE_WORLD_GUIDE_PATH}>Explore Wonderland</a>
    <a href={OTHER_ALICE_HOUSES_PATH}>See who holds power</a>
    <a href={OTHER_ALICE_WEB_PATH}>Open the Web of Wonderland</a>
   </nav>
   <p class="chronology-line">{otherAliceChronology.rail}</p>
  </div>
 </header>

 <section class="section atlas-section" aria-labelledby="glance-title">
  <div class="section-heading"><p class="index">01 / The inhabited world</p><h2 id="glance-title">Wonderland is inhabited, maintained, traded, taxed, and argued over.</h2><p>The Queen's court claims one circular realm. Daily power follows land, companies, water, labor, roads, appetite, and the people who can keep a place working.</p></div>
  <LivingAtlas />
 </section>

 <section class="section systems" aria-labelledby="systems-title">
  <div class="section-heading"><p class="index">02 / Systems in motion</p><h2 id="systems-title">The world does not wait for Alice.</h2><p>Workers, animals, courts, routes, crops, markets, and old visitor traces keep changing when she is elsewhere. Alice connects the records. She does not create the life inside them.</p></div>
  <div class="system-strip">
   <a href={`${OTHER_ALICE_WORLD_GUIDE_PATH}#routes`}><span>Present routes</span><strong>Alice moves through systems already in use.</strong></a>
   <a href={`${OTHER_ALICE_WORLD_GUIDE_PATH}#regions`}><span>Regional life</span><strong>Every place has labor, institutions, and material needs.</strong></a>
   <a href={`${OTHER_ALICE_WORLD_GUIDE_PATH}#visitors`}><span>Historical layers</span><strong>Objects and methods survive through local adaptation.</strong></a>
   <a href={`${OTHER_ALICE_WORLD_GUIDE_PATH}#access`}><span>Thresholds</span><strong>Resonance becomes access only after choice and cost.</strong></a>
   <a href={`${OTHER_ALICE_WORLD_GUIDE_PATH}#ecology`}><span>Repeated use</span><strong>Change spreads through work, repair, trade, and ecology.</strong></a>
  </div>
 </section>

 <section class="section" aria-labelledby="houses-title">
  <div class="section-heading"><p class="index">03 / The shared estate</p><h2 id="houses-title">Four powers occupy the same ground.</h2></div>
  <HousePowerStack />
  <p class="section-link"><a href={OTHER_ALICE_HOUSES_PATH}>Read the House dossiers →</a></p>
 </section>

 <section class="section route-section" aria-labelledby="routes-title">
  <div class="section-heading"><p class="index">04 / Routes</p><h2 id="routes-title">Distance is only one obstacle.</h2><p>Radial routes carry the center outward. Orbital routes let regions trade around it. Burrow routes ignore ordinary distance and make access a form of power.</p></div>
  <RouteAtlas compact />
 </section>

 <section class="section visitor-section" aria-labelledby="visitor-title">
  <div class="section-heading"><p class="index">05 / Visitors and time</p><h2 id="visitor-title">Wonderland keeps what people leave behind.</h2><p>A visitor may leave an object, method, name, organism, habit, or rule. Local people decide what survives. Repetition turns private residue into custom, infrastructure, ecology, or law.</p></div>
  <VisitorImprint compact />
  <div class="chronology">{chronologyRail.map((item)=><article><span>{item.label}</span><strong>{item.value}</strong><p>{item.note}</p></article>)}</div>
 </section>

 <section class="section evidence-section" aria-labelledby="evidence-title">
  <div class="section-heading"><p class="index">06 / Residents, ecology, evidence</p><h2 id="evidence-title">A world record needs people, work, organisms, and doubt.</h2></div>
  <div class="evidence-layout">
   <article class="alice-plate"><img src="https://cdn.hob.farm/pages/other-alice-adventures/other-alice-character-sheet.webp" width="1400" height="1050" loading="lazy" alt="Approved character sheet showing Other Alice in a purple dress, with field tools and multiple views."/><div><p class="index">Dominant resident record</p><h3>Other Alice</h3><p>{otherAliceResidents[0].summary.join(" ")}</p></div></article>
   <div class="evidence-column">
    {otherAliceResidents.slice(1,4).map((resident)=><article><p class="index">{resident.role}</p><h3>{resident.name}</h3><p>{resident.summary.join(" ")}</p></article>)}
   </div>
   <div class="evidence-column narrow">
    <article><p class="index">Living infrastructure</p><h3>{bestiaryRecords[0].title}</h3><p>{bestiaryRecords[0].summary}</p></article>
    <article><p class="index">Creature record</p><h3>{bestiaryRecords[1].title}</h3><p>{bestiaryRecords[1].summary}</p></article>
    <article><p class="index">Disputed artifact</p><h3>{archiveRecords[1].title}</h3><p>{archiveRecords[1].summary}</p></article>
   </div>
  </div>
 </section>

 <section class="section" aria-labelledby="workshop-title">
  <div class="section-heading"><p class="index">07 / Public Workshop</p><h2 id="workshop-title">The world guide shows its working parts.</h2><p>Maps, identity locks, diagrams, material studies, and canon labels make the construction record visible without exposing private story development.</p></div>
  <WorkshopContactSheet />
 </section>

 <section class="section"><BoundaryRecord /></section>
</div>
<style>
 .oaa-world{--paper:#eee7d6;--ink:#090b12;--muted:#acb1bd;overflow:hidden;background:#080a11;color:var(--paper)}
 .hero{display:grid;grid-template-columns:minmax(20rem,.75fr) minmax(0,1.25fr);min-height:clamp(42rem,78vh,62rem);max-width:100rem;margin:auto;border-inline:1px solid rgba(255,255,255,.1)}.hero-art{position:relative;overflow:hidden;background:#14121e}.hero-art:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent 60%,#080a11)}.hero-art img{width:100%;height:100%;object-fit:cover;object-position:center}.hero-copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(2rem,7vw,7rem)}.eyebrow,.index{color:#a88cff;font:600 .68rem/1 ui-monospace,SFMono-Regular,monospace;letter-spacing:.16em;text-transform:uppercase}.hero h1{max-width:11ch;margin:.7rem 0 1.5rem;font:400 clamp(3.7rem,8vw,8.6rem)/.83 Georgia,serif;letter-spacing:-.065em}.deck{max-width:43rem;margin:0;color:#d6d7db;font-size:clamp(1.15rem,2vw,1.65rem);line-height:1.45}.format{margin:1.4rem 0;color:#9ea4b2;font-style:italic}.actions{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1rem}.actions a,.section-link a{border:1px solid #5f6674;border-radius:999px;padding:.7rem 1rem;color:#fff;font:600 .72rem/1 ui-monospace,monospace;text-transform:uppercase;text-decoration:none}.actions a:first-child{background:var(--paper);color:#0a0b10}.actions a:hover,.actions a:focus-visible,.section-link a:hover,.section-link a:focus-visible{outline:2px solid #9f7aea;outline-offset:3px}.chronology-line{margin-top:2rem;color:#8f95a4;font:600 .69rem/1.6 ui-monospace,monospace;text-transform:uppercase}.chronology-line i{padding:.3rem;color:#9f7aea;font-style:normal}
 .section{max-width:90rem;margin:auto;padding:clamp(4rem,9vw,9rem) clamp(1rem,4vw,4rem);border-top:1px solid rgba(255,255,255,.1)}.section-heading{display:grid;grid-template-columns:minmax(10rem,.3fr) minmax(0,1fr);gap:1rem 3rem;margin-bottom:clamp(2rem,5vw,4rem)}.section-heading .index{grid-row:1/3}.section-heading h2{max-width:23ch;margin:0;font:400 clamp(2.25rem,5vw,5rem)/.98 Georgia,serif;letter-spacing:-.035em}.section-heading>p:not(.index){max-width:48rem;margin:0;color:var(--muted);font-size:1rem;line-height:1.7}.system-strip{display:grid;grid-template-columns:repeat(5,1fr);border:1px solid rgba(255,255,255,.13)}.system-strip a{min-height:14rem;padding:1rem;border-right:1px solid rgba(255,255,255,.12);color:#fff;text-decoration:none;background:linear-gradient(180deg,rgba(159,122,234,.08),transparent)}.system-strip a:last-child{border:0}.system-strip a:hover,.system-strip a:focus-visible{background:#171c29;outline:2px solid #9f7aea;outline-offset:-2px}.system-strip span{display:block;color:#8e95a4;font:600 .65rem/1 ui-monospace,monospace;text-transform:uppercase}.system-strip strong{display:block;margin-top:5rem;font:400 1.05rem/1.35 Georgia,serif}.section-link{margin-top:1.5rem}.chronology{display:grid;grid-template-columns:repeat(4,1fr);margin-top:2rem;border:1px solid rgba(255,255,255,.13)}.chronology article{padding:1rem;border-right:1px solid rgba(255,255,255,.12)}.chronology span{color:#8f95a4;font:600 .65rem/1 ui-monospace,monospace;text-transform:uppercase}.chronology strong{display:block;margin:2rem 0 .7rem;font-size:1.25rem}.chronology p{color:#aeb3bf;font-size:.86rem;line-height:1.55}
 .evidence-layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(13rem,.7fr) minmax(12rem,.55fr);gap:1rem}.alice-plate{position:relative;overflow:hidden;min-height:40rem;background:#eee}.alice-plate img{width:100%;height:100%;object-fit:cover}.alice-plate div{position:absolute;inset:auto 1rem 1rem;padding:1rem;background:rgba(8,10,17,.9);backdrop-filter:blur(10px)}.alice-plate h3,.evidence-column h3{margin:.5rem 0;color:#fff;font:400 1.5rem/1.1 Georgia,serif}.alice-plate p,.evidence-column p{color:#b5bac5;line-height:1.55}.evidence-column{display:grid;gap:1rem}.evidence-column article{padding:1rem;border:1px solid rgba(255,255,255,.13);background:#0e121c}.evidence-column.narrow article:nth-child(2){border-color:#557c70}.evidence-column.narrow article:nth-child(3){border-style:dashed;border-color:#9f7aea}
 @media(max-width:900px){.hero{grid-template-columns:1fr;min-height:auto}.hero-art{height:32rem}.hero-art:after{background:linear-gradient(0deg,#080a11,transparent 55%)}.hero-copy{margin-top:-8rem;position:relative}.section-heading{grid-template-columns:1fr}.section-heading .index{grid-row:auto}.system-strip{grid-template-columns:repeat(2,1fr)}.system-strip a{min-height:11rem}.chronology{grid-template-columns:1fr 1fr}.evidence-layout{grid-template-columns:1fr 1fr}.alice-plate{grid-column:1/-1;min-height:30rem}}
 @media(max-width:560px){.hero-art{height:27rem}.hero-copy{padding:1rem}.hero h1{font-size:3.7rem}.actions{display:grid}.actions a{text-align:center}.section{padding-block:4rem}.system-strip,.chronology,.evidence-layout{grid-template-columns:1fr}.system-strip a{min-height:auto}.system-strip strong{margin-top:2rem}.chronology article{border-right:0;border-bottom:1px solid rgba(255,255,255,.12)}.alice-plate{min-height:27rem}.evidence-column{grid-column:1}.section-heading h2{font-size:2.35rem}}
</style>
