---
import { accessStages } from "@/data/other-alice-world-guide";
---
<ol class="access-sequence">
 {accessStages.map((stage)=><li><span>{stage.n}</span><div><h3>{stage.title}</h3><p>{stage.text}</p></div></li>)}
</ol>
<style>
 .access-sequence{display:grid;grid-template-columns:repeat(6,1fr);gap:0;margin:1.5rem 0 0;padding:0;list-style:none;border-block:1px solid rgba(255,255,255,.14)}
 li{position:relative;min-height:13rem;padding:1rem;border-right:1px solid rgba(255,255,255,.12);background:linear-gradient(180deg,rgba(159,122,234,.08),transparent)}li:last-child{border-right:0}span{color:#9f7aea;font:600 .7rem/1 ui-monospace,monospace}h3{margin:3rem 0 .5rem;color:#fff;font-size:1rem}p{margin:0;color:#aeb3c0;font-size:.84rem;line-height:1.55}
 @media(max-width:900px){.access-sequence{grid-template-columns:repeat(3,1fr)}li:nth-child(3){border-right:0}}
 @media(max-width:540px){.access-sequence{grid-template-columns:1fr}li{min-height:auto;border-right:0;border-bottom:1px solid rgba(255,255,255,.12);display:grid;grid-template-columns:2.5rem 1fr}h3{margin:0 0 .4rem}}
</style>
