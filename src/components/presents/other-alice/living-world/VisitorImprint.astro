---
import {
  aliceVisitorRecord,
  visitorImprintStages,
  visitorThresholdStages,
} from "@/data/other-alice-world-guide";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const idSuffix = compact ? "compact" : "full";
---

<div class:list={["visitor-route", compact && "compact"]} data-visitor-route>
  <div class="route-diagram">
    <section class="route-group threshold-route" aria-labelledby={`threshold-route-${idSuffix}`}>
      <header>
        <p>Route 01</p>
        <h3 id={`threshold-route-${idSuffix}`}>Threshold route</h3>
      </header>
      <ol>
        {visitorThresholdStages.map((stage, index) => (
          <li data-stage={stage.id}>
            <span class="stage-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <strong>{stage.title}</strong>
              <p>{stage.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <div class="wet-gate" aria-hidden="true">
      <span></span>
      <i></i>
    </div>

    <section class="route-group imprint-route" aria-labelledby={`imprint-route-${idSuffix}`}>
      <header>
        <p>Route 02</p>
        <h3 id={`imprint-route-${idSuffix}`}>Imprint route</h3>
      </header>
      <ol>
        {visitorImprintStages.map((stage, index) => (
          <li data-stage={stage.id}>
            <span class="stage-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <strong>{stage.title}</strong>
              <p>{stage.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <aside class="alice-record" aria-labelledby={`alice-visitor-record-${idSuffix}`} data-record-id={aliceVisitorRecord.entityRef}>
    <header>
      <p>{aliceVisitorRecord.label}</p>
      <h3 id={`alice-visitor-record-${idSuffix}`}>Two choices establish the resident.</h3>
    </header>
    <dl class="choice-records">
      {aliceVisitorRecord.choices.map((choice) => (
        <div class="choice-record">
          <dt>{choice.label}</dt>
          <dd>{choice.summary}</dd>
        </div>
      ))}
    </dl>
    <dl class="field-records">
      {aliceVisitorRecord.fields.map((field) => (
        <div>
          <dt>{field.label}</dt>
          <dd>{field.value}</dd>
        </div>
      ))}
    </dl>
  </aside>
</div>

<style>
  .visitor-route {
    --alice-cyan: #49c6d7;
    --alice-magenta: #c044b5;
    --alice-purple: #9f7aea;
    color: #d7d9e0;
  }
  .route-diagram {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) 4.75rem minmax(0, 1.55fr);
    align-items: stretch;
    border-block: 1px solid rgba(255, 255, 255, 0.14);
    background: #080a11;
  }
  .route-group { min-width: 0; padding: clamp(1rem, 2.5vw, 2rem); }
  .route-group header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1.4rem; }
  .route-group header p, .alice-record header p {
    margin: 0;
    color: #7f8797;
    font: 600 0.6rem/1 ui-monospace, SFMono-Regular, monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .route-group h3, .alice-record h3 { margin: 0; color: #fff; font: 400 1.35rem/1.05 Georgia, serif; }
  .route-group ol { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .threshold-route ol { grid-template-columns: 1fr 1fr; }
  .imprint-route ol { grid-template-columns: repeat(4, 1fr); }
  .route-group li {
    position: relative;
    display: grid;
    grid-template-columns: 1.7rem minmax(0, 1fr);
    gap: 0.65rem;
    min-width: 0;
    min-height: 10.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    padding: 0.85rem 0.7rem 1rem 0;
  }
  .route-group li::after {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 1.7rem;
    height: 1px;
    background: #6d7380;
  }
  .threshold-route li:nth-child(even) { margin-top: 1.7rem; }
  .threshold-route li:nth-child(3) { border-top-color: rgba(73, 198, 215, 0.68); }
  .threshold-route li:nth-child(4) { border-top-color: rgba(192, 68, 181, 0.68); }
  .stage-number {
    display: grid;
    width: 1.45rem;
    height: 1.45rem;
    place-items: center;
    border: 1px solid #5b6270;
    border-radius: 50%;
    color: #939aa8;
    font: 600 0.55rem/1 ui-monospace, SFMono-Regular, monospace;
  }
  .threshold-route .stage-number {
    border-color: var(--alice-purple);
    color: #fff;
    box-shadow: -2px 0 0 rgba(73, 198, 215, 0.72), 2px 0 0 rgba(192, 68, 181, 0.72);
  }
  .route-group strong { display: block; color: #f2f0eb; font: 600 0.7rem/1.25 ui-monospace, SFMono-Regular, monospace; text-transform: uppercase; }
  .route-group li p { margin: 0.65rem 0 0; color: #9fa5b2; font-size: 0.78rem; line-height: 1.52; }
  .wet-gate {
    position: relative;
    overflow: hidden;
    min-height: 100%;
    border-inline: 1px solid rgba(255, 255, 255, 0.13);
    background:
      radial-gradient(circle at 50% 18%, rgba(73, 198, 215, 0.2), transparent 21%),
      radial-gradient(circle at 42% 67%, rgba(192, 68, 181, 0.22), transparent 28%),
      linear-gradient(180deg, #101820, #120c18 58%, #080a11);
  }
  .wet-gate::before, .wet-gate::after {
    content: "";
    position: absolute;
    inset: 8% 19%;
    border: 1px solid rgba(159, 122, 234, 0.52);
    border-radius: 52% 42% 58% 38% / 35% 57% 43% 65%;
  }
  .wet-gate::after { inset: 17% 30%; border-color: rgba(73, 198, 215, 0.45); transform: rotate(9deg); }
  .wet-gate span {
    position: absolute;
    top: 12%;
    left: 50%;
    width: 1px;
    height: 76%;
    background: linear-gradient(180deg, transparent, var(--alice-cyan) 26%, var(--alice-magenta) 72%, transparent);
  }
  .wet-gate i {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: #080a11;
    box-shadow: -3px 0 var(--alice-cyan), 3px 0 var(--alice-magenta);
    transform: translate(-50%, -50%);
  }
  .alice-record {
    display: grid;
    grid-template-columns: minmax(13rem, 0.45fr) minmax(15rem, 0.65fr) minmax(0, 1.5fr);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    background:
      linear-gradient(90deg, rgba(73, 198, 215, 0.08), transparent 12%),
      linear-gradient(90deg, transparent 88%, rgba(192, 68, 181, 0.08)),
      #0c0f17;
  }
  .alice-record > * { min-width: 0; padding: clamp(1rem, 2.5vw, 2rem); }
  .alice-record header { border-right: 1px solid rgba(255, 255, 255, 0.12); }
  .alice-record header p { color: var(--alice-purple); }
  .alice-record h3 { max-width: 13ch; margin-top: 0.7rem; }
  .choice-records, .field-records { display: grid; margin: 0; }
  .choice-records { gap: 1rem; border-right: 1px solid rgba(255, 255, 255, 0.12); }
  .choice-records > div, .field-records > div { border-top: 1px solid rgba(255, 255, 255, 0.13); padding-top: 0.65rem; }
  .choice-records > div { position: relative; padding-left: 1rem; }
  .choice-records > div::before {
    content: "";
    position: absolute;
    top: 0.75rem;
    left: 0;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--alice-purple);
    box-shadow: -2px 0 var(--alice-cyan), 2px 0 var(--alice-magenta);
  }
  .field-records { grid-template-columns: 1fr 1fr; gap: 1rem 1.5rem; }
  .field-records > div:last-child { grid-column: 1 / -1; }
  .alice-record dt { color: #858d9c; font: 600 0.58rem/1 ui-monospace, SFMono-Regular, monospace; letter-spacing: 0.11em; text-transform: uppercase; }
  .alice-record dd { margin: 0.45rem 0 0; color: #c5c9d1; font-size: 0.8rem; line-height: 1.5; }
  .compact .route-group li { min-height: 9rem; }
  @media (max-width: 980px) {
    .route-diagram { grid-template-columns: 1fr; }
    .wet-gate { min-height: 4.5rem; border-block: 1px solid rgba(255, 255, 255, 0.13); border-inline: 0; }
    .wet-gate::before { inset: 20% 8%; }
    .wet-gate::after { inset: 31% 17%; }
    .wet-gate span { top: 50%; left: 8%; width: 84%; height: 1px; background: linear-gradient(90deg, transparent, var(--alice-cyan) 26%, var(--alice-magenta) 72%, transparent); }
    .alice-record { grid-template-columns: 1fr 1.25fr; }
    .alice-record header { border-bottom: 1px solid rgba(255, 255, 255, 0.12); }
    .choice-records { border-right: 0; border-bottom: 1px solid rgba(255, 255, 255, 0.12); }
    .field-records { grid-column: 1 / -1; }
  }
  @media (max-width: 680px) {
    .route-group header { align-items: flex-start; flex-direction: column; }
    .threshold-route ol, .imprint-route ol { grid-template-columns: 1fr; }
    .threshold-route li:nth-child(even) { margin-top: 0; }
    .route-group li { min-height: auto; padding-block: 0.9rem 1.15rem; }
    .alice-record { grid-template-columns: 1fr; }
    .alice-record header, .choice-records { border-right: 0; }
    .field-records { grid-column: 1; grid-template-columns: 1fr; }
    .field-records > div:last-child { grid-column: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .visitor-route *, .visitor-route *::before, .visitor-route *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
