---
import { routeTypes } from "@/data/other-alice-world-guide";
interface Props { compact?: boolean }
const { compact=false } = Astro.props;

const routeImageAlts: Record<string, string> = {
 radial: "Aerial view of Heart-controlled Wonderland with bright roads radiating from the central estate into outer regions.",
 orbital: "Aerial view of Wonderland with illuminated regional routes circling and connecting settlements without returning to the center.",
 burrow: "Cutaway view beneath Wonderland showing a discontinuous network of inhabited burrows, root passages, and portal-like shortcuts.",
};
---
<div class:list={["route-atlas",compact&&"compact"]} data-route-atlas>
 <div class="controls" role="toolbar" aria-label="Route family">
  {routeTypes.map((route,index)=><button type="button" data-route={route.id} aria-pressed={index===0?"true":"false"}>{route.label}</button>)}
 </div>

 <div class="route-panels" aria-live="polite">
  {routeTypes.map((route,index)=><article data-route-panel={route.id} hidden={index!==0} style={`--route:${route.color}`}>
   <figure>
    <img src={`https://cdn.hob.farm/pages/other-alice-adventures/routes/other-alice-adventures-routes-${route.id}.png`} alt={routeImageAlts[route.id]} width="1448" height="1086" loading="lazy" decoding="async"/>
    <figcaption>{route.label} routes shown in use</figcaption>
   </figure>
   <div class="route-copy">
    <p class="eyebrow">{route.label} route</p>
    <h3>{route.summary}</h3>
    <dl>
     <div><dt>What the shape means</dt><dd>{route.meaning}</dd></div>
     <div><dt>Effect on Wonderland</dt><dd>{route.effect}</dd></div>
     <div><dt>Where power sits</dt><dd>{route.power}</dd></div>
    </dl>
    <small>Evidence base: {route.evidence}</small>
   </div>
  </article>)}
 </div>

 <div class="diagram-row">
  <div class="diagram-copy">
   <p class="eyebrow">Route logic</p>
   <h3>The graph removes the scenery and keeps the rule.</h3>
   <p>The selected line shows what each family treats as important: a center, a circuit, or a condition that can ignore ordinary distance. The landscape plates show the same rule after people build homes, jobs, tolls, exchanges, and shortcuts around it.</p>
  </div>
  <svg viewBox="0 0 640 440" role="img" aria-labelledby="route-title route-desc">
   <title id="route-title">Radial, orbital, and burrow route logic</title><desc id="route-desc">Three route families cross one circular diagram. Buttons select the highlighted family and its corresponding landscape plate.</desc>
   <circle class="terrain" cx="320" cy="220" r="185"/><circle class="terrain inner" cx="320" cy="220" r="65"/>
   <g data-family="radial" class="family active"><path d="M320 220 L320 36 M320 220 L490 145 M320 220 L470 330 M320 220 L145 295 M320 220 L160 115"/></g>
   <g data-family="orbital" class="family"><path d="M150 220a170 120 0 1 0 340 0a170 120 0 1 0-340 0M205 220a115 78 0 1 0 230 0a115 78 0 1 0-230 0"/></g>
   <g data-family="burrow" class="family"><path d="M95 360 C210 300 170 125 320 160 S470 360 560 70"/><circle cx="95" cy="360" r="8"/><circle cx="560" cy="70" r="8"/></g>
  </svg>
 </div>
</div>
<script>
 const valid = ["radial","orbital","burrow"];
 document.querySelectorAll<HTMLElement>("[data-route-atlas]").forEach((root)=>{
  const buttons=[...root.querySelectorAll<HTMLButtonElement>("[data-route]")];
  const select=(id:string,write=true)=>{ if(!valid.includes(id)) id="radial"; buttons.forEach((b)=>b.setAttribute("aria-pressed",String(b.dataset.route===id))); root.querySelectorAll<SVGGElement>("[data-family]").forEach((g)=>g.classList.toggle("active",g.dataset.family===id)); root.querySelectorAll<HTMLElement>("[data-route-panel]").forEach((panel)=>panel.hidden=panel.dataset.routePanel!==id); if(write){const u=new URL(location.href);u.searchParams.set("route",id);history.replaceState({},"",u);} };
  buttons.forEach((b,i)=>{b.addEventListener("click",()=>select(b.dataset.route||"radial"));b.addEventListener("keydown",(e)=>{if(e.key!=="ArrowRight"&&e.key!=="ArrowLeft")return;e.preventDefault();const d=e.key==="ArrowRight"?1:-1;const n=(i+d+buttons.length)%buttons.length;buttons[n].focus();select(buttons[n].dataset.route||"radial");});});
  select(new URL(location.href).searchParams.get("route")||"radial",false);
 });
</script>
<style>
 .route-atlas{overflow:hidden;border:1px solid rgba(255,255,255,.14);border-radius:1rem;background:linear-gradient(145deg,#101522,#080b13)}.controls{display:flex;gap:.5rem;flex-wrap:wrap;padding:1rem;border-bottom:1px solid rgba(255,255,255,.12)}.controls button{border:1px solid #3d4352;border-radius:999px;background:transparent;padding:.55rem .8rem;color:#cdd0da;font:600 .72rem/1 ui-monospace,monospace;text-transform:uppercase}.controls button[aria-pressed="true"]{border-color:#9f7aea;background:#9f7aea;color:#090a10}.controls button:focus-visible{outline:2px solid white;outline-offset:3px}
 .route-panels article{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(19rem,.85fr)}.route-panels article[hidden]{display:none}.route-panels figure{position:relative;margin:0;background:#071017}.route-panels img{display:block;width:100%;height:100%;min-height:34rem;object-fit:cover}.route-panels figcaption{position:absolute;inset:auto 1rem 1rem;padding:.5rem .65rem;background:rgba(5,8,14,.82);color:#fff;font:600 .62rem/1 ui-monospace,monospace;letter-spacing:.1em;text-transform:uppercase}.route-copy{display:flex;flex-direction:column;padding:clamp(1.4rem,4vw,3rem);border-left:3px solid var(--route)}.eyebrow{margin:0;color:var(--route,#a88cff);font:600 .68rem/1 ui-monospace,monospace;text-transform:uppercase;letter-spacing:.14em}.route-copy h3,.diagram-copy h3{margin:1rem 0 0;color:#f0eadc;font:400 clamp(1.35rem,2.4vw,2.3rem)/1.12 Georgia,serif}.route-copy dl{display:grid;gap:1.2rem;margin:2rem 0}.route-copy dl div{padding-top:1rem;border-top:1px solid rgba(255,255,255,.12)}dt{color:#fff;font:600 .66rem/1 ui-monospace,monospace;text-transform:uppercase;letter-spacing:.1em}dd{margin:.55rem 0 0;color:#aeb4c0;font-size:.9rem;line-height:1.65}.route-copy small{margin-top:auto;color:#858c9c}
 .diagram-row{display:grid;grid-template-columns:minmax(17rem,.65fr) minmax(0,1.35fr);gap:1rem;align-items:center;padding:clamp(1.25rem,3vw,2.5rem);border-top:1px solid rgba(255,255,255,.12);background:#090d16}.diagram-copy p:last-child{margin:1rem 0 0;color:#9ea5b3;font-size:.92rem;line-height:1.65}.diagram-row svg{width:100%;height:auto;max-height:30rem}.terrain{fill:#162b28;stroke:#648a83;stroke-width:2}.terrain.inner{fill:#4a1925;stroke:#ef476f}.family{opacity:.12;fill:none;stroke:#697282;stroke-width:5;stroke-linecap:round;transition:opacity .2s,stroke .2s}.family.active{opacity:1}.family[data-family="radial"].active{stroke:#ef476f}.family[data-family="orbital"].active{stroke:#f7c948}.family[data-family="burrow"].active{stroke:#9f7aea;stroke-dasharray:10 9}.family circle{fill:#9f7aea;stroke:none}.compact .route-panels img{min-height:30rem}
 @media(max-width:880px){.route-panels article,.diagram-row{grid-template-columns:1fr}.route-panels img{height:auto;min-height:0;aspect-ratio:4/3}.route-copy{border-top:3px solid var(--route);border-left:0}.diagram-row svg{max-height:22rem}}
 @media(max-width:560px){.controls{overflow-x:auto;flex-wrap:nowrap}.route-copy{padding:1.25rem}.diagram-row{padding:1.25rem}.compact .route-panels img{min-height:0}}
 @media(prefers-reduced-motion:reduce){.family{transition:none}}
</style>
