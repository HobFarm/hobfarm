---
import { regions } from "@/data/other-alice-world-guide";
import { getMedia } from "@/data/media-registry";
const atlas = getMedia("other-alice.wonderland.world-map");
interface Props { compact?: boolean }
const { compact=false } = Astro.props;
---
<figure class:list={["living-atlas",compact&&"compact"]}>
  <div class="plate">
    <img src={atlas.src} width="1448" height="1086" sizes="(max-width: 700px) calc(100vw - 2rem), (max-width: 1440px) calc(100vw - 8rem), 1312px" alt={atlas.alt} loading={compact?"lazy":"eager"} fetchpriority={compact?"auto":"high"} />
  </div>
  {!compact && <figcaption>
    <strong>The atlas is a working public record.</strong> Its labels describe position and use; House power overlaps the terrain instead of replacing it.
  </figcaption>}
</figure>
<details class="atlas-fallback">
  <summary>Read the atlas as text</summary>
  <ol>{regions.map((region)=><li><strong>{region.title}:</strong> {region.summary}</li>)}</ol>
</details>
<style>
 .living-atlas{margin:0}.plate{position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.14);border-radius:1.2rem;background:#d6c29c;box-shadow:0 28px 90px rgba(0,0,0,.42)}
 img{display:block;width:100%;height:auto}
 figcaption{max-width:52rem;margin:.8rem 0 0;color:#adb2c0;font-size:.86rem;line-height:1.6}.atlas-fallback{margin-top:.8rem;border-left:2px solid #8c6dff;padding:.45rem .8rem;color:#c8cad2;font-size:.88rem}.atlas-fallback summary{cursor:pointer;color:white}.atlas-fallback ol{display:grid;gap:.55rem;padding-left:1.2rem}
 @media(max-width:700px){.compact .plate{border-radius:.75rem}}
</style>
