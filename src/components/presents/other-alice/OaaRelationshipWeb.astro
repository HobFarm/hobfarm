---
import {
  OTHER_ALICE_WEB_PATH,
  relationshipEdges,
  relationshipLegend,
  relationshipNodes,
} from "@/data/other-alice-world-guide";

interface Props {
  compact?: boolean;
  heading?: string;
  intro?: string;
}

const {
  compact = false,
  heading = "Web of Wonderland",
  intro = "The realm runs on recognition, labor, water, transport, appetite, trust, and disputed testimony. Every line needs a record behind it.",
} = Astro.props;
const instanceId = compact ? "oaa-relationship-preview" : "oaa-relationship-full";
const edgeColors = new Map(relationshipLegend.map((entry) => [entry.type, entry.color]));
const connectedEdges = relationshipEdges.map((edge) => ({
  ...edge,
  sourceNode: relationshipNodes.find((node) => node.id === edge.source)!,
  targetNode: relationshipNodes.find((node) => node.id === edge.target)!,
  color: edgeColors.get(edge.type) ?? "#f5f0df",
  layer:
    edge.status === "disputed"
      ? "disputed"
      : ["authority", "recognition", "debt"].includes(edge.type)
        ? "political"
        : ["labor", "maintenance", "water", "transport", "route"].includes(edge.type)
          ? "material"
          : "personal",
}));
---

<section id={instanceId} class:list={["relationship-web", compact && "relationship-web--compact"]} aria-labelledby={`${instanceId}-heading`}>
  <header class="relationship-web__header">
    <div>
      <p>Connection record / evidence required</p>
      <h2 id={`${instanceId}-heading`}>{heading}</h2>
    </div>
    <p>{intro}</p>
  </header>

  {!compact && (
    <div class="relationship-web__filters" role="group" aria-label="Filter relationships">
      {[
        ["all", "All connections"],
        ["political", "Political"],
        ["material", "Material"],
        ["personal", "Personal"],
        ["disputed", "Disputed"],
      ].map(([value, label], index) => (
        <button type="button" data-web-filter={value} aria-pressed={index === 0 ? "true" : "false"}>{label}</button>
      ))}
    </div>
  )}

  <div class="relationship-web__legend" aria-label="Relationship legend">
    {relationshipLegend.map((entry) => (
      <span style={`--legend-color:${entry.color}`}><i aria-hidden="true"></i>{entry.label}</span>
    ))}
  </div>

  <div class="relationship-web__plate">
    <svg viewBox="0 0 1200 760" role="img" aria-labelledby={`${instanceId}-svg-title ${instanceId}-svg-description`}>
      <title id={`${instanceId}-svg-title`}>Other Alice character, House, and institution relationships</title>
      <desc id={`${instanceId}-svg-description`}>
        A faction and relationship diagram centered on Alice. The Queen and Heart recognition sit to the left,
        Diamond circulation to the upper right, Spade continuity and Ciryl to the lower right, Clubs to the lower left,
        and Chester below Alice. A full text connection list follows the diagram.
      </desc>
      <defs>
        {relationshipNodes.filter((node) => node.image).map((node) => (
          <clipPath id={`${instanceId}-${node.id}-clip`}>
            <circle cx="0" cy="-14" r={node.kind === "person" ? 48 : 42} />
          </clipPath>
        ))}
      </defs>

      <g class="relationship-web__house-labels" aria-hidden="true">
        <text x="72" y="52">HEART RECORDS</text>
        <text x="935" y="52">DIAMOND SYSTEMS</text>
        <text x="938" y="735">SPADE SYSTEMS</text>
        <text x="72" y="735">CLUB ROUTES</text>
      </g>

      <g class="relationship-web__edges">
        {connectedEdges.map((edge) => (
          <g data-web-edge data-layer={edge.layer} data-status={edge.status} style={`--edge-color:${edge.color}`}>
            <title>{edge.sourceNode.label} — {edge.label} — {edge.targetNode.label}. Evidence: {edge.evidenceLabel}.</title>
            <line x1={edge.sourceNode.x} y1={edge.sourceNode.y} x2={edge.targetNode.x} y2={edge.targetNode.y} />
            <circle cx={(edge.sourceNode.x + edge.targetNode.x) / 2} cy={(edge.sourceNode.y + edge.targetNode.y) / 2} r="5" />
          </g>
        ))}
      </g>

      <g class="relationship-web__nodes">
        {relationshipNodes.map((node) => (
          <a href={node.href} aria-label={`Open ${node.label}`}>
            <g class={`relationship-node relationship-node--${node.group}`} transform={`translate(${node.x} ${node.y})`}>
              <circle class="relationship-node__frame" cy="-14" r={node.kind === "person" ? 58 : 52} />
              {node.image ? (
                <image
                  href={node.image}
                  x={-48}
                  y={-62}
                  width="96"
                  height="96"
                  preserveAspectRatio="xMidYMid slice"
                  clip-path={`url(#${instanceId}-${node.id}-clip)`}
                />
              ) : (
                <text class="relationship-node__stamp" y="-4" text-anchor="middle">{node.label.split(" ")[0]}</text>
              )}
              <rect class="relationship-node__label-bg" x="-88" y="49" width="176" height="41" />
              <text class="relationship-node__label" y="66" text-anchor="middle">{node.label}</text>
              <text class="relationship-node__kind" y="82" text-anchor="middle">{node.kind}</text>
            </g>
          </a>
        ))}
      </g>
    </svg>
  </div>

  <ol class="relationship-web__records" aria-label="Connection records">
    {connectedEdges.map((edge) => (
      <li data-web-record data-layer={edge.layer} data-status={edge.status} style={`--edge-color:${edge.color}`}>
        <span aria-hidden="true"></span>
        <div>
          <strong><a href={edge.sourceNode.href}>{edge.sourceNode.label}</a> → <a href={edge.targetNode.href}>{edge.targetNode.label}</a></strong>
          <p>{edge.label}. <b>{edge.type}</b> / {edge.status}.</p>
          <a href={edge.evidenceHref}>Evidence: {edge.evidenceLabel}</a>
        </div>
      </li>
    ))}
  </ol>

  {compact && <a class="relationship-web__open" href={OTHER_ALICE_WEB_PATH}>Open the full relationship record &rarr;</a>}
</section>

{!compact && (
  <script>
    const web = document.querySelector<HTMLElement>("#oaa-relationship-full");
    const buttons = Array.from(web?.querySelectorAll<HTMLButtonElement>("[data-web-filter]") ?? []);
    const edges = Array.from(web?.querySelectorAll<SVGGElement>("[data-web-edge]") ?? []);
    const records = Array.from(web?.querySelectorAll<HTMLElement>("[data-web-record]") ?? []);

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.webFilter ?? "all";
        buttons.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button)));
        edges.forEach((edge) => {
          const visible = filter === "all" || edge.dataset.layer === filter || edge.dataset.status === filter;
          edge.style.display = visible ? "" : "none";
        });
        records.forEach((record) => {
          record.hidden = filter !== "all" && record.dataset.layer !== filter && record.dataset.status !== filter;
        });
      });
    });
  </script>
)}

<style>
  .relationship-web {
    border-block: 1px solid #41384d;
    background: #09080d;
  }

  .relationship-web__header {
    display: grid;
    gap: 1.2rem;
    padding: clamp(1.4rem, 4vw, 2.6rem);
    border-bottom: 1px solid #41384d;
  }

  .relationship-web__header > div > p {
    margin: 0;
    color: #d4b861;
    font-family: var(--font-mono);
    font-size: 0.61rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .relationship-web__header h2 {
    margin: 0.55rem 0 0;
    color: #f5f0df;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4.8rem);
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .relationship-web__header > p {
    max-width: 46rem;
    margin: 0;
    color: #aaa4b2;
    line-height: 1.7;
  }

  .relationship-web__filters,
  .relationship-web__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0.85rem clamp(1rem, 4vw, 2.6rem);
    border-bottom: 1px solid #28232f;
  }

  .relationship-web__filters button {
    padding: 0.65rem 0.78rem;
    border: 1px solid #41384d;
    background: #121017;
    color: #aaa4b2;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .relationship-web__filters button:hover,
  .relationship-web__filters button:focus-visible,
  .relationship-web__filters button[aria-pressed="true"] {
    border-color: #f5f0df;
    color: #fff;
  }

  .relationship-web__legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #aaa4b2;
    font-family: var(--font-mono);
    font-size: 0.57rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .relationship-web__legend i,
  .relationship-web__records > li > span {
    width: 1.8rem;
    height: 0.18rem;
    background: var(--legend-color, var(--edge-color));
  }

  .relationship-web__plate {
    display: none;
    padding: clamp(1rem, 3vw, 2rem);
    background: #060508;
  }

  .relationship-web__plate svg {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #28232f;
    background: #0c0910;
  }

  .relationship-web__house-labels text {
    fill: #625a6b;
    font-family: var(--font-mono);
    font-size: 18px;
    letter-spacing: 3px;
  }

  .relationship-web__edges line {
    stroke: var(--edge-color);
    stroke-width: 4;
    opacity: 0.72;
  }

  .relationship-web__edges circle {
    fill: var(--edge-color);
  }

  .relationship-web__edges [data-status="disputed"] line {
    stroke-dasharray: 12 12;
  }

  .relationship-web__nodes a:focus-visible .relationship-node__frame {
    stroke: #fff;
    stroke-width: 7;
  }

  .relationship-node__frame {
    fill: #0b0910;
    stroke: #b66be3;
    stroke-width: 5;
  }

  .relationship-node--hearts .relationship-node__frame { stroke: #e23a4e; }
  .relationship-node--diamonds .relationship-node__frame { stroke: #e3c82f; }
  .relationship-node--spades .relationship-node__frame { stroke: #2fe089; }
  .relationship-node--clubs .relationship-node__frame { stroke: #43aee8; }
  .relationship-node__label-bg { fill: #09080d; stroke: #41384d; stroke-width: 2; }
  .relationship-node__label { fill: #f5f0df; font-family: var(--font-display); font-size: 18px; font-weight: 700; }
  .relationship-node__kind { fill: #aaa4b2; font-family: var(--font-mono); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; }
  .relationship-node__stamp { fill: #f5f0df; font-family: var(--font-display); font-size: 16px; font-weight: 700; }

  .relationship-web__records {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    background: #28232f;
    list-style: none;
  }

  .relationship-web__records li {
    display: grid;
    grid-template-columns: 2.1rem minmax(0, 1fr);
    gap: 0.7rem;
    align-items: start;
    padding: 1rem;
    background: #0c0910;
  }

  .relationship-web__records > li > span {
    margin-top: 0.6rem;
  }

  .relationship-web__records strong,
  .relationship-web__records strong a {
    color: #f5f0df;
    font-family: var(--font-display);
    text-decoration: none;
  }

  .relationship-web__records p {
    margin: 0.35rem 0 0;
    color: #aaa4b2;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .relationship-web__records p b {
    color: #d4b861;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 400;
    text-transform: uppercase;
  }

  .relationship-web__records div > a {
    display: inline-flex;
    margin-top: 0.45rem;
    color: #8fd8ef;
    font-family: var(--font-mono);
    font-size: 0.59rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .relationship-web__open {
    display: inline-flex;
    margin: 1.2rem;
    color: #d4b861;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  [data-web-edge][hidden],
  [data-web-record][hidden] {
    display: none;
  }

  @media (min-width: 760px) {
    .relationship-web__header {
      grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 1.1fr);
      align-items: end;
    }

    .relationship-web__plate {
      display: block;
    }

    .relationship-web__records {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .relationship-web__records {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .relationship-web--compact .relationship-web__records li:nth-child(n + 7) {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .relationship-web *,
    .relationship-web *::before,
    .relationship-web *::after {
      scroll-behavior: auto !important;
      transition-duration: 0s !important;
    }
  }
</style>
