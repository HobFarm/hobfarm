---
import { relationshipEdges, relationshipLegend, relationshipNodes } from "@/data/other-alice-world-guide";
interface Props { heading?:string; intro?:string; compact?:boolean }
const { heading="The systems between people and places", intro="Filter the diagram by connection type. The ordered ledger carries the same evidence in text.", compact=false }=Astro.props;
const node=(id:string)=>relationshipNodes.find((item)=>item.id===id)!;
---
<section class:list={["relationship-web",compact&&"compact"]} data-relationship-web>
 <header><p class="eyebrow">Evidence-backed connections</p><h2>{heading}</h2><p>{intro}</p></header>
 <div class="filters" role="toolbar" aria-label="Connection types">
  <button type="button" data-relation="all" aria-pressed="true">All</button>
  {relationshipLegend.map((item)=><button type="button" data-relation={item.id} aria-pressed="false">{item.label}</button>)}
 </div>
 <div class="web-layout">
  <svg viewBox="0 0 100 100" role="img" aria-labelledby="web-title web-desc">
   <title id="web-title">Web of Wonderland relationships</title><desc id="web-desc">People, Houses, regions, routes, institutions, artifacts, organisms, historical claims, and visitor imprints connected by evidence-backed lines.</desc>
   <g class="edges">{relationshipEdges.map((edge)=><line data-edge-kind={edge.kind} x1={node(edge.source).x} y1={node(edge.source).y} x2={node(edge.target).x} y2={node(edge.target).y}><title>{node(edge.source).label} {edge.label} {node(edge.target).label}. Evidence: {edge.evidence}.</title></line>)}</g>
   <g class="nodes">{relationshipNodes.map((item)=><a href={`#node-${item.id}`} data-node-kind={item.kind} aria-label={`${item.label}, ${item.kind}: ${item.summary}`}><circle cx={item.x} cy={item.y} r={item.kind==="House"?3.8:2.7}/><text x={item.x} y={item.y+6} text-anchor="middle">{item.label}</text></a>)}</g>
  </svg>
  <aside><p class="eyebrow">Node index</p><ul>{relationshipNodes.map((item)=><li id={`node-${item.id}`}><span>{item.kind}</span><strong>{item.label}</strong><small>{item.summary}</small></li>)}</ul></aside>
 </div>
 <details open><summary>Connection ledger</summary><ol>{relationshipEdges.map((edge)=><li id={`connection-${edge.id}`} data-ledger-kind={edge.kind}><p><strong>{node(edge.source).label}</strong> <span>{edge.label}</span> <strong>{node(edge.target).label}</strong></p><small>{edge.kind} · {edge.certainty} · Evidence: {edge.evidence}</small></li>)}</ol></details>
</section>
<script>
 const valid=["all","body","knowledge","material","authority","ecology","echo"];
 document.querySelectorAll<HTMLElement>("[data-relationship-web]").forEach((root)=>{
  const buttons=[...root.querySelectorAll<HTMLButtonElement>("[data-relation]")];
  const apply=(kind:string,write=true)=>{if(!valid.includes(kind))kind="all";buttons.forEach((b)=>b.setAttribute("aria-pressed",String(b.dataset.relation===kind)));root.querySelectorAll<SVGLineElement>("[data-edge-kind]").forEach((line)=>line.classList.toggle("dim",kind!=="all"&&line.dataset.edgeKind!==kind));root.querySelectorAll<HTMLElement>("[data-ledger-kind]").forEach((item)=>item.hidden=kind!=="all"&&item.dataset.ledgerKind!==kind);if(write){const url=new URL(location.href);if(kind==="all")url.searchParams.delete("relation");else url.searchParams.set("relation",kind);history.replaceState({},"",url);}};
  buttons.forEach((button,index)=>{button.addEventListener("click",()=>apply(button.dataset.relation||"all"));button.addEventListener("keydown",(event)=>{if(event.key!=="ArrowRight"&&event.key!=="ArrowLeft")return;event.preventDefault();const next=(index+(event.key==="ArrowRight"?1:-1)+buttons.length)%buttons.length;buttons[next].focus();apply(buttons[next].dataset.relation||"all");});});apply(new URL(location.href).searchParams.get("relation")||"all",false);
 });
</script>
<style>
 .relationship-web{margin-top:2rem}.relationship-web header{max-width:55rem}.eyebrow{color:#9f7aea;font:600 .66rem/1 ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase}.relationship-web h2{margin:.6rem 0;color:#fff;font:400 clamp(2rem,5vw,4.5rem)/1 Georgia,serif}.relationship-web header>p:last-child{color:#afb4c0;line-height:1.65}.filters{display:flex;gap:.4rem;overflow-x:auto;margin:1.5rem 0;padding:.2rem}.filters button{border:1px solid #4b5261;border-radius:999px;background:transparent;padding:.55rem .75rem;color:#c9ccd4;font:600 .69rem/1 ui-monospace,monospace;text-transform:uppercase}.filters button[aria-pressed="true"]{background:#eee7d6;color:#090b11}.filters button:focus-visible{outline:2px solid #9f7aea;outline-offset:2px}.web-layout{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(15rem,.4fr);gap:1rem}.web-layout svg{width:100%;height:auto;border:1px solid rgba(255,255,255,.13);background:radial-gradient(circle,#15231f,#090c13 65%)}.edges line{stroke:#9f7aea;stroke-width:.65;opacity:.75;transition:opacity .2s}.edges line.dim{opacity:.05}.nodes circle{fill:#eee7d6;stroke:#090b11;stroke-width:.6}.nodes [data-node-kind="House"] circle{fill:#ef476f}.nodes text{fill:#fff;paint-order:stroke;stroke:#090b11;stroke-width:1;font:600 2.1px/1 ui-monospace,monospace}.nodes a:focus circle{stroke:#fff;stroke-width:1.4}.web-layout aside{max-height:38rem;overflow:auto;border:1px solid rgba(255,255,255,.13);padding:1rem}.web-layout ul{margin:1rem 0 0;padding:0;list-style:none}.web-layout li{display:grid;padding:.65rem 0;border-top:1px solid rgba(255,255,255,.1)}.web-layout li span{color:#7f8797;font:600 .6rem/1 ui-monospace,monospace;text-transform:uppercase}.web-layout li strong{margin-top:.3rem;color:#fff}.web-layout li small{margin-top:.25rem;color:#aeb3bf}details{margin-top:1rem;border:1px solid rgba(255,255,255,.13);padding:1rem}summary{cursor:pointer;color:#fff;font-weight:700}details ol{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;margin:1rem 0 0;padding:0;list-style:none}details li{padding:.8rem;background:#0e121c}details p{margin:0;color:#c6c9d1}details p span{color:#9f7aea}details small{display:block;margin-top:.35rem;color:#858c9a}.compact .web-layout aside,.compact details{display:none}
 @media(max-width:750px){.web-layout{grid-template-columns:1fr}.web-layout aside{max-height:none}details ol{grid-template-columns:1fr}}
 @media(prefers-reduced-motion:reduce){.edges line{transition:none}}
</style>
