---
import type { CharacterVisualDevelopment } from "@/data/characters";

interface Props {
  record: CharacterVisualDevelopment;
}

const { record } = Astro.props;
---

<section class="visual-development" aria-labelledby="alice-appearance-title">
  <header>
    <p>{record.label}</p>
    <div>
      <h2 id="alice-appearance-title">{record.title}</h2>
      <div class="intro-copy">
        {record.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <aside>{record.note}</aside>
    </div>
  </header>

  <div class="trait-grid">
    {record.plates.map((plate, index) => (
      <figure class:list={["trait-card", index === 0 && "trait-card--lead"]}>
        <img
          src={plate.src}
          alt={plate.alt}
          width={plate.width}
          height={plate.height}
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <strong>{plate.label}</strong>
          <span>{plate.note}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .visual-development {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
  }
  header {
    display: grid;
    grid-template-columns: minmax(10rem, 0.32fr) minmax(0, 1fr);
    gap: 1rem 2rem;
    margin-bottom: 1.5rem;
  }
  header > p {
    margin: 0;
    color: #a88cff;
    font: 600 0.64rem/1.4 ui-monospace, SFMono-Regular, monospace;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  h2 {
    max-width: 52rem;
    margin: 0;
    color: #eee7d6;
    font: 400 clamp(2rem, 5vw, 3.8rem)/0.98 Georgia, serif;
    text-wrap: balance;
  }
  .intro-copy {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem 1.5rem;
    max-width: 58rem;
    margin-top: 1.5rem;
  }
  .intro-copy p {
    margin: 0;
    color: #b4b9c4;
    font-size: 0.94rem;
    line-height: 1.7;
  }
  .intro-copy p:first-child { grid-column: 1 / -1; color: #ddd7ca; }
  aside {
    max-width: 58rem;
    margin-top: 1.25rem;
    padding: 0.9rem 1rem;
    border-left: 2px solid #a88cff;
    background: rgba(168, 140, 255, 0.06);
    color: #9fa4b0;
    font-size: 0.82rem;
    line-height: 1.6;
  }
  .trait-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 0.85rem;
  }
  .trait-card {
    grid-column: span 3;
    overflow: hidden;
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 0.45rem;
    background: rgba(12, 15, 24, 0.92);
  }
  .trait-card--lead { grid-column: span 6; grid-row: span 2; }
  img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
  figcaption { padding: 0.85rem 0.9rem 0.95rem; }
  figcaption strong {
    display: block;
    color: #eee7d6;
    font: 400 1.05rem/1.1 Georgia, serif;
  }
  figcaption span {
    display: block;
    margin-top: 0.45rem;
    color: #9298a5;
    font-size: 0.75rem;
    line-height: 1.55;
  }
  @media (max-width: 900px) {
    .trait-card, .trait-card--lead { grid-column: span 6; grid-row: auto; }
  }
  @media (max-width: 680px) {
    header, .intro-copy { grid-template-columns: 1fr; }
    .intro-copy p:first-child { grid-column: auto; }
  }
  @media (max-width: 520px) {
    .trait-card, .trait-card--lead { grid-column: 1 / -1; }
  }
</style>
