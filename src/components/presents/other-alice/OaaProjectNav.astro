---
import { otherAliceProjectNav } from "@/data/other-alice-world-guide";
type Current = (typeof otherAliceProjectNav)[number]["id"];
interface Props { current?: Current }
const { current = "world-guide" } = Astro.props;
---
<nav aria-label="Other Alice" class="oaa-project-nav">
  <ul>
    {otherAliceProjectNav.map((item) => (
      <li><a href={item.href} aria-current={item.id === current ? "page" : undefined}>{item.label}</a></li>
    ))}
  </ul>
</nav>
<style>
  .oaa-project-nav{position:sticky;top:0;z-index:20;margin-inline:auto;max-width:90rem;border-block:1px solid rgba(255,255,255,.12);background:rgba(7,9,16,.9);backdrop-filter:blur(14px)}
  ul{display:flex;gap:.25rem;overflow-x:auto;margin:0;padding:.55rem clamp(1rem,3vw,3rem);list-style:none;scrollbar-width:thin}
  a{display:block;white-space:nowrap;border:1px solid transparent;border-radius:999px;padding:.55rem .8rem;color:#b9bdc9;font:600 .72rem/1 ui-monospace,SFMono-Regular,monospace;letter-spacing:.08em;text-transform:uppercase;text-decoration:none}
  a:hover,a:focus-visible{color:white;border-color:#8c6dff;outline:none}
  a[aria-current="page"]{background:#eee7d6;color:#11131d}
</style>
