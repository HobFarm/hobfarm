---
const stages = [
  { title: "Architecture", note: "The interface limits which actions are easy." },
  { title: "Measurement", note: "Clicks, watch time, shares, surveys, and reactions become signals." },
  { title: "Classification", note: "People and work are grouped into predicted interests." },
  { title: "Rewards", note: "Some patterns receive more distribution, attention, or money." },
  { title: "Imitation", note: "Creators repeat what appears to work." },
  { title: "Saturation", note: "The feed fills with variations of the rewarded pattern." },
];
---

<section class="funnel" aria-labelledby="funnel-heading">
  <p class="funnel__eyebrow">The funnel-bucket cycle</p><h2 id="funnel-heading">How an interface becomes creative management</h2>
  <ol>
    {stages.map((stage, index) => <li><span>{index + 1}</span><div><strong>{stage.title}</strong><p>{stage.note}</p></div></li>)}
  </ol>
  <p class="funnel__loop">The saturated pattern re-enters the architecture as evidence of what the audience wants.</p>
</section>

<style>
  .funnel{margin:2.8rem 0;padding:clamp(1.2rem,4vw,2rem);border:1px solid #5a4632;background:#07101b}.funnel__eyebrow{margin:0;color:#e6762d!important;font-family:var(--font-mono);font-size:.65rem;letter-spacing:.14em;text-transform:uppercase}.funnel h2{margin:.5rem 0 0!important}.funnel ol{display:grid;gap:.65rem;margin:1.5rem 0 0!important;padding:0!important;list-style:none!important}.funnel li{display:grid;grid-template-columns:2.25rem minmax(0,1fr);gap:.8rem;padding:.85rem;border:1px solid #293744;background:#0a1521}.funnel li>span{display:grid;width:2rem;height:2rem;place-items:center;border:1px solid #e6762d;border-radius:50%;color:#f5e6c8;font-family:var(--font-mono);font-size:.65rem}.funnel strong{color:#f5e6c8}.funnel li p{margin:.25rem 0 0!important;color:#a99f90!important;font-size:.76rem;line-height:1.5}.funnel__loop{margin:1rem 0 0!important;padding:.85rem;border-left:3px solid #e6762d;color:#d8cab1!important;font-size:.82rem;font-style:italic}
  @media(min-width:760px){.funnel ol{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style>
