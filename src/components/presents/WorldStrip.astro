---
import Text from "@/components/fundations/elements/Text.astro";

interface Props {
  worldStrip: {
    title: string;
    paragraphs: string[];
    details?: {
      label: string;
      value: string;
    }[];
    image?: string;
    imageAlt?: string;
  }[];
}

const { worldStrip } = Astro.props;
---

{worldStrip.length > 0 && (
  <div class="mt-16 border-t border-base-800 pt-10">
    <Text tag="h2" variant="displaySM" class="mb-6 font-display text-white">
      World rules and portal logic
    </Text>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      {worldStrip.map((world) => (
        <div class="overflow-hidden rounded-lg border border-base-800 bg-base-900/50">
          {world.image && (
            <img
              src={world.image}
              alt={world.imageAlt ?? world.title}
              class="aspect-[3/4] w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          )}
          <div class="p-5">
            <h3 class="font-display text-base text-white">{world.title}</h3>
            <div class="mt-3 space-y-3">
              {world.paragraphs.map((paragraph) => (
                <p class="text-sm leading-relaxed text-base-400">{paragraph}</p>
              ))}
            </div>
            {(world.details?.length ?? 0) > 0 && (
              <dl class="mt-5 space-y-4 border-t border-base-800 pt-4">
                {world.details!.map((detail) => (
                  <div>
                    <dt class="font-mono text-[10px] uppercase tracking-widest text-accent-500">
                      {detail.label}
                    </dt>
                    <dd class="mt-1 text-xs leading-relaxed text-base-400">{detail.value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
)}
