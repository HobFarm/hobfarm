---
import type { Article } from "@/lib/articles";
import { articlePath, getArticleDate, getArticleDescription, getArticleHero } from "@/lib/articles";
import { THREE_DM_LOGO } from "@/data/presents-titles";

interface Props { entry: Article; featured?: boolean; }
const { entry, featured = false } = Astro.props;
const href = articlePath(entry);
const image = getArticleHero(entry.data) ?? THREE_DM_LOGO;
const entryType = (entry.data.entryType ?? "article").replaceAll("-", " ");
const date = getArticleDate(entry);
---

<article class:list={["route-card", featured && "route-card--featured"]}>
  <a href={href}>
    <div class="route-card__media">
      <img src={image} alt={entry.data.heroAlt ?? entry.data.title} width="900" height="900" loading={featured ? "eager" : "lazy"} decoding="async" />
      {entry.data.video && <span class="route-card__play" aria-hidden="true">Play</span>}
    </div>
    <div class="route-card__copy">
      <div class="route-card__meta">
        <span>{entryType}</span>
        {entry.data.video?.duration && <span>{entry.data.video.duration.replace("PT", "").toLowerCase()}</span>}
        {entry.data.connection?.degreeCount != null && <span>{entry.data.connection.degreeCount} degrees</span>}
      </div>
      <h3>{entry.data.title}</h3>
      <p>{getArticleDescription(entry.data)}</p>
      <time datetime={date.toISOString()}>{date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}</time>
    </div>
  </a>
</article>

<style>
  .route-card { overflow: hidden; border: 1px solid #463a2c; background: #09121d; }
  .route-card > a { display: grid; height: 100%; color: inherit; text-decoration: none; }
  .route-card__media { position: relative; display: grid; min-height: 15rem; place-items: center; overflow: hidden; border-bottom: 1px solid #463a2c; background: #03070c; }
  .route-card__media img { width: 100%; height: 15rem; padding: 0.8rem; object-fit: contain; transition: transform 300ms ease; }
  .route-card__play { position: absolute; right: 0.8rem; bottom: 0.8rem; padding: 0.45rem 0.6rem; border: 1px solid #e6762d; background: #07101b; color: #f5e6c8; font-family: var(--font-mono); font-size: 0.6rem; text-transform: uppercase; }
  .route-card__copy { padding: 1.2rem; }
  .route-card__meta { display: flex; flex-wrap: wrap; gap: 0.45rem 0.8rem; color: #d59654; font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.09em; text-transform: uppercase; }
  .route-card h3 { margin: 0.65rem 0 0; color: #f5e6c8; font-family: var(--font-display); font-size: 1.45rem; letter-spacing: -0.035em; line-height: 1.05; }
  .route-card p { margin: 0.8rem 0 0; color: #b9ae9c; font-size: 0.84rem; line-height: 1.6; }
  .route-card time { display: block; margin-top: 1rem; color: #756d62; font-family: var(--font-mono); font-size: 0.62rem; text-transform: uppercase; }
  .route-card a:hover img { transform: scale(1.025); }
  .route-card a:focus-visible { outline: 2px solid #e6762d; outline-offset: -3px; }
  @media (min-width: 900px) { .route-card--featured > a { grid-template-columns: minmax(18rem, 0.85fr) minmax(0, 1.15fr); } .route-card--featured .route-card__media { border-right: 1px solid #463a2c; border-bottom: 0; } .route-card--featured .route-card__media img { height: 22rem; } .route-card--featured .route-card__copy { display: flex; flex-direction: column; justify-content: center; padding: 2rem; } .route-card--featured h3 { font-size: clamp(2rem, 4vw, 3.5rem); } }
  @media (prefers-reduced-motion: reduce) { .route-card__media img { transition: none; } .route-card a:hover img { transform: none; } }
</style>
