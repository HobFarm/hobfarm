---
import type { PresentsTitle } from "@/data/presents-titles";

interface Props {
  title: PresentsTitle;
}

const { title } = Astro.props;
---

<article class:list={["title-card", `title-card--${title.theme}`]}>
  <a href={title.href} class="title-card__link" aria-label={`Enter ${title.title}`}>
    <div class="title-card__media">
      <img
        src={title.image}
        alt={title.imageAlt}
        width="900"
        height="900"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="title-card__copy">
      <p>{title.typeLabel}</p>
      <h3>{title.title}</h3>
      <span>{title.description}</span>
      <strong>Enter the title &rarr;</strong>
    </div>
  </a>
</article>

<style>
  .title-card {
    --title-accent: #f0c96b;
    overflow: hidden;
    border: 1px solid #2c2440;
    background: #0e0b16;
  }
  .title-card--3dm { --title-accent: #e6762d; background: #0a111b; }
  .title-card__link { display: grid; height: 100%; color: inherit; text-decoration: none; }
  .title-card__media {
    display: grid;
    min-height: 19rem;
    place-items: center;
    overflow: hidden;
    border-bottom: 1px solid #2c2440;
    background: radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--title-accent) 12%, transparent), transparent 64%), #07060b;
  }
  .title-card__media img { width: 100%; height: 19rem; padding: 1rem; object-fit: contain; transition: transform 300ms ease; }
  .title-card__copy { display: flex; flex-direction: column; padding: 1.35rem; }
  .title-card__copy p { margin: 0; color: var(--title-accent); font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.16em; text-transform: uppercase; }
  .title-card__copy h3 { margin: 0.65rem 0 0; color: #f5f0df; font-family: var(--font-display); font-size: clamp(1.65rem, 3vw, 2.5rem); font-weight: 650; letter-spacing: -0.04em; line-height: 1; }
  .title-card__copy span { margin-top: 0.9rem; color: #b5b0c2; font-size: 0.9rem; line-height: 1.65; }
  .title-card__copy strong { margin-top: 1.35rem; color: #ece9f5; font-family: var(--font-mono); font-size: 0.68rem; font-weight: 400; letter-spacing: 0.08em; text-transform: uppercase; }
  .title-card__link:hover .title-card__media img { transform: scale(1.025); }
  .title-card__link:hover strong, .title-card__link:focus-visible strong { color: var(--title-accent); }
  .title-card__link:focus-visible { outline: 2px solid var(--title-accent); outline-offset: -3px; }
  @media (min-width: 760px) { .title-card__link { grid-template-columns: minmax(14rem, 0.75fr) minmax(0, 1.25fr); } .title-card__media { border-right: 1px solid #2c2440; border-bottom: 0; } }
  @media (prefers-reduced-motion: reduce) { .title-card__media img { transition: none; } .title-card__link:hover .title-card__media img { transform: none; } }
</style>
