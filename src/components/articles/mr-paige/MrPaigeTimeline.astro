---
const events = [
  ["1925", "First solo exhibition at Galeries Dalmau; the young painter tests bodies, rooms, windows, boats, and Mediterranean light."],
  ["1928", "Dalí, Lluís Montanyà, and Sebastià Gasch issue the Catalan Anti-Artistic Manifesto, also known as the Yellow Manifesto."],
  ["1929", "Un Chien Andalou premieres; Dalí meets Gala and enters the Paris Surrealist network."],
  ["1939", "Commercial photographs, celebrity images, collage, gouache, and painting remain visibly joined in works such as Shirley Temple and Baby Map of the World."],
  ["1950s", "Rhinoceros-horn geometry, nuclear physics, DNA, religion, and old-master technique meet inside Dalí’s postwar systems."],
  ["1970–73", "Dalí paints The Palace of the Wind while the Theatre-Museum takes shape in Figueres."],
  ["1971", "The Púbol ceiling and the Cavett appearance place the viewer under—or inside—the image."],
  ["1974", "The Dalí Theatre-Museum officially opens on September 28."],
];
---

<figure class="article-wide timeline not-prose">
  <p class="eyebrow">1925 to 1974</p>
  <ol>
    {events.map(([year, text]) => (
      <li>
        <time>{year}</time>
        <span>{text}</span>
      </li>
    ))}
  </ol>
  <figcaption>The television character arrived after decades of technical study, group politics, commercial work, and environmental scale.</figcaption>
</figure>

<style>
  .timeline {
    margin-block: 2.2rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 0.7rem;
    background: #0c0b0e;
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #d9b56c;
    font: 700 0.68rem/1.2 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 5.25rem 1fr;
    gap: 0.75rem;
    border-top: 1px solid rgb(255 255 255 / 0.08);
    padding: 0.7rem 0;
  }

  time {
    color: #71e3e5;
    font: 700 0.76rem/1.5 var(--font-mono);
  }

  li span {
    color: #b6b2af;
    font-size: 0.8rem;
    line-height: 1.55;
  }

  figcaption {
    margin-top: 0.75rem;
  }
</style>
