---
const milestones = [
  {
    date: "2.6 million years ago",
    title: "Oldowan tools",
    note: "Recognizable stone-tool traditions appear long before our species.",
  },
  {
    date: "about 300,000 years ago",
    title: "Homo sapiens",
    note: "Our species is present in Africa.",
  },
  {
    date: "about 65,000 years ago",
    title: "Madjedbebe",
    note: "People live in northern Australia with grinding stones, ochre and ground-edge axes.",
  },
  {
    date: "9600 BCE",
    title: "Göbekli Tepe",
    note: "Hunter-gatherers begin monumental construction in Upper Mesopotamia.",
  },
  {
    date: "late sixth millennium BCE",
    title: "Eridu",
    note: "Occupation begins on the southern Mesopotamian plain.",
  },
  {
    date: "about 3200 BCE",
    title: "Proto-cuneiform",
    note: "Administrative records make southern Mesopotamia newly visible.",
  },
  {
    date: "about 3100 BCE",
    title: "Dynastic Egypt",
    note: "Another durable written state enters the surviving record.",
  },
];
---

<figure class="eridu-timeline article-wide not-prose" aria-labelledby="eridu-timeline-title">
  <figcaption>
    <p class="eridu-timeline__eyebrow">Deep-time comparison</p>
    <h3 id="eridu-timeline-title">The recorder turned on late</h3>
    <p>The milestones are ordered, not drawn to scale. A linear chart would compress every city and written record into the final sliver.</p>
  </figcaption>
  <ol>
    {milestones.map((milestone, index) => (
      <li>
        <span class="eridu-timeline__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        <div>
          <time>{milestone.date}</time>
          <strong>{milestone.title}</strong>
          <p>{milestone.note}</p>
        </div>
      </li>
    ))}
  </ol>
</figure>

<style>
  .eridu-timeline {
    margin-block: 3rem !important;
    overflow: hidden;
    border: 1px solid rgb(124 174 169 / 0.34);
    border-radius: 0.55rem;
    background:
      radial-gradient(circle at 12% 0%, rgb(40 119 126 / 0.24), transparent 32rem),
      #071011;
    color: #f3f1e7;
    box-shadow: 0.65rem 0.75rem 0 rgb(0 0 0 / 0.25);
  }

  figcaption {
    display: grid;
    gap: 0.45rem;
    padding: clamp(1.2rem, 3vw, 2rem);
    border-bottom: 1px solid rgb(124 174 169 / 0.25);
  }

  figcaption p,
  figcaption h3 {
    margin: 0;
  }

  figcaption h3 {
    color: #fff;
    font-size: clamp(1.45rem, 3vw, 2.2rem);
    line-height: 1.05;
  }

  figcaption > p:not(.eridu-timeline__eyebrow) {
    max-width: 72ch;
    color: #bdc8c5;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .eridu-timeline__eyebrow {
    color: #e2b66e;
    font: 700 0.7rem/1.3 var(--font-mono, monospace);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  ol {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.85rem;
    padding: 1rem clamp(1.2rem, 3vw, 2rem);
    border-bottom: 1px solid rgb(124 174 169 / 0.16);
  }

  li:last-child {
    border-bottom: 0;
  }

  li:nth-child(n + 5) {
    background: rgb(226 182 110 / 0.045);
  }

  .eridu-timeline__number {
    padding-top: 0.1rem;
    color: #5f8582;
    font: 700 0.68rem/1.4 var(--font-mono, monospace);
  }

  li div {
    display: grid;
    grid-template-columns: minmax(10rem, 0.75fr) minmax(8rem, 0.55fr) minmax(14rem, 1.7fr);
    gap: 1rem;
    align-items: baseline;
  }

  time {
    color: #72d8e8;
    font: 700 0.7rem/1.4 var(--font-mono, monospace);
    text-transform: uppercase;
  }

  strong {
    color: #f8f4e7;
    font-size: 0.92rem;
  }

  li p {
    margin: 0;
    color: #aab7b4;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  @media (max-width: 48rem) {
    li div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
