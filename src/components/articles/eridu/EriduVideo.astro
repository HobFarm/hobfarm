---
interface Props {
  videoId: string;
  title: string;
  publisher: string;
  note: string;
}

const { videoId, title, publisher, note } = Astro.props;
const watchUrl = `https://www.youtube.com/watch?v=${videoId}`;
const posterUrl = `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`;
---

<figure class="eridu-video article-wide not-prose" data-eridu-video data-video-id={videoId}>
  <div class="eridu-video__screen" data-video-screen>
    <img src={posterUrl} alt="" width="1280" height="720" loading="lazy" decoding="async" />
    <button type="button" data-video-load aria-label={`Play ${title}`}>
      <span aria-hidden="true">▶</span>
      Play source video
    </button>
  </div>
  <figcaption>
    <div>
      <strong>{title}</strong>
      <span>{publisher}</span>
      <small>{note}</small>
    </div>
    <a href={watchUrl} target="_blank" rel="noopener noreferrer">Watch on YouTube <span aria-hidden="true">↗</span></a>
  </figcaption>
  <p class="sr-only" aria-live="polite" data-video-status></p>
</figure>

<script>
  function installEriduVideo() {
    document.querySelectorAll<HTMLElement>("[data-eridu-video]").forEach((player) => {
      const button = player.querySelector<HTMLButtonElement>("[data-video-load]");
      const screen = player.querySelector<HTMLElement>("[data-video-screen]");
      const status = player.querySelector<HTMLElement>("[data-video-status]");
      if (!button || !screen || button.dataset.ready === "true") return;
      button.dataset.ready = "true";

      button.addEventListener("click", () => {
        const videoId = player.dataset.videoId;
        if (!videoId) return;

        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}?autoplay=1&rel=0`;
        iframe.title = button.getAttribute("aria-label")?.replace(/^Play /, "") ?? "YouTube video";
        iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.referrerPolicy = "strict-origin-when-cross-origin";
        iframe.allowFullscreen = true;
        iframe.addEventListener("load", () => {
          if (status) status.textContent = `${iframe.title} loaded.`;
          iframe.focus();
        });

        screen.replaceChildren(iframe);
        if (status) status.textContent = `Loading ${iframe.title}.`;
      }, { once: true });
    });
  }

  installEriduVideo();
  document.addEventListener("astro:page-load", installEriduVideo);
</script>

<style>
  .eridu-video {
    margin-block: 2.75rem !important;
    overflow: hidden;
    border: 1px solid rgb(93 171 190 / 0.35);
    border-radius: 0.55rem;
    background: #071015;
    box-shadow: 0.7rem 0.8rem 0 rgb(0 0 0 / 0.28);
  }

  .eridu-video__screen {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #020507;
  }

  .eridu-video__screen::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 42%, rgb(0 0 0 / 0.74));
    content: "";
    pointer-events: none;
  }

  .eridu-video__screen img,
  .eridu-video__screen :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .eridu-video__screen :global(iframe) {
    position: relative;
    z-index: 2;
  }

  button {
    position: absolute;
    z-index: 1;
    right: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding: 0.72rem 0.9rem;
    border: 1px solid rgb(255 255 255 / 0.72);
    border-radius: 0.2rem;
    background: rgb(4 9 12 / 0.92);
    color: #fff;
    font: 700 0.72rem/1 var(--font-mono, monospace);
    cursor: pointer;
  }

  button:hover,
  button:focus-visible {
    border-color: #72d8e8;
    outline: 2px solid #72d8e8;
    outline-offset: 2px;
  }

  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1rem;
    border-top: 4px solid #c99e58;
  }

  figcaption div {
    display: grid;
    gap: 0.17rem;
  }

  strong {
    color: #f5f3ec;
    font-size: 0.86rem;
  }

  figcaption span,
  small {
    color: #a7b1b0;
    font-size: 0.7rem;
  }

  a {
    flex: 0 0 auto;
    color: #72d8e8 !important;
    font: 700 0.68rem/1.3 var(--font-mono, monospace);
  }

  @media (max-width: 34rem) {
    figcaption {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
