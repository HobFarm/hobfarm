---
interface ImageItem {
  src: string;
  alt: string;
  caption: string;
  credit: string;
  sourceUrl?: string;
  width?: number;
  height?: number;
}

interface Props {
  items: ImageItem[];
  label: string;
  columns?: 2 | 3;
  archive?: boolean;
}

const { items, label, columns = 2, archive = false } = Astro.props;
---

<section
  class:list={[
    "racing-image-group",
    "article-wide",
    archive && "racing-image-group--archive",
  ]}
  aria-label={label}
  style={`--racing-columns:${columns}`}
>
  <div class="racing-image-grid">
    {
      items.map((item) => (
        <figure>
          <img
            src={item.src}
            alt={item.alt}
            width={item.width}
            height={item.height}
            loading="lazy"
            decoding="async"
            data-lightbox
          />
          <figcaption>
            <span>{item.caption}</span>
            <span class="racing-credit">
              {item.sourceUrl ? (
                <a href={item.sourceUrl} rel="noreferrer">{item.credit}</a>
              ) : (
                item.credit
              )}
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .racing-image-group {
    margin-block: 2.5rem;
  }

  .racing-image-grid {
    display: grid;
    grid-template-columns: repeat(var(--racing-columns), minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
  }

  figure {
    min-width: 0;
    margin: 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.55rem;
  }

  .racing-image-group--archive img {
    max-height: 38rem;
    object-fit: contain;
    background: #111;
  }

  figcaption {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.65rem;
    color: var(--color-text-muted, #5b6674);
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .racing-credit {
    font-size: 0.75rem;
  }

  .racing-credit a {
    color: inherit;
    text-underline-offset: 0.16em;
  }

  @media (max-width: 720px) {
    .racing-image-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
