---
const pairs = [
  ["Eugene McDaniels", "Beastie Boys"],
  ["Quincy Jones", "The Pharcyde"],
  ["Labi Siffre", "Eminem"],
  ["Bob James", "Run-DMC"],
] as const;
---

<figure class="chronologies article-wide not-prose" aria-labelledby="chronologies-title">
  <figcaption id="chronologies-title">Two directions through the same records</figcaption>
  <div class="chronologies__lanes">
    <section aria-label="Historical time">
      <p>Historical time</p>
      {pairs.map(([source, later]) => (
        <div><strong>{source}</strong><span aria-hidden="true">→</span><strong>{later}</strong></div>
      ))}
    </section>
    <section aria-label="Personal listening time">
      <p>Personal listening time</p>
      {pairs.map(([source, later]) => (
        <div><strong>{later}</strong><span aria-hidden="true">→</span><strong>{source}</strong></div>
      ))}
    </section>
  </div>
  <p class="chronologies__key">The records keep their dates. Recognition reverses the route.</p>
</figure>

<style>
  .chronologies {
    margin-block: 2.7rem !important;
    overflow: hidden;
    border: 1px solid rgb(222 180 82 / 0.42);
    border-radius: 0.5rem;
    background:
      radial-gradient(circle at 50% 50%, transparent 0 12%, rgb(218 181 92 / 0.08) 12.5% 13%, transparent 13.5% 22%, rgb(218 181 92 / 0.07) 22.5% 23%, transparent 23.5%),
      #0a1115;
    box-shadow: 0.65rem 0.75rem 0 rgb(0 0 0 / 0.26);
  }

  figcaption {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgb(222 180 82 / 0.34);
    color: #f2e4c3;
    font: 800 0.74rem/1.4 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .chronologies__lanes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  section {
    padding: 1rem;
  }

  section + section {
    border-left: 1px dashed rgb(222 180 82 / 0.35);
  }

  section > p {
    margin: 0 0 0.7rem !important;
    color: #d8ad55;
    font: 800 0.65rem/1.4 var(--font-mono, monospace);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  section div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.55rem;
    min-height: 3.2rem;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }

  section div:first-of-type {
    border-top: 0;
  }

  section strong {
    color: #e7e2d6;
    font-size: 0.76rem;
    line-height: 1.25;
  }

  section strong:last-child {
    text-align: right;
  }

  section span {
    color: #ce522d;
    font-size: 1.15rem;
  }

  .chronologies__key {
    margin: 0 !important;
    padding: 0.75rem 1rem 0.85rem;
    border-top: 1px solid rgb(222 180 82 / 0.34);
    color: #aeb8ba;
    font: 650 0.69rem/1.45 var(--font-mono, monospace);
    text-align: center;
  }

  @media (max-width: 42rem) {
    .chronologies__lanes {
      grid-template-columns: 1fr;
    }

    section + section {
      border-top: 1px dashed rgb(222 180 82 / 0.35);
      border-left: 0;
    }
  }
</style>
