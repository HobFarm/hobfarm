---
import { imageSrcset, transformImageUrl } from "@/lib/media-transforms";

interface PhotoItem {
  file: string;
  alt: string;
  caption: string;
  width: number;
  height: number;
}

interface Props {
  id: string;
  kicker: string;
  title: string;
  intro?: string;
  photos: PhotoItem[];
  layout?: "grid" | "pair" | "single";
}

const { id, kicker, title, intro, photos, layout = "grid" } = Astro.props;
const assetBase = "https://cdn.hob.farm/articles/rock-art";
const source = (file: string) => `${assetBase}/${encodeURIComponent(file)}`;
---

<section class:list={["rock-photo-group", "article-wide", "not-prose", `layout-${layout}`]} aria-labelledby={`${id}-title`}>
  <header>
    <p>{kicker}</p>
    <h2 id={`${id}-title`}>{title}</h2>
    {intro && <span>{intro}</span>}
  </header>
  <div class="photos">
    {photos.map((photo) => {
      const original = source(photo.file);
      const widths = [480, 800, 1200, 1600].filter((candidate) => photo.width >= candidate);
      return (
        <figure>
          <img
            src={transformImageUrl(original, { width: widths.at(-1) ?? photo.width, quality: 84, fit: "contain" })}
            srcset={imageSrcset(original, widths, { quality: 84, fit: "contain" })}
            sizes={layout === "single" ? "(min-width: 900px) 68rem, 92vw" : "(min-width: 900px) 34rem, 92vw"}
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            loading="lazy"
            decoding="async"
            data-lightbox={original}
            data-lightbox-group={`rock-art-${id}`}
            data-lightbox-caption={photo.caption}
          />
          <figcaption>{photo.caption}</figcaption>
        </figure>
      );
    })}
  </div>
  <footer>Photographs by HobFarm</footer>
</section>

<style>
  .rock-photo-group {
    overflow: hidden;
    border: 1px solid rgb(208 143 75 / 0.34);
    border-radius: 0.65rem;
    background: #0c0a08;
  }

  header {
    padding: clamp(1rem, 3vw, 1.55rem);
    background: linear-gradient(112deg, rgb(115 57 28 / 0.58), transparent 68%);
  }

  header p,
  header h2,
  header span {
    margin: 0 !important;
  }

  header p {
    color: #e9a45e !important;
    font: 700 0.66rem/1.2 var(--font-mono), monospace !important;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  header h2 {
    margin-top: 0.3rem !important;
    color: #f5eee6 !important;
    font-size: clamp(1.35rem, 3vw, 2rem) !important;
  }

  header span {
    display: block;
    max-width: 58rem;
    margin-top: 0.65rem !important;
    color: #c1b6aa;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: rgb(208 143 75 / 0.2);
  }

  .layout-single .photos {
    grid-template-columns: 1fr;
  }

  figure {
    display: grid;
    grid-template-rows: 1fr auto;
    min-width: 0;
    margin: 0 !important;
    background: #050403;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 46rem;
    margin: 0 !important;
    object-fit: contain;
    background: #020202;
    cursor: zoom-in;
  }

  .layout-grid img,
  .layout-pair img {
    aspect-ratio: 4 / 3;
  }

  .layout-single img {
    height: auto;
    max-height: none;
  }

  figcaption {
    min-height: 4.3rem;
    padding: 0.72rem 0.9rem 0.9rem;
    color: #bbb0a5 !important;
    font-size: 0.72rem !important;
    line-height: 1.55 !important;
    text-align: left !important;
  }

  footer {
    padding: 0.75rem 1rem;
    border-top: 1px solid rgb(208 143 75 / 0.18);
    color: #91877e;
    font: 0.68rem/1.45 var(--font-mono), monospace;
  }

  @media (max-width: 699px) {
    .photos {
      grid-template-columns: 1fr;
    }

    figcaption {
      min-height: 0;
    }
  }
</style>
