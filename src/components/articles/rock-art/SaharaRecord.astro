---
const stages = [
  {
    label: "Wild fauna",
    where: "Tadrart Acacus and Tassili n’Ajjer",
    evidence: "Elephants, giraffes, hippos, rhinoceroses, and other water-dependent or savanna animals appear in documented Saharan image records.",
    limit: "An animal image does not provide a complete local climate history by itself.",
  },
  {
    label: "Pastoral cattle",
    where: "Tassili n’Ajjer",
    evidence: "UNESCO’s Cattle Period description records herds and scenes of daily and social life.",
    limit: "The label belongs to a regional scholarly sequence, not every Saharan wall.",
  },
  {
    label: "Horses and transport",
    where: "Tassili n’Ajjer",
    evidence: "Later images include horses and show another set of lifeways and movement across the landscape.",
    limit: "Style and subject can suggest relative order. Direct dates remain uneven.",
  },
  {
    label: "Camels and scripts",
    where: "Tassili n’Ajjer and Ḥimā",
    evidence: "Camel images belong to later Saharan phases. At Ḥimā, travelers left inscriptions in several scripts into recent centuries.",
    limit: "Later additions extend the archive. They do not erase or explain the earlier marks.",
  },
];
---

<section class="sahara-record article-wide not-prose" aria-labelledby="sahara-record-title">
  <header>
    <p>A regional sequence</p>
    <h2 id="sahara-record-title">The walls changed while the Sahara changed</h2>
    <span>These four subjects occur in securely documented regional records. They are evidence of succession, not a universal four-stage style system.</span>
  </header>
  <ol>
    {stages.map((stage, index) => (
      <li>
        <div class="stage-number">{String(index + 1).padStart(2, "0")}</div>
        <p class="where">{stage.where}</p>
        <h3>{stage.label}</h3>
        <p class="evidence">{stage.evidence}</p>
        <p class="limit"><strong>Limit:</strong> {stage.limit}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .sahara-record {
    overflow: hidden;
    border: 1px solid rgb(221 151 74 / 0.35);
    border-radius: 0.7rem;
    background: #100b07;
  }

  header {
    padding: clamp(1rem, 3vw, 1.55rem);
    background: linear-gradient(112deg, rgb(132 67 22 / 0.62), transparent 70%);
  }

  header p,
  header h2,
  header span,
  li p,
  li h3 {
    margin: 0 !important;
  }

  header p,
  .where {
    color: #edaa61 !important;
    font: 700 0.65rem/1.3 var(--font-mono), monospace !important;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  header h2 {
    margin-top: 0.3rem !important;
    color: #f7eee3 !important;
    font-size: clamp(1.35rem, 3vw, 2rem) !important;
  }

  header span {
    display: block;
    max-width: 58rem;
    margin-top: 0.55rem !important;
    color: #c5b6a7;
    font-size: 0.82rem;
  }

  ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0 !important;
    padding: 0 !important;
    list-style: none;
  }

  li {
    position: relative;
    min-width: 0;
    padding: 1rem;
    border-top: 1px solid rgb(221 151 74 / 0.2);
    border-right: 1px solid rgb(221 151 74 / 0.18);
  }

  li:last-child {
    border-right: 0;
  }

  .stage-number {
    margin-bottom: 0.65rem;
    color: rgb(237 170 97 / 0.5);
    font: 800 1.2rem/1 var(--font-mono), monospace;
  }

  li h3 {
    margin-top: 0.3rem !important;
    color: #f7eee3 !important;
    font-size: 1rem !important;
  }

  .evidence {
    margin-top: 0.55rem !important;
    color: #c3b5a7 !important;
    font-size: 0.75rem !important;
    line-height: 1.55 !important;
  }

  .limit {
    margin-top: 0.75rem !important;
    padding-top: 0.65rem;
    border-top: 1px solid rgb(221 151 74 / 0.15);
    color: #95887c !important;
    font-size: 0.68rem !important;
    line-height: 1.5 !important;
  }

  .limit strong {
    color: #b9a797;
  }

  @media (max-width: 899px) {
    ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 559px) {
    ol {
      grid-template-columns: 1fr;
    }

    li {
      border-right: 0;
    }
  }
</style>
