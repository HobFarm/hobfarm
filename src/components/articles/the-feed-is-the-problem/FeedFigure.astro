---
type FigureKind = "accounting" | "loop" | "pipelines" | "friend" | "curriculum";

interface Props {
  kind: FigureKind;
}

const figures = {
  accounting: {
    eyebrow: "Two accounting systems",
    title: "The event ends at different times",
    caption:
      "A platform can count the completed engagement event while the person keeps carrying the material. The right column describes the mechanism tested in the doomscrolling studies, not an outcome for every reader.",
    transcript: [
      "Platform record: stopped, read, watched, opened comments, refreshed, and returned.",
      "Human aftermath: rumination, distraction, worry, lower work engagement, mood residue, and attention still occupied.",
      "The platform can record a successful event even when the material remains mentally active after the screen is closed.",
    ],
  },
  loop: {
    eyebrow: "The feedback loop",
    title: "Attention becomes a production signal",
    caption:
      "Solid connectors summarize measured relationships in the cited studies. Dotted connectors mark the article's synthesis across separate findings. The path is possible, not universal.",
    transcript: [
      "Measured route: low mood can influence selection of negative information, and negative browsing can worsen mood.",
      "Measured route: doomscrolling is associated with rumination and lower work engagement.",
      "Measured route: negative headline words increased click-through rates in the Upworthy experiments.",
      "Measured route: creators report interpreting metrics and adapting later work under algorithmic and monetary control.",
      "Side input: pressure to make a distinct contribution can push a discussion toward more negative comments.",
      "System synthesis: behavioral signals influence distribution, distribution produces more metrics, and those metrics can become production instructions.",
      "Exit routes: chosen sources through RSS and direct mutual relationships.",
    ],
  },
  pipelines: {
    eyebrow: "Ranked feed versus chosen source",
    title: "The source choice happens in a different place",
    caption:
      "RSS does not make a publisher trustworthy. It lets the reader choose the publisher without requiring a recommendation system to infer the next source from a pause.",
    transcript: [
      "Ranked public feed: publisher, platform ingestion, ranking, personalized delivery, user behavior, and updated ranking.",
      "Chosen-source feed: publisher, RSS item, reader-selected folder, reader, and source website.",
      "Both lanes can still contain poor reporting, persuasion, analytics, or clickbait. Quality still depends on the source.",
    ],
  },
  friend: {
    eyebrow: "A feed is not a friend",
    title: "Distribution and relationship are different systems",
    caption:
      "A direct online friendship can be a real relationship. The distinction is between mutual connection and attention routed through a ranked public feed.",
    transcript: [
      "Public feed: reach, ranking, performance, audience, metrics, distribution, and monetization.",
      "Mutual relationship: reciprocity, history, context, care, and shared consequence.",
      "The relationship study reports an association with self-rated health. It does not show that friendship is a cure or a substitute for treatment.",
    ],
  },
  curriculum: {
    eyebrow: "The loop has a curriculum",
    title: "Platform work is now a formal course of study",
    caption:
      "Arizona State University's Content Creation BA combines production craft with audience strategy, analytics, media law, ethics, and professional experience. The program does not claim to teach outrage.",
    transcript: [
      "Verified curriculum areas include media writing, developing media content, multimedia production, mass communication ethics, media law, digital audience work, social media, podcasting, studio production, editing, videography, and a production capstone.",
      "ASU's program description also names content planning, personal branding, audience analytics, integrated communication, brand projects, and professional experience.",
    ],
  },
} as const;

const figure = figures[Astro.props.kind];
---

<figure class="feed-figure not-prose my-12 border-y border-base-800 py-6 sm:my-16 sm:py-8" data-kind={Astro.props.kind}>
  <div class="mx-auto max-w-[48rem] overflow-hidden border border-base-800 bg-base-950 shadow-2xl shadow-black/20">
    <header class="border-b border-base-800 p-5 sm:p-7">
      <p class="font-mono text-[10px] uppercase tracking-[.18em] text-accent-cyan">{figure.eyebrow}</p>
      <h3 class="mt-2 font-display text-2xl font-light text-white sm:text-3xl">{figure.title}</h3>
    </header>

    {Astro.props.kind === "accounting" && (
      <div class="grid gap-px bg-base-800 sm:grid-cols-2">
        <section class="bg-base-950 p-5 sm:p-7">
          <p class="lane-label">Platform record</p>
          <ul class="signal-list">
            <li>Stopped</li><li>Read</li><li>Watched</li><li>Opened comments</li><li>Refreshed</li><li>Returned</li>
          </ul>
          <p class="result-box cyan">Engagement event counted</p>
        </section>
        <section class="bg-base-950 p-5 sm:p-7">
          <p class="lane-label">Human aftermath</p>
          <ul class="signal-list warm">
            <li>Rumination</li><li>Distraction</li><li>Worry</li><li>Lower engagement</li><li>Mood residue</li><li>Attention occupied</li>
          </ul>
          <p class="result-box orange">Event still running</p>
        </section>
      </div>
    )}

    {Astro.props.kind === "loop" && (
      <div class="p-5 sm:p-7">
        <div class="loop-grid">
          <span class="loop-node">Uncertainty or low mood</span>
          <span class="loop-arrow solid" aria-hidden="true">↓</span>
          <span class="loop-node warm">Negative information</span>
          <span class="loop-arrow solid" aria-hidden="true">↓</span>
          <span class="loop-node">Attention and behavior</span>
          <span class="loop-arrow dotted" aria-hidden="true">↓</span>
          <span class="loop-node cyan">Ranking and distribution</span>
          <span class="loop-arrow dotted" aria-hidden="true">↓</span>
          <span class="loop-node warm">More exposure</span>
          <span class="loop-arrow solid" aria-hidden="true">↓</span>
          <span class="loop-node">Rumination or mood effect</span>
          <span class="loop-arrow dotted" aria-hidden="true">↓</span>
          <span class="loop-node cyan">Creator analytics</span>
          <span class="loop-arrow solid" aria-hidden="true">↓</span>
          <span class="loop-node">Adapted production</span>
        </div>
        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          <div class="side-card warm"><strong>Side input</strong><span>Pressure to stand out → more negative contribution</span></div>
          <div class="side-card exit"><strong>Exit route</strong><span>Reader-chosen sources through RSS</span></div>
          <div class="side-card exit"><strong>Exit route</strong><span>Direct mutual relationships</span></div>
        </div>
        <div class="mt-5 flex flex-wrap gap-4 font-mono text-[9px] uppercase tracking-wider text-base-400">
          <span><i class="legend solid"></i> measured relationship</span>
          <span><i class="legend dotted"></i> system synthesis</span>
        </div>
      </div>
    )}

    {Astro.props.kind === "pipelines" && (
      <div class="grid gap-px bg-base-800 md:grid-cols-2">
        <section class="bg-base-950 p-5 sm:p-7">
          <p class="lane-label">Ranked public feed</p>
          <ol class="route-list">
            <li>Publisher</li><li>Platform ingestion</li><li>Ranking</li><li>Personalized delivery</li><li>User behavior</li><li>Updated ranking</li>
          </ol>
        </section>
        <section class="bg-base-950 p-5 sm:p-7">
          <p class="lane-label text-accent-cyan">Chosen-source feed</p>
          <ol class="route-list direct">
            <li>Publisher</li><li>RSS item</li><li>Reader-selected folder</li><li>Reader</li><li>Source website</li>
          </ol>
        </section>
        <p class="bg-base-950 p-4 text-center font-mono text-[10px] uppercase tracking-[.14em] text-base-400 md:col-span-2">Quality still depends on the source</p>
      </div>
    )}

    {Astro.props.kind === "friend" && (
      <div class="grid gap-px bg-base-800 sm:grid-cols-2">
        <section class="bg-base-950 p-5 sm:p-7">
          <p class="lane-label">Public feed</p>
          <div class="word-field"><span>Reach</span><span>Ranking</span><span>Performance</span><span>Audience</span><span>Metrics</span><span>Distribution</span><span>Monetization</span></div>
        </section>
        <section class="bg-base-950 p-5 sm:p-7">
          <p class="lane-label text-accent-cyan">Mutual relationship</p>
          <div class="word-field direct"><span>Reciprocity</span><span>History</span><span>Context</span><span>Care</span><span>Shared consequence</span></div>
        </section>
      </div>
    )}

    {Astro.props.kind === "curriculum" && (
      <div class="grid gap-2 p-5 sm:grid-cols-2 sm:p-7 md:grid-cols-4">
        {["Content planning", "Video + audio", "Audience growth", "Analytics", "Ethics", "Copyright + law", "Brand work", "Production capstone"].map((item) => <span class="curriculum-card">{item}</span>)}
      </div>
    )}
  </div>

  <figcaption class="mx-auto mt-4 max-w-[48rem] text-sm leading-relaxed text-base-300">{figure.caption}</figcaption>
  <details class="mx-auto mt-4 max-w-[48rem] border border-base-800 bg-base-950/60 p-4 text-sm text-base-300">
    <summary class="cursor-pointer font-mono text-[10px] uppercase tracking-wider text-accent-cyan focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-cyan">Read the graphic transcript</summary>
    <ul class="mt-3 space-y-2 pl-5 leading-relaxed">{figure.transcript.map((line: string) => <li>{line}</li>)}</ul>
  </details>
</figure>

<style>
  .lane-label { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: rgb(161 161 170); }
  .signal-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; margin-top: 1rem; padding: 0; list-style: none; }
  .signal-list li, .curriculum-card { border: 1px solid rgb(63 63 70); background: rgb(24 24 27); padding: .7rem; color: rgb(228 228 231); font-size: .78rem; }
  .signal-list.warm li { border-color: rgb(154 72 33 / .65); }
  .result-box { margin-top: 1rem; border: 1px solid; padding: .75rem; font-family: var(--font-mono); font-size: .63rem; letter-spacing: .1em; text-transform: uppercase; }
  .result-box.cyan { border-color: rgb(85 215 255 / .55); color: rgb(85 215 255); }
  .result-box.orange { border-color: rgb(230 118 45 / .65); color: rgb(251 146 60); }
  .loop-grid { display: grid; justify-items: center; }
  .loop-node { width: min(100%, 29rem); border: 1px solid rgb(63 63 70); background: rgb(24 24 27); padding: .75rem 1rem; text-align: center; color: white; font-size: .78rem; }
  .loop-node.warm { border-color: rgb(154 72 33 / .75); color: rgb(253 186 116); }
  .loop-node.cyan { border-color: rgb(85 215 255 / .6); color: rgb(85 215 255); }
  .loop-arrow { height: 1.55rem; display: grid; place-items: center; color: rgb(113 113 122); }
  .loop-arrow.dotted { color: rgb(85 215 255); }
  .side-card { display: grid; gap: .35rem; border: 1px solid rgb(63 63 70); padding: .8rem; font-size: .72rem; color: rgb(212 212 216); }
  .side-card strong { font-family: var(--font-mono); font-size: .58rem; letter-spacing: .1em; text-transform: uppercase; color: rgb(161 161 170); }
  .side-card.warm { border-color: rgb(154 72 33 / .65); }
  .side-card.exit { border-color: rgb(85 215 255 / .45); }
  .legend { display: inline-block; width: 1.5rem; margin-right: .4rem; vertical-align: middle; border-top: 2px solid rgb(161 161 170); }
  .legend.dotted { border-top-style: dotted; border-color: rgb(85 215 255); }
  .route-list { margin: 1rem 0 0; padding: 0; list-style: none; counter-reset: route; }
  .route-list li { position: relative; margin-bottom: 1.5rem; border: 1px solid rgb(63 63 70); padding: .72rem 2.7rem .72rem .8rem; color: rgb(228 228 231); font-size: .78rem; counter-increment: route; }
  .route-list li::after { content: counter(route, decimal-leading-zero); position: absolute; right: .8rem; color: rgb(113 113 122); font-family: var(--font-mono); font-size: .6rem; }
  .route-list li:not(:last-child)::before { content: "↓"; position: absolute; left: 50%; top: calc(100% + .15rem); color: rgb(113 113 122); }
  .route-list.direct li { border-color: rgb(85 215 255 / .45); }
  .word-field { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
  .word-field span { border: 1px solid rgb(63 63 70); padding: .6rem .7rem; color: rgb(212 212 216); font-size: .72rem; }
  .word-field.direct span { border-color: rgb(85 215 255 / .45); color: rgb(165 243 252); }
  .curriculum-card { text-align: center; border-color: rgb(85 215 255 / .35); }
  @media (max-width: 420px) { .signal-list { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .feed-figure * { scroll-behavior: auto; transition-duration: .01ms !important; } }
</style>
