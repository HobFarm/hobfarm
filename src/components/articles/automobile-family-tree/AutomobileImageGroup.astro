---
interface ImageItem {
  src: string;
  alt: string;
  caption: string;
  credit: string;
  sourceUrl?: string;
  width?: number;
  height?: number;
}

interface Props {
  items: ImageItem[];
  label: string;
  columns?: 2 | 3 | 4;
}

const { items, label, columns = 2 } = Astro.props;
---

<section
  class="automobile-image-group article-wide"
  aria-label={label}
  style={`--automobile-columns:${columns}`}
>
  <div class="automobile-image-grid">
    {
      items.map((item) => (
        <figure>
          <img
            src={item.src}
            alt={item.alt}
            width={item.width}
            height={item.height}
            loading="lazy"
            decoding="async"
            data-lightbox
          />
          <figcaption>
            <span>{item.caption}</span>
            <span class="automobile-credit">
              {item.sourceUrl ? (
                <a href={item.sourceUrl} rel="noreferrer">{item.credit}</a>
              ) : (
                item.credit
              )}
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .automobile-image-group {
    margin-block: 2.5rem;
  }

  .automobile-image-grid {
    display: grid;
    grid-template-columns: repeat(var(--automobile-columns), minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
  }

  figure {
    min-width: 0;
    margin: 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.6rem;
  }

  figcaption {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.65rem;
    color: var(--color-text-muted, #6b7280);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .automobile-credit {
    font-size: 0.73rem;
  }

  a {
    color: inherit;
    text-underline-offset: 0.16em;
  }

  @media (max-width: 760px) {
    .automobile-image-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
