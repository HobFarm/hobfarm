---
const decks = {
  playlist: {
    eyebrow: "PERSONAL ARCHIVE",
    title: "The four-hundred-video channel",
    intro: "A hand-picked YouTube Music playlist is the closest thing here to a fixed personal schedule. The sequence is mine; playback still depends on what YouTube can serve.",
    links: [
      ["Author’s music-video playlist", "400 videos and counting", "https://music.youtube.com/playlist?list=PLjvwJi5CsacmfJiRLxQGC2NalZx0SqUby"],
    ],
  },
  archives: {
    eyebrow: "OFFICIAL CHANNELS",
    title: "The tapes are scattered by artist",
    intro: "These channels are durable fallbacks when a recommendation service has the song but not its video.",
    links: [
      ["Nirvana", "Official videos and live performances", "https://www.youtube.com/@nirvana/videos"],
      ["Guns N’ Roses", "Official videos, including catalog gaps elsewhere", "https://www.youtube.com/@gunsnroses/videos"],
      ["Book Club Radio", "Filmed DJ sets and event channel", "https://www.youtube.com/@bookclubradio"],
    ],
  },
  paramount: {
    eyebrow: "CABLE AFTERLIFE",
    title: "The MTV shelves on Paramount+",
    intro: "The service has selected programs, not a complete restoration of the old broadcast schedule. Availability can vary by market and subscription.",
    links: [
      ["MTV hub", "Current Paramount+ MTV index", "https://www.paramountplus.com/brands/mtv/"],
      ["MTV Unplugged", "Selected performances and episodes", "https://www.paramountplus.com/shows/mtv-unplugged/"],
      ["Beavis and Butt-Head", "The Mike Judge collection and current series pages", "https://www.paramountplus.com/shows/beavis-and-butt-head/"],
    ],
  },
} as const;

interface Props {
  deck: keyof typeof decks;
}

const item = decks[Astro.props.deck];
---

<aside class="article-wide link-deck not-prose" aria-labelledby={`link-deck-${Astro.props.deck}`}>
  <header><p>{item.eyebrow}</p><h3 id={`link-deck-${Astro.props.deck}`}>{item.title}</h3><span>{item.intro}</span></header>
  <ul>
    {item.links.map(([title, note, url]) => (
      <li><a href={url} target="_blank" rel="noopener noreferrer"><strong>{title}</strong><span>{note}</span><b aria-hidden="true">↗</b></a></li>
    ))}
  </ul>
</aside>

<style>
  .link-deck {
    margin-block: 2.4rem !important;
    padding: clamp(0.8rem, 2vw, 1.15rem);
    border: 1px solid rgb(105 215 209 / 0.28);
    border-radius: 0.45rem;
    background: linear-gradient(115deg, rgb(105 215 209 / 0.07), transparent 50%), #090d0e;
  }

  header p,
  header h3,
  header span {
    margin: 0 !important;
  }

  header p {
    color: #69d7d1;
    font: 700 0.59rem/1.3 var(--font-mono);
    letter-spacing: 0.13em;
  }

  header h3 {
    margin-top: 0.18rem !important;
    color: #eff5f4;
    font-size: clamp(1.15rem, 3.5vw, 1.65rem) !important;
  }

  header > span {
    display: block;
    max-width: 48rem;
    margin-top: 0.35rem !important;
    color: #929c9c;
    font-size: 0.7rem;
    line-height: 1.5;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0.55rem;
    margin: 0.9rem 0 0 !important;
    padding: 0 !important;
    list-style: none;
  }

  li {
    margin: 0 !important;
  }

  a {
    display: grid;
    grid-template-columns: 1fr auto;
    height: 100%;
    padding: 0.72rem;
    border: 1px solid rgb(255 255 255 / 0.11);
    background: rgb(5 7 8 / 0.72);
    text-decoration: none !important;
  }

  a:hover,
  a:focus-visible {
    border-color: #69d7d1;
    outline: 2px solid #69d7d1;
    outline-offset: 2px;
  }

  a strong {
    color: #e9efee;
    font-size: 0.76rem;
  }

  a span {
    grid-column: 1;
    margin-top: 0.24rem;
    color: #8d9797;
    font-size: 0.64rem;
    line-height: 1.4;
  }

  a b {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: #69d7d1;
    font-size: 0.82rem;
  }
</style>
