---
interface Props {
  title: string;
  artist: string;
  videoId: string;
  note?: string;
}

const { title, artist, videoId, note } = Astro.props;
const watchUrl = `https://www.youtube.com/watch?v=${videoId}`;
const posterUrl = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
---

<figure class="article-wide mtv-player not-prose" data-mtv-player data-video-id={videoId}>
  <div class="mtv-player__screen" data-player-screen>
    <img src={posterUrl} alt="" width="480" height="360" loading="lazy" decoding="async" />
    <button type="button" data-player-load aria-label={`Load ${title} by ${artist} from YouTube`}>
      <span aria-hidden="true">▶</span>
      Load official video
    </button>
  </div>
  <figcaption>
    <div>
      <strong>{title}</strong>
      <span>{artist}</span>
      {note && <small>{note}</small>}
    </div>
    <a href={watchUrl} target="_blank" rel="noopener noreferrer">Watch on YouTube <span aria-hidden="true">↗</span></a>
  </figcaption>
  <p class="sr-only" aria-live="polite" data-player-status></p>
</figure>

<script>
  function installMtvPlayers() {
    document.querySelectorAll<HTMLElement>("[data-mtv-player]").forEach((player) => {
      const button = player.querySelector<HTMLButtonElement>("[data-player-load]");
      const screen = player.querySelector<HTMLElement>("[data-player-screen]");
      const status = player.querySelector<HTMLElement>("[data-player-status]");

      if (!button || !screen || button.dataset.ready === "true") return;
      button.dataset.ready = "true";

      button.addEventListener("click", () => {
        const videoId = player.dataset.videoId;
        const label = button.getAttribute("aria-label")?.replace(/^Load /, "").replace(/ from YouTube$/, "") ?? "video";
        if (!videoId) return;

        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}?rel=0`;
        iframe.title = label;
        iframe.loading = "lazy";
        iframe.allow = "encrypted-media; picture-in-picture; web-share";
        iframe.referrerPolicy = "strict-origin-when-cross-origin";
        iframe.allowFullscreen = true;
        iframe.addEventListener("load", () => {
          if (status) status.textContent = `${label} loaded.`;
          iframe.focus();
        });

        screen.replaceChildren(iframe);
        if (status) status.textContent = `Loading ${label}.`;
      });
    });
  }

  installMtvPlayers();
  document.addEventListener("astro:page-load", installMtvPlayers);
</script>

<style>
  .mtv-player {
    margin-block: 2.6rem !important;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: 0.45rem;
    background: #08090b;
    box-shadow: 0.7rem 0.8rem 0 rgb(0 0 0 / 0.28);
  }

  .mtv-player__screen {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #020303;
  }

  .mtv-player__screen::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgb(0 0 0 / 0.7));
    content: "";
    pointer-events: none;
  }

  .mtv-player__screen img,
  .mtv-player__screen :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .mtv-player__screen :global(iframe) {
    position: relative;
    z-index: 2;
  }

  .mtv-player button {
    position: absolute;
    z-index: 1;
    right: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.68rem 0.82rem;
    border: 1px solid rgb(255 255 255 / 0.65);
    border-radius: 0.2rem;
    background: rgb(5 8 9 / 0.9);
    color: #fff;
    font: 700 0.72rem/1 var(--font-mono);
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .mtv-player button:hover,
  .mtv-player button:focus-visible {
    border-color: #62f0cf;
    background: #10201d;
    outline: 2px solid #62f0cf;
    outline-offset: 2px;
  }

  .mtv-player figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 !important;
    padding: 0.8rem 0.9rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .mtv-player figcaption div {
    display: grid;
  }

  .mtv-player strong {
    color: #f1f5f2;
    font-size: 0.82rem;
  }

  .mtv-player figcaption span,
  .mtv-player small {
    color: #98a39f;
    font-size: 0.68rem;
  }

  .mtv-player small {
    margin-top: 0.25rem;
  }

  .mtv-player a {
    flex: 0 0 auto;
    color: #62f0cf !important;
    font: 700 0.66rem/1.3 var(--font-mono);
  }

  @media (max-width: 34rem) {
    .mtv-player figcaption {
      align-items: start;
      flex-direction: column;
    }

    .mtv-player button {
      right: 0.65rem;
      bottom: 0.65rem;
    }
  }
</style>
