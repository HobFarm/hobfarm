---
const tracks = {
  "love-spreads": {
    title: "Love Spreads",
    artist: "The Stone Roses",
    url: "https://open.spotify.com/track/6UMPJxK96s3qIoQwEWGTPM",
  },
  "nearly-lost-you": {
    title: "Nearly Lost You",
    artist: "Screaming Trees",
    url: "https://open.spotify.com/track/6sapvfFkqmdv44tyjRwjuB",
  },
} as const;

interface Props {
  track: keyof typeof tracks;
}

const item = tracks[Astro.props.track];
---

<aside class="spotify-track not-prose" aria-label={`Spotify track: ${item.title} by ${item.artist}`}>
  <div aria-hidden="true">♫</div>
  <p><strong>{item.title}</strong><span>{item.artist}</span></p>
  <a href={item.url} target="_blank" rel="noopener noreferrer">Open in Spotify <span aria-hidden="true">↗</span></a>
  <small>Open in Spotify, then use <strong>Switch to video</strong> when available.</small>
</aside>

<style>
  .spotify-track {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    margin-block: 1.5rem !important;
    padding: 0.75rem;
    border: 1px solid rgb(93 220 135 / 0.28);
    border-radius: 0.4rem;
    background: linear-gradient(100deg, rgb(30 215 96 / 0.08), transparent 48%), #0a0d0b;
  }

  .spotify-track > div {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    background: #1ed760;
    color: #061009;
    font-weight: 900;
  }

  .spotify-track p,
  .spotify-track small {
    margin: 0 !important;
  }

  .spotify-track p {
    display: grid;
  }

  .spotify-track p strong {
    color: #f0f5f1;
    font-size: 0.78rem;
  }

  .spotify-track p span,
  .spotify-track small {
    color: #929d95;
    font-size: 0.64rem;
  }

  .spotify-track a {
    color: #65e88f !important;
    font: 700 0.66rem/1.3 var(--font-mono);
  }

  .spotify-track small {
    grid-column: 2 / -1;
  }

  .spotify-track small strong {
    color: #b8c2ba;
  }

  @media (max-width: 34rem) {
    .spotify-track {
      grid-template-columns: auto 1fr;
    }

    .spotify-track a,
    .spotify-track small {
      grid-column: 2;
    }
  }
</style>
