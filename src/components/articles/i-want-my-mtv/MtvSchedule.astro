---
const blocks = [
  ["18:00", "Opening credits", "Stone Roses, Screaming Trees, the summer of 1992"],
  ["18:35", "The rotation", "Sonic Youth seed, Spotify video radio, personal playlist"],
  ["19:15", "Live room", "Nirvana and Alice in Chains Unplugged"],
  ["20:00", "Cable afterlife", "Beavis and Butt-Head, Æon Flux, selected MTV archive"],
  ["20:45", "Full concert", "One artist channel, no chopped-up set"],
  ["22:15", "Book Club Radio", "A filmed DJ set or a night at the venue"],
  ["00:00", "After-hours film program", "Ganacci, Jamie xx, Bonobo, LCD Soundsystem"],
] as const;
---

<section class="article-wide mtv-schedule not-prose" aria-labelledby="mtv-schedule-title">
  <header><p>HOBFARM PERSONAL NETWORK</p><h3 id="mtv-schedule-title">Tonight on my MTV</h3></header>
  <ol>
    {blocks.map(([time, title, note]) => (
      <li><time>{time}</time><div><strong>{title}</strong><span>{note}</span></div></li>
    ))}
  </ol>
  <footer>SUBJECT TO RIGHTS, MEMORY, AND THE NEXT VIDEO ACTUALLY LOADING</footer>
</section>

<style>
  .mtv-schedule {
    --schedule: #ff6b9d;
    margin-block: 3rem !important;
    overflow: hidden;
    border: 1px solid rgb(255 107 157 / 0.38);
    border-radius: 0.5rem;
    background: #100a10;
    box-shadow: 0.7rem 0.85rem 0 #040304;
  }

  header {
    padding: 1rem;
    border-bottom: 1px solid rgb(255 107 157 / 0.25);
    background: linear-gradient(100deg, rgb(255 107 157 / 0.12), transparent 60%);
  }

  header p,
  header h3 {
    margin: 0 !important;
  }

  header p,
  footer {
    color: var(--schedule);
    font: 700 0.59rem/1.4 var(--font-mono);
    letter-spacing: 0.13em;
  }

  header h3 {
    margin-top: 0.16rem !important;
    color: #f6eef5;
    font-size: clamp(1.35rem, 4vw, 2rem) !important;
  }

  ol {
    margin: 0 !important;
    padding: 0 !important;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.8rem;
    margin: 0 !important;
    padding: 0.72rem 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  time {
    color: var(--schedule);
    font: 700 0.75rem/1.4 var(--font-mono);
  }

  li div {
    display: grid;
  }

  li strong {
    color: #ede7ed;
    font-size: 0.79rem;
  }

  li span {
    margin-top: 0.12rem;
    color: #938a93;
    font-size: 0.66rem;
  }

  footer {
    padding: 0.7rem 1rem;
    background: #0a070a;
  }

  @media (max-width: 30rem) {
    li {
      grid-template-columns: 3.3rem 1fr;
      padding-inline: 0.75rem;
    }
  }
</style>
