---
type FigureKind = "timeline" | "quarters" | "canon" | "hardware";

interface Props {
  kind: FigureKind;
}

const figures = {
  timeline: {
    eyebrow: "The arcade years",
    title: "The games kept changing after 1983",
    caption:
      "Release years establish the sequence, not the exact year each cabinet reached one particular arcade. The personal line is memory; the dated line is documented game history.",
    transcript: [
      "1983: Dragon's Lair and Spy Hunter.",
      "1985: Gauntlet and Ghosts 'n Goblins.",
      "1986: Rampage.",
      "1988: LED Storm and Altered Beast.",
      "1991: Street Fighter II.",
      "1992: Mortal Kombat and Wolfenstein 3D.",
      "1993: Doom.",
      "The sequence moves from quarter-fed arcade spectacle toward home-computer games that could be explored and modified.",
    ],
  },
  quarters: {
    eyebrow: "Two-quarter test",
    title: "The price bought a shorter kind of possibility",
    caption:
      "This compares the remembered value proposition, not audited average play time. A skilled Dragon's Lair player could go much farther. A new player usually bought a brief timing lesson.",
    transcript: [
      "Dragon's Lair: two quarters, three lives, correct directional input inside a narrow timing window, rapid death while learning, and another two quarters to test the lesson.",
      "Two conventional credits: two separate starts, familiar controls, room for improvisation, and the possibility of sharing one credit with a friend on a multiplayer cabinet.",
      "The problem was not simply difficulty. It was the amount of play and discovery available for the same coins.",
    ],
  },
  canon: {
    eyebrow: "What got my quarters instead",
    title: "The cabinet had to let me do something",
    caption:
      "These are the remembered reasons the machines mattered to me, not universal rankings of the games.",
    transcript: [
      "Spy Hunter offered speed, steering, weapons, and a moving road.",
      "Gauntlet offered a four-player party and a dungeon that continued.",
      "Rampage offered cooperative destruction.",
      "Ghosts 'n Goblins and Altered Beast offered difficult action that still felt responsive.",
      "LED Storm became a repeated competition with a friend.",
      "The common factor was agency: movement, improvisation, competition, cooperation, or a skill that could be practiced on the current credit.",
    ],
  },
  hardware: {
    eyebrow: "The hardware shift",
    title: "The arcade stopped owning the future",
    caption:
      "The dates mark major releases and hardware eras. The personal change was gradual: the home machine became the place where play could last, deepen, and eventually become making.",
    transcript: [
      "1977: Atari's Video Computer System brings interchangeable-cartridge games into the home.",
      "1983: Dragon's Lair pairs an arcade controller and logic board with LaserDisc video.",
      "Mid-1980s: Nintendo's Entertainment System expands the home console library.",
      "1992: Wolfenstein 3D makes the PC a fast first-person game machine.",
      "1993: Doom spreads through shareware and gives players a game they can modify.",
      "The path moves from paying for a short attempt, to owning a cartridge, to exploring and altering software on a general-purpose computer.",
    ],
  },
} as const;

const figure = figures[Astro.props.kind];
---

<figure class="arcade-figure not-prose my-12 border-y border-base-800 py-6 sm:my-16 sm:py-8" data-kind={Astro.props.kind}>
  <div class="mx-auto max-w-[50rem] overflow-hidden border border-base-800 bg-[#09090d] shadow-2xl shadow-black/30">
    <header class="border-b border-base-800 p-5 sm:p-7">
      <p class="font-mono text-[10px] uppercase tracking-[.18em] text-[#ffb24e]">{figure.eyebrow}</p>
      <h3 class="mt-2 font-display text-2xl font-light text-white sm:text-3xl">{figure.title}</h3>
    </header>

    {Astro.props.kind === "timeline" && (
      <ol class="timeline p-5 sm:p-7" aria-label="Arcade and home game timeline">
        {[
          ["1983", "Dragon's Lair", "Spy Hunter"],
          ["1985", "Gauntlet", "Ghosts 'n Goblins"],
          ["1986", "Rampage"],
          ["1988", "LED Storm", "Altered Beast"],
          ["1991", "Street Fighter II"],
          ["1992", "Mortal Kombat", "Wolfenstein 3D"],
          ["1993", "Doom"],
        ].map(([year, ...games]) => (
          <li><time>{year}</time><span>{games.join(" • ")}</span></li>
        ))}
      </ol>
    )}

    {Astro.props.kind === "quarters" && (
      <div class="grid gap-px bg-base-800 sm:grid-cols-2">
        <section class="lane warm">
          <p class="lane-label">One Dragon's Lair credit</p>
          <div class="coins" aria-label="Two quarters"><i>25¢</i><i>25¢</i></div>
          <ul><li>Three lives</li><li>Narrow timing windows</li><li>Learn by dying</li><li>Pay again to test memory</li></ul>
          <strong>Brief access to the cartoon</strong>
        </section>
        <section class="lane cyan">
          <p class="lane-label">Two conventional credits</p>
          <div class="coins" aria-label="Two quarters"><i>25¢</i><i>25¢</i></div>
          <ul><li>Two separate starts</li><li>Continuous control</li><li>Room to improvise</li><li>Possible turn for a friend</li></ul>
          <strong>More chances to play</strong>
        </section>
      </div>
    )}

    {Astro.props.kind === "canon" && (
      <div class="canon-grid p-5 sm:p-7">
        {[
          ["Spy Hunter", "Drive • evade • fire"],
          ["Gauntlet", "Four players • one dungeon"],
          ["Rampage", "Climb • smash • cooperate"],
          ["Ghosts 'n Goblins", "Run • jump • survive"],
          ["Altered Beast", "Fight • transform • advance"],
          ["LED Storm", "Race • repeat • compete"],
        ].map(([game, verbs], index) => (
          <div class="game-card"><span>{String(index + 1).padStart(2, "0")}</span><strong>{game}</strong><small>{verbs}</small></div>
        ))}
      </div>
    )}

    {Astro.props.kind === "hardware" && (
      <div class="hardware p-5 sm:p-7">
        <div class="hardware-step"><span>1977</span><strong>Atari VCS</strong><small>Games come home</small></div>
        <b aria-hidden="true">→</b>
        <div class="hardware-step warm"><span>1983</span><strong>LaserDisc arcade</strong><small>Theater enters the cabinet</small></div>
        <b aria-hidden="true">→</b>
        <div class="hardware-step"><span>mid-1980s</span><strong>NES</strong><small>The library expands</small></div>
        <b aria-hidden="true">→</b>
        <div class="hardware-step cyan"><span>1992–93</span><strong>Home PC</strong><small>Play becomes modification</small></div>
      </div>
    )}
  </div>

  <figcaption class="mx-auto mt-4 max-w-[50rem] text-sm leading-relaxed text-base-300">{figure.caption}</figcaption>
  <details class="mx-auto mt-4 max-w-[50rem] border border-base-800 bg-base-950/60 p-4 text-sm text-base-300">
    <summary class="cursor-pointer font-mono text-[10px] uppercase tracking-wider text-accent-cyan focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-cyan">Read the graphic transcript</summary>
    <ul class="mt-3 space-y-2 pl-5 leading-relaxed">{figure.transcript.map((line: string) => <li>{line}</li>)}</ul>
  </details>
</figure>

<style>
  .timeline { display: grid; margin: 0; list-style: none; }
  .timeline li { display: grid; grid-template-columns: 5rem 1fr; gap: 1rem; border-left: 2px solid #3f3b45; padding: .45rem 0 1.25rem 1.25rem; position: relative; }
  .timeline li::before { content: ""; position: absolute; width: .7rem; height: .7rem; border-radius: 50%; background: #ffb24e; left: -.42rem; top: .72rem; box-shadow: 0 0 18px rgb(255 178 78 / .45); }
  .timeline time { color: #ffb24e; font: 600 .7rem var(--font-mono); letter-spacing: .12em; }
  .timeline span { color: #e7e3ea; font-size: .83rem; }
  .lane { background: #09090d; padding: 1.5rem; }
  .lane-label { color: #a9a2af; font: 600 .65rem var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
  .lane ul { margin: 1rem 0 1.25rem; padding-left: 1.1rem; color: #d5d0d9; font-size: .8rem; line-height: 1.75; }
  .lane strong { display: block; border: 1px solid #6d552f; color: #ffc671; padding: .75rem; font: 600 .67rem var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .lane.cyan strong { border-color: #245e70; color: #7ee5ff; }
  .coins { display: flex; gap: .55rem; margin-top: 1.1rem; }
  .coins i { display: grid; place-items: center; width: 3.2rem; height: 3.2rem; border: 2px solid #ffb24e; border-radius: 50%; color: #ffcf83; font: 600 .7rem var(--font-mono); font-style: normal; }
  .lane.cyan .coins i { border-color: #55d7ff; color: #8ae9ff; }
  .canon-grid { display: grid; gap: .7rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .game-card { display: grid; grid-template-columns: 2.4rem 1fr; gap: .18rem .8rem; border: 1px solid #3e3944; background: #121117; padding: .9rem; }
  .game-card span { grid-row: 1 / 3; color: #ffb24e; font: 600 .62rem var(--font-mono); }
  .game-card strong { color: #f4f1f5; font-size: .85rem; }
  .game-card small { color: #918a98; font: 500 .61rem var(--font-mono); letter-spacing: .04em; }
  .hardware { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr; align-items: center; gap: .6rem; }
  .hardware > b { color: #5c5662; font-weight: 400; }
  .hardware-step { min-height: 8.3rem; border: 1px solid #3e3944; background: #121117; padding: .9rem; display: flex; flex-direction: column; justify-content: center; }
  .hardware-step span { color: #918a98; font: 600 .58rem var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .hardware-step strong { margin-top: .55rem; color: #f4f1f5; font-size: .8rem; }
  .hardware-step small { margin-top: .4rem; color: #aaa3b0; font-size: .68rem; line-height: 1.45; }
  .hardware-step.warm { border-color: #8b6231; }
  .hardware-step.cyan { border-color: #2c7188; }
  @media (max-width: 680px) { .hardware { grid-template-columns: 1fr; } .hardware > b { transform: rotate(90deg); text-align: center; } }
  @media (max-width: 480px) { .canon-grid { grid-template-columns: 1fr; } .timeline li { grid-template-columns: 3.7rem 1fr; } }
  @media (prefers-reduced-motion: reduce) { .arcade-figure * { scroll-behavior: auto; transition-duration: .01ms !important; } }
</style>
