---
type MediaKind = "gpk" | "alien-chef" | "corrupted-cake" | "corrupted-critter";

interface Props {
  kind: MediaKind;
}

const { kind } = Astro.props;
const root = "/articles/i-stopped-writing-prompts-and-built-a-machine-instead";

const media = {
  "alien-chef": {
    base: "alien-chef",
    alt: "A green alien pastry chef with purple hair, a tall white chef hat, and a pastry bag decorating a pink cake in a pastel bakery.",
    caption: "This was a Character pull, not a Cake pull. Chef role logic, a pastry-bag prop, and a cake-piping action created the cake context.",
  },
  "corrupted-cake": {
    base: "corrupted-cake",
    alt: "A square cream-colored cake with dark ganache drips, raspberries, lemon slices, a large ivory sugar bow, black flowers, mushrooms, and toxic green underlighting in a dark patisserie.",
    caption: "The Corrupted Cake stays legible as confectionery. Fungus bloom, controlled ganache drips, thorn-like sugar flowers, and toxic underglow came from form-specific treatment nodes.",
  },
  "corrupted-critter": {
    base: "corrupted-critter-cat",
    alt: "A cheerful blue-gray domestic cat with extra blue eyes and a long curled tail covered in dark organic growths and blue mushrooms against a luminous blue background.",
    caption: "The Critter selected mushrooms from its own motif node. Corrupted supplied distortion, sheen, lighting, atmosphere, and the heavier painted treatment.",
  },
} as const;

const selected = kind === "gpk" ? undefined : media[kind];
---

{kind === "gpk" ? (
  <figure class="article-wide gpk-reference">
    <div class="gpk-grid">
      <img
        src={`${root}/gpk-shrunken-ed-cheeky-charles.webp`}
        alt="Two Garbage Pail Kids cards using the same swollen-cheek character artwork with the names Shrunken Ed and Cheeky Charles."
        width="514"
        height="354"
        loading="lazy"
        decoding="async"
      />
      <img
        src={`${root}/gpk-hot-scott-luke-warm.webp`}
        alt="Two Garbage Pail Kids cards using the same small red devil artwork with the names Hot Scott and Luke Warm."
        width="509"
        height="350"
        loading="lazy"
        decoding="async"
      />
      <img
        src={`${root}/gpk-spacey-stacy-janet-planet.webp`}
        alt="Two Garbage Pail Kids cards using the same multi-eyed alien character artwork with the names Spacey Stacy and Janet Planet."
        width="514"
        height="354"
        loading="lazy"
        decoding="async"
      />
    </div>
    <figcaption>
      Three A/B name pairs from Garbage Pail Kids Original Series 2. Artwork credited to John Pound; Garbage Pail Kids and card design belong to Topps. Small reference images reproduced for commentary from the <a href="https://geepeekay.com/gallery_os2.html">GeePeeKay OS2 gallery</a>.
    </figcaption>
  </figure>
) : selected ? (
  <figure class="article-wide article-compact ezize-render">
    <picture>
      <source
        srcset={`${root}/${selected.base}-640.webp 640w, ${root}/${selected.base}-1000.webp 1000w`}
        sizes="(min-width: 48rem) 28rem, 82vw"
      />
      <img
        src={`${root}/${selected.base}-1000.webp`}
        alt={selected.alt}
        width="1000"
        height="1500"
        loading="lazy"
        decoding="async"
        data-lightbox
      />
    </picture>
    <figcaption>
      {selected.caption} Generated by the EZIZE development machine, HobFarm, using OpenAI image rendering from a deterministic EZIZE genome.
    </figcaption>
  </figure>
) : null}

<style>
  .gpk-reference,
  .ezize-render {
    gap: 0.75rem;
  }

  .gpk-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
    align-items: center;
  }

  .gpk-grid img,
  .ezize-render img,
  .ezize-render picture {
    display: block;
    width: 100%;
    height: auto;
  }

  .gpk-grid img {
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    background: #111;
  }

  .ezize-render img {
    border: 1px solid #3d3544;
    background: #08070a;
  }

  figcaption a {
    color: var(--color-accent-cyan, #55d7ff);
  }

  @media (max-width: 639px) {
    .gpk-grid {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
  }
</style>
