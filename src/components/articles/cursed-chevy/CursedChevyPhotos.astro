---
interface PhotoItem {
  file: string;
  alt: string;
  caption: string;
  width: number;
  height: number;
}

interface Props {
  label: string;
  items: PhotoItem[];
}

const { label, items } = Astro.props;
const cdnBase = "https://cdn.hob.farm/";
const assetBase = "articles/cursed-chevy";
const originalUrl = (file: string) => `${cdnBase}${assetBase}/${encodeURIComponent(file)}`;
const transformedUrl = (file: string, width: number) =>
  `${cdnBase}cdn-cgi/image/format=auto,quality=84,width=${width}/${assetBase}/${encodeURIComponent(file)}`;
const widthsFor = (item: PhotoItem) =>
  [480, 800, 1200, 1600, 2000].filter((width) => width <= item.width);
const isPair = items.length === 2;
---

<section
  class:list={["chevy-photos", "article-wide", "not-prose", isPair && "is-pair"]}
  aria-label={label}
>
  {items.map((item) => {
    const widths = widthsFor(item);
    const fallbackWidth = widths.at(-1) ?? item.width;
    const full = originalUrl(item.file);
    const srcset = widths
      .map((width) => `${transformedUrl(item.file, width)} ${width}w`)
      .join(", ");

    return (
      <figure>
        <img
          src={transformedUrl(item.file, fallbackWidth)}
          srcset={srcset || undefined}
          sizes={isPair ? "(min-width: 768px) 21rem, 92vw" : "(min-width: 768px) 42rem, 92vw"}
          alt={item.alt}
          width={item.width}
          height={item.height}
          loading="lazy"
          decoding="async"
          data-lightbox={full}
          data-lightbox-group="cursed-chevy"
          data-lightbox-caption={`${item.caption} Photograph by d00d.`}
        />
        <figcaption>
          <span>{item.caption}</span>
          <small>Photograph by d00d</small>
        </figcaption>
      </figure>
    );
  })}
</section>

<style>
  .chevy-photos {
    display: grid;
    gap: 1rem;
    margin-block: 2.75rem !important;
  }

  .chevy-photos.is-pair {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  figure {
    min-width: 0;
    margin: 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 !important;
    border: 1px solid rgb(130 71 255 / 0.3);
    border-radius: 0.45rem;
    background: #07080d;
    box-shadow: 0.45rem 0.55rem 0 rgb(0 0 0 / 0.28);
    cursor: zoom-in;
  }

  figcaption {
    display: grid;
    gap: 0.3rem;
    margin-top: 0.7rem;
    color: #c8c3d4;
    font-size: 0.8rem;
    line-height: 1.5;
    text-align: left;
  }

  small {
    color: #8f8b98;
    font: 600 0.65rem/1.4 var(--font-mono, monospace);
  }

  @media (max-width: 47rem) {
    .chevy-photos.is-pair {
      grid-template-columns: 1fr;
    }
  }
</style>
