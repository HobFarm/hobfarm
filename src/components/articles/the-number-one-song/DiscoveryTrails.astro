---
import trailData from "@/data/the-number-one-song-discovery-trails.json";
---

<figure class="article-wide discovery-trails not-prose" aria-labelledby="trails-title trails-caption">
  <div class="discovery-trails__frame">
    <header>
      <p>PERSONAL LISTENING RECEIPT</p>
      <h3 id="trails-title">The trail matters more than the ranking</h3>
    </header>
    <ol>
      {trailData.trails.map((trail, trailIndex) => (
        <li class={`discovery-trails__trail discovery-trails__trail--${trailIndex + 1}`}>
          <div class="discovery-trails__heading">
            <span>PATH 0{trailIndex + 1}</span>
            <h4>{trail.title}</h4>
          </div>
          <ol aria-label={trail.title}>
            {trail.nodes.map((node, nodeIndex) => (
              <li>
                <span>{node}</span>
                {nodeIndex < trail.nodes.length - 1 && <b aria-hidden="true">→</b>}
              </li>
            ))}
          </ol>
          <p>{trail.confidence}</p>
        </li>
      ))}
    </ol>
  </div>
  <figcaption id="trails-caption">{trailData.notice} The sequence records the author's memory and supplied screenshots.</figcaption>
</figure>

<style>
  .discovery-trails {
    margin-block: 2.8rem !important;
  }

  .discovery-trails__frame {
    padding: clamp(1rem, 3vw, 1.6rem);
    border: 1px solid rgb(118 194 188 / 0.35);
    border-radius: 0.5rem;
    background:
      linear-gradient(rgb(255 255 255 / 0.025) 1px, transparent 1px) 0 0 / 100% 1.65rem,
      #071517;
    box-shadow: 0.65rem 0.8rem 0 #020809;
  }

  header {
    margin-bottom: 1rem;
    text-align: left;
  }

  header p,
  header h3 {
    margin: 0 !important;
  }

  header p {
    color: #e1654b;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  header h3 {
    margin-top: 0.2rem !important;
    color: #f1e7d1;
    font-size: clamp(1.2rem, 3vw, 1.75rem) !important;
  }

  .discovery-trails__frame > ol {
    display: grid;
    gap: 0.85rem;
    margin: 0 !important;
    padding: 0 !important;
    list-style: none;
  }

  .discovery-trails__trail {
    margin: 0 !important;
    padding: 0.9rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-left: 0.35rem solid var(--trail-color);
    background: rgb(2 8 9 / 0.82);
    text-align: left;
  }

  .discovery-trails__trail--1 { --trail-color: #d5a74e; }
  .discovery-trails__trail--2 { --trail-color: #67b9b4; }
  .discovery-trails__trail--3 { --trail-color: #e1654b; }

  .discovery-trails__heading {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 0.65rem;
    align-items: baseline;
  }

  .discovery-trails__heading span {
    color: var(--trail-color);
    font-family: var(--font-mono);
    font-size: 0.59rem;
    font-weight: 800;
  }

  .discovery-trails__heading h4 {
    margin: 0 !important;
    color: #f4eee2;
    font-size: 0.92rem;
  }

  .discovery-trails__trail ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.7rem 0 !important;
    padding: 0 !important;
    list-style: none;
  }

  .discovery-trails__trail ol li {
    display: flex;
    gap: 0.35rem;
    align-items: center;
    margin: 0 !important;
  }

  .discovery-trails__trail ol span {
    padding: 0.38rem 0.48rem;
    border: 1px solid color-mix(in srgb, var(--trail-color) 45%, transparent);
    background: color-mix(in srgb, var(--trail-color) 8%, transparent);
    color: #ddd6ca;
    font-size: 0.68rem;
    line-height: 1.35;
  }

  .discovery-trails__trail ol b {
    color: var(--trail-color);
    font-weight: 400;
  }

  .discovery-trails__trail > p {
    margin: 0 !important;
    color: #8f9998;
    font-family: var(--font-mono);
    font-size: 0.57rem;
    line-height: 1.45;
    text-transform: uppercase;
  }

  @media (max-width: 560px) {
    .discovery-trails__heading {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .discovery-trails__trail ol {
      display: grid;
    }

    .discovery-trails__trail ol li {
      display: grid;
      grid-template-columns: 1fr;
    }

    .discovery-trails__trail ol b {
      transform: rotate(90deg);
      transform-origin: 0.6rem center;
    }
  }
</style>
