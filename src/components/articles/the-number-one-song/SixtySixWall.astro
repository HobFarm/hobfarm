---
const songs = [
  { title: "These Boots Are Made for Walkin'", artist: "Nancy Sinatra", peak: 1, url: "https://www.officialcharts.com/artist/12263/nancy-sinatra/" },
  { title: "Wild Thing", artist: "The Troggs", peak: 2, url: "https://www.officialcharts.com/songs/troggs-wild-thing/" },
  { title: "Paint It, Black", artist: "The Rolling Stones", peak: 1, url: "https://www.officialcharts.com/artist/28195/rolling-stones/" },
  { title: "Monday Monday", artist: "The Mamas & the Papas", peak: 3, url: "https://www.officialcharts.com/charts/singles-chart/19660630/7501/" },
  { title: "When a Man Loves a Woman", artist: "Percy Sledge", peak: 4, url: "https://www.officialcharts.com/songs/percy-sledge-when-a-man-loves-a-woman/" },
  { title: "Paperback Writer", artist: "The Beatles", peak: 1, url: "https://www.officialcharts.com/songs/the-beatles-paperback-writer/" },
  { title: "Sunny Afternoon", artist: "The Kinks", peak: 1, url: "https://www.officialcharts.com/charts/singles-chart/19660804/7501/" },
  { title: "River Deep, Mountain High", artist: "Ike & Tina Turner", peak: 3, url: "https://www.officialcharts.com/songs/ike-and-tina-turner-river-deep-mountain-high/" },
  { title: "God Only Knows", artist: "The Beach Boys", peak: 2, url: "https://www.officialcharts.com/songs/beach-boys-god-only-knows/" },
  { title: "Yellow Submarine / Eleanor Rigby", artist: "The Beatles", peak: 1, url: "https://www.officialcharts.com/songs/the-beatles-yellow-submarineeleanor-rigby/" },
  { title: "Summer in the City", artist: "The Lovin' Spoonful", peak: 8, url: "https://www.officialcharts.com/songs/lovin-spoonful-summer-in-the-city/" },
  { title: "You Can't Hurry Love", artist: "The Supremes", peak: 3, url: "https://www.officialcharts.com/songs/supremes-you-cant-hurry-love/" },
  { title: "Reach Out I'll Be There", artist: "Four Tops", peak: 1, url: "https://www.officialcharts.com/songs/four-tops-reach-out-ill-be-there/" },
  { title: "Good Vibrations", artist: "The Beach Boys", peak: 1, url: "https://www.officialcharts.com/songs/beach-boys-good-vibrations/" },
  { title: "Gimme Some Loving", artist: "The Spencer Davis Group", peak: 2, url: "https://www.officialcharts.com/charts/singles-chart/19661222/7501/" },
];
---

<figure class="article-wide sixty-six-wall not-prose" aria-labelledby="sixty-six-title sixty-six-caption">
  <div class="sixty-six-wall__paper">
    <header>
      <p>UK TOP-TEN ENTRIES · 1966</p>
      <h3 id="sixty-six-title">I wasn't alive yet. I know every one.</h3>
    </header>
    <ol>
      {songs.map((song, index) => (
        <li>
          <a href={song.url} target="_blank" rel="noreferrer">
            <span class="sixty-six-wall__number">{String(index + 1).padStart(2, "0")}</span>
            <strong>{song.title}</strong>
            <span>{song.artist} · peak {song.peak}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
  <figcaption id="sixty-six-caption">
    Each displayed title and peak was checked against Official Charts on August 6, 2026. “Yellow Submarine” and “Eleanor Rigby” were one double A-side chart entry.
  </figcaption>
</figure>

<style>
  .sixty-six-wall {
    margin-block: 2.8rem !important;
  }

  .sixty-six-wall__paper {
    position: relative;
    overflow: hidden;
    padding: clamp(1rem, 4vw, 2.2rem);
    border: 1px solid #312d24;
    border-radius: 0.25rem;
    background:
      radial-gradient(circle at 17% 21%, rgb(177 52 36 / 0.13) 0 1px, transparent 1.5px) 0 0 / 9px 9px,
      linear-gradient(104deg, #ebe0c6, #d7c9aa 58%, #eee2c8);
    box-shadow: 0.65rem 0.8rem 0 #08070a;
    color: #17130f;
  }

  .sixty-six-wall__paper::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(123 35 28 / 0.07), transparent 42%, rgb(19 67 74 / 0.08));
    content: "";
    pointer-events: none;
  }

  header {
    position: relative;
    z-index: 1;
    margin-bottom: 1.2rem;
    border-bottom: 0.42rem solid #b53d2d;
  }

  header p,
  header h3 {
    margin: 0 !important;
    color: inherit;
  }

  header p {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  header h3 {
    padding: 0.2rem 0 0.55rem;
    font-family: var(--font-display, sans-serif);
    font-size: clamp(1.35rem, 4vw, 2.35rem) !important;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  ol {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0 !important;
    padding: 0 !important;
    list-style: none;
  }

  li {
    margin: 0 !important;
  }

  a {
    display: grid;
    grid-template-columns: 2rem 1fr;
    padding: 0.6rem;
    border: 1px solid rgb(23 19 15 / 0.23);
    background: rgb(250 245 231 / 0.44);
    color: inherit !important;
    text-decoration: none !important;
    transition: background 150ms ease, transform 150ms ease;
  }

  a:hover,
  a:focus-visible {
    background: rgb(255 252 240 / 0.8);
    transform: translateY(-1px);
  }

  .sixty-six-wall__number {
    grid-row: span 2;
    color: #b53d2d;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
  }

  strong {
    font-size: 0.76rem;
    line-height: 1.15;
    text-transform: uppercase;
  }

  a span:last-child {
    margin-top: 0.25rem;
    color: #594f42;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    line-height: 1.3;
  }

  @media (max-width: 560px) {
    ol {
      grid-template-columns: 1fr;
    }
  }
</style>
