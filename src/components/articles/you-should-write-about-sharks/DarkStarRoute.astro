---
const steps = [
  "Shark",
  "Panic",
  "Mondo",
  "Corman",
  "Jaws",
  "Franchises",
  "Indie film",
  "Tracked shark",
  "Shark",
];
---

<figure class="route-map article-wide not-prose">
  <div class="route-map__canvas">
    <svg viewBox="0 0 960 520" role="img" aria-labelledby="route-title route-description">
      <title id="route-title">The Dark Star route through Sharksploitation</title>
      <desc id="route-description">A shark theme leaves its starting point, travels through panic, mondo films, Corman, Jaws, franchises, independent film, and tracking, then returns to a real shark.</desc>
      <defs>
        <filter id="paper-shadow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="5" dy="7" stdDeviation="0" flood-color="#02090b" flood-opacity="0.72" />
        </filter>
        <marker id="route-arrow" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto">
          <path d="M0 0 10 5 0 10Z" fill="#ee6b46" />
        </marker>
      </defs>

      <rect width="960" height="520" rx="20" fill="#06161a" />
      <path
        d="M100 255 C150 120 220 88 300 150 S405 225 455 115 S580 90 610 205 S790 70 838 160 S850 332 730 352 S530 430 420 360 S250 330 122 260"
        fill="none"
        stroke="#ee6b46"
        stroke-width="4"
        stroke-dasharray="7 11"
        marker-end="url(#route-arrow)"
      />
      <path d="M318 161 C285 235 267 272 210 305" fill="none" stroke="#77a7b1" stroke-width="2" stroke-dasharray="4 8" />
      <path d="M638 190 C705 236 725 260 748 302" fill="none" stroke="#77a7b1" stroke-width="2" stroke-dasharray="4 8" />

      {[
        [70, 225, "SHARK"],
        [165, 74, "PANIC"],
        [280, 128, "MONDO"],
        [414, 58, "CORMAN"],
        [562, 174, "JAWS"],
        [704, 66, "FRANCHISES"],
        [790, 224, "INDIE FILM"],
        [610, 338, "TRACKED SHARK"],
        [278, 344, "SHARK"],
      ].map(([x, y, label], index) => (
        <g transform={`translate(${x} ${y}) rotate(${index % 2 === 0 ? -2 : 2})`} filter="url(#paper-shadow)">
          <rect width={label === "TRACKED SHARK" ? 164 : label === "FRANCHISES" ? 142 : 116} height="58" rx="4" fill={index === 0 || index === 8 ? "#d9d0bc" : "#0d3038"} stroke="#77a7b1" stroke-opacity="0.68" />
          <text x="14" y="35" fill={index === 0 || index === 8 ? "#0b2025" : "#f5efe3"} font-size="15" font-weight="750" letter-spacing="1.2">{label}</text>
        </g>
      ))}

      <g transform="translate(146 300) rotate(-4)">
        <rect width="126" height="42" rx="3" fill="#152a30" stroke="#77a7b1" stroke-opacity="0.42" />
        <text x="12" y="26" fill="#9fb4b8" font-size="12" letter-spacing="1">LATER SHOCK</text>
      </g>
      <g transform="translate(714 292) rotate(3)">
        <rect width="134" height="42" rx="3" fill="#152a30" stroke="#77a7b1" stroke-opacity="0.42" />
        <text x="12" y="26" fill="#9fb4b8" font-size="12" letter-spacing="1">SHARKNADO</text>
      </g>
    </svg>
  </div>

  <ol class="route-map__mobile" aria-label="The Sharksploitation detour and return">
    {steps.map((step, index) => (
      <li>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <strong>{step}</strong>
      </li>
    ))}
  </ol>

  <figcaption><strong>The Dark Star method.</strong> The route leaves the shark, discovers an argument, and returns to the shark with a different meaning.</figcaption>
</figure>

<style>
  .route-map {
    margin-block: 3rem;
  }

  .route-map__canvas {
    overflow: hidden;
    border: 1px solid rgb(119 167 177 / 0.38);
    border-radius: 0.7rem;
    background: #06161a;
    box-shadow: 0.65rem 0.75rem 0 rgb(2 9 11 / 0.7);
  }

  .route-map svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .route-map__mobile {
    display: none;
  }

  .route-map figcaption {
    margin-top: 0.9rem;
    color: var(--color-base-400, #a1a1a1);
    font-size: 0.82rem;
  }

  .route-map figcaption strong {
    color: #ee6b46;
  }

  @media (max-width: 720px) {
    .route-map__canvas {
      display: none;
    }

    .route-map__mobile {
      display: grid;
      gap: 0.4rem;
      margin: 0;
      padding: 0.65rem;
      border: 1px solid rgb(119 167 177 / 0.38);
      border-radius: 0.7rem;
      background: #06161a;
      list-style: none;
    }

    .route-map__mobile li {
      display: grid;
      grid-template-columns: 2.2rem 1fr;
      gap: 0.65rem;
      align-items: center;
      padding: 0.72rem;
      border-left: 3px solid #ee6b46;
      background: #0d3038;
    }

    .route-map__mobile span {
      color: #ee6b46;
      font-family: var(--font-mono);
      font-size: 0.72rem;
    }

    .route-map__mobile strong {
      color: #f5efe3;
      font-size: 0.9rem;
      text-transform: uppercase;
    }
  }
</style>
