---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

interface Props {
  heading?: string;
  description?: string;
}

const {
  heading = "Get new articles and visual notes",
  description = "Subscribe for new HobFarm features, gallery notes, studio updates, and work-in-progress dispatches.",
} = Astro.props;
---

<section>
  <Wrapper
    variant="standard"
    class="py-12 relative grid grid-cols-1 md:grid-cols-4"
  >
    <div
      class="md:col-span-2 md:col-start-2"
      data-subscribe-root
    >
      <h2
        class="mt-12 text-3xl lg:text-4xl text-base-100 text-balance font-display"
      >
        {heading}
      </h2>
      <p class="text-base-300 mt-2 text-balance leading-relaxed">
        {description}
      </p>

      <div data-success hidden class="mt-12">
        <div class="flex items-start gap-3 p-4 border border-accent-500/30 bg-accent-500/5">
          <svg class="size-5 text-accent-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div>
            <p data-success-message class="text-base-100 font-medium text-sm"></p>
            <p class="text-base-400 text-xs mt-1">Check your spam folder if you don't see it.</p>
          </div>
        </div>
      </div>

      <form data-subscribe-form class="mt-12">
        <div class="flex flex-col gap-y-4">
          <div data-error hidden>
            <p data-error-message class="text-sm text-accent-500"></p>
          </div>

          <input
            type="text"
            name="website"
            class="hidden"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="flex flex-col-reverse relative">
            <input
              id="email"
              name="email"
              type="email"
              placeholder="Your email"
              autocomplete="email"
              required
              class="peer relative placeholder:duration-500 placeholder:absolute focus:placeholder:pt-10 block w-full px-3 py-3 border-l border-l-base-100 border-transparent appearance-none text-base-100 bg-base-900 focus:border-base-100 focus:bg-base-950 focus:outline-none duration-300 focus:ring-base-100 sm:text-sm placeholder-base-500 h-14 focus:placeholder:text-transparent z-10 disabled:opacity-50"
            />
            <label
              for="email"
              class="duration-500 opacity-0 mb-1 peer-focus:opacity-100 text-base-500 text-xs -translate-y-12 peer-focus:translate-y-0 after:ml-0.5 after:text-accent-500 after:content-['*'] z-0"
            >
              Email
            </label>
          </div>
          <div class="flex">
            <button
              data-submit
              type="submit"
              class="px-6 py-3 text-sm font-medium text-base-100 bg-base-900 border border-base-700 hover:border-base-100 transition-colors duration-300 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span data-submit-idle>Subscribe</span>
              <span data-submit-loading hidden class="flex items-center gap-2">
                <svg class="size-4 animate-spin" viewBox="0 0 24 24" fill="none">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                </svg>
                Subscribing...
              </span>
            </button>
          </div>
        </div>
      </form>
    </div>
  </Wrapper>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-subscribe-root]");
  if (root) {
    const form = root.querySelector<HTMLFormElement>("[data-subscribe-form]");
    const successBlock = root.querySelector<HTMLElement>("[data-success]");
    const successMsg = root.querySelector<HTMLElement>("[data-success-message]");
    const errorBlock = root.querySelector<HTMLElement>("[data-error]");
    const errorMsg = root.querySelector<HTMLElement>("[data-error-message]");
    const submitBtn = root.querySelector<HTMLButtonElement>("[data-submit]");
    const submitIdle = root.querySelector<HTMLElement>("[data-submit-idle]");
    const submitLoading = root.querySelector<HTMLElement>("[data-submit-loading]");

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (
        !form ||
        !errorBlock ||
        !errorMsg ||
        !successBlock ||
        !successMsg ||
        !submitBtn ||
        !submitIdle ||
        !submitLoading
      ) {
        return;
      }

      submitBtn.disabled = true;
      submitIdle.hidden = true;
      submitLoading.hidden = false;
      errorBlock.hidden = true;
      errorMsg.textContent = "";

      const formData = new FormData(form);

      try {
        const res = await fetch("/api/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: String(formData.get("email") || ""),
            website: String(formData.get("website") || ""),
          }),
        });

        const data = (await res.json().catch(() => ({}))) as {
          success?: boolean;
          message?: string;
          error?: string;
        };

        if (res.ok && data.success) {
          form.hidden = true;
          successBlock.hidden = false;
          successMsg.textContent = data.message || "Subscribed.";
        } else {
          errorBlock.hidden = false;
          errorMsg.textContent =
            data.error || "Something went wrong. Please try again.";
        }
      } catch {
        errorBlock.hidden = false;
        errorMsg.textContent = "Network error. Please try again.";
      } finally {
        submitBtn.disabled = false;
        submitIdle.hidden = false;
        submitLoading.hidden = true;
      }
    });
  }
</script>
