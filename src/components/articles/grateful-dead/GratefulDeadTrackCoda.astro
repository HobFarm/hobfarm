---
const spotifyId = "5RsgqNZdtk0k0KufMi9AgK";
const spotifyUrl = `https://open.spotify.com/track/${spotifyId}`;
---

<aside class="dead-track-coda article-wide not-prose" aria-labelledby="dead-track-coda-title">
  <div class="dead-track-coda__copy">
    <span>A new transmission</span>
    <h3 id="dead-track-coda-title">Althea (Deep Funk Edit)</h3>
    <p>The Polish Ambassador · Dead Polish · September 2, 2026</p>
    <small>A Grateful Dead song crosses into a neighboring electronic-festival scene, then arrives through the feed while this article is being written.</small>
    <a href={spotifyUrl} target="_blank" rel="noopener noreferrer">
      Open exact track in Spotify <span aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="dead-track-coda__player" data-dead-track data-spotify-id={spotifyId}>
    <button type="button" data-spotify-load aria-label="Load Spotify player for Althea (Deep Funk Edit) by The Polish Ambassador and Dead Polish">
      <span aria-hidden="true">♫</span>
      Load Spotify track
    </button>
  </div>
  <p class="sr-only" aria-live="polite" data-spotify-status></p>
</aside>

<script>
  function installDeadSpotifyTrack() {
    document.querySelectorAll<HTMLElement>("[data-dead-track]").forEach((slot) => {
      const button = slot.querySelector<HTMLButtonElement>("[data-spotify-load]");
      const status = slot.parentElement?.querySelector<HTMLElement>("[data-spotify-status]");
      if (!button || button.dataset.ready === "true") return;
      button.dataset.ready = "true";

      button.addEventListener("click", () => {
        const spotifyId = slot.dataset.spotifyId;
        if (!spotifyId) return;

        const iframe = document.createElement("iframe");
        iframe.src = `https://open.spotify.com/embed/track/${encodeURIComponent(spotifyId)}?utm_source=generator&theme=0`;
        iframe.title = button.getAttribute("aria-label")?.replace(/^Load /, "") ?? "Spotify track";
        iframe.loading = "lazy";
        iframe.allow = "autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture";
        iframe.referrerPolicy = "strict-origin-when-cross-origin";
        iframe.addEventListener("load", () => {
          if (status) status.textContent = `${iframe.title} loaded.`;
          iframe.focus();
        });

        slot.replaceChildren(iframe);
        if (status) status.textContent = `Loading ${iframe.title}.`;
      }, { once: true });
    });
  }

  installDeadSpotifyTrack();
  document.addEventListener("astro:page-load", installDeadSpotifyTrack);
</script>

<style>
  .dead-track-coda {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 1fr);
    gap: 1rem;
    margin-block: 2.7rem !important;
    padding: 1rem;
    overflow: hidden;
    color: #aaa4b1;
    border: 1px solid rgb(115 228 219 / 0.34);
    border-radius: 0.38rem;
    background: linear-gradient(120deg, rgb(208 54 214 / 0.16), transparent 58%), #07070c;
    box-shadow: 0.7rem 0.75rem 0 rgb(41 10 55 / 0.25);
  }

  .dead-track-coda__copy {
    display: grid;
    align-content: center;
    gap: 0.35rem;
  }

  .dead-track-coda__copy > span {
    color: #73e4db;
    font: 700 0.63rem/1.3 var(--font-mono), monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h3,
  p,
  small {
    margin: 0 !important;
  }

  h3 {
    color: #fff;
    font-size: 1.05rem;
  }

  p,
  small {
    font-size: 0.72rem;
    line-height: 1.55;
  }

  a {
    margin-top: 0.4rem;
    color: #65e88f !important;
    font: 700 0.66rem/1.4 var(--font-mono), monospace;
  }

  .dead-track-coda__player {
    display: grid;
    min-height: 9.5rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgb(30 215 96 / 0.28);
    border-radius: 0.7rem;
    background: linear-gradient(140deg, rgb(30 215 96 / 0.1), rgb(2 5 3 / 0.92));
  }

  .dead-track-coda__player :global(iframe) {
    display: block;
    width: 100%;
    height: 152px;
    border: 0;
  }

  button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.72rem 0.85rem;
    color: #e8f7ed;
    border: 1px solid rgb(84 235 136 / 0.72);
    border-radius: 999px;
    background: #08150c;
    font: 700 0.67rem/1 var(--font-mono), monospace;
    cursor: pointer;
  }

  button:hover,
  button:focus-visible {
    outline: 2px solid #54eb88;
    outline-offset: 2px;
  }

  @media (max-width: 39rem) {
    .dead-track-coda {
      grid-template-columns: 1fr;
    }
  }
</style>
