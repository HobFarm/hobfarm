---
const stops = [
  { time: "Sept. 10, 5:43 p.m.", place: "Comfort Inn", detail: "Atta and al-Omari check in at 90 Maine Mall Road." },
  { time: "8:00 to 9:00 p.m.", place: "Pizza Hut", detail: "Two men matching their description are reported at 415 Maine Mall Road for about fifteen minutes." },
  { time: "8:31 p.m.", place: "KeyBank ATM", detail: "A drive-up camera records them at 445 Gorham Road." },
  { time: "8:41 p.m.", place: "ATM near UNO's", detail: "Another camera records them near 280 Maine Mall Road." },
  { time: "9:15 p.m.", place: "Jetport Gas", detail: "They appear at 446 Western Avenue." },
  { time: "9:22 p.m.", place: "Walmart", detail: "Atta is recorded at 451 Payne Road in Scarborough for about twenty minutes." },
  { time: "Sept. 11, 5:33 a.m.", place: "Comfort Inn", detail: "They check out." },
  { time: "5:40 to 6:00 a.m.", place: "Portland Jetport", detail: "The rental car enters the lot; they check in, clear security, and depart for Boston at 6:00." },
];
---

<aside class="maine-timeline article-wide not-prose" aria-labelledby="maine-timeline-title">
  <header>
    <p>FBI chronology</p>
    <h2 id="maine-timeline-title">Maine Mall, September 10 to 11, 2001</h2>
    <div>The times are approximate. The sequence shows documented stops, not a complete route or an explanation for the Portland detour.</div>
  </header>
  <ol>
    {stops.map((stop) => (
      <li>
        <time>{stop.time}</time>
        <div>
          <strong>{stop.place}</strong>
          <span>{stop.detail}</span>
        </div>
      </li>
    ))}
  </ol>
  <footer>
    Source: FBI Boston Division chronology, October 5, 2001. The 9/11 Commission later said the reason for the Portland trip remained unknown.
  </footer>
</aside>

<style>
  .maine-timeline {
    overflow: hidden;
    margin-block: 2.7rem !important;
    border: 1px solid rgb(232 180 92 / 0.34);
    border-radius: 0.7rem;
    background: #0b0a08;
  }

  header {
    padding: clamp(1rem, 3vw, 1.5rem);
    border-bottom: 1px solid rgb(232 180 92 / 0.22);
    background: linear-gradient(120deg, rgb(124 73 25 / 0.38), transparent 72%);
  }

  header p,
  header h2,
  header div {
    margin: 0 !important;
  }

  header p {
    color: #f2c777 !important;
    font: 700 0.66rem/1.2 var(--font-mono), monospace !important;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  header h2 {
    margin-top: 0.35rem !important;
    color: #f4eee5 !important;
    font-size: clamp(1.3rem, 3vw, 1.9rem) !important;
  }

  header div {
    max-width: 55rem;
    margin-top: 0.55rem !important;
    color: #bfb7a9;
    font-size: 0.82rem;
    line-height: 1.55;
  }

  ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }

  li {
    display: grid;
    grid-template-columns: minmax(8rem, 0.7fr) minmax(0, 1.3fr);
    gap: 0.8rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid rgb(232 180 92 / 0.14);
  }

  li:nth-child(odd) {
    border-right: 1px solid rgb(232 180 92 / 0.14);
  }

  time {
    color: #f2c777;
    font: 700 0.7rem/1.45 var(--font-mono), monospace;
  }

  li div {
    display: grid;
    gap: 0.2rem;
  }

  strong {
    color: #f2eee7;
    font-size: 0.84rem;
  }

  li span {
    color: #aca79e;
    font-size: 0.76rem;
    line-height: 1.5;
  }

  footer {
    padding: 0.75rem 1rem 0.9rem;
    color: #8f887d;
    font-size: 0.7rem;
    line-height: 1.5;
  }

  @media (max-width: 780px) {
    ol {
      grid-template-columns: 1fr;
    }

    li:nth-child(odd) {
      border-right: 0;
    }
  }

  @media (max-width: 520px) {
    li {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
