---
import { imageSrcset, transformImageUrl } from "@/lib/media-transforms";

interface Props {
  src: string;
  alt: string;
  caption: string;
  width: number;
  height: number;
  label?: string;
  credit?: string;
  group?: string;
  position?: "contain" | "cover";
}

const {
  src,
  alt,
  caption,
  width,
  height,
  label,
  credit = "Author photograph",
  group = "2001-the-odyssey",
  position = "contain",
} = Astro.props;

const widths = [640, 960, 1280, 1600].filter((candidate) => candidate <= width);
if (!widths.includes(width) && width < 1600) widths.push(width);
---

<figure class:list={["odyssey-figure", "article-wide", "not-prose", `image-${position}`]}>
  {label && <span class="odyssey-label">{label}</span>}
  <img
    src={transformImageUrl(src, { width: Math.min(width, 1600), quality: 86, fit: position })}
    srcset={imageSrcset(src, widths, { quality: 86, fit: position })}
    sizes="(min-width: 900px) 68rem, 92vw"
    alt={alt}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
    data-lightbox={src}
    data-lightbox-group={group}
    data-lightbox-caption={`${caption} ${credit}`}
  />
  <figcaption>
    <span>{caption}</span>
    <small>{credit}</small>
  </figcaption>
</figure>

<style>
  .odyssey-figure {
    position: relative;
    overflow: hidden;
    margin-block: 2.4rem !important;
    border: 1px solid rgb(115 207 224 / 0.25);
    border-radius: 0.55rem;
    background: #05080b;
    box-shadow: 0 1.3rem 3rem rgb(0 0 0 / 0.16);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 50rem;
    margin: 0 !important;
    background: #020304;
    object-fit: contain;
  }

  .image-cover img {
    max-height: 42rem;
    object-fit: cover;
  }

  .odyssey-label {
    position: absolute;
    z-index: 1;
    top: 0.7rem;
    left: 0.7rem;
    padding: 0.27rem 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.24);
    border-radius: 999px;
    background: rgb(3 9 14 / 0.82);
    color: #d7f6fb;
    font: 700 0.64rem/1 var(--font-mono), monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(6px);
  }

  figcaption {
    display: grid;
    gap: 0.3rem;
    padding: 0.75rem 0.9rem 0.9rem;
  }

  figcaption > span {
    color: #d8dde2;
  }

  small {
    color: #89939b;
    font: 600 0.67rem/1.4 var(--font-mono), monospace;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
