---
import { editorialSeries } from "@/data/editorial-mesh";
import {
  articleUsesSeries,
  getArticleDate,
  getArticleHero,
  getPublishedArticles,
} from "@/lib/articles";
import { imageSrcset, transformImageUrl } from "@/lib/media-transforms";

interface Props {
  heading?: string;
  compact?: boolean;
  showVisuals?: boolean;
}

const { heading = "Specials", compact = false, showVisuals = false } = Astro.props;
const articles = await getPublishedArticles();
const seriesPresentation = {
  "magazine-time-machine": {
    accent: "#f0c96b",
    mark: "MTM / Archive artifact",
    visual: "https://cdn.hob.farm/hero-images/magazine-time-machine-hero.png",
  },
  "3dm": { accent: "#f24da6", mark: "3DM / Cinema connection" },
  "built-over": { accent: "#5cf0a6", mark: "Built / Place record" },
} as const;
const specials = editorialSeries.map((series) => {
  const entries = articles.filter((article) => articleUsesSeries(article.data, series.id));
  const visualArticle = entries.find((article) => Boolean(getArticleHero(article.data)));
  const presentation = seriesPresentation[series.id];
  const visual = ("visual" in presentation ? presentation.visual : undefined)
    ?? (visualArticle ? getArticleHero(visualArticle.data) : undefined);
  return {
    ...series,
    ...presentation,
    entries,
    newest: entries[0],
    visual,
    visualSrc: visual
      ? transformImageUrl(visual, { width: 900, quality: 82, fit: "cover" })
      : undefined,
    visualSrcset: visual
      ? imageSrcset(visual, [360, 540, 720, 900], { quality: 82, fit: "cover" })
      : undefined,
  };
});
---

<section class:list={["editorial-specials", compact && "editorial-specials--compact"]} aria-labelledby="editorial-specials-heading">
  <header>
    <p>Recurring editorial work</p>
    <h2 id="editorial-specials-heading">{heading}</h2>
  </header>
  <div class="editorial-specials__grid">
    {specials.map((special, index) => (
      <a href={special.href} class:list={["editorial-specials__card", showVisuals && "editorial-specials__card--visual"]} style={`--series-accent:${special.accent}`}>
        {showVisuals && (
          <div class="editorial-specials__visual">
            {special.visual ? (
              <img
                src={special.visualSrc}
                srcset={special.visualSrcset}
                sizes="(min-width: 720px) 33vw, 100vw"
                alt=""
                width="900"
                height="506"
                loading="lazy"
                fetchpriority="low"
                decoding="async"
              />
            ) : (
              <span class="editorial-specials__fallback" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            )}
            <span class="editorial-specials__mark" aria-hidden="true">{special.mark}</span>
          </div>
        )}
        <div class="editorial-specials__body">
          <span>{special.entries.length} {special.entries.length === 1 ? "entry" : "entries"}</span>
          <h3>{special.label}</h3>
          <p>{special.membershipRule}</p>
          <div class="editorial-specials__footer">
            {special.newest && (
              <small>
                Latest {getArticleDate(special.newest).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}
              </small>
            )}
            <strong>Open series &rarr;</strong>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .editorial-specials { margin-top: 4rem; }
  .editorial-specials header > p { margin: 0; color: #f24da6; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; }
  .editorial-specials header h2 { margin: .55rem 0 0; color: #fff; font-family: var(--font-display); font-size: clamp(1.75rem, 4vw, 2.7rem); font-weight: 300; }
  .editorial-specials__grid { display: grid; gap: .75rem; margin-top: 1.25rem; }
  .editorial-specials__card { display: flex; min-height: 14rem; min-width: 0; flex-direction: column; overflow: hidden; border: 1px solid #2c2440; border-top: 2px solid var(--series-accent, #f24da6); border-radius: .75rem; background: #0e0b16b8; color: inherit; text-decoration: none; }
  .editorial-specials__card:hover { border-color: var(--series-accent, #f24da6); }
  .editorial-specials__card:focus-visible { outline: 2px solid var(--series-accent, #f24da6); outline-offset: 3px; }
  .editorial-specials__body { display: flex; min-height: 14rem; flex: 1; flex-direction: column; padding: 1.25rem; }
  .editorial-specials__card span, .editorial-specials__card small { color: #8f899f; font-family: var(--font-mono); font-size: .6rem; letter-spacing: .09em; text-transform: uppercase; }
  .editorial-specials__card h3 { margin: 1rem 0 0; color: #fff; font-family: var(--font-display); font-size: 1.35rem; font-weight: 400; }
  .editorial-specials__card p { margin: .65rem 0 0; color: #aaa5ba; font-size: .8rem; line-height: 1.55; }
  .editorial-specials__footer { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: .75rem; margin-top: auto; padding-top: 1rem; }
  .editorial-specials__footer strong { color: var(--series-accent, #f24da6); font-family: var(--font-mono); font-size: .6rem; font-weight: 400; letter-spacing: .08em; text-transform: uppercase; }
  .editorial-specials__visual { position: relative; aspect-ratio: 16 / 8.5; overflow: hidden; border-bottom: 1px solid #2c2440; background: linear-gradient(135deg, color-mix(in srgb, var(--series-accent) 14%, #0e0b16), #07060b); }
  .editorial-specials__visual::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 35%, rgb(7 6 11 / 0.82)), linear-gradient(125deg, color-mix(in srgb, var(--series-accent) 12%, transparent), transparent 45%); pointer-events: none; }
  .editorial-specials__visual img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.8) contrast(1.06); transition: filter 240ms ease, transform 450ms ease; }
  .editorial-specials__fallback { position: absolute; inset: 0; display: grid; place-items: center; color: color-mix(in srgb, var(--series-accent) 45%, transparent); font-size: 4rem; }
  .editorial-specials__mark { position: absolute; z-index: 1; bottom: .8rem; left: 1rem; color: var(--series-accent) !important; font-size: .55rem !important; }
  .editorial-specials--compact .editorial-specials__card, .editorial-specials--compact .editorial-specials__body { min-height: 11rem; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .editorial-specials__card:hover .editorial-specials__visual img { filter: saturate(1) contrast(1.02); transform: scale(1.025); } }
  @media (min-width: 720px) { .editorial-specials__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (prefers-reduced-motion: reduce) { .editorial-specials__visual img { transition: none; } }
</style>
