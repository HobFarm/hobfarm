---
interface Props {
  src: string;
  alt: string;
  caption: string;
  credit?: string;
  width: number;
  height: number;
  wide?: boolean;
  eager?: boolean;
}

const {
  src,
  alt,
  caption,
  credit = "Photograph by HobFarm",
  width,
  height,
  wide = false,
  eager = false,
} = Astro.props;
---

<figure class:list={["cadillac-figure", wide && "article-wide"]}>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    data-lightbox
  />
  <figcaption>
    <span>{caption}</span>
    <span class="cadillac-credit">{credit}</span>
  </figcaption>
</figure>

<style>
  .cadillac-figure {
    margin-block: 2.4rem;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.65rem;
  }

  figcaption {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.7rem;
    color: var(--color-text-muted, #6b7280);
    font-size: 0.88rem;
    line-height: 1.48;
  }

  .cadillac-credit {
    font-size: 0.76rem;
    letter-spacing: 0.01em;
  }
</style>
