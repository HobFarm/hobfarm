---
const branches = [
  {
    number: "01",
    name: "Mike Rich",
    first: "Street practice",
    description: "Access, risk, permission, and the long stewardship of Portland's public walls.",
    later: "Graffiti and large-scale murals across a practice now spanning more than thirty years.",
    color: "cyan",
  },
  {
    number: "02",
    name: "Tim Clorius / SUBONE",
    first: "Studio translation",
    description: "Aerosol carried into canvases, workshops, commissions, and personal figurative worlds.",
    later: "Public murals, studio work, teaching, and collaborations that continue across those boundaries.",
    color: "acid",
  },
  {
    number: "03",
    name: "Eli Cayer",
    first: "Community structure",
    description: "Legal walls, screenings, events, and the practical systems that let other people participate.",
    later: "MENSK, Maine Mead Works, Urban Farm Fermentory, and the community-funded NorthStar Brewpub.",
    color: "coral",
  },
] as const;
---

<figure class="branches article-wide" aria-labelledby="branches-title">
  <figcaption>
    <p>Original documentary structure · 2004</p>
    <h3 id="branches-title">Three possible futures for the same creative scene</h3>
  </figcaption>
  <div class="branches__origin" aria-hidden="true">
    <span>PORTLAND</span>
    <i></i>
  </div>
  <div class="branches__grid">
    {branches.map((branch) => (
      <section class={`branches__card branches__card--${branch.color}`}>
        <div class="branches__head">
          <span>{branch.number}</span>
          <h4>{branch.name}</h4>
        </div>
        <p class="branches__first">{branch.first}</p>
        <p>{branch.description}</p>
        <div class="branches__later">
          <span>Public record · 2026</span>
          <p>{branch.later}</p>
        </div>
      </section>
    ))}
  </div>
  <p class="branches__note">These were lenses, not fixed roles. Each person crossed the boundaries.</p>
</figure>

<style>
  .branches {
    margin-block: 3.5rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-border, #64748b) 70%, transparent);
    background:
      linear-gradient(rgb(10 16 24 / 0.93), rgb(10 16 24 / 0.96)),
      repeating-linear-gradient(90deg, transparent 0 31px, rgb(255 255 255 / 0.06) 31px 32px);
    color: #eaf1f8;
  }

  figcaption {
    max-width: 62rem;
  }

  figcaption p,
  figcaption h3,
  .branches__card p,
  .branches__card h4,
  .branches__note {
    margin: 0;
  }

  figcaption > p {
    color: #55e6ff;
    font: 700 0.72rem/1.3 var(--font-mono, monospace);
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  figcaption h3 {
    margin-top: 0.55rem;
    color: #fff;
    font-size: clamp(1.6rem, 4vw, 2.7rem);
    line-height: 1.04;
  }

  .branches__origin {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 7.5rem;
    height: 2.3rem;
    margin: 2rem auto 1.4rem;
    border: 1px solid #6f8194;
    border-radius: 999px;
    background: #111d2a;
    color: #fff;
    font: 700 0.7rem/1 var(--font-mono, monospace);
    letter-spacing: 0.16em;
  }

  .branches__origin i,
  .branches__origin i::before,
  .branches__origin i::after {
    position: absolute;
    display: block;
    width: 1px;
    background: #6f8194;
    content: "";
  }

  .branches__origin i {
    top: 100%;
    left: 50%;
    height: 1.4rem;
  }

  .branches__origin i::before,
  .branches__origin i::after {
    top: 1.4rem;
    height: 1.4rem;
    transform-origin: top;
  }

  .branches__origin i::before {
    transform: rotate(72deg);
  }

  .branches__origin i::after {
    transform: rotate(-72deg);
  }

  .branches__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .branches__card {
    --branch: #55e6ff;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.25rem;
    border-top: 5px solid var(--branch);
    background: rgb(17 29 42 / 0.94);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }

  .branches__card--acid { --branch: #e6ff4f; }
  .branches__card--coral { --branch: #ff6d67; }

  .branches__head {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
  }

  .branches__head > span {
    color: var(--branch);
    font: 700 0.7rem/1 var(--font-mono, monospace);
  }

  .branches__head h4 {
    color: #fff;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.15;
  }

  .branches__card > p {
    color: #c4d0dc;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .branches__card .branches__first {
    color: var(--branch);
    font: 700 0.76rem/1.2 var(--font-mono, monospace);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .branches__later {
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .branches__later span {
    color: #92a2b3;
    font: 700 0.66rem/1.3 var(--font-mono, monospace);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .branches__later p {
    margin-top: 0.45rem;
    color: #e6edf5;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .branches__note {
    margin-top: 1.25rem;
    color: #9cacbb;
    font: 0.72rem/1.5 var(--font-mono, monospace);
    text-align: center;
  }

  @media (max-width: 720px) {
    .branches__origin i::before,
    .branches__origin i::after {
      display: none;
    }

    .branches__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
