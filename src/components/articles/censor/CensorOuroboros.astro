---
const cycle = ["Offense", "Campaign", "Pressure", "Rule", "Self-censorship", "Migration", "Counter-platform", "Grievance content", "Counter-campaign", "Stronger rule"];
---

<section class="ouroboros not-prose" aria-labelledby="ouroboros-title">
  <header>
    <p>Censorship ouroboros</p>
    <h2 id="ouroboros-title">The censor and anti-censor become co-producers</h2>
  </header>
  <div class="cycle">
    <ol>
      {cycle.map((step, index) => <li><span>{index + 1}</span>{step}</li>)}
    </ol>
    <div class="center" aria-hidden="true"><span>↻</span></div>
  </div>
  <p class="note">Mechanism, not moral equivalence. Evidence, power, proportionality, and consequence still matter.</p>
</section>

<style>
  .ouroboros { position:relative; left:50%; width:min(68rem,calc(100vw - 2rem)); margin:clamp(2.5rem,7vw,5rem) 0; transform:translateX(-50%); border:1px solid #5a4632; border-radius:.35rem; background:radial-gradient(circle at 50% 54%,rgb(112 158 80 / .14),transparent 24rem),#080b0d; color:#eee4cb; }
  header { padding:1.2rem 1.4rem .9rem; text-align:center; }
  header p { margin:0 0 .35rem !important; color:#7da55c !important; font:700 .66rem/1.2 var(--font-mono),monospace; letter-spacing:.15em; text-transform:uppercase; }
  h2 { margin:0 !important; color:#f3ead3 !important; font-size:clamp(1.2rem,3vw,1.9rem) !important; font-weight:500 !important; }
  .cycle { position:relative; padding:1rem 1rem 2rem; }
  ol { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:.7rem; margin:0 !important; padding:0 !important; list-style:none !important; }
  li { display:grid; grid-template-columns:1.6rem 1fr; align-items:center; min-height:4.3rem; padding:.65rem; border:1px solid #4b4236; background:#141410; color:#e7dcc3; font:700 .7rem/1.25 var(--font-mono),monospace; letter-spacing:.03em; text-transform:uppercase; }
  li span { display:grid; place-items:center; width:1.25rem; height:1.25rem; border-radius:50%; background:#9f2f27; color:#fff5dc; font-size:.57rem; }
  li:nth-child(n+6) { direction:rtl; background:#111713; }
  li:nth-child(n+6) span { background:#55733f; }
  .center { display:grid; place-items:center; width:5.2rem; height:5.2rem; margin:1.2rem auto -1rem; border:1px solid #6b5a43; border-radius:50%; background:#0a0d0b; color:#d7523c; font-size:3rem; }
  .note { margin:0 !important; padding:.9rem 1.2rem !important; border-top:1px solid #3d362d; color:#938b7d !important; font:500 .66rem/1.5 var(--font-mono),monospace !important; text-align:center; }
  @media (max-width:760px) { ol { grid-template-columns:repeat(2,minmax(0,1fr)); } li:nth-child(n+6) { direction:ltr; } }
  @media (max-width:480px) { .ouroboros { width:calc(100vw - 1rem); } ol { grid-template-columns:1fr; } .center { display:none; } }
</style>
