---
import model from "@/data/salton-sea-model.json";

type GraphicKind =
  | "two-plants"
  | "regional-machine"
  | "stable-balance"
  | "bahrain-coachella"
  | "water-power"
  | "salt-path"
  | "gulf-route"
  | "shorelines";

interface Props {
  kind: GraphicKind;
}

const kind = Astro.props.kind;
const base = model.steadyScenarios.find(
  (scenario) => scenario.productId === "bahrain-nameplate" && scenario.lakeSalinityPpt === 35.5,
) ?? model.steadyScenarios[0];
const comparisonMax = model.comparisons.bahrainNameplateAfy;
const fmt = (value: number) => Math.round(value).toLocaleString("en-US");
const maf = (value: number) => `${(value / 1_000_000).toFixed(2)} MAFY`;
const percent = (value: number, max: number) => `${Math.max(3, value / max * 100).toFixed(1)}%`;

const copy: Record<GraphicKind, { title: string; caption: string; transcript: string[] }> = {
  "two-plants": {
    title: "Two plants, two jobs",
    caption: "Clean the water coming in. Desalinate the water going out. The waste streams stay separate.",
    transcript: [
      "Upstream plants treat Gulf water, the New River, the Alamo River, and agricultural drainage before controlled water enters the Sea.",
      "Lake-side plants withdraw Salton Sea water, produce finished water, and send marine concentrate to a dedicated salt-handling system.",
      "Deep geothermal brine remains in a third closed loop for power, mineral recovery, and reinjection.",
    ],
  },
  "regional-machine": {
    title: "The full regional water machine",
    caption: "The proposal works only as a network of water, power, habitat, accounting, and waste systems.",
    transcript: [
      "Gulf water travels through a binational intake, treatment, and conveyance corridor.",
      "New River, Alamo River, and agricultural drainage receive contaminant treatment before admission.",
      "The managed Sea feeds lake-side desalination; product water serves farms and communities under a Colorado River substitution agreement.",
      "Brine, salt, and contaminated residuals have separate handling routes. Geothermal, solar, wind, storage, and transmission supply power.",
    ],
  },
  "stable-balance": {
    title: "Stable level and stable salt",
    caption: `Worked screening case at -240 ft ${model.assumptions.datum}, 35.5 ppt, and Bahrain-nameplate output.`,
    transcript: [
      `Finished product P is ${fmt(base.deliveredProductAfy)} acre-feet per year.`,
      `At ${Math.round(base.recovery * 100)} percent recovery, lake withdrawal L is ${fmt(base.lakeWithdrawalAfy)} acre-feet per year.`,
      `Net evaporation E is ${fmt(base.netEvaporationAfy)} acre-feet per year, so treated inlet I is ${fmt(base.treatedInletAfy)} acre-feet per year.`,
      `To hold the Sea at 35.5 ppt in this ideal balance, admitted water averages ${base.requiredInletSalinityPpt} ppt.`,
    ],
  },
  "bahrain-coachella": {
    title: "One Bahrain versus Coachella farms",
    caption: "Actual production and nameplate capacity are different comparisons. Neither includes local downtime, conveyance loss, or an accounting agreement.",
    transcript: [
      `Bahrain's verified 2024 actual production converts to ${fmt(model.comparisons.bahrainActualAfy)} acre-feet per year, ${model.comparisons.bahrainActualShareOfCoachellaPercent} percent of the reported Coachella farm-delivery comparison.`,
      `Coachella Valley Water District reports about 260,000 acre-feet per year delivered to local farms.`,
      `Bahrain's 213 million-imperial-gallon-per-day nameplate converts to ${fmt(model.comparisons.bahrainNameplateAfy)} acre-feet per year, leaving a numerical margin of ${fmt(model.comparisons.bahrainNameplateMinusCoachellaAfy)} acre-feet before losses and downtime.`,
    ],
  },
  "water-power": {
    title: "Water output versus power",
    caption: "RO electricity is only part of the full system load. Intake, pumping, treatment, brine concentration, storage, and delivery come on top.",
    transcript: [
      ...base.energy.map((item) => `${item.kwhPerCubicMeter} kilowatt-hours per cubic meter requires about ${item.averageMegawatts} average megawatts for Bahrain-nameplate product output.`),
      `BHER reports 345 megawatts net across ten existing plants. DOE reports about 400 megawatts operating region-wide in 2023 and 2,950 megawatts of technical potential. These figures overlap and are not additive.`,
    ],
  },
  "salt-path": {
    title: "Where the salt goes",
    caption: "A salt balance is a disposal plan only after land, liners, storms, wildlife, markets, transport, and end-of-life are designed.",
    transcript: [
      `The -240 ft base case moves ${fmt(base.saltThroughOutletMetricTons)} metric tons of dissolved salts through lake-side withdrawal each year.`,
      `The ideal outlet brine is ${base.idealOutletBrineSalinityPpt} ppt and occupies ${fmt(base.outletBrineAfy)} acre-feet per year before further concentration.`,
      `Evaporating that annual brine volume at the model's net rate produces a hydraulic minimum near ${fmt(base.hydraulicPondMinimumAcres)} acres, before residence time, storms, storage, and operations.`,
      `The upstream balance rejects or retains another ${fmt(base.sourceBalance.upstreamSaltRejectedOrRetainedMetricTons)} metric tons rather than admitting it to the Sea.`,
    ],
  },
  "gulf-route": {
    title: "The Gulf-to-Salton study corridor",
    caption: "The favorable profile exists on a map. The intake, alignment, land rights, treaty authority, and environmental permits do not yet exist as a project.",
    transcript: [
      `The 2016 Salton Sea Authority reference described roughly ${model.routeReference.corridorMiles} miles through the Laguna Salada corridor and a maximum elevation near ${model.routeReference.maximumElevationFeetMsl} feet above mean sea level.`,
      `Its ${fmt(model.routeReference.referenceFlowAcreFeetPerYear)} acre-foot-per-year example used an ${model.routeReference.referencePipelineDiameterInches}-inch pipeline.`,
      "A refined project must begin with a Gulf intake and Mexico as a full design, ownership, jobs, habitat, emergency-operations, and revenue partner before crossing the international border toward the Salton Basin.",
    ],
  },
  "shorelines": {
    title: "Target shoreline scenarios",
    caption: "These interpolated screening footprints are not a flood map. Parcel, habitat, road, rail, utility, levee, and harbor GIS must decide the operating band.",
    transcript: model.shoreline.map((item) => `${item.label}: elevation ${item.feet} feet ${model.assumptions.datum}, area ${fmt(item.areaAcres)} acres, volume ${fmt(item.capacityAcreFeet)} acre-feet, and refill from the current observation ${fmt(item.refillFromCurrentAcreFeet)} acre-feet. North Shore status: ${item.northShoreHarborStatus}.`),
  },
};

const graphic = copy[kind];
---

<figure class:list={["ss-graphic", "article-wide", "not-prose", `kind-${kind}`]} aria-labelledby={`ss-${kind}-title`}>
  <header>
    <span>Screening model</span>
    <h2 id={`ss-${kind}-title`}>{graphic.title}</h2>
  </header>

  {kind === "two-plants" && (
    <div class="plant-grid graphic-body" role="img" aria-label={graphic.transcript.join(" ")}>
      <section>
        <b>Plant A: inlet control</b>
        <p>Gulf water</p><p>New + Alamo rivers</p><p>Agricultural drainage</p>
        <strong>Contaminants and excess salt removed upstream</strong>
      </section>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <section class="sea-node"><b>Managed Sea</b><p>Level band</p><p>Salinity band</p><p>Habitat cells</p></section>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <section>
        <b>Plant B: lake outlet</b>
        <p>Freshwater product</p><p>Marine concentrate</p><p>Salt withdrawal</p>
        <strong>Brine and minerals handled separately</strong>
      </section>
      <aside><b>Third loop</b><span>Deep geothermal brine → power → lithium/minerals → reinjection</span></aside>
    </div>
  )}

  {kind === "regional-machine" && (
    <div class="machine graphic-body" role="img" aria-label={graphic.transcript.join(" ")}>
      <div class="machine-row sources"><span>Gulf intake</span><span>New River</span><span>Alamo River</span><span>Farm drainage</span></div>
      <div class="machine-junction">↓ binational conveyance + upstream treatment ↓</div>
      <div class="machine-row center"><span>Managed Salton Sea</span><span>Habitat cells</span><span>Lake-side desalination</span></div>
      <div class="machine-junction">↓ finished water + separate residual systems ↓</div>
      <div class="machine-row outputs"><span>Farms + cities</span><span>Colorado substitution</span><span>Salt + minerals</span><span>Residual disposal</span></div>
      <div class="power-band">Geothermal + solar + wind + storage + transmission</div>
    </div>
  )}

  {kind === "stable-balance" && (
    <div class="balance graphic-body" role="img" aria-label={graphic.transcript.join(" ")}>
      <div class="equation"><b>P = r × L</b><span>{fmt(base.deliveredProductAfy)} = {Math.round(base.recovery * 100)}% × {fmt(base.lakeWithdrawalAfy)} AFY</span></div>
      <div class="equation"><b>I = E + L</b><span>{fmt(base.treatedInletAfy)} = {fmt(base.netEvaporationAfy)} + {fmt(base.lakeWithdrawalAfy)} AFY</span></div>
      <div class="equation"><b>I × Cᵢ = L × Cₛ</b><span>{base.requiredInletSalinityPpt} ppt inlet holds a {base.lakeSalinityPpt} ppt Sea</span></div>
      <div class="balance-note">Model date {model.modelDate} · Annual average · Ideal salt rejection · See assumptions</div>
    </div>
  )}

  {kind === "bahrain-coachella" && (
    <div class="bars graphic-body" role="img" aria-label={graphic.transcript.join(" ")}>
      {[
        ["Bahrain 2024 actual", model.comparisons.bahrainActualAfy, "Measured annual production"],
        ["Coachella farm deliveries", 260000, "Approximate reported comparison"],
        ["Bahrain nameplate", model.comparisons.bahrainNameplateAfy, "Installed fleet capacity"],
      ].map(([label, value, note]) => (
        <div class="bar-row">
          <div><b>{label}</b><small>{note}</small></div>
          <span class="bar-track"><i style={`width:${percent(Number(value), comparisonMax)}`}></i></span>
          <strong>{fmt(Number(value))} AFY</strong>
        </div>
      ))}
      <p class="callout">Nameplate margin before local losses: <b>{fmt(model.comparisons.bahrainNameplateMinusCoachellaAfy)} AFY</b></p>
    </div>
  )}

  {kind === "water-power" && (
    <div class="power graphic-body" role="img" aria-label={graphic.transcript.join(" ")}>
      <section>
        <h3>Bahrain-nameplate RO product</h3>
        {base.energy.map((item) => <p><span>{item.kwhPerCubicMeter} kWh/m³</span><b>{item.averageMegawatts} MW average</b><small>{item.annualTwh} TWh/year</small></p>)}
      </section>
      <section>
        <h3>Geothermal scale references</h3>
        <p><span>BHER existing</span><b>{model.capacityReferences.existingBherGeothermalMegawatts} MW net</b><small>10 plants</small></p>
        <p><span>Region operating, 2023</span><b>{model.capacityReferences.regionalGeothermalOperatingMegawatts2023} MW</b><small>Overlaps BHER</small></p>
        <p><span>DOE technical potential</span><b>{fmt(model.capacityReferences.regionalGeothermalTechnicalPotentialMegawatts)} MW</b><small>Not operating capacity</small></p>
      </section>
    </div>
  )}

  {kind === "salt-path" && (
    <div class="salt graphic-body" role="img" aria-label={graphic.transcript.join(" ")}>
      <div><span>Upstream plants</span><b>{fmt(base.sourceBalance.upstreamSaltRejectedOrRetainedMetricTons)} t</b><small>rejected or retained before admission</small></div>
      <i aria-hidden="true">+</i>
      <div><span>Lake outlet</span><b>{fmt(base.saltThroughOutletMetricTons)} t</b><small>dissolved salts carried out annually</small></div>
      <i aria-hidden="true">→</i>
      <div><span>Brine system</span><b>{fmt(base.outletBrineAfy)} AFY</b><small>{base.idealOutletBrineSalinityPpt} ppt ideal concentrate</small></div>
      <i aria-hidden="true">→</i>
      <div class="hazard"><span>Pond floor</span><b>{fmt(base.hydraulicPondMinimumAcres)} acres</b><small>hydraulic minimum, not a design area</small></div>
    </div>
  )}

  {kind === "gulf-route" && (
    <div class="route graphic-body" role="img" aria-label={graphic.transcript.join(" ")}>
      <svg viewBox="0 0 900 310" aria-hidden="true">
        <path class="land" d="M40 230 C165 90 275 280 390 145 S610 50 850 105 L850 285 L40 285 Z" />
        <path class="route-line" d="M85 230 C215 110 285 245 400 145 S610 85 815 105" />
        <circle cx="85" cy="230" r="9"/><circle cx="270" cy="183" r="9"/><circle cx="510" cy="95" r="9"/><circle cx="815" cy="105" r="9"/>
        <text x="58" y="262">Gulf intake</text><text x="205" y="215">Laguna Salada</text><text x="467" y="69">Border</text><text x="744" y="79">Salton Sea</text>
        <text class="measure" x="294" y="282">~{model.routeReference.corridorMiles} miles · crest near {model.routeReference.maximumElevationFeetMsl} ft MSL</text>
      </svg>
      <div class="route-reference">2016 reference: {fmt(model.routeReference.referenceFlowAcreFeetPerYear)} AFY · {model.routeReference.referencePipelineDiameterInches}-inch pipe</div>
    </div>
  )}

  {kind === "shorelines" && (
    <div class="shoreline graphic-body" role="img" aria-label={graphic.transcript.join(" ")}>
      {model.shoreline.map((item) => (
        <section class:list={[item.id === "current" && "current", item.id.includes("2010") && "documented"]}>
          <span>{item.label}</span>
          <b>{item.feet.toFixed(item.feet % 1 ? 2 : 0)} ft</b>
          <small>{fmt(item.areaAcres)} acres</small>
          <small>{item.refillFromCurrentAcreFeet ? `${maf(item.refillFromCurrentAcreFeet)} refill` : "Observed baseline"}</small>
        </section>
      ))}
    </div>
  )}

  <figcaption>{graphic.caption}</figcaption>
  <details>
    <summary>Read this graphic as text</summary>
    <ol>{graphic.transcript.map((item) => <li>{item}</li>)}</ol>
  </details>
</figure>

<style>
  .ss-graphic {
    gap: 0;
    overflow: hidden;
    margin-block: 2.7rem !important;
    border: 1px solid rgb(97 206 185 / 0.3);
    border-radius: 0.7rem;
    background: #07100f;
    color: #ede8dc;
    box-shadow: 0 1.2rem 3.4rem rgb(0 0 0 / 0.24);
  }

  header {
    box-sizing: border-box;
    width: 100%;
    padding: 1rem clamp(1rem, 3vw, 1.5rem);
    border-bottom: 1px solid rgb(97 206 185 / 0.2);
    background: linear-gradient(110deg, rgb(17 102 89 / 0.55), rgb(116 75 27 / 0.2) 72%, transparent);
    text-align: left;
  }

  header span {
    display: block;
    color: #8ee4d4;
    font: 700 0.63rem/1.2 var(--font-mono), monospace;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  header h2 {
    margin: 0.28rem 0 0 !important;
    color: #f6f0e3 !important;
    font-size: clamp(1.25rem, 3vw, 1.85rem) !important;
  }

  .graphic-body {
    box-sizing: border-box;
    width: 100%;
    padding: clamp(1rem, 3.5vw, 1.65rem);
  }

  .plant-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(8rem, 0.68fr) auto minmax(0, 1fr);
    gap: 0.7rem;
    align-items: center;
  }

  .plant-grid section,
  .plant-grid aside {
    padding: 0.9rem;
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: 0.4rem;
    background: rgb(255 255 255 / 0.035);
    text-align: left;
  }

  .plant-grid section b,
  .plant-grid section strong,
  .plant-grid aside b,
  .plant-grid aside span {
    display: block;
  }

  .plant-grid section b { color: #86e3d2; }
  .plant-grid section p { margin: 0.35rem 0 !important; color: #d4d0c6; font-size: 0.76rem; }
  .plant-grid section strong { margin-top: 0.75rem; color: #e7b76a; font-size: 0.68rem; line-height: 1.4; }
  .plant-grid .sea-node { border-color: rgb(73 190 220 / 0.45); background: rgb(20 111 136 / 0.16); }
  .flow-arrow { color: #73d9c8; font-size: 1.4rem; }
  .plant-grid aside { grid-column: 1 / -1; display: flex; gap: 0.7rem; color: #a8aaa3; font: 0.68rem/1.5 var(--font-mono), monospace; }
  .plant-grid aside b { color: #e2c078; }

  .machine-row { display: grid; gap: 0.55rem; }
  .machine-row.sources, .machine-row.outputs { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .machine-row.center { grid-template-columns: 1.25fr 0.8fr 1.25fr; }
  .machine-row span { padding: 0.75rem 0.5rem; border: 1px solid rgb(255 255 255 / 0.14); border-radius: 0.35rem; background: rgb(255 255 255 / 0.035); font: 700 0.7rem/1.35 var(--font-mono), monospace; }
  .machine-row.center span { border-color: rgb(80 191 175 / 0.42); color: #eaf8f4; background: rgb(20 112 100 / 0.15); }
  .machine-junction { padding: 0.7rem; color: #79d9c8; font: 0.68rem/1.2 var(--font-mono), monospace; }
  .power-band { margin-top: 0.8rem; padding: 0.65rem; border-radius: 0.3rem; background: linear-gradient(90deg, #66451f, #236052, #263d55); color: #fff3d7; font: 700 0.7rem/1.4 var(--font-mono), monospace; }

  .balance { display: grid; gap: 0.65rem; grid-template-columns: repeat(3, minmax(0, 1fr)); text-align: left; }
  .equation { padding: 1rem; border: 1px solid rgb(97 206 185 / 0.25); border-radius: 0.4rem; background: rgb(255 255 255 / 0.035); }
  .equation b { display: block; color: #8fe6d5; font: 700 1.12rem/1.3 var(--font-mono), monospace; }
  .equation span { display: block; margin-top: 0.65rem; color: #cbc8bf; font-size: 0.72rem; line-height: 1.5; }
  .balance-note { grid-column: 1 / -1; color: #858e89; font: 0.65rem/1.5 var(--font-mono), monospace; text-align: center; }

  .bars { display: grid; gap: 0.85rem; }
  .bar-row { display: grid; grid-template-columns: minmax(9rem, 1fr) minmax(8rem, 2fr) 7.5rem; gap: 0.75rem; align-items: center; text-align: left; }
  .bar-row b, .bar-row small { display: block; }
  .bar-row b { color: #e9e3d5; font-size: 0.76rem; }
  .bar-row small { margin-top: 0.12rem; color: #7f8984; font-size: 0.62rem; }
  .bar-row strong { color: #d7c28d; font: 700 0.7rem/1.2 var(--font-mono), monospace; text-align: right; }
  .bar-track { overflow: hidden; height: 0.82rem; border-radius: 999px; background: #15201e; }
  .bar-track i { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #2b9c88, #80dcca); }
  .callout { margin: 0.3rem 0 0 !important; padding-top: 0.8rem; border-top: 1px solid rgb(255 255 255 / 0.12); color: #bcb7aa; font-size: 0.74rem; }
  .callout b { color: #e9ba6e; }

  .power { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; text-align: left; }
  .power section { padding: 1rem; border: 1px solid rgb(255 255 255 / 0.13); border-radius: 0.4rem; }
  .power h3 { margin: 0 0 0.75rem !important; color: #8ce0d0 !important; font-size: 0.78rem !important; text-transform: uppercase; letter-spacing: 0.06em; }
  .power p { display: grid; grid-template-columns: 1fr auto; gap: 0.1rem 0.65rem; margin: 0.55rem 0 !important; padding-bottom: 0.55rem; border-bottom: 1px solid rgb(255 255 255 / 0.08); font-size: 0.71rem; }
  .power p:last-child { border: 0; padding-bottom: 0; }
  .power p b { color: #e7c078; }
  .power p small { grid-column: 1 / -1; color: #7f8984; }

  .salt { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr; gap: 0.6rem; align-items: center; }
  .salt div { min-height: 7rem; padding: 0.8rem; border: 1px solid rgb(255 255 255 / 0.14); border-radius: 0.4rem; background: rgb(255 255 255 / 0.035); text-align: left; }
  .salt div span, .salt div b, .salt div small { display: block; }
  .salt div span { color: #8de0d1; font: 700 0.66rem/1.25 var(--font-mono), monospace; }
  .salt div b { margin-top: 0.6rem; color: #efd092; font-size: 0.92rem; }
  .salt div small { margin-top: 0.35rem; color: #929892; font-size: 0.62rem; line-height: 1.35; }
  .salt i { color: #75d5c4; font-style: normal; }
  .salt .hazard { border-color: rgb(220 139 76 / 0.4); }

  .route svg { display: block; width: 100%; height: auto; border-radius: 0.35rem; background: #d9c79e; }
  .route svg .land { fill: #b99b67; stroke: #745c38; stroke-width: 2; }
  .route svg .route-line { fill: none; stroke: #176f73; stroke-width: 8; stroke-linecap: round; stroke-dasharray: 14 8; }
  .route svg circle { fill: #f0cc77; stroke: #173d3d; stroke-width: 4; }
  .route svg text { fill: #172c2b; font: 700 19px sans-serif; }
  .route svg text.measure { font: 700 17px monospace; }
  .route-reference { margin-top: 0.65rem; color: #9da8a3; font: 0.68rem/1.4 var(--font-mono), monospace; }

  .shoreline { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0.5rem; align-items: end; }
  .shoreline section { min-height: 8rem; padding: 0.75rem 0.55rem; border: 1px solid rgb(255 255 255 / 0.13); border-radius: 0.35rem; background: linear-gradient(to top, rgb(28 109 118 / 0.32), rgb(255 255 255 / 0.025)); text-align: left; }
  .shoreline section.current { border-color: rgb(220 153 75 / 0.5); }
  .shoreline section.documented { border-color: rgb(98 211 185 / 0.5); }
  .shoreline span, .shoreline b, .shoreline small { display: block; }
  .shoreline span { min-height: 2.1rem; color: #9da8a3; font: 0.6rem/1.35 var(--font-mono), monospace; }
  .shoreline b { margin-top: 0.5rem; color: #f0d28e; font-size: 1rem; }
  .shoreline small { margin-top: 0.35rem; color: #c4c2ba; font-size: 0.61rem; line-height: 1.35; }

  figcaption {
    box-sizing: border-box;
    width: 100%;
    margin: 0 !important;
    padding: 0.85rem 1rem;
    border-top: 1px solid rgb(97 206 185 / 0.17);
    color: #aaa9a2 !important;
    font-size: 0.73rem !important;
    line-height: 1.5 !important;
    text-align: left !important;
  }

  details {
    box-sizing: border-box;
    width: calc(100% - 2rem);
    margin: 0 1rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 0.35rem;
    color: #b5b7b2;
    font: 0.7rem/1.55 var(--font-mono), monospace;
    text-align: left;
  }

  summary { cursor: pointer; padding: 0.65rem 0.8rem; color: #8edfcf; }
  details ol { margin: 0 !important; padding: 0 1rem 0.8rem 2.1rem !important; }
  details li { margin: 0.35rem 0 !important; }

  @media (min-width: 700px) {
    details { display: none; }
  }

  @media (max-width: 699px) {
    .plant-grid { grid-template-columns: 1fr; }
    .flow-arrow { transform: rotate(90deg); }
    .machine-row.sources, .machine-row.outputs, .machine-row.center { grid-template-columns: 1fr 1fr; }
    .balance, .power { grid-template-columns: 1fr; }
    .bar-row { grid-template-columns: 1fr; gap: 0.35rem; }
    .bar-row strong { text-align: left; }
    .salt { grid-template-columns: 1fr; }
    .salt i { transform: rotate(90deg); }
    .salt div { min-height: 0; }
    .shoreline { grid-template-columns: 1fr 1fr; align-items: stretch; }
  }
</style>
