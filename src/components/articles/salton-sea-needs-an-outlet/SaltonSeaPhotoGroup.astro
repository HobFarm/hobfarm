---
import { imageSrcset, transformImageUrl } from "@/lib/media-transforms";

interface PhotoItem {
  file: string;
  alt: string;
  caption: string;
  width: number;
  height: number;
  credit: string;
  label?: string;
}

interface Props {
  id: string;
  kicker: string;
  title: string;
  intro?: string;
  photos: PhotoItem[];
  layout?: "grid" | "pair" | "single";
  sourceNote?: string;
}

const {
  id,
  kicker,
  title,
  intro,
  photos,
  layout = "grid",
  sourceNote,
} = Astro.props;

const base = "https://cdn.hob.farm/articles/salton-sea/";
const source = (file: string) => `${base}${file.split("/").map(encodeURIComponent).join("/")}`;
---

<section class:list={["ss-photo-group", "article-wide", "not-prose", `layout-${layout}`]} aria-labelledby={`${id}-title`}>
  <header>
    <p>{kicker}</p>
    <h2 id={`${id}-title`}>{title}</h2>
    {intro && <div>{intro}</div>}
  </header>
  <div class="photos">
    {photos.map((photo) => {
      const original = source(photo.file);
      return (
        <figure>
          {photo.label && <span class="photo-label">{photo.label}</span>}
          <img
            src={transformImageUrl(original, { width: Math.min(photo.width, 1600), quality: 84, fit: "contain" })}
            srcset={imageSrcset(original, [480, 800, 1200, 1600].filter((width) => width <= photo.width), { quality: 84, fit: "contain" })}
            sizes={layout === "single" ? "(min-width: 800px) 42rem, 92vw" : "(min-width: 800px) 21rem, 92vw"}
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            loading="lazy"
            decoding="async"
            data-lightbox={original}
            data-lightbox-group={`salton-sea-${id}`}
            data-lightbox-caption={`${photo.caption} ${photo.credit}`}
          />
          <figcaption>
            <span>{photo.caption}</span>
            <small>{photo.credit}</small>
          </figcaption>
        </figure>
      );
    })}
  </div>
  {sourceNote && <footer>{sourceNote}</footer>}
</section>

<style>
  .ss-photo-group {
    overflow: hidden;
    margin-block: 2.5rem !important;
    border: 1px solid rgb(83 179 164 / 0.28);
    border-radius: 0.7rem;
    background: #07100f;
  }

  header {
    padding: clamp(1rem, 3vw, 1.45rem);
    background: linear-gradient(115deg, rgb(19 92 82 / 0.48), rgb(112 77 32 / 0.18) 70%, transparent);
  }

  header p,
  header h2,
  header div {
    margin: 0 !important;
  }

  header p {
    color: #85dfcf !important;
    font: 700 0.66rem/1.2 var(--font-mono), monospace !important;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  header h2 {
    margin-top: 0.3rem !important;
    color: #f5efe3 !important;
    font-size: clamp(1.3rem, 3vw, 1.9rem) !important;
  }

  header div {
    max-width: 54rem;
    margin-top: 0.55rem !important;
    color: #b9b7ad;
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .photos {
    display: grid;
    gap: 1px;
    background: rgb(83 179 164 / 0.2);
  }

  .layout-grid .photos,
  .layout-pair .photos {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  figure {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-width: 0;
    margin: 0 !important;
    background: #040706;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 42rem;
    margin: 0 !important;
    object-fit: contain;
    background: #020303;
  }

  .layout-grid img,
  .layout-pair img {
    aspect-ratio: 4 / 3;
  }

  .layout-single img {
    height: auto;
  }

  .photo-label {
    position: absolute;
    z-index: 1;
    top: 0.7rem;
    left: 0.7rem;
    padding: 0.3rem 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.32);
    border-radius: 0.25rem;
    background: rgb(3 8 8 / 0.84);
    color: #eef9f6;
    font: 700 0.67rem/1 var(--font-mono), monospace;
    letter-spacing: 0.06em;
  }

  figcaption {
    box-sizing: border-box;
    min-height: 5rem;
    padding: 0.75rem 0.9rem 0.9rem;
    color: #cbc6ba !important;
    font-size: 0.74rem !important;
    line-height: 1.5 !important;
    text-align: left !important;
  }

  figcaption span,
  figcaption small {
    display: block;
  }

  figcaption small {
    margin-top: 0.35rem;
    color: #858d89;
    font-size: 0.66rem;
  }

  footer {
    padding: 0.75rem 1rem;
    border-top: 1px solid rgb(83 179 164 / 0.18);
    color: #8d948f;
    font: 0.69rem/1.5 var(--font-mono), monospace;
  }

  @media (max-width: 699px) {
    .layout-grid .photos,
    .layout-pair .photos {
      grid-template-columns: 1fr;
    }

    figcaption {
      min-height: 0;
    }
  }
</style>
