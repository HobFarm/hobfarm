---
const images = [
  {
    src: "/images/articles/hey-its-that-guy/hammond-street-downtown-bangor.jpg",
    title: "Hammond Street",
    location: "Downtown Bangor",
    date: "Street View, August 2025",
    alt: "Google Street View looking uphill along Hammond Street in downtown Bangor, with brick commercial buildings on the left and the former post office building on the right.",
  },
  {
    src: "/images/articles/hey-its-that-guy/i395-exit-5-approach-brewer.jpg",
    title: "I-395 eastbound",
    location: "Exit 5 approach, Brewer",
    date: "Street View, August 2025",
    alt: "Google Street View from I-395 eastbound approaching the right-hand Exit 5 ramp in Brewer, Maine.",
  },
  {
    src: "/images/articles/hey-its-that-guy/exit-5-ramp-brewer.jpg",
    title: "Exit 5",
    location: "Brewer",
    date: "Street View, May 2026",
    alt: "Google Street View on the curving Exit 5 ramp in Brewer, with the interstate and exit sign visible to the left.",
  },
];
---

<figure class="bangor-brewer not-prose" aria-labelledby="bangor-brewer-title">
  <header>
    <p>Bangor becomes Brewer</p>
    <h2 id="bangor-brewer-title">The road under the movie</h2>
  </header>

  <div class="road-grid">
    {images.map((image, index) => (
      <article class:list={{ wide: index === 0 }}>
        <img
          src={image.src}
          alt={image.alt}
          width="1610"
          height="949"
          loading="eager"
          decoding="async"
        />
        <div>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <p><strong>{image.title}</strong><br />{image.location}</p>
          <small>{image.date}</small>
        </div>
      </article>
    ))}
  </div>

  <figcaption>
    “The Hitch-hiker” rearranges Bangor and Brewer according to camera direction and dramatic continuity. A local viewer can see the joins. Images: Google Street View / Google Maps.
  </figcaption>
</figure>

<style>
  .bangor-brewer {
    margin: 3rem 0;
    padding: clamp(0.75rem, 2.5vw, 1.5rem);
    color: #f5edd6;
    background: #111516;
    border: 1px solid rgb(224 202 144 / 0.32);
  }

  header {
    margin-bottom: 1rem;
  }

  header p,
  header h2 {
    margin: 0;
  }

  header p {
    color: #8fbcb3;
    font: 800 0.7rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  header h2 {
    margin-top: 0.25rem;
    font: 800 clamp(1.55rem, 4vw, 2.5rem)/1 Georgia, serif;
  }

  .road-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  article {
    position: relative;
    overflow: hidden;
    background: #1c2424;
    border: 1px solid rgb(255 255 255 / 0.12);
  }

  article.wide {
    grid-column: 1 / -1;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1610 / 949;
    object-fit: cover;
  }

  article > div {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.75rem;
    align-items: center;
    padding: 0.75rem;
  }

  article > div > span {
    color: #dfb653;
    font: 800 0.72rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  article p {
    margin: 0;
    color: #d7d8cf;
    font-size: 0.78rem;
    line-height: 1.3;
  }

  article strong {
    color: #fff5d8;
    font-size: 0.9rem;
  }

  small {
    color: #8e9c98;
    font-size: 0.68rem;
    text-align: right;
  }

  figcaption {
    margin-top: 0.85rem;
    color: #9ca8a3;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  @media (max-width: 620px) {
    .road-grid {
      grid-template-columns: 1fr;
    }

    article.wide {
      grid-column: auto;
    }

    article > div {
      grid-template-columns: auto 1fr;
    }

    small {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
