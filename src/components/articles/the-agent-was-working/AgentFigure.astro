---
type FigureKind = "cycle" | "maintenance" | "architecture" | "economics";

interface Props {
  kind: FigureKind;
}

const figures = {
  cycle: {
    eyebrow: "What autonomy looked like",
    title: "The alarm clock starts the run",
    caption: "Cron is the alarm clock. The model-directed loop is the agentic part.",
    transcript: [
      "A cron schedule, event, or user request starts a bounded run.",
      "The system loads instructions, state, and available tools.",
      "The model chooses or composes an action and invokes a tool.",
      "The run writes logs, artifacts, and updated state, reaches an exit condition, then sleeps or waits for another request.",
      "Cron is one possible trigger. It is not the intelligence.",
    ],
  },
  maintenance: {
    eyebrow: "The actual maintenance loop",
    title: "The job changes. The model changes. The files remain.",
    caption: "The agent configuration sits between two moving targets: the model changes, and the job changes.",
    transcript: [
      "Write skill.",
      "Test.",
      "Agent does something weird.",
      "Rewrite skill.",
      "Project changes.",
      "Rewrite skill.",
      "Model changes.",
      "Remove obsolete instructions.",
      "New tool becomes available.",
      "Rewrite workflow.",
      "Repeat.",
    ],
  },
  architecture: {
    eyebrow: "HobBot to the current system",
    title: "The useful parts survived the large agent",
    caption: "The useful parts survived. The requirement that one autonomous system own everything did not.",
    transcript: [
      "Moltbook HobBot used scheduled runs, behavior files, state, and social tools.",
      "HobFarm HobBot workers expanded the idea into publishing, monitoring, and maintenance jobs.",
      "The first Grimoire agent grew around workflows, providers, storage, queues, and background processing.",
      "A cost and boundary audit separated current work from legacy infrastructure.",
      "Current Grimoire uses authored sources, deterministic local compilation, versioned packs, and bounded consumers including StyleFusion, EZIZE through Wildcard Machine, Wonder Machine for Other Alice, HobFarm, and human-directed Codex tasks.",
    ],
  },
  economics: {
    eyebrow: "Scale changes the answer",
    title: "The same agent can be sensible or absurd",
    caption: "The economic threshold changes with task frequency, human labor, verification burden, and failure cost.",
    transcript: [
      "Large organization: many users, frequent tasks, an expensive human baseline, shared infrastructure, and formal monitoring can spread agent cost across volume.",
      "Solo publisher: one article package, a bounded Codex task, human review, a five-minute scheduling step, and uncertain distribution may leave too little work for a posting agent to remove.",
      "Editorial value model: labor removed times frequency times scale, minus build, runtime, review, maintenance, and cleanup.",
    ],
  },
} as const;

const figure = figures[Astro.props.kind];
const maintenanceSteps = [
  "write skill",
  "test",
  "agent does something weird",
  "rewrite skill",
  "project changes",
  "rewrite skill",
  "model changes",
  "remove obsolete instructions",
  "new tool becomes available",
  "rewrite workflow",
  "repeat",
];
---

<figure class="agent-figure not-prose my-12 border-y border-base-800 py-6 sm:my-16 sm:py-8" data-kind={Astro.props.kind}>
  <div class="mx-auto max-w-[50rem] overflow-hidden border border-base-800 bg-[#0b0c0e] shadow-2xl shadow-black/25">
    <header class="agent-header border-b border-base-800 p-5 sm:p-7">
      <p>{figure.eyebrow}</p>
      <h3>{figure.title}</h3>
    </header>

    {Astro.props.kind === "cycle" && (
      <div class="cycle-grid p-5 sm:p-7">
        <div class="trigger-bank">
          <span>cron</span><span>event</span><span>request</span>
        </div>
        <span class="down" aria-hidden="true">↓</span>
        <div class="cycle-node"><b>Load</b><span>instructions + state + tools</span></div>
        <span class="down orange" aria-hidden="true">↓</span>
        <div class="agent-loop">
          <span>model</span><i aria-hidden="true">⇄</i><span>tools</span>
          <small>choose · act · observe</small>
        </div>
        <span class="down orange" aria-hidden="true">↓</span>
        <div class="cycle-node"><b>Record</b><span>logs + artifacts + updated state</span></div>
        <span class="down" aria-hidden="true">↓</span>
        <div class="exit-bank"><span>exit condition</span><span>sleep or wait</span></div>
        <p class="cycle-note">The trigger starts the process. The loop directs the work.</p>
      </div>
    )}

    {Astro.props.kind === "maintenance" && (
      <div class="maintenance-wrap p-5 sm:p-7">
        <ol class="maintenance-list">
          {maintenanceSteps.map((step, index) => (
            <li class:list={{ correction: step.includes("weird") || step.includes("obsolete"), rewrite: step.includes("rewrite") }}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{step}</strong>
            </li>
          ))}
        </ol>
        <div class="maintenance-side">
          <div><span>moving target 01</span><strong>the job</strong><small>scope · files · tools</small></div>
          <div><span>moving target 02</span><strong>the model</strong><small>behavior · limits · defaults</small></div>
          <p>service manual<br />never finished</p>
        </div>
      </div>
    )}

    {Astro.props.kind === "architecture" && (
      <div class="architecture-wrap p-5 sm:p-7">
        <ol class="architecture-line">
          <li><span>01</span><strong>Moltbook HobBot</strong><small>scheduled runs · behavior files · state · social tools</small></li>
          <li><span>02</span><strong>HobFarm workers</strong><small>publishing · monitoring · maintenance</small></li>
          <li class="large"><span>03</span><strong>First Grimoire agent</strong><small>workflows · providers · storage · queues · background processing</small></li>
          <li class="audit"><span>04</span><strong>Cost + boundary audit</strong><small>separate the useful contracts from the autonomous machinery</small></li>
        </ol>
        <section class="current-system">
          <p>current smaller system</p>
          <div class="source-box">authored sources</div>
          <span aria-hidden="true">↓ deterministic compile ↓</span>
          <div class="pack-box">versioned named packs</div>
          <div class="consumer-grid">
            <span>StyleFusion</span><span>EZIZE</span><span>Other Alice</span><span>HobFarm</span><span>Codex</span>
          </div>
        </section>
      </div>
    )}

    {Astro.props.kind === "economics" && (
      <div class="economics-wrap">
        <section>
          <p>large organization</p>
          <ul><li>many users</li><li>high task frequency</li><li>expensive human baseline</li><li>shared infrastructure</li><li>formal monitoring</li></ul>
          <strong>cost spread across volume</strong>
        </section>
        <div class="equation">
          <b>VALUE</b>
          <span>labor removed × frequency × scale</span>
          <i>minus</i>
          <span>build + run + review + maintenance + cleanup</span>
        </div>
        <section class="solo">
          <p>solo publisher</p>
          <ul><li>one article package</li><li>bounded Codex task</li><li>human review</li><li>five-minute scheduling step</li><li>uncertain distribution</li></ul>
          <strong>autonomy may cost more than it removes</strong>
        </section>
      </div>
    )}
  </div>

  <figcaption class="mx-auto mt-4 max-w-[48rem] text-sm leading-relaxed text-base-300">{figure.caption}</figcaption>
  <details class="mx-auto mt-4 max-w-[48rem] border border-base-800 bg-base-950/60 p-4 text-sm text-base-300">
    <summary class="cursor-pointer font-mono text-[10px] uppercase tracking-wider text-[#ff5a2f] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#ff5a2f]">Read the graphic transcript</summary>
    <ul class="mt-3 space-y-2 pl-5 leading-relaxed">{figure.transcript.map((line: string) => <li>{line}</li>)}</ul>
  </details>
</figure>

<style>
  .agent-header { background: linear-gradient(90deg, rgb(255 74 35 / .12), transparent 65%); }
  .agent-header p, .architecture-line span, .current-system > p, .economics-wrap section > p, .maintenance-side span { margin: 0; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .15em; text-transform: uppercase; color: #ff6b3d; }
  .agent-header h3 { margin: .45rem 0 0; font-family: var(--font-display); font-size: clamp(1.45rem, 4vw, 2rem); font-weight: 300; color: white; }
  .cycle-grid { display: grid; justify-items: center; }
  .trigger-bank, .exit-bank { display: flex; flex-wrap: wrap; justify-content: center; gap: .45rem; }
  .trigger-bank span, .exit-bank span, .consumer-grid span { border: 1px solid #494b50; background: #181a1d; padding: .55rem .75rem; font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .08em; color: #d8d8d4; }
  .cycle-node { width: min(100%, 32rem); display: grid; gap: .25rem; border: 1px solid #494b50; background: #17191c; padding: .8rem 1rem; text-align: center; }
  .cycle-node b { color: #fff; font-size: .82rem; }
  .cycle-node span { color: #a7a8ab; font-family: var(--font-mono); font-size: .64rem; }
  .down { height: 1.8rem; display: grid; place-items: center; color: #777a80; }
  .down.orange { color: #ff5a2f; }
  .agent-loop { width: min(100%, 34rem); display: grid; grid-template-columns: 1fr auto 1fr; gap: .8rem; align-items: center; border: 2px solid #ff5a2f; background: #21130f; padding: 1rem; text-align: center; color: white; }
  .agent-loop span { border: 1px solid rgb(255 107 61 / .5); padding: .7rem; font-family: var(--font-mono); text-transform: uppercase; font-size: .72rem; }
  .agent-loop i { color: #ff8a64; font-style: normal; font-size: 1.4rem; }
  .agent-loop small { grid-column: 1 / -1; color: #c9a99f; font-family: var(--font-mono); font-size: .58rem; letter-spacing: .12em; text-transform: uppercase; }
  .cycle-note { margin: 1.3rem 0 0; color: #ff9b7d; font-family: var(--font-mono); font-size: .64rem; text-align: center; text-transform: uppercase; letter-spacing: .08em; }
  .maintenance-wrap { display: grid; gap: 1rem; }
  .maintenance-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; margin: 0; padding: 0; list-style: none; counter-reset: none; }
  .maintenance-list li { display: grid; grid-template-columns: 2rem 1fr; align-items: center; min-height: 3.25rem; border: 1px solid #3f4145; background: #17191c; }
  .maintenance-list li > span { display: grid; height: 100%; place-items: center; border-right: 1px solid #3f4145; color: #777a80; font-family: var(--font-mono); font-size: .58rem; }
  .maintenance-list strong { padding: .6rem; color: #e9e9e5; font-family: var(--font-mono); font-size: .65rem; font-weight: 500; text-transform: uppercase; }
  .maintenance-list .rewrite { border-color: rgb(255 90 47 / .65); }
  .maintenance-list .rewrite strong { color: #ff9676; }
  .maintenance-list .correction { transform: rotate(-.5deg); background: #251510; }
  .maintenance-side { display: grid; grid-template-columns: repeat(2, 1fr); gap: .5rem; }
  .maintenance-side div { display: grid; gap: .3rem; border: 1px dashed #55585e; padding: .8rem; }
  .maintenance-side strong { color: #fff; font-size: .9rem; }
  .maintenance-side small { color: #8d8f94; font-family: var(--font-mono); font-size: .58rem; }
  .maintenance-side p { grid-column: 1 / -1; margin: .35rem 0 0; border-top: 1px solid #34363a; padding-top: .8rem; color: #65686e; font-family: var(--font-mono); font-size: .58rem; text-align: right; text-transform: uppercase; }
  .architecture-wrap { display: grid; gap: 1rem; }
  .architecture-line { display: grid; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  .architecture-line li { position: relative; display: grid; gap: .2rem; border-left: 3px solid #777a80; background: #17191c; padding: .75rem .9rem; }
  .architecture-line li:not(:last-child)::after { content: "↓"; position: absolute; bottom: -.9rem; left: .55rem; z-index: 2; color: #777a80; }
  .architecture-line strong { color: white; font-size: .84rem; }
  .architecture-line small { color: #a6a8ac; font-family: var(--font-mono); font-size: .58rem; line-height: 1.5; }
  .architecture-line .large { border-color: #ff5a2f; background: #22130f; }
  .architecture-line .audit { border-color: #ffd263; }
  .current-system { display: grid; justify-items: center; gap: .6rem; border: 1px solid #4a4d52; background: #101112; padding: 1rem; }
  .source-box, .pack-box { width: min(100%, 26rem); border: 1px solid #72757b; padding: .65rem; text-align: center; color: white; font-family: var(--font-mono); font-size: .68rem; text-transform: uppercase; }
  .pack-box { border-color: #ff5a2f; color: #ff9676; }
  .current-system > span { color: #777a80; font-family: var(--font-mono); font-size: .55rem; text-transform: uppercase; }
  .consumer-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: .4rem; }
  .economics-wrap { display: grid; background: #3f4145; gap: 1px; }
  .economics-wrap section { background: #0f1012; padding: 1.2rem; }
  .economics-wrap section.solo { background: #17100d; }
  .economics-wrap ul { display: grid; gap: .45rem; margin: 1rem 0; padding: 0; list-style: none; }
  .economics-wrap li { border: 1px solid #3f4145; padding: .55rem .7rem; color: #d2d3d0; font-size: .72rem; }
  .economics-wrap section > strong { display: block; border-top: 1px solid #3f4145; padding-top: .8rem; color: #fff; font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; }
  .economics-wrap .solo > strong { color: #ff9676; }
  .equation { display: grid; align-content: center; gap: .7rem; background: #15171a; padding: 1.2rem; text-align: center; }
  .equation b { color: #ff5a2f; font-family: var(--font-mono); letter-spacing: .16em; font-size: .65rem; }
  .equation span { border: 1px solid #4c4f54; padding: .7rem; color: #eee; font-family: var(--font-mono); font-size: .64rem; line-height: 1.45; }
  .equation i { color: #777a80; font-style: normal; font-family: var(--font-mono); font-size: .55rem; text-transform: uppercase; }
  @media (min-width: 700px) {
    .maintenance-wrap { grid-template-columns: 2fr 1fr; }
    .maintenance-side { grid-template-columns: 1fr; align-content: start; }
    .maintenance-side p { grid-column: 1; }
    .architecture-wrap { grid-template-columns: .9fr 1.1fr; align-items: center; }
    .economics-wrap { grid-template-columns: 1fr .9fr 1fr; }
  }
  @media (max-width: 440px) {
    .maintenance-list { grid-template-columns: 1fr; }
    .agent-loop { gap: .35rem; padding: .7rem; }
    .agent-loop span { padding: .55rem .35rem; }
  }
</style>
