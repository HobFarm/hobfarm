---
interface Item {
  src: string;
  alt: string;
  caption: string;
  width: number;
  height: number;
}

interface Props {
  label: string;
  items: Item[];
}

const { label, items } = Astro.props;
---

<section class="wavy-pair article-wide not-prose" aria-label={label}>
  {items.map((item) => (
    <figure>
      <img
        src={item.src}
        alt={item.alt}
        width={item.width}
        height={item.height}
        loading="lazy"
        decoding="async"
        data-lightbox={item.src}
        data-lightbox-caption={`${item.caption} Photograph by HobFarm.`}
      />
      <figcaption>
        <span>{item.caption}</span>
        <small>Photograph by HobFarm</small>
      </figcaption>
    </figure>
  ))}
</section>

<style>
  .wavy-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-block: 2.6rem !important;
  }

  figure {
    min-width: 0;
    margin: 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgb(231 180 91 / 0.25);
    border-radius: 0.35rem;
    box-shadow: 0.45rem 0.55rem 0 rgb(0 0 0 / 0.24);
  }

  figcaption {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.65rem;
    color: #c8c3b8;
    font-size: 0.8rem;
    line-height: 1.45;
  }

  small {
    color: #8f8b82;
    font: 600 0.65rem/1.4 var(--font-mono, monospace);
  }

  @media (max-width: 44rem) {
    .wavy-pair {
      grid-template-columns: 1fr;
    }
  }
</style>
