---
import { giorgioCoda, spotifyTrackUrl } from "@/data/new-wave-article";
---

<aside class="giorgio-coda article-wide not-prose" aria-label="Listening coda: Giorgio by Moroder by Daft Punk">
  <div>
    <span>Retrospective listening coda</span>
    <h3>{giorgioCoda.title}</h3>
    <p>{giorgioCoda.artist} · {giorgioCoda.album} · {giorgioCoda.year}</p>
    <small>Listen for Moroder describing his search for a sound of the future, then for the recording to build that history around his voice.</small>
    <a href={spotifyTrackUrl(giorgioCoda)} target="_blank" rel="noopener noreferrer">Open exact track in Spotify <span aria-hidden="true">↗</span></a>
  </div>
  <div class="giorgio-coda__embed" data-spotify-slot data-spotify-id={giorgioCoda.spotifyId}>
    <button type="button" data-spotify-load aria-label={`Load Spotify player for ${giorgioCoda.title} by ${giorgioCoda.artist}`}>
      <span aria-hidden="true">♫</span>
      Load Spotify player
    </button>
  </div>
</aside>

<style>
  .giorgio-coda {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 1fr);
    gap: 1rem;
    margin-block: 2.7rem !important;
    padding: 1rem;
    color: #aeb8b5;
    border: 1px solid rgb(121 216 231 / 0.35);
    border-radius: 0.4rem;
    background: linear-gradient(120deg, rgb(121 216 231 / 0.1), transparent 50%), #080d10;
  }

  .giorgio-coda > div:first-child {
    display: grid;
    align-content: center;
    gap: 0.35rem;
  }

  span {
    color: #79d8e7;
    font: 750 0.62rem/1.3 var(--font-mono), monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3,
  p,
  small {
    margin: 0 !important;
  }

  h3 {
    color: #f5f1e7;
    font-size: 1.1rem;
  }

  p,
  small {
    font-size: 0.72rem;
    line-height: 1.55;
  }

  a {
    margin-top: 0.4rem;
    color: #65e88f !important;
    font: 700 0.66rem/1.35 var(--font-mono), monospace;
  }

  .giorgio-coda__embed {
    display: grid;
    min-height: 9.5rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgb(30 215 96 / 0.24);
    border-radius: 0.7rem;
    background: #050806;
  }

  .giorgio-coda__embed :global(iframe) {
    display: block;
    width: 100%;
    height: 152px;
    border: 0;
  }

  button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.72rem 0.85rem;
    color: #e8f7ed;
    border: 1px solid rgb(84 235 136 / 0.7);
    border-radius: 999px;
    background: #08150c;
    font: 700 0.68rem/1 var(--font-mono), monospace;
    cursor: pointer;
  }

  button:hover,
  button:focus-visible {
    outline: 2px solid #54eb88;
    outline-offset: 2px;
  }

  @media (max-width: 39rem) {
    .giorgio-coda {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function installCodaPlayer() {
    document.querySelectorAll<HTMLElement>(".giorgio-coda [data-spotify-slot]").forEach((slot) => {
      const button = slot.querySelector<HTMLButtonElement>("[data-spotify-load]");
      if (!button || button.dataset.ready === "true") return;
      button.dataset.ready = "true";
      button.addEventListener("click", () => {
        const spotifyId = slot.dataset.spotifyId;
        if (!spotifyId) return;
        const iframe = document.createElement("iframe");
        iframe.src = `https://open.spotify.com/embed/track/${encodeURIComponent(spotifyId)}?utm_source=generator&theme=0`;
        iframe.title = button.getAttribute("aria-label")?.replace(/^Load /, "") ?? "Spotify track";
        iframe.loading = "lazy";
        iframe.allow = "autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture";
        iframe.referrerPolicy = "strict-origin-when-cross-origin";
        slot.replaceChildren(iframe);
      }, { once: true });
    });
  }

  installCodaPlayer();
  document.addEventListener("astro:page-load", installCodaPlayer);
</script>
