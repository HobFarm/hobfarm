---
import { hamburgerTrain, spotifyTrackUrl } from "@/data/new-wave-article";
---

<aside class="hamburger-train article-wide not-prose" aria-label="Scene receipt: Hamburger Train by Primus">
  <div class="hamburger-train__copy">
    <span>Scene becomes song</span>
    <h3>{hamburgerTrain.title}</h3>
    <p>{hamburgerTrain.artist} · {hamburgerTrain.album} · {hamburgerTrain.year}</p>
    <blockquote>“You’re the guy from the hamburger train, right?”</blockquote>
    <small>The track opens with Paul Reubens’s Howie from the same <em>Nice Dreams</em> restaurant scene. The scene identification is the author’s supplied observation; Spotify verifies the exact track object.</small>
    <a href={spotifyTrackUrl(hamburgerTrain)} target="_blank" rel="noopener noreferrer">Open exact track in Spotify <span aria-hidden="true">↗</span></a>
  </div>
  <div class="hamburger-train__embed" data-hamburger-train-slot data-spotify-id={hamburgerTrain.spotifyId}>
    <button type="button" data-hamburger-train-load aria-label={`Load Spotify player for ${hamburgerTrain.title} by ${hamburgerTrain.artist}`}>
      <span aria-hidden="true">♫</span>
      Load Spotify player
    </button>
  </div>
</aside>

<script>
  function installHamburgerTrainPlayer() {
    document.querySelectorAll<HTMLElement>("[data-hamburger-train-slot]").forEach((slot) => {
      const button = slot.querySelector<HTMLButtonElement>("[data-hamburger-train-load]");
      if (!button || button.dataset.ready === "true") return;
      button.dataset.ready = "true";
      button.addEventListener("click", () => {
        const spotifyId = slot.dataset.spotifyId;
        if (!spotifyId) return;
        const iframe = document.createElement("iframe");
        iframe.src = `https://open.spotify.com/embed/track/${encodeURIComponent(spotifyId)}?utm_source=generator&theme=0`;
        iframe.title = button.getAttribute("aria-label")?.replace(/^Load /, "") ?? "Spotify track";
        iframe.loading = "lazy";
        iframe.allow = "autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture";
        iframe.referrerPolicy = "strict-origin-when-cross-origin";
        slot.replaceChildren(iframe);
      }, { once: true });
    });
  }

  installHamburgerTrainPlayer();
  document.addEventListener("astro:page-load", installHamburgerTrainPlayer);
</script>

<style>
  .hamburger-train {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(15rem, 1fr);
    gap: 1rem;
    margin-block: 2.6rem !important;
    padding: 1rem;
    overflow: hidden;
    color: #aeb8b5;
    border: 1px solid rgb(241 200 92 / 0.42);
    border-radius: 0.4rem;
    background: linear-gradient(120deg, rgb(241 200 92 / 0.12), transparent 52%), #090d0f;
    box-shadow: 0.55rem 0.6rem 0 rgb(0 0 0 / 0.22);
  }

  .hamburger-train__copy {
    display: grid;
    align-content: center;
    gap: 0.35rem;
  }

  span {
    color: #f1c85c;
    font: 750 0.62rem/1.3 var(--font-mono), monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3,
  p,
  blockquote,
  small {
    margin: 0 !important;
  }

  h3 {
    color: #f5f1e7;
    font-size: 1.15rem;
  }

  p,
  small {
    font-size: 0.72rem;
    line-height: 1.55;
  }

  blockquote {
    padding: 0.5rem 0 0.5rem 0.75rem;
    color: #f5f1e7;
    border-left: 4px solid #e54b4b;
    font-size: 0.92rem;
    font-weight: 750;
    line-height: 1.4;
  }

  a {
    margin-top: 0.4rem;
    color: #65e88f !important;
    font: 700 0.66rem/1.35 var(--font-mono), monospace;
  }

  .hamburger-train__embed {
    display: grid;
    min-height: 9.5rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgb(30 215 96 / 0.24);
    border-radius: 0.7rem;
    background: #050806;
  }

  .hamburger-train__embed :global(iframe) {
    display: block;
    width: 100%;
    height: 152px;
    border: 0;
  }

  button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.72rem 0.85rem;
    color: #e8f7ed;
    border: 1px solid rgb(84 235 136 / 0.7);
    border-radius: 999px;
    background: #08150c;
    font: 700 0.68rem/1 var(--font-mono), monospace;
    cursor: pointer;
  }

  button:hover,
  button:focus-visible {
    outline: 2px solid #54eb88;
    outline-offset: 2px;
  }

  @media (max-width: 39rem) {
    .hamburger-train {
      grid-template-columns: 1fr;
    }
  }
</style>
