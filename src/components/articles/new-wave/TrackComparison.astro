---
import { newWaveTrackPairs, spotifyTrackUrl } from "@/data/new-wave-article";

interface Props {
  pairId: string;
}

const pair = newWaveTrackPairs.find((item) => item.id === Astro.props.pairId);
if (!pair) throw new Error(`Unknown New Wave track pair: ${Astro.props.pairId}`);

const tracks = [
  { label: "Original", item: pair.original },
  { label: "Primus cover", item: pair.cover },
];
---

<section class="track-comparison article-wide not-prose" aria-labelledby={`comparison-${pair.id}`}>
  <header>
    <span>Original / cover receipt</span>
    <h3 id={`comparison-${pair.id}`}>{pair.heading}</h3>
  </header>
  <div class="track-comparison__grid">
    {tracks.map(({ label, item }) => (
      <article class="track-card">
        <p class="track-card__label">{label}</p>
        <h4>{item.title}</h4>
        <p class="track-card__meta">{item.artist}<br />{item.album}, {item.year}</p>
        <div class="track-card__embed" data-spotify-slot data-spotify-id={item.spotifyId}>
          <button type="button" data-spotify-load aria-label={`Load Spotify player for ${item.title} by ${item.artist}`}>
            <span aria-hidden="true">♫</span>
            Load Spotify player
          </button>
        </div>
        <a class="track-card__link" href={spotifyTrackUrl(item)} target="_blank" rel="noopener noreferrer">
          Open exact track in Spotify <span aria-hidden="true">↗</span>
        </a>
      </article>
    ))}
  </div>
  <div class="track-comparison__notes">
    <p><strong>Listen for</strong>{pair.listenFor}</p>
    <p><strong>Why it is here</strong>{pair.connection}</p>
  </div>
</section>

<script>
  function installSpotifyPlayers() {
    document.querySelectorAll<HTMLElement>("[data-spotify-slot]").forEach((slot) => {
      const button = slot.querySelector<HTMLButtonElement>("[data-spotify-load]");
      if (!button || button.dataset.ready === "true") return;
      button.dataset.ready = "true";

      button.addEventListener("click", () => {
        const spotifyId = slot.dataset.spotifyId;
        if (!spotifyId) return;
        const iframe = document.createElement("iframe");
        iframe.src = `https://open.spotify.com/embed/track/${encodeURIComponent(spotifyId)}?utm_source=generator&theme=0`;
        iframe.title = button.getAttribute("aria-label")?.replace(/^Load /, "") ?? "Spotify track";
        iframe.loading = "lazy";
        iframe.allow = "autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture";
        iframe.referrerPolicy = "strict-origin-when-cross-origin";
        slot.replaceChildren(iframe);
      }, { once: true });
    });
  }

  installSpotifyPlayers();
  document.addEventListener("astro:page-load", installSpotifyPlayers);
</script>

<style>
  .track-comparison {
    margin-block: 2.6rem !important;
    overflow: hidden;
    border: 1px solid rgb(232 224 196 / 0.25);
    border-radius: 0.4rem;
    background: #090d0f;
    box-shadow: 0.55rem 0.6rem 0 rgb(0 0 0 / 0.22);
  }

  header {
    padding: 1rem 1.1rem 0.9rem;
    border-bottom: 4px solid #e54b4b;
    background: linear-gradient(100deg, rgb(229 75 75 / 0.15), transparent 58%);
  }

  header span,
  .track-card__label {
    color: #79d8e7;
    font: 750 0.63rem/1.3 var(--font-mono), monospace;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h3,
  h4,
  p {
    margin: 0 !important;
  }

  h3 {
    margin-top: 0.22rem !important;
    color: #f2eddf;
    font-size: 1.12rem;
  }

  .track-comparison__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .track-card {
    min-width: 0;
    padding: 1rem;
  }

  .track-card + .track-card {
    border-left: 1px solid rgb(232 224 196 / 0.16);
  }

  h4 {
    margin-top: 0.34rem !important;
    color: #f5f3eb;
    font-size: 0.9rem;
  }

  .track-card__meta {
    min-height: 2.8rem;
    margin-top: 0.2rem !important;
    color: #9ba6a4;
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .track-card__embed {
    display: grid;
    min-height: 8.7rem;
    margin-top: 0.8rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgb(30 215 96 / 0.24);
    border-radius: 0.7rem;
    background: linear-gradient(140deg, rgb(30 215 96 / 0.1), rgb(2 5 3 / 0.9));
  }

  .track-card__embed :global(iframe) {
    display: block;
    width: 100%;
    height: 152px;
    border: 0;
  }

  button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.72rem 0.85rem;
    color: #e8f7ed;
    border: 1px solid rgb(84 235 136 / 0.7);
    border-radius: 999px;
    background: #08150c;
    font: 700 0.68rem/1 var(--font-mono), monospace;
    cursor: pointer;
  }

  button:hover,
  button:focus-visible {
    outline: 2px solid #54eb88;
    outline-offset: 2px;
  }

  .track-card__link {
    display: inline-block;
    margin-top: 0.7rem;
    color: #65e88f !important;
    font: 700 0.66rem/1.4 var(--font-mono), monospace;
  }

  .track-comparison__notes {
    display: grid;
    gap: 0.6rem;
    padding: 0.9rem 1rem 1rem;
    color: #acb5b2;
    border-top: 1px solid rgb(232 224 196 / 0.14);
    background: #0d1315;
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .track-comparison__notes strong {
    display: block;
    color: #f1c85c;
    font: 750 0.62rem/1.3 var(--font-mono), monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 39rem) {
    .track-comparison__grid {
      grid-template-columns: 1fr;
    }

    .track-card + .track-card {
      border-top: 1px solid rgb(232 224 196 / 0.16);
      border-left: 0;
    }

    .track-card__meta {
      min-height: 0;
    }
  }
</style>
