---
type KofiTipCardVariant = "band" | "footer";

interface Props {
  variant: KofiTipCardVariant;
  placement: string;
  href?: string;
  class?: string;
}

const {
  variant,
  placement,
  href = "https://ko-fi.com/hobfarm",
  class: className,
} = Astro.props as Props;

const linkClasses = [
  "inline-flex",
  "min-h-11",
  "w-full",
  "items-center",
  "justify-center",
  "gap-2",
  "rounded-full",
  "bg-linear-to-r",
  "from-accent-violet",
  "to-accent-green-dim",
  "px-5",
  "py-3",
  "text-center",
  "text-sm",
  "font-semibold",
  "text-base-950",
  "shadow-dimensional",
  "transition-colors",
  "hover:from-accent-violet-bright",
  "hover:to-accent-green",
  "focus-visible:outline-2",
  "focus-visible:outline-offset-4",
  "focus-visible:outline-accent-green-bright",
  "motion-reduce:transition-none",
  "sm:w-auto",
];
---

{
  variant === "band" ? (
    <aside
      class:list={[
        "grid gap-5 rounded-lg border border-base-700 bg-linear-to-r from-accent-950/65 via-base-950 to-accent-green-dim/10 p-5 shadow-dimensional sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:p-6",
        className,
      ]}
      aria-labelledby="homepage-support-heading"
    >
      <div>
        <p class="font-mono text-[10px] uppercase tracking-widest text-accent-green-bright">
          No mysterious pile of money
        </p>
        <h2 id="homepage-support-heading" class="mt-2 font-display text-xl leading-tight text-white">
          HobFarm is independently published.
        </h2>
        <p class="mt-2 max-w-3xl text-sm leading-relaxed text-base-300">
          Tips pay for hosting, tools, reporting, and whatever gets built next.
        </p>
      </div>
      <a
        class:list={linkClasses}
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Tip HobFarm on Ko-fi (opens in a new tab)"
        data-support-provider="kofi"
        data-support-placement={placement}
      >
        <span>Tip HobFarm</span>
        <svg class="size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M8 5h11v11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="m19 5-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M16 13v6H5V8h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </aside>
  ) : (
    <section
      class:list={[
        "w-full border-y border-base-700 bg-linear-to-r from-accent-950/70 via-base-950 to-accent-green-dim/10",
        className,
      ]}
      aria-label="Support HobFarm"
    >
      <div class="mx-auto flex max-w-7xl flex-col gap-5 px-4 py-7 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
        <p class="max-w-4xl text-base leading-relaxed text-base-200">
          HobFarm is built by one person. Early support helps it become a larger independent publishing operation.
        </p>
        <a
          class:list={linkClasses}
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Tip HobFarm on Ko-fi (opens in a new tab)"
          data-support-provider="kofi"
          data-support-placement={placement}
        >
          <span>Tip HobFarm</span>
          <svg class="size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M8 5h11v11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <path d="m19 5-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M16 13v6H5V8h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </section>
  )
}
