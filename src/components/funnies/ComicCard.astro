---
import type { Comic } from "@/lib/comics";
import { comicPath } from "@/lib/comics";
import { getSeriesTitle } from "@/data/comic-series";
import { imageSrcset, transformImageUrl } from "@/lib/media-transforms";

interface Props {
  comic: Comic;
}

const { comic } = Astro.props;
const { title, image, imageAlt, caption, series } = comic.data;
const src = transformImageUrl(image, { width: 640, quality: 82, fit: "cover" });
const srcset = imageSrcset(image, [320, 480, 640, 900], { quality: 82, fit: "cover" });
---

<a
  href={comicPath(comic)}
  class="group flex flex-col overflow-hidden rounded-lg border border-base-800 bg-base-900/50 transition-colors hover:border-accent-green/50"
>
  <div class="aspect-[4/3] overflow-hidden bg-base-950">
    <img
      src={src}
      srcset={srcset}
      sizes="(min-width: 1024px) 320px, (min-width: 640px) 50vw, 100vw"
      alt={imageAlt || title}
      class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="flex flex-1 flex-col p-4">
    <p class="font-mono text-[10px] uppercase tracking-widest text-accent-green">
      {getSeriesTitle(series)}
    </p>
    <h3 class="mt-2 font-display text-base text-white">{title}</h3>
    {caption && <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-base-400">{caption}</p>}
  </div>
</a>
