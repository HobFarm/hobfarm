---
import type { ResolvedRelatedContent } from "@/lib/content-relationships";
import { relatedContentKindLabels } from "@/lib/content-relationships";

interface Props {
  items: ResolvedRelatedContent[];
  heading?: string;
  id?: string;
}

const {
  items,
  heading = "Continue through HobFarm",
  id = "related-content-heading",
} = Astro.props;
---

{items.length > 0 && (
  <section class="related-content" aria-labelledby={id}>
    <div class="related-content__header">
      <p>Connected work</p>
      <h2 id={id}>{heading}</h2>
    </div>
    <div class="related-content__rail">
      {items.map((item) => (
        <a href={item.href} class="related-content__card">
          <span>{relatedContentKindLabels[item.kind]}</span>
          <h3>{item.label}</h3>
          {item.description && <p>{item.description}</p>}
          <strong>Open &rarr;</strong>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-content { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid #2c2440; }
  .related-content__header > p { margin: 0; color: #6b6580; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; }
  .related-content__header h2 { margin: .65rem 0 0; color: #ece9f5; font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 300; }
  .related-content__rail { display: grid; grid-auto-columns: minmax(min(18rem, 82vw), 1fr); grid-auto-flow: column; gap: .75rem; margin-top: 1.25rem; padding-bottom: .5rem; overflow-x: auto; scroll-snap-type: x proximity; }
  .related-content__card { display: flex; min-height: 15rem; flex-direction: column; padding: 1.25rem; border: 1px solid #2c2440; border-radius: .75rem; background: rgba(14, 11, 22, .72); color: inherit; text-decoration: none; scroll-snap-align: start; }
  .related-content__card:hover { border-color: #6b6580; }
  .related-content__card > span { color: #55d7ff; font-family: var(--font-mono); font-size: .58rem; letter-spacing: .13em; text-transform: uppercase; }
  .related-content__card h3 { margin: 1rem 0 0; color: #fff; font-family: var(--font-display); font-size: 1.35rem; font-weight: 400; line-height: 1.1; }
  .related-content__card p { margin: .75rem 0 0; color: #9b96ad; font-size: .82rem; line-height: 1.6; }
  .related-content__card strong { margin-top: auto; padding-top: 1.25rem; color: #ece9f5; font-family: var(--font-mono); font-size: .62rem; font-weight: 400; letter-spacing: .1em; text-transform: uppercase; }
  @media (min-width: 900px) { .related-content__rail { grid-auto-columns: minmax(17rem, 1fr); } }
</style>
