---
export type BreadcrumbItem = { label: string; href?: string };
interface Props { items: BreadcrumbItem[]; }
const { items } = Astro.props;
const origin = Astro.site?.origin ?? "https://hob.farm";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, origin).toString() } : {}),
  })),
};
---
<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol>
    {items.map((item, index) => <li>{item.href && index < items.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current={index === items.length - 1 ? "page" : undefined}>{item.label}</span>}</li>)}
  </ol>
</nav>
<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
<style>
  .breadcrumbs { overflow-x: auto; }
  ol { display: flex; width: max-content; align-items: center; gap: .55rem; margin: 0; padding: 0; list-style: none; }
  li { display: flex; align-items: center; gap: .55rem; color: #6b6580; font-family: var(--font-mono); font-size: .65rem; letter-spacing: .08em; text-transform: uppercase; }
  li + li::before { content: "/"; color: #433559; }
  a { color: #9b96ad; text-decoration: none; }
  span[aria-current="page"] { color: #9b96ad; }
  a:hover, a:focus-visible { color: white; }
</style>
