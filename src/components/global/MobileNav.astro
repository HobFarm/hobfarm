---
// Fundations
import Button from "@/components/fundations/elements/Button.astro";
// Icons
import Menu from "@/components/fundations/icons/Menu.astro";
import Close from "@/components/fundations/icons/Close.astro";
interface Props {
  navLinks: { label: string; href: string; children?: { label: string; href: string }[] }[];
}
const { navLinks } = Astro.props;
---

<div class="md:hidden">
  <!-- Mobile Menu Toggle -->
  <Button
    iconOnly
    size="sm"
    variant="default"
    id="menu-toggle"
    aria-label="Toggle main menu"
    aria-expanded="false"
    aria-controls="mobile-menu"
    type="button"
  >
    <Menu slot="icon" size="sm" id="menu-icon" />
    <Close slot="icon" size="sm" class="hidden" id="close-icon" />
  </Button>
  <!-- Mobile Menu -->
  <nav
    id="mobile-menu"
    inert
    aria-hidden="true"
    class="absolute left-4 mt-8 right-4 top-full grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out"
  >
    <div class="overflow-hidden">
      <div class="max-h-[calc(100vh-6rem)] overflow-y-auto flex flex-col gap-2 p-8 bg-base-900 rounded-xl">
        {
          navLinks.map((link) => link.children ? (
            <div class="relative border-b border-base-800 pb-2">
              <a href={link.href} class="block pr-10 text-xl text-white hover:text-base-300">{link.label}</a>
              <button
                type="button"
                data-mobile-submenu-toggle
                aria-label={`Toggle ${link.label} links`}
                aria-expanded="false"
                aria-controls={`mobile-submenu-${link.label.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
                class="absolute right-0 top-0 grid size-8 cursor-pointer place-items-center text-base-500"
              >
                <span class="transition-transform" aria-hidden="true">+</span>
              </button>
              <div
                id={`mobile-submenu-${link.label.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}
                hidden
                class="mt-3 grid gap-2 border-l border-base-700 pl-4"
              >
                {link.children.map((child) => <a href={child.href} class="text-sm text-base-300 hover:text-white">{child.label}</a>)}
              </div>
            </div>
          ) : (
            <a title={link.label} aria-label={link.label} href={link.href} class="hover:text-base-400 text-white text-xl">{link.label}</a>
          ))
        }
        <button
          type="button"
          data-search-trigger
          aria-label="Search HobFarm"
          class="text-left hover:text-base-400 text-white text-xl"
        >
          Search
        </button>
        <div class="mt-12">
          <Button
            isLink
            size="sm"
            variant="green"
            href="/account/"
            class="w-full"
          >
            Account
          </Button>
        </div>
      </div>
    </div>
  </nav>
</div>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon");
    const closeIcon = document.getElementById("close-icon");
    if (!menuToggle || !mobileMenu || !menuIcon || !closeIcon) return;

    const submenuToggles = mobileMenu.querySelectorAll<HTMLButtonElement>("[data-mobile-submenu-toggle]");

    submenuToggles.forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const panelId = toggle.getAttribute("aria-controls");
        const panel = panelId ? document.getElementById(panelId) : null;
        if (!panel) return;
        const willOpen = toggle.getAttribute("aria-expanded") !== "true";
        toggle.setAttribute("aria-expanded", String(willOpen));
        panel.hidden = !willOpen;
        toggle.querySelector("span")?.classList.toggle("rotate-45", willOpen);
      });
    });

    let isMenuOpen = false;

    // Initial closed-state ARIA wiring
    menuToggle.setAttribute("aria-expanded", "false");
    menuToggle.setAttribute("aria-controls", "mobile-menu");
    mobileMenu.setAttribute("inert", "");
    mobileMenu.setAttribute("aria-hidden", "true");

    function applyState() {
      if (isMenuOpen) {
        mobileMenu.classList.remove("grid-rows-[0fr]");
        mobileMenu.classList.add("grid-rows-[1fr]");
        mobileMenu.removeAttribute("inert");
        mobileMenu.removeAttribute("aria-hidden");
        menuToggle.setAttribute("aria-expanded", "true");
      } else {
        submenuToggles.forEach((toggle) => {
          const panelId = toggle.getAttribute("aria-controls");
          const panel = panelId ? document.getElementById(panelId) : null;
          toggle.setAttribute("aria-expanded", "false");
          toggle.querySelector("span")?.classList.remove("rotate-45");
          if (panel) panel.hidden = true;
        });
        mobileMenu.classList.remove("grid-rows-[1fr]");
        mobileMenu.classList.add("grid-rows-[0fr]");
        mobileMenu.setAttribute("inert", "");
        mobileMenu.setAttribute("aria-hidden", "true");
        menuToggle.setAttribute("aria-expanded", "false");
      }
      menuIcon.classList.toggle("hidden", isMenuOpen);
      closeIcon.classList.toggle("hidden", !isMenuOpen);
    }

    function toggleMenu() {
      isMenuOpen = !isMenuOpen;
      applyState();
    }

    function handleResize() {
      if (window.innerWidth >= 768 && isMenuOpen) {
        isMenuOpen = false;
        applyState();
      }
    }

    menuToggle.addEventListener("click", toggleMenu);
    window.addEventListener("resize", handleResize);
  });
</script>
