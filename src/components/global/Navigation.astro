---
// Fundations
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import MobileNav from "@/components/global/MobileNav.astro";
import SearchIcon from "@/components/fundations/icons/Search.astro";
import { topNavLinks as navLinks } from "@/data/navigation";

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  const sectionPath = href.endsWith("/") ? href : `${href}/`;
  return currentPath === href || currentPath.startsWith(sectionPath);
}
---

<div
  id="nav-wrapper"
  class="mx-auto fixed top-0 w-full py-4 inset-x-0 z-100 transition-all duration-300 ease-in-out"
>
  <Wrapper class="standard">
    <div
      id="navigation-wrapper"
      class="relative flex items-center justify-between"
    >
      <!-- Logo -->
      <a
        href="/"
        aria-label="Go to homepage"
        title="Homepage"
        class="shrink-0"
      >
        <img
          src="https://cdn.hob.farm/brand/hobfarm-logo-white.svg"
          alt="HobFarm"
          class="h-8"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-6">
        {
          navLinks.map((link) => link.children ? (
            <div class="nav-group">
              <a
                title={link.label}
                aria-label={link.label}
                href={link.href}
                aria-haspopup="true"
                class:list={["text-sm transition-colors", isActive(link.href) ? "text-white border-b border-accent-500" : "text-base-400 hover:text-base-300"]}
              >{link.label}</a>
              <div class="nav-menu" role="menu">
                {link.children.map((child) => <a role="menuitem" href={child.href}>{child.label}</a>)}
              </div>
            </div>
          ) : (
            <a
              title={link.label}
              aria-label={link.label}
              href={link.href}
              class:list={[
                "text-sm transition-colors",
                isActive(link.href)
                  ? "text-white border-b border-accent-500"
                  : "text-base-400 hover:text-base-300",
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <!-- Search: opens the global Search modal via the delegated
             [data-search-trigger] hook in Search.astro. -->
        <button
          type="button"
          data-search-trigger
          aria-label="Search HobFarm"
          title="Search"
          class="text-base-400 hover:text-white transition-colors"
        >
          <SearchIcon size="sm" />
        </button>
        <!-- Account owns the authentication redirect. Keeping this link
             static avoids probing session state from every public page. -->
        <Button
          isLink
          size="sm"
          variant="green"
          href="/account/"
        >
          Account
        </Button>
      </nav>

      <!-- Mobile Navigation -->
      <MobileNav navLinks={navLinks} />
    </div>
  </Wrapper>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const navWrapper = document.getElementById("nav-wrapper");
    const scrollThreshold = 20;

    function handleScroll() {
      const scrolled = window.scrollY > scrollThreshold;

      navWrapper.classList.toggle("backdrop-blur-md", scrolled);
      navWrapper.classList.toggle("bg-base-950/80", scrolled);
      navWrapper.classList.toggle("py-2", scrolled);
      navWrapper.classList.toggle("py-4", !scrolled);
    }

    window.addEventListener("scroll", handleScroll);
    handleScroll();

  });
</script>

<style>
  .nav-group { position: relative; padding-block: .6rem; }
  .nav-menu { position: absolute; top: 100%; left: 50%; display: grid; min-width: 16rem; padding: .65rem; border: 1px solid #2c2440; border-radius: .7rem; background: rgb(14 11 22 / 97%); box-shadow: 0 1rem 3rem rgb(0 0 0 / 35%); opacity: 0; pointer-events: none; transform: translate(-50%, -.35rem); transition: opacity 160ms ease, transform 160ms ease; }
  .nav-menu a { padding: .62rem .7rem; border-radius: .4rem; color: #c8c6d4; font-size: .78rem; text-decoration: none; white-space: nowrap; }
  .nav-menu a:hover, .nav-menu a:focus-visible { background: #221a33; color: white; outline: none; }
  .nav-group:hover .nav-menu, .nav-group:focus-within .nav-menu { opacity: 1; pointer-events: auto; transform: translate(-50%, 0); }
  @media (prefers-reduced-motion: reduce) { .nav-menu { transition: none; } }
</style>
