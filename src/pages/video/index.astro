---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Eyebrow from "@/components/sections/Eyebrow.astro";
import Button from "@/components/fundations/elements/Button.astro";
import GalleryCard from "@/components/gallery/GalleryCard.astro";
import ArticleCard from "@/components/articles/ArticleCard.astro";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import { getCollection } from "astro:content";
import { getPublishedArticles } from "@/lib/articles";

// Shows live as project entries under projects/hobfarm-tv/. Same query the
// HobFarm TV hub uses, so new shows appear here automatically.
const shows = (await getCollection("projects"))
  .filter((p) => p.id.startsWith("hobfarm-tv/"))
  .sort((a, b) => a.data.order - b.data.order);

const showPath = (id: string) =>
  id === "hobfarm-tv/3-degrees-of-dick-miller"
    ? "/presents/3-degrees-of-dick-miller/"
    : `/projects/${id.replace(/\.md$/, "")}/`;

// Any gallery piece whose hero is a video, or that lives in the motion lane.
const clips = (await getCollection("gallery"))
  .filter((e) => !e.data.draft && (e.data.hero.type === "video" || e.data.type === "video-workflow"))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));

// Articles that are themselves a video/trailer (future-proofing the format).
const videoArticles = (await getPublishedArticles()).filter((p) =>
  ["video", "trailer"].includes(p.data.format ?? ""),
);
---

<BaseLayout
  title="Video Archive | HobFarm"
  description="HobFarm video archive: short videos, trailers, animated posters, avatar bits, critter clips, and story-world fragments from HobFarm Presents and the wider feed."
  canonical="/video/"
>
  <section class="bg-noise">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <div class="max-w-2xl">
          <Eyebrow text="HobFarm / Video Archive" />
          <Text tag="h1" variant="display2XL" class="mt-6 font-display text-white text-balance">
            Video Archive
          </Text>
          <Text tag="p" variant="textLG" class="mt-5 text-base-400 leading-relaxed text-pretty">
            Short videos, trailers, animated posters, avatar bits, critter clips, and story-world fragments. This route stays as a filterable archive; the primary homes are departments, projects, visual systems, and workshop notes.
          </Text>
          <div class="mt-6 flex flex-wrap gap-3">
            <Button isLink size="base" variant="default" href="https://www.youtube.com/@HobFarm" target="_blank" rel="noopener noreferrer">
              Subscribe on YouTube
            </Button>
            <Button isLink size="base" variant="muted" href="/presents/">
              HobFarm Presents
            </Button>
          </div>
        </div>

        {shows.length > 0 && (
          <div class="mt-16">
            <Text tag="h2" variant="displaySM" class="mb-6 font-display text-white">The Shows</Text>
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
              {shows.map((show) => (
                <a
                  href={showPath(show.id)}
                  class="group flex flex-col rounded-xl border border-base-800 bg-base-900/50 p-6 transition-colors hover:border-accent-violet/40"
                >
                  <div class="mb-1.5"><StatusBadge status={show.data.status} /></div>
                  <Text tag="h3" variant="textXL" class="font-medium text-white">{show.data.title}</Text>
                  <Text tag="p" variant="textBase" class="mt-3 flex-1 leading-relaxed text-base-400">
                    {show.data.subtitle}
                  </Text>
                  <span class="mt-6 font-mono text-sm uppercase tracking-wider text-accent-violet-bright">
                    View show &rarr;
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}

        {clips.length > 0 && (
          <div class="mt-16 border-t border-base-800 pt-10">
            <div class="mb-6 flex items-end justify-between gap-4">
              <Text tag="h2" variant="displaySM" class="font-display text-white">Clips &amp; motion</Text>
              <a
                href="/gallery/"
                class="font-mono text-[10px] uppercase tracking-wider text-base-400 transition-colors hover:text-white"
              >
                Open Gallery &rarr;
              </a>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {clips.map((entry) => <GalleryCard entry={entry} />)}
            </div>
          </div>
        )}

        {videoArticles.length > 0 && (
          <div class="mt-16 border-t border-base-800 pt-10">
            <Text tag="h2" variant="displaySM" class="mb-6 font-display text-white">From the feed</Text>
            <div class="grid grid-cols-1 gap-x-4 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
              {videoArticles.map((post) => <ArticleCard post={post} />)}
            </div>
          </div>
        )}
      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>
