---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Breadcrumbs from "@/components/global/Breadcrumbs.astro";

const description =
  "EZIZE is HobFarm's probability machine for collectible images. Insert one EZ coin to get a finished Cake, Critter, or Character with a unique ID and Generation Path Odds.";
const appUrl = "https://ezize.hob.farm/";
const cdnRoot = "https://cdn.hob.farm/ezize";
const socialImage = `${cdnRoot}/ezize-hero.png`;
const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const canonicalUrl = new URL("/ezize/", siteOrigin).toString();

const imageUrl = (filename: string, width: number, quality = 82) =>
  `https://cdn.hob.farm/cdn-cgi/image/width=${width},quality=${quality},format=auto/ezize/${encodeURIComponent(filename)}`;
const imageSrcSet = (filename: string, widths: number[]) =>
  widths.map((width) => `${imageUrl(filename, width)} ${width}w`).join(", ");

const forms = [
  {
    name: "Cake",
    file: "ezize-efb0ab2e5ad02c37.png",
    alt: "An EZIZE cake with white frosting, chocolate layers, cherries, daisies, and a smiling face",
    text: "A built edible object with shape, layers, flavor, frosting, decorations, presentation, and scene logic.",
  },
  {
    name: "Critter",
    file: "ezize-d6b613e86a33f971.png",
    alt: "A colorful EZIZE otter-like critter with pink and teal striped body details",
    text: "An animal-led figure assembled from species, body logic, behavior, setting, props, and modifiers.",
  },
  {
    name: "Character",
    file: "ezize-76bd76d0a0822404.png",
    alt: "A smiling EZIZE character in an ocean-inspired outfit in a warm geometric landscape",
    text: "A persona-driven figure with a role, wardrobe, action, body traits, environment, and other authored choices.",
  },
];

const selectionLayers = [
  "authored vocabularies",
  "weighted choices",
  "compatible relationships",
  "conditional branches",
  "versioned rules",
  "deterministic selections",
];

const pricePacks = [
  { coins: 5, price: "$5" },
  { coins: 10, price: "$9" },
  { coins: 20, price: "$17" },
  { coins: 50, price: "$42" },
  { coins: 100, price: "$80" },
];

const gallery = [
  {
    id: "EZ-3FA18FC59D7DB51E",
    label: "Critter pull",
    file: "ezize-3fa18fc59d7db51e.png",
    alt: "A red and black glossy frog-like EZIZE critter surrounded by heart and ritual motifs",
  },
  {
    id: "EZ-7F0E17704D1E71C8",
    label: "Corrupted Cake",
    file: "ezize-7f0e17704d1e71c8.png",
    alt: "A dark chocolate and mushroom Corrupted Cake in a vivid gothic laboratory",
  },
  {
    id: "EZ-9AD6FC992BC91702",
    label: "Cake pull",
    file: "ezize-9ad6fc992bc91702.png",
    alt: "An ivory and purple crystal-studded EZIZE cake in a theatrical gothic setting",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteOrigin}/#organization`,
      name: "HobFarm",
      url: `${siteOrigin}/`,
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: "EZIZE: The HobFarm Probability Machine",
      description,
      image: socialImage,
      publisher: { "@id": `${siteOrigin}/#organization` },
      mainEntity: { "@id": `${canonicalUrl}#application` },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${canonicalUrl}#application`,
      name: "EZIZE",
      applicationCategory: "MultimediaApplication",
      operatingSystem: "Web browser",
      url: appUrl,
      description,
      creator: { "@id": `${siteOrigin}/#organization` },
      offers: {
        "@type": "AggregateOffer",
        priceCurrency: "USD",
        lowPrice: "5",
        highPrice: "80",
        offerCount: "5",
      },
    },
  ],
};
---

<BaseLayout
  title="EZIZE: The HobFarm Probability Machine"
  description={description}
  canonical={canonicalUrl}
  image={socialImage}
  imageAlt="The EZIZE machine surrounded by Cute and Corrupted Cakes, Critters, and Characters"
  structuredData={structuredData}
  palette="purple-green"
>
  <div class="ezize-page">
    <Wrapper class="crumb-wrap">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "EZIZE" }]} />
    </Wrapper>

    <Wrapper class="hero-wrap">
      <section class="hero" aria-labelledby="ezize-title">
        <img
          class="hero-image"
          src={socialImage}
          width="1672"
          height="941"
          alt="The EZIZE vending machine surrounded by Cute and Corrupted Cakes, Critters, and Characters"
          decoding="async"
          fetchpriority="high"
        />
        <div class="hero-shade"></div>
        <div class="hero-copy">
          <p class="kicker">The HobFarm probability machine</p>
          <div class="hero-title-row">
            <h1 id="ezize-title">EZIZE</h1>
            <p class="burst burst-two" aria-hidden="true">1 COIN = 1 EZ</p>
          </div>
          <p class="hero-line">Insert coin.<br />Get a collectible EZ.<br />It's that EZ.</p>
          <p class="hero-dek">
            An EZ is a collectible image, like a digital trading card. Each one has a unique ID and Generation Path Odds showing how likely that combination is to be chosen again.
          </p>
          <div class="hero-actions">
            <a class="machine-button" href={appUrl}>Open the machine <span aria-hidden="true">→</span></a>
            <a class="text-link" href="#how-it-works">See how a pull works</a>
          </div>
        </div>
      </section>
    </Wrapper>

    <Wrapper class="pull-wrap" id="how-it-works">
      <ol class="pull-path" aria-label="EZIZE in three steps">
        <li><span>01</span><strong>Insert coin</strong></li>
        <li><span>02</span><strong>Get a collectible EZ</strong></li>
        <li><span>03</span><strong>It's that EZ</strong></li>
      </ol>
    </Wrapper>

    <Wrapper class="section-space cabinet-space">
      <section aria-labelledby="ez-definition-title">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow">What is an EZ?</p>
            <h2 id="ez-definition-title">A collectible image with its own ID and probability score.</h2>
          </div>
          <p>
            Think of it like a digital trading card. Each EZ is a finished Cake, Critter, or Character with a unique EZ ID and Generation Path Odds, the theoretical chance that the same version of EZIZE would choose that combination again.
          </p>
        </div>
        <div class="form-grid">
          {forms.map((form) => (
            <article class="form-card">
              <img
                src={imageUrl(form.file, 640)}
                srcset={imageSrcSet(form.file, [420, 640, 900])}
                sizes="(min-width: 900px) 30vw, 92vw"
                width="2336"
                height="3504"
                alt={form.alt}
                loading="lazy"
                decoding="async"
              />
              <div class="form-copy">
                <p class="form-number">FORM</p>
                <h3>{form.name}</h3>
                <p>{form.text}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="persona-strip" aria-label="EZIZE personas">
          <article>
            <span class="persona-face" aria-hidden="true">☺</span>
            <div><p class="eyebrow">Persona one</p><h3>Cute</h3><p>Warm, playful, appealing, and deliberately constructed. Cute has its own vocabulary and rules.</p></div>
          </article>
          <article class="corrupted">
            <span class="persona-face" aria-hidden="true">☠</span>
            <div><p class="eyebrow">Persona two</p><h3>Corrupted</h3><p>Mutated, damaged, uncanny, and still intentional. Corrupted owns the transformation instead of applying a generic horror filter.</p></div>
          </article>
        </div>
      </section>
    </Wrapper>

    <section class="decision-band" aria-labelledby="decision-title">
      <Wrapper>
        <div class="decision-grid">
          <div>
            <p class="eyebrow">The authored machine</p>
            <h2 id="decision-title">AI renders the final image. EZIZE decides what image to ask for.</h2>
          </div>
          <div class="decision-copy">
            <p>
              EZIZE is not a prompt box. The machine assembles a generation path from authored vocabularies, weights, relationships, compatibility rules, and conditional branches. The renderer turns that resolved instruction into an image.
            </p>
            <p>
              Those rules live in versioned contracts. That keeps the selection logic inspectable and lets HobFarm calculate the theoretical odds of a path without pretending the rendered pixels are mathematically unique.
            </p>
          </div>
        </div>
        <ul class="selection-list">
          {selectionLayers.map((layer, index) => <li><span>{String(index + 1).padStart(2, "0")}</span>{layer}</li>)}
        </ul>
      </Wrapper>
    </section>

    <Wrapper class="section-space">
      <section class="odds-section" aria-labelledby="odds-title">
        <div class="odds-ticket">
          <div class="ticket-stub">
            <p>EZIZE</p>
            <strong>GENERATION<br />PATH ODDS</strong>
            <span>CALCULATED AFTER PULL</span>
          </div>
          <div class="ticket-body">
            <p class="eyebrow">A precise claim</p>
            <h2 id="odds-title">What the probability score means</h2>
            <p class="definition">
              Generation Path Odds are the theoretical chance that the same version of EZIZE would make the same sequence of weighted selections again.
            </p>
            <p class="caveat">
              Generation Path Odds do not mean an identical pixel-for-pixel image would render again. They describe the machine's selection path.
            </p>
            <div class="odds-example">
              <div><span>EZ ID</span><strong>EZ-76BD76D0A0822404</strong></div>
              <div><span>FORM</span><strong>Character</strong></div>
              <div><span>PERSONA</span><strong>Cute</strong></div>
              <div><span>ODDS</span><strong>Recorded with the pull</strong></div>
            </div>
            <p class="fine-print">
              The odds are not a count of images generated, sold, or available. EZIZE does not turn them into artificial rarity tiers.
            </p>
          </div>
        </div>
      </section>
    </Wrapper>

    <Wrapper class="section-space compact-top">
      <section class="receipt-grid" aria-labelledby="receipt-title">
        <div>
          <p class="eyebrow">One coin, one complete pull</p>
          <h2 id="receipt-title">Every EZ comes with an ID and a record.</h2>
          <p class="lede">
            Every finished collectible receives a unique EZ ID, a filename, a timestamp, a private HobFarm generation record, and an account receipt. The ID identifies the result. It is not a claim that no similar image could ever exist.
          </p>
        </div>
        <div class="receipt-card">
          <div class="receipt-head"><strong>EZIZE RECEIPT</strong><span>COMPLETE</span></div>
          <dl>
            <div><dt>EZ ID</dt><dd>EZ-76BD76D0A0822404</dd></div>
            <div><dt>Form</dt><dd>Character</dd></div>
            <div><dt>Persona</dt><dd>Cute</dd></div>
            <div><dt>Output</dt><dd>High-resolution PNG</dd></div>
            <div><dt>Path odds</dt><dd>Included</dd></div>
            <div><dt>Timestamp</dt><dd>Included</dd></div>
          </dl>
        </div>
        <div class="included-card">
          <h3>You receive</h3>
          <ul>
            <li>the finished high-resolution PNG</li>
            <li>the EZ ID and filename</li>
            <li>form, persona, timestamp, and odds</li>
            <li>an account receipt for the pull</li>
          </ul>
        </div>
        <div class="included-card private-card">
          <h3>The machine keeps private</h3>
          <ul>
            <li>the seed and raw genome</li>
            <li>the full decision trace and provider prompt</li>
            <li>schemas, pack data, and exact weights</li>
            <li>private code and internal generation records</li>
          </ul>
        </div>
      </section>
    </Wrapper>

    <section class="derivative-band" aria-labelledby="derivative-title">
      <Wrapper>
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow">One EZ can keep going</p>
            <h2 id="derivative-title">The original, then the things made from it.</h2>
          </div>
          <p>
            The PNG made by the pull is the canonical EZ. Character sheets, animation, products, stories, and other extensions are later derivative work. EZIZE does not create them automatically.
          </p>
        </div>
        <div class="derivative-grid">
          <figure class="original-figure">
            <img
              src={imageUrl("ezize-76bd76d0a0822404.png", 760)}
              srcset={imageSrcSet("ezize-76bd76d0a0822404.png", [520, 760, 1080])}
              sizes="(min-width: 900px) 40vw, 92vw"
              width="2336"
              height="3504"
              alt="The original Cute Character EZ-76BD76D0A0822404"
              loading="lazy"
              decoding="async"
            />
            <figcaption><span>01 / CANONICAL EZ</span><strong>EZ-76BD76D0A0822404.png</strong></figcaption>
          </figure>
          <figure class="sheet-figure">
            <img
              src={imageUrl("ezize-76bd76d0a0822404-sheet.png", 1000)}
              srcset={imageSrcSet("ezize-76bd76d0a0822404-sheet.png", [720, 1000, 1400])}
              sizes="(min-width: 900px) 48vw, 92vw"
              width="3840"
              height="2160"
              alt="A later four-view character sheet derived from EZ-76BD76D0A0822404"
              loading="lazy"
              decoding="async"
            />
            <figcaption><span>02 / LATER DERIVATIVE</span><strong>EZ-76BD76D0A0822404-sheet.png</strong></figcaption>
          </figure>
          <figure class="video-figure">
            <video controls muted loop playsinline preload="metadata" poster={imageUrl("ezize-76bd76d0a0822404.png", 720)} aria-label="A short animation derived from EZ-76BD76D0A0822404">
              <source src={`${cdnRoot}/ezize-76bd76d0a0822404.mp4`} type="video/mp4" />
              Your browser does not support embedded video.
            </video>
            <figcaption><span>03 / LATER DERIVATIVE</span><strong>EZ-76BD76D0A0822404-video.mp4</strong></figcaption>
          </figure>
        </div>
        <p class="derivative-note">Your output license lets you edit, animate, print, publish, merchandise, and build new work from your EZ, subject to applicable law and the full license.</p>
      </Wrapper>
    </section>

    <Wrapper class="section-space">
      <section aria-labelledby="gallery-title">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">From the machine</p><h2 id="gallery-title">Each collectible carries its EZ ID.</h2></div>
          <p>HobFarm may curate exceptional EZs into gallery features, character packages, stories, animation tests, or products. Outside platforms can help distribute selected work, but they do not define the machine or its records.</p>
        </div>
        <div class="gallery-grid">
          {gallery.map((item) => (
            <figure>
              <img src={imageUrl(item.file, 720)} srcset={imageSrcSet(item.file, [480, 720, 960])} sizes="(min-width: 900px) 30vw, 92vw" width="2336" height="3504" alt={item.alt} loading="lazy" decoding="async" />
              <figcaption><span>{item.label}</span><strong>{item.id}</strong></figcaption>
            </figure>
          ))}
        </div>
      </section>
    </Wrapper>

    <section class="coin-band" aria-labelledby="coin-title">
      <Wrapper>
        <div class="coin-intro">
          <div><p class="eyebrow">Load the machine</p><h2 id="coin-title">1 EZ coin = 1 complete collectible EZ.</h2></div>
          <p>EZ coins are prepaid machine credit. They are not cryptocurrency, blockchain tokens, an investment, or money you can withdraw. A free account keeps your balance and completed EZs connected to your verified email.</p>
        </div>
        <div class="price-grid">
          {pricePacks.map((pack) => (
            <article><p><strong>{pack.coins}</strong><span>EZ coins</span></p><span class="price">{pack.price}</span></article>
          ))}
        </div>
        <div class="account-grid">
          <article>
            <p class="eyebrow">Free account</p><h3>Your balance waits for you.</h3>
            <p>Sign in through a passwordless link sent to a verified email address. Logging out does not remove unused coins. Completed paid EZs remain recoverable from the account, subject to the service's retention policy.</p>
          </article>
          <article class="club-card">
            <p class="eyebrow">HobFarm Club · $5 monthly</p><h3>Five more pulls after every paid month.</h3>
            <p>Each successfully paid month adds five EZ coins. Coins stack. Canceling stops future billing and grants; it does not erase the existing balance or earlier EZs. Restarting resumes grants after successful payments. Normal packs stay available.</p>
          </article>
        </div>
        <div class="center-action">
          <a class="machine-button dark-button" href={appUrl}>Get started at EZIZE <span aria-hidden="true">→</span></a>
          <p>Account creation does not subscribe you to marketing email.</p>
        </div>
      </Wrapper>
    </section>

    <Wrapper class="section-space">
      <section class="rights-grid" aria-labelledby="rights-title">
        <div class="rights-callout">
          <p class="eyebrow">Output rights</p><h2 id="rights-title">YOUR EZ IS YOURS TO USE.</h2>
          <p>You receive broad permission to use the specific paid EZ output: personal work, commercial projects, edits, animation, prints, merchandise, publishing, and derivative work, subject to law, third-party rights, and the full EZIZE license.</p>
          <a class="text-link light-link" href="/ezize/license/">Read the output license →</a>
        </div>
        <div class="retained-callout">
          <p class="eyebrow">What stays with HobFarm</p><h3>The output license does not transfer the machine.</h3>
          <p>Your purchase does not transfer EZIZE or HobFarm names and logos, Grimoire, Wildcard, schemas, packs, weights, generation logic, algorithms, source code, APIs, documentation, the site, or anyone else's EZ.</p>
          <p>No promise is made that an AI-assisted output is copyrightable in every jurisdiction or that a rendered image is exclusively unique.</p>
        </div>
      </section>
    </Wrapper>

    <section class="legal-band" aria-labelledby="legal-title">
      <Wrapper>
        <div>
          <p class="eyebrow">Before you pull</p><h2 id="legal-title">Plain rules, visible from the product page.</h2>
          <p>Service messages cover account access, receipts, billing, security, recovery, and material service changes. Marketing requires a separate double opt-in.</p>
        </div>
        <nav aria-label="EZIZE legal information">
          <a href="/ezize/terms/"><span>01</span>Terms</a><a href="/ezize/privacy/"><span>02</span>Privacy</a><a href="/ezize/refunds/"><span>03</span>Refunds</a><a href="/ezize/license/"><span>04</span>Output license</a>
        </nav>
      </Wrapper>
    </section>

    <Wrapper class="final-wrap">
      <section class="final-cta" aria-labelledby="final-title">
        <p class="burst final-burst" aria-hidden="true">IT'S THAT EZ!</p><p class="eyebrow">Cakes · Critters · Characters</p>
        <h2 id="final-title">Insert coin. Get a collectible EZ.</h2>
        <a class="machine-button" href={appUrl}>Open EZIZE <span aria-hidden="true">→</span></a>
      </section>
    </Wrapper>
  </div>
</BaseLayout>

<style>
  :global(body) { background: #0b0b08; }
  .ezize-page { --ink: #0b0b08; --paper: #f5f1de; --lime: #dfff36; --orange: #ff684d; --cyan: #79e2dd; --line: rgba(245, 241, 222, .18); color: var(--paper); overflow: clip; }
  .crumb-wrap { padding-top: 1rem; padding-bottom: 1rem; }
  .hero-wrap { max-width: 96rem; }
  .hero { position: relative; min-height: 42rem; overflow: hidden; container-type: inline-size; border: 1px solid rgba(255,255,255,.16); background: #071a31; box-shadow: 0 2rem 7rem rgba(0,0,0,.44); isolation: isolate; }
  .hero-image, .hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-image { object-fit: cover; object-position: center; }
  .hero-shade { z-index: 1; background: linear-gradient(90deg, rgba(3,13,28,.98) 0%, rgba(3,13,28,.78) 31%, rgba(3,13,28,.08) 62%, rgba(3,13,28,.04) 100%); }
  .hero-copy { position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: center; width: min(36rem, 48%); min-height: 42rem; padding: clamp(2rem, 5vw, 5.5rem); }
  .hero-title-row { display: flex; align-items: center; gap: .7rem; }
  .kicker, .eyebrow { margin: 0 0 .8rem; font: 700 .72rem/1.2 var(--font-mono); letter-spacing: .13em; text-transform: uppercase; }
  .kicker { color: var(--lime); }
  h1, h2, h3, p { text-wrap: pretty; }
  h1 { margin: 0; color: #fff6c6; font: 900 clamp(4.6rem, 10vw, 9rem)/.8 var(--font-display); letter-spacing: -.075em; text-shadow: .07em .07em 0 #b52619, .11em .11em 0 rgba(0,0,0,.45); }
  .hero-line { margin: 1.6rem 0 .8rem; color: #fff; font: 800 clamp(1.8rem, 3vw, 3.1rem)/.96 var(--font-display); letter-spacing: -.035em; text-transform: uppercase; }
  .hero-dek { max-width: 31rem; margin: .8rem 0 0; color: rgba(255,255,255,.8); font-size: 1.04rem; line-height: 1.65; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.25rem; margin-top: 2rem; }
  .machine-button { display: inline-flex; align-items: center; justify-content: space-between; gap: 1.4rem; min-width: 13rem; padding: .95rem 1.15rem; border: 2px solid var(--ink); border-radius: .25rem; background: var(--lime); color: var(--ink); box-shadow: .38rem .38rem 0 var(--orange); font: 800 .76rem/1 var(--font-mono); letter-spacing: .07em; text-transform: uppercase; text-decoration: none; transition: transform .18s ease, box-shadow .18s ease; }
  .machine-button:hover, .machine-button:focus-visible { transform: translate(.18rem,.18rem); box-shadow: .2rem .2rem 0 var(--orange); }
  .text-link { color: #fff; font: 700 .75rem/1.4 var(--font-mono); letter-spacing: .04em; text-transform: uppercase; text-underline-offset: .3em; }
  .burst { position: absolute; z-index: 3; display: grid; place-items: center; width: 8rem; aspect-ratio: 1; margin: 0; padding: 1rem; clip-path: polygon(50% 0,61% 17%,79% 7%,82% 28%,100% 31%,87% 49%,100% 64%,79% 69%,78% 91%,59% 81%,47% 100%,38% 81%,17% 94%,17% 72%,0 64%,13% 47%,0 31%,21% 27%,24% 6%,42% 17%); background: var(--lime); color: var(--ink); font: 900 .76rem/1.05 var(--font-display); text-align: center; transform: rotate(8deg); filter: drop-shadow(.35rem .35rem 0 rgba(0,0,0,.4)); }
  .burst-two { position: static; flex: 0 0 auto; width: 6.25rem; background: var(--lime); color: var(--ink); font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif; font-size: .95rem; font-style: italic; letter-spacing: .025em; line-height: .9; transform: rotate(-8deg); }
  .pull-wrap { position: relative; z-index: 4; margin-top: -1.25rem; }
  .pull-path { display: grid; grid-template-columns: repeat(3,1fr); margin: 0; padding: 0; border: 2px solid var(--ink); background: var(--paper); color: var(--ink); box-shadow: .45rem .45rem 0 var(--orange); list-style: none; }
  .pull-path li { position: relative; display: flex; align-items: center; gap: .7rem; min-height: 4.8rem; padding: .9rem; border-right: 1px dashed rgba(11,11,8,.35); font: 700 .7rem/1.25 var(--font-mono); letter-spacing: .03em; text-transform: uppercase; }
  .pull-path li:last-child { border-right: 0; }
  .pull-path span { display: grid; flex: 0 0 auto; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 50%; background: var(--ink); color: var(--lime); font-size: .62rem; }
  .section-space { padding-top: clamp(5rem, 9vw, 9rem); padding-bottom: clamp(5rem, 9vw, 9rem); }
  :global(.cabinet-space) { padding-top: clamp(4.5rem, 8vw, 7.5rem); padding-bottom: clamp(5rem, 9vw, 9rem); }
  .compact-top { padding-top: 1rem; }
  .section-heading { margin-bottom: 2.5rem; }
