---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Breadcrumbs from "@/components/global/Breadcrumbs.astro";
import BeforeAfterCompare from "@/components/ui/BeforeAfterCompare.astro";
import { buildCompareItems } from "@/lib/cute-corrupted";

const description =
  "EZIZE is a probability-driven collectible image machine published by HobFarm, built around structured random generation and exact recipe probabilities.";
// The public subdomain has no deployed DNS target yet. Make the CTA live only
// after the application itself has been verified.
const app = {
  href: "https://ez.hob.farm/",
  live: false,
};

const pairs = await buildCompareItems([
  "cute-corrupted/cakes",
  "cute-corrupted/raccoon",
  "cute-corrupted/sienna",
]);
const pairBySlug = new Map(pairs.map((pair) => [pair.slug, pair]));
const cabinetForms = [
  {
    name: "Cake",
    version: "v0.4",
    slug: "cute-corrupted/cakes",
    side: "after" as const,
    description:
      "Constructed edible objects resolved from cake type, tiers, flavors, decorations, presentation, and cake-specific variables.",
  },
  {
    name: "Critter",
    version: "v0.3",
    slug: "cute-corrupted/raccoon",
    side: "before" as const,
    description:
      "Animal-led collectible cartoons built from species identity, behavior, body logic, environment, and modifiers.",
  },
  {
    name: "Character",
    version: "v0.1",
    slug: "cute-corrupted/sienna",
    side: "after" as const,
    description:
      "Humanoid and persona-driven figures with identity, role, wardrobe, action, props, body traits, conditions, environments, and modifiers.",
  },
].flatMap((form) => {
  const pair = pairBySlug.get(form.slug);
  return pair ? [{ ...form, pair }] : [];
});

// This poster is already an approved public preview and stays on the direct CDN
// URL required by social crawlers. A dedicated EZIZE social card can replace it.
const socialImage = "https://cdn.hob.farm/gallery/cute-corrupted/sienna-red/sienna-poster.jpg";
const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const canonicalUrl = new URL("/ezize/", siteOrigin).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteOrigin}/#organization`,
      name: "HobFarm",
      url: `${siteOrigin}/`,
    },
    {
      "@type": "WebSite",
      "@id": `${siteOrigin}/#website`,
      name: "HobFarm",
      url: `${siteOrigin}/`,
      publisher: { "@id": `${siteOrigin}/#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: "EZIZE | HobFarm",
      description,
      isPartOf: { "@id": `${siteOrigin}/#website` },
      publisher: { "@id": `${siteOrigin}/#organization` },
      mainEntity: { "@id": `${canonicalUrl}#ezize` },
      ...(socialImage ? { image: socialImage } : {}),
    },
    {
      "@type": "CreativeWork",
      "@id": `${canonicalUrl}#ezize`,
      name: "EZIZE",
      alternateName: "easies",
      description,
      url: canonicalUrl,
      creator: { "@id": `${siteOrigin}/#organization` },
      publisher: { "@id": `${siteOrigin}/#organization` },
      genre: ["Collectible image system", "Generative art"],
    },
  ],
};

const pullSteps = [
  "Pull",
  "Resolve traits",
  "Calculate probability",
  "Build image specification",
  "Render image",
  "Receive an easie",
];
const rarityRecipe = ["Cute", "Character", "Skeleton", "Pirate", "Heavy body mass", "Fire"];
---

<BaseLayout
  title="EZIZE | HobFarm"
  description={description}
  canonical="/ezize/"
  image={socialImage}
  imageAlt="A Cute and Corrupted character study from the image grammar behind EZIZE"
  structuredData={structuredData}
  palette="magenta-cyan"
>
  <div class="ezize-page">
    <section class="hero" aria-labelledby="ezize-title">
      <Wrapper variant="standard" class="hero-wrap">
        <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "EZIZE" }]} />
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">A collectible image system published by HobFarm</p>
            <h1 id="ezize-title">EZIZE</h1>
            <p class="pronunciation">Pronounced “easies.”</p>
            <p class="deck">
              A probability-driven collectible image machine. Every pull resolves a structured combination of
              traits, calculates how likely that exact recipe was, then prepares a one-of-a-kind image specification.
            </p>
            <div class="hero-actions">
              {app.live ? (
                <a class="primary-action" href={app.href}>Open the EZIZE arcade <span aria-hidden="true">↗</span></a>
              ) : (
                <span class="primary-action is-disabled" role="status" aria-label="The EZIZE application is in development">
                  Application coming soon
                </span>
              )}
              <a class="secondary-action" href="#cabinet">Open the cabinet</a>
            </div>
            <p class="app-home">
              Future application home: <span>{app.href.replace("https://", "")}</span>
            </p>
          </div>

          <div class="cabinet-preview" aria-label="Cake, Critter, and Character previews">
            <div class="cabinet-marquee">
              <span>Cabinet online</span>
              <span aria-hidden="true">● ● ●</span>
            </div>
            <div class="cabinet-windows">
              {cabinetForms.map((form, index) => {
                const image = form.pair[form.side];
                return (
                  <figure>
                    <img src={image.src} alt={image.alt} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
                    <figcaption><span>{form.version}</span>{form.name}</figcaption>
                  </figure>
                );
              })}
            </div>
            <div class="cabinet-controls" aria-hidden="true">
              <span></span><span></span><span></span><b>EZ</b>
            </div>
          </div>
        </div>
      </Wrapper>
    </section>

    <section class="definition" aria-labelledby="definition-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="split-heading">
          <div>
            <p class="eyebrow">What is an EZIZE?</p>
            <h2 id="definition-heading">One pull. One recipe. One easie.</h2>
          </div>
          <div class="body-copy">
            <p>
              An <strong>ezize</strong>, or <strong>easie</strong>, is one collectible produced by the machine. The
              recipe comes first. The image model does not choose the rarity, the form, or the underlying traits.
            </p>
            <p>
              The current engine can resolve the recipe, genome, exact probability, and canonical image JSON. The
              OpenAI image-provider connection that turns that specification into the finished picture is the next
              implementation phase.
            </p>
          </div>
        </div>

        <ol class="pull-path" aria-label="Conceptual EZIZE pull path">
          {pullSteps.map((step, index) => (
            <li><span>{String(index + 1).padStart(2, "0")}</span><strong>{step}</strong></li>
          ))}
        </ol>
        <p class="diagram-note">Conceptual pull path. Image rendering and the public arcade are still being built.</p>
      </Wrapper>
    </section>

    <section class="blind-pull" aria-labelledby="blind-pull-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="blind-grid">
          <div>
            <p class="eyebrow">You do not choose what comes out</p>
            <h2 id="blind-pull-heading">Pull the handle. Let the cabinet decide.</h2>
            <p class="deck-small">
              EZIZE works like a vending machine, a gumball machine, or a sealed trading-card pack. It is not a
              conventional prompt form. The structured surprise is the point.
            </p>
          </div>
          <ol class="arcade-sequence">
            <li><span>01</span><div><strong>Start with a seed</strong><p>The seed makes the pull repeatable.</p></div></li>
            <li><span>02</span><div><strong>Resolve the branches</strong><p>Cabinet, persona, form, and traits follow their defined weights.</p></div></li>
            <li><span>03</span><div><strong>Seal the recipe</strong><p>The genome, probability, and image specification are recorded together.</p></div></li>
          </ol>
        </div>
      </Wrapper>
    </section>

    <section id="cabinet" class="cabinet-section" aria-labelledby="cabinet-heading">
      <Wrapper variant="standard" class="section-space">
        <header class="section-heading">
          <p class="eyebrow">The Cabinet</p>
          <h2 id="cabinet-heading">Three forms are in the machine.</h2>
          <p>
            Each form owns its variables. A cake does not borrow a character wardrobe, and a critter does not use a
            cake-tier rule. The Cabinet chooses the correct grammar before the pull continues.
          </p>
        </header>

        <div class="form-grid">
          {cabinetForms.map((form, index) => {
            const image = form.pair[form.side];
            return (
              <article class="form-card">
                <a href={form.pair.href} aria-label={`See the ${form.name} source study in the HobFarm Gallery`}>
                  <div class="form-image"><img src={image.src} alt={image.alt} loading="lazy" decoding="async" /></div>
                  <div class="form-copy">
                    <div><span>{String(index + 1).padStart(2, "0")}</span><b>{form.version}</b></div>
                    <h3>{form.name}</h3>
                    <p>{form.description}</p>
                    <strong>See the source study <span aria-hidden="true">→</span></strong>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      </Wrapper>
    </section>

    {pairBySlug.get("cute-corrupted/raccoon") && (
      <section class="modes" aria-labelledby="modes-heading">
        <Wrapper variant="standard" class="section-space">
          <div class="modes-grid">
            <div class="compare-wrap">
              <BeforeAfterCompare
                before={pairBySlug.get("cute-corrupted/raccoon")!.before}
                after={pairBySlug.get("cute-corrupted/raccoon")!.after}
                video={pairBySlug.get("cute-corrupted/raccoon")!.video}
                aspect={pairBySlug.get("cute-corrupted/raccoon")!.aspect}
                ariaLabel="Raccoon in Cute and Corrupted modes"
              />
            </div>
            <div>
              <p class="eyebrow">Cute / Corrupted</p>
              <h2 id="modes-heading">Two intentional modes.</h2>
              <p class="mode-intro">
                Cute and Corrupted began as the public name of the project. They now operate inside EZIZE as a core
                persona and transformation grammar.
              </p>
              <dl class="mode-definitions">
                <div><dt>Cute</dt><dd>Readable, charming, polished, and inviting.</dd></div>
                <div><dt>Corrupted</dt><dd>Darker, stranger, theatrical, toxic, supernatural, warped, excessive, or otherwise intensified.</dd></div>
              </dl>
              <p class="mode-note">
                Corrupted owns the transformation. It is not the failed version of a Cute image. Skeletons, aliens,
                robots, and other unusual identities can appear in either mode.
              </p>
              <a class="text-link" href="/workshop/cute-and-corrupted/">Read the Workshop method <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </Wrapper>
      </section>
    )}

    <section class="rarity" aria-labelledby="rarity-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="split-heading rarity-heading">
          <div>
            <p class="eyebrow">Rarity comes from the machine</p>
            <h2 id="rarity-heading">There is no “Legendary” die roll.</h2>
          </div>
          <div class="body-copy">
            <p>
              Every choice in the generation path has a probability. Those probabilities multiply, so rarity emerges
              from the completed recipe. A common trait can become part of an extremely unusual combination.
            </p>
            <p>
              The engine records the exact generation probability. That number describes the pull, not the edition
              size and not a promise of market value.
            </p>
          </div>
        </div>

        <div class="recipe" aria-label="Example of traits combining into an unusual recipe">
          {rarityRecipe.map((trait, index) => (
            <div><span>{index === 0 ? "" : "×"}</span><strong>{trait}</strong></div>
          ))}
          <div class="recipe-result"><span>=</span><strong>One extremely unusual recipe</strong></div>
        </div>
        <div class="rarity-separations" aria-label="Rarity distinctions">
          <span>Generation probability</span><b>≠</b><span>Number minted</span><b>≠</b><span>Market value</span>
        </div>
      </Wrapper>
    </section>

    <section class="system" aria-labelledby="system-heading">
      <Wrapper variant="standard" class="section-space">
        <header class="section-heading">
          <p class="eyebrow">Inside the machine</p>
          <h2 id="system-heading">The image model receives a resolved specification.</h2>
          <p>
            HobFarm publishes EZIZE. Three supporting systems do separate jobs, so the collectible structure exists
            before an image provider draws the final surface.
          </p>
        </header>

        <div class="system-map">
          <div class="publisher-node"><span>Publisher</span><strong>HobFarm</strong><p>Publishes and develops EZIZE.</p></div>
          <div class="product-node"><span>Product</span><strong>EZIZE</strong><p>Creates and records the collectible recipe.</p></div>
          <div class="engine-nodes">
            <article><span>Authoring and schema</span><h3>Grimoire</h3><p>Defines what can exist.</p></article>
            <article><span>Deterministic runtime</span><h3>Wildcard Machine</h3><p>Performs the seeded pull and calculates its probability.</p></article>
            <article><span>Image renderer</span><h3>OpenAI</h3><p>Will render the already-resolved visual specification.</p></article>
          </div>
        </div>
      </Wrapper>
    </section>

    <section class="status" aria-labelledby="status-heading">
      <Wrapper variant="standard" class="section-space">
        <header class="section-heading">
          <p class="eyebrow">Current build status</p>
          <h2 id="status-heading">The engine exists. The public arcade comes next.</h2>
        </header>
        <div class="status-grid">
          <article>
            <span class="status-label available">Available in the engine</span>
            <h3>Structured resolution</h3>
            <p>Seed → Cabinet → persona → form → traits → genome → exact probability → canonical image JSON.</p>
            <ul><li>Cake v0.4</li><li>Critter v0.3</li><li>Character v0.1</li></ul>
          </article>
          <article>
            <span class="status-label building">Being built</span>
            <h3>Image and arcade layer</h3>
            <p>OpenAI image-provider integration, visual QA, and the public application at <span>ez.hob.farm</span>.</p>
          </article>
          <article>
            <span class="status-label planned">Planned</span>
            <h3>Collection and ownership</h3>
            <p>Downloads, collection records, public credits, and optional minting for selected easies.</p>
          </article>
        </div>
      </Wrapper>
    </section>

    <section class="minting" aria-labelledby="minting-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="mint-grid">
          <div>
            <p class="eyebrow">Generated first. Minted only by choice.</p>
            <h2 id="minting-heading">An easie begins as an image, not an NFT.</h2>
            <p>
              The planned path starts with generation. An owner will be able to keep, download, and collect an easie,
              then decide whether to mint a selected one. Minting is a separate action. It will not happen to every
              generated image automatically.
            </p>
          </div>
          <div class="future-chain">
            <div><span>01</span><strong>EZIZE</strong><p>Creates and records the collectible.</p></div>
            <div><span>02 / planned</span><strong>Base</strong><p>Provides on-chain ownership for selected minted easies.</p></div>
            <div><span>03 / planned</span><strong>OpenSea</strong><p>Provides an external marketplace for minted EZIZE.</p></div>
          </div>
        </div>
        <p class="mint-note">
          These integrations are not live. HobFarm will remain the publisher and creator identity; EZIZE will be the
          collection and product identity.
        </p>
      </Wrapper>
    </section>

    <section class="name-section" aria-labelledby="name-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="name-grid">
          <div><p class="mini-wordmark" aria-hidden="true">EZIZE</p></div>
          <div>
            <p class="eyebrow">Why EZIZE?</p>
            <h2 id="name-heading">Easy to pull. Easies to collect.</h2>
            <p>
              EZ carries the “easy” association. EZIZE is pronounced “easies,” which is also what the individual
              collectibles are called. The product is EZIZE. The thing you receive is an ezize, or an easie.
            </p>
          </div>
        </div>
      </Wrapper>
    </section>

    <section class="final-cta" aria-labelledby="final-heading">
      <Wrapper variant="standard" class="section-space">
        <p class="eyebrow">The cabinet is being wired</p>
        <h2 id="final-heading">The public EZIZE arcade will live at ez.hob.farm.</h2>
        <p>
          Until it opens, the original Cute / Corrupted studies remain available in the HobFarm Gallery and the
          production method remains in Workshop.
        </p>
        <div class="hero-actions final-actions">
          <span class="primary-action is-disabled" role="status">Application coming soon</span>
          <a class="secondary-action" href="/gallery/cute-corrupted/raccoon/">See a Critter study</a>
          <a class="secondary-action" href="/workshop/cute-and-corrupted/">Read the Workshop method</a>
        </div>
      </Wrapper>
    </section>
  </div>
</BaseLayout>

<style>
  .ezize-page {
    --ez-line: #332940;
    --ez-panel: #0d0a13;
    --ez-paper: #ece9f5;
    --ez-muted: #aaa5b8;
    --ez-cyan: #63e9eb;
    --ez-pink: #e660a7;
    overflow: hidden;
    background: #07060b;
    color: var(--ez-muted);
  }
  .ezize-page section { border-bottom: 1px solid var(--ez-line); }
  :global(.ezize-page .section-space) { padding-block: clamp(4.75rem, 9vw, 8rem); }
  .eyebrow { margin: 0; color: var(--ez-cyan); font-family: var(--font-mono); font-size: .64rem; letter-spacing: .18em; text-transform: uppercase; }
  h1, h2, h3 { color: var(--ez-paper); font-family: var(--font-display); font-weight: 300; }
  h2 { max-width: 16ch; margin: .95rem 0 0; font-size: clamp(2.6rem, 6vw, 5.8rem); letter-spacing: -.055em; line-height: .92; text-wrap: balance; }
  p { line-height: 1.72; }
  strong { color: #ded9e6; }
  .hero { background: radial-gradient(circle at 86% 18%, rgb(99 233 235 / .11), transparent 32rem), radial-gradient(circle at 12% 72%, rgb(230 96 167 / .12), transparent 30rem), #07060b; }
  :global(.hero-wrap) { padding-top: 1.3rem; padding-bottom: clamp(4rem, 8vw, 7rem); }
  .hero-grid { display: grid; gap: clamp(3rem, 7vw, 6rem); margin-top: clamp(3.5rem, 8vw, 6rem); align-items: center; }
  .hero-copy { min-width: 0; }
  h1 { margin: 1.1rem 0 0; color: white; font-size: clamp(5rem, 17vw, 12.5rem); font-weight: 650; letter-spacing: -.095em; line-height: .73; }
  .pronunciation { margin: 1.35rem 0 0; color: var(--ez-pink); font-family: var(--font-mono); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; }
  .deck { max-width: 47rem; margin: 1.7rem 0 0; color: #d2cdda; font-size: clamp(1.04rem, 2vw, 1.25rem); line-height: 1.75; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .primary-action, .secondary-action { display: inline-flex; min-height: 2.9rem; align-items: center; justify-content: center; padding: .72rem 1.1rem; border: 1px solid var(--ez-line); border-radius: 999px; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .06em; text-decoration: none; text-transform: uppercase; }
  .primary-action { border-color: var(--ez-cyan); background: var(--ez-cyan); color: #071011; }
  .primary-action:not(.is-disabled):hover, .primary-action:not(.is-disabled):focus-visible { background: white; border-color: white; outline: none; }
  .primary-action.is-disabled { border-color: #47404e; background: #17131b; color: #857e8d; cursor: not-allowed; }
  .secondary-action { color: #dcd7e3; }
  .secondary-action:hover, .secondary-action:focus-visible { border-color: var(--ez-pink); color: white; outline: none; }
  .app-home { margin: 1rem 0 0; color: #777181; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .04em; }
  .app-home span { color: #aaa5b8; }
  .cabinet-preview { min-width: 0; padding: .8rem; border: 1px solid #4a3b59; border-radius: 1rem; background: linear-gradient(145deg, #17111e, #09070c 65%); box-shadow: 0 1.4rem 4rem rgb(0 0 0 / .34), inset 0 0 0 1px rgb(255 255 255 / .035); }
  .cabinet-marquee { display: flex; align-items: center; justify-content: space-between; padding: .55rem .7rem .8rem; color: #bcb5c7; font-family: var(--font-mono); font-size: .53rem; letter-spacing: .13em; text-transform: uppercase; }
  .cabinet-marquee span:last-child { color: var(--ez-cyan); letter-spacing: .3em; }
  .cabinet-windows { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .45rem; }
  .cabinet-windows figure { min-width: 0; margin: 0; overflow: hidden; border: 1px solid #332b3b; border-radius: .55rem; background: #050407; }
  .cabinet-windows img { display: block; width: 100%; aspect-ratio: 2 / 3; object-fit: cover; }
  .cabinet-windows figcaption { display: flex; align-items: center; justify-content: space-between; gap: .4rem; padding: .65rem .55rem; color: #d4cfda; font-family: var(--font-mono); font-size: .5rem; letter-spacing: .06em; text-transform: uppercase; }
  .cabinet-windows figcaption span { color: var(--ez-pink); }
  .cabinet-controls { display: flex; align-items: center; gap: .6rem; padding: .8rem .4rem .15rem; }
  .cabinet-controls span { width: .55rem; height: .55rem; border-radius: 50%; border: 1px solid #5e5269; background: #211927; }
  .cabinet-controls span:first-child { background: var(--ez-pink); box-shadow: 0 0 1rem rgb(230 96 167 / .45); }
  .cabinet-controls b { margin-left: auto; color: var(--ez-cyan); font-family: var(--font-mono); font-size: .62rem; letter-spacing: .1em; }
  .split-heading { display: grid; gap: clamp(2rem, 5vw, 5rem); }
  .body-copy { max-width: 46rem; }
  .body-copy p { margin: 0; }
  .body-copy p + p { margin-top: 1.15rem; }
  .pull-path { display: grid; gap: .65rem; margin: clamp(2.5rem, 5vw, 4rem) 0 0; padding: 0; list-style: none; }
  .pull-path li { min-width: 0; min-height: 7.5rem; padding: 1rem; border: 1px solid var(--ez-line); background: var(--ez-panel); }
  .pull-path li span { display: block; color: var(--ez-cyan); font-family: var(--font-mono); font-size: .56rem; }
  .pull-path li strong { display: block; margin-top: 2rem; font-size: .74rem; font-weight: 500; line-height: 1.45; }
  .diagram-note { margin: 1rem 0 0; color: #777181; font-family: var(--font-mono); font-size: .58rem; letter-spacing: .03em; }
  .blind-pull { background: linear-gradient(90deg, rgb(230 96 167 / .045), transparent 40%), #0a0810; }
  .blind-grid { display: grid; gap: clamp(3rem, 7vw, 6rem); }
  .deck-small { max-width: 45rem; margin: 1.5rem 0 0; }
  .arcade-sequence { display: grid; gap: .7rem; margin: 0; padding: 0; list-style: none; }
  .arcade-sequence li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 1rem; align-items: start; padding: 1.2rem; border: 1px solid var(--ez-line); background: #08060b; }
  .arcade-sequence li > span { color: var(--ez-pink); font-family: var(--font-mono); font-size: .6rem; }
  .arcade-sequence strong { font-weight: 500; }
  .arcade-sequence p { margin: .45rem 0 0; color: #8f8999; font-size: .78rem; }
