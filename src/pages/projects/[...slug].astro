---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import StatusBadge from "@/components/ui/StatusBadge.astro";
import Button from "@/components/fundations/elements/Button.astro";
import KofiCta from "@/components/KofiCta.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import ContentPanel from "@/components/ContentPanel.astro";
import StyleFusionProjectPage from "@/components/projects/StyleFusionProjectPage.astro";
import { imageSrcset, transformImageUrl } from "@/lib/media-transforms";

interface Props {
  project: CollectionEntry<"projects">;
}

type ProjectFeature = {
  title: string;
  description: string;
};

type ProjectCta = {
  label: string;
  href: string;
  external?: boolean;
};

type ProjectImage = {
  url: {
    src: string;
  };
  alt: string;
};

type ContentImageMetadata = {
  src: string;
  width: number;
  height: number;
  format: "svg" | "png" | "jpg" | "jpeg" | "tiff" | "webp" | "gif" | "avif";
};

export async function getStaticPaths() {
  // Slugs in this list are skipped from static generation so a public/_redirects
  // rule can take over. These project entries were promoted to top-level pages
  // (/shop/, /academy/, /grimoire/); the .md files stay as the data source.
  const redirectedSlugs: string[] = ["shop", "courses", "grimoire", "hobfarm-tv/3-degrees-of-dick-miller"];
  const projects = await getCollection("projects");
  return projects
    .filter((project) => !redirectedSlugs.includes(project.id.replace(/\.md$/, "")))
    .map((project) => ({
      params: { slug: project.id.replace(/\.md$/, "") },
      props: { project },
    }));
}

const { project } = Astro.props as Props;
const { Content } = await render(project);
const slug = project.id.replace(/\.md$/, "");
const isStyleFusion = slug === "stylefusion";
const seoImage = project.data.heroImage;
const isKofiHref = (href: string) => href.includes("ko-fi.com");
const logoIsSvg = project.data.logo?.url.src.endsWith(".svg") ?? false;
const transformedHeroImage = project.data.heroImage
  ? transformImageUrl(project.data.heroImage, { width: 1400, quality: 84, fit: "cover" })
  : undefined;
const heroSrcset = project.data.heroImage
  ? imageSrcset(project.data.heroImage, [640, 960, 1400, 1920], {
      quality: 84,
      fit: "cover",
    })
  : undefined;

// Format date
const pubDate = new Date(project.data.pubDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const canonicalUrl = `${siteOrigin}/projects/${slug}/`;
const projectJsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.data.title,
  description: project.data.subtitle || project.data.description,
  url: canonicalUrl,
  image: seoImage,
  datePublished: project.data.pubDate.toISOString(),
  dateModified: (project.data.updatedDate ?? project.data.pubDate).toISOString(),
  genre: project.data.category,
  keywords: [...(project.data.stack ?? []), ...(project.data.highlights ?? [])].join(", "),
  creator: {
    "@type": "Organization",
    name: "HobFarm",
    url: siteOrigin,
  },
};
---

{isStyleFusion ? (
  <StyleFusionProjectPage project={project} />
) : (
  <BaseLayout
    title={`${project.data.title} | HobFarm`}
    description={project.data.subtitle}
    canonical={`/projects/${slug}/`}
    image={seoImage}
    structuredData={projectJsonLd}
  >
    <section class="bg-noise">
      <ContentPanel>
        <Wrapper variant="standard" class="py-12 lg:py-24">
        {/* Header Block */}
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-8 mb-12">
          <div class="flex items-start gap-6">
            {project.data.logo && (
              <div class="w-16 h-16 rounded-xl bg-base-900 border border-base-800 flex items-center justify-center p-3 shrink-0">
                {logoIsSvg ? (
                  <img
                    src={project.data.logo.url.src}
                    alt={project.data.logo.alt}
                    width={64}
                    height={64}
                    class="w-full h-full object-contain"
                  />
                ) : (
                  <Image
                    src={project.data.logo.url as ContentImageMetadata}
                    alt={project.data.logo.alt}
                    width={64}
                    height={64}
                    format="webp"
                    quality={82}
                    class="w-full h-full object-contain"
                  />
                )}
              </div>
            )}
            <div>
              <div class="flex items-center gap-3 mb-2">
                <Text tag="span" variant="textSM" class="text-base-500 font-mono uppercase tracking-wider">
                  {project.data.category}
                </Text>
                <StatusBadge status={project.data.status} />
              </div>
              <Text tag="h1" variant="display2XL" class="text-white text-balance font-display mb-4">
                {project.data.title}
              </Text>
              <Text tag="p" variant="textLG" class="text-base-400 text-balance max-w-2xl">
                {project.data.subtitle}
              </Text>
            </div>
          </div>

          {/* Action Buttons */}
          <div class="flex flex-wrap gap-3 shrink-0 mt-4 md:mt-0">
            {project.data.ctas && project.data.ctas.length > 0 ? (
              project.data.ctas.map((cta: ProjectCta, i: number) => (
                isKofiHref(cta.href) ? (
                  <KofiCta variant="button" href={cta.href} />
                ) : (
                  <Button
                    isLink
                    size="base"
                    variant={i === 0 ? "default" : "muted"}
                    href={cta.href}
                    target={cta.external ? "_blank" : undefined}
                    rel={cta.external ? "noopener noreferrer" : undefined}
                  >
                    {cta.label}
                  </Button>
                )
              ))
            ) : project.data.primaryCta ? (
              <>
                <Button isLink size="base" variant="default" href={project.data.primaryCta.href}>
                  {project.data.primaryCta.label}
                </Button>
                {project.data.secondaryCta && (
                  <Button isLink size="base" variant="muted" href={project.data.secondaryCta.href}>
                    {project.data.secondaryCta.label}
                  </Button>
                )}
              </>
            ) : (
              project.data.liveUrl && (
                <Button isLink size="base" variant="default" href={project.data.liveUrl} target="_blank" rel="noopener noreferrer">
                  Visit Project
                </Button>
              )
            )}
            {project.data.repoUrl && (
              <Button isLink size="base" variant="muted" href={project.data.repoUrl} target="_blank" rel="noopener noreferrer">
                Source Code
              </Button>
            )}
          </div>
        </div>

        {/* Hero Media */}
        {project.data.heroVideo ? (
          <div class="relative w-full aspect-video rounded-2xl overflow-hidden border border-base-800 mb-12 bg-base-900 isolate">
            <div class="absolute inset-0 bg-linear-to-b from-transparent to-base-950/80 mix-blend-multiply z-10"></div>
            <video
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster={transformedHeroImage}
              class="w-full h-full object-cover rounded-2xl"
            >
              <source src={project.data.heroVideo} type="video/mp4" />
            </video>
          </div>
        ) : project.data.heroImage ? (
          <div class="relative w-full aspect-video rounded-2xl overflow-hidden border border-base-800 mb-12 bg-base-900 isolate">
            <div class="absolute inset-0 bg-linear-to-b from-transparent to-base-950/80 mix-blend-multiply z-10"></div>
            <img
              src={transformedHeroImage}
              srcset={heroSrcset}
              sizes="100vw"
              alt={project.data.title}
              width={1920}
              height={1080}
              decoding="async"
              class="w-full h-full object-cover rounded-2xl"
            />
          </div>
        ) : project.data.image ? (
          <div class="relative w-full aspect-video rounded-2xl overflow-hidden border border-base-800 mb-12 bg-base-900 isolate">
            <div class="absolute inset-0 bg-linear-to-b from-transparent to-base-950/80 mix-blend-multiply z-10"></div>
            <img
              src={project.data.image.url.src}
              alt={project.data.image.alt}
              width={1920}
              height={1080}
              class="w-full h-full object-cover rounded-2xl"
            />
          </div>
        ) : null}

        {/* Meta Row */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16 py-8 border-y border-base-800/80">
          <div>
            <Text tag="h3" variant="textSM" class="text-base-500 font-mono uppercase tracking-wider mb-2">Published</Text>
            <Text tag="p" variant="textBase" class="text-white">{pubDate}</Text>
          </div>
          <div class="md:col-span-2">
            <Text tag="h3" variant="textSM" class="text-base-500 font-mono uppercase tracking-wider mb-2">Tech Stack</Text>
            <div class="flex flex-wrap gap-2">
              {project.data.stack?.map((tech: string) => (
                <span class="px-3 py-1 bg-base-900 border border-base-800 rounded-full text-sm text-base-300 font-mono">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>

        {/* Structured Grid Layout for Highlights & Prose */}
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
          <div class="lg:col-span-1 space-y-16">
            {/* Highlights */}
            {project.data.highlights && project.data.highlights.length > 0 && (
              <div>
                <Text tag="h2" variant="textXL" class="text-white font-medium mb-6">Key Highlights</Text>
                <ul class="space-y-4">
                  {project.data.highlights.map((item: string) => (
                    <li class="flex items-start gap-3">
                      <svg class="w-5 h-5 text-accent-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      <Text tag="span" variant="textBase" class="text-base-300">{item}</Text>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            
            {/* Description fallback if prose is short */}
            <div>
              <Text tag="h2" variant="textXL" class="text-white font-medium mb-4">Overview</Text>
              <Text tag="p" variant="textBase" class="text-base-400 text-balance">
                {project.data.description}
              </Text>
            </div>
          </div>

          {/* Prose Content */}
          <div class="lg:col-span-2">
            <Wrapper variant="prose" class="max-w-none">
              <Content />
            </Wrapper>
          </div>
        </div>

        {/* Features Grid */}
        {project.data.features && project.data.features.length > 0 && (
          <div class="mt-24">
            <Text tag="h2" variant="displayLG" class="text-white font-display mb-12">{project.data.featuresTitle ?? "System Features"}</Text>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {project.data.features.map((feature: ProjectFeature) => (
                <div class="glass border border-base-800 rounded-xl p-8 hover:border-accent-500/50 transition-colors duration-300 relative group overflow-hidden">
                  <div class="absolute inset-0 bg-linear-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                  <Text tag="h3" variant="textLG" class="text-white font-medium mb-3 relative z-10">{feature.title}</Text>
                  <Text tag="p" variant="textBase" class="text-base-400 relative z-10">{feature.description}</Text>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Images Gallery */}
        {project.data.images && project.data.images.length > 0 && (
          <div class="mt-24">
            <Text tag="h2" variant="displayLG" class="text-white font-display mb-12">Gallery</Text>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {project.data.images.map((img: ProjectImage) => (
                <div class="relative w-full aspect-video rounded-xl overflow-hidden border border-base-800 bg-base-900 group">
                  <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors z-10 pointer-events-none"></div>
                  <img
                    src={img.url.src}
                    alt={img.alt}
                    width={800}
                    height={450}
                    loading="lazy"
                    class="w-full h-full object-cover"
                  />
                </div>
              ))}
            </div>
          </div>
        )}
        </Wrapper>
      </ContentPanel>
    </section>
  </BaseLayout>
)}
