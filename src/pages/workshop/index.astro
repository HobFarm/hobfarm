---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import ArticleCard from "@/components/articles/ArticleCard.astro";
import WorkshopMethodStrip from "@/components/workshop/WorkshopMethodStrip.astro";
import ProjectGrowthDiagram from "@/components/workshop/ProjectGrowthDiagram.astro";
import EzizeEvidence from "@/components/workshop/EzizeEvidence.astro";
import WorkshopProjectGrid from "@/components/workshop/WorkshopProjectGrid.astro";
import { getArticleDepartment, getPublishedArticles } from "@/lib/articles";
import { getMedia } from "@/data/media-registry";
import { selectedWorkshopProjects } from "@/data/workshop-projects";

const notes = (await getPublishedArticles())
  .filter((post) => getArticleDepartment(post.data) === "workshop-notes")
  .slice(0, 3);

const workshopHero = getMedia("workshop.graphics.hero");
const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const workshopJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "HobFarm Workshop",
  description: "The sources, decisions, structures, tests, and production methods behind HobFarm publishing, visual work, applications, games, and creative systems.",
  url: `${siteOrigin}/workshop/`,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: [...selectedWorkshopProjects]
      .sort((a, b) => a.featuredPosition - b.featuredPosition)
      .map((project, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: project.title,
        url: `${siteOrigin}${project.destination}`,
      })),
  },
};
---

<BaseLayout
  title="Workshop | How HobFarm Projects Are Developed"
  description="See how HobFarm moves from ideas and source research through structure, production, testing, publishing, and new project branches."
  canonical="/workshop/"
  structuredData={workshopJsonLd}
  image={workshopHero.src}
  imageAlt={workshopHero.alt}
  palette="blue-red"
>
  <div class="workshop-hub">
    <section class="workshop-hero" aria-labelledby="workshop-hero-heading">
      <Wrapper variant="standard" class="workshop-hero__wrapper">
        <figure class="workshop-hero__figure">
          <div class="workshop-hero__media">
            <img src={workshopHero.src} alt={workshopHero.alt} width={workshopHero.width} height={workshopHero.height} loading="eager" fetchpriority="high" decoding="async" />
            <header class="workshop-hero__title">
              <p class="eyebrow">HobFarm Workshop</p>
              <h1 id="workshop-hero-heading">One method for different projects.</h1>
            </header>
          </div>
          <figcaption>Source material, working decisions, production tools, and finished worlds</figcaption>
        </figure>

        <div class="workshop-hero__after">
          <p class="deck">
            HobFarm work moves between research, writing, visual direction, software, and publishing. Each project keeps its sources, decisions, useful structure, and revisions visible, so the work can change form without losing what made it useful.
          </p>
          <div class="actions">
            <Button isLink size="sm" variant="green" href="/workshop/projects/" data-event="workshop_projects_open">Browse projects</Button>
            <Button isLink size="sm" variant="muted" href="/workshop/workshop-notes/" data-event="workshop_notes_open">Read Workshop Notes</Button>
          </div>
        </div>
      </Wrapper>
    </section>

    <section id="method" class="method-section" aria-labelledby="method-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">The working method</p>
            <h2 id="method-heading">Start with the source. Keep the decisions visible.</h2>
          </div>
          <p>
            A project may begin with an idea, question, problem, photograph, historical object, experiment, or application need. The first job is to define the premise and find the evidence it needs. Writing, code, photography, compositing, editing, motion, and AI-assisted production can all enter later.
          </p>
        </div>
        <div class="method-strip-wrap"><WorkshopMethodStrip showMedia /></div>
      </Wrapper>
    </section>

    <section id="growth" class="growth-section" aria-labelledby="growth-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Project growth</p>
            <h2 id="growth-heading">Projects grow. Build them so they can.</h2>
          </div>
          <div>
            <p>
              Research, structure, production, testing, and outputs gather around a project core. An article can expose a tool that needs building. A visual test can reveal a larger system. Some branches are planned; others only become visible while doing the work.
            </p>
            <p>
              The source and useful decisions persist while software, models, providers, and production methods change. Evaluation returns to the project instead of disappearing with the tool that produced one result.
            </p>
          </div>
        </div>

        <div class="growth-diagram-wrap"><ProjectGrowthDiagram /></div>

        <div class="durable-principle" aria-label="What remains stable while a project grows">
          <div><span>01</span><strong>Source and decisions persist</strong></div>
          <div><span>02</span><strong>Useful structure travels</strong></div>
          <div><span>03</span><strong>Production tools can change</strong></div>
          <div><span>04</span><strong>Results return for revision</strong></div>
        </div>
      </Wrapper>
    </section>

    <section id="ezize" class="ezize-feature" aria-labelledby="ezize-feature-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Featured project / EZIZE</p>
            <h2 id="ezize-feature-heading">Separate experiments became one working machine.</h2>
          </div>
          <div>
            <p>
              EZIZE is the clearest current example of a project finding its full shape through the work. Cute &amp; Corrupted supplied the visual premise. Grimoire gave the ideas an authored structure. Wildcard Machine made the pull deterministic. EZIZE joined those parts to an interface, renderer, download, and generation record.
            </p>
            <p class="status-note"><span>Current status</span> Working private alpha behind Cloudflare Access. Public generation is closed.</p>
          </div>
        </div>

        <ol class="ezize-lineage" aria-label="EZIZE project lineage">
          <li><span>Origin</span><strong>Cute &amp; Corrupted</strong><p>Persona and transformation grammar</p></li>
          <li><span>Authoring</span><strong>Grimoire</strong><p>Taxonomies and compiled packs</p></li>
          <li><span>Runtime</span><strong>Wildcard Machine</strong><p>Seeded choices and exact probability</p></li>
          <li><span>Application</span><strong>EZIZE</strong><p>Interface, render, PNG download, and record</p></li>
        </ol>

        <div class="ezize-evidence-wrap"><EzizeEvidence compact /></div>

        <div class="ezize-proof-grid">
          <article>
            <p class="eyebrow">Working now</p>
            <h3>The complete owner-alpha path.</h3>
            <ul>
              <li>Deterministic seed and genome identity</li>
              <li>Persona and form selection</li>
              <li>Exact full-recipe probability</li>
              <li>Resolved image specification and render</li>
              <li>Downloadable PNG and development record</li>
            </ul>
          </article>
          <article>
            <p class="eyebrow eyebrow--future">Directions, not shipped products</p>
            <h3>The finished output can open new branches.</h3>
            <ul>
              <li>Articles and process documentation</li>
              <li>Future public collections and product paths</li>
              <li>Academy material built from the method</li>
              <li>Optional provenance or minting work for selected easies</li>
            </ul>
          </article>
        </div>

        <div class="route-links">
          <a class="primary-route" href="/ezize/" data-event="workshop_ezize_open">Open the EZIZE case study <span aria-hidden="true">&rarr;</span></a>
          <a href="https://ez.hob.farm/" data-event="workshop_ezize_alpha_open">Private-alpha application <span aria-hidden="true">&nearr;</span></a>
        </div>
      </Wrapper>
    </section>

    <section id="projects" class="projects-section" aria-labelledby="projects-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Selected projects</p>
            <h2 id="projects-heading">The method changes with the job.</h2>
          </div>
          <div>
            <p>
              A publishing system, reference-analysis application, photographic comparison, historical concept campaign, and interactive story world need different evidence and different production records. These projects show the range through working artifacts.
            </p>
            <a class="text-link" href="/workshop/projects/" data-event="workshop_projects_open">Browse the full project index <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
        <div class="project-grid-space"><WorkshopProjectGrid surface="workshop" /></div>
      </Wrapper>
    </section>

    <section class="notes-section" aria-labelledby="notes-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Workshop Notes</p>
            <h2 id="notes-heading">Keep the production record with the work.</h2>
          </div>
          <div>
            <p>
              Workshop Notes records the question, source material, tests, failures, revisions, and reusable findings behind current work. The archive shows how decisions change after the polished project page is published.
            </p>
            <a class="text-link" href="/workshop/workshop-notes/" data-event="workshop_notes_open">Read all Workshop Notes <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
        {notes.length > 0 && <div class="note-grid">{notes.map((post) => <ArticleCard post={post} />)}</div>}
      </Wrapper>
    </section>

    <section class="final-routes" aria-labelledby="final-routes-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="final-routes__layout">
          <div>
            <p class="eyebrow">Research, editorial, creative technology, and production</p>
            <h2 id="final-routes-heading">See the work. Then see who made it.</h2>
          </div>
          <div>
            <p>
              HobFarm projects combine research, writing, information architecture, visual systems, application development, testing, and publishing. About explains the larger studio. Contact is the direct route for a project or professional conversation.
            </p>
            <nav class="final-route-grid" aria-label="Workshop next steps">
              <a href="/about/">About HobFarm</a>
              <a href="/contact/?subject=creative-project">Discuss a project</a>
              <a href="/workshop/projects/">More Workshop projects</a>
            </nav>
          </div>
        </div>
      </Wrapper>
    </section>
  </div>
</BaseLayout>

<style>
  .workshop-hub {
    --line: #2c2440;
    --panel: #0d0a13;
    --section-space: clamp(4.5rem, 9vw, 7.5rem);
    --content-space: clamp(2.25rem, 5vw, 4rem);
    --cluster-space: clamp(1.5rem, 3vw, 2.4rem);
    background: #07060b;
    color: #aaa5b8;
  }

  .workshop-hub section { border-bottom: 1px solid var(--line); }
  :global(.workshop-hub .section-space) { padding-block: var(--section-space); }

  .eyebrow {
    margin: 0;
    color: #55d7ff;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.17em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    color: white;
    font-family: var(--font-display);
    font-weight: 300;
  }

  h1 {
    max-width: 8ch;
    margin: clamp(0.55rem, 1.4vw, 1.1rem) 0 0;
    font-size: clamp(2rem, 6.4vw, 6.5rem);
    letter-spacing: -0.065em;
    line-height: 0.84;
    text-wrap: balance;
  }

  h2 {
    max-width: 17ch;
    margin: 0.9rem 0 0;
    font-size: clamp(2.5rem, 5.8vw, 5.25rem);
    letter-spacing: -0.05em;
    line-height: 0.94;
    text-wrap: balance;
  }

  .deck {
    max-width: 58rem;
    margin: 0;
    color: #cbc6d2;
    font-size: clamp(1rem, 2vw, 1.18rem);
    line-height: 1.75;
  }

  .actions,
  .route-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--cluster-space);
  }

  .workshop-hero {
    background: radial-gradient(circle at 82% 18%, rgb(85 215 255 / 0.12), transparent 32rem), radial-gradient(circle at 10% 70%, rgb(191 45 88 / 0.1), transparent 28rem), #07060b;
  }

  :global(.workshop-hero__wrapper) {
    padding-top: clamp(1.25rem, 2vw, 2rem);
    padding-bottom: clamp(4rem, 8vw, 6.5rem);
  }

  .workshop-hero__figure {
    margin: 0;
    overflow: hidden;
    border: 1px solid #3b3150;
    border-radius: 0.7rem;
    background: #08070b;
  }

  .workshop-hero__media { position: relative; isolation: isolate; }

  .workshop-hero__media::after {
    position: absolute;
    z-index: 0;
    inset: 0 42% 0 0;
    background: linear-gradient(90deg, rgb(237 227 208 / 0.2), transparent);
    content: "";
    pointer-events: none;
  }

  .workshop-hero__figure img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .workshop-hero__figure figcaption {
    padding: 0.65rem 0.8rem;
    color: #7f798b;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .workshop-hero__title {
    position: absolute;
    z-index: 1;
    top: clamp(0.75rem, 2.5vw, 2.5rem);
    left: clamp(1rem, 4vw, 4rem);
    width: min(52%, 35rem);
  }

  .workshop-hero__title .eyebrow { color: #174e5a; }

  .workshop-hero__title h1 {
    color: #151016;
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.28);
  }

  .workshop-hero__after { padding-top: clamp(1.5rem, 3vw, 2.5rem); }

  .method-section,
  .projects-section,
  .final-routes { background: #0a0810; }

  .growth-section {
    background: radial-gradient(circle at 50% 38%, rgb(85 215 255 / 0.055), transparent 34rem), #07060b;
  }

  .notes-section { background: #09070d; }

  .section-heading { max-width: 65rem; }

  .section-heading--split {
    display: grid;
    gap: var(--cluster-space);
    max-width: none;
  }

  .section-heading--split > p,
  .section-heading--split > div:last-child > p {
    max-width: 48rem;
    margin: 0;
    line-height: 1.75;
  }

  .section-heading--split > div:last-child > p + p { margin-top: 1rem; }
  .method-strip-wrap,
  .growth-diagram-wrap,
  .project-grid-space,
  .note-grid { margin-top: var(--content-space); }

  .growth-diagram-wrap { max-width: 74rem; margin-inline: auto; }

  .durable-principle {
    display: grid;
    gap: 0.65rem;
    margin-top: 0.8rem;
  }

  .durable-principle > div {
    min-width: 0;
    padding: 1rem;
    border-left: 2px solid #55d7ff;
    background: #0d0a13;
  }

  .durable-principle span {
    display: block;
    color: #55d7ff;
    font-family: var(--font-mono);
    font-size: 0.54rem;
  }

  .durable-principle strong {
    display: block;
    margin-top: 0.65rem;
    color: #d8d3df;
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .ezize-feature {
    --ez-lime: #dfff36;
    --ez-orange: #ff684d;
    background: radial-gradient(circle at 85% 18%, rgb(223 255 54 / 0.09), transparent 34rem), linear-gradient(140deg, rgb(255 104 77 / 0.045), transparent 42%), #090807;
  }

  .ezize-feature .eyebrow { color: var(--ez-lime); }

  .status-note {
    padding-left: 0.9rem;
    border-left: 2px solid var(--ez-lime);
    color: #c8c3cb;
  }

  .status-note span {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--ez-lime);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ezize-lineage {
    display: grid;
    gap: 0.65rem;
    margin: var(--content-space) 0 0;
    padding: 0;
    list-style: none;
  }

  .ezize-lineage li {
    position: relative;
    min-width: 0;
    padding: 1rem;
    border: 1px solid #413b2c;
    background: #100f0b;
  }

  .ezize-lineage span,
  .ezize-lineage p {
    color: #aaa596;
    font-family: var(--font-mono);
    font-size: 0.54rem;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .ezize-lineage span { color: var(--ez-lime); letter-spacing: 0.09em; }

  .ezize-lineage strong {
    display: block;
    margin-top: 1.45rem;
    color: #f3f0e9;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 350;
    line-height: 1;
  }

  .ezize-lineage p { margin: 0.75rem 0 0; }
  .ezize-evidence-wrap { margin-top: 0.8rem; }

  .ezize-proof-grid {
    display: grid;
    gap: 0.8rem;
    margin-top: 0.8rem;
  }

  .ezize-proof-grid article {
    padding: clamp(1.2rem, 3vw, 1.8rem);
    border: 1px solid #413b2c;
    background: #100f0b;
  }

  .ezize-proof-grid .eyebrow--future { color: var(--ez-orange); }

  .ezize-proof-grid h3 {
    margin: 1rem 0 0;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1;
  }

  .ezize-proof-grid ul {
    display: grid;
    gap: 0.65rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ezize-proof-grid li {
    position: relative;
    padding-left: 1.2rem;
    color: #aaa596;
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .ezize-proof-grid li::before {
    position: absolute;
    top: 0.7em;
    left: 0;
    width: 0.5rem;
    height: 1px;
    background: var(--ez-lime);
    content: "";
  }

  .ezize-proof-grid article:last-child li::before { background: var(--ez-orange); }

  .route-links a,
  .final-route-grid a {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    padding: 0.7rem 0.9rem;
    border: 1px solid #493d55;
    border-radius: 0.35rem;
    color: #ded9e6;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .route-links .primary-route {
    border-color: var(--ez-lime);
    background: var(--ez-lime);
    color: #0a0a07;
  }

  .route-links a:hover,
  .route-links a:focus-visible,
  .final-route-grid a:hover,
  .final-route-grid a:focus-visible {
    border-color: #55d7ff;
    color: white;
    outline: 2px solid transparent;
  }

  .route-links .primary-route:hover,
  .route-links .primary-route:focus-visible {
    border-color: white;
    background: white;
    color: #0a0a07;
  }

  .text-link {
    display: inline-block;
    margin-top: 1.5rem;
    color: #77e8eb;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .text-link:hover,
  .text-link:focus-visible { color: white; outline-offset: 0.3rem; }

  .note-grid { display: grid; gap: 1.1rem; }

  .final-routes { border-bottom: 0 !important; }

  .final-routes__layout {
    display: grid;
    gap: var(--cluster-space);
  }

  .final-routes__layout > div:last-child > p {
    max-width: 48rem;
    margin: 0;
    line-height: 1.75;
  }

  .final-route-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.75rem;
  }

  @media (min-width: 42rem) {
    .durable-principle,
    .ezize-proof-grid,
    .note-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    .note-grid > :global(*:last-child:nth-child(odd)) { grid-column: span 2; }
  }

  @media (min-width: 48rem) {
    .ezize-lineage { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 64rem) {
    .section-heading--split,
    .final-routes__layout {
      grid-template-columns: minmax(0, 1.18fr) minmax(24rem, 0.72fr);
      align-items: end;
      gap: clamp(3rem, 7vw, 7rem);
    }

    .section-heading--split > div:last-child > p,
    .section-heading--split > p { margin-top: 0; }

    .durable-principle { grid-template-columns: repeat(4, minmax(0, 1fr)); }

    .ezize-lineage {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
    }

    .ezize-lineage li + li { border-left: 0; }

    .ezize-lineage li + li::before {
      position: absolute;
      z-index: 2;
      top: 50%;
      left: -0.38rem;
      color: var(--ez-lime);
      content: "→";
      font-family: var(--font-mono);
      transform: translateY(-50%);
    }

    .note-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .note-grid > :global(*:last-child:nth-child(odd)) { grid-column: auto; }
  }

  @media (max-width: 34rem) {
    .workshop-hero__figure img { min-height: 18rem; object-position: center; }
    .workshop-hero__media::after { right: 28%; }
    .workshop-hero__title { width: 63%; }
    .workshop-hero__figure figcaption { display: none; }
    .actions :global(a) { width: 100%; justify-content: center; }
    .route-links { display: grid; }
    .route-links a { justify-content: center; text-align: center; }
    .final-route-grid { display: grid; }
    .final-route-grid a { justify-content: center; text-align: center; }
  }
</style>
