---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import ArticleCard from "@/components/articles/ArticleCard.astro";
import WorkshopMethodStrip from "@/components/workshop/WorkshopMethodStrip.astro";
import WorkshopProgramNav from "@/components/workshop/WorkshopProgramNav.astro";
import { getArticleDepartment, getPublishedArticles } from "@/lib/articles";
import { primaryWorkshopPrograms } from "@/data/site-hierarchy";
import { getMedia } from "@/data/media-registry";
import { getWorkshopProject } from "@/data/workshop-projects";
import { transformImageUrl } from "@/lib/media-transforms";

const notes = (await getPublishedArticles())
  .filter((post) => getArticleDepartment(post.data) === "workshop-notes");
const featuredNotes = notes.slice(0, 3);
const moreNotes = notes.slice(3, 6);

const visualPrograms = primaryWorkshopPrograms.filter((program) => program.id !== "workshop-notes");
const workshopHero = getMedia("workshop.graphics.hero");
const futureCarriage = getWorkshopProject("future-carriage")!;
const futureSource = getMedia("workshop.ami-legacy.history.gig-3917");
const futureProduct = getMedia("workshop.ami-legacy.model-3917.vehicle");
const futureCampaign = getMedia("workshop.ami-legacy.hero");
const ami = getMedia("avatar.identity.ami");

const programProof = {
  "character-mannequin": getMedia("workshop.program-index.character-mannequin"),
  "avatar-host": getMedia("workshop.program-index.avatar-host"),
  "before-after": getMedia("workshop.program-index.before-after"),
  "cute-corrupted": getMedia("workshop.program-index.cute-corrupted"),
  "alter-ego": getMedia("workshop.program-index.alter-ego"),
} as const;

const outputs = [
  { title: "Publication", body: "Long-form article, visual essay, gallery, or recurring series.", href: "/articles/", label: "Read Articles", event: "workshop_publication_continue", image: getMedia("workshop.route-card.publication") },
  { title: "Motion and social", body: "Avatar introduction, short clip, diagram, carousel, or trailer with a return path to the source.", href: "/presents/", label: "Explore Presents", event: "workshop_presents_continue", image: getMedia("workshop.route-card.motion-social") },
  { title: "Marketplace", body: "Character pack, image set, template, digital product, edition, or related listing when one is verified.", href: "/shop/", label: "Browse Shop", event: "workshop_shop_continue", image: getMedia("workshop.route-card.marketplace") },
  { title: "Academy", body: "Guided method, lesson, exercise, source packet, and production template.", href: "/academy/", label: "Continue to Academy", event: "workshop_academy_continue", image: getMedia("workshop.route-card.academy") },
  { title: "Applications and studio work", body: "Interactive tool, web experience, campaign, VFX element, or custom production.", href: "/workshop/stylefusion/", label: "Explore an application", event: "workshop_application_open", image: getMedia("workshop.route-card.applications-studio") },
] as const;

const tools = [
  { title: "StyleFusion", body: "Assigns reference images clear jobs, extracts usable visual rules, and compiles a production record.", href: "/workshop/stylefusion/", label: "Inspect StyleFusion", image: getMedia("workshop.route-card.stylefusion") },
  { title: "Wonder Machine", body: "Turns authored world rules, state, routes, and character memory into an interactive story application.", href: "/presents/other-alice-adventures/", label: "See the application", image: getMedia("workshop.route-card.wonder-machine") },
  { title: "Voice and avatar production", body: "Connects a stable identity to a role, voice, expression, motion direction, captions, and a real destination.", href: "/workshop/avatar-host/", label: "Open Avatar & Host", image: getMedia("workshop.route-card.voice-avatar-production") },
  { title: "Image, motion, and delivery", body: "Uses research, photography, design, compositing, editing, code, and format-specific finishing to publish the work.", href: "/workshop/workshop-notes/", label: "Read the records", image: getMedia("workshop.route-card.image-motion-delivery") },
] as const;

const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const workshopJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "HobFarm Workshop",
  description: "The production method and visible record behind HobFarm articles, characters, visual worlds, applications, products, motion, and studio work.",
  url: `${siteOrigin}/workshop/`,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: primaryWorkshopPrograms.map((program, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: program.name,
      url: `${siteOrigin}${program.href}`,
    })),
  },
};
---

<BaseLayout
  title="Workshop | The Production Method Behind HobFarm"
  description="See the sources, decisions, transformations, direction, and finished outputs behind HobFarm articles, characters, visual worlds, applications, products, and motion."
  canonical="/workshop/"
  structuredData={workshopJsonLd}
  image={workshopHero.src}
  imageAlt={workshopHero.alt}
  palette="blue-red"
>
  <main class="workshop-hub">
    <section class="workshop-hero" aria-labelledby="workshop-hero-heading">
      <Wrapper variant="standard" class="workshop-hero__wrapper">
        <div class="workshop-hero__layout">
          <figure class="workshop-hero__figure">
            <div class="workshop-hero__media">
              <img src={workshopHero.src} alt={workshopHero.alt} width={workshopHero.width} height={workshopHero.height} loading="eager" fetchpriority="high" decoding="async" />
              <header class="workshop-hero__title">
                <p class="eyebrow">HobFarm Workshop</p>
                <h1 id="workshop-hero-heading">One method for different projects.</h1>
              </header>
            </div>
            <figcaption>HobFarm Workshop / source material, character systems, production tools, and finished worlds</figcaption>
          </figure>
          <div class="workshop-hero__after">
            <p class="deck">Start with an idea and find the angle that makes it yours. Build a baseline: a mannequin, scene, landscape, animal, object, or other stable form. Then layer in the influences and techniques that matter. Artists study a style, decide what they value in it, and work those decisions through their own method. The Workshop follows the same habit across different projects and tools.</p>
            <div class="actions">
              <Button isLink size="sm" variant="green" href="#programs">Explore the programs</Button>
              <Button isLink size="sm" variant="muted" href="/workshop/workshop-notes/" data-event="workshop_notes_open">Read Workshop Notes</Button>
            </div>
          </div>
        </div>
      </Wrapper>
    </section>

    <section class="notes-intro" aria-labelledby="notes-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Workshop Notes</p>
            <h2 id="notes-heading">The production record behind HobFarm.</h2>
          </div>
          <div>
            <p>Workshop Notes keeps the sources, questions, decisions, tests, failures, revisions, and reusable findings attached to the finished work. The notes explain what changed, why it changed, and what survived into the next project.</p>
            <p>The five visual programs apply that record to stable forms, recurring hosts, time and condition, tonal corruption, and split personas.</p>
            <a class="text-link" href="/workshop/workshop-notes/" data-event="workshop_notes_open">Read all Workshop Notes <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
        <div class="note-grid">
          {featuredNotes.map((post) => <ArticleCard post={post} />)}
        </div>
      </Wrapper>
    </section>

    <section id="method" aria-labelledby="method-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Shared production method</p>
            <h2 id="method-heading">Start with the source. Keep the decisions visible.</h2>
          </div>
          <p>Research, writing, photography, design, compositing, editing, voice, motion, code, and publishing can all enter the chain. AI is one production tool inside it. The method is older than the current software.</p>
        </div>
        <div class="method-strip-wrap"><WorkshopMethodStrip showMedia /></div>
      </Wrapper>
    </section>

    <section id="programs" class="programs-section" aria-labelledby="programs-heading">
      <Wrapper variant="standard" class="section-space">
        <header class="section-heading">
          <p class="eyebrow">Workshop programs</p>
          <h2 id="programs-heading">Five demonstrations of the same method.</h2>
          <p>Each program starts with a source, defines what must stay recognizable, applies a specific kind of change, then directs the result toward a useful form.</p>
        </header>

        <div class="program-stack" aria-label="Workshop program sequence">
          {visualPrograms.map((program) => {
            const proof = program.id in programProof
              ? programProof[program.id as keyof typeof programProof]
              : { src: program.heroImage!, alt: program.heroAlt!, width: 1600, height: 900 };
            const proofSrc = transformImageUrl(proof.src, { width: 1000, quality: 82, fit: "cover" });
            const programNumber = String(program.order - 1).padStart(2, "0");
            return (
              <article class="program-entry" data-program-id={program.id}>
                <div class="program-entry__marker" aria-hidden="true">
                  <span>Program</span>
                  <strong>{programNumber}</strong>
                </div>
                <span class="program-entry__ghost" aria-hidden="true">{programNumber}</span>
                <div class="program-entry__main">
                  <div class="program-entry__narrative">
                    <h3>{program.name}</h3>
                    <p class="program-definition">{program.description}</p>
                    {program.id === "character-mannequin" && <p>The mannequin can be a wedding cake. The character can be a corrupted green cake living in a swamp.</p>}
                    {program.id === "avatar-host" && <p><a class="inline-link" href="/workshop/avatar-host/#ami-future-carriage" data-event="workshop_ami_open">Who is Ami? See how one identity becomes a recurring host.</a></p>}
                    {program.distinction && <p class="distinction">{program.distinction}</p>}
                  </div>
                  <figure class="program-entry__figure">
                    <img src={proofSrc} alt={proof.alt} width={proof.width} height={proof.height} loading="lazy" decoding="async" />
                  </figure>
                  <ol class="program-path" aria-label={`${program.name} source to output path`}>
                    <li><span>Source</span><strong>{program.startsWith[0]}</strong></li>
                    <li><span>Base</span><strong>{program.startsWith.at(-1)}</strong></li>
                    <li><span>Transformation</span><strong>{program.transformation}</strong></li>
                    <li><span>Output</span><strong>{program.outputs[0]}</strong></li>
                  </ol>
                </div>
                <div class="program-entry__footer">
                  <div class="program-meta">
                    <p><strong>Starting inputs</strong>{program.startsWith.join(" · ")}</p>
                    <p><strong>Possible outputs</strong>{program.outputs.join(" · ")}</p>
                  </div>
                  <a class="text-link" href={program.href} data-event="workshop_program_open" data-program-id={program.id}>{program.ctaLabel} <span aria-hidden="true">&rarr;</span></a>
                </div>
              </article>
            );
          })}
        </div>
      </Wrapper>
    </section>

    <section class="future-carriage" aria-labelledby="future-carriage-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Connected case study / Future Carriage</p>
            <h2 id="future-carriage-heading">One project can cross several branches.</h2>
          </div>
          <p>A historical carriage drawing supplies the design evidence. The stable base becomes a future product family. Campaign direction gives the vehicle a world, and Ami gives the campaign a recurring voice and public role.</p>
        </div>

        <div class="carriage-evidence">
          <figure><img src={futureSource.src} alt={futureSource.alt} width={futureSource.width} height={futureSource.height} loading="lazy" decoding="async" /><figcaption>Historical source / Brewster &amp; Co. gig No. 3917</figcaption></figure>
          <figure><img src={futureProduct.src} alt={futureProduct.alt} width={futureProduct.width} height={futureProduct.height} loading="lazy" decoding="async" /><figcaption>Stable design rules / future product study</figcaption></figure>
          <figure><img src={futureCampaign.src} alt={futureCampaign.alt} width={futureCampaign.width} height={futureCampaign.height} loading="lazy" decoding="async" /><figcaption>Directed campaign / product, environment, and Ami</figcaption></figure>
          <figure class="ami-card"><img src={ami.src} alt={ami.alt} width={ami.width} height={ami.height} loading="lazy" decoding="async" /><figcaption>Ami / recurring avatar and spokesperson</figcaption></figure>
        </div>

        <ol class="case-chain" aria-label="Future Carriage development chain">
          {[
            "Historical carriage drawing",
            "Extracted design rules and stable base",
            "Future product transformation",
            "Directed campaign environment",
            "Ami as recurring avatar and spokesperson",
            "Article, image, motion, product study, or course material",
          ].map((step, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><strong>{step}</strong></li>)}
        </ol>
        <div class="route-links">
          <a href={futureCarriage.destination} data-event="workshop_future_carriage_open">Open the Future Carriage case study</a>
          <a href="/workshop/avatar-host/" data-event="workshop_ami_open">See Ami in Avatar &amp; Host</a>
          <a href="/workshop/character-mannequin/" data-event="workshop_program_open" data-program-id="character-mannequin">Follow the stable-base method</a>
        </div>
      </Wrapper>
    </section>

    <section aria-labelledby="outputs-heading">
      <Wrapper variant="standard" class="section-space">
        <header class="section-heading">
          <p class="eyebrow">One project, several useful outputs</p>
          <h2 id="outputs-heading">The next form follows the work.</h2>
        </header>
        <div class="output-grid">
          {outputs.map((output) => (
            <a href={output.href} data-event={output.event}>
              <div class="route-card__media"><img src={output.image.src} alt={output.image.alt} width={output.image.width} height={output.image.height} loading="lazy" decoding="async" /></div>
              <div class="route-card__body"><h3>{output.title}</h3><p>{output.body}</p><strong>{output.label} <span aria-hidden="true">&rarr;</span></strong></div>
            </a>
          ))}
        </div>
      </Wrapper>
    </section>

    <section class="tools-section" aria-labelledby="tools-heading">
      <Wrapper variant="standard" class="section-space">
        <header class="section-heading section-heading--split">
          <div><p class="eyebrow">Tools and applications</p><h2 id="tools-heading">Supporting systems do specific jobs.</h2></div>
          <p>Provider names belong in technical records when they explain a decision. The Workshop hub keeps the durable function visible.</p>
        </header>
        <div class="tool-grid">
          {tools.map((tool) => <a href={tool.href} data-event="workshop_application_open"><div class="route-card__media"><img src={tool.image.src} alt={tool.image.alt} width={tool.image.width} height={tool.image.height} loading="lazy" decoding="async" /></div><div class="route-card__body"><h3>{tool.title}</h3><p>{tool.body}</p><strong>{tool.label} <span aria-hidden="true">&rarr;</span></strong></div></a>)}
        </div>
      </Wrapper>
    </section>

    <section class="final-routes" aria-labelledby="final-routes-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading section-heading--split">
          <div><p class="eyebrow">Latest Workshop Notes</p><h2 id="final-routes-heading">Keep reading or follow the work outward.</h2></div>
          <p>The archive keeps the production record. Academy teaches stable methods. Shop points to verified HobFarm and marketplace shelves. Supporting applications keep their own durable routes.</p>
        </div>
        {moreNotes.length > 0 && <div class="note-grid">{moreNotes.map((post) => <ArticleCard post={post} />)}</div>}
        <div class="final-route-grid">
          <a href="/workshop/workshop-notes/" data-event="workshop_notes_open">Read Workshop Notes</a>
          <a href="/academy/" data-event="workshop_academy_continue">Continue to Academy</a>
          <a href="/shop/" data-event="workshop_shop_continue">Browse Shop and marketplace profiles</a>
          <a href="/workshop/stylefusion/" data-event="workshop_application_open">Explore applications</a>
          <a href="/contact/?subject=creative-project" data-event="workshop_project_inquiry_open">Start a project</a>
        </div>
        <div class="program-index"><WorkshopProgramNav /></div>
      </Wrapper>
    </section>
  </main>
</BaseLayout>

<style>
  .workshop-hub {
    --line: #2c2440;
    --panel: #0d0a13;
    --section-space: clamp(5rem, 10vw, 8rem);
    --content-space: clamp(3rem, 6vw, 4.5rem);
    --cluster-space: clamp(1.75rem, 3vw, 2.5rem);
    background: #07060b;
    color: #aaa5b8;
  }
  .workshop-hub section { border-bottom: 1px solid var(--line); }
  :global(.workshop-hub .section-space) { padding-block: var(--section-space); }
  .eyebrow { margin: 0; color: #55d7ff; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .17em; text-transform: uppercase; }
  h1, h2, h3 { color: white; font-family: var(--font-display); font-weight: 300; }
  h1 { max-width: 66rem; margin: 1.25rem 0 0; font-size: clamp(3.7rem, 9vw, 8.2rem); letter-spacing: -.065em; line-height: .88; text-wrap: balance; }
  h2 { max-width: 66rem; margin: 1rem 0 0; font-size: clamp(2.6rem, 6vw, 5.4rem); letter-spacing: -.05em; line-height: .94; text-wrap: balance; }
  .deck { max-width: 54rem; margin: 2rem 0 0; color: #c5c1d0; font-size: clamp(1rem, 2vw, 1.18rem); line-height: 1.75; }
  .actions, .route-links { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: var(--cluster-space); }
  .workshop-hero { background: radial-gradient(circle at 82% 18%, rgb(85 215 255 / .12), transparent 32rem), radial-gradient(circle at 10% 70%, rgb(191 45 88 / .1), transparent 28rem), #07060b; }
  :global(.workshop-hero__wrapper) { padding-top: clamp(1.25rem, 2vw, 2rem); padding-bottom: clamp(4rem, 8vw, 6.5rem); }
  .workshop-hero__layout { display: grid; gap: 0; }
  .workshop-hero__figure, .carriage-evidence figure { margin: 0; overflow: hidden; border: 1px solid #3b3150; border-radius: .7rem; background: #08070b; }
  .workshop-hero__media { position: relative; isolation: isolate; }
  .workshop-hero__media::after { position: absolute; z-index: 0; inset: 0 43% 0 0; background: linear-gradient(90deg, rgb(237 227 208 / .2), transparent); content: ""; pointer-events: none; }
  .workshop-hero__figure img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .workshop-hero__title { position: absolute; z-index: 1; top: clamp(.75rem, 2.5vw, 2.5rem); left: clamp(1rem, 4vw, 4rem); width: min(47%, 34rem); }
  .workshop-hero__title .eyebrow { color: #174e5a; }
  .workshop-hero__title h1 { max-width: 8ch; margin-top: clamp(.55rem, 1.4vw, 1.1rem); color: #151016; font-size: clamp(2rem, 6.4vw, 6.5rem); line-height: .84; text-wrap: balance; text-shadow: 0 1px 0 rgb(255 255 255 / .28); }
  .workshop-hero__after { padding-top: clamp(1.5rem, 3vw, 2.5rem); }
  .workshop-hero__after .deck { margin-top: 0; }
  figcaption { padding: .7rem .85rem; color: #908a9f; font-family: var(--font-mono); font-size: .55rem; letter-spacing: .05em; line-height: 1.5; text-transform: uppercase; }
  .notes-intro, .programs-section, .tools-section, .final-routes { background: #0a0810; }
  .section-heading { max-width: 64rem; }
  .section-heading--split { display: grid; gap: var(--cluster-space); max-width: none; }
  .section-heading > p:not(.eyebrow), .section-heading--split > p, .section-heading--split > div:last-child > p { max-width: 48rem; margin: 1.5rem 0 0; line-height: 1.75; }
  .text-link, .inline-link { color: #77e8eb; text-underline-offset: .25rem; }
  .text-link { display: inline-block; margin-top: 1.75rem; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .05em; text-decoration: none; text-transform: uppercase; }
  .note-grid { display: grid; gap: 1.25rem; margin-top: var(--content-space); }
  .method-strip-wrap { margin-top: var(--content-space); }
  .program-stack { position: relative; margin-top: var(--content-space); }
  .program-stack::before { position: absolute; top: 0; bottom: 0; left: 1rem; width: 1px; background: #2ddfe3; content: ""; opacity: .72; }
  .program-entry { position: relative; min-width: 0; padding: 3.25rem 0 3.5rem 3rem; border-top: 1px solid var(--line); }
  .program-entry:first-child { padding-top: 0; border-top: 0; }
  .program-entry__marker { position: absolute; top: 3.25rem; left: 0; z-index: 2; display: grid; width: 2rem; justify-items: center; gap: .35rem; color: #55d7ff; font-family: var(--font-mono); text-align: center; text-transform: uppercase; }
  .program-entry:first-child .program-entry__marker { top: 0; }
  .program-entry__marker::after { position: absolute; top: 1.05rem; left: .73rem; width: .58rem; height: .58rem; border-radius: 50%; background: #55d7ff; box-shadow: 0 0 0 3px #0a0810; content: ""; transform: translateY(-50%); }
  .program-entry__marker span { display: none; font-size: .52rem; letter-spacing: .12em; }
  .program-entry__marker strong { margin-top: 1.8rem; font-size: .9rem; font-weight: 400; letter-spacing: .04em; }
  .program-entry__ghost { display: none; }
  .program-entry__main { display: grid; gap: clamp(2rem, 5vw, 3.5rem); }
  .program-entry h3 { max-width: 42rem; margin: 0; font-size: clamp(2.6rem, 7vw, 5.2rem); letter-spacing: -.05em; line-height: .92; text-wrap: balance; }
  .program-definition, .program-entry__narrative > p:not(.distinction) { max-width: 42rem; margin: 1.35rem 0 0; line-height: 1.7; }
  .distinction { margin: 1.5rem 0 0; padding-left: .8rem; border-left: 2px solid #d04a93; color: #d9c2d2; line-height: 1.7; }
  .program-entry__figure { min-width: 0; margin: 0; overflow: hidden; border: 1px solid #3b3150; border-radius: .18rem; background: #060509; }
  .program-entry__figure img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .program-path { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .program-path li { position: relative; min-width: 0; padding-left: 1.9rem; }
  .program-path li::before { position: absolute; top: .72rem; left: 0; width: 1rem; height: 1px; background: #817b91; content: ""; }
  .program-path span, .program-meta strong { display: block; color: #55d7ff; font-family: var(--font-mono); font-size: .54rem; letter-spacing: .07em; text-transform: uppercase; }
  .program-path strong { display: block; margin-top: .5rem; color: #d6d1df; font-size: .72rem; font-weight: 400; line-height: 1.5; }
  .program-entry__footer { margin-top: clamp(1.5rem, 3vw, 2.25rem); padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .program-meta { display: grid; gap: .85rem; }
  .program-meta p { margin: 0; color: #918b9e; font-size: .7rem; line-height: 1.6; }
  .program-meta strong { margin-bottom: .35rem; }
  .program-entry__footer .text-link { margin-top: 1.35rem; }
  .future-carriage { background: radial-gradient(circle at 86% 20%, rgb(197 147 75 / .14), transparent 32rem), #090807; }
  .future-carriage .eyebrow { color: #d3a75f; }
  .carriage-evidence { display: grid; gap: 1rem; margin-top: var(--content-space); }
  .carriage-evidence img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .carriage-evidence figure:first-child img { padding: .4rem; background: #eee8db; object-fit: contain; }
  .carriage-evidence .ami-card img { object-position: center 22%; }
  .case-chain { display: grid; gap: .75rem; margin: var(--cluster-space) 0 0; padding: 0; list-style: none; }
  .case-chain li { min-height: 7.5rem; padding: 1.1rem; border: 1px solid #473b30; background: #0e0c0a; }
  .case-chain span { color: #d3a75f; font-family: var(--font-mono); font-size: .56rem; }
  .case-chain strong { display: block; margin-top: 2.25rem; color: #f4f0e8; font-size: .74rem; font-weight: 500; line-height: 1.45; }
  .route-links a, .final-route-grid a { display: inline-flex; min-height: 2.8rem; align-items: center; padding: .65rem .8rem; border: 1px solid #493d55; border-radius: .35rem; color: #ded9e6; font-family: var(--font-mono); font-size: .58rem; letter-spacing: .04em; text-decoration: none; text-transform: uppercase; }
