    </section>

    <section class="border-b border-base-800/70" aria-labelledby="circuit-heading">
      <Wrapper variant="standard" class="py-16 lg:py-24">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.58fr)_minmax(0,1fr)] lg:items-start">
          <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent-magenta-bright">The full circuit</p>
            <h2 id="circuit-heading" class="mt-4 font-display text-4xl font-light text-white lg:text-5xl">
              The Workshop does not end at the tutorial.
            </h2>
            <p class="mt-5 text-sm leading-relaxed text-base-300">
