---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import ArticleCard from "@/components/articles/ArticleCard.astro";
import { mediaImageUrl } from "@/lib/gallery";
import { getVisualSystem } from "@/data/visual-systems";
import {
  workshopBenches,
  workshopLayers,
  workshopResearch,
} from "@/data/workshop-page";
import { articlePath, getArticleDepartment, getPublishedArticles } from "@/lib/articles";
import { workshopPrograms } from "@/data/site-hierarchy";
import WorkshopMediaIndex from "@/components/workshop/WorkshopMediaIndex.astro";
import WorkshopProcessFilm from "@/components/workshop/WorkshopProcessFilm.astro";
import WorkshopPsyGothLanes from "@/components/workshop/WorkshopPsyGothLanes.astro";
import WorkshopOfferRail from "@/components/relationships/WorkshopOfferRail.astro";
import WorkshopPhotographySource from "@/components/workshop/WorkshopPhotographySource.astro";
import WorkshopProjectGrid from "@/components/workshop/WorkshopProjectGrid.astro";
import WorkshopMethodStrip from "@/components/workshop/WorkshopMethodStrip.astro";
import { workshopProcessFilm } from "@/data/workshop-process-film";
import {
  getWorkshopProject,
  workshopCapabilities,
} from "@/data/workshop-projects";

const visibleWorkshopPrograms = workshopPrograms.filter((program) => program.noindex !== true);
const programGroups = [
  {
    id: "character",
    title: "Character",
    programIds: ["character-mannequin", "alter-ego", "cute-corrupted", "avatar-host"],
  },
  {
    id: "world",
    title: "World",
    programIds: ["seed-to-world", "fashion-grammar", "book-package", "stylefusion"],
  },
  {
    id: "time-motion",
    title: "Time and motion",
    programIds: ["before-after", "motion", "workshop-notes"],
  },
].map((group) => ({
  ...group,
  programs: group.programIds.flatMap((id) => {
    const program = visibleWorkshopPrograms.find((entry) => entry.id === id);
    return program ? [program] : [];
  }),
}));
const futureCarriage = getWorkshopProject("future-carriage")!;
const futureSource = futureCarriage.secondaryMedia!;
const futureResult = futureCarriage.media;
const heroProjectIds = [
  "other-alice-world",
  "before-after",
  "stylefusion",
  "character-mannequin",
] as const;
const heroProjectDetails = {
  "other-alice-world": {
    headline: "A working map of Wonderland",
    description:
      "The atlas tracks regions, routes, Houses, boundary mountains, and the Park Anomaly for the Other Alice story world.",
    action: "Open the world guide",
  },
  "before-after": {
    headline: "An abandoned laundry, rebuilt",
    description:
      "The finished frame from Shit to Shine 01 rebuilds a ruined laundry as a near-future utility room.",
    action: "Open Before & After",
  },
  stylefusion: {
    headline: "References turned into production direction",
    description:
      "This engraving study is a StyleFusion result. The application assigns each source image a job, extracts usable rules, and compiles a production record.",
    action: "Open StyleFusion",
  },
  "character-mannequin": {
    headline: "The production board beneath a character",
    description:
      "The board separates the neutral body, face and hair, wardrobe, camera, scene, and motion tests so later versions keep the same identity.",
    action: "Open the workflow",
  },
} as const;
const heroProjects = heroProjectIds.filter(
  (id) => workshopPrograms.find((program) => program.id === id)?.inNav !== false,
).flatMap((id) => {
  const project = getWorkshopProject(id);
  return project ? [{ ...project, hero: heroProjectDetails[id] }] : [];
});

const notes = (await getPublishedArticles())
  .filter((post) => getArticleDepartment(post.data) === "workshop-notes")
  .slice(0, 9);

const system = getVisualSystem("sophia-stella");
const sophia = system?.variants.find((variant) => variant.key === "sophia");
const stella = system?.variants.find((variant) => variant.key === "stella");

const image = (folder: string, file: string, width: number, fit: "cover" | "scale-down" = "cover") =>
  mediaImageUrl(folder, file, { width, quality: 84, fit });

const sophiaHero = sophia?.hero ? image(sophia.hero.folder, sophia.hero.file, 1000) : null;
const stellaHero = stella?.hero ? image(stella.hero.folder, stella.hero.file, 1000) : null;
const sophiaSheet = sophia?.sheetPreviews[0]
  ? image(sophia.sheetPreviews[0].folder, sophia.sheetPreviews[0].file, 900, "scale-down")
  : null;
const stellaSheet = stella?.sheetPreviews[0]
  ? image(stella.sheetPreviews[0].folder, stella.sheetPreviews[0].file, 900, "scale-down")
  : null;
const pairPoster = system?.featuredAssets.poster
  ? image(system.featuredAssets.poster.folder, system.featuredAssets.poster.file, 1100)
  : null;
const pairVideo = null;

const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const workshopJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "HobFarm Workshop",
  description:
    "Selected concept campaigns, product visualization, character systems, photography, archival work, motion, and creative-production records from HobFarm.",
  url: `${siteOrigin}/workshop/`,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: notes.map((note, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: note.data.title,
      url: `${siteOrigin}${articlePath(note)}/`,
    })),
  },
};
---

<BaseLayout
  title="Workshop | Concept Campaigns, Visual Development, and Production"
  description="See HobFarm concept campaigns, product visualization, character systems, photography, archival work, motion, interactive worlds, and creative-production records."
  canonical="/workshop/"
  structuredData={workshopJsonLd}
  palette="blue-red"
>
  <div class="workshop-page">
    <section class="workshop-hero relative isolate overflow-hidden border-b border-base-800/70" aria-labelledby="workshop-hero-heading">
      <Wrapper variant="standard" class="py-16 lg:py-24">
        <header class="workshop-hero__heading">
          <p class="font-mono text-[10px] uppercase tracking-[0.24em] text-accent-blue-bright">
            HobFarm / Workshop
          </p>
          <h1 id="workshop-hero-heading" class="mt-5 font-display text-5xl font-light leading-[1.05] text-white text-balance lg:text-7xl">
            Bring the idea. Build the visual system.
          </h1>
          <p class="mt-6 max-w-3xl text-base leading-relaxed text-base-300 lg:text-lg">
            HobFarm turns products, archives, characters, photographs, stories, and references into campaigns, scenes, motion, interactive pages, and production records.
          </p>
          <div class="mt-8 flex flex-wrap gap-2">
            <Button isLink size="sm" variant="green" href="#selected-projects">View selected projects</Button>
            <Button isLink size="sm" variant="muted" href="#method">See the method</Button>
            <Button isLink size="sm" variant="muted" href="/contact/?subject=creative-project">Start a project</Button>
          </div>
        </header>

        <div class="hero-project-grid" aria-label="Workshop project range">
          {heroProjects.map((project, index) => (
            <a class="hero-project-card" href={project.destination}>
              <figure>
                <img
                  src={project.media.src}
                  alt={project.media.alt}
                  width={project.media.width}
                  height={project.media.height}
                  loading={index === 0 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : undefined}
                  decoding="async"
                />
              </figure>
              <div class="hero-project-card__copy">
                <p>{project.title}</p>
                <h2>{project.hero.headline}</h2>
                <span>{project.hero.description}</span>
                <strong>{project.hero.action} <span aria-hidden="true">&rarr;</span></strong>
              </div>
            </a>
          ))}
        </div>
      </Wrapper>
    </section>

    <section id="selected-projects" class="border-b border-base-800/70" aria-labelledby="selected-projects-heading">
      <Wrapper variant="standard" class="py-14 lg:py-20">
        <div class="max-w-4xl">
          <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent-cyan">Selected projects</p>
          <h2 id="selected-projects-heading" class="mt-4 font-display text-4xl font-light text-white lg:text-6xl">
            Start with the outcome, then open the production record.
          </h2>
          <p class="mt-5 max-w-3xl text-sm leading-relaxed text-base-300">
            These projects start with different source material and end in different forms. Each card shows the brief, constraints, direction, and production files behind the visible result.
          </p>
        </div>
        <div class="mt-10">
          <WorkshopProjectGrid surface="workshop" />
        </div>
      </Wrapper>
    </section>

    <section class="capabilities-section border-b border-base-800/70" aria-labelledby="capabilities-heading">
      <Wrapper variant="standard" class="py-14 lg:py-20">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.52fr)_minmax(0,1fr)]">
          <div class="max-w-2xl">
            <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent-magenta-bright">What can be built here</p>
            <h2 id="capabilities-heading" class="mt-4 font-display text-4xl font-light text-white lg:text-5xl">
              One finished image or a larger campaign.
            </h2>
            <p class="mt-5 text-sm leading-relaxed text-base-300">
              Work can end with one image, or continue into motion, an interactive page, character sheets, and a documented set of production rules.
            </p>
          </div>
          <div class="capability-grid">
            {workshopCapabilities.map((capability, index) => (
              <article>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{capability.title}</h3>
                <p>{capability.description}</p>
              </article>
            ))}
          </div>
        </div>
      </Wrapper>
    </section>

    <section class="future-carriage-feature border-b border-base-800/70" aria-labelledby="future-carriage-heading">
      <Wrapper variant="standard" class="py-16 lg:py-24">
        <header class="future-carriage-feature__heading">
          <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-amber-300">Featured case study / Future Carriage</p>
            <h2 id="future-carriage-heading">A historical drawing becomes a product campaign.</h2>
          </div>
          <div>
            <p>
              The source plate establishes the wheel scale, seating, silhouette, lamps, suspension, and pulling geometry. Propulsion and control change; the carriage keeps its identity.
            </p>
            <a href={futureCarriage.destination}>Open the complete case study <span aria-hidden="true">&rarr;</span></a>
          </div>
        </header>

        <div class="future-carriage-feature__comparison">
          <figure>
            <img src={futureSource.src} alt={futureSource.alt} width={futureSource.width} height={futureSource.height} loading="lazy" decoding="async" />
            <figcaption>Historical source / Brewster &amp; Co. gig No. 3917</figcaption>
          </figure>
          <figure>
            <img src={futureResult.src} alt={futureResult.alt} width={futureResult.width} height={futureResult.height} loading="lazy" decoding="async" />
            <figcaption>Product study / robot-pulled Model 3917 family</figcaption>
          </figure>
        </div>

        <ol class="future-carriage-feature__chain" aria-label="Future Carriage development chain">
          {[
            "Historical plate",
            "Extracted design rules",
            "Future product study",
            "Directed environment",
            "Campaign image or motion",
          ].map((step, index) => (
            <li><span>{String(index + 1).padStart(2, "0")}</span><strong>{step}</strong></li>
          ))}
        </ol>
      </Wrapper>
    </section>

    <section id="method" class="method-section border-b border-base-800/70" aria-labelledby="method-heading">
      <Wrapper variant="standard" class="py-16 lg:py-24">
        <div class="method-section__heading">
          <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent-blue-bright">How the work is developed</p>
            <h2 id="method-heading">One production method. Five useful stages.</h2>
          </div>
          <p>
            AI is one part of the chain. Research, concept development, continuity rules, camera direction, compositing, editing, typography, delivery formats, and revision decide what the project becomes.
          </p>
        </div>
        <div class="mt-10">
          <WorkshopMethodStrip />
        </div>
      </Wrapper>
    </section>

    <section id="programs" class="border-b border-base-800/70" aria-labelledby="programs-heading">
      <Wrapper variant="standard" class="py-14 lg:py-20">
        <div class="max-w-3xl">
          <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent-cyan">Workshop programs and archive</p>
          <h2 id="programs-heading" class="mt-4 font-display text-4xl font-light text-white lg:text-5xl">Browse the detailed programs.</h2>
          <p class="mt-5 text-sm leading-relaxed text-base-300">These programs hold full case studies, comparisons, character systems, and current build notes.</p>
        </div>
        <div class="mt-10 space-y-12">
          {programGroups.map((group) => (
            <section aria-labelledby={`program-group-${group.id}`}>
              <h3 id={`program-group-${group.id}`} class="font-mono text-xs uppercase tracking-[0.2em] text-accent-cyan">
                {group.title}
              </h3>
              <div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                {group.programs.map((program) => <a href={program.href} class="program-card group relative isolate min-h-72 overflow-hidden rounded-xl border border-base-800 bg-base-950/70 p-6 transition hover:-translate-y-1 hover:border-accent-cyan/50 motion-reduce:transition-none motion-reduce:hover:translate-y-0">
                  {program.heroImage && <img src={program.heroImage} alt="" width="800" height="450" class="absolute inset-0 -z-20 size-full object-cover opacity-25 transition group-hover:opacity-35" loading="lazy" decoding="async" />}
                  <span class="absolute inset-0 -z-10 bg-gradient-to-t from-base-950 via-base-950/85 to-base-950/25"></span>
                  <div class="flex h-full flex-col justify-end"><p class="font-mono text-[9px] uppercase tracking-[0.18em] text-accent-cyan">Program {String(program.order).padStart(2,"0")}</p><h4 class="mt-3 font-display text-2xl font-light text-white">{program.name}</h4><p class="mt-3 text-sm leading-relaxed text-base-300">{program.description}</p><span class="mt-6 font-mono text-[10px] uppercase tracking-wider text-white">{program.ctaLabel} &rarr;</span></div>
                </a>)}
              </div>
            </section>
          ))}
        </div>
      </Wrapper>
    </section>

    <section id="process-film" class="process-film-section border-b border-base-800/70" aria-labelledby="process-film-heading">
      <Wrapper variant="standard" class="py-16 lg:py-24">
        <header class="process-film-section__header">
          <div>
            <p>Process Film 01 / Zima</p>
            <h2 id="process-film-heading">Follow the decisions, not just the finished frame.</h2>
          </div>
          <div>
            <p>
              One PsyGoth identity moves from a written brief into a neutral mannequin, visual-language rules, wardrobe, a directed scene, and the published avatar performance. The source strip stays visible so every change has something to answer to.
            </p>
            <nav aria-label="Related process routes">
              <a href="/workshop/character-mannequin/" data-event="workshop_character_mannequin_clicked">Character / Mannequin</a>
              <a href="/workshop/stylefusion/" data-event="workshop_stylefusion_clicked">StyleFusion</a>
              <a href="/workshop/workshop-notes/psygoth/">PsyGoth note</a>
            </nav>
          </div>
        </header>

        <div class="mt-10">
          <WorkshopProcessFilm
            manifest={workshopProcessFilm}
            variant="wide"
            id="workshop-process-film"
            showNavigator={true}
            showReferenceStrip={true}
            showTranscript={true}
            showNotes={true}
            transcriptOpen={false}
            autoplay={false}
            loop={false}
          />
        </div>
      </Wrapper>
    </section>

    <WorkshopPsyGothLanes />

    <WorkshopPhotographySource />

    <WorkshopMediaIndex showStyleFusion={true} />

    <section class="border-b border-base-800/70" aria-labelledby="practice-heading">
      <Wrapper variant="standard" class="py-14 lg:py-20">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,0.62fr)_minmax(0,1fr)] lg:items-start">
          <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-base-500">Why the Workshop starts here</p>
            <h2 id="practice-heading" class="mt-3 font-display text-3xl font-light text-white lg:text-4xl">
              Art direction comes before production.
            </h2>
            <p class="mt-5 text-sm leading-relaxed text-base-300">
              Artists have always learned by studying color, form, composition, materials, and the work that came before them. Animation studios call the early phase visual development: the point where characters, worlds, palettes, and composition begin serving the story.
            </p>
            <p class="mt-4 text-sm leading-relaxed text-base-300">
              HobFarm uses computer tools inside that older practice. The software changes. The questions stay recognizable: What does this world value? How is it drawn? Which traits make the character herself? What should the camera make us feel?
            </p>
          </div>

          <div class="grid gap-3 sm:grid-cols-3">
            {workshopLayers.map((layer) => (
              <article class="rounded-xl border border-base-800 bg-base-950/55 p-5" style={`--layer-accent:${layer.accent}`}>
                <span class="layer-dot block size-2.5 rounded-full" aria-hidden="true"></span>
                <h3 class="mt-6 font-display text-xl font-light text-white">{layer.label}</h3>
                <p class="mt-3 text-sm leading-relaxed text-base-400">{layer.description}</p>
              </article>
            ))}
          </div>
        </div>
      </Wrapper>
    </section>

    {system && (
      <section id="sophia-stella" class="case-study border-b border-base-800/70" aria-labelledby="case-study-heading">
        <Wrapper variant="standard" class="py-12 lg:py-16">
          <header class="grid gap-6 lg:grid-cols-[minmax(0,0.75fr)_minmax(20rem,0.45fr)] lg:items-end">
            <div>
              <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent-magenta-bright">Compact case study / Sophia + Stella</p>
              <h2 id="case-study-heading" class="mt-4 font-display text-4xl font-light text-white text-balance lg:text-5xl">
                One base can still lead two lives.
              </h2>
            </div>
            <p class="max-w-xl text-sm leading-relaxed text-base-300 lg:justify-self-end">
              Sophia and Stella remain one complete example inside the larger Workshop. Their shared face, proportions, and feline silhouette survive two opposing palettes, wardrobes, attitudes, and worlds.
            </p>
          </header>

          <div class="case-study__detail mt-10 grid gap-4 lg:grid-cols-2">
            <article class="overflow-hidden rounded-xl border border-base-800 bg-base-950/65">
              {sophiaHero && <img src={sophiaHero} alt={sophia?.hero?.alt ?? "Sophia hero"} class="aspect-[16/10] w-full object-cover object-top" loading="lazy" decoding="async" />}
              <div class="p-6">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent-cyan">Candy-rave / playful / luminous</p>
                <h3 class="mt-3 font-display text-3xl font-light text-white">Sophia</h3>
                <p class="mt-3 text-sm leading-relaxed text-base-300">Pastel club light, glossy materials, charm-heavy fashion, open body language, and a world designed to glow around her.</p>
              </div>
            </article>
            <article class="overflow-hidden rounded-xl border border-base-800 bg-base-950/65">
              {stellaHero && <img src={stellaHero} alt={stella?.hero?.alt ?? "Stella hero"} class="aspect-[16/10] w-full object-cover object-top" loading="lazy" decoding="async" />}
              <div class="p-6">
                <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent-red-bright">Gothic club / dominant / nocturnal</p>
                <h3 class="mt-3 font-display text-3xl font-light text-white">Stella</h3>
                <p class="mt-3 text-sm leading-relaxed text-base-300">Dark surfaces, red and gold light, heavier hardware, low-angle authority, and an environment that turns the shared silhouette into a threat.</p>
              </div>
            </article>
          </div>

          <div class="case-study__detail mt-4 grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.42fr)]">
            <div class="grid gap-4 sm:grid-cols-2">
              {sophiaSheet && <img src={sophiaSheet} alt={sophia?.sheetPreviews[0]?.alt ?? "Sophia character sheet preview"} class="w-full rounded-xl border border-base-800 bg-base-950 object-contain" loading="lazy" decoding="async" />}
              {stellaSheet && <img src={stellaSheet} alt={stella?.sheetPreviews[0]?.alt ?? "Stella character sheet preview"} class="w-full rounded-xl border border-base-800 bg-base-950 object-contain" loading="lazy" decoding="async" />}
            </div>
            <aside class="rounded-xl border border-base-800 bg-base-900/55 p-6">
              <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-base-500">The production logic</p>
              <ol class="mt-6 space-y-5">
                {[
                  ["Eyes first", "Test line, lashes, iris, catchlight, shading, finish, and palette in the densest part of the style."],
                  ["Sheet locks", "Resolve front, back, three-quarter, silhouette, outfit, materials, and identity before adding scene drama."],
                  ["Hero sells", "Use lens, pose, depth, lighting, and environment to make the character feel alive in her own world."],
                  ["Poster connects", "Pair the two lives into one visual hook that can carry story, product, and promotional meaning."],
                  ["Video moves", "Add one camera move, one character action, and one environmental motion without redesigning canon."],
                ].map(([title, text], index) => (
                  <li class="grid grid-cols-[1.75rem_1fr] gap-3">
                    <span class="font-mono text-[10px] text-accent-blue-bright">{String(index + 1).padStart(2, "0")}</span>
                    <div>
                      <h3 class="text-sm text-white">{title}</h3>
                      <p class="mt-1 text-xs leading-relaxed text-base-400">{text}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </aside>
          </div>

          <div class="case-study__compact-media mt-6 grid gap-4 md:grid-cols-[minmax(0,0.6fr)_minmax(18rem,0.4fr)]">
            {pairPoster && (
              <div class="media-frame media-frame--compact">
                <img
                  src={pairPoster}
                  alt={system.featuredAssets.poster?.alt ?? "Sophia and Stella poster"}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            {pairVideo && (
              <div class="media-frame media-frame--compact">
                <video
                  src={pairVideo}
                  poster={pairPoster ?? undefined}
                  muted
                  loop
                  controls
                  playsinline
                  preload="none"
                  aria-label={system.featuredAssets.teaserVideo?.alt ?? "Sophia and Stella video preview"}
                ></video>
              </div>
            )}
          </div>

          <WorkshopOfferRail
            method={{
              label: "Learn the character system",
              href: "/academy/avatar-content-system/",
              description: "Follow the repeatable workflow behind character production.",
            }}
            assets={{
              label: "Browse character assets on DeviantArt",
              href: "https://www.deviantart.com/hobfarm",
              description: "Open the verified HobFarm profile. Individual purchase links appear only on live listings.",
            }}
            support={{
              label: "Support the next character project",
              href: "/support/",
              description: "Choose a one-time contribution, membership, Shop purchase, or course.",
            }}
            heading="Continue from the Sophia and Stella case study"
          />
        </Wrapper>
      </section>
    )}

    <section class="border-b border-base-800/70" aria-labelledby="benches-heading">
      <Wrapper variant="standard" class="py-16 lg:py-24">
        <div class="max-w-3xl">
          <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent-cyan">Working benches</p>
          <h2 id="benches-heading" class="mt-4 font-display text-4xl font-light text-white lg:text-5xl">
            Follow the part of the process you need.
          </h2>
        </div>
        <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {workshopBenches.map((bench) => (
            <a href={bench.href} class="bench-card group flex min-h-64 flex-col rounded-xl border border-base-800 bg-base-900/45 p-6 transition duration-300 hover:-translate-y-1 hover:border-accent-cyan/40 motion-reduce:transition-none motion-reduce:hover:translate-y-0">
              <h3 class="font-display text-2xl font-light text-white">{bench.label}</h3>
