---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import SheetToHero from "@/components/workshop/SheetToHero.astro";
import VisualSystemMap from "@/components/workshop/VisualSystemMap.astro";
import ProductAssetStack from "@/components/workshop/ProductAssetStack.astro";
import AssetManifest from "@/components/workshop/AssetManifest.astro";
import ToolRouteNote from "@/components/workshop/ToolRouteNote.astro";
import AmbientVideoFrame from "@/components/media/AmbientVideoFrame.astro";
import RelatedContentRail from "@/components/relationships/RelatedContentRail.astro";
import { getVisualSystem } from "@/data/visual-systems";
import { mediaImageUrl, mediaUrl } from "@/lib/gallery";
import { resolveRelatedContent, type AssetManifestRef } from "@/lib/content-relationships";

const system = getVisualSystem("sophia-stella")!;
const sophia = system.variants.find((variant) => variant.key === "sophia")!;
const stella = system.variants.find((variant) => variant.key === "stella")!;
const poster = system.featuredAssets.poster!;
const teaser = system.featuredAssets.teaserVideo!;
const products = await getCollection("products");
const product = products.find((entry) => entry.id === "sophia-stella-sheet-pack")!;

const preview = (asset: { folder: string; file: string }) =>
  mediaImageUrl(asset.folder, asset.file, { width: 1200, quality: 82, fit: "scale-down" });

const sophiaSheet = preview(sophia.sheetPreviews[0]);
const sophiaHero = preview(sophia.hero!);
const stellaSheet = preview(stella.sheetPreviews[0]);
const stellaHero = preview(stella.hero!);
const pairPoster = preview(poster);
const teaserVideo = mediaUrl(teaser.folder, teaser.file);

const manifest: AssetManifestRef[] = [
  { id: "SS-SHT-A-PREVIEW", label: "Sophia sheet", role: "sheet", preview: sophiaSheet, format: "JPG", dimensions: "capped web preview" },
  { id: "SS-HERO-A-PREVIEW", label: "Sophia Hero", role: "hero", preview: sophiaHero, format: "JPG", dimensions: "capped web preview" },
  { id: "SS-SHT-B-PREVIEW", label: "Stella sheet", role: "sheet", preview: stellaSheet, format: "JPG", dimensions: "capped web preview" },
  { id: "SS-HERO-B-PREVIEW", label: "Stella Hero", role: "hero", preview: stellaHero, format: "PNG", dimensions: "capped web preview" },
  { id: "SS-POSTER-AB-PREVIEW", label: "Sophia / Stella poster", role: "poster", preview: pairPoster, format: "JPG", dimensions: "capped web preview" },
  { id: "SS-VIDEO-AB-PREVIEW", label: "Sophia / Stella teaser", role: "video", preview: pairPoster, format: "MP4", dimensions: "16:9" },
  { id: "SS-SHT-A-FULL", label: "Sophia full-resolution sheet", role: "download", buyerFile: true, format: "image" },
  { id: "SS-SHT-B-FULL", label: "Stella full-resolution sheet", role: "download", buyerFile: true, format: "image" },
];

const relatedItems = await resolveRelatedContent(product.data);
---

<BaseLayout
  title="Visual Lab: Sophia / Stella | HobFarm Workshop"
  description="A noindex local review route for the medium-depth Sophia and Stella editorial system."
  canonical="/workshop/visual-lab/"
  image={mediaUrl(poster.folder, poster.file)}
  imageAlt={poster.alt}
  palette="magenta-cyan"
  noindex
>
  <article class="visual-lab">
    <header class="visual-lab__hero">
      <Wrapper variant="standard" class="py-16 lg:py-24">
        <p class="kicker">Noindex review route / Direction 2</p>
        <h1>One identity, two visual systems, one readable production chain.</h1>
        <p class="deck">This lab uses the existing Sophia and Stella packet to test interactive editorial components without changing public navigation, character canon, store status, or R2 assets.</p>
        <nav aria-label="Visual lab sections">
          <a href="#comparison">Compare</a><a href="#system-map">Map</a><a href="#stack">Assets</a><a href="#motion">Motion</a><a href="#connections">Connections</a>
        </nav>
      </Wrapper>
    </header>

    <section id="comparison" class="visual-lab__section">
      <Wrapper variant="standard" class="py-16 lg:py-24">
        <div class="comparison-grid">
          <SheetToHero sheet={{ src: sophiaSheet, alt: sophia.sheetPreviews[0].alt, label: "Sophia sheet" }} hero={{ src: sophiaHero, alt: sophia.hero!.alt, label: "Sophia Hero" }} title="Sophia: sheet to Hero" description="The identity lock stays fixed while the sheet becomes a luminous candy-rave scene." id="sophia-sheet-to-hero" />
          <SheetToHero sheet={{ src: stellaSheet, alt: stella.sheetPreviews[0].alt, label: "Stella sheet" }} hero={{ src: stellaHero, alt: stella.hero!.alt, label: "Stella Hero" }} title="Stella: sheet to Hero" description="The same mannequin logic moves into darker surfaces, smoke, and nightclub authority." id="stella-sheet-to-hero" />
        </div>
      </Wrapper>
    </section>

    <section id="system-map" class="visual-lab__section visual-lab__section--tinted">
      <Wrapper variant="standard" class="py-16 lg:py-24">
        <VisualSystemMap
          title="Visual system source map"
          sources={[
            { label: "Shared mannequin", role: "Identity anchor", controls: ["face", "feline silhouette", "eyes", "proportions"], accent: "#55d7ff" },
            { label: "Sophia rules", role: "Bright variant", controls: ["neon pastel palette", "glossy fashion", "playful energy"], accent: "#ff4fc3" },
            { label: "Stella rules", role: "Dark variant", controls: ["black surfaces", "smoke", "red-gold light", "authority"], accent: "#e23a4e" },
          ]}
          result={{ label: "Sophia / Stella system", description: "A shared identity expressed through two controlled aesthetic systems and one connected media packet." }}
        />
      </Wrapper>
    </section>

    <section id="stack" class="visual-lab__section">
      <Wrapper variant="standard" class="py-16 lg:py-24">
        <ProductAssetStack items={manifest} />
        <div class="manifest-gap"><AssetManifest items={manifest} /></div>
      </Wrapper>
    </section>

    <section id="motion" class="visual-lab__section visual-lab__section--tinted">
      <Wrapper variant="standard" class="py-16 lg:py-24">
        <div class="motion-grid">
          <div><p class="kicker">Poster first / motion on request</p><h2>Ambient motion without an autoplay tax.</h2><p>The poster is complete content. The MP4 is not requested until the visitor activates the native control.</p></div>
          <AmbientVideoFrame src={teaserVideo} poster={pairPoster} label={teaser.alt} caption="Existing Sophia / Stella teaser. No new generation or upload was used." />
        </div>
        <div class="tool-gap"><ToolRouteNote route={{ required: ["Astro", "CSS and SVG", "existing R2 previews"], optional: ["Image cleanup after approval", "authored motion after cost review"], fallback: ["static figures", "captions", "manifest and canonical links"], note: "The page remains complete when scripts, video, or optional tools are unavailable." }} /></div>
      </Wrapper>
    </section>

    <section id="connections" class="visual-lab__section">
      <Wrapper variant="standard" class="py-16 lg:py-24">
        <RelatedContentRail items={relatedItems} heading="Follow the Sophia / Stella system" id="visual-lab-related" />
      </Wrapper>
    </section>
  </article>
</BaseLayout>

<style>
  .visual-lab { background: radial-gradient(circle at 80% 6%, rgba(255,79,195,.1), transparent 32rem), #07060b; }
  .visual-lab__hero { border-bottom: 1px solid #2c2440; background: linear-gradient(120deg, rgba(14,11,22,.96), rgba(7,6,11,.8)), url("https://cdn.hob.farm/visual-systems/sophia-stella-poster-hd.jpg") center 22% / cover; }
  .kicker { margin: 0; color: #55d7ff; font-family: var(--font-mono); font-size: .65rem; letter-spacing: .16em; text-transform: uppercase; }
  h1 { max-width: 60rem; margin: 1rem 0 0; color: #fff; font-family: var(--font-display); font-size: clamp(3rem, 8vw, 7rem); font-weight: 300; letter-spacing: -.055em; line-height: .88; text-wrap: balance; }
  .deck { max-width: 48rem; margin: 1.5rem 0 0; color: #c8c6d4; font-size: 1rem; line-height: 1.7; }
  nav { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 2rem; }
  nav a { padding: .65rem .8rem; border: 1px solid #433559; color: #ece9f5; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
  nav a:hover { border-color: #55d7ff; }
  .visual-lab__section { scroll-margin-top: 6rem; border-bottom: 1px solid #2c2440; }
  .visual-lab__section--tinted { background: rgba(14,11,22,.55); }
  .comparison-grid { display: grid; gap: 5rem; }
  .manifest-gap, .tool-gap { margin-top: 2rem; }
  .motion-grid { display: grid; gap: 2rem; align-items: center; }
  .motion-grid h2 { margin: .7rem 0 0; color: #fff; font-family: var(--font-display); font-size: clamp(2.2rem, 5vw, 4rem); font-weight: 300; line-height: .98; }
  .motion-grid p:last-child { max-width: 36rem; margin-top: 1rem; color: #9b96ad; line-height: 1.65; }
  @media (min-width: 1000px) { .motion-grid { grid-template-columns: minmax(16rem, .55fr) minmax(0, 1fr); } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
