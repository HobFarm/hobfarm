---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CharacterMannequinPage from "@/components/workshop/CharacterMannequinPage.astro";
import {
  characterLooks,
  characterMannequinPage,
} from "@/data/character-mannequin";
import { transformImageUrl } from "@/lib/media-transforms";

const page = characterMannequinPage;
const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const canonical = "/workshop/character-mannequin/";
const socialImage = transformImageUrl(page.heroGraphic.src, {
  width: 1200,
  quality: 82,
  fit: "cover",
});
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${siteOrigin}${canonical}#page`,
      name: "Character / Mannequin Workshop",
      description: page.description,
      url: `${siteOrigin}${canonical}`,
      image: socialImage,
      isPartOf: {
        "@type": "CollectionPage",
        name: "HobFarm Workshop",
        url: `${siteOrigin}/workshop/`,
      },
      mainEntity: {
        "@type": "ItemList",
        itemListElement: characterLooks.map((look, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: look.title,
          url: `${siteOrigin}${canonical}#${look.id}`,
        })),
      },
    },
    ...characterLooks.map((look) => ({
      "@type": "VideoObject",
      name: `${look.title} motion study`,
      description: look.motion.alt,
      thumbnailUrl: transformImageUrl(look.scene.src, {
        width: 900,
        quality: 82,
        fit: "cover",
      }),
      contentUrl: look.motion.src,
      isPartOf: { "@id": `${siteOrigin}${canonical}#page` },
    })),
  ],
};
---

<BaseLayout
  title={page.title}
  description={page.description}
  canonical={canonical}
  image={socialImage}
  imageAlt={page.heroGraphic.alt}
  structuredData={structuredData}
  palette="blue-red"
>
  <CharacterMannequinPage />
</BaseLayout>
