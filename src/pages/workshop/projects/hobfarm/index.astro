---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Breadcrumbs from "@/components/global/Breadcrumbs.astro";
import ArticleSubjectMesh from "@/components/workshop/ArticleSubjectMesh.astro";
import ConnectedWork from "@/components/workshop/ConnectedWork.astro";
import HobFarmProductionDiagram from "@/components/workshop/HobFarmProductionDiagram.astro";
import NodeCompositionDiagram from "@/components/workshop/NodeCompositionDiagram.astro";
import ProjectNodeAnatomy from "@/components/workshop/ProjectNodeAnatomy.astro";
import WorkshopNodeMesh from "@/components/workshop/WorkshopNodeMesh.astro";
import { getEditorialSubject } from "@/data/editorial-mesh";
import { getMedia } from "@/data/media-registry";
import {
  acadiaComposition,
  edgeVocabulary,
  primaryComposition,
  replaceableStructureExamples,
} from "@/data/workshop-node-mesh";
import {
  articlePath,
  articleSubjectPath,
  getPublishedArticles,
  stripArticleExt,
} from "@/lib/articles";

const hero = getMedia("workshop.hobfarm-project.hero");
const processHero = getMedia("workshop.hobfarm-project.process");
const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const canonical = "/workshop/projects/hobfarm/";
const canonicalUrl = `${siteOrigin}${canonical}`;
const description = "How HobFarm keeps Articles, projects, workflows, applications, media, and releases independently useful while connecting them to make new work.";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteOrigin}/#organization`,
      name: "HobFarm",
      url: `${siteOrigin}/`,
    },
    {
      "@type": "WebSite",
      "@id": `${siteOrigin}/#website`,
      name: "HobFarm",
      url: `${siteOrigin}/`,
      publisher: { "@id": `${siteOrigin}/#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      name: "The HobFarm composable node mesh",
      description,
      url: canonicalUrl,
      isPartOf: { "@id": `${siteOrigin}/#website` },
      mainEntity: { "@id": `${canonicalUrl}#project` },
    },
    {
      "@type": "CreativeWork",
      "@id": `${canonicalUrl}#project`,
      name: "The HobFarm composable node mesh",
      description,
      url: canonicalUrl,
      image: hero.src,
      creator: { "@id": `${siteOrigin}/#organization` },
      mainEntityOfPage: { "@id": `${canonicalUrl}#webpage` },
      isPartOf: {
        "@type": "CollectionPage",
        "@id": `${siteOrigin}/workshop/projects/#collection`,
        name: "HobFarm Workshop Projects",
        url: `${siteOrigin}/workshop/projects/`,
      },
      about: { "@id": `${siteOrigin}/#website` },
    },
  ],
};

const standaloneExamples = [
  { kind: "Project", label: "Future Carriage", href: "/workshop/future-carriage/", description: "A complete concept project with historical constraints, a vehicle family, campaign language, and its own public record." },
  { kind: "Workflow", label: "Avatar & Host", href: "/workshop/avatar-host/", description: "A reusable character-continuity method with stable identity, role, reference, voice, and motion direction." },
  { kind: "Application", label: "EZIZE", href: "/ezize/", description: "A private-alpha application whose recipe, probability math, pull, and Ledger make sense as one system." },
  { kind: "Workflow", label: "Before & After", href: "/workshop/before-and-after/", description: "A source-integrity and transformation method that keeps documentary, restorative, and speculative work legible." },
  { kind: "Editorial", label: "An Article", href: "/articles/", description: "A readable work with its own question, evidence, argument, media, metadata, and canonical route." },
  { kind: "Subject", label: "A recurring subject", href: "/articles/topics/", description: "A useful path through two or more released Articles that share a durable concept." },
] as const;

type PublishingSurface = { label: string; href?: string; job: string };

const publishingSurfaces: readonly PublishingSurface[] = [
  { label: "Articles", href: "/articles/", job: "Publish a real investigation, argument, report, release note, or reusable finding." },
  { label: "Workshop", href: "/workshop/", job: "Keep the project, method, experiment, revision, and production record." },
  { label: "Presents", href: "/presents/", job: "Give a recurring story, character, title, or developed world its audience-facing home." },
  { label: "Applications", href: "/ezize/", job: "Let a tool or game operate through its own durable route." },
  { label: "Gallery", href: "/gallery/", job: "Keep visual evidence and releases available across Editorial, Workshop, Presents, Projects, and Shop." },
  { label: "Academy", href: "/academy/", job: "Teach a repeatable method after real work has tested it." },
  { label: "Shop", href: "/shop/", job: "Route a verified finished deliverable to the right direct or external shelf." },
  { label: "External distribution", job: "Handle audience, video, gallery, download, and marketplace jobs without becoming the source of truth." },
] as const;

const boundedExamples = [
  "Avatar & Host can pass a character reference sheet into a Future Carriage scene. It does not pass the workflow's entire history.",
  "Future Carriage can pass vehicle references and campaign constraints into a film scene. It does not absorb every Workshop transportation record.",
  "An Article can reference a subject without importing every note ever attached to that subject.",
] as const;

const publishedArticles = await getPublishedArticles();
const articleExampleSlugs = ["gary-and-the-fork", "goth-get-boots"] as const;
const articleExampleEntries = articleExampleSlugs.map((slug) => {
  const article = publishedArticles.find((entry) => stripArticleExt(entry.id) === slug);
  if (!article) throw new Error(`Living-book example Article is not public: ${slug}`);
  if (!article.data.mesh?.subjects.includes("model-behavior")) {
    throw new Error(`Living-book example Article does not use the model-behavior subject: ${slug}`);
  }
  return { title: article.data.title, href: `${articlePath(article)}/` };
}) as [{ title: string; href: string }, { title: string; href: string }];
const articleExampleSubject = getEditorialSubject("model-behavior");
if (!articleExampleSubject) throw new Error("The model-behavior subject is not registered.");
---

<BaseLayout
  title="Useful Work Can Stand Alone and Still Connect | HobFarm Workshop"
  description={description}
  canonical={canonical}
  image={hero.src}
  imageAlt={hero.alt}
  palette="blue-red"
  structuredData={structuredData}
>
  <div class="hobfarm-mesh-page">
    <Wrapper variant="standard" class="breadcrumbs">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Workshop", href: "/workshop/" }, { label: "Projects", href: "/workshop/projects/" }, { label: "HobFarm" }]} />
    </Wrapper>

    <header class="mesh-hero">
      <Wrapper variant="standard">
        <div class="mesh-hero__copy">
          <div>
            <p class="eyebrow">HobFarm / The website is part of the work</p>
            <h1>Useful work can stand alone and still connect.</h1>
          </div>
          <div class="hero-summary">
            <p>HobFarm is built from Articles, projects, workflows, applications, characters, media, and releases that remain useful by themselves.</p>
            <p>A real relationship can connect two nodes. Two or more nodes can also contribute selected parts to something new, while the original work stays intact and reusable.</p>
            <div class="actions"><a href="#what-is-a-node">What counts as a node?</a><a href="#live-mesh">Open the live mesh</a></div>
          </div>
        </div>
        <figure class="hero-figure">
          <img src={hero.src} alt={hero.alt} width={hero.width} height={hero.height} loading="eager" fetchpriority="high" decoding="async" />
          <figcaption>HobFarm / independently useful work connected through selected editorial, production, and publishing relationships</figcaption>
        </figure>
      </Wrapper>
    </header>

    <section id="what-is-a-node" aria-labelledby="node-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading">
          <div><p class="eyebrow">What is a node?</p><h2 id="node-heading">A node is a bounded body of work with a reason to exist.</h2></div>
          <div class="section-copy">
            <p>A HobFarm node has enough identity, context, structure, or output to stand on its own and connect to other work.</p>
            <p>A page, tag, card, image, or file does not become a node automatically. It becomes useful as a node when its identity or reusable value can support a real relationship.</p>
          </div>
        </div>
        <div class="diagram-space"><ProjectNodeAnatomy /></div>
      </Wrapper>
    </section>

    <section class="standalone" aria-labelledby="standalone-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading">
          <div><p class="eyebrow">Each node stands alone</p><h2 id="standalone-heading">Connections add capability. They do not rescue unfinished work.</h2></div>
          <div class="section-copy">
            <p>Each node keeps enough of its own sources, rules, decisions, and outputs to remain understandable by itself. Another project can use one of those parts without collapsing both records into the same thing.</p>
          </div>
        </div>
        <div class="standalone-grid">
          {standaloneExamples.map((example) => (
            <article><span>{example.kind}</span><h3><a href={example.href}>{example.label}</a></h3><p>{example.description}</p></article>
          ))}
        </div>
      </Wrapper>
    </section>

    <section aria-labelledby="edges-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading">
          <div><p class="eyebrow">Connections have jobs</p><h2 id="edges-heading">An edge says why two nodes connect.</h2></div>
          <div class="section-copy">
            <p>HobFarm does not connect everything to everything. A relationship is added when an artifact, decision, subject, method, output, or destination actually travels across it.</p>
            <p>Direction matters. A Workshop record may document a project; the project does not necessarily document the record.</p>
          </div>
        </div>
        <dl class="edge-grid">
          {edgeVocabulary.map((edge) => <div><dt>{edge.meaning}</dt><dd>{edge.description}</dd></div>)}
        </dl>
        <aside class="bounded-context" aria-labelledby="bounded-heading">
          <div><p class="eyebrow">Bounded context</p><h3 id="bounded-heading">Only the useful part travels.</h3></div>
          <ul>{boundedExamples.map((example) => <li>{example}</li>)}</ul>
        </aside>
      </Wrapper>
    </section>

    <section class="composition-section" aria-labelledby="composition-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading">
          <div><p class="eyebrow">Composition creates another node</p><h2 id="composition-heading">Existing work can supply the parts for a new production.</h2></div>
          <div class="section-copy">
            <p>Avatar &amp; Host and Future Carriage already have their own sources, rules, outputs, and routes. A campaign frame or scene can select continuity material from one and vehicle, setting, and campaign material from the other.</p>
            <p>A video workflow could combine a character sheet with depth, camera, movement, and scene references to place the same character inside a moving environment. The permanent architecture does not depend on the current video provider.</p>
          </div>
        </div>
        <div class="diagram-space"><NodeCompositionDiagram example={primaryComposition} /></div>
      </Wrapper>
    </section>

    <section class="hypothetical" aria-labelledby="hypothetical-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading">
          <div><p class="eyebrow">Nodes can compose again</p><h2 id="hypothetical-heading">A third node can change the direction of an existing project.</h2></div>
          <div class="section-copy">
            <p>Future Carriage could combine with a future Acadia carriage-road research node to produce a speculative national-park carriage concept. That composite could later connect to Avatar &amp; Host for a campaign, fictional visitor story, film, advertisement, Article, or Workshop record.</p>
            <p>This diagram explains reuse. It is not a factual Acadia study, a real park proposal, or evidence of involvement by Acadia or the National Park Service.</p>
          </div>
        </div>
        <div class="diagram-space"><NodeCompositionDiagram example={acadiaComposition} /></div>
      </Wrapper>
    </section>

    <section class="living-book" aria-labelledby="living-book-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading">
          <div><p class="eyebrow">Articles become a living book</p><h2 id="living-book-heading">Subjects create routes that chronology could not predict.</h2></div>
          <div class="section-copy">
            <p>An Article is an independent Editorial node. A recurring subject can connect Articles published at different times, asked through different questions, or filed in different sections.</p>
            <p>HobFarm exposes a public subject route only after at least two released Articles share that canonical subject. A later Article can reveal a useful connection that did not exist when the earlier one was published.</p>
          </div>
        </div>
        <div class="diagram-space">
          <ArticleSubjectMesh articles={articleExampleEntries} subject={{ label: articleExampleSubject.label, href: articleSubjectPath(articleExampleSubject.id) }} />
        </div>
        <div class="mesh-behaviors">
          <article><span>Knowledge and Editorial mesh</span><h3>Readers move through meaning.</h3><p>Articles connect through subjects, people, places, events, technologies, works, source artifacts, strict series, and selected related Articles.</p></article>
          <article><span>Production and project mesh</span><h3>Existing work becomes usable again.</h3><p>Projects, workflows, applications, characters, avatars, media, visual systems, courses, products, and releases can contribute bounded parts to later work.</p></article>
        </div>
      </Wrapper>
    </section>

    <section aria-labelledby="surfaces-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading">
          <div><p class="eyebrow">Nodes publish in different forms</p><h2 id="surfaces-heading">Public surfaces are destinations, not steps in a funnel.</h2></div>
          <div class="section-copy">
            <p>A research question may need only an Article. A character workflow may need a Workshop record and an external visual release. A method may become an application and a Workshop Note. A recurring character world may belong in Presents.</p>
            <p>No project has to become an Article, video, course, product, and social post. Each destination needs a real job.</p>
          </div>
        </div>
        <div class="surface-grid">
          {publishingSurfaces.map((surface) => (
            <article><h3>{surface.href ? <a href={surface.href}>{surface.label}</a> : surface.label}</h3><p>{surface.job}</p></article>
          ))}
        </div>
      </Wrapper>
    </section>

    <section class="replaceable" aria-labelledby="replaceable-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading">
          <div><p class="eyebrow">Tools can change</p><h2 id="replaceable-heading">The durable core should survive the next provider.</h2></div>
          <div class="section-copy">
            <p>Sources, identity, authored rules, constraints, expected inputs and outputs, validation, and the production record belong to the node. Models, renderers, APIs, editing tools, CMS components, and hosting services are replaceable implementation details.</p>
          </div>
        </div>
        <div class="replacement-grid">
          {replaceableStructureExamples.map((example) => (
            <article><h3>{example.label}</h3><dl><div><dt>Stable core</dt><dd>{example.stable}</dd></div><div><dt>Replaceable</dt><dd>{example.replaceable}</dd></div></dl></article>
          ))}
        </div>
      </Wrapper>
    </section>

    <section id="development" class="development" aria-labelledby="development-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading">
          <div><p class="eyebrow">How one node develops</p><h2 id="development-heading">Building exposes the real cost and the next useful decision.</h2></div>
          <div class="section-copy">
            <p>The old HobFarm lifecycle still describes how one node grows. An idea becomes concrete enough to test; code, production time, APIs, hosting, maintenance, and distribution become visible; then the work can continue, simplify, publish what it learned, or wait.</p>
            <p>The repository keeps the sources, routes, components, media, platform decisions, revisions, and failures that explain what changed. The first version is evidence for the next one.</p>
          </div>
        </div>
        <div class="process-layout">
          <figure class="process-figure"><img src={processHero.src} alt={processHero.alt} width={processHero.width} height={processHero.height} loading="lazy" decoding="async" /><figcaption>Ideas go in. What matters stays. This diagram describes one node's development loop rather than the architecture of the whole mesh.</figcaption></figure>
          <HobFarmProductionDiagram />
        </div>
      </Wrapper>
    </section>

    <section id="live-mesh" class="live-mesh" aria-labelledby="live-mesh-heading">
      <Wrapper variant="standard" class="section-space">
        <div class="section-heading">
          <div><p class="eyebrow">The live HobFarm mesh</p><h2 id="live-mesh-heading">Current nodes keep their own routes and selected relationships.</h2></div>
          <div class="section-copy">
            <p>This curated view shows public HobFarm work that already has enough identity to stand alone. It does not register every URL, tag, file, image, or idea.</p>
            <p>Article relationships continue to live in the Editorial Mesh and its public graph. The production view below stays small enough to maintain by hand.</p>
          </div>
        </div>
        <div class="diagram-space"><WorkshopNodeMesh /></div>
      </Wrapper>
    </section>

    <Wrapper variant="standard" class="connected-space">
      <ConnectedWork eyebrow="Open related nodes" title="Follow a relationship with a job." links={[
        { relationship: "Documents production", label: "Workshop", href: "/workshop/" },
        { relationship: "Contributes continuity", label: "Avatar & Host", href: "/workshop/avatar-host/" },
        { relationship: "Contributes a vehicle system", label: "Future Carriage", href: "/workshop/future-carriage/" },
        { relationship: "Powers a current application", label: "EZIZE", href: "/ezize/" },
        { relationship: "Connects the living book", label: "Article subjects", href: "/articles/topics/" },
      ]} />
    </Wrapper>
  </div>
</BaseLayout>

<style>
  .hobfarm-mesh-page { background: #07060b; color: #aaa5b8; }
  .breadcrumbs { padding-top: 1.25rem; }
  .mesh-hero { padding-block: clamp(3.5rem, 8vw, 7rem); border-bottom: 1px solid #2c2440; background: radial-gradient(circle at 16% 20%, rgb(85 215 255 / .13), transparent 30rem), radial-gradient(circle at 92% 28%, rgb(208 74 147 / .08), transparent 34rem), #07060b; }
  .mesh-hero__copy { display: grid; gap: 2rem; align-items: end; }
  .eyebrow { margin: 0; color: #55d7ff; font-family: var(--font-mono); font-size: .61rem; letter-spacing: .15em; text-transform: uppercase; }
  h1, h2 { color: #fff; font-family: var(--font-display); font-weight: 300; letter-spacing: -.055em; text-wrap: balance; }
  h1 { max-width: 64rem; margin: 1rem 0 0; font-size: clamp(3.4rem, 8vw, 7rem); line-height: .88; }
  h2 { margin: .8rem 0 0; font-size: clamp(2.5rem, 6vw, 5rem); line-height: .94; }
  .hero-summary { max-width: 46rem; }
  .hero-summary p { margin: 0; color: #c7c2cf; font-size: clamp(1rem, 2vw, 1.16rem); line-height: 1.75; }
  .hero-summary p + p { margin-top: .8rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1.5rem; }
  .actions a { padding: .7rem .85rem; border: 1px solid #55d7ff; color: #eeeaf3; font-family: var(--font-mono); font-size: .59rem; text-decoration: none; text-transform: uppercase; }
  .actions a:first-child { background: #55d7ff; color: #07060b; }
  .hero-figure, .process-figure { margin: clamp(2rem, 5vw, 4rem) 0 0; overflow: hidden; border: 1px solid #3a304c; border-radius: .8rem; background: #09070e; }
  .hero-figure img, .process-figure img { display: block; width: 100%; height: auto; }
  .hero-figure figcaption, .process-figure figcaption { padding: .7rem; color: #8f899e; font-family: var(--font-mono); font-size: .55rem; line-height: 1.5; text-transform: uppercase; }
  section { border-bottom: 1px solid #2c2440; }
  .standalone, .composition-section, .living-book, .replaceable, .live-mesh { background: #0a0810; }
  :global(.section-space) { padding-block: clamp(4rem, 8vw, 7rem); }
  .section-heading { display: grid; gap: 1.4rem; }
  .section-copy { max-width: 45rem; }
  .section-copy p { margin: 0; line-height: 1.75; }
  .section-copy p + p { margin-top: .8rem; }
  .diagram-space, .standalone-grid, .edge-grid, .bounded-context, .mesh-behaviors, .surface-grid, .replacement-grid, .process-layout { margin-top: clamp(2rem, 4vw, 3.5rem); }
  .standalone-grid, .surface-grid, .replacement-grid, .mesh-behaviors { display: grid; gap: .7rem; }
  .standalone-grid article, .surface-grid article, .replacement-grid article, .mesh-behaviors article { min-width: 0; padding: 1rem; border: 1px solid #342b45; background: #0d0a13; }
  .standalone-grid span, .mesh-behaviors span { color: #55d7ff; font-family: var(--font-mono); font-size: .53rem; letter-spacing: .09em; text-transform: uppercase; }
  .standalone-grid h3, .surface-grid h3, .replacement-grid h3, .mesh-behaviors h3, .bounded-context h3 { margin: .7rem 0 0; color: #f4f0f6; font-family: var(--font-display); font-size: 1.4rem; font-weight: 400; line-height: 1.08; }
  .standalone-grid h3 a, .surface-grid h3 a { color: inherit; text-decoration-color: #566277; text-underline-offset: .2rem; }
  .standalone-grid h3 a:hover, .standalone-grid h3 a:focus-visible, .surface-grid h3 a:hover, .surface-grid h3 a:focus-visible { color: #55d7ff; }
  .standalone-grid p, .surface-grid p, .mesh-behaviors p { margin: .8rem 0 0; color: #9f99aa; font-size: .74rem; line-height: 1.6; }
  .edge-grid { display: grid; gap: .55rem; }
  .edge-grid div { padding: .85rem; border: 1px solid #342b45; background: #0d0a13; }
  .edge-grid dt, .replacement-grid dt { color: #55d7ff; font-family: var(--font-mono); font-size: .53rem; letter-spacing: .07em; text-transform: uppercase; }
  .edge-grid dd, .replacement-grid dd { margin: .4rem 0 0; color: #c5c0cc; font-size: .72rem; line-height: 1.55; }
  .bounded-context { display: grid; gap: 1.25rem; padding: clamp(1.1rem, 3vw, 1.6rem); border: 1px solid #3a304c; border-left: 3px solid #d04a93; background: #0d0a13; }
  .bounded-context ul { display: grid; gap: .65rem; margin: 0; padding-left: 1.15rem; }
  .bounded-context li { color: #aaa4b4; font-size: .76rem; line-height: 1.6; }
  .hypothetical { background: repeating-linear-gradient(135deg, rgb(225 160 82 / .022) 0 1px, transparent 1px 12px), #07060b; }
  .mesh-behaviors article:first-child { border-top: 2px solid #d04a93; }
  .mesh-behaviors article:last-child { border-top: 2px solid #55d7ff; }
  .replacement-grid article { padding: 1.1rem; }
  .replacement-grid h3 { margin: 0; }
  .replacement-grid dl { display: grid; gap: .7rem; margin: 1rem 0 0; }
  .replacement-grid dl div { padding-top: .7rem; border-top: 1px solid #342b45; }
  .process-layout { display: grid; gap: 1rem; align-items: start; }
  .process-figure { margin: 0; }
  :global(.connected-space) { padding-block: clamp(3rem, 6vw, 5rem); }
  @media (min-width: 42rem) {
    .standalone-grid, .surface-grid, .replacement-grid, .mesh-behaviors { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .edge-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64rem) {
    .mesh-hero__copy { grid-template-columns: minmax(0, .95fr) minmax(26rem, .75fr); }
    .section-heading { grid-template-columns: minmax(0, 1.15fr) minmax(24rem, .65fr); align-items: end; }
    .standalone-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .surface-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .replacement-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .edge-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .bounded-context { grid-template-columns: minmax(0, .65fr) minmax(0, 1.35fr); }
    .process-layout { grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); }
  }
  @media (max-width: 30rem) {
    .actions a { width: 100%; text-align: center; }
  }
</style>
