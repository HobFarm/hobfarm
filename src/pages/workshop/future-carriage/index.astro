---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { getMedia } from "@/data/media-registry";

const introVideo = getMedia("workshop.ami-legacy.intro.video");
const hero = getMedia("workshop.ami-legacy.hero");
const modelWithAmi = getMedia("workshop.ami-legacy.model-3917.ami");
const modelVehicle = getMedia("workshop.ami-legacy.model-3917.vehicle");
const autonomousCoach = getMedia("workshop.ami-legacy.autonomous-coach");
const redwoodLifestyle = getMedia("workshop.ami-legacy.redwood-lifestyle");
const redwoodProfile = getMedia("workshop.ami-legacy.redwood-profile");

const historicalReferences = [
  {
    label: "Brewster & Co. gig / No. 3917",
    answer: "Robot-pulled Model 3917 family",
    media: getMedia("workshop.ami-legacy.history.gig-3917"),
    sourceHref: "https://www.metmuseum.org/art/collection/search/378670",
    sourceNote: "The Met Open Access / Public domain",
  },
  {
    label: "Diligence coach",
    answer: "Enclosed electric autonomous coach",
    media: getMedia("workshop.ami-legacy.history.diligence"),
    sourceHref: "https://picryl.com/",
    sourceNote: "PICRYL source / Public domain / CC0 1.0",
  },
  {
    label: "Phaeton / No. 651a",
    answer: "Open four-wheel electric study",
    media: getMedia("workshop.ami-legacy.history.phaeton"),
    sourceHref: "https://picryl.com/",
    sourceNote: "PICRYL source / Public domain / CC0 1.0",
  },
  {
    label: "Vis-à-vis / No. 3049",
    answer: "Social carriage with facing seats",
    media: getMedia("workshop.ami-legacy.history.vis-a-vis"),
    sourceHref: "https://picryl.com/",
    sourceNote: "PICRYL source / Public domain / CC0 1.0",
  },
];

const preserved = [
  "Wheel count and scale",
  "Passenger arrangement",
  "Body silhouette",
  "Canopy and lamps",
  "Suspension and pulling geometry",
  "Visible historical model identity",
];

const developed = [
  "Propulsion",
  "Control system",
  "Materials and finish",
  "Camera and environment",
  "Campaign typography",
  "Presenter and motion treatment",
];

const campaignDirections = [
  {
    title: "Product reveal",
    description: "A clean vehicle plate keeps the robot, both wheels, shafts, and carriage body legible as one system.",
    media: modelVehicle,
  },
  {
    title: "Scenic tourism",
    description: "The redwood road places the carriage in a believable passenger route without losing the full silhouette.",
    media: redwoodLifestyle,
  },
  {
    title: "Luxury hospitality",
    description: "The enclosed coach supports resort, hotel, park-route, or heritage-district advertising as a self-directed concept.",
    media: autonomousCoach,
  },
  {
    title: "Fake commercial",
    description: "A sincere luxury-vehicle frame can turn satirical in the edit. The project packet keeps that direction separate from any real client claim.",
    media: modelWithAmi,
  },
];

const deliverables = [
  "Hero image",
  "Historical source comparison",
  "Clean product plate",
  "Campaign poster",
  "Vertical social cut",
  "Landscape film",
  "Presenter segment",
  "Landing-page case study",
  "Production and continuity record",
];

const productionRecord = [
  {
    title: "Historical reference selection",
    description:
      "Four carriage plates were selected for distinct wheelbases, cabins, seating arrangements, and pulling geometry.",
  },
  {
    title: "Concept and branch rules",
    description:
      "Two-wheel forms keep a visible pulling system and use a robotic draft unit. Four-wheel forms carry electric propulsion and autonomous control.",
  },
  {
    title: "Generated product studies",
    description:
      "Future-vehicle images were developed against the source constraints, then selected into a six-image campaign packet with clean plates, presenter frames, and environmental studies.",
  },
  {
    title: "Continuity and crop direction",
    description:
      "The packet records what must stay visible in each frame. Wide carriage compositions use letterbox, split-screen, or presenter-panel layouts instead of destructive center crops.",
  },
  {
    title: "Camera, setting, and edit planning",
    description:
      "Showroom frames prove the object. Roads and scenic routes prove use. The production plan specifies 9:16, 16:9, carousel, caption, and short-film treatments.",
  },
  {
    title: "Finishing and delivery record",
    description:
      "The supplied images were converted to optimized WebP derivatives without overwriting the originals. The current record does not name an Adobe application, so this case study does not claim one.",
  },
];

const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  headline: "Future Carriage: A Concept Campaign from Historical Carriage Design",
  description:
    "A self-directed HobFarm concept campaign that turns 19th-century carriage drawings into electric, robotic, and autonomous product studies.",
  image: [hero.src, modelVehicle.src, autonomousCoach.src],
  url: `${siteOrigin}/workshop/future-carriage/`,
  creativeWorkStatus: "Concept study",
  video: {
    "@type": "VideoObject",
    name: "Ami campaign-host introduction",
    description: introVideo.alt,
    thumbnailUrl: introVideo.poster,
    contentUrl: introVideo.src,
    uploadDate: "2026-07-22T06:33:05Z",
    duration: "PT36S",
  },
  isPartOf: {
    "@type": "CollectionPage",
    name: "HobFarm Workshop",
    url: `${siteOrigin}/workshop/`,
  },
};
---

<BaseLayout
  title="Future Carriage: Historical Design to Concept Campaign | HobFarm"
  description="A self-directed product-visualization case study that develops 19th-century carriage drawings into electric, robotic, and autonomous campaign studies."
  canonical="/workshop/future-carriage/"
  structuredData={structuredData}
  image={hero.src}
  imageAlt={hero.alt}
  palette="magenta-cyan"
>
  <article class="carriage-study">
    <header class="campaign-reveal">
      <Wrapper variant="standard" class="py-14 lg:py-24">
        <div class="campaign-reveal__copy">
          <p class="kicker">Independent concept campaign / Product visualization</p>
          <h1>Future Carriage: A Concept Campaign from Historical Carriage Design</h1>
          <p class="deck">
            Start with an 1800s carriage drawing. Keep the wheels, silhouette, seating, lamps, suspension, and pulling geometry. Then replace horse power with an electric, robotic, or autonomous system.
          </p>
          <div class="tag-row" aria-label="Case-study categories">
            <span>No horses</span>
            <span>Historical source study</span>
            <span>Advertising and motion</span>
            <span>Self-directed concept</span>
          </div>
        </div>
        <figure class="campaign-reveal__media">
          <img
            src={hero.src}
            alt={hero.alt}
            width={hero.width}
            height={hero.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption>Campaign reveal / directed still image / Legacy product family</figcaption>
        </figure>
      </Wrapper>
    </header>

    <section class="brief-section" aria-labelledby="brief-heading">
      <Wrapper variant="standard" class="py-12 lg:py-16">
        <div class="brief-card">
          <div>
            <p class="kicker">The brief</p>
            <h2 id="brief-heading">Build a future mobility campaign from historical carriage design.</h2>
          </div>
          <div>
            <p>
              Preserve the identity and operating logic of each carriage while replacing horse power with electric, robotic, or autonomous propulsion.
            </p>
            <p>
              This is a self-directed HobFarm concept study. The images demonstrate a campaign direction; they do not represent a commissioned vehicle or a real transport service.
            </p>
          </div>
        </div>
      </Wrapper>
    </section>

    <section class="source-concept-section" aria-labelledby="source-concept-heading">
      <Wrapper variant="standard" class="py-14 lg:py-24">
        <header class="section-heading">
          <p class="kicker">Source to concept</p>
          <h2 id="source-concept-heading">The drawing creates the constraints.</h2>
          <p>
            The No. 3917 gig plate establishes two wheels, exposed seating, long shafts, tall wheel scale, and visible pulling geometry. The future study answers those decisions instead of using the carriage as surface decoration.
          </p>
        </header>
        <div class="source-concept-grid">
          <figure class="historical-figure">
            <img
              src={historicalReferences[0].media.src}
              alt={historicalReferences[0].media.alt}
              width={historicalReferences[0].media.width}
              height={historicalReferences[0].media.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption><strong>Historical source</strong> Brewster &amp; Co. gig / No. 3917</figcaption>
          </figure>
          <div class="constraint-card">
            <p class="kicker">Design constraints</p>
            <ul>
              <li>Keep the two-wheel pull architecture</li>
              <li>Preserve the tall wheels and compact body</li>
              <li>Keep the shafts visible</li>
              <li>Replace the horse with a purpose-built draft unit</li>
            </ul>
          </div>
          <figure>
            <img src={modelVehicle.src} alt={modelVehicle.alt} width={modelVehicle.width} height={modelVehicle.height} loading="lazy" decoding="async" />
            <figcaption><strong>Product study</strong> Robot-pulled Model 3917 family</figcaption>
          </figure>
          <figure>
            <img src={modelWithAmi.src} alt={modelWithAmi.alt} width={modelWithAmi.width} height={modelWithAmi.height} loading="lazy" decoding="async" />
            <figcaption><strong>Campaign frame</strong> Vehicle and presenter share the frame without hiding the mechanism</figcaption>
          </figure>
        </div>
      </Wrapper>
    </section>

    <section class="preserved-section" aria-labelledby="preserved-heading">
      <Wrapper variant="standard" class="py-14 lg:py-20">
        <header class="section-heading">
          <p class="kicker">Preserved and developed</p>
          <h2 id="preserved-heading">The source stays legible while the product moves forward.</h2>
        </header>
        <div class="preserved-grid">
          <article>
            <h3>Preserved</h3>
            <ul>{preserved.map((item) => <li>{item}</li>)}</ul>
          </article>
          <article>
            <h3>Developed</h3>
            <ul>{developed.map((item) => <li>{item}</li>)}</ul>
          </article>
        </div>
      </Wrapper>
    </section>

    <section class="branches-section" aria-labelledby="branches-heading">
      <Wrapper variant="standard" class="py-14 lg:py-24">
        <header class="section-heading">
          <p class="kicker">Product branches</p>
          <h2 id="branches-heading">The wheel count decides how the future moves.</h2>
          <p>
            These are carriages with new propulsion and control systems. When the historical number is legible, it becomes the model name.
          </p>
        </header>
        <div class="branch-grid">
          <article>
            <span>Two wheels</span>
            <h3>Keep the pulling logic.</h3>
            <p>A robotic draft unit replaces the horse and keeps the old balance and trace geometry visible. This branch suits short ceremonial, park, and novelty routes where the mechanism is part of the experience.</p>
          </article>
          <article>
            <span>Four wheels</span>
            <h3>Integrate electric and autonomous control.</h3>
            <p>Motors, batteries, sensors, and navigation fit into the historical body. This branch supports quiet resort, hotel, heritage-district, and sightseeing transport as a concept direction.</p>
          </article>
        </div>
        <div class="branch-media">
          <figure>
            <img src={modelVehicle.src} alt={modelVehicle.alt} width={modelVehicle.width} height={modelVehicle.height} loading="lazy" decoding="async" />
            <figcaption>Two-wheel branch / visible robotic draft unit</figcaption>
          </figure>
          <figure>
            <img src={autonomousCoach.src} alt={autonomousCoach.alt} width={autonomousCoach.width} height={autonomousCoach.height} loading="lazy" decoding="async" />
            <figcaption>Four-wheel branch / enclosed autonomous coach</figcaption>
          </figure>
        </div>
      </Wrapper>
    </section>

    <section class="directions-section" aria-labelledby="directions-heading">
      <Wrapper variant="standard" class="py-14 lg:py-24">
        <header class="section-heading">
          <p class="kicker">Campaign directions</p>
          <h2 id="directions-heading">One product rule can support several advertising contexts.</h2>
          <p>
            The current image packet covers reveal, travel, hospitality, and deliberate fake-commercial treatments. Each remains a proposed use for a self-directed concept.
          </p>
        </header>
        <div class="direction-grid">
          {campaignDirections.map((direction) => (
            <article>
              <img src={direction.media.src} alt={direction.media.alt} width={direction.media.width} height={direction.media.height} loading="lazy" decoding="async" />
              <div>
                <h3>{direction.title}</h3>
                <p>{direction.description}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="landscape-pair">
          <figure>
            <img src={redwoodLifestyle.src} alt={redwoodLifestyle.alt} width={redwoodLifestyle.width} height={redwoodLifestyle.height} loading="lazy" decoding="async" />
            <figcaption>Scenic tourism / directed environmental frame</figcaption>
          </figure>
          <figure>
            <img src={redwoodProfile.src} alt={redwoodProfile.alt} width={redwoodProfile.width} height={redwoodProfile.height} loading="lazy" decoding="async" />
            <figcaption>Luxury hospitality / quiet profile study</figcaption>
          </figure>
        </div>
      </Wrapper>
    </section>

    <section class="deliverables-section" aria-labelledby="deliverables-heading">
      <Wrapper variant="standard" class="py-14 lg:py-20">
        <div class="deliverables-layout">
          <div>
            <p class="kicker">Campaign deliverables</p>
            <h2 id="deliverables-heading">What the campaign can produce.</h2>
            <p>
              This case study shows how the concept can extend into still, motion, social, web, presenter, and documentation formats.
            </p>
          </div>
          <ul>
            {deliverables.map((deliverable, index) => (
              <li><span>{String(index + 1).padStart(2, "0")}</span><strong>{deliverable}</strong></li>
            ))}
          </ul>
        </div>
      </Wrapper>
    </section>

    <section class="ami-section" aria-labelledby="ami-heading">
      <Wrapper variant="standard" class="py-14 lg:py-24">
        <div class="ami-grid">
          <div class="ami-video">
            <video
              controls
              playsinline
              preload="none"
              poster={introVideo.poster}
              aria-label="Ami's captioned HobFarm introduction"
              aria-describedby="ami-video-note"
            >
              <source src={introVideo.src} type="video/mp4" />
            </video>
            <p id="ami-video-note">Captioned vertical presenter master / 36 seconds / playback starts only when requested</p>
          </div>
          <div>
            <p class="kicker">Ami as presenter</p>
            <h2 id="ami-heading">The campaign host arrives after the product idea.</h2>
            <p>
              Ami can introduce a model, explain its design rule, appear in advertising frames, and carry the format into later episodes. Her current 36-second clip is a general HobFarm introduction, not a completed Future Carriage commercial.
            </p>
            <p>
              The dedicated 30-second vertical proof is approved as the local master. It stays out of the public player until the video, captions, transcript, and poster have durable HobFarm media paths.
            </p>
            <Button isLink size="md" variant="muted" href="/workshop/avatar-host/">
              View the avatar host system
            </Button>
          </div>
        </div>
      </Wrapper>
    </section>

    <section class="production-section" aria-labelledby="production-heading">
      <Wrapper variant="standard" class="py-14 lg:py-24">
        <header class="section-heading">
          <p class="kicker">Production record</p>
          <h2 id="production-heading">What the current project files verify.</h2>
          <p>
            The record covers source selection, concept rules, generated studies, continuity, camera and crop direction, edit planning, captions, delivery formats, and media optimization.
          </p>
        </header>
        <ol class="production-grid">
          {productionRecord.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </li>
          ))}
        </ol>
      </Wrapper>
    </section>

    <section class="sources-section" aria-labelledby="sources-heading">
      <Wrapper variant="standard" class="py-14 lg:py-24">
        <header class="section-heading">
          <p class="kicker">Historical sources</p>
          <h2 id="sources-heading">Four source plates anchor the current model families.</h2>
          <p>
            The No. 3917 gig plate comes from <a href="https://www.metmuseum.org/art/collection/search/378670" target="_blank" rel="noreferrer">The Metropolitan Museum of Art’s Open Access collection</a>.
            The other three plates were found through <a href="https://picryl.com/" target="_blank" rel="noreferrer">PICRYL</a>,
            whose item records identify them as public-domain material under CC0 1.0. The labels preserve the carriage
            names and model numbers recorded in the project files.
          </p>
        </header>
        <div class="source-grid">
          {historicalReferences.map(({ label, answer, media, sourceHref, sourceNote }) => (
            <figure>
              <img src={media.src} alt={media.alt} width={media.width} height={media.height} loading="lazy" decoding="async" />
              <figcaption>
                <strong>Historical source / {label}</strong>
                <span>Current concept answer / {answer}</span>
                <small><a href={sourceHref} target="_blank" rel="noreferrer">{sourceNote}</a></small>
              </figcaption>
            </figure>
          ))}
        </div>
      </Wrapper>
    </section>

    <section class="next-section" aria-labelledby="next-heading">
      <Wrapper variant="standard" class="py-14 lg:py-20">
        <div class="next-grid">
          <div>
            <p class="kicker">Related routes</p>
            <h2 id="next-heading">Continue through the Workshop.</h2>
          </div>
          <nav aria-label="Future Carriage related routes">
            <a href="/workshop/">Return to Workshop</a>
            <a href="/workshop/avatar-host/">View the avatar host system</a>
            <a href="/workshop/character-mannequin/">Follow the stable-base method</a>
            <a href="/workshop/before-and-after/">View Before &amp; After</a>
            <a href="/contact/?subject=creative-project">Start a project</a>
          </nav>
        </div>
      </Wrapper>
    </section>
  </article>
</BaseLayout>

<style>
  .carriage-study {
    background:
      radial-gradient(circle at 12% 8%, rgb(197 147 75 / 0.09), transparent 34rem),
      #080808;
    color: #b9b2aa;
  }

  section,
  .campaign-reveal {
    border-bottom: 1px solid #302922;
  }

  .campaign-reveal {
    background:
      radial-gradient(circle at 18% 10%, rgb(197 147 75 / 0.15), transparent 30rem),
      radial-gradient(circle at 84% 36%, rgb(96 55 130 / 0.1), transparent 34rem),
      #080808;
  }

  .campaign-reveal__copy {
    max-width: 74rem;
  }

  .kicker {
    margin: 0;
    color: #d6ad72;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 76rem;
    margin: 1rem 0 0;
    color: #fffaf2;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 8.5vw, 7.8rem);
    font-weight: 300;
    letter-spacing: -0.06em;
    line-height: 0.9;
    text-wrap: balance;
  }

  .deck {
    max-width: 58rem;
    margin: 1.5rem 0 0;
    color: #d4cec5;
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.75;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.8rem;
  }

  .tag-row span {
    padding: 0.55rem 0.75rem;
    border: 1px solid #665344;
    border-radius: 999px;
    color: #e3c9a6;
    font-family: var(--font-mono);
    font-size: 0.57rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  figure {
    margin: 0;
  }

  .campaign-reveal__media {
    overflow: hidden;
    margin-top: 2.5rem;
    border: 1px solid #4a3b30;
    border-radius: 0.75rem;
    background: #0d0b09;
    box-shadow: 0 32px 90px rgb(0 0 0 / 0.45);
  }

  .campaign-reveal__media img,
  .source-concept-grid img,
  .branch-media img,
  .direction-grid img,
  .landscape-pair img,
  .source-grid img {
    display: block;
    width: 100%;
  }

  figcaption {
    padding: 0.8rem 1rem;
    color: #c9b18e;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.05em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .brief-section,
  .preserved-section,
  .directions-section,
  .ami-section,
  .sources-section {
    background: #0b0a09;
  }

  .brief-card,
  .deliverables-layout,
  .next-grid {
    display: grid;
    gap: 1.5rem;
  }

  .brief-card {
    padding: 1.25rem;
    border: 1px solid #4a3b30;
    border-left: 4px solid #bd8f52;
    border-radius: 0.65rem;
    background: #0e0c0a;
  }

  .brief-card h2,
  .section-heading h2,
  .deliverables-layout h2,
  .ami-grid h2,
  .next-grid h2 {
    max-width: 64rem;
    margin: 0.75rem 0 0;
    color: #fffaf2;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5.2rem);
    font-weight: 300;
    letter-spacing: -0.045em;
    line-height: 0.96;
  }

  .brief-card > div:last-child > p,
  .section-heading > p:last-child,
  .deliverables-layout > div > p:last-child,
  .ami-grid > div:last-child > p,
  .production-grid p {
    max-width: 52rem;
    margin: 1rem 0 0;
    color: #aaa29b;
    line-height: 1.75;
  }

  .brief-card > div:last-child > p:first-child {
    margin-top: 0;
    color: #ddd5ca;
    font-size: 1.05rem;
  }

  .section-heading {
    max-width: 72rem;
  }

  .source-concept-grid,
  .branch-media,
  .direction-grid,
  .landscape-pair,
  .source-grid {
    display: grid;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .source-concept-grid figure,
  .branch-media figure,
  .landscape-pair figure,
  .source-grid figure {
    overflow: hidden;
    border: 1px solid #3a3028;
    border-radius: 0.55rem;
    background: #0d0b09;
  }

  .source-concept-grid img,
  .branch-media img,
  .landscape-pair img {
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .source-concept-grid .historical-figure img,
  .source-grid img {
    aspect-ratio: 4 / 3;
    object-fit: contain;
    background: #eee8db;
  }

  .source-concept-grid figcaption strong {
    display: block;
    color: #fff1dc;
  }

  .constraint-card {
    padding: 1.1rem;
    border: 1px solid #3a3028;
    border-top: 2px solid #bd8f52;
    border-radius: 0.55rem;
    background: #0e0c0a;
  }

  .constraint-card ul,
  .preserved-grid ul {
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .constraint-card li,
  .preserved-grid li {
    padding: 0.72rem 0;
    border-top: 1px solid #332b25;
    color: #c4bbb1;
    font-size: 0.82rem;
  }

  .preserved-grid,
  .branch-grid {
    display: grid;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .preserved-grid article,
  .branch-grid article {
    padding: 1.2rem;
    border: 1px solid #3a3028;
    border-top: 2px solid #bd8f52;
    border-radius: 0.55rem;
    background: #0e0c0a;
  }

  .preserved-grid h3,
  .branch-grid h3,
  .direction-grid h3,
  .production-grid h3 {
    margin: 0;
    color: #fffaf2;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 300;
    line-height: 1;
  }

  .branch-grid article {
    min-height: 20rem;
  }

