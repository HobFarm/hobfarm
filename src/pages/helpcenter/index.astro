---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
// Components
import HelpCenterCard from "@/components/helpcenter/HelpCenterCard.astro";
// Content
import { getCollection } from "astro:content";

const allHelpCenterCard = await getCollection("help");

const hubLinks = [
  {
    title: "Browse Articles",
    description: "Guides for StyleFusion, gallery uploads, and project workflows.",
    linkText: "All Guides",
    linkHref: "#articles",
  },
  {
    title: "Service Status",
    description: "Real-time status for HobFarm services and infrastructure.",
    linkText: "View Status",
    linkHref: "/status",
  },
  {
    title: "Contact Support",
    description: "Reach the HobFarm team directly for help with your account or tools.",
    linkText: "Contact Support",
    linkHref: "/contact/",
  },
];
---

<BaseLayout
  title="Help Center | HobFarm"
  description="HobFarm help center: guides, system status, and contact paths for StyleFusion, Grimoire, HobBot, and gallery workflows."
>
  <section class="bg-noise">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-16">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-y-12">
          <div class="md:col-span-2">
            <Text tag="span" variant="textSM" class="text-white">
              Help center
            </Text>
            <Text
              tag="h1"
              variant="displayMD"
              class="mt-12 text-white text-balance font-display"
            >
              HobFarm Support
              <span class="text-base-400 block">Guides, status, and contact</span>
            </Text>
            <Text tag="p" variant="textBase" class="text-white mt-2 text-balance">
              Get the most out of HobFarm's tools. Browse guides, check service
              status, or reach support directly.
            </Text>
          </div>
          <ul class="grid grid-cols-1 md:grid-cols-3 md:row-start-2 md:col-span-3">
            {
              hubLinks.map((item) => (
                <li class="before:bg-white h-full">
                  <div class="px-4 relative flex flex-col h-full justify-between before:absolute after:absolute before:bg-white before:top-0 before:left-0 before:h-6 before:w-px after:top-8 after:bottom-0 after:left-0 after:w-px">
                    <div>
                      <Text tag="h3" variant="textBase" class="text-white">
                        {item.title}
                      </Text>
                      <Text tag="p" variant="textSM" class="mt-2 text-base-400">
                        {item.description}
                      </Text>
                    </div>
                    <div class="mt-12 flex">
                      <Button
                        isLink
                        size="sm"
                        variant="muted"
                        href={item.linkHref}
                        title={item.title}
                        class="w-auto justify-center"
                      >
                        {item.linkText}
                      </Button>
                    </div>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div id="articles" class="mt-16 lg:mt-24 pt-12 border-t border-base-900 scroll-mt-24">
          <Text tag="h2" variant="displaySM" class="text-white font-display">
            All Articles
          </Text>
          <Text tag="p" variant="textSM" class="text-base-400 mt-2">
            {allHelpCenterCard.length} guides and references.
          </Text>
          <ul
            role="list"
            class="mt-8 divide-y divide-base-900 text-white border-y border-base-900"
          >
            {allHelpCenterCard.map((post) => <HelpCenterCard post={post} />)}
          </ul>
        </div>
      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>
