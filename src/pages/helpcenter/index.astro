---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import HelpCenterCard from "@/components/helpcenter/HelpCenterCard.astro";
import SupportEmailLink from "@/components/support/SupportEmailLink.astro";
import { getCollection } from "astro:content";

const allHelpCenterCard = await getCollection("help");

interface HubLink {
  description: string;
  emailSubject?: string;
  linkHref?: string;
  linkText: string;
  title: string;
}

const hubLinks: HubLink[] = [
  {
    title: "Browse guides",
    description: "Read setup notes, preview documentation, gallery guidance, and project workflows.",
    linkText: "All guides",
    linkHref: "#guides",
  },
  {
    title: "Service status",
    description: "Check HobFarm services and infrastructure before reporting a duplicate issue.",
    linkText: "View status",
    linkHref: "/status/",
  },
  {
    title: "Email Customer Help",
    description: "Send an order, account, access, refund, or application problem directly to HobFarm.",
    linkText: "Email Customer Help",
    emailSubject: "HobFarm Customer Help",
  },
];

interface CustomerHelpTopic {
  body: string;
  cta?: string;
  emailSubject?: string;
  href?: string;
  title: string;
}

const customerHelpTopics: CustomerHelpTopic[] = [
  {
    title: "Payments and refunds",
    body: "Include the payment provider, order ID or receipt, transaction date, and the email address used at checkout. Refund rules vary by item and provider.",
    href: "/legal/refunds/",
    cta: "Read the refund policy",
  },
  {
    title: "Accounts and access",
    body: "Report sign-in problems, missing membership access, missing course lessons, or an entitlement that does not match the receipt.",
  },
  {
    title: "Downloads and courses",
    body: "Name the download or course, the page you used, and what happened. Include an error message or screenshot when it helps explain the problem.",
  },
  {
    title: "Marketplace orders",
    body: "For Etsy, DeviantArt, eBay, or another external platform, include the platform and listing or order number. Platform rules may control delivery, returns, or refunds.",
  },
  {
    title: "Applications and tools",
    body: "For StyleFusion, Grimoire, Daily Signal, galleries, or public demos, include the route, browser, action, and exact error. Do not send passwords or API keys.",
  },
  {
    title: "Security reports",
    body: "Use the security subject for vulnerabilities or privacy concerns. Do not include live credentials, private user data, or access tokens.",
    emailSubject: "HobFarm security report",
    cta: "Email a security report",
  },
];
---

<BaseLayout
  title="Customer Help | HobFarm"
  description="Customer Help for HobFarm payments, refunds, accounts, access, downloads, courses, applications, marketplace orders, guides, and service status."
  canonical="/helpcenter/"
>
  <section class="bg-noise border-b border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <div class="max-w-3xl">
          <Text tag="span" variant="textSM" class="font-mono uppercase tracking-widest text-accent-green-bright">
            Customer Help
          </Text>
          <Text tag="h1" variant="displayXL" class="mt-8 text-balance font-display text-white">
            Help with orders, accounts, courses, and HobFarm tools.
          </Text>
          <Text tag="p" variant="textBase" class="mt-5 max-w-2xl text-balance leading-relaxed text-base-300">
            Start with a guide or service status. If the problem involves a payment, account, download, course, refund, or application, email Customer Help with the details.
          </Text>
        </div>

        <ul class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
          {hubLinks.map((item) => (
            <li class="flex h-full flex-col border border-base-800 bg-base-900/45 p-5">
              <Text tag="h2" variant="textLG" class="font-display text-white">{item.title}</Text>
              <Text tag="p" variant="textSM" class="mt-3 flex-1 leading-relaxed text-base-400">{item.description}</Text>
              <div class="mt-6">
                {item.emailSubject ? (
                  <SupportEmailLink compact label={item.linkText} subject={item.emailSubject} />
                ) : (
                  <Button isLink size="sm" variant="muted" href={item.linkHref!}>{item.linkText}</Button>
                )}
              </div>
            </li>
          ))}
        </ul>
      </Wrapper>
    </ContentPanel>
  </section>

  <section aria-labelledby="customer-help-topics-heading">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <Text id="customer-help-topics-heading" tag="h2" variant="displaySM" class="font-display text-white">
          What Customer Help covers
        </Text>
        <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
          {customerHelpTopics.map((topic) => (
            <article class="border border-base-800 bg-base-900/35 p-6">
              <Text tag="h3" variant="textLG" class="font-display text-white">{topic.title}</Text>
              <p class="mt-3 text-sm leading-relaxed text-base-400">{topic.body}</p>
              {topic.href && topic.cta && (
                <a class="mt-5 inline-flex text-sm text-white underline decoration-base-600 underline-offset-4 hover:decoration-white" href={topic.href}>
                  {topic.cta}
                </a>
              )}
              {topic.emailSubject && topic.cta && (
                <div class="mt-5">
                  <SupportEmailLink compact label={topic.cta} subject={topic.emailSubject} />
                </div>
              )}
            </article>
          ))}
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  <section id="guides" class="scroll-mt-24 border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <Text tag="h2" variant="displaySM" class="font-display text-white">Guides and references</Text>
        <Text tag="p" variant="textSM" class="mt-2 text-base-400">
          {allHelpCenterCard.length} guides and references.
        </Text>
        <ul role="list" class="mt-8 divide-y divide-base-900 border-y border-base-900 text-white">
          {allHelpCenterCard.map((post) => <HelpCenterCard post={post} />)}
        </ul>
      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>
