---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import ComicCard from "@/components/funnies/ComicCard.astro";
import AliceMotionRecords from "@/components/presents/other-alice/AliceMotionRecords.astro";
import AliceVisualDevelopment from "@/components/presents/other-alice/AliceVisualDevelopment.astro";
import { characterPath, characters } from "@/data/characters";
import { getComicSeries, seriesPath } from "@/data/comic-series";
import { getStorySeries, storySeriesPath } from "@/data/story-series";
import { comicsForCharacter, getPublishedComics } from "@/lib/comics";
import {
  OTHER_ALICE_CAST_PATH,
  OTHER_ALICE_WORLD_GUIDE_PATH,
} from "@/data/other-alice-world-guide";

// Other Alice residents only. `/characters/` is retired: comic characters now
// render on their series page under /presents/funnies/, but the Other Alice
// cast carries dossiers, trait plates, and motion records that need a page of
// their own, and Other Alice keeps its own structure.
export async function getStaticPaths() {
  const comics = await getPublishedComics();
  return characters
    .filter((character) => character.relatedSeries.includes("other-alice-adventures"))
    .map((character) => ({
      params: { character: character.slug },
      props: {
        character,
        comics: comicsForCharacter(comics, character.slug).slice(0, 6),
      },
    }));
}

const { character, comics } = Astro.props;
const comicSeries = character.relatedSeries
  .map((slug) => getComicSeries(slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));
const fictionSeries = character.relatedSeries
  .map((slug) => getStorySeries(slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));
const belongsToOtherAlice = fictionSeries.some((series) => series.slug === "other-alice-adventures");
const canonicalPath = characterPath(character.slug);
const canonicalUrl = new URL(canonicalPath, "https://hob.farm").toString();
const heroPortrait = character.heroMedia?.portrait;
const heroLandscape = character.heroMedia?.landscape;
const displayImage = heroPortrait?.src ?? character.image;
const displayImageAlt = heroPortrait?.alt ?? character.imageAlt ?? character.name;
const socialImage = heroLandscape?.src ?? character.image;
const socialImageAlt = heroLandscape?.alt ?? character.imageAlt;
const characterStructuredData = socialImage
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "ProfilePage",
          "@id": `${canonicalUrl}#webpage`,
          url: canonicalUrl,
          name: character.seoTitle ?? `${character.name} | Characters | HobFarm`,
          description: character.metaDescription ?? character.bio,
          image: socialImage,
          mainEntity: { "@id": `${canonicalUrl}#character` },
        },
        {
          "@type": "Person",
          "@id": `${canonicalUrl}#character`,
          name: character.name,
          alternateName: character.slug === "alice" ? "Other Alice" : undefined,
          description: character.bio,
          image: socialImage,
          knowsAbout: character.traits,
          subjectOf: fictionSeries.map((series) => ({
            "@type": "CreativeWorkSeries",
            name: series.title,
            url: new URL(storySeriesPath(series.slug), "https://hob.farm").toString(),
          })),
        },
        {
          "@type": "BreadcrumbList",
          itemListElement: [
            {
              "@type": "ListItem",
              position: 1,
              name: "HobFarm Presents",
              item: "https://hob.farm/presents/",
            },
            {
              "@type": "ListItem",
              position: 2,
              name: "Other Alice Adventures",
              item: "https://hob.farm/presents/other-alice-adventures/",
            },
            {
              "@type": "ListItem",
              position: 3,
              name: "Cast",
              item: new URL(OTHER_ALICE_CAST_PATH, "https://hob.farm").toString(),
            },
            { "@type": "ListItem", position: 4, name: character.name, item: canonicalUrl },
          ],
        },
      ],
    }
  : undefined;
---

<BaseLayout
  title={character.seoTitle ?? `${character.name} | Characters | HobFarm`}
  description={character.metaDescription ?? character.bio}
  canonical={canonicalPath}
  image={socialImage}
  imageAlt={socialImageAlt}
  structuredData={characterStructuredData}
>
  <section>
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-16">
        <a href={OTHER_ALICE_CAST_PATH} class="text-sm text-base-500 transition-colors hover:text-base-100">
          &larr; Other Alice cast
        </a>
        <div class:list={[
          "mt-5 grid grid-cols-1 gap-8",
          displayImage && "lg:grid-cols-[minmax(0,1.15fr)_minmax(280px,0.85fr)] lg:items-start",
        ]}>
          <div>
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
              <Text tag="h1" variant="display2XL" class="font-display text-white text-balance">
                {character.displayName ?? character.name}
              </Text>
              <span class="font-mono text-[10px] uppercase tracking-widest text-base-500">{character.role}</span>
            </div>
            <Text tag="p" variant="textLG" class="mt-4 max-w-2xl text-base-300 leading-relaxed text-pretty">
              {character.heroDeck ?? character.bio}
            </Text>

            {character.traits.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-2">
                {character.traits.map((trait) => (
                  <span class="rounded-full border border-base-700 px-3 py-1 text-xs text-base-300">{trait}</span>
                ))}
              </div>
            )}
          </div>

          {displayImage && (
            <figure class="character-hero-media overflow-hidden rounded-lg border border-base-800 bg-base-950">
              {character.heroMotion ? (
                <video
                  src={character.heroMotion.src}
                  poster={character.heroMotion.poster.src}
                  autoplay
                  muted
                  loop
                  playsinline
                  controls
                  preload="metadata"
                  width={character.heroMotion.width}
                  height={character.heroMotion.height}
                  class="w-full object-cover"
                  aria-label={character.heroMotion.alt}
                ></video>
              ) : (
                <picture>
                  {heroLandscape && <source media="(max-width: 1023px)" srcset={heroLandscape.src} />}
                  <img
                    src={displayImage}
                    alt={displayImageAlt}
                    width={heroPortrait?.width}
                    height={heroPortrait?.height}
                    class="w-full object-cover"
                    loading="eager"
                    decoding="async"
                  />
                </picture>
              )}
            </figure>
          )}
        </div>

        {(character.guideIntro?.length ?? 0) > 0 && (
          <div class="mt-12 max-w-3xl space-y-4 border-t border-base-800 pt-10">
            {character.guideIntro!.map((paragraph, index) => (
              <p class:list={[
                "leading-relaxed text-pretty",
                index === 0 ? "font-display text-xl text-white" : "text-base text-base-400",
              ]}>{paragraph}</p>
            ))}
          </div>
        )}

        {(character.dossier?.length ?? 0) > 0 && (
          <div class="mt-12">
            <Text tag="h2" variant="displaySM" class="mb-5 font-display text-white">Dossier</Text>
            <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {character.dossier!.map((item) => (
                <div class="rounded-lg border border-base-800 bg-base-900/50 p-4">
                  <dt class="font-mono text-[10px] uppercase tracking-widest text-accent-500">{item.label}</dt>
                  <dd class="mt-2 text-sm leading-relaxed text-base-300">{item.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        {character.visualDevelopment && <AliceVisualDevelopment record={character.visualDevelopment} />}

        {character.featureMedia && (
          <figure class="mt-12 overflow-hidden rounded-lg border border-base-800 bg-base-950">
            <img
              src={character.featureMedia.src}
              alt={character.featureMedia.alt}
              width={character.featureMedia.width}
              height={character.featureMedia.height}
              class="aspect-video w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            {character.featureMedia.caption && <figcaption class="border-t border-base-800 px-4 py-3 text-sm leading-relaxed text-base-400">{character.featureMedia.caption}</figcaption>}
          </figure>
        )}

        {(character.motionMedia?.length ?? 0) > 0 && <AliceMotionRecords records={character.motionMedia!} />}

        {(character.guideSections?.length ?? 0) > 0 && (
          <div class="mt-12 grid grid-cols-1 gap-4 lg:grid-cols-2">
            {character.guideSections!.map((section) => (
              <section class:list={["rounded-lg border border-base-800 bg-base-900/50 p-5 sm:p-6", section.media && "lg:col-span-2 lg:grid lg:grid-cols-[minmax(17rem,0.7fr)_minmax(0,1.3fr)] lg:gap-6"]}>
                <div>
                  <h2 class="font-display text-xl text-white">{section.title}</h2>
                  {(section.paragraphs?.length ?? 0) > 0 && (
                    <div class="mt-4 space-y-3">
                      {section.paragraphs!.map((paragraph) => (
                        <p class="text-sm leading-relaxed text-base-400">{paragraph}</p>
                      ))}
                    </div>
                  )}
                  {(section.bullets?.length ?? 0) > 0 && (
                    <ul class="mt-4 space-y-2 text-sm leading-relaxed text-base-400">
                      {section.bullets!.map((bullet) => <li class="flex gap-2"><span class="text-accent-500">&bull;</span><span>{bullet}</span></li>)}
                    </ul>
                  )}
                </div>
                {section.media && (
                  <figure class="mt-5 overflow-hidden rounded-md border border-base-800 bg-base-950 lg:mt-0">
                    <img
                      src={section.media.src}
                      alt={section.media.alt}
                      width={section.media.width}
                      height={section.media.height}
                      style={`aspect-ratio:${section.media.width}/${section.media.height}`}
                      class:list={["w-full", section.media.fit === "contain" ? "object-contain" : "object-cover"]}
                      loading="lazy"
                      decoding="async"
                    />
                    {section.media.caption && <figcaption class="border-t border-base-800 px-4 py-3 text-xs leading-relaxed text-base-400">{section.media.caption}</figcaption>}
                  </figure>
                )}
              </section>
            ))}
          </div>
        )}

        {comicSeries.length > 0 && (
          <div class="mt-12">
            <Text tag="h2" variant="displaySM" class="mb-5 font-display text-white">Comic series</Text>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {comicSeries.map((s) => (
                <a
                  href={seriesPath(s.slug)}
                  class="group rounded-lg border border-base-800 bg-base-900/50 p-4 transition-colors hover:border-accent-green/50"
                >
                  <h3 class="font-display text-base text-white">{s.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-base-400">{s.premise}</p>
                </a>
              ))}
            </div>
            {belongsToOtherAlice && (
              <a
                href={OTHER_ALICE_WORLD_GUIDE_PATH}
                class="mt-4 inline-flex font-mono text-[10px] uppercase tracking-widest text-accent-cyan transition-colors hover:text-white"
              >
                Open the Other Alice World Guide &rarr;
              </a>
            )}
          </div>
        )}

        {fictionSeries.length > 0 && (
          <div class="mt-12">
            <Text tag="h2" variant="displaySM" class="mb-5 font-display text-white">Game world</Text>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {fictionSeries.map((s) => (
                <a
                  href={storySeriesPath(s.slug)}
                  class="group rounded-lg border border-base-800 bg-base-900/50 p-4 transition-colors hover:border-accent-green/50"
                >
                  <h3 class="font-display text-base text-white">{s.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-base-400">{s.logline}</p>
                </a>
              ))}
            </div>
          </div>
        )}

        {fictionSeries.length > 0 ? (
          <div class="mt-12 border-t border-base-800 pt-10">
            <Text tag="h2" variant="displaySM" class="mb-5 font-display text-white">Role in play</Text>
            <p class="max-w-2xl text-sm leading-relaxed text-base-400">
              This dossier records the shared character. Wonder Machine can surface authored people, places, relationships, and consequences when a campaign makes them relevant, but no page can predict a particular player's history.
            </p>
          </div>
        ) : (
          <div class="mt-12 border-t border-base-800 pt-10">
            <Text tag="h2" variant="displaySM" class="mb-5 font-display text-white">Latest comics</Text>
            {comics.length > 0 ? (
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {comics.map((comic) => <ComicCard comic={comic} />)}
            </div>
            ) : (
              <p class="text-sm text-base-400">
                No published comics featuring {character.name} yet. They are in the rotation.
              </p>
            )}
          </div>
        )}

        {character.primaryCta && (
          <div class="mt-12 rounded-lg border border-accent-500/25 bg-accent-500/5 p-6 sm:p-8">
            <h2 class="font-display text-2xl text-white">{character.primaryCta.label}</h2>
            {character.primaryCta.description && (
              <p class="mt-3 max-w-2xl text-sm leading-relaxed text-base-300">{character.primaryCta.description}</p>
            )}
            <div class="mt-5">
              <Button isLink size="base" variant="green" href={character.primaryCta.href}>
                {character.primaryCta.label}
              </Button>
            </div>
          </div>
        )}
      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>

<style>
  .character-hero-media img { aspect-ratio: 3 / 4; }
  @media (max-width: 1023px) {
    .character-hero-media img { aspect-ratio: 16 / 9; }
  }
</style>
