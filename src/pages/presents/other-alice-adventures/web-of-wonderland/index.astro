---
import BaseLayout from "@/layouts/BaseLayout.astro";
import OaaProjectNav from "@/components/presents/other-alice/OaaProjectNav.astro";
import OaaRelationshipWeb from "@/components/presents/other-alice/OaaRelationshipWeb.astro";
import { OTHER_ALICE_WEB_PATH, relationshipEdges, relationshipNodes } from "@/data/other-alice-world-guide";
const structuredData={"@context":"https://schema.org","@type":"Dataset",name:"Web of Wonderland",description:"An evidence-backed map connecting people, Houses, institutions, regions, routes, artifacts, organisms, historical claims, and visitor imprints.",url:new URL(OTHER_ALICE_WEB_PATH,"https://hob.farm").toString(),variableMeasured:["body","knowledge","material","authority","ecology","echo"]};
---
<BaseLayout title="Web of Wonderland | Other Alice Adventures" description="Trace evidence-backed relationships among Wonderland's people, Houses, institutions, regions, routes, artifacts, organisms, history, and visitor imprints." canonical={OTHER_ALICE_WEB_PATH} image="https://cdn.hob.farm/pages/other-alice-adventures/oaa-map-wonderland-living-atlas-v01-16x9.webp" imageAlt="Aerial atlas of circular Wonderland" structuredData={structuredData}>
 <div class="web-page"><OaaProjectNav current="web" /><header><p class="eyebrow">Relationship record</p><h1>Web of Wonderland</h1><p>Power, maintenance, bodies, objects, routes, organisms, and inherited claims form one evidence-backed network. A connection is a claim with a source.</p><dl><div><dt>Nodes</dt><dd>{relationshipNodes.length}</dd></div><div><dt>Connections</dt><dd>{relationshipEdges.length}</dd></div><div><dt>Evidence</dt><dd>Every edge</dd></div></dl></header><section><OaaRelationshipWeb /></section>
  <section class="reading"><h2>How to read the web</h2><div><article><h3>Confirmed</h3><p>Multiple public records support the connection.</p></article><article><h3>Recorded</h3><p>A material, map, observation, or testimony exists without closing every question.</p></article><article><h3>Inferred</h3><p>The pattern is useful and evidence-backed but remains a working reconstruction.</p></article><article><h3>Directional</h3><p>Authority or material can move one way while dependency runs back in the other direction.</p></article></div></section>
 </div>
</BaseLayout>
<style>
 .web-page{min-height:100vh;background:#080a11;color:#eee7d6}.web-page>header,.web-page>section{max-width:90rem;margin:auto;padding:clamp(3.5rem,8vw,8rem) clamp(1rem,4vw,4rem);border-top:1px solid rgba(255,255,255,.1)}.web-page>header{border:0}.eyebrow{color:#9f7aea;font:600 .68rem/1 ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase}h1{max-width:11ch;margin:.7rem 0;font:400 clamp(4rem,10vw,10rem)/.84 Georgia,serif;letter-spacing:-.06em}.web-page header>p:last-of-type{max-width:50rem;color:#b5bac5;font-size:1.1rem;line-height:1.7}.web-page header dl{display:flex;gap:2rem;margin-top:2rem}.web-page header dl div{border-left:2px solid #9f7aea;padding-left:.8rem}.web-page header dt{color:#868d9c;font:600 .62rem/1 ui-monospace,monospace;text-transform:uppercase}.web-page header dd{margin:.4rem 0 0;color:white;font-size:1.2rem}.reading h2{font:400 clamp(2rem,5vw,4.5rem)/1 Georgia,serif}.reading>div{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid rgba(255,255,255,.13)}.reading article{padding:1rem;border-right:1px solid rgba(255,255,255,.12)}.reading h3{color:white}.reading p{color:#adb2bd;line-height:1.55}@media(max-width:650px){h1{font-size:3.8rem}.web-page header dl{display:grid;grid-template-columns:1fr 1fr}.reading>div{grid-template-columns:1fr 1fr}}
</style>
