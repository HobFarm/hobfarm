---
import BaseLayout from "@/layouts/BaseLayout.astro";
import OaaProjectNav from "@/components/presents/other-alice/OaaProjectNav.astro";
import HousePowerStack from "@/components/presents/other-alice/living-world/HousePowerStack.astro";
import { OTHER_ALICE_HOUSES_PATH, courtDossiers, otherAliceCanon, regionPowerRecords, failureCascades } from "@/data/other-alice-world-guide";
const canonicalUrl=new URL(OTHER_ALICE_HOUSES_PATH,"https://hob.farm").toString();
const structuredData={"@context":"https://schema.org","@type":"CollectionPage",name:"The Houses of Wonderland",url:canonicalUrl,description:otherAliceCanon.politicalRule,hasPart:courtDossiers.map((house)=>({"@type":"Organization",name:house.name,description:house.summary}))};
---
<BaseLayout title="The Houses of Wonderland | Other Alice Adventures" description="How Hearts, Diamonds, Spades, and Clubs share ground, commerce, continuity, and force across Wonderland." canonical={OTHER_ALICE_HOUSES_PATH} image="https://cdn.hob.farm/pages/other-alice-adventures/oaa-map-wonderland-living-atlas-v01-16x9.webp" imageAlt="Aerial atlas of the shared Wonderland estate" structuredData={structuredData}>
 <div class="houses"><OaaProjectNav current="houses" />
  <header><p class="eyebrow">Power is layered</p><h1>The Houses of Wonderland</h1><p class="deck">{otherAliceCanon.politicalRule}</p><p>The Houses are not four isolated territories. They are overlapping systems that recognize land, circulate value, maintain life, and enforce reach across one inhabited estate.</p></header>
  <section><HousePowerStack /></section>
  <section aria-labelledby="dossiers"><div class="heading"><p>01 / Dossiers</p><h2 id="dossiers">Court, lived reality, dependency</h2></div><div class="dossiers">{courtDossiers.map((house)=><article style={`--house:${house.color}`}><p class="eyebrow">{house.estateLayer}</p><h3>{house.name}</h3><dl><div><dt>Court</dt><dd>{house.court}</dd></div><div><dt>Lived</dt><dd>{house.lived}</dd></div><div><dt>Dependency</dt><dd>{house.dependency}</dd></div><div><dt>Evidence</dt><dd>{house.evidence[0].label} · {house.evidence[0].certainty}</dd></div></dl></article>)}</div></section>
  <section aria-labelledby="regions"><div class="heading"><p>02 / Regional overlap</p><h2 id="regions">The same functions change by place.</h2></div><div class="table-wrap"><table><thead><tr><th>Region</th><th>Hearts</th><th>Diamonds</th><th>Spades</th><th>Clubs</th></tr></thead><tbody>{regionPowerRecords.map((record)=><tr><th>{record.region}</th><td>{record.heart}</td><td>{record.diamond}</td><td>{record.spade}</td><td>{record.club}</td></tr>)}</tbody></table></div></section>
  <section aria-labelledby="failure"><div class="heading"><p>03 / Dependency test</p><h2 id="failure">Failure reveals the estate.</h2></div><ol class="failures">{failureCascades.map((item)=><li><strong>{item.house}</strong><span>{item.failure}</span></li>)}</ol></section>
 </div>
</BaseLayout>
<style>
 .houses{min-height:100vh;background:#080a11;color:#eee7d6}.houses>header,.houses>section{max-width:90rem;margin:auto;padding:clamp(3.5rem,8vw,8rem) clamp(1rem,4vw,4rem);border-top:1px solid rgba(255,255,255,.1)}.houses>header{border:0}.eyebrow,.heading>p{color:#9f7aea;font:600 .68rem/1 ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase}h1{max-width:11ch;margin:.8rem 0;font:400 clamp(4rem,9vw,9rem)/.85 Georgia,serif;letter-spacing:-.06em}.deck{max-width:30ch;color:#fff;font:400 clamp(1.45rem,3vw,2.7rem)/1.2 Georgia,serif}.houses header>p:last-child{max-width:48rem;color:#b7bbc6;line-height:1.7}.heading{display:grid;grid-template-columns:.35fr 1fr;gap:2rem;margin-bottom:2rem}.heading h2{max-width:22ch;margin:0;font:400 clamp(2.2rem,5vw,4.5rem)/1 Georgia,serif}.dossiers{display:grid;grid-template-columns:1fr 1fr;border:1px solid rgba(255,255,255,.13)}.dossiers article{padding:1.2rem;border-right:1px solid rgba(255,255,255,.1);border-bottom:1px solid rgba(255,255,255,.1);box-shadow:inset 4px 0 var(--house)}.dossiers h3{margin:.6rem 0 1.5rem;font:400 2.2rem/1 Georgia,serif}.dossiers dl{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.dossiers dt{color:#8c93a2;font:600 .62rem/1 ui-monospace,monospace;text-transform:uppercase}.dossiers dd{margin:.4rem 0 0;color:#b7bbc5;line-height:1.55}.table-wrap{overflow-x:auto}table{width:100%;min-width:55rem;border-collapse:collapse}th,td{border:1px solid rgba(255,255,255,.13);padding:.85rem;text-align:left;vertical-align:top;color:#b9bdc7;font-size:.86rem;line-height:1.5}thead th,tbody th{color:white;background:#11151f}.failures{display:grid;grid-template-columns:repeat(4,1fr);margin:0;padding:0;list-style:none;border:1px solid rgba(255,255,255,.13)}.failures li{min-height:12rem;padding:1rem;border-right:1px solid rgba(255,255,255,.12)}.failures strong{display:block;color:white;font:400 1.4rem/1 Georgia,serif}.failures span{display:block;margin-top:3rem;color:#adb2bd;line-height:1.55}
 @media(max-width:700px){.heading,.dossiers{grid-template-columns:1fr}.dossiers dl{grid-template-columns:1fr}.failures{grid-template-columns:1fr 1fr}.houses>header,.houses>section{padding-block:4rem}}
 @media(max-width:450px){h1{font-size:3.8rem}.failures{grid-template-columns:1fr}}
</style>
