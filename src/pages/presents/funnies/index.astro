---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Text from "@/components/fundations/elements/Text.astro";
import ComicCard from "@/components/funnies/ComicCard.astro";
import FunniesHero from "@/components/funnies/FunniesHero.astro";
import { getDepartment } from "@/data/departments";
import { comicSeries, seriesPath } from "@/data/comic-series";
import { characters, characterPath, getCharacterName } from "@/data/characters";
import { comicPath, comicsInSeries, getPublishedComics } from "@/lib/comics";

const department = getDepartment("funnies")!;
const pageDeck =
  "Single-panel cartoons, recurring cast members, old comic-strip logic, and small disasters caused by animals who should not be in charge of anything.";
const intro = [
  "Funnies is the HobFarm cartoon shelf: short visual jokes, recurring characters, deadpan panels, bad decisions, public inconvenience, and creatures trying to survive systems they barely understand.",
  "Some cartoons are built like old newspaper gag panels. Some are brighter magazine-style animal chaos. Some live in antique ink, some live in slick color, and some are just Gary quietly absorbing one more humiliating human errand.",
  "The point is simple: one clear situation, one readable panel, one character logic that keeps working every time.",
];
const whatLivesHere = [
  "This department collects recurring HobFarm cartoon series, including Larry Cartoons, Buffcock, Gary, Fat Cat, and any future one-panel cast members who earn their place on the page.",
  "These are not lore dumps or comic-book universes. They are cartoon engines. Each series has a clear visual language, a clear kind of joke, and a cast that can be dropped into new situations without explaining itself every time.",
];
const comics = await getPublishedComics();
const featured = comics[0];
const latest = comics.slice(0, 8);
const primarySeries = new Set(["larry", "buffcock", "gary"]);
const castSlugs = ["larry", "gothcat", "helmut", "heidi", "buffcock", "cs", "gary", "fat-cat"];
const featuredCast = castSlugs
  .map((slug) => characters.find((character) => character.slug === slug))
  .filter((character): character is (typeof characters)[number] => Boolean(character));

// Pre-compute each series' comics once for the series grid + counts.
const seriesCards = comicSeries.filter((s) => primarySeries.has(s.slug)).map((s) => {
  const inSeries = comicsInSeries(comics, s.slug);
  return { series: s, comics: inSeries, latest: inSeries[0], image: s.thumbnail ?? inSeries[0]?.data.image };
});
---

<BaseLayout
  title="Funnies | HobFarm"
  description={pageDeck}
  canonical="/presents/funnies/"
>
  <section>
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        {/* 1 Hero / intro */}
        <FunniesHero
          title="Funnies"
          deck={pageDeck}
          image={department.heroImage}
          imageAlt="HobFarm Funnies cast collage."
          eyebrow="HobFarm / Funnies"
        />

        <div class="mt-12 grid grid-cols-1 gap-8 border-y border-base-800 py-10 lg:grid-cols-[minmax(0,1fr)_minmax(280px,0.75fr)]">
          <div class="space-y-5">
            {intro.map((paragraph) => (
              <p class="text-base leading-relaxed text-base-300 text-pretty">{paragraph}</p>
            ))}
          </div>
          <div>
            <Text tag="h2" variant="displayXS" class="font-display text-white">What lives here</Text>
            <div class="mt-4 space-y-4">
              {whatLivesHere.map((paragraph) => (
                <p class="text-sm leading-relaxed text-base-400 text-pretty">{paragraph}</p>
              ))}
            </div>
          </div>
        </div>

        {/* 2 Featured / latest comic */}
        {featured && (
          <a
            href={comicPath(featured)}
            class="group mt-12 grid overflow-hidden rounded-lg border border-base-800 bg-base-950/60 transition-colors hover:border-accent-green/50 lg:grid-cols-[1.3fr_0.7fr]"
          >
            <div class="aspect-[16/10] overflow-hidden bg-base-950 lg:aspect-auto">
              <img
                src={featured.data.image}
                alt={featured.data.imageAlt || featured.data.title}
                class="size-full object-cover"
                loading="eager"
                decoding="async"
              />
            </div>
            <div class="flex flex-col justify-between p-5 sm:p-6">
              <div>
                <p class="font-mono text-[10px] uppercase tracking-widest text-accent-green">Latest comic</p>
                <h2 class="mt-3 font-display text-2xl text-white">{featured.data.title}</h2>
                {featured.data.caption && (
                  <p class="mt-3 text-base leading-relaxed text-base-300">{featured.data.caption}</p>
                )}
              </div>
              <span class="mt-6 inline-flex text-sm text-base-100 group-hover:text-accent-green">Read it</span>
            </div>
          </a>
        )}

        {/* 3 Comic series grid */}
        <div class="mt-16">
          <Text tag="h2" variant="displaySM" class="mb-6 font-display text-white">Series</Text>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {seriesCards.map(({ series, comics: list, latest: latestInSeries, image }) => (
              <a
                href={seriesPath(series.slug)}
                class="group flex flex-col overflow-hidden rounded-lg border border-base-800 bg-base-900/50 transition-colors hover:border-accent-green/50"
              >
                {image && (
                  <div class="aspect-[4/3] overflow-hidden bg-base-950">
                    <img
                      src={image}
                      alt=""
                      class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="flex flex-1 flex-col p-5">
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="font-display text-lg text-white">{series.title}</h3>
                    <span class="shrink-0 font-mono text-[10px] uppercase tracking-widest text-base-500">
                      {list.length} {list.length === 1 ? "comic" : "comics"}
                    </span>
                  </div>
                  {series.formatBadge && (
                    <p class="mt-2 font-mono text-[10px] uppercase tracking-wider text-accent-green">
                      {series.formatBadge}
                    </p>
                  )}
                  {series.characters.length > 0 && (
                    <p class="mt-2 font-mono text-[10px] uppercase tracking-wider text-base-500">
                      {series.characters.map((slug) => getCharacterName(slug)).join(" · ")}
                    </p>
                  )}
                  <p class="mt-3 flex-1 text-sm leading-relaxed text-base-400">{series.shortBlurb ?? series.premise}</p>
                  <span class="mt-5 font-mono text-[10px] uppercase tracking-wider text-base-400 group-hover:text-white">
                    {latestInSeries ? "Read the series" : "Filling up"} &rarr;
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>

        {/* 4 Latest comics grid (or 6 empty-state teaser) */}
        <div class="mt-16 border-t border-base-800 pt-10">
          <Text tag="h2" variant="displaySM" class="mb-6 font-display text-white">Latest comics</Text>
          {latest.length > 0 ? (
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {latest.map((comic) => <ComicCard comic={comic} />)}
            </div>
          ) : (
            <div class="rounded-lg border border-dashed border-base-800 bg-base-950/40 p-6">
              <p class="text-sm text-base-400">
                The ink is still wet. New comics will land here as the strips go up. Each series above gets its own archive.
              </p>
            </div>
          )}
        </div>

        {/* 5 Cast strip -> /characters */}
        <div class="mt-16 border-t border-base-800 pt-10">
          <div class="mb-6 flex items-end justify-between gap-4">
            <Text tag="h2" variant="displaySM" class="font-display text-white">The cast</Text>
            <a
              href="/characters/"
              class="font-mono text-[10px] uppercase tracking-wider text-base-400 transition-colors hover:text-white"
            >
              Character index &rarr;
            </a>
          </div>
          <div class="flex flex-wrap gap-2">
            {featuredCast.map((c) => (
              <a
                href={characterPath(c.slug)}
                class="rounded-full border border-base-700 px-4 py-2 text-sm text-base-200 transition-colors hover:border-accent-green/60 hover:text-white"
              >
                {c.name}
              </a>
            ))}
          </div>
        </div>
      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>
