---
import BaseLayout from "@/layouts/BaseLayout.astro";
import OtherAliceStartPage from "@/components/presents/other-alice/OtherAliceStartPage.astro";
import { storySeries, storySeriesPath } from "@/data/story-series";
import { getMedia } from "@/data/media-registry";

export function getStaticPaths() {
  return storySeries
    .filter((series) => series.slug === "other-alice-adventures")
    .map((series) => ({
      params: { series: series.slug },
      props: { series },
    }));
}

const { series } = Astro.props;
const canonicalPath = storySeriesPath(series.slug);
const canonicalUrl = new URL(canonicalPath, "https://hob.farm").toString();
const representativeScene = getMedia("other-alice.alice.representative-landscape");
const seriesImage = series.slug === "other-alice-adventures"
  ? representativeScene.src
  : series.heroMedia?.type === "image"
    ? series.heroMedia.file
    : series.cover;
const seriesImageAlt = series.slug === "other-alice-adventures"
  ? representativeScene.alt
  : series.heroMedia?.type === "image"
    ? series.heroMedia.alt
    : series.coverAlt ?? series.title;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: series.seoTitle ?? series.title,
      description: series.metaDescription ?? series.logline,
      image: seriesImage,
      mainEntity: { "@id": `${canonicalUrl}#game` },
      isPartOf: { "@id": "https://hob.farm/#website" },
    },
    {
      "@type": "VideoGame",
      "@id": `${canonicalUrl}#game`,
      name: series.title,
      description: series.metaDescription ?? series.logline,
      url: canonicalUrl,
      image: seriesImage,
      genre: ["Surreal fantasy", "Interactive fiction", "Persistent world"],
      gamePlatform: "Web browser",
      creator: (series.contributors ?? []).map((contributor) => ({
        "@type": "Person",
        name: contributor.name,
      })),
      publisher: { "@id": "https://hob.farm/#organization" },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "HobFarm Presents",
          item: "https://hob.farm/presents/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: series.title,
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={series.seoTitle ?? `${series.title} | HobFarm Presents`}
  description={series.metaDescription ?? series.logline}
  canonical={canonicalPath}
  image={seriesImage}
  imageAlt={seriesImageAlt}
  structuredData={structuredData}
  feed={{ href: "/presents/rss.xml", title: "HobFarm Presents" }}
>
  <OtherAliceStartPage />
</BaseLayout>
