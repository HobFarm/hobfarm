---
import { render } from "astro:content";
import ThreeDMEntryLayout from "@/layouts/ThreeDMEntryLayout.astro";
import { readingTime } from "@/lib/reading-time";
import { articleUsesSeries, getPublishedArticles, stripArticleExt } from "@/lib/articles";

export async function getStaticPaths() {
  const entries = (await getPublishedArticles()).filter((entry) => articleUsesSeries(entry.data, "3dm"));
  return entries.map((entry) => ({
    params: { slug: stripArticleExt(entry.id).split("/").pop()! },
    props: { entry, related: entries.filter((candidate) => candidate.id !== entry.id).slice(0, 4) },
  }));
}

const { entry, related } = Astro.props;
const { Content } = await render(entry);
const stats = entry.body ? readingTime(entry.body) : null;
---

<ThreeDMEntryLayout article={entry} readingTime={stats?.text ?? ""} related={related}>
  <Content />
</ThreeDMEntryLayout>
