---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import SectionHero from "@/components/sections/SectionHero.astro";
import { presentsSeries, siteSections } from "@/data/site-hierarchy";
import { getPublishedArticles, getArticleDepartment, articlePath, getArticleHero } from "@/lib/articles";
import { getPublishedComics, comicPath } from "@/lib/comics";
import { OTHER_ALICE_WORLD_GUIDE_PATH } from "@/data/other-alice-world-guide";
import { getMedia } from "@/data/media-registry";

const section = siteSections.find((entry) => entry.id === "presents")!;
const articles = await getPublishedArticles();
const comics = await getPublishedComics();
const latest3dm = articles.find((article) => article.data.presentsSeries === "3dm" || article.id.startsWith("3dm/"));
const latestMagazine = articles.find((article) => getArticleDepartment(article.data) === "magazine-time-machine");
const latestComic = comics[0];
const seriesById = new Map(presentsSeries.map((entry) => [entry.id, entry]));
const threeDmSeries = seriesById.get("3dm")!;
const magazineSeries = seriesById.get("magazine-time-machine")!;
const otherAliceSeries = seriesById.get("other-alice")!;
const funniesSeries = seriesById.get("funnies")!;
const hobfarmTvSeries = seriesById.get("hobfarm-tv")!;
const otherAliceFeature = getMedia("other-alice.alice.size-change");
const features: Record<string, { title:string; description:string; href:string; image?:string; alt:string }> = {
  "3dm": latest3dm ? { title:latest3dm.data.title, description:latest3dm.data.excerpt, href:articlePath(latest3dm), image:getArticleHero(latest3dm.data), alt:latest3dm.data.heroAlt ?? latest3dm.data.title } : { title:"Enter the Millerverse", description:"Start with the connection map and current film-history archive.", href:threeDmSeries.href, image:threeDmSeries.logo, alt:"3 Degrees of Dick Miller logo" },
  "magazine-time-machine": latestMagazine ? { title:latestMagazine.data.title, description:latestMagazine.data.excerpt, href:articlePath(latestMagazine), image:getArticleHero(latestMagazine.data), alt:latestMagazine.data.heroAlt ?? latestMagazine.data.title } : { title:"Open the archive", description:"Old pages become new investigations.", href:magazineSeries.href, image:magazineSeries.heroImage, alt:magazineSeries.heroAlt ?? "" },
  "other-alice": { title:"Enter a world that remembers", description:"Explore the public Wonderland behind a persistent story game. The private runtime alpha already preserves choices, time, relationships, and consequences.", href:otherAliceSeries.href, image:otherAliceFeature.src, alt:otherAliceFeature.alt },
  "funnies": latestComic ? { title:latestComic.data.title, description:latestComic.data.caption, href:comicPath(latestComic), image:latestComic.data.image, alt:latestComic.data.imageAlt } : { title:"Read the Funnies", description:"Open the current cartoon archive.", href:funniesSeries.href, image:funniesSeries.heroImage, alt:funniesSeries.heroAlt ?? "" },
  "hobfarm-tv": { title:"The network is still in the shop", description:"Programs will arrive when there are programs worth airing.", href:"/contact/?subject=hobfarm-tv-contributor", image:hobfarmTvSeries.heroImage, alt:hobfarmTvSeries.heroAlt ?? "" },
};
---
<BaseLayout title="HobFarm Presents | Series, Film History, Cartoons, and Television" description={section.description} canonical={section.href} image={section.heroImage} imageAlt={section.heroAlt}>
  <SectionHero eyebrow="HobFarm's series imprint" title="HobFarm Presents" deck="Recurring editorial properties get room to build their own archives, visual languages, release patterns, and on-screen voices. Hillary anchors the editorial frame; Ami and the PsyGoth trio step in when a program calls for them." image={section.heroImage} imageAlt={section.heroAlt} theme="presents" cta={{label:"Browse the series",href:"#series"}} breadcrumbs={[{label:"Home",href:"/"},{label:"HobFarm Presents"}]} />
  <nav id="series" class="series-index" aria-label="HobFarm Presents series"><Wrapper variant="standard" class="py-4"><div class="index-links">{presentsSeries.map((entry) => <a href={`#${entry.id}`}>{entry.shortName ?? entry.name}</a>)}</div></Wrapper></nav>

  {presentsSeries.map((entry, index) => { const feature = features[entry.id]; return <section id={entry.id} class:list={["series-section", `theme-${entry.theme}`]} style={`--series-image:url('${entry.heroImage ?? feature.image ?? ""}')`}>
    <Wrapper variant="standard" class="py-16 lg:py-24">
      <div class:list={["series-layout", index % 2 === 1 && "series-layout--reverse"]}>
        <div class="series-copy">
          <div class="series-meta"><span>{String(index+1).padStart(2,"0")}</span><span>{entry.id === "other-alice" ? "Persistent story game" : entry.status === "coming-eventually" ? "Coming eventually" : "Now showing"}</span></div>
          <h2 class:list={[entry.logo && "sr-only"]}>{entry.name}</h2>
          {entry.logo && <img class="series-logo" src={entry.logo} alt={`${entry.name} logo`} width="640" height="360" loading="lazy" decoding="async" />}
          <p>{entry.description}</p>
          {entry.id === "hobfarm-tv" && <div class="tv-note"><p>HobFarm TV is planned as the video side of these sections. The same person is writing the articles, making the images, building the site, and supposedly producing the television network, so the programs are taking longer.</p><p>Contributors are welcome. There is no budget and almost no audience yet. Credit will be real; future revenue stays hypothetical unless a paid arrangement is made in writing.</p></div>}
          <a class="series-cta" href={entry.href}>{entry.ctaLabel} &rarr;</a>
          {entry.id === "other-alice" && <a class="series-cta" href={OTHER_ALICE_WORLD_GUIDE_PATH}>Open the World Guide &rarr;</a>}
        </div>
        <a class="feature" href={feature.href}>
          {feature.image && <img src={feature.image} alt={feature.alt} width="1200" height="800" loading="lazy" decoding="async" />}
          <div><span>{entry.id === "hobfarm-tv" ? "Contribution line" : "Featured / start here"}</span><h3>{feature.title}</h3><p>{feature.description}</p></div>
        </a>
      </div>
    </Wrapper>
  </section>})}
</BaseLayout>

<style>
  .series-index{position:sticky;top:4rem;z-index:20;border-bottom:1px solid #2c2440;background:rgb(7 6 11 / 92%);backdrop-filter:blur(12px)}.index-links{display:flex;width:100%;min-width:0;gap:.55rem;overflow-x:auto}.series-index a{flex:none;padding:.55rem .75rem;border:1px solid #2c2440;color:#c8c6d4;font-family:var(--font-mono);font-size:.64rem;text-decoration:none;text-transform:uppercase}.series-index a:hover{border-color:#a06bff;color:white}.series-section{--series-accent:#a06bff;position:relative;scroll-margin-top:8rem;border-bottom:1px solid #2c2440;background:#07060b}.theme-film{--series-accent:#79a9d6;background:#090e16}.theme-magazine{--series-accent:#f0c96b;background:#161008}.theme-alice{--series-accent:#b75cff;background:linear-gradient(110deg,#140719,#101009)}.theme-comics{--series-accent:#ff3d52;background:#f4f2ed;color:#121015}.theme-broadcast{--series-accent:#19e3e3;background:#020607}.series-layout{display:grid;min-width:0;gap:2rem;align-items:stretch}.series-layout>*{min-width:0}.series-meta{display:flex;gap:1rem;color:var(--series-accent);font-family:var(--font-mono);font-size:.64rem;letter-spacing:.12em;text-transform:uppercase}.series-copy{display:flex;min-width:0;flex-direction:column;justify-content:center;min-height:30rem}.series-copy h2{margin:1.5rem 0 0;color:white;font-family:var(--font-display);font-size:clamp(3rem,7vw,6rem);font-weight:300;letter-spacing:-.06em;line-height:.9}.theme-comics .series-copy h2,.theme-comics .series-copy>p{color:#121015}.series-logo{width:100%;max-width:28rem;height:auto;margin-top:2rem;object-fit:contain}.series-copy>p{max-width:42rem;margin:1.4rem 0 0;color:#b5b0c2;font-size:1.05rem;line-height:1.7}.series-cta{align-self:flex-start;margin-top:1.8rem;padding:.7rem .85rem;border:2px solid var(--series-accent);background:color-mix(in srgb,var(--series-accent) 12%,#07060b);color:#ece9f5;font-family:var(--font-mono);font-size:.68rem;font-weight:600;letter-spacing:.06em;text-decoration:none;text-transform:uppercase;transition:background-color .2s ease,color .2s ease}.theme-comics .series-cta{background:color-mix(in srgb,var(--series-accent) 10%,#f4f2ed);color:#121015}.series-cta:hover,.series-cta:focus-visible{background:var(--series-accent);color:#07060b}.series-cta:focus-visible{outline:2px solid #ece9f5;outline-offset:3px}.feature{position:relative;display:flex;min-width:0;min-height:32rem;flex-direction:column;justify-content:flex-end;overflow:hidden;border:1px solid color-mix(in srgb,var(--series-accent) 35%,#2c2440);background:#0e0b16;color:white;text-decoration:none}.feature>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.7;transition:transform .5s ease}.feature:hover>img{transform:scale(1.025)}.feature>div{position:relative;padding:clamp(1.25rem,4vw,2.5rem);background:linear-gradient(0deg,rgba(7,6,11,.98),rgba(7,6,11,.72),transparent)}.feature span{color:var(--series-accent);font-family:var(--font-mono);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase}.feature h3{margin:.6rem 0 0;font-family:var(--font-display);font-size:clamp(2rem,4vw,3.4rem);font-weight:400;line-height:1}.feature p{max-width:40rem;margin:.8rem 0 0;color:#d8d4e4;line-height:1.55}.tv-note{max-width:45rem;margin-top:1.5rem;padding:1rem;border-left:3px solid var(--series-accent);background:rgba(25,227,227,.05)}.tv-note p{margin:.6rem 0;color:#b5b0c2;line-height:1.65}@media(min-width:900px){.series-layout{grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr)}.series-layout--reverse{grid-template-columns:minmax(0,1.22fr) minmax(0,.78fr)}.series-layout--reverse .series-copy{order:2}.series-layout--reverse .feature{order:1}}@media(prefers-reduced-motion:reduce){.series-cta{transition:none}.feature>img{transition:none}.feature:hover>img{transform:none}}
</style>
