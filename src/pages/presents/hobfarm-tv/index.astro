---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Eyebrow from "@/components/sections/Eyebrow.astro";
import { presentsSeries } from "@/data/site-hierarchy";

const tvSection = presentsSeries.find((entry) => entry.id === "hobfarm-tv")!;
const tvHero = tvSection.heroImage!;
---

<BaseLayout
  title="HobFarm TV | HobFarm"
  description="HobFarm TV is the picture-show channel: cult-film archaeology, cultural analysis, and build logs. Home of 3 Degrees of Dick Miller and Magazine Time Machine."
  canonical="/presents/hobfarm-tv/"
  image={tvHero}
  imageAlt={tvSection.heroAlt}
>
  <section class="bg-noise">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-24">

        {/* ── Header ── */}
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-12">
          <div class="max-w-2xl">
            <Eyebrow text="HobFarm TV / Channel" />
            <Text tag="h1" variant="display2XL" class="mt-6 text-white text-balance font-display">
              HobFarm TV
            </Text>
            <Text tag="p" variant="textLG" class="text-base-400 mt-6 text-pretty leading-relaxed">
              The picture-show channel. Part cult-film archaeology, part cultural analysis, part build log: a slate of shows built on the HobFarm workshop and its AI tooling. Early days. Subscribe to catch it from the start.
            </Text>
          </div>
          <div class="flex flex-wrap gap-3 shrink-0">
            <Button isLink size="base" variant="default" href="https://www.youtube.com/@HobFarm" target="_blank" rel="noopener noreferrer">
              Subscribe on YouTube
            </Button>
          </div>
        </div>

        {/* ── Hero ── */}
        <div class="relative w-full aspect-video rounded-2xl overflow-hidden border border-base-800 mb-16 bg-base-900 isolate">
          <div class="absolute inset-0 bg-linear-to-b from-transparent to-base-950/80 mix-blend-multiply z-10"></div>
          <img src={tvHero} alt={tvSection.heroAlt ?? "HobFarm TV test pattern"} width="1600" height="900" class="w-full h-full object-cover rounded-2xl" decoding="async" fetchpriority="high" />
        </div>

        {/* ── Shows ──
             There are no shows yet. The two records this grid used to read were
             3DM and Magazine Time Machine, which are sibling Presents sections,
             not HobFarm TV shows. Shows will live at /presents/hobfarm-tv/shows/
             once they exist. */}
        <Text tag="h2" variant="displayLG" class="text-white font-display mb-8">The Shows</Text>
        <p class="max-w-2xl text-base leading-relaxed text-base-400">
          Nothing is scheduled yet. HobFarm TV is video built from the articles in
          the other Presents sections, so the first shows will follow the writing
          rather than lead it.
        </p>

      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>
