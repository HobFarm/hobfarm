---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ArticleCard from "@/components/articles/ArticleCard.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Subscribe from "@/components/articles/Subscribe.astro";
import {
  articleCategories,
  articleCategoryPath,
  getArticleDepartment,
  getArticleDepartmentLabel,
  getPublishedArticles,
} from "@/lib/articles";

const categoryDescriptions: Record<string, string> = {
  technical:
    "Workshop notes on HobFarm systems, implementation decisions, infrastructure, and production workflows.",
  "magazine-time-machine":
    "Vintage media, old ads, print culture, and time-capsule commentary from the Magazine Time Machine archive.",
  "cultural-thread":
    "Cultural analysis, media history, strange connections, and visual research threads from HobFarm.",
  grimoire:
    "Articles about Grimoire, the structured knowledge graph behind HobFarm's visual vocabulary systems.",
  stylefusion:
    "Articles about StyleFusion, structured prompt packages, reference analysis, and portable visual direction.",
  hobbot:
    "Development notes and experiments around HobBot, automated agents, posting systems, and personality-driven workflows.",
  business:
    "Studio notes on monetization, creator infrastructure, memberships, storefronts, product strategy, and funding the work.",
  research:
    "Research notes, references, experiments, and source-mapping for HobFarm's creative technology systems.",
};

export async function getStaticPaths() {
  const categories = articleCategories.filter((category) => category.value !== "all");
  const allPosts = await getPublishedArticles();
  return categories.map((cat) => ({
    params: { category: cat.value },
    props: {
      posts: allPosts.filter((p) => p.data.category === cat.value || getArticleDepartment(p.data) === cat.value),
    },
  }));
}

const { category } = Astro.params;
const { posts } = Astro.props;
const label = getArticleDepartmentLabel(category);
const description =
  categoryDescriptions[category!] ||
  `Articles in the ${label} department on HobFarm.`;
---

<BaseLayout
  title={`${label} Articles | HobFarm`}
  description={description}
  canonical={`${articleCategoryPath(category!)}/`}
>
  <section>
    <ContentPanel>
      <Wrapper
        variant="standard"
        class="grid grid-cols-1 py-12 lg:py-16 gap-y-12 lg:gap-y-24 lg:grid-cols-4"
      >
        <div class="order-2 lg:order-1">
          <div class="lg:pr-8 lg:sticky lg:top-24 align-self-start">
            <a href="/articles/" class="text-sm text-base-500 hover:text-base-100 transition-colors">
              &larr; All articles
            </a>
            <h1 class="mt-4 text-3xl lg:text-4xl font-light text-base-100 text-balance font-display">
              {label}
            </h1>
            <p class="mt-2 text-sm text-base-400">
              {posts.length} {posts.length === 1 ? "article" : "articles"}
            </p>
          </div>
        </div>
        <div
          class="order-1 grid grid-cols-1 sm:grid-cols-2 lg:order-2 lg:col-span-3 gap-y-12 lg:gap-y-24 lg:grid-cols-3"
        >
          {posts.length > 0 ? (
            posts.map((post) => <ArticleCard post={post} />)
          ) : (
            <p class="text-base text-base-500 col-span-3">
              No articles in this department yet.
            </p>
          )}
        </div>
      </Wrapper>
    </ContentPanel>
    <Subscribe />
  </section>
</BaseLayout>
