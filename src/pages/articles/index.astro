---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import ArticleCard from "@/components/articles/ArticleCard.astro";
import ArticlePagination from "@/components/articles/ArticlePagination.astro";
import EditorialSectionRail from "@/components/articles/EditorialSectionRail.astro";
import EditorialSpecials from "@/components/articles/EditorialSpecials.astro";
import EditorialSubjectLinks from "@/components/articles/EditorialSubjectLinks.astro";
import SubscribeToHobFarm from "@/components/articles/SubscribeToHobFarm.astro";
import {
  articlePath,
  getArticleDate,
  getArticleDek,
  getArticleHero,
  getArticleSectionLabel,
  getArticleSubjectCounts,
  getPublishedArticles,
} from "@/lib/articles";
import {
  getArticleArchivePage,
  getArticleArchivePageCount,
} from "@/lib/article-pagination";

const allPosts = await getPublishedArticles();
const coverStory = allPosts[0];
const latest = getArticleArchivePage(allPosts, 1);
const totalPages = getArticleArchivePageCount(allPosts.length);
const coverDate = coverStory ? getArticleDate(coverStory) : null;
const coverHero = coverStory ? getArticleHero(coverStory.data) : undefined;
const subjects = getArticleSubjectCounts(allPosts).filter((subject) => subject.count >= 2);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "HobFarm Articles",
  description: "The public Editorial archive for HobFarm.",
  url: new URL("/articles/", Astro.site ?? "https://hob.farm").toString(),
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: allPosts.length,
    itemListElement: allPosts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: post.data.title,
      url: new URL(`${articlePath(post)}/`, Astro.site ?? "https://hob.farm").toString(),
    })),
  },
};
---

<BaseLayout
  title="Articles | HobFarm"
  description="HobFarm Editorial publishes articles about technology, art and design, culture, film and television, music, and the places and systems beneath them."
  canonical="/articles/"
  structuredData={structuredData}
>
  <section>
    <ContentPanel>
      <Wrapper variant="standard" class="py-8 lg:py-12">
        <header class="max-w-3xl">
          <p class="font-mono text-[10px] uppercase tracking-[.16em] text-accent-cyan">HobFarm Editorial</p>
          <h1 class="mt-3 font-display text-4xl font-light text-white sm:text-5xl">Articles</h1>
          <p class="mt-4 text-base leading-relaxed text-base-300">
            Research, criticism, reporting, satire, visual studies, and production essays from the publishing side of HobFarm.
          </p>
          <a href="#article-subscribe" class="mt-5 inline-flex font-mono text-[10px] uppercase tracking-wider text-accent-cyan hover:text-white">
            Subscribe to articles &rarr;
          </a>
        </header>

        <div class="mt-8"><EditorialSectionRail /></div>

        {coverStory && (
          <section class="mt-12" aria-labelledby="cover-story-heading">
            <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
              <p class="font-mono text-[10px] uppercase tracking-widest text-accent-magenta-bright">Cover story</p>
              {coverDate && (
                <time class="font-mono text-[10px] uppercase tracking-wider text-base-500" datetime={coverDate.toISOString()}>
                  {coverDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" })}
                </time>
              )}
            </div>
            <a href={articlePath(coverStory)} class="group grid overflow-hidden rounded-xl border border-base-800 bg-base-950/70 transition-colors hover:border-accent-cyan/50 lg:grid-cols-[1.25fr_.75fr]">
              {coverHero && (
                <img src={coverHero} alt={coverStory.data.heroAlt || coverStory.data.title} class="aspect-video h-full w-full object-cover" loading="eager" decoding="async" />
              )}
              <div class="flex flex-col justify-center p-6 lg:p-8">
                <p class="font-mono text-[10px] uppercase tracking-widest text-accent-cyan">{getArticleSectionLabel(coverStory.data)}</p>
                <h2 id="cover-story-heading" class="mt-3 font-display text-2xl font-light text-white sm:text-3xl">{coverStory.data.title}</h2>
                <p class="mt-4 text-sm leading-relaxed text-base-300">{getArticleDek(coverStory.data)}</p>
                <span class="mt-6 text-sm text-base-200 group-hover:text-accent-cyan">Read the feature &rarr;</span>
              </div>
            </a>
          </section>
        )}

        <section class="mt-14" aria-labelledby="latest-articles-heading">
          <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
            <h2 id="latest-articles-heading" class="font-display text-2xl font-light text-white">Chronological archive</h2>
            <span class="font-mono text-[10px] uppercase tracking-wider text-base-500">Page 1 of {totalPages} &middot; {allPosts.length} published</span>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {latest.map((post) => <ArticleCard post={post} />)}
          </div>
          <ArticlePagination currentPage={1} totalPages={totalPages} />
        </section>

        <EditorialSpecials heading="Series and specials" compact />
        <EditorialSubjectLinks subjects={subjects} limit={28} />

        <aside class="mt-14 grid gap-5 border border-base-800 bg-base-900/40 p-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-end" aria-labelledby="article-workshop-heading">
          <div><p class="font-mono text-[10px] uppercase tracking-widest text-accent-cyan">Articles and their production records</p><h2 id="article-workshop-heading" class="mt-3 font-display text-2xl font-light text-white">Follow the source into the Workshop.</h2><p class="mt-3 max-w-2xl text-sm leading-relaxed text-base-400">When an article grows from a larger production system, its project record keeps the research, constraints, tests, media, and later outputs attached without changing the article's Editorial section.</p></div>
          <div class="flex flex-wrap gap-3"><a href="/workshop/projects/" class="border border-base-700 px-4 py-2 font-mono text-[10px] uppercase tracking-wider text-base-200 hover:border-accent-cyan hover:text-white">Browse projects</a><a href="/workshop/workshop-notes/" class="border border-base-700 px-4 py-2 font-mono text-[10px] uppercase tracking-wider text-base-200 hover:border-accent-cyan hover:text-white">Read Workshop Notes</a></div>
        </aside>
      </Wrapper>
    </ContentPanel>
    <ContentPanel>
      <Wrapper variant="narrow" class="py-12">
        <SubscribeToHobFarm mode="expanded" id="article-subscribe" />
      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>
