---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import ArticleCard from "@/components/articles/ArticleCard.astro";
import ArticlePagination from "@/components/articles/ArticlePagination.astro";
import EditorialSectionRail from "@/components/articles/EditorialSectionRail.astro";
import EditorialSubjectLinks from "@/components/articles/EditorialSubjectLinks.astro";
import Subscribe from "@/components/articles/Subscribe.astro";
import { getArticleSubjectCounts, getPublishedArticles } from "@/lib/articles";
import {
  articleArchivePagePath,
  getArticleArchivePage,
  getArticleArchivePageCount,
} from "@/lib/article-pagination";

export async function getStaticPaths() {
  const allPosts = await getPublishedArticles();
  const totalPages = getArticleArchivePageCount(allPosts.length);
  const subjects = getArticleSubjectCounts(allPosts).filter((subject) => subject.count >= 2);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: String(page) },
      props: {
        posts: getArticleArchivePage(allPosts, page),
        publishedCount: allPosts.length,
        subjects,
        totalPages,
      },
    };
  });
}

const currentPage = Number(Astro.params.page);
const { posts, publishedCount, subjects, totalPages } = Astro.props;
---

<BaseLayout
  title={`Articles, Page ${currentPage} | HobFarm`}
  description={`Page ${currentPage} of the chronological HobFarm Editorial archive.`}
  canonical={articleArchivePagePath(currentPage)}
>
  <section>
    <ContentPanel>
      <Wrapper variant="standard" class="py-8 lg:py-12">
        <header>
          <a href="/articles/" class="font-mono text-[10px] uppercase tracking-wider text-base-500 hover:text-white">&larr; Cover story and latest</a>
          <h1 class="mt-3 font-display text-4xl font-light text-white">Article archive</h1>
          <p class="mt-3 text-sm text-base-400">Page {currentPage} of {totalPages} &middot; {publishedCount} published</p>
        </header>
        <div class="mt-7"><EditorialSectionRail /></div>
        <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => <ArticleCard post={post} />)}
        </div>
        <ArticlePagination currentPage={currentPage} totalPages={totalPages} />
        <EditorialSubjectLinks subjects={subjects} limit={20} />
      </Wrapper>
    </ContentPanel>
    <Subscribe />
  </section>
</BaseLayout>
