---
// Editorial categories that are neither a Presents section nor a Workshop
// program. Replaces the retired `/departments/[slug]`. A category with no
// content generates no route: it stays in the taxonomy so an article can be
// filed to it, and its page appears when it has something to show.
import BaseLayout from "@/layouts/BaseLayout.astro";
import EditorialSectionArchive from "@/components/archive/EditorialSectionArchive.astro";
import {
  editorialSections,
  editorialSectionPath,
  getEditorialSection,
} from "@/data/editorial-mesh";
import { articlePath, getArticleSubjectCounts, getPublishedArticles } from "@/lib/articles";

export async function getStaticPaths() {
  const articles = await getPublishedArticles();

  const sectionCandidates = editorialSections.map((section) => ({
    params: { category: section.slug },
    props: {
      department: section,
      canonical: editorialSectionPath(section.slug),
      noindex: false,
      posts: articles.filter((article) => article.data.mesh?.section === section.slug),
    },
  }));

  // An empty category generates no route at all.
  return sectionCandidates.filter(({ props }) => props.posts.length > 0);
}

const { department, canonical, noindex, posts } = Astro.props;
const editorialSection = getEditorialSection(department.slug);
const publishedArticles = await getPublishedArticles();
const denseSubjects = getArticleSubjectCounts(publishedArticles).filter((subject) => subject.count >= 2);
const metaDescription =
  editorialSection?.blurb ?? String(department.blurb);
const sectionJsonLd = editorialSection ? {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${editorialSection.label} articles`,
  description: editorialSection.definition,
  url: new URL(canonical, Astro.site ?? "https://hob.farm").toString(),
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: posts.length,
    itemListElement: posts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`${articlePath(post)}/`, Astro.site ?? "https://hob.farm").toString(),
      name: post.data.title,
    })),
  },
} : undefined;
---

<BaseLayout
  title={`${department.label} | HobFarm`}
  description={metaDescription}
  canonical={canonical}
  noindex={noindex}
  feed={editorialSection ? { href: `/articles/${editorialSection.slug}/rss.xml`, title: `${editorialSection.label} articles` } : undefined}
  structuredData={sectionJsonLd}
>
  {editorialSection && <EditorialSectionArchive section={editorialSection} posts={posts} denseSubjects={denseSubjects} />}
</BaseLayout>
