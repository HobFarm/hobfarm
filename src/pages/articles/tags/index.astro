---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import ArticleTagCloud from "@/components/articles/ArticleTagCloud.astro";
import { getArticleTagCounts, getPublishedArticles } from "@/lib/articles";

const allPosts = await getPublishedArticles();
const tagCounts = getArticleTagCounts(allPosts);
---

<BaseLayout title="Article Tags | HobFarm" canonical="/articles/tags/" noindex>
  <section>
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-16">
        <h1 class="text-2xl font-light text-base-100 font-display">Article tags</h1>
        <div class="mt-8 max-w-5xl">
          <ArticleTagCloud tags={tagCounts} ariaLabel="All article tags" />
        </div>
      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>
