---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ArticleCard from "@/components/articles/ArticleCard.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import { articleTagPath, getPublishedArticles } from "@/lib/articles";

const allPosts = await getPublishedArticles();
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())];

export async function getStaticPaths() {
  const allPosts = await getPublishedArticles();
  const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags).flat())];
  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post) => post.data.tags.includes(tag));
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const description = `Articles tagged "${tag}" on HobFarm, covering related systems, visual research, and project notes.`;
---

<BaseLayout title={`${tag} Articles | HobFarm`} description={description} canonical={`${articleTagPath(tag!)}/`}>
  <section>
    <ContentPanel>
      <Wrapper
        variant="standard"
        class="grid grid-cols-1 py-12 lg:py-16 gap-y-12 lg:gap-y-24 lg:grid-cols-4"
      >
        <div class="order-2 lg:order-1 lg:pr-8">
          <a href="/articles/" class="text-sm text-base-500 hover:text-base-100 transition-colors">
            &larr; All articles
          </a>
          <h1 class="mt-4 text-2xl font-light text-base-100 font-display capitalize text-balance">
            Articles tagged: {tag}
          </h1>
          <p class="mt-2 text-sm text-base-400">
            {posts.length} {posts.length === 1 ? "article" : "articles"}
          </p>

          <div class="mt-12">
            <h2 class="text-base font-medium text-base-100">All tags</h2>
            <div class="flex flex-wrap gap-2 mt-4 lg:flex-col">
              {
                tags.map((t) => (
                  <a
                    class:list={[
                      "text-sm capitalize transition-colors",
                      t === tag ? "text-base-100 font-medium" : "text-base-400 hover:text-base-100",
                    ]}
                    href={articleTagPath(t)}
                  >
                    {t}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
        <div
          class="order-1 grid grid-cols-1 sm:grid-cols-2 lg:order-2 lg:col-span-3 gap-y-12 lg:gap-y-24 lg:grid-cols-3"
        >
          {posts.map((post) => <ArticleCard post={post} />)}
        </div>
      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>
