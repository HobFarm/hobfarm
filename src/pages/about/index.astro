---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import AboutHero from "@/components/about/AboutHero.astro";
import AboutJumpNav from "@/components/about/AboutJumpNav.astro";
import AboutWhy from "@/components/about/AboutWhy.astro";
import AboutCapabilityGrid from "@/components/about/AboutCapabilityGrid.astro";
import AboutProductionGrounding from "@/components/about/AboutProductionGrounding.astro";
import AboutMethodMap from "@/components/about/AboutMethodMap.astro";
import AboutSelectedWork from "@/components/about/AboutSelectedWork.astro";
import AboutHobFarmRoutes from "@/components/about/AboutHobFarmRoutes.astro";
import AboutContactBlock from "@/components/about/AboutContactBlock.astro";
import { aboutLinkedInUrl } from "@/data/about";
import { getMedia } from "@/data/media-registry";
import "@/styles/about.css";

const title = "About Kris Reynolds and HobFarm";
const description =
  "Kris Reynolds builds and operates HobFarm, an independent publication and working studio for research, digital media, web systems, visual production, and inspectable creative workflows.";
const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const canonicalUrl = `${siteOrigin}/about/`;
const heroImage = getMedia("about.hero.hayworth-avenue");
const heroSrcset = [640, 960, 1400, 1920]
  .map((width) => `/media/about/about-hero-hayworth-avenue-${width}.webp ${width}w`)
  .join(", ");
const heroCaption =
  "South Hayworth Avenue, just south of Beverly Boulevard, Los Angeles / looking north / photograph by Kris Reynolds";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${canonicalUrl}#kris-reynolds`,
      name: "Kris Reynolds",
      url: canonicalUrl,
      jobTitle: "Publisher and Digital Media Producer",
      homeLocation: {
        "@type": "Place",
        name: "Las Vegas, Nevada",
      },
      sameAs: [aboutLinkedInUrl],
      worksFor: {
        "@id": `${siteOrigin}/#organization`,
      },
    },
    {
      "@type": "Organization",
      "@id": `${siteOrigin}/#organization`,
      name: "HobFarm",
      url: `${siteOrigin}/`,
      logo: "https://cdn.hob.farm/brand/hobfarm-logo-white.svg",
      founder: {
        "@id": `${canonicalUrl}#kris-reynolds`,
      },
    },
    {
      "@type": "AboutPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      about: [
        { "@id": `${canonicalUrl}#kris-reynolds` },
        { "@id": `${siteOrigin}/#organization` },
      ],
      mainEntity: {
        "@id": `${canonicalUrl}#kris-reynolds`,
      },
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical="/about/"
  image={heroImage.src}
  imageAlt={heroImage.alt}
  structuredData={structuredData}
  palette="blue-red"
>
  <div class="about-page">
    <AboutHero image={heroImage} caption={heroCaption} srcset={heroSrcset} />
    <AboutJumpNav />
    <AboutWhy />
    <AboutCapabilityGrid />
    <AboutProductionGrounding />
    <AboutMethodMap />
    <AboutSelectedWork />
    <AboutHobFarmRoutes />

    <section class="about-section about-operation" aria-labelledby="about-operation-heading">
      <Wrapper variant="standard" class="about-section__grid">
        <p class="about-section__label">07 / Operation</p>
        <div class="about-section__body">
          <h2 id="about-operation-heading">I currently run HobFarm alone.</h2>
          <p>
            I keep the sources, decisions, production, publishing, and maintenance connected. I
            bring in collaborators and specialists when a real project, role, budget, and delivery
            need justify it.
          </p>
        </div>
      </Wrapper>
    </section>

    <AboutContactBlock />
  </div>
</BaseLayout>
