---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Eyebrow from "@/components/sections/Eyebrow.astro";
import GalleryCard from "@/components/gallery/GalleryCard.astro";
import { getCollection } from "astro:content";
import { characters, characterPath } from "@/data/characters";

// Character systems with real imagery come from the Cute & Corrupted and
// character-development gallery lanes.
const systems = (await getCollection("gallery"))
  .filter(
    (e) => !e.data.draft && (e.data.type === "cute-corrupted" || e.data.type === "character-dev"),
  )
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
---

<BaseLayout
  title="Characters | HobFarm"
  description="The recurring HobFarm cast and character systems: Gary, Fat Cat, Larry, Hobunny, Hillary HobFarm, Gothcat, and the Cute & Corrupted entries."
  canonical="/characters/"
>
  <section>
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <div class="max-w-2xl">
          <Eyebrow text="HobFarm / Characters" />
          <Text tag="h1" variant="display2XL" class="mt-6 font-display text-white text-balance">
            Characters
          </Text>
          <Text tag="p" variant="textLG" class="mt-5 text-base-400 leading-relaxed text-pretty">
            The recurring cast and the character systems they come from. Cartoons, critters, and the cute-to-corrupted pairs.
          </Text>
        </div>

        <div class="mt-12">
          <Text tag="h2" variant="displaySM" class="mb-6 font-display text-white">The cast</Text>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {characters.map((c) => (
              <a
                href={characterPath(c.slug)}
                class="group flex flex-col rounded-lg border border-base-800 bg-base-900/50 p-5 transition-colors hover:border-base-600"
              >
                <div class="flex items-baseline justify-between gap-3">
                  <Text tag="h3" variant="textXL" class="font-display text-white">{c.name}</Text>
                  <span class="font-mono text-[10px] uppercase tracking-widest text-base-500">{c.role}</span>
                </div>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-base-400">{c.blurb}</p>
                <span class="mt-5 font-mono text-[10px] uppercase tracking-wider text-base-400 group-hover:text-white">
                  See more &rarr;
                </span>
              </a>
            ))}
          </div>
        </div>

        {systems.length > 0 && (
          <div class="mt-16 border-t border-base-800 pt-10">
            <div class="mb-6 flex items-end justify-between gap-4">
              <Text tag="h2" variant="displaySM" class="font-display text-white">Character systems</Text>
              <a
                href="/departments/cute-corrupted/"
                class="font-mono text-[10px] uppercase tracking-wider text-base-400 transition-colors hover:text-white"
              >
                Cute &amp; Corrupted &rarr;
              </a>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {systems.map((entry) => <GalleryCard entry={entry} />)}
            </div>
          </div>
        )}
      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>
