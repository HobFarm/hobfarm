<script>
  document.addEventListener("astro:page-load", () => {
    const toc = document.getElementById("wp-toc");
    if (!toc) return;

    const links = toc.querySelectorAll<HTMLAnchorElement>(".wp-toc-link");
    const sections = [...links].map((link) => {
      const id = link.dataset.section!;
      return { id, el: document.getElementById(id)!, link };
    }).filter((s) => s.el);

    if (!sections.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const match = sections.find((s) => s.el === entry.target);
          if (!match) return;
          if (entry.isIntersecting) {
            links.forEach((l) => {
              l.classList.remove("!text-white", "!border-accent-500");
            });
            match.link.classList.add("!text-white", "!border-accent-500");
          }
        });
      },
      { rootMargin: "-20% 0px -70% 0px", threshold: 0 }
    );

    sections.forEach((s) => observer.observe(s.el));
  });
</script>
