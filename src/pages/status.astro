---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GridStatus from "@/components/GridStatus";
import ContentPanel from "@/components/ContentPanel.astro";
---

<BaseLayout title="System Status">
    <section class="py-24">
        <ContentPanel>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center">
                <h1 class="text-3xl font-extrabold text-base-100 sm:text-4xl font-mono tracking-wider uppercase">
                    System Status
                </h1>
                <p class="mt-4 text-lg text-base-400 font-mono tracking-wide">
                    Real-time grid performance metrics.
                </p>
            </div>

            <div class="mt-10">
                <GridStatus client:load />
            </div>
        </div>
        </ContentPanel>
    </section>
</BaseLayout>
