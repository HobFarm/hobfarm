---
import ProcessMethodPage from "@/components/process/ProcessMethodPage.astro";
import { processPipelines, type ProcessPipeline } from "@/data/processPipelines";

export async function getStaticPaths() {
  return processPipelines.map((pipeline) => ({
    params: { slug: pipeline.slug },
    props: { pipeline },
  }));
}

interface Props {
  pipeline: ProcessPipeline;
}

const { pipeline } = Astro.props;
---

<ProcessMethodPage pipeline={pipeline} />
