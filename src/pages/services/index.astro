---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Eyebrow from "@/components/sections/Eyebrow.astro";
import SectionHeader from "@/components/sections/SectionHeader.astro";
import Button from "@/components/fundations/elements/Button.astro";

type Offer = { title: string; body: string };

const offers: Offer[] = [
  {
    title: "Image restoration and finishing",
    body: "Photo restoration, retouching, cleanup, color correction, compositing, archival-image repair, and final image preparation and delivery.",
  },
  {
    title: "Video editing and motion",
    body: "Editing, image-to-video, photo animation, motion graphics, visual effects, trailers, long and short-form delivery, and versions for different destinations.",
  },
  {
    title: "Visual development",
    body: "Characters, identity and continuity sheets, visual systems, covers, posters, concept development, campaign imagery, and production specifications.",
  },
  {
    title: "Web publishing and small applications",
    body: "Content architecture, static sites, publishing workflows, landing and project pages, small web applications, and media or asset integration.",
  },
  {
    title: "Applied AI and workflow development",
    body: "Structured generation, reference analysis, model and provider selection, prompt and schema systems, troubleshooting, evaluation, production records, and practical automation.",
  },
  {
    title: "Product and editorial media",
    body: "Article packages, product images, demonstrations, short videos, visual explanations, and release assets built for a defined destination.",
  },
];

type ProcessCard = { title: string; body: string; href: string };

const processCards: ProcessCard[] = [
  {
    title: "Before & After",
    body: "Source photographs become restorations, documentary comparisons, locked-camera transformations, and clearly labeled alternate histories.",
    href: "/workshop/before-and-after/",
  },
  {
    title: "Motion",
    body: "A still-image system expands into animated clips, transitions, and an editorial loop with a clear production record.",
    href: "/workshop/motion/",
  },
  {
    title: "The HobFarm publishing system",
    body: "The live site shows content architecture, reusable components, media integration, release checks, and revision in one working project.",
    href: "/workshop/projects/hobfarm/",
  },
  {
    title: "EZIZE",
    body: "An authored visual grammar, deterministic pull, exact probability, renderer handoff, and ledger become one private application.",
    href: "/ezize/",
  },
];
---

<BaseLayout
  title="Services | HobFarm"
  description="Hire Kris Reynolds through HobFarm for image finishing, video and motion, visual development, web publishing, small applications, and applied AI workflows."
>
  {/* ── Hero ── */}
  <section class="bg-noise border-b border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-20 lg:py-28">
        <Eyebrow text="HobFarm / Las Vegas" />
        <Text tag="h1" variant="display2XL" class="mt-6 text-white font-display max-w-4xl text-balance">
          Services
        </Text>
        <Text tag="p" variant="textBase" class="text-base-300 mt-6 max-w-2xl text-pretty leading-relaxed">
          I take on selected outside work through HobFarm. Tell me what you are making, what you already have, and where the process is stuck. I can help with a defined production problem or build the working system around it.
        </Text>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button isLink size="sm" variant="green" href="/contact/?subject=creative-project">Discuss a project</Button>
          <Button isLink size="sm" variant="muted" href="#process">See how it's made</Button>
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  {/* ── Offers ── */}
  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="01" heading="What I do" note="Pick a lane, or describe the job." />
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {offers.map((offer) => (
            <div class="rounded-lg border border-base-800 bg-base-900/40 p-6">
              <Text tag="h3" variant="textLG" class="text-white font-display">
                {offer.title}
              </Text>
              <Text tag="p" variant="textSM" class="text-base-400 mt-3 text-pretty leading-relaxed">
                {offer.body}
              </Text>
            </div>
          ))}
        </div>
        <Text tag="p" variant="textSM" class="text-base-500 mt-8 max-w-2xl text-pretty leading-relaxed">
          I use professional image, layout, editing, motion, web, and model tools as the job requires. Software and providers stay secondary to the source, specification, review, and finished delivery.
        </Text>
      </Wrapper>
    </ContentPanel>
  </section>

  {/* ── How it's made / process ── */}
  <section id="process" class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="02" heading="How it's made" note="Real jobs, start to finish." />
        <Text tag="p" variant="textBase" class="text-base-400 max-w-2xl mb-10 text-pretty leading-relaxed">
          These are real HobFarm routes. They show what I lock early, what stays flexible, how I test the result, and which record survives after delivery.
        </Text>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {processCards.map((card) => (
            <a
              href={card.href}
              class="group rounded-lg border border-base-800 bg-base-900/40 p-6 transition-colors hover:border-accent-500"
            >
              <Text tag="h3" variant="textLG" class="text-white font-display">
                {card.title}
              </Text>
              <Text tag="p" variant="textSM" class="text-base-400 mt-3 text-pretty leading-relaxed">
                {card.body}
              </Text>
              <span class="mt-4 inline-block text-sm text-accent-violet-bright group-hover:text-white">
                See the process →
              </span>
            </a>
          ))}
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  {/* ── CTA ── */}
  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <Text tag="h2" variant="displaySM" class="text-white font-display">
          Have something in mind?
        </Text>
        <Text tag="p" variant="textBase" class="text-base-400 mt-4 max-w-2xl text-pretty leading-relaxed">
          Tell me what you are making, what already exists, and what a useful finished result would look like. Selected project and contract work is by request.
        </Text>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button isLink size="sm" variant="green" href="/contact/?subject=creative-project">Discuss a project</Button>
          <Button isLink size="sm" variant="muted" href="/workshop/projects/">See project evidence</Button>
        </div>
      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>
