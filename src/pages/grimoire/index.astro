---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
import {
  OTHER_ALICE_ROOT_PATH,
  OTHER_ALICE_WEB_PATH,
  OTHER_ALICE_WORLD_GUIDE_PATH,
} from "@/data/other-alice/canon";

const title = "The Grimoire is being rebuilt | HobFarm";
const description =
  "The Grimoire is becoming the game engine behind Other Alice Adventures and a durable knowledge graph for HobFarm.";
const heroImage =
  "https://cdn.hob.farm/pages/other-alice-adventures/oaa-map-wonderland-living-atlas-v01-16x9.webp";
const heroAlt =
  "Aerial atlas of circular Wonderland with inhabited regions, roads, forests, farms, and a mountain boundary.";
const canonicalUrl = "https://hob.farm/grimoire/";

const engineRecords = [
  {
    label: "World state",
    text: "Characters, places, objects, routes, institutions, and current conditions become connected records instead of loose notes.",
  },
  {
    label: "Local rules",
    text: "Wonderland's systems can describe what a place permits, what a route costs, and which physical or social rules apply there.",
  },
  {
    label: "Choice and consequence",
    text: "A decision can change a relationship, debt, body, object, route, or piece of evidence, then carry that change into the next encounter.",
  },
  {
    label: "Continuity",
    text: "The engine can remember what happened, which facts are confirmed, and which parts of the world still need review.",
  },
];

const graphRecords = [
  {
    label: "Entities",
    text: "People, creatures, regions, Houses, materials, works, tools, and ideas get stable identities.",
  },
  {
    label: "Correspondences",
    text: "Relationships connect those identities through place, influence, ownership, sequence, resemblance, evidence, and use.",
  },
  {
    label: "Evidence",
    text: "Sources, observations, canon status, and revision history keep facts separate from guesses and unfinished ideas.",
  },
  {
    label: "Reusable context",
    text: "Workshop notes, story systems, visual direction, and future tools can read the same records without rebuilding the world each time.",
  },
];

const flow = [
  { number: "01", label: "Record the world", text: "Add a person, place, route, rule, object, or event with its evidence and current status." },
  { number: "02", label: "Connect the parts", text: "Describe who owns it, who depends on it, what it changes, and where it leads." },
  { number: "03", label: "Run the choice", text: "Test a player action against local rules, relationships, inventory, access, and prior consequences." },
  { number: "04", label: "Write back the result", text: "Keep the new state, record the cost, and flag anything that needs a human canon decision." },
];

const grimoireJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonicalUrl,
  image: heroImage,
  about: [
    { "@type": "CreativeWorkSeries", name: "Other Alice Adventures", url: `https://hob.farm${OTHER_ALICE_ROOT_PATH}` },
    { "@type": "Thing", name: "Knowledge graph" },
    { "@type": "Thing", name: "Narrative game engine" },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical="/grimoire/"
  image={heroImage}
  imageAlt={heroAlt}
  structuredData={grimoireJsonLd}
  palette="purple-green"
>
  <section class="relative overflow-hidden border-b border-base-800/70">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute -left-32 top-8 size-[34rem] rounded-full bg-spot-purple/10 blur-[150px]"></div>
      <div class="absolute -right-32 bottom-0 size-[30rem] rounded-full bg-spot-green/10 blur-[150px]"></div>
    </div>

    <Wrapper variant="standard" class="relative py-16 lg:py-24">
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(28rem,1.1fr)] lg:gap-14">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-accent-500/35 bg-accent-500/10 px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.2em] text-accent-300">
            <span class="size-2 rounded-full bg-accent-400"></span>
            Under redevelopment
          </div>
          <p class="mt-7 font-mono text-xs uppercase tracking-[0.22em] text-spot-green">
            Grimoire / next form
          </p>
          <h1 class="mt-4 max-w-3xl font-display text-4xl font-light leading-[1.03] text-white text-balance sm:text-5xl lg:text-7xl">
            The Grimoire is becoming Wonderland's game engine.
          </h1>
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-base-300 sm:text-lg">
            The public Grimoire is being rebuilt around Other Alice Adventures. Its next form will connect the world guide to playable state: characters, places, routes, rules, evidence, choices, and consequences held in one knowledge graph.
          </p>
          <p class="mt-4 max-w-2xl text-sm leading-relaxed text-base-400 sm:text-base">
            The larger HobFarm role stays intact. The same graph can hold visual vocabulary, project memory, workshop research, and agent-readable context without tying the work to one model or provider.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <Button isLink size="base" variant="green" href={OTHER_ALICE_ROOT_PATH}>
              Enter Other Alice Adventures
            </Button>
            <Button isLink size="base" variant="muted" href="/workshop/">
              Open the Workshop
            </Button>
          </div>
        </div>

        <figure class="overflow-hidden rounded-xl border border-base-700 bg-base-900/70 shadow-2xl shadow-black/40">
          <div class="relative aspect-[16/10] overflow-hidden">
            <img
              src={heroImage}
              alt={heroAlt}
              width="1920"
              height="1072"
              loading="eager"
              decoding="async"
              class="size-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-base-950 via-transparent to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6">
              <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-spot-green">Live world record</p>
              <p class="mt-2 max-w-xl text-sm leading-relaxed text-base-200">
                Wonderland already has regions, Houses, routes, ecology, residents, and evidence. The rebuild turns those records into a world that can remember change.
              </p>
            </div>
          </div>
        </figure>
      </div>
    </Wrapper>
  </section>

  <section class="border-b border-base-800/70">
    <Wrapper variant="standard" class="py-14 lg:py-20">
      <div class="max-w-3xl">
        <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent-400">Two jobs, one structure</p>
        <h2 class="mt-4 font-display text-3xl font-light text-white text-balance sm:text-5xl">
          Story engine and knowledge graph.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-base-400">
          Other Alice gives the system a demanding first world. It needs geography, institutions, ecology, access rules, relationships, inventory, time, and consequences. Building those parts as durable records also gives the rest of HobFarm a stronger memory layer.
        </p>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        <article class="rounded-xl border border-spot-purple/30 bg-spot-purple/5 p-6 sm:p-8">
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-spot-purple">Other Alice Adventures</p>
          <h3 class="mt-3 font-display text-3xl font-light text-white">The game engine</h3>
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {engineRecords.map((record) => (
              <div class="rounded-lg border border-base-800 bg-base-950/60 p-4">
                <h4 class="text-sm font-medium text-white">{record.label}</h4>
                <p class="mt-2 text-xs leading-relaxed text-base-400">{record.text}</p>
              </div>
            ))}
          </div>
        </article>

        <article class="rounded-xl border border-spot-green/30 bg-spot-green/5 p-6 sm:p-8">
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-spot-green">HobFarm memory layer</p>
          <h3 class="mt-3 font-display text-3xl font-light text-white">The knowledge graph</h3>
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            {graphRecords.map((record) => (
              <div class="rounded-lg border border-base-800 bg-base-950/60 p-4">
                <h4 class="text-sm font-medium text-white">{record.label}</h4>
                <p class="mt-2 text-xs leading-relaxed text-base-400">{record.text}</p>
              </div>
            ))}
          </div>
        </article>
      </div>
    </Wrapper>
  </section>

  <section class="border-b border-base-800/70 bg-base-900/25">
    <Wrapper variant="standard" class="py-14 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.65fr)_minmax(0,1.35fr)] lg:gap-16">
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-accent-400">Planned loop</p>
          <h2 class="mt-4 font-display text-3xl font-light text-white sm:text-4xl">How the pieces will move.</h2>
          <p class="mt-5 text-sm leading-relaxed text-base-400">
            The engine will read structured world records, test an action against the local situation, and return a change that can be inspected before it becomes canon.
          </p>
        </div>

        <ol class="grid gap-3 sm:grid-cols-2">
          {flow.map((step) => (
            <li class="rounded-lg border border-base-800 bg-base-950/70 p-5">
              <span class="font-mono text-[10px] tracking-[0.2em] text-base-500">{step.number}</span>
              <h3 class="mt-3 text-base font-medium text-white">{step.label}</h3>
              <p class="mt-2 text-sm leading-relaxed text-base-400">{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </Wrapper>
  </section>

  <section>
    <Wrapper variant="standard" class="py-14 lg:py-20">
      <div class="rounded-xl border border-base-800 bg-base-900/60 p-6 sm:p-8 lg:p-10">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:items-end">
          <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-spot-green">Public work in progress</p>
            <h2 class="mt-4 font-display text-3xl font-light text-white sm:text-4xl">The old library is offline. The working ideas remain visible.</h2>
            <p class="mt-5 text-sm leading-relaxed text-base-400">
              The former documentation and cross-pollination archive are out of public circulation while their useful parts are reviewed. Workshop pages still explain the production methods. The Other Alice guides show the world records the new engine will use.
            </p>
          </div>

          <nav class="grid gap-3 sm:grid-cols-2" aria-label="Follow the Grimoire redevelopment">
            <a href={OTHER_ALICE_WORLD_GUIDE_PATH} class="rounded-lg border border-base-700 bg-base-950/70 p-4 transition-colors hover:border-accent-500/60">
              <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent-400">World records</span>
              <span class="mt-2 block text-base text-white">Open the World Guide</span>
            </a>
            <a href={OTHER_ALICE_WEB_PATH} class="rounded-lg border border-base-700 bg-base-950/70 p-4 transition-colors hover:border-accent-500/60">
              <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent-400">Relationships</span>
              <span class="mt-2 block text-base text-white">See the Web of Wonderland</span>
            </a>
            <a href="/workshop/" class="rounded-lg border border-base-700 bg-base-950/70 p-4 transition-colors hover:border-accent-500/60">
              <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent-400">Methods</span>
              <span class="mt-2 block text-base text-white">Read the Workshop</span>
            </a>
            <a href="/articles/" class="rounded-lg border border-base-700 bg-base-950/70 p-4 transition-colors hover:border-accent-500/60">
              <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent-400">Updates</span>
              <span class="mt-2 block text-base text-white">Follow through Articles</span>
            </a>
          </nav>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
