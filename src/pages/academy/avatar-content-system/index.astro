---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Eyebrow from "@/components/sections/Eyebrow.astro";
import SectionHeader from "@/components/sections/SectionHeader.astro";
import CourseDiagram from "@/components/academy/CourseDiagram.astro";
import LessonCard from "@/components/academy/LessonCard.astro";
import AffiliateDisclosure from "@/components/legal/AffiliateDisclosure.astro";
import { getMedia } from "@/data/media-registry";
import {
  affiliateTools,
  avatarCourse,
  avatarIntroProject,
  castMethod,
  courseModules,
  landingSections,
  faqItems,
  lessonHref,
  whereThisFits,
  workflowPaths,
} from "@/data/avatar-content-system";

const amiIntroVideo = getMedia("workshop.ami-legacy.intro.video");
---

<BaseLayout
  title={`${avatarCourse.productName} | HobFarm Academy`}
  description={avatarCourse.summary}
  palette="magenta-cyan"
>
  <section class="bg-noise border-b border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-16 lg:py-24">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div>
            <Eyebrow text="HobFarm / Academy" />
            <p class="mt-5 text-xs font-mono uppercase tracking-wider text-accent-cyan-bright">
              {avatarCourse.frameLabel}
            </p>
            <Text tag="h1" variant="display2XL" class="mt-6 max-w-4xl text-balance font-display text-white">
              {avatarCourse.productName}
            </Text>
            <p class="mt-6 max-w-2xl text-base leading-relaxed text-base-300 text-pretty">
              {avatarCourse.summary}
            </p>
            <p class="mt-4 max-w-2xl text-sm leading-relaxed text-base-400 text-pretty">
              {avatarCourse.thesis}
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <Button isLink size="sm" variant="green" href={avatarCourse.freePath}>
                Start free overview
              </Button>
              <Button isLink size="sm" variant="muted" href={avatarCourse.coursePath}>
                View course modules
              </Button>
            </div>
            <p class="mt-4 text-xs font-mono text-base-500">{avatarCourse.betaCta}</p>
          </div>
          <CourseDiagram variant="workflow" />
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  <section id="ami-intro-project" class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader
          eyebrow="Field project"
          heading={avatarIntroProject.title}
          note="One master video, several useful placements."
        />
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(16rem,0.58fr)_minmax(0,1.42fr)] lg:items-start">
          <div>
            <video
              controls
              playsinline
              preload="none"
              poster={amiIntroVideo.poster}
              aria-label="Ami's captioned HobFarm introduction"
              class="mx-auto aspect-[9/16] w-full max-w-sm border border-accent-violet/50 bg-black object-cover"
            >
              <source src={amiIntroVideo.src} type="video/mp4" />
            </video>
            <p class="mt-3 text-center text-[10px] font-mono uppercase tracking-wider text-base-500">
              Captioned master / {avatarIntroProject.duration}
            </p>
          </div>

          <div>
            <article class="border border-accent-violet/40 bg-base-900/50 p-6">
              <div class="flex flex-wrap gap-2 text-[10px] font-mono uppercase tracking-wider">
                <span class="border border-accent-green/40 px-3 py-2 text-accent-green-bright">
                  {avatarIntroProject.status}
                </span>
                <span class="border border-base-700 px-3 py-2 text-base-300">{avatarIntroProject.duration}</span>
                <span class="border border-base-700 px-3 py-2 text-base-300">{avatarIntroProject.productionTool}</span>
              </div>
              <p class="mt-5 text-base leading-relaxed text-base-300">{avatarIntroProject.summary}</p>
              <h3 class="mt-7 text-lg font-display text-white">Current build</h3>
              <ul class="mt-4 space-y-3">
                {avatarIntroProject.currentBuild.map((item) => (
                  <li class="border-l border-l-accent-cyan px-4 text-sm leading-relaxed text-base-400">{item}</li>
                ))}
              </ul>
              <div class="mt-7 flex flex-wrap gap-3">
                <Button isLink size="md" variant="green" href={`${avatarCourse.freePath}#intro-project`}>
                  Use the project brief
                </Button>
                <Button isLink size="md" variant="muted" href={avatarIntroProject.workshopHref}>
                  See what Ami introduces next
                </Button>
                <a
                  href={avatarIntroProject.kofiHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Open HobFarm on Ko-fi (opens in a new tab)"
                  class="inline-flex min-h-11 items-center justify-center rounded-full border border-base-700 px-5 py-3 text-sm font-semibold text-base-200 transition-colors hover:border-white hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-green-bright motion-reduce:transition-none"
                >
                  Open HobFarm on Ko-fi
                </a>
              </div>
            </article>

            <h3 class="mt-8 text-xl font-display text-white">Placement map</h3>
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
              {avatarIntroProject.placements.map((placement) => (
                <article class="border border-base-800 bg-base-950/50 p-5">
                  <h4 class="text-base font-display text-white">{placement.name}</h4>
                  <p class="mt-3 text-sm leading-relaxed text-base-400">{placement.body}</p>
                </article>
              ))}
            </div>
            <h3 class="mt-8 text-xl font-display text-white">Where it enters the course</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {avatarIntroProject.lessonLinks.map((lesson) => (
                <a
                  href={lessonHref(lesson.slug)}
                  class="inline-flex min-h-11 items-center border border-base-700 px-4 py-2 text-xs font-mono text-base-300 transition-colors hover:border-accent-violet hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-violet-bright"
                >
                  {lesson.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="01" heading="What this helps you make" note="A first usable system." />
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
          {landingSections.helpsMake.map((item) => (
            <article class="border border-base-800 bg-base-900/40 p-5">
              <p class="text-sm leading-relaxed text-base-300">{item}</p>
            </article>
          ))}
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="02" heading="CAST, kept small" note="A light method for the starter kit." />
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
          {castMethod.map((step) => (
            <article class="border border-base-800 bg-base-900/40 p-5">
              <h3 class="text-xl font-display text-white">{step.term}</h3>
              <p class="mt-3 text-sm leading-relaxed text-base-400">{step.body}</p>
            </article>
          ))}
        </div>
        <p class="mt-6 max-w-3xl text-sm leading-relaxed text-base-500">
          CAST is only a handle here. The starter kit uses it to keep one avatar post organized before the larger Aesthetic Systems Lab material expands the method.
        </p>
      </Wrapper>
    </ContentPanel>
  </section>

  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="03" heading="Voice/Phone vs Text/Computer" note="Start where you actually work." />
        <CourseDiagram variant="paths" />
        <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2">
          {workflowPaths.map((path) => (
            <article class="border-l border-l-accent-cyan bg-base-900/40 px-5 py-4">
              <h3 class="text-xl font-display text-white">{path.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-base-400">{path.body}</p>
            </article>
          ))}
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="04" heading="Avatar content pipeline" note="The shared path." />
        <CourseDiagram variant="workflow" />
      </Wrapper>
    </ContentPanel>
  </section>

  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
          <section>
            <SectionHeader eyebrow="05" heading="What is free" />
            <ul class="space-y-3">
              {landingSections.freeIncludes.map((item) => (
                <li class="border-l border-l-accent-green px-4 text-sm leading-relaxed text-base-300">
                  {item}
                </li>
              ))}
            </ul>
            <div class="mt-6">
              <Button isLink size="sm" variant="green" href={avatarCourse.freePath}>
                Open free overview
              </Button>
            </div>
          </section>
          <section>
            <SectionHeader eyebrow="06" heading="Paid starter kit" />
            <ul class="space-y-3">
              {landingSections.paidIncludes.map((item) => (
                <li class="border-l border-l-accent-violet px-4 text-sm leading-relaxed text-base-300">
                  {item}
                </li>
              ))}
            </ul>
            <div class="mt-6">
              <Button isLink size="sm" variant="muted" href={avatarCourse.coursePath}>
                Preview locked lessons
              </Button>
            </div>
          </section>
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="07" heading="Course modules" note="Free setup, then paid depth." />
        <div class="space-y-8">
          {courseModules.map((module) => (
            <section>
              <h3 class="mb-4 text-xl font-display text-white">{module.title}</h3>
              <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
                {module.lessons.map((lesson) => <LessonCard lesson={lesson} />)}
              </div>
            </section>
          ))}
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="08" heading="Tools used" note="The small stack." />
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
          {affiliateTools.map((tool) => (
            <article class="border border-base-800 bg-base-900/40 p-5">
              <h3 class="text-lg font-display text-white">
                {tool.href ? (
                  <a
                    href={tool.href}
                    class="hover:text-accent-green-bright"
                    target="_blank"
                    rel={tool.affiliate ? "sponsored nofollow noopener noreferrer" : "noopener noreferrer"}
                  >
                    {tool.name}
                  </a>
                ) : (
                  tool.name
                )}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-base-400">{tool.role}</p>
              {tool.href && tool.affiliate && (
                <AffiliateDisclosure class="mt-4" />
              )}
            </article>
          ))}
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="09" heading="Where this fits" note="Starter kit first, lab later." />
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          {whereThisFits.map((item) => (
            <article class="border border-base-800 bg-base-900/40 p-5">
              <h3 class="text-xl font-display text-white">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-base-400">{item.body}</p>
              {item.href ? (
                <a
                  href={item.href}
                  class="mt-5 inline-flex text-xs font-mono uppercase tracking-wider text-accent-green-bright underline decoration-base-700 underline-offset-4 hover:text-white"
                >
                  {item.cta}
                </a>
              ) : (
                <p class="mt-5 text-xs font-mono uppercase tracking-wider text-base-500">{item.cta}</p>
              )}
            </article>
          ))}
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_0.8fr] lg:items-start">
          <div>
            <SectionHeader eyebrow="10" heading="Supporter beta access" note="Simple access while the kit is new." />
            <p class="max-w-2xl text-base leading-relaxed text-base-300">
              {avatarCourse.betaCta} The four setup lessons remain public, so you can inspect the workflow before joining.
            </p>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-base-500">
              {avatarCourse.standaloneNote}
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <Button isLink size="sm" variant="green" href={avatarCourse.checkoutPath}>
                Join for beta access
              </Button>
              <Button isLink size="sm" variant="muted" href={avatarCourse.coursePath}>
                See lesson previews
              </Button>
            </div>
          </div>
          <aside class="border border-base-800 bg-base-900/40 p-5">
            <p class="text-xs font-mono uppercase tracking-wider text-accent-cyan-bright">Course access note</p>
            <p class="mt-4 text-sm leading-relaxed text-base-400">
              Current supporter access remains active while the course moves toward a one-time purchase model.
            </p>
          </aside>
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="11" heading="FAQ" />
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {faqItems.map((item) => (
            <article class="border border-base-800 bg-base-900/40 p-5">
              <h3 class="text-lg font-display text-white">{item.question}</h3>
              <p class="mt-3 text-sm leading-relaxed text-base-400">{item.answer}</p>
            </article>
          ))}
        </div>
      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>
