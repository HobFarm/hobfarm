---
import Breadcrumbs from "@/components/global/Breadcrumbs.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { contentAcademyCourses, type AcademyCourse, type AcademyDownload } from "@/data/academy-courses";
import BaseLayout from "@/layouts/BaseLayout.astro";

const worksheetFields: Record<string, string[]> = {
  "ai-output-receipt": [
    "What I asked for",
    "What the tool actually did",
    "What it retrieved or quoted",
    "What it inferred",
    "What it invented",
    "What it decided without permission",
    "What is useful",
    "What needs verification",
    "What I am discarding",
    "What I am approving",
    "Next tool or action",
    "Stop condition",
  ],
  "my-intellectual-self-defense-protocol-v1": [
    "My pause signals",
    "Jobs I delegate",
    "Jobs I keep",
    "My original-source rule",
    "My multiple-source rule",
    "Creative gaps the tool may invent",
    "Decisions that require my approval",
    "My scope-drift response",
    "My emotional warning lights",
    "My uncertainty language",
    "My sharing rule",
    "What would change my mind",
  ],
};

export function getStaticPaths() {
  return contentAcademyCourses.flatMap((course) =>
    (course.downloads ?? [])
      .filter((download) => download.printable)
      .map((download) => ({
        params: { courseSlug: course.slug, worksheetSlug: download.slug },
        props: { course, download },
      })),
  );
}

interface Props {
  course: AcademyCourse;
  download: AcademyDownload;
}

const { course, download } = Astro.props;
const fields = worksheetFields[download.slug] ?? [];
---

<BaseLayout title={`${download.label} | ${course.title}`} description={download.description} canonical={`${course.href}worksheets/${download.slug}/`} palette="magenta-cyan">
  <div class="screen-only">
    <ContentPanel>
      <Wrapper variant="standard" class="pt-5">
        <Breadcrumbs items={[{ label: "Academy", href: "/academy/" }, { label: course.shortTitle, href: course.href }, { label: download.label }]} />
      </Wrapper>
    </ContentPanel>
  </div>
  <article class="worksheet">
    <header>
      <p>HobFarm Academy / {course.shortTitle}</p>
      <h1>{download.label}</h1>
      <p>{download.description}</p>
      <dl><div><dt>Version</dt><dd>1</dd></div><div><dt>Date</dt><dd></dd></div><div><dt>Next review</dt><dd></dd></div></dl>
    </header>
    <ol>
      {fields.map((field) => (
        <li><h2>{field}</h2><div aria-hidden="true"></div><div aria-hidden="true"></div></li>
      ))}
    </ol>
    <footer>
      <p>READY TO BE REVISED</p>
      <a class="screen-only" href={download.href} download>Download the editable Markdown source</a>
      <span class="screen-only">Use your browser's Print command for paper or PDF.</span>
    </footer>
  </article>
</BaseLayout>

<style>
  .worksheet { width: min(54rem, calc(100% - 2rem)); margin: 2rem auto 5rem; padding: clamp(1.1rem, 4vw, 2.5rem); border: 1px solid #2c2440; border-radius: 1rem; background: #f0e5c9; color: #07060b; }
  header > p:first-child { margin: 0; color: #5b1fb8; font-family: var(--font-mono); font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: .65rem 0 0; font-family: var(--font-display); font-size: clamp(2.1rem, 7vw, 4rem); line-height: .98; }
  header > p:not(:first-child) { max-width: 44rem; margin: 1rem 0 0; color: #2c2440; line-height: 1.6; }
  dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6rem; margin: 1.4rem 0 0; }
  dl div { min-height: 3.3rem; padding: .65rem; border: 1px solid #9f8d69; }
  dt { color: #5b1fb8; font-family: var(--font-mono); font-size: .58rem; text-transform: uppercase; }
  dd { margin: .5rem 0 0; border-bottom: 1px solid #9f8d69; }
  ol { display: grid; gap: 1rem; margin: 2rem 0 0; padding: 0; counter-reset: worksheet; list-style: none; }
  li { counter-increment: worksheet; break-inside: avoid; }
  h2 { display: flex; gap: .75rem; margin: 0; font-family: var(--font-display); font-size: 1rem; }
  h2::before { content: counter(worksheet, decimal-leading-zero); color: #14b5b5; font-family: var(--font-mono); font-size: .8rem; }
  li div { height: 1.9rem; margin-left: 2.5rem; border-bottom: 1px solid #b9a57c; }
  li div + div { border-bottom-style: dashed; opacity: .7; }
  footer { margin-top: 2rem; padding-top: 1rem; border-top: 2px solid #14b5b5; text-align: center; }
  footer p { margin: 0; color: #14b5b5; font-family: var(--font-mono); font-weight: 700; letter-spacing: .08em; }
  footer a, footer span { display: block; margin-top: .8rem; color: #5b1fb8; font-size: .76rem; }
  @media print {
    @page { size: letter; margin: .4in; }
    :global(body) { background: #fff !important; }
    :global(body > *) { visibility: hidden; }
    :global(.worksheet), :global(.worksheet *) { visibility: visible; }
    .worksheet { position: absolute; inset: 0; width: auto; margin: 0; padding: 0; border: 0; border-radius: 0; background: #fff; }
    .screen-only, :global(nav), :global(footer:not(.worksheet footer)) { display: none !important; }
    ol { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem 1.2rem; }
    li div { height: 1.35rem; }
  }
</style>
