---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Breadcrumbs from "@/components/global/Breadcrumbs.astro";
import AcademyHelp from "@/components/academy/AcademyHelp";
import { academyFeatures } from "@/data/academy-features";
---

<BaseLayout title="Academy Help | HobFarm" description="Search HobFarm Academy course help and report a lesson question that the current material does not answer." canonical="/academy/help/" palette="magenta-cyan">
  <ContentPanel><Wrapper variant="standard" class="pt-5"><Breadcrumbs items={[{ label: "Academy", href: "/academy/" }, { label: "Help" }]} /></Wrapper></ContentPanel>
  <header class="border-b border-base-800 bg-base-950"><ContentPanel><Wrapper variant="standard" class="py-14 lg:py-20">
    <p class="text-xs font-mono uppercase tracking-wider text-accent-cyan-bright">Academy Help</p>
    <h1 class="mt-4 max-w-4xl font-display text-5xl font-light leading-none text-white lg:text-7xl">Find the answer. Show us the missing lesson.</h1>
    <p class="mt-5 max-w-3xl text-base leading-relaxed text-base-300">Search the current course answers first. Course-content gaps go into a private improvement report. Billing, refunds, account access, and payment problems go to Customer Help.</p>
    <div class="mt-5 flex flex-wrap gap-3"><a class="text-sm text-white underline" href="/helpcenter/">Customer Help</a><a class="text-sm text-white underline" href="/account/">Account</a></div>
  </Wrapper></ContentPanel></header>
  <div><ContentPanel><Wrapper variant="standard" class="py-12 lg:py-20">
    <AcademyHelp client:visible />
    <aside class="mt-12 border border-base-800 p-5">
      <p class="text-xs font-mono uppercase tracking-wider text-base-500">Ask the Academy</p>
      <p class="mt-3 text-sm leading-relaxed text-base-400">{academyFeatures.askAcademyReason}</p>
    </aside>
  </Wrapper></ContentPanel></div>
</BaseLayout>
