---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Breadcrumbs from "@/components/global/Breadcrumbs.astro";
import { academyToolRoute } from "@/data/academy-tool-route";
---

<BaseLayout
  title={`${academyToolRoute.title} | HobFarm Academy`}
  description="A planned free Academy worksheet for choosing a creative tool route from the job, inputs, limits, and costs."
  canonical="/academy/choose-the-tool-for-the-job/"
  noindex
  palette="magenta-cyan"
>
  <ContentPanel><Wrapper variant="standard" class="pt-5"><Breadcrumbs items={[{ label: "Academy", href: "/academy/" }, { label: academyToolRoute.title }]} /></Wrapper></ContentPanel>
  <header class="tool-hero"><ContentPanel><Wrapper variant="standard" class="py-14 lg:py-20">
    <p class="eyebrow">Queued free tool / planned</p>
    <h1>{academyToolRoute.title}</h1>
    <p class="lead">{academyToolRoute.purpose} This preview records the questions. It does not recommend or rank providers yet.</p>
  </Wrapper></ContentPanel></header>
  <main><ContentPanel><Wrapper variant="standard" class="py-12 lg:py-20">
    <section aria-labelledby="route-heading"><p class="eyebrow">Route map</p><h2 id="route-heading">Describe the job before choosing the software.</h2>
      <ol class="questions">{academyToolRoute.questions.map((question) => <li><strong>{question.prompt}</strong>{question.choices && <span>{question.choices.join(" / ")}</span>}</li>)}</ol>
    </section>
    <aside><strong>The worksheet is not active.</strong><p>Provider facts, availability, pricing, and regional limits will be added only with a visible verification date. The finished tool will allow a chain of tools when one provider cannot meet the whole job.</p></aside>
  </Wrapper></ContentPanel></main>
</BaseLayout>

<style>
  .tool-hero { border-bottom: 1px solid #2c2440; background: radial-gradient(circle at 80% 10%, rgba(92,240,240,.1), transparent 32rem), #07060b; }
  .eyebrow { margin: 0; color: #5cf0f0; font-family: var(--font-mono); font-size: .65rem; letter-spacing: .1em; text-transform: uppercase; }
  h1 { max-width: 60rem; margin: 1rem 0 0; color: #fff; font-family: var(--font-display); font-size: clamp(3rem, 8vw, 6rem); font-weight: 300; line-height: .92; letter-spacing: -.04em; }
  .lead { max-width: 48rem; margin-top: 1.3rem; color: #c8c6d4; line-height: 1.7; }
  h2 { max-width: 48rem; margin: .7rem 0 0; color: #fff; font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.4rem); font-weight: 350; line-height: 1.04; }
  .questions { display: grid; gap: .7rem; margin-top: 1.5rem; padding: 0; list-style: none; counter-reset: route; }
  .questions li { counter-increment: route; padding: 1rem; border: 1px solid #2c2440; background: #0e0b16; color: #ece9f5; }
  .questions li::before { content: counter(route, decimal-leading-zero); margin-right: .8rem; color: #f24da6; font-family: var(--font-mono); font-size: .65rem; }
  .questions span { display: block; margin: .5rem 0 0 2.2rem; color: #8d879d; font-size: .75rem; line-height: 1.5; }
  aside { margin-top: 2rem; padding: 1rem; border-left: 2px solid #f0c96b; background: rgba(240,201,107,.05); }
  aside strong { color: #f0c96b; } aside p { color: #aaa5b7; font-size: .82rem; line-height: 1.6; }
  @media (min-width: 760px) { .questions { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
