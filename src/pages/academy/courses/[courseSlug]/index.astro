---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Breadcrumbs from "@/components/global/Breadcrumbs.astro";
import CourseAccessCard from "@/components/academy/CourseAccessCard.astro";
import CheckoutNotice from "@/components/academy/CheckoutNotice";
import {
  academyCourseManifests,
  academyLessonHref,
  academyPriceLabel,
  type AcademyCourseManifest,
} from "@/data/academy-manifest";

export function getStaticPaths() {
  return academyCourseManifests.map((course) => ({ params: { courseSlug: course.slug }, props: { course } }));
}

interface Props { course: AcademyCourseManifest }
const { course } = Astro.props;
---

<BaseLayout
  title={`${course.title} | HobFarm Academy`}
  description={course.subtitle}
  canonical={`/academy/courses/${course.slug}/`}
  noindex={course.status !== "available"}
  palette="magenta-cyan"
>
  <ContentPanel>
    <Wrapper variant="standard" class="pt-5"><Breadcrumbs items={[{ label: "Academy", href: "/academy/" }, { label: course.title }]} /></Wrapper>
  </ContentPanel>
  <header class="course-hero" data-event="academy_course_view" data-course-id={course.courseId}>
    <ContentPanel><Wrapper variant="standard" class="py-14 lg:py-20">
      <p class="eyebrow">{course.publicStatus} / {academyPriceLabel(course.priceTier)}</p>
      <h1>{course.title}</h1>
      <p class="subtitle">{course.subtitle}</p>
      <div class="facts">
        <span>{course.learner}</span><span>{course.estimatedTime}</span><span>{course.freePreviewLessons.length} free preview lessons</span>
      </div>
      <CheckoutNotice client:load />
    </Wrapper></ContentPanel>
  </header>

  <div>
    <ContentPanel><Wrapper variant="standard" class="py-12 lg:py-18">
      <section class="problem-grid">
        <article><span>Production problem</span><p>{course.problem}</p></article>
        <article><span>Finished result</span><p>{course.outcome}</p></article>
      </section>

      <section class="course-section" aria-labelledby="artifacts-heading">
        <h2 id="artifacts-heading">What you will finish</h2>
        <ul>{course.artifacts.map((artifact) => <li>{artifact}</li>)}</ul>
      </section>

      {course.mediaManifest?.map((media) => (
        <section class="course-section media-pilot" aria-labelledby={`${media.mediaId}-heading`}>
          <div><p class="eyebrow">Media pilot</p><h2 id={`${media.mediaId}-heading`}>The method in motion</h2><p>{media.transcript}</p></div>
          <video controls preload="metadata" poster={media.poster} width={media.width} height={media.height} aria-label={media.alt}>
            <source src={media.sourceFile.replace("public/", "/")} type="video/mp4" />
            {media.captions && <track kind="captions" src={media.captions} srclang="en" label="English" default />}
            <p>{media.transcript}</p>
          </video>
          <details><summary>Read transcript</summary><p>{media.transcript}</p></details>
        </section>
      ))}

      <section class="course-section" aria-labelledby="lessons-heading">
        <div class="section-heading"><div><p class="eyebrow">Course map</p><h2 id="lessons-heading">Lessons</h2></div><p>Public previews stay readable. Paid bodies are fetched only after server-side access checks.</p></div>
        <ol class="lesson-list">
          {course.lessons.map((lesson) => (
            <li>
              <a href={academyLessonHref(course, lesson)}>
                <span>{String(lesson.order).padStart(2, "0")} / {lesson.access}</span>
                <strong>{lesson.title}</strong>
                <p>{lesson.preview}</p>
                <small>Build: {lesson.builds}</small>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <div class="course-section"><CourseAccessCard course={course} /></div>

      <section class="course-section source-loop" aria-labelledby="source-heading">
        <div><p class="eyebrow">Source trace</p><h2 id="source-heading">See the result in Workshop. Learn the mechanics here.</h2><p>Workshop keeps the public evidence and production record. Academy supplies the ordered practice, checkpoints, failure checks, and saved artifacts.</p></div>
        <ul>{course.workshopSources.map((source) => <li><a href={source}>Open Workshop source</a></li>)}</ul>
      </section>

      {course.operatorInputRequired?.length && (
        <section class="course-section review-note" aria-labelledby="review-heading">
          <p class="eyebrow">Review gate</p><h2 id="review-heading">This course is not for sale yet.</h2>
          <p>The source-backed draft is visible, but these operator checks still block paid publication:</p>
          <ul>{course.operatorInputRequired.map((item) => <li>{item}</li>)}</ul>
        </section>
      )}
    </Wrapper></ContentPanel>
  </div>
</BaseLayout>

<style>
  .course-hero { border-bottom: 1px solid #2c2440; background: radial-gradient(circle at 80% 15%, rgba(242,77,166,.12), transparent 35rem), #07060b; }
  .eyebrow { margin: 0; color: #5cf0f0; font-family: var(--font-mono); font-size: .65rem; letter-spacing: .1em; text-transform: uppercase; }
  h1 { max-width: 62rem; margin: 1rem 0 0; color: #fff; font-family: var(--font-display); font-size: clamp(2.8rem, 7vw, 5.8rem); font-weight: 300; line-height: .92; letter-spacing: -.04em; }
  .subtitle { max-width: 50rem; margin: 1.4rem 0 0; color: #c8c6d4; font-size: clamp(1rem, 2vw, 1.2rem); line-height: 1.62; }
  .facts { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.4rem; }
  .facts span { padding: .45rem .65rem; border: 1px solid #2c2440; color: #9b96ad; font-family: var(--font-mono); font-size: .62rem; }
  .problem-grid { display: grid; gap: .8rem; }
  .problem-grid article { padding: 1.2rem; border: 1px solid #2c2440; background: #0e0b16; }
  .problem-grid span { color: #f24da6; font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; }
  .problem-grid p, .source-loop p, .media-pilot p, .review-note p { color: #b9b5c8; font-size: .9rem; line-height: 1.65; }
  .course-section { margin-top: 3.5rem; }
  .course-section h2 { margin: .65rem 0 0; color: #fff; font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3rem); font-weight: 350; line-height: 1.04; }
  .course-section > ul { display: grid; gap: .65rem; margin: 1rem 0 0; padding: 0; list-style: none; }
  .course-section > ul li { padding: .8rem 1rem; border-left: 2px solid #5cf0a6; background: #0e0b16; color: #c8c6d4; font-size: .82rem; }
  .section-heading { display: grid; gap: 1rem; align-items: end; }
  .section-heading > p { max-width: 34rem; margin: 0; color: #8d879d; font-size: .78rem; line-height: 1.55; }
  .lesson-list { display: grid; gap: .75rem; margin: 1.2rem 0 0; padding: 0; list-style: none; }
  .lesson-list a { display: block; height: 100%; padding: 1rem; border: 1px solid #2c2440; border-radius: .7rem; background: #0e0b16; text-decoration: none; }
  .lesson-list a:hover { border-color: #5cf0a6; }
  .lesson-list span, .lesson-list small { color: #6f687e; font-family: var(--font-mono); font-size: .6rem; text-transform: uppercase; }
  .lesson-list strong { display: block; margin-top: .5rem; color: #fff; font-family: var(--font-display); font-size: 1.25rem; font-weight: 450; }
  .lesson-list p { color: #aaa5b7; font-size: .76rem; line-height: 1.5; }
  .lesson-list small { display: block; color: #5cf0f0; line-height: 1.45; }
  .media-pilot video { display: block; width: min(100%, 60rem); height: auto; margin-top: 1.2rem; border: 1px solid #2c2440; background: #000; }
  .media-pilot details { margin-top: .7rem; color: #aaa5b7; font-size: .78rem; }
  .media-pilot summary { color: #5cf0f0; cursor: pointer; }
  .source-loop { display: grid; gap: 1.4rem; padding: 1.3rem; border: 1px solid #2c2440; }
  .source-loop a { color: #5cf0a6; }
  .review-note { padding: 1.25rem; border: 1px solid rgba(240,201,107,.45); background: rgba(240,201,107,.04); }
  @media (min-width: 720px) { .problem-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .section-heading, .source-loop { grid-template-columns: 1fr .8fr; } .lesson-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
