---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Eyebrow from "@/components/sections/Eyebrow.astro";
import SectionHeader from "@/components/sections/SectionHeader.astro";
import Button from "@/components/fundations/elements/Button.astro";
import KofiCta from "@/components/KofiCta.astro";
import { avatarCourse } from "@/data/avatar-content-system";

type Track = { title: string; body: string };

const tracks: Track[] = [
  {
    title: "Platform fundamentals",
    body: "Getting set up on the main AI platforms: figuring out what each model is good at, getting your API keys working, and learning the quirks of Grok on X, Meta AI, and Gemini. This is the groundwork everything else builds on.",
  },
  {
    title: "Prompt science",
    body: "How to write prompts that actually work. Run the same prompt through different models and compare the results. Try the same model with different formats (plain text, markdown, JSON, tag lists) and watch what changes. Learn how the order of a prompt shifts the answer, and where each platform's length limits get in the way.",
  },
  {
    title: "Image workflows",
    body: "The full image process, start to finish. Mask a subject image in Photoshop, assign approved StyleFusion reference roles, inspect the export, then send the compiled document into a downstream image run. Grimoire keeps the references, notes, and metadata connected without treating the generated images as part of the export.",
  },
  {
    title: "Building with AI",
    body: "How the HobFarm apps actually get built: the tools, the tech stack, the custom Claude skills and instructions behind them, and how one person ships real software with AI.",
  },
  {
    title: "Selling your work",
    body: "Etsy and print-on-demand, run from a real shop. How to set up listings, turn generated art into physical products people can buy, and let a single post that shows a real technique do the selling for you.",
  },
  {
    title: "Character sheets",
    body: "Reusable character sheets and reference files that keep a character looking the same from one image to the next, across different models and projects.",
  },
];

const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const academyJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Academy",
  description:
    "Practical AI training from HobFarm: avatar workflows, prompts, image systems, building apps, and selling your work.",
  url: `${siteOrigin}/academy/`,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: avatarCourse.productName,
        url: `${siteOrigin}${avatarCourse.basePath}/`,
      },
      ...tracks.map((track, index) => ({
        "@type": "ListItem",
        position: index + 2,
        name: track.title,
        description: track.body,
      })),
    ],
  },
};
---

<BaseLayout
  title="Academy | HobFarm"
  description="Practical AI training from HobFarm: avatar workflows, prompts, image systems, building apps, and selling your work. Built from the real work behind the site."
  canonical="/academy/"
  structuredData={academyJsonLd}
>
  {/* ── Hero ── */}
  <section class="bg-noise border-b border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-20 lg:py-28">
        <Eyebrow text="HobFarm / Academy" />
        <Text tag="h1" variant="display2XL" class="mt-6 text-white font-display max-w-4xl text-balance">
          Academy
        </Text>
        <Text tag="p" variant="textBase" class="text-base-300 mt-6 max-w-2xl text-pretty leading-relaxed">
          Practical AI training built from the work behind this site: avatar workflows, writing prompts, comparing models, setting up files, and turning rough ideas into finished work.
        </Text>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button isLink size="sm" variant="green" href={avatarCourse.basePath}>
            Open first course
          </Button>
          <Button isLink size="sm" variant="muted" href={avatarCourse.freePath}>
            Start free overview
          </Button>
          <KofiCta variant="symbol" text="Ko-fi" />
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  {/* ── First course ── */}
  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="01" heading="First course" note="Beta access is open." />
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_0.8fr]">
          <div class="border border-base-800 bg-base-900/40 p-6">
            <Text tag="h2" variant="displaySM" class="text-white font-display text-balance">
              {avatarCourse.productName}
            </Text>
            <p class="mt-4 max-w-2xl text-sm leading-relaxed text-base-400">
              A beginner workflow for making avatar videos with ChatGPT, HeyGen, ElevenLabs, and Meta Business Suite. It starts with the real problem: moving between phone, laptop, screenshots, voice notes, scripts, exports, and scheduled posts without turning the whole thing into a junk drawer.
            </p>
            <p class="mt-4 text-xs font-mono text-base-500">{avatarCourse.betaCta}</p>
            <div class="mt-6 flex flex-wrap gap-3">
              <Button isLink size="sm" variant="green" href={avatarCourse.basePath}>
                View course
              </Button>
              <Button isLink size="sm" variant="muted" href={avatarCourse.coursePath}>
                See modules
              </Button>
            </div>
          </div>
          <aside class="border border-base-800 bg-base-950/60 p-6">
            <p class="text-xs font-mono uppercase tracking-wider text-accent-violet-bright">
              Free + paid
            </p>
            <dl class="mt-5 space-y-4">
              <div>
                <dt class="text-sm text-white">Free overview</dt>
                <dd class="mt-1 text-sm leading-relaxed text-base-400">
                  System map, workflow choice, folder setup, and starter prompts.
                </dd>
              </div>
              <div>
                <dt class="text-sm text-white">Paid starter kit</dt>
                <dd class="mt-1 text-sm leading-relaxed text-base-400">
                  Modular walkthroughs, screenshot slots, snippets, prompts, and checklists.
                </dd>
              </div>
            </dl>
          </aside>
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  {/* ── What's coming ── */}
  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="02" heading="What's coming" note="More tracks in production." />
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {tracks.map((track) => (
            <div class="rounded-lg border border-base-800 bg-base-900/40 p-6">
              <Text tag="h3" variant="textLG" class="text-white font-display">
                {track.title}
              </Text>
              <Text tag="p" variant="textSM" class="text-base-400 mt-3 text-pretty leading-relaxed">
                {track.body}
              </Text>
            </div>
          ))}
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  {/* ── Built from real work ── */}
  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="03" heading="Built from real work" note="Nothing here is theory." />
        <Text tag="p" variant="textBase" class="text-base-400 max-w-2xl text-pretty leading-relaxed">
          These courses come from the same work behind StyleFusion, Grimoire, and the rest of HobFarm. When a lesson covers a prompt change, it shows the results side by side. When it covers a platform quirk, it explains where the issue came up and how it was handled.
        </Text>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button isLink size="sm" variant="green" href="/articles">Get notified through articles</Button>
        </div>
      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>
