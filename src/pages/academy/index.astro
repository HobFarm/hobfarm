---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Breadcrumbs from "@/components/global/Breadcrumbs.astro";
import AcademyCourseCard from "@/components/academy/AcademyCourseCard.astro";
import { academyCourseManifests, academyCourseScaffolds } from "@/data/academy-manifest";

const available = academyCourseManifests.filter((course) => course.publicStatus === "available");
const previews = academyCourseManifests.filter((course) => course.publicStatus === "preview" || course.publicStatus === "in production");
const academyJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "HobFarm Academy courses",
  itemListElement: available.map((course, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: `https://hob.farm/academy/courses/${course.slug}/`,
    name: course.title,
  })),
};
---

<BaseLayout
  title="Academy | HobFarm"
  description="Practical HobFarm courses that turn Workshop methods into finished assets, source files, and repeatable workflows."
  canonical="/academy/"
  structuredData={academyJsonLd}
  palette="magenta-cyan"
>
  <ContentPanel><Wrapper variant="standard" class="pt-5"><Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Academy" }]} /></Wrapper></ContentPanel>

  <header class="academy-hero" data-event="academy_catalog_view">
    <ContentPanel><Wrapper variant="standard" class="py-16 lg:py-24">
      <p class="eyebrow">HobFarm / Academy</p>
      <h1>Learn the system behind the work.</h1>
      <p class="lead">Each course starts with one production problem and ends with a finished asset, source file, or repeatable workflow. Start with a free course, buy one for $5 or $7 when it is available, or use the catalog with the $5 monthly HobFarm membership.</p>
      <div class="hero-actions"><a href="#courses">Browse courses</a><a href="/account/">Continue from Account</a><a href="/academy/help/">Academy help</a></div>
    </Wrapper></ContentPanel>
  </header>

  <main>
    <ContentPanel><Wrapper variant="standard" class="py-12 lg:py-20">
      <section class="access-explainer" aria-labelledby="access-heading">
        <div><p class="eyebrow">Access</p><h2 id="access-heading">The price buys the course. Membership borrows the catalog.</h2></div>
        <div class="access-grid">
          <article><span>Free</span><p>Public lessons, exercises, and downloads stay open without an account.</p></article>
          <article><span>One time</span><p>A $5 or $7 course purchase grants permanent account access unless it is refunded, disputed, or corrected by support.</p></article>
          <article><span>Membership</span><p>The $5 monthly HobFarm membership includes Academy courses while membership is active. A separate purchase survives cancellation.</p></article>
        </div>
      </section>

      <section id="courses" class="catalog-section" aria-labelledby="available-heading">
        <div class="section-heading"><div><p class="eyebrow">Available now</p><h2 id="available-heading">Courses you can use</h2></div><p>Course prices do not include outside model, avatar, voice, API, hosting, stock, or licensing costs. Each card names the likely tool requirement.</p></div>
        <div class="course-grid">{available.map((course) => <AcademyCourseCard course={course} />)}</div>
      </section>

      <section class="catalog-section" aria-labelledby="preview-heading">
        <div class="section-heading"><div><p class="eyebrow">Preview</p><h2 id="preview-heading">Built from current Workshop evidence</h2></div><p>These drafts are not on sale. Public previews show the problem and source trace while operator walkthroughs close the remaining gaps.</p></div>
        <div class="course-grid">{previews.map((course) => <AcademyCourseCard course={course} />)}</div>
      </section>

      <section class="catalog-section" aria-labelledby="planned-heading">
        <div class="section-heading"><div><p class="eyebrow">Planned</p><h2 id="planned-heading">Next source-backed courses</h2></div><p>These are production records, not promises or products. They move forward only when the Workshop source, operator steps, and validation record support them.</p></div>
        <div class="course-grid">{academyCourseScaffolds.map((course) => <AcademyCourseCard course={course} />)}</div>
      </section>

      <section class="catalog-section next-routes" aria-labelledby="next-heading">
        <div><p class="eyebrow">Need a route</p><h2 id="next-heading">Start with the evidence, the lesson, or support.</h2></div>
        <nav aria-label="Academy next steps">
          <a href="/workshop/"><strong>Workshop</strong><span>See the public proof and production record.</span></a>
          <a href="/academy/help/"><strong>Academy Help</strong><span>Search course questions and report a missing answer.</span></a>
          <a href="/academy/choose-the-tool-for-the-job/"><strong>Choose the Tool for the Job</strong><span>Preview the planned free route map for choosing a workflow from constraints.</span></a>
          <a href="/academy/production-system-sprint/"><strong>Private sprint draft</strong><span>Read the proposed high-touch scope. Applications are not open.</span></a>
        </nav>
      </section>
    </Wrapper></ContentPanel>
  </main>
</BaseLayout>

<style>
  .academy-hero { border-bottom: 1px solid #2c2440; background: radial-gradient(circle at 82% 18%, rgba(242,77,166,.13), transparent 31rem), radial-gradient(circle at 20% 70%, rgba(92,240,240,.08), transparent 28rem), #07060b; }
  .eyebrow { margin: 0; color: #5cf0f0; font-family: var(--font-mono); font-size: .65rem; letter-spacing: .11em; text-transform: uppercase; }
  h1 { max-width: 64rem; margin: 1rem 0 0; color: #fff; font-family: var(--font-display); font-size: clamp(3.2rem, 9vw, 7.4rem); font-weight: 280; line-height: .88; letter-spacing: -.055em; }
  .lead { max-width: 52rem; margin: 1.5rem 0 0; color: #c8c6d4; font-size: clamp(1rem, 2vw, 1.2rem); line-height: 1.7; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.5rem; }
  .hero-actions a { border: 1px solid #41345c; border-radius: 999px; padding: .65rem 1rem; color: #ece9f5; font-family: var(--font-mono); font-size: .68rem; text-decoration: none; }
  .hero-actions a:first-child { border-color: #5cf0a6; background: #5cf0a6; color: #07060b; }
  .access-explainer, .catalog-section { margin-top: 4rem; }
  .access-explainer { margin-top: 0; }
  .access-explainer h2, .section-heading h2, .next-routes h2 { max-width: 48rem; margin: .65rem 0 0; color: #fff; font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.4rem); font-weight: 340; line-height: 1.02; }
  .access-grid { display: grid; gap: .7rem; margin-top: 1.4rem; }
  .access-grid article { padding: 1.1rem; border: 1px solid #2c2440; background: #0e0b16; }
  .access-grid span { color: #5cf0a6; font-family: var(--font-mono); font-size: .64rem; text-transform: uppercase; }
  .access-grid p, .section-heading > p { color: #aaa5b7; font-size: .82rem; line-height: 1.6; }
  .section-heading { display: grid; gap: 1rem; align-items: end; }
  .section-heading > p { max-width: 38rem; margin: 0; }
  .course-grid { display: grid; gap: .9rem; margin-top: 1.3rem; }
  .next-routes { display: grid; gap: 1.4rem; padding: 1.3rem; border: 1px solid #41345c; background: #0e0b16; }
  .next-routes nav { display: grid; gap: .65rem; }
  .next-routes a { padding: .9rem; border: 1px solid #2c2440; color: #fff; text-decoration: none; }
  .next-routes a:hover { border-color: #5cf0a6; }
  .next-routes strong { display: block; font-family: var(--font-display); font-size: 1.1rem; }
  .next-routes span { display: block; margin-top: .35rem; color: #8d879d; font-size: .72rem; line-height: 1.5; }
  @media (min-width: 720px) { .access-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .section-heading, .next-routes { grid-template-columns: 1fr .8fr; } .course-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
