---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Eyebrow from "@/components/sections/Eyebrow.astro";
import SectionHeader from "@/components/sections/SectionHeader.astro";
import Button from "@/components/fundations/elements/Button.astro";
import {
  academyCourses,
  intellectualSelfDefenseCourse,
} from "@/data/academy-courses";

type Track = { title: string; body: string };

const tracks: Track[] = [
  {
    title: "Platform fundamentals",
    body: "Getting set up on the main AI platforms: figuring out what each model is good at, getting your API keys working, and learning the quirks of Grok on X, Meta AI, and Gemini. This is the groundwork everything else builds on.",
  },
  {
    title: "Prompt science",
    body: "How to write prompts that actually work. Run the same prompt through different models and compare the results. Try the same model with different formats (plain text, markdown, JSON, tag lists) and watch what changes. Learn how the order of a prompt shifts the answer, and where each platform's length limits get in the way.",
  },
  {
    title: "Image workflows",
    body: "The full image process, start to finish. Mask a subject image in Photoshop, assign approved StyleFusion reference roles, inspect the export, then send the compiled document into a downstream image run. Grimoire keeps the references, notes, and metadata connected without treating the generated images as part of the export.",
  },
  {
    title: "Building with AI",
    body: "How the HobFarm apps actually get built: the tools, the tech stack, the custom Claude skills and instructions behind them, and how one person ships real software with AI.",
  },
  {
    title: "Selling your work",
    body: "Etsy and print-on-demand, run from a real shop. How to set up listings, turn generated art into physical products people can buy, and let a single post that shows a real technique do the selling for you.",
  },
  {
    title: "Character sheets",
    body: "Reusable character sheets and reference files that keep a character looking the same from one image to the next, across different models and projects.",
  },
];

const priceBands = [
  {
    label: "Free",
    body: "Public courses and onboarding material stay open without checkout.",
  },
  {
    label: "$5 / $7 / $9",
    body: "Paid courses use a one-time price chosen for the size of the course.",
  },
  {
    label: "Bundle price",
    body: "A bundle gets one clearly labeled one-time price when several courses belong together.",
  },
];

const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const academyJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Academy",
  description:
    "Practical HobFarm courses for research, creative production, media judgment, and repeatable AI workflows.",
  url: `${siteOrigin}/academy/`,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: intellectualSelfDefenseCourse.title,
        url: `${siteOrigin}${intellectualSelfDefenseCourse.href}`,
      },
      ...academyCourses.slice(1).map((course, index) => ({
        "@type": "ListItem",
        position: index + 2,
        name: course.title,
        url: `${siteOrigin}${course.href}`,
      })),
      ...tracks.map((track, index) => ({
        "@type": "ListItem",
        position: index + academyCourses.length + 1,
        name: track.title,
        description: track.body,
      })),
    ],
  },
};
---

<BaseLayout
  title="Academy | HobFarm"
  description="Practical HobFarm courses for research, creative production, media judgment, and repeatable AI workflows."
  canonical="/academy/"
  structuredData={academyJsonLd}
>
  {/* ── Hero ── */}
  <section class="bg-noise border-b border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-20 lg:py-28">
        <Eyebrow text="HobFarm / Academy" />
        <Text tag="h1" variant="display2XL" class="mt-6 text-white font-display max-w-4xl text-balance">
          Academy
        </Text>
        <Text tag="p" variant="textBase" class="text-base-300 mt-6 max-w-2xl text-pretty leading-relaxed">
          A catalog of practical free and affordable one-time courses built from HobFarm's working methods. Start with the free media-literacy course or preview the Avatar Content System while its current supporter access remains in place.
        </Text>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button isLink size="sm" variant="green" href={intellectualSelfDefenseCourse.startHref}>
            Start the free course
          </Button>
          <Button isLink size="sm" variant="muted" href={intellectualSelfDefenseCourse.href}>
            View the course map
          </Button>
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  {/* ── Available courses ── */}
  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="01" heading="Available courses" note="Start with the job in front of you." />
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          {academyCourses.map((course) => (
            <article class="overflow-hidden border border-base-800 bg-base-900/40">
              <img src={course.cover} alt={course.coverAlt} class="aspect-video w-full object-cover" loading="lazy" decoding="async" />
              <div class="p-6">
                <p class="text-xs font-mono uppercase tracking-wider text-accent-green-bright">{course.accessLabel}</p>
                <Text tag="h2" variant="displaySM" class="mt-3 text-white font-display text-balance">
                  {course.title}
                </Text>
                <p class="mt-4 max-w-2xl text-sm leading-relaxed text-base-400">{course.description}</p>
                <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-xs font-mono text-base-500">
                  <span>{course.statusLabel}</span>
                  <span>{course.priceLabel}</span>
                  <span>{course.duration}</span>
                </div>
                {course.accessType === "active-membership" && (
                  <p class="mt-4 border-l-2 border-accent-cyan/50 pl-3 text-xs leading-relaxed text-base-500">
                    Existing supporter entitlement remains active. A one-time purchase migration has not been approved or applied.
                  </p>
                )}
                <div class="mt-6 flex flex-wrap gap-3">
                  <Button isLink size="sm" variant="green" href={course.href}>{course.ctaLabel}</Button>
                  <Button isLink size="sm" variant="muted" href={course.startHref}>Start here</Button>
                </div>
              </div>
            </article>
          ))}
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="02" heading="Simple one-time pricing" note="The price appears before checkout." />
        <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
          {priceBands.map((band) => (
            <article class="border border-base-800 bg-base-900/40 p-6">
              <p class="font-mono text-lg text-accent-green-bright">{band.label}</p>
              <p class="mt-3 text-sm leading-relaxed text-base-400">{band.body}</p>
            </article>
          ))}
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  {/* ── What's coming ── */}
  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="03" heading="What's coming" note="More tracks in production." />
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {tracks.map((track) => (
            <div class="rounded-lg border border-base-800 bg-base-900/40 p-6">
              <Text tag="h3" variant="textLG" class="text-white font-display">
                {track.title}
              </Text>
              <Text tag="p" variant="textSM" class="text-base-400 mt-3 text-pretty leading-relaxed">
                {track.body}
              </Text>
            </div>
          ))}
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  {/* ── Built from real work ── */}
  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="04" heading="Built from real work" note="Nothing here is theory." />
        <Text tag="p" variant="textBase" class="text-base-400 max-w-2xl text-pretty leading-relaxed">
          These courses come from the same work behind StyleFusion, Grimoire, and the rest of HobFarm. When a lesson covers a prompt change, it shows the results side by side. When it covers a platform quirk, it explains where the issue came up and how it was handled.
        </Text>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button isLink size="sm" variant="green" href="/articles">Get notified through articles</Button>
        </div>
      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>
