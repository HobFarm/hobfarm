---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";

const supportTopics = [
  "Account or membership access",
  "Stripe, Ko-fi, Lemon Squeezy, PayPal, or marketplace payment questions",
  "Refund and cancellation requests",
  "Missing downloads, course access, or generation credits",
  "StyleFusion, Grimoire, Daily Signal, and gallery issues",
  "Custom work, licensing, and product-use questions",
];

const detailsToInclude = [
  "Email address used for the order or account",
  "Order ID, receipt number, or transaction date",
  "Payment provider or marketplace name",
  "Product, membership, credit pack, course, or download involved",
  "Short description of what happened",
  "Screenshots, files, or error messages when useful",
];
---

<BaseLayout
  title="Support | HobFarm"
  description="Support information for HobFarm accounts, memberships, digital products, credits, downloads, galleries, and creative tools."
>
  <section class="bg-noise">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-4">
          <div class="lg:col-span-2">
            <Text tag="span" variant="textSM" class="text-accent-500 font-mono">
              Support
            </Text>
            <Text tag="h1" variant="displayXL" class="mt-10 text-white text-balance font-display">
              Help for HobFarm.
            </Text>
            <Text tag="p" variant="textBase" class="mt-4 max-w-2xl text-base-400 leading-relaxed text-balance">
              Use this page for payment questions, product access, memberships, refunds, credits,
              downloads, courses, public demos, and HobFarm creative tools.
            </Text>
            <div class="mt-8 flex flex-wrap gap-3">
              <Button isLink size="sm" variant="green" href="/contact/">
                Contact Support
              </Button>
              <Button isLink size="sm" variant="muted" href="/contact/">
                Contact Form
              </Button>
            </div>
          </div>

          <div class="lg:col-span-2 lg:pt-12">
            <div class="border-y border-base-800 py-6">
              <Text tag="h2" variant="textSM" class="text-white font-mono uppercase tracking-widest">
                Support Path
              </Text>
              <p class="mt-4 text-sm text-base-400 leading-relaxed">
                Send the form at <a href="/contact/" class="text-white underline decoration-base-600 underline-offset-4 hover:decoration-white">/contact/</a>.
                Payment and access issues are reviewed manually. Most routine replies are handled within two business days.
              </p>
              <p class="mt-3 text-sm text-base-500 leading-relaxed">
                Security reports should use the <a href="/contact/?subject=security" class="text-white underline decoration-base-600 underline-offset-4 hover:decoration-white">security report subject</a>.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-14 grid grid-cols-1 gap-10 lg:grid-cols-2">
          <section>
            <Text tag="h2" variant="displayXS" class="text-white font-display">
              What We Can Help With
            </Text>
            <ul class="mt-6 divide-y divide-base-800 border-y border-base-800">
              {supportTopics.map((topic) => (
                <li class="py-3 text-sm text-base-400">{topic}</li>
              ))}
            </ul>
          </section>

          <section>
            <Text tag="h2" variant="displayXS" class="text-white font-display">
              Include These Details
            </Text>
            <ul class="mt-6 divide-y divide-base-800 border-y border-base-800">
              {detailsToInclude.map((detail) => (
                <li class="py-3 text-sm text-base-400">{detail}</li>
              ))}
            </ul>
          </section>
        </div>

        <div class="mt-14 grid grid-cols-1 gap-8 border-t border-base-800 pt-10 md:grid-cols-3">
          <div>
            <Text tag="h3" variant="textSM" class="text-white font-mono uppercase tracking-widest">
              Billing
            </Text>
            <p class="mt-3 text-sm text-base-400 leading-relaxed">
              For Stripe, Ko-fi, Lemon Squeezy, PayPal, or marketplace orders, include the provider and order ID.
            </p>
          </div>
          <div>
            <Text tag="h3" variant="textSM" class="text-white font-mono uppercase tracking-widest">
              Refunds
            </Text>
            <p class="mt-3 text-sm text-base-400 leading-relaxed">
              Refund rules vary by memberships, credits, downloads, courses, custom work, and physical products.
            </p>
            <a href="/legal/refunds/" class="mt-3 inline-block text-sm text-white underline decoration-base-600 underline-offset-4 hover:decoration-white">
              Read the refund policy
            </a>
          </div>
          <div>
            <Text tag="h3" variant="textSM" class="text-white font-mono uppercase tracking-widest">
              Status
            </Text>
            <p class="mt-3 text-sm text-base-400 leading-relaxed">
              If a public route looks unavailable, check the status page before opening a duplicate report.
            </p>
            <a href="/status/" class="mt-3 inline-block text-sm text-white underline decoration-base-600 underline-offset-4 hover:decoration-white">
              View status
            </a>
          </div>
        </div>
      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>
