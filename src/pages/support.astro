---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import SupportWays from "@/components/support/SupportWays.astro";
import SupportEmailLink from "@/components/support/SupportEmailLink.astro";
---

<BaseLayout
  title="Support HobFarm"
  description="Fund independent HobFarm publishing with a one-time contribution, monthly support, a Shop purchase, or an Academy course."
  canonical="/support/"
>
  <section class="bg-noise border-b border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-16 lg:py-24">
        <p class="font-mono text-xs uppercase tracking-widest text-accent-green-bright">Independent funding</p>
        <Text tag="h1" variant="displayXL" class="mt-6 max-w-4xl text-balance font-display text-white">
          Support the next HobFarm release.
        </Text>
        <Text tag="p" variant="textLG" class="mt-6 max-w-3xl text-pretty leading-relaxed text-base-300">
          HobFarm is currently a solo operation. Reader funding pays for publishing, hosting, tools, research, media production, and the time needed to finish the work.
        </Text>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button isLink size="sm" variant="green" href="https://ko-fi.com/hobfarm/" target="_blank" rel="noopener noreferrer">
            Support once on Ko-fi ↗
          </Button>
          <Button isLink size="sm" variant="muted" href="/membership/">
            Become a $5/month supporter
          </Button>
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  <section>
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SupportWays
          heading="Four ways to keep HobFarm moving"
          description="Each path has one job. Choose the one that matches how you want to participate."
        />
      </Wrapper>
    </ContentPanel>
  </section>

  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
          <article class="border border-base-800 bg-base-900/45 p-6">
            <p class="font-mono text-[10px] uppercase tracking-widest text-accent-cyan">Editorial policy</p>
            <Text tag="h2" variant="textXL" class="mt-3 font-display text-white">
              No display ads or sponsored editorial
            </Text>
            <p class="mt-4 text-sm leading-relaxed text-base-400">
              HobFarm does not run third-party display ads or publish sponsored editorial. Articles are chosen and edited independently.
            </p>
          </article>

          <article class="border border-base-800 bg-base-900/45 p-6">
            <p class="font-mono text-[10px] uppercase tracking-widest text-accent-cyan">Affiliate links</p>
            <Text tag="h2" variant="textXL" class="mt-3 font-display text-white">
              Labeled where they appear
            </Text>
            <p class="mt-4 text-sm leading-relaxed text-base-400">
              Clearly labeled affiliate links may appear near a relevant tool or service. A commission does not change the buyer's price or determine the editorial conclusion.
            </p>
          </article>

          <article class="border border-base-800 bg-base-900/45 p-6">
            <p class="font-mono text-[10px] uppercase tracking-widest text-accent-cyan">Future contributors</p>
            <Text tag="h2" variant="textXL" class="mt-3 font-display text-white">
              Revenue can widen the operation
            </Text>
            <p class="mt-4 text-sm leading-relaxed text-base-400">
              Greater revenue can eventually fund paid contributors and specialists. HobFarm is not currently hiring.
            </p>
          </article>
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
          <div class="max-w-2xl">
            <Text tag="h2" variant="displaySM" class="font-display text-white">
              Looking for order or account help?
            </Text>
            <Text tag="p" variant="textBase" class="mt-4 text-pretty leading-relaxed text-base-400">
              Customer Help handles payments, downloads, course access, refunds, accounts, applications, and marketplace orders.
            </Text>
          </div>
          <div class="flex flex-wrap gap-3">
            <Button isLink size="sm" variant="green" href="/helpcenter/">Go to Customer Help</Button>
            <SupportEmailLink compact subject="HobFarm Customer Help" />
          </div>
        </div>
      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>
