---
import { render } from "astro:content";
import BlogLayout from "@/layouts/BlogLayout.astro";
import { readingTime } from "@/lib/reading-time";
import { getPublishedPosts, byOldest } from "@/lib/blog";

export async function getStaticPaths() {
  const blog = (await getPublishedPosts()).sort(byOldest);
  return blog.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      previous: i > 0 ? blog[i - 1] : null,
      next: i < blog.length - 1 ? blog[i + 1] : null,
    },
  }));
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const stats = entry.body ? readingTime(entry.body) : null;
---

<BlogLayout
  frontmatter={entry.data}
  readingTime={stats?.text ?? ""}
  id={entry.id}
  previous={previous}
  next={next}
>
  <Content />
</BlogLayout>
