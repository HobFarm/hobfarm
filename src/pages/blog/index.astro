---
// Components
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ArticleCard from "@/components/blog/ArticleCard.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Subscribe from "@/components/blog/Subscribe.astro";

// Content
import { getPublishedPosts } from "@/lib/blog";
const allPosts = await getPublishedPosts();
// Tags
const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())];
// Categories
const categories = [
  { value: "all", label: "All" },
  { value: "technical", label: "Technical" },
  { value: "magazine-time-machine", label: "Time Machine" },
  { value: "cultural-thread", label: "Cultural Thread" },
  { value: "grimoire", label: "Grimoire" },
  { value: "stylefusion", label: "StyleFusion" },
  { value: "hobbot", label: "HobBot" },
  { value: "business", label: "Business" },
  { value: "research", label: "Research" },
];
---

<BaseLayout title="Blog | HobFarm" description="Articles on AI tools, creative workflows, and the Atomic Noir universe.">
  <section>
    <ContentPanel>
      <Wrapper
        variant="standard"
        class="grid grid-cols-1 py-8 gap-y-8 lg:gap-y-0 lg:grid-cols-4"
      >
        <div class="order-2 lg:order-1">
          <div class="lg:pr-8 lg:sticky lg:top-24 align-self-start">
            <h1 class="text-3xl lg:text-4xl font-light text-base-100 text-balance font-display">
              Blog
            </h1>

            {/* Category tabs */}
            <div class="mt-8 flex flex-wrap gap-2 lg:flex-col">
              {categories.map((cat) => (
                <a
                  href={cat.value === "all" ? "/blog/" : `/blog/category/${cat.value}/`}
                  class:list={[
                    "text-xs font-mono px-3 py-1.5 border transition-colors",
                    cat.value === "all"
                      ? "border-base-100 text-base-100"
                      : "border-base-700 text-base-400 hover:border-base-100 hover:text-base-100",
                  ]}
                >
                  {cat.label}
                </a>
              ))}
            </div>

            <div class="mt-12">
              <h4 class="text-base font-medium text-base-100">All tags</h4>
              <div role="list" class="flex flex-wrap gap-2 mt-4 lg:flex-col">
                {
                  tags.map((tag) => (
                    <a
                      class="text-sm text-base-100 capitalize hover:text-base-400 transition-colors"
                      href={`/blog/tags/${tag}`}
                    >
                      {tag}
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
        <div
          class="order-1 grid grid-cols-1 sm:grid-cols-2 lg:order-2 lg:col-span-3 gap-4 lg:grid-cols-3 content-start"
        >
          {allPosts.map((post) => <ArticleCard post={post} />)}
        </div>
      </Wrapper>
    </ContentPanel>
    <Subscribe />
  </section>
</BaseLayout>
