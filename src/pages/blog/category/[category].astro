---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ArticleCard from "@/components/blog/ArticleCard.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Subscribe from "@/components/blog/Subscribe.astro";
import { getPublishedPosts } from "@/lib/blog";

const categoryLabels: Record<string, string> = {
  technical: "Technical",
  "magazine-time-machine": "Time Machine",
  "cultural-thread": "Cultural Thread",
  grimoire: "Grimoire",
  stylefusion: "StyleFusion",
  hobbot: "HobBot",
  business: "Business",
  research: "Research",
};

const categoryDescriptions: Record<string, string> = {
  technical:
    "Technical notes on HobFarm systems, implementation decisions, infrastructure, and production workflows.",
  "magazine-time-machine":
    "Vintage media, old ads, print culture, and time-capsule commentary from the Magazine Time Machine archive.",
  "cultural-thread":
    "Cultural analysis, media history, strange connections, and visual research threads from the HobFarm lab.",
  grimoire:
    "Posts about Grimoire, the structured knowledge substrate behind HobFarm's agent workflows and visual vocabulary systems.",
  stylefusion:
    "Posts about StyleFusion, structured prompt compilation, reference blending, image pipelines, and provider-portable visual generation.",
  hobbot:
    "Development notes and experiments around HobBot, automated agents, posting systems, and personality-driven workflows.",
  business:
    "Business notes on monetization, creator infrastructure, memberships, storefronts, product strategy, and funding the machine.",
  research:
    "Research notes, references, experiments, and source-mapping for HobFarm's creative technology systems.",
};

export async function getStaticPaths() {
  const categories = [
    "technical",
    "magazine-time-machine",
    "cultural-thread",
    "grimoire",
    "stylefusion",
    "hobbot",
    "business",
    "research",
  ];
  const allPosts = await getPublishedPosts();
  return categories.map((cat) => ({
    params: { category: cat },
    props: {
      posts: allPosts.filter((p) => p.data.category === cat),
    },
  }));
}

const { category } = Astro.params;
const { posts } = Astro.props;
const label = categoryLabels[category!] || category;
const description =
  categoryDescriptions[category!] ||
  `Articles in the ${label} category on HobFarm.`;
---

<BaseLayout
  title={`${label} | Blog | HobFarm`}
  description={description}
>
  <section>
    <ContentPanel>
      <Wrapper
        variant="standard"
        class="grid grid-cols-1 py-12 lg:py-16 gap-y-12 lg:gap-y-24 lg:grid-cols-4"
      >
        <div class="order-2 lg:order-1">
          <div class="lg:pr-8 lg:sticky lg:top-24 align-self-start">
            <a href="/blog/" class="text-sm text-base-500 hover:text-base-100 transition-colors">
              &larr; All posts
            </a>
            <h1 class="mt-4 text-3xl lg:text-4xl font-light text-base-100 text-balance font-display">
              {label}
            </h1>
            <p class="mt-2 text-sm text-base-400">
              {posts.length} {posts.length === 1 ? "post" : "posts"}
            </p>
          </div>
        </div>
        <div
          class="order-1 grid grid-cols-1 sm:grid-cols-2 lg:order-2 lg:col-span-3 gap-y-12 lg:gap-y-24 lg:grid-cols-3"
        >
          {posts.length > 0 ? (
            posts.map((post) => <ArticleCard post={post} />)
          ) : (
            <p class="text-base text-base-500 col-span-3">
              No posts in this category yet.
            </p>
          )}
        </div>
      </Wrapper>
    </ContentPanel>
    <Subscribe />
  </section>
</BaseLayout>
