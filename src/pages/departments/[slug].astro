---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import ArticleCard from "@/components/articles/ArticleCard.astro";
import ComicCard from "@/components/funnies/ComicCard.astro";
import GalleryCard from "@/components/gallery/GalleryCard.astro";
import DropCard from "@/components/shop/DropCard.astro";
import Subscribe from "@/components/articles/Subscribe.astro";
import Text from "@/components/fundations/elements/Text.astro";
import { getCollection } from "astro:content";
import { mediaImageUrl } from "@/lib/gallery";
import {
  departments,
  departmentPath,
  departmentStatus,
  galleryTypeToDepartment,
  resolveDepartment,
} from "@/data/departments";
import { visualSystemPath, visualSystemsForDepartment } from "@/data/visual-systems";
import { getArticleDepartment, getPublishedArticles } from "@/lib/articles";
import { getPublishedComics } from "@/lib/comics";
import { getProductsByDepartment } from "@/lib/products";

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  const visuals = (await getCollection("gallery")).filter((e) => !e.data.draft);
  const comics = await getPublishedComics();

  // Funnies has its own richer comics landing at /departments/funnies.astro.
  return await Promise.all(departments
    .filter((department) => department.slug !== "funnies")
    .map(async (department) => ({
      params: { slug: department.slug },
      props: {
        department,
        // getArticleDepartment already resolves legacy slugs to canonical, so a
        // post filed as `category: technical` lands in workshop-notes here.
        posts: articles.filter((p) => getArticleDepartment(p.data) === department.slug),
        visuals: visuals
          .filter(
            (g) =>
              resolveDepartment(g.data.department ?? galleryTypeToDepartment[g.data.type]) ===
              department.slug,
          )
          .slice(0, 6),
        comics: comics
          .filter((c) => resolveDepartment(c.data.department) === department.slug)
          .slice(0, 6),
        drops: await getProductsByDepartment(department.slug),
        systems: visualSystemsForDepartment(department.slug),
      },
    })));
}

const { department, posts, visuals, comics, drops, systems } = Astro.props;
// Planned (not-yet-launched) department pages still generate as a starting
// point, but stay out of search engines until they have real content.
const noindex = departmentStatus(department) !== "active";
const intro = department.intro ?? [department.blurb];
const metaDescription = department.metaDescription ?? department.blurb;
const workshopNotes = posts.filter((post) => post.data.format === "workshop-note");
const articles = posts.filter((post) => post.data.format !== "workshop-note");
---

<BaseLayout
  title={`${department.label} | HobFarm`}
  description={metaDescription}
  canonical={departmentPath(department.slug)}
  noindex={noindex}
>
  <section>
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-16">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(320px,0.7fr)] lg:items-end">
          <div class="max-w-2xl">
            <a href="/departments/" class="text-sm text-base-500 transition-colors hover:text-base-100">
              &larr; All departments
            </a>
            <div class="mt-5 flex items-center gap-3">
              <span
                class="size-3 shrink-0 rounded-full"
                style={`background-color: ${department.accent}`}
              />
              <Text tag="h1" variant="display2XL" class="font-display text-white text-balance">
                {department.label}
              </Text>
            </div>
            <div class="mt-4 space-y-4">
              {intro.map((paragraph, index) => (
                <Text
                  tag="p"
                  variant={index === 0 ? "textLG" : "textBase"}
                  class={`${index === 0 ? "text-base-400" : "text-base-500"} leading-relaxed text-pretty`}
                >
                  {paragraph}
                </Text>
              ))}
            </div>
            <p class="mt-3 font-mono text-[10px] uppercase tracking-widest text-base-500">
              {posts.length} {posts.length === 1 ? "article" : "articles"}
            </p>
          </div>

          {department.heroImage && (
            <div class="overflow-hidden rounded-lg border border-base-800 bg-base-950">
              <img
                src={department.heroImage}
                alt=""
                class="aspect-[16/10] w-full object-cover"
                loading="eager"
                decoding="async"
              />
            </div>
          )}
        </div>

        {systems.length > 0 && (
          <div class="mt-16 border-t border-base-800 pt-10">
            <div class="mb-6 flex items-end justify-between gap-4">
              <Text tag="h2" variant="displaySM" class="font-display text-white">
                Visual systems
              </Text>
              <a
                href="/visual-systems/"
                class="font-mono text-[10px] uppercase tracking-wider text-base-400 transition-colors hover:text-white"
              >
                Open Showroom &rarr;
              </a>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {systems.map((system) => {
                const poster = system.featuredAssets.poster;
                const posterSrc = poster
                  ? mediaImageUrl(poster.folder, poster.file, { width: 640, quality: 82, fit: "cover" })
                  : null;
                return (
                  <a
                    href={visualSystemPath(system.slug)}
                    class="group flex flex-col overflow-hidden rounded-lg border border-base-800 bg-base-900/50 transition-colors hover:border-accent-500/40"
                  >
                    {posterSrc && (
                      <img
                        src={posterSrc}
                        alt={poster!.alt}
                        loading="lazy"
                        decoding="async"
                        class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                      />
                    )}
                    <div class="flex flex-1 flex-col p-5">
                      <h3 class="font-display text-lg text-white">{system.title}</h3>
                      <p class="mt-3 flex-1 text-sm leading-relaxed text-base-400">
                        {system.shortDescription}
                      </p>
                      <span class="mt-5 font-mono text-[10px] uppercase tracking-wider text-base-400 group-hover:text-white">
                        See the full system &rarr;
                      </span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        )}

        {drops.length > 0 && (
          <div class="mt-16 border-t border-base-800 pt-10">
            <div class="mb-6 flex items-end justify-between gap-4">
              <Text tag="h2" variant="displaySM" class="font-display text-white">
                Drops
              </Text>
              <a
                href="/shop/"
                class="font-mono text-[10px] uppercase tracking-wider text-base-400 transition-colors hover:text-white"
              >
                Open Shop &rarr;
              </a>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {drops.map((product) => <DropCard product={product} />)}
            </div>
          </div>
        )}

        {workshopNotes.length > 0 && (
          <div class="mt-16 border-t border-base-800 pt-10">
            <div class="mb-6 flex items-end justify-between gap-4">
              <Text tag="h2" variant="displaySM" class="font-display text-white">
                Workshop notes
              </Text>
              <a
                href="/workshop/"
                class="font-mono text-[10px] uppercase tracking-wider text-base-400 transition-colors hover:text-white"
              >
                Open Workshop &rarr;
              </a>
            </div>
            <div class="grid grid-cols-1 gap-x-4 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
              {workshopNotes.map((post) => <ArticleCard post={post} />)}
            </div>
          </div>
        )}

        <div class="mt-10 grid grid-cols-1 gap-x-4 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {articles.length > 0 ? (
            articles.map((post) => <ArticleCard post={post} />)
          ) : posts.length === 0 && visuals.length === 0 && comics.length === 0 && drops.length === 0 && systems.length === 0 ? (
            <p class="col-span-full text-base text-base-500">
              No articles in this department yet.
            </p>
          ) : null}
        </div>

        {comics.length > 0 && (
          <div class="mt-16 border-t border-base-800 pt-10">
            <div class="mb-6 flex items-end justify-between gap-4">
              <Text tag="h2" variant="displaySM" class="font-display text-white">
                Comics
              </Text>
              <a
                href="/characters/"
                class="font-mono text-[10px] uppercase tracking-wider text-base-400 transition-colors hover:text-white"
              >
                Open Character Index &rarr;
              </a>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {comics.map((comic) => <ComicCard comic={comic} />)}
            </div>
          </div>
        )}

        {visuals.length > 0 && (
          <div class="mt-16 border-t border-base-800 pt-10">
            <div class="mb-6 flex items-end justify-between gap-4">
              <Text tag="h2" variant="displaySM" class="font-display text-white">
                Visuals
              </Text>
              <a
                href="/gallery/"
                class="font-mono text-[10px] uppercase tracking-wider text-base-400 transition-colors hover:text-white"
              >
                Open Gallery &rarr;
              </a>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {visuals.map((entry) => <GalleryCard entry={entry} />)}
            </div>
          </div>
        )}
      </Wrapper>
    </ContentPanel>
    <Subscribe />
  </section>
</BaseLayout>
