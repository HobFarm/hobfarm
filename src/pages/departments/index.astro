---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import SectionHero from "@/components/sections/SectionHero.astro";
import { articleCategories, presentsSeries, siteSections, workshopPrograms } from "@/data/site-hierarchy";
const articles = siteSections.find((entry) => entry.id === "articles")!;
const presents = siteSections.find((entry) => entry.id === "presents")!;
const workshop = siteSections.find((entry) => entry.id === "workshop")!;
const operations = siteSections.filter((entry) => ["academy","shop","about-support"].includes(entry.id));
---
<BaseLayout title="Departments | HobFarm" description="The complete HobFarm directory: Articles, HobFarm Presents, Workshop programs, Academy, Shop, About, and Support." canonical="/departments/" image={presents.heroImage} imageAlt={presents.heroAlt}>
  <SectionHero eyebrow="Complete site directory" title="Departments" deck="Articles is the full editorial feed. HobFarm Presents holds recurring editorial properties. Workshop holds production programs. Academy, Shop, About, and Support handle the practical work around them." image={presents.heroImage} imageAlt={presents.heroAlt} theme="presents" breadcrumbs={[{label:"Home",href:"/"},{label:"Departments"}]} />

  <section class="directory-block directory-block--articles"><Wrapper variant="standard" class="py-14 lg:py-20"><div class="lead-grid"><div><p class="number">01 / Read everything</p><h2>{articles.name}</h2><p>{articles.description}</p><a href={articles.href}>{articles.ctaLabel} &rarr;</a></div><img src={articles.heroImage} alt={articles.heroAlt} width="1000" height="563" loading="lazy" decoding="async" /></div><div class="category-row">{articleCategories.map((category)=><a href={category.href}><strong>{category.name}</strong><span>{category.description}</span></a>)}</div></Wrapper></section>

  <section class="directory-block"><Wrapper variant="standard" class="py-14 lg:py-20"><header><p class="number">02 / Editorial properties</p><h2>{presents.name}</h2><p>{presents.description}</p><a href={presents.href}>View all Presents &rarr;</a></header><div class="nested-grid">{presentsSeries.map((entry)=><a href={entry.href} style={`--accent:${entry.theme === "broadcast" ? "#19e3e3" : entry.theme === "magazine" ? "#f0c96b" : entry.theme === "comics" ? "#2fe089" : "#a06bff"}`}><div>{entry.heroImage && <img src={entry.heroImage} alt="" width="700" height="394" loading="lazy" decoding="async" />}</div><span>{entry.status === "coming-eventually" ? "Coming eventually" : "Presents series"}</span><strong>{entry.name}</strong><p>{entry.description}</p></a>)}</div></Wrapper></section>

  <section class="directory-block directory-block--workshop"><Wrapper variant="standard" class="py-14 lg:py-20"><header><p class="number">03 / Production programs</p><h2>{workshop.name}</h2><p>{workshop.description}</p><a href={workshop.href}>View all Workshop &rarr;</a></header><div class="nested-grid">{workshopPrograms.map((entry)=><a href={entry.href} style="--accent:#19e3e3"><div>{entry.heroImage && <img src={entry.heroImage} alt="" width="700" height="394" loading="lazy" decoding="async" />}</div><span>Workshop program</span><strong>{entry.name}</strong><p>{entry.description}</p></a>)}</div></Wrapper></section>

  <section class="directory-block"><Wrapper variant="standard" class="py-14 lg:py-20"><header><p class="number">04–06 / Learn, buy, and take part</p><h2>The operational side</h2><p>These sections support the publication without competing with its editorial hierarchy.</p></header><div class="operations">{operations.map((entry)=><a href={entry.href}><strong>{entry.name}</strong><p>{entry.description}</p><span>{entry.ctaLabel} &rarr;</span></a>)}<a href="/support/"><strong>Support</strong><p>Billing, downloads, course access, refunds, and technical help.</p><span>Get support &rarr;</span></a></div></Wrapper></section>
</BaseLayout>
<style>
  .directory-block{border-bottom:1px solid #2c2440;background:#07060b}.directory-block--articles{background:#090d12}.directory-block--workshop{background:#080d10}header{max-width:54rem}.number{margin:0;color:#19e3e3;font-family:var(--font-mono);font-size:.66rem;letter-spacing:.18em;text-transform:uppercase}h2{margin:.7rem 0 0;color:white;font-family:var(--font-display);font-size:clamp(2.6rem,6vw,5rem);font-weight:300;letter-spacing:-.05em;line-height:.95}header>p:not(.number),.lead-grid>div>p:not(.number){max-width:46rem;margin:1.2rem 0 0;color:#9b96ad;line-height:1.7}header>a,.lead-grid a{display:inline-block;margin-top:1.3rem;color:#ece9f5}.lead-grid{display:grid;gap:2rem;align-items:center}.lead-grid img{width:100%;max-height:30rem;object-fit:cover;border:1px solid #2c2440}.category-row{display:grid;gap:1rem;margin-top:2rem}.category-row a,.operations a{padding:1.25rem;border:1px solid #2c2440;background:#0e0b16;text-decoration:none}.category-row strong,.category-row span{display:block}.category-row strong,.operations strong{color:white;font-size:1.15rem}.category-row span,.operations p{margin:.55rem 0 0;color:#9b96ad;line-height:1.5}.nested-grid{display:grid;gap:1rem;margin-top:2.5rem}.nested-grid>a{display:flex;min-height:23rem;flex-direction:column;padding:1rem;border:1px solid #2c2440;background:#0e0b16;text-decoration:none}.nested-grid>a:hover{border-color:var(--accent)}.nested-grid div{height:10rem;margin:-1rem -1rem 1rem;overflow:hidden;background:#15101f}.nested-grid img{width:100%;height:100%;object-fit:cover;opacity:.72}.nested-grid span{color:var(--accent);font-family:var(--font-mono);font-size:.58rem;letter-spacing:.12em;text-transform:uppercase}.nested-grid strong{margin-top:.65rem;color:white;font-family:var(--font-display);font-size:1.5rem;font-weight:450}.nested-grid p{margin:.7rem 0 0;color:#9b96ad;font-size:.86rem;line-height:1.55}.operations{display:grid;gap:1rem;margin-top:2rem}.operations span{display:block;margin-top:1.2rem;color:#ece9f5;font-family:var(--font-mono);font-size:.65rem;text-transform:uppercase}@media(min-width:760px){.lead-grid{grid-template-columns:minmax(0,.75fr) minmax(0,1fr)}.nested-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.operations{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(min-width:1100px){.nested-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.operations{grid-template-columns:repeat(4,minmax(0,1fr))}}
</style>
