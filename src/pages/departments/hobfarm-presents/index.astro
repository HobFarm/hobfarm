---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import AdventureCard from "@/components/presents/AdventureCard.astro";
import PulpPressHero from "@/components/presents/PulpPressHero.astro";
import SupportWays from "@/components/support/SupportWays.astro";
import Subscribe from "@/components/articles/Subscribe.astro";
import ArticleCard from "@/components/articles/ArticleCard.astro";
import PresentsTitleCard from "@/components/presents/PresentsTitleCard.astro";
import { getDepartment, departmentPath } from "@/data/departments";
import { getActivePresentsTitles } from "@/data/presents-titles";
import { storySeries, storySeriesPath } from "@/data/story-series";
import { characterPath } from "@/data/characters";
import { adventurePath, getPublishedAdventures } from "@/lib/adventures";
import { getPublishedArticles } from "@/lib/articles";
import { OTHER_ALICE_WORLD_GUIDE_PATH } from "@/data/other-alice-world-guide";

const department = getDepartment("hobfarm-presents")!;
const presentsTitles = getActivePresentsTitles();
const seriesSorted = [...storySeries].sort(
  (a, b) => (a.displayOrder ?? 999) - (b.displayOrder ?? 999),
);
const featuredSeries = seriesSorted[0];
const allAdventures = await getPublishedAdventures();
const seriesAdventures = featuredSeries
  ? allAdventures.filter((adventure) => adventure.data.series === featuredSeries.slug)
  : [];
const latestAdventure = seriesAdventures[0];
const previousAdventures = seriesAdventures.slice(1);
const otherSeries = seriesSorted.slice(1).filter((series) => series.status !== "complete");
const knownSeries = new Set(storySeries.map((series) => series.slug));
const standaloneTales = allAdventures.filter((adventure) => !knownSeries.has(adventure.data.series));
const allArticles = await getPublishedArticles();
const companionArticles = featuredSeries
  ? allArticles.filter((article) => article.data.tags.includes(featuredSeries.slug)).slice(0, 4)
  : [];
const atlasConcepts = featuredSeries?.worldAtlas?.concepts ?? [];
const featuredResident = featuredSeries?.residents?.entries[0];
const heroCover = featuredSeries?.cover ?? department.heroImage!;
const heroAlt = featuredSeries?.coverAlt ?? featuredSeries?.title ?? "HobFarm Presents cover";
const primaryHref = latestAdventure
  ? adventurePath(latestAdventure)
  : featuredSeries
    ? storySeriesPath(featuredSeries.slug)
    : departmentPath(department.slug);
const primaryLabel = latestAdventure
  ? `Read ${latestAdventure.data.title}`
  : "Enter the current serial";
---

<BaseLayout
  title="HobFarm Presents: Recurring Stories, Film History, and Media Series"
  description="HobFarm Presents is the series imprint for recurring story worlds, film-history projects, illustrated fiction, video essays, character files, and moving scenes."
  canonical={departmentPath(department.slug)}
  image={heroCover}
  imageAlt={heroAlt}
  feed={{ href: "/departments/hobfarm-presents/rss.xml", title: "HobFarm Presents" }}
>
  <section class="presents-press">
    <ContentPanel>
      <Wrapper variant="standard" class="py-6 sm:py-10 lg:py-14">
        <PulpPressHero
          mastheadImage={department.heroImage!}
          cover={heroCover}
          coverAlt={heroAlt}
          title="HobFarm Presents"
          deck="Recurring story worlds, film-history projects, short fiction, video essays, character files, moving scenes, and other things built to continue. Each title gets its own archive, visual language, release feed, and media system."
          issueLabel="HobFarm's series imprint"
          primaryHref={primaryHref}
          primaryLabel={primaryLabel}
          secondaryHref="#titles"
          secondaryLabel="Browse every title"
          contents="Illustrated fiction · film history · video essays · character files"
          coverLabel="Current fiction title"
          coverFit="contain"
        />

        <nav class="press-index" aria-label="HobFarm Presents sections">
          <a href="#titles"><span>01</span> Title index</a>
          <a href="#current-serial"><span>02</span> Current serial</a>
          <a href="#adventure-file"><span>03</span> Adventure file</a>
          <a href="#world-atlas"><span>04</span> World atlas</a>
          <a href="#support-the-press"><span>05</span> Support the press</a>
        </nav>

        <section id="titles" class="press-section" data-reveal>
          <header class="press-heading">
            <p>01 / Title index</p>
            <h2>Series built to keep going</h2>
            <span>Some are fiction. Some are film history. All of them grow beyond a single post.</span>
          </header>
          <div class="title-index">
            {presentsTitles.map((title) => <PresentsTitleCard title={title} />)}
          </div>
        </section>

        {featuredSeries && (
          <section id="current-serial" class="press-section press-section--feature" data-reveal>
            <header class="press-heading">
              <p>02 / Current serial · Illustrated Fiction</p>
              <h2>{featuredSeries.title}</h2>
              <span>{featuredSeries.tagline}</span>
            </header>

            <div class="serial-feature">
              <div class="serial-feature__copy">
                <p class="serial-feature__lead">{featuredSeries.logline}</p>
                {(featuredSeries.heroIntro ?? []).slice(0, 2).map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                <div class="press-actions">
                  <a class="press-button press-button--bright" href={storySeriesPath(featuredSeries.slug)}>Enter the series</a>
                  {featuredSeries.slug === "other-alice-adventures" && (
                    <a class="press-button" href={OTHER_ALICE_WORLD_GUIDE_PATH}>Open the World Guide</a>
                  )}
                  <a class="press-button" href={characterPath("alice")}>Meet Other Alice</a>
                </div>
              </div>

              <aside class="press-facts" aria-label={`${featuredSeries.title} reading guide`}>
                <p class="press-facts__label">Reader's field card</p>
                <dl>
                  <div><dt>Format</dt><dd>Illustrated serial</dd></div>
                  <div><dt>Terrain</dt><dd>Wonderland / Wasteland</dd></div>
                  <div><dt>Start</dt><dd>{latestAdventure?.data.title ?? "Series guide"}</dd></div>
                  <div><dt>Media</dt><dd>Fiction, maps, portraits, motion</dd></div>
                </dl>
              </aside>
            </div>
          </section>
        )}

        <section id="adventure-file" class="press-section" data-reveal>
          <header class="press-heading press-heading--row">
            <div>
              <p>03 / Adventure file</p>
              <h2>Open the latest tunnel</h2>
            </div>
            {featuredSeries && <a href={storySeriesPath(featuredSeries.slug)}>View the complete archive &rarr;</a>}
          </header>

          {latestAdventure ? (
            <div class="adventure-lead">
              <a href={adventurePath(latestAdventure)} class="adventure-lead__image">
                <img
                  src={latestAdventure.data.heroMedia?.file ?? latestAdventure.data.cover}
                  alt={latestAdventure.data.heroMedia?.alt ?? latestAdventure.data.coverAlt ?? latestAdventure.data.title}
                  width="1400"
                  height="900"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="adventure-lead__copy">
                <p class="press-stamp">Adventure No. {String(latestAdventure.data.number).padStart(2, "0")}</p>
                <h3>{latestAdventure.data.title}</h3>
                <p>{latestAdventure.data.teaser}</p>
                <a href={adventurePath(latestAdventure)}>Read the adventure &rarr;</a>
              </div>
            </div>
          ) : (
            <p class="press-empty">The next illustrated Adventure is in editorial review.</p>
          )}

          {previousAdventures.length > 0 && (
            <div class="cover-rail" aria-label="Previous adventures">
              {previousAdventures.map((adventure) => <AdventureCard adventure={adventure} />)}
            </div>
          )}
        </section>

        {atlasConcepts.length > 0 && (
          <section id="world-atlas" class="press-section" data-reveal>
            <header class="press-heading press-heading--row">
              <div>
                <p>04 / Illustrated atlas</p>
                <h2>The world below has an edge</h2>
              </div>
              <a href={`${storySeriesPath(featuredSeries!.slug)}#world-atlas`}>Open the full atlas &rarr;</a>
            </header>

            <div class="atlas-strip">
              {atlasConcepts.slice(0, 4).map((concept, index) => (
                <a href={`${storySeriesPath(featuredSeries!.slug)}#${concept.id}`} class:list={["atlas-card", index === 0 && "atlas-card--wide"]}>
                  <img src={concept.image} alt={concept.imageAlt} width={concept.width} height={concept.height} loading="lazy" decoding="async" />
                  <span><small>{concept.realm}</small>{concept.title}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {featuredResident && (
          <section id="character-file" class="press-section character-file" data-reveal>
            <div class="character-file__portrait">
              <img src={featuredResident.image} alt={featuredResident.imageAlt} width="1024" height="1536" loading="lazy" decoding="async" />
            </div>
            <div class="character-file__copy">
              <p class="press-stamp">Character file</p>
              <h2>{featuredResident.name}</h2>
              <p class="character-file__role">{featuredResident.role}</p>
              {featuredResident.summary.slice(0, 2).map((paragraph) => <p>{paragraph}</p>)}
              <a href={featuredResident.href ?? characterPath("alice")}>Open the complete character guide &rarr;</a>
            </div>
          </section>
        )}

        {(standaloneTales.length > 0 || otherSeries.length > 0) && (
          <section class="press-section" data-reveal>
            <header class="press-heading">
              <p>Elsewhere in the press</p>
              <h2>More worlds and standalone tales</h2>
            </header>
            <div class="press-link-grid">
              {otherSeries.map((series) => (
                <a href={storySeriesPath(series.slug)}><span>{series.title}</span><small>{series.tagline}</small></a>
              ))}
              {standaloneTales.map((adventure) => (
                <a href={adventurePath(adventure)}><span>{adventure.data.title}</span><small>{adventure.data.teaser}</small></a>
              ))}
            </div>
          </section>
        )}

        {companionArticles.length > 0 && (
          <section class="press-section" data-reveal>
            <header class="press-heading">
              <p>From the magazine</p>
              <h2>Companion reading</h2>
            </header>
            <div class="article-grid">
              {companionArticles.map((post) => <ArticleCard post={post} />)}
            </div>
          </section>
        )}

        <section class="press-section press-shop" data-reveal>
          <div>
            <p class="press-stamp">Covers, characters, and objects</p>
            <h2>Take part of the world with you</h2>
            <p>HobFarm stories can continue as prints, character packs, small editions, physical objects, and behind-the-scenes learning material.</p>
          </div>
          <div class="press-actions">
            <a class="press-button press-button--bright" href="/shop/">Visit the shop</a>
            <a class="press-button" href="/academy/">Explore the Academy</a>
          </div>
        </section>

        <div id="support-the-press" class="press-section" data-reveal>
          <SupportWays
            heading="Keep the press running"
            description="Join through HobFarm, leave one-time support or request a commission on Ko-fi, or use Patreon as a separate community membership."
          />
        </div>
      </Wrapper>
    </ContentPanel>

    <Subscribe
      heading="Join the HobFarm Club"
      description="Get the weekly issue: new fiction, visual releases, character files, shop drops, and workshop notes."
    />
  </section>

  <script>
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const reveals = document.querySelectorAll<HTMLElement>("[data-reveal]");

    if (reducedMotion || !("IntersectionObserver" in window)) {
      reveals.forEach((element) => element.dataset.visible = "true");
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            (entry.target as HTMLElement).dataset.visible = "true";
            observer.unobserve(entry.target);
          });
        },
        { rootMargin: "0px 0px -10%", threshold: 0.08 },
      );
      reveals.forEach((element) => observer.observe(element));
    }
  </script>
</BaseLayout>

<style>
  .presents-press {
    --press-paper: #f5f0df;
    --press-ink: #100b18;
    --press-gold: #f0c96b;
    --press-cyan: #5cf0f0;
    background: #07060b;
  }

  .press-index {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 1rem;
    border: 1px solid #2c2440;
    background: #0e0b16;
  }

  .press-index a {
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    gap: 0.65rem;
    padding: 0.7rem 0.85rem;
    border-right: 1px solid #2c2440;
    color: #c8c6d4;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .press-index a:last-child { border-right: 0; }
  .press-index a:hover, .press-index a:focus-visible { color: #fff; background: #15101f; }
  .press-index span { color: var(--press-gold); }

  .press-section {
    margin-top: clamp(3.5rem, 8vw, 7rem);
    scroll-margin-top: 7rem;
  }

  .title-index { display: grid; gap: 1rem; margin-top: 1.5rem; }

  [data-reveal] {
    opacity: 0;
    transform: translateY(1.2rem);
    transition: opacity 500ms ease, transform 650ms cubic-bezier(.2,.8,.2,1);
  }
  [data-reveal][data-visible="true"] { opacity: 1; transform: none; }

  .press-heading {
    padding-bottom: 1.15rem;
    border-bottom: 4px solid var(--press-gold);
  }

  .press-heading--row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .press-heading p, .press-stamp {
    margin: 0;
    color: var(--press-gold);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .press-heading h2, .press-shop h2, .character-file h2 {
    margin: 0.55rem 0 0;
    color: var(--press-paper);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4.6rem);
    font-weight: 790;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .press-heading > span { display: block; margin-top: 0.75rem; color: #9b96ad; font-style: italic; }
  .press-heading a, .character-file a, .adventure-lead__copy > a {
    color: #ece9f5;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .press-heading a:hover, .character-file a:hover, .adventure-lead__copy > a:hover { color: var(--press-gold); }

  .serial-feature {
    display: grid;
    gap: 1rem;
    margin-top: 1.4rem;
  }

  .serial-feature__copy, .press-facts {
    padding: clamp(1.4rem, 4vw, 3rem);
    border: 1px solid #2c2440;
    background: #0e0b16;
  }

  .serial-feature__copy > p { max-width: 48rem; margin: 1rem 0 0; color: #9b96ad; line-height: 1.7; }
  .serial-feature__copy .serial-feature__lead { margin-top: 0; color: #ece9f5; font-size: 1.18rem; }
  .press-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.6rem; }
  .press-button { display: inline-flex; align-items: center; min-height: 2.8rem; padding: 0.7rem 0.95rem; border: 1px solid #6b6580; color: #ece9f5; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; text-decoration: none; text-transform: uppercase; }
  .press-button:hover, .press-button:focus-visible { border-color: #ece9f5; }
  .press-button--bright { border-color: var(--press-gold); background: var(--press-gold); color: var(--press-ink); }
  .press-button--bright:hover, .press-button--bright:focus-visible { background: #fff2b5; color: var(--press-ink); }

  .press-facts__label { margin: 0; color: var(--press-cyan); font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; }
  .press-facts dl { margin: 1rem 0 0; }
  .press-facts dl div { display: grid; grid-template-columns: 5.8rem 1fr; gap: 1rem; padding: 0.85rem 0; border-top: 1px solid #2c2440; }
  .press-facts dt { color: #6b6580; font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .press-facts dd { margin: 0; color: #d8d4e4; font-size: 0.86rem; }

  .adventure-lead { display: grid; overflow: hidden; margin-top: 1.5rem; border: 1px solid #2c2440; background: #0e0b16; }
  .adventure-lead__image { min-height: 22rem; overflow: hidden; background: #07060b; }
  .adventure-lead__image img { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms cubic-bezier(.2,.8,.2,1); }
  .adventure-lead__image:hover img { transform: scale(1.025); }
  .adventure-lead__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(1.5rem, 5vw, 4rem); }
  .adventure-lead__copy h3 { margin: 0.75rem 0 0; color: var(--press-paper); font-family: var(--font-display); font-size: clamp(2rem, 4vw, 4rem); letter-spacing: -0.05em; line-height: 0.95; }
  .adventure-lead__copy p:not(.press-stamp) { margin: 1.2rem 0 1.8rem; color: #b5b0c2; line-height: 1.7; }
  .cover-rail { display: grid; grid-auto-columns: minmax(16rem, 22rem); grid-auto-flow: column; gap: 1rem; margin-top: 1rem; overflow-x: auto; padding: 0 0 1rem; scroll-snap-type: x proximity; }
  .cover-rail > * { scroll-snap-align: start; }
  .press-empty { margin: 1.5rem 0 0; padding: 2rem; border: 1px dashed #433559; color: #9b96ad; }

  .atlas-strip { display: grid; gap: 1rem; margin-top: 1.5rem; }
  .atlas-card { position: relative; display: block; min-height: 21rem; overflow: hidden; border: 1px solid #2c2440; background: #0e0b16; }
  .atlas-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms cubic-bezier(.2,.8,.2,1); }
  .atlas-card:hover img { transform: scale(1.025); }
  .atlas-card > span { position: absolute; right: 0.75rem; bottom: 0.75rem; left: 0.75rem; padding: 0.8rem; background: rgb(7 6 11 / 90%); color: #ece9f5; font-family: var(--font-display); font-size: 1.05rem; }
  .atlas-card small { display: block; margin-bottom: 0.25rem; color: var(--press-gold); font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; }

  .character-file { display: grid; overflow: hidden; border: 1px solid #433559; background: #0e0b16; }
  .character-file__portrait { min-height: 34rem; background: #07060b; }
  .character-file__portrait img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .character-file__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(1.5rem, 5vw, 4rem); }
  .character-file__role { margin: 0.7rem 0 1.2rem !important; color: var(--press-cyan) !important; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .character-file__copy > p:not(.press-stamp) { margin: 0.85rem 0 0; color: #b5b0c2; line-height: 1.7; }
  .character-file__copy > a { margin-top: 1.8rem; }

  .press-link-grid, .article-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .press-link-grid a { display: flex; min-height: 9rem; flex-direction: column; justify-content: space-between; padding: 1.25rem; border: 1px solid #2c2440; background: #0e0b16; text-decoration: none; }
  .press-link-grid span { color: #ece9f5; font-family: var(--font-display); font-size: 1.35rem; }
  .press-link-grid small { color: #9b96ad; line-height: 1.5; }
  .press-link-grid a:hover { border-color: var(--press-gold); }

  .press-shop { display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding: clamp(1.5rem, 5vw, 4rem); border: 1px solid #433559; border-left: 6px solid var(--press-gold); background: #15101f; }
  .press-shop > div:first-child { max-width: 46rem; }
  .press-shop > div:first-child > p:last-child { margin: 1.2rem 0 0; color: #b5b0c2; line-height: 1.7; }

  @media (min-width: 860px) {
    .title-index { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .serial-feature { grid-template-columns: minmax(0, 1.5fr) minmax(17rem, 0.5fr); }
    .adventure-lead { grid-template-columns: minmax(0, 1.25fr) minmax(20rem, 0.75fr); }
    .atlas-strip { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .atlas-card--wide { grid-column: span 2; }
    .character-file { grid-template-columns: minmax(22rem, 0.82fr) minmax(0, 1.18fr); }
  }

  @media (max-width: 900px) {
    .press-index { grid-template-columns: 1fr 1fr; }
    .press-index a { border-bottom: 1px solid #2c2440; }
    .press-shop { align-items: start; flex-direction: column; }
  }

  @media (max-width: 620px) {
    .press-index { grid-template-columns: 1fr; }
    .press-index a { border-right: 0; }
    .press-heading--row { align-items: start; flex-direction: column; }
    .article-grid, .press-link-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1; transform: none; transition: none; }
    .adventure-lead__image img, .atlas-card img { transition: none; }
    .adventure-lead__image:hover img, .atlas-card:hover img { transform: none; }
  }
</style>
