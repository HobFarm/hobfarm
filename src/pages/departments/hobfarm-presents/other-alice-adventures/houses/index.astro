---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import OaaProjectNav from "@/components/presents/other-alice/OaaProjectNav.astro";
import {
  OTHER_ALICE_HOUSES_PATH,
  OTHER_ALICE_WEB_PATH,
  courtDossiers,
  failureCascades,
  getOtherAliceResident,
  otherAliceCanon,
  politicalMapViews,
  regionPowerRecords,
} from "@/data/other-alice-world-guide";

const atlasImage = "https://cdn.hob.farm/pages/other-alice-adventures/oaa-wonderland-wasteland-aerial.png";
const atlasAlt = "Aerial atlas plate of circular Wonderland, its central city, ecological belts, boundary mountains, and exterior desert.";
const queen = getOtherAliceResident("queen-of-hearts");
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Who rules Wonderland? The Houses of Other Alice Adventures",
  description: `${otherAliceCanon.politicalRule} ${otherAliceCanon.politicalLine}`,
  url: new URL(OTHER_ALICE_HOUSES_PATH, Astro.site?.origin ?? "https://hob.farm").toString(),
  image: atlasImage,
  isPartOf: {
    "@type": "CreativeWorkSeries",
    name: "Other Alice Adventures",
    url: "https://hob.farm/departments/hobfarm-presents/other-alice-adventures/",
  },
};
---

<BaseLayout
  title="Who Rules Wonderland? The Houses of Other Alice Adventures"
  description="Compare Heart legal sovereignty with Diamond circulation, Spade continuity, and Club reach across the lived map of Wonderland."
  canonical={OTHER_ALICE_HOUSES_PATH}
  image={atlasImage}
  imageAlt={atlasAlt}
  structuredData={structuredData}
>
  <section class="political-page">
    <ContentPanel>
      <Wrapper variant="standard" class="py-8 lg:py-14">
        <OaaProjectNav current="houses" />

        <header class="political-hero">
          <div>
            <p class="political-kicker">The Houses of Wonderland</p>
            <h1>Who rules Wonderland?</h1>
            <blockquote>{otherAliceCanon.politicalLine}</blockquote>
            <p>The Queen's court recognizes one realm, one sovereign, and one legal map. Daily power follows markets, water, labor, roads, and the ability to survive far from the center.</p>
            <div class="political-actions">
              <a href="#political-map">Compare the maps</a>
              <a href="#house-records">Open a House record</a>
            </div>
          </div>
          <figure>
            <img src={atlasImage} alt={atlasAlt} width="1254" height="1254" decoding="async" fetchpriority="high" />
            <figcaption>Official geography / political interpretation changes with the record layer.</figcaption>
          </figure>
        </header>

        <section id="political-map" class="political-section" aria-labelledby="political-map-heading">
          <header class="political-heading">
            <p>Paired realm plate</p>
            <h2 id="political-map-heading">One geography. Three political records.</h2>
            <span>The image stays fixed. The institution reading it changes.</span>
          </header>

          <div class="map-switcher">
            <div class="map-switcher__controls" role="tablist" aria-label="Political map view">
              {politicalMapViews.map((view, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`map-tab-${view.id}`}
                  aria-controls={`map-panel-${view.id}`}
                  aria-selected={index === 0 ? "true" : "false"}
                  tabindex={index === 0 ? 0 : -1}
                  data-map-tab={view.id}
                >
                  <span>{String(index + 1).padStart(2, "0")}</span>{view.label}
                </button>
              ))}
            </div>

            <div class="map-switcher__plate">
              <figure>
                <img src={atlasImage} alt={atlasAlt} width="1254" height="1254" loading="lazy" decoding="async" />
                <figcaption data-map-caption>{politicalMapViews[0].title}</figcaption>
              </figure>
              <div class="map-switcher__record">
                {politicalMapViews.map((view, index) => (
                  <article
                    id={`map-panel-${view.id}`}
                    role="tabpanel"
                    aria-labelledby={`map-tab-${view.id}`}
                    data-map-panel={view.id}
                    hidden={index !== 0}
                  >
                    <p class="political-kicker">{view.label}</p>
                    <h3>{view.title}</h3>
                    <p>{view.description}</p>
                    <h4>This record shows</h4>
                    <ul>{view.shows.map((item) => <li>{item}</li>)}</ul>
                  </article>
                ))}
              </div>
            </div>
          </div>

          <p class="map-note"><strong>Court copy.</strong> Regional corrections unauthorized and mostly accurate.</p>
        </section>

        <section id="regional-ledger" class="political-section" aria-labelledby="regional-ledger-heading">
          <header class="political-heading">
            <p>Regional ledger</p>
            <h2 id="regional-ledger-heading">Where the claim weakens and the work takes over.</h2>
          </header>
          <div class="regional-ledger">
            {regionPowerRecords.map((record) => (
              <article id={record.id}>
                <header><h3>{record.region}</h3><span>{record.actualPower}</span></header>
                <dl>
                  <div><dt>Heart claim</dt><dd>{record.heartClaim}</dd></div>
                  <div><dt>Power basis</dt><dd>{record.powerBasis.join(", ")}</dd></div>
                  <div><dt>Dependencies</dt><dd>{record.dependencies.join(", ")}</dd></div>
                  <div><dt>Leverage</dt><dd>{record.leverage.join(", ")}</dd></div>
                  <div><dt>What keeps it inside</dt><dd>{record.insideSystem}</dd></div>
                </dl>
                <p><strong>File opened:</strong> {record.activeDispute}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="house-records" class="political-section" aria-labelledby="house-records-heading">
          <header class="political-heading">
            <p>Four House folios</p>
            <h2 id="house-records-heading">Four forms of power hold one realm together.</h2>
          </header>
          <div class="house-folios">
            {courtDossiers.map((house, index) => (
              <article id={house.id} style={`--house-accent:${house.accent}`}>
                <div class="house-folio__stamp">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{house.sigil}</strong>
                  <p>{house.ink}</p>
                </div>
                <div class="house-folio__copy">
                  <p class="political-kicker">Power form / {house.powerForm}</p>
                  <h3>{house.name}</h3>
                  <span>{house.formalStatus}</span>
                  {house.summary.map((paragraph) => <p>{paragraph}</p>)}
                  <dl>
                    <div><dt>Actual power base</dt><dd>{house.materialControl}</dd></div>
                    <div><dt>They need</dt><dd>{house.needs}</dd></div>
                    <div><dt>They can withhold</dt><dd>{house.canWithhold}</dd></div>
                    <div><dt>Failure test</dt><dd>{house.failureTest}</dd></div>
                  </dl>
                  <aside><b>Evidence object</b><span>{house.evidenceObject}</span></aside>
                </div>
              </article>
            ))}
          </div>
        </section>

        {queen && (
          <section class="political-section queen-government" aria-labelledby="queen-government-heading">
            <figure>
              <img src={queen.image} alt={queen.imageAlt} width="1024" height="1536" loading="lazy" decoding="async" />
              <figcaption>Institutional portrait / sovereignty at the center</figcaption>
            </figure>
            <div>
              <p class="political-kicker">The Queen's actual government</p>
              <h2 id="queen-government-heading">Recognition turns regional power into one official Wonderland.</h2>
              <p>The Queen does not need to stand on every road or own every harvest directly. She needs deeds, contracts, taxes, succession, and ceremonial recognition to pass through the center.</p>
              <p>A Diamond contract backed by Heart law travels farther. A Spade settlement with court recognition can demand resources. A Club commander with a charter can call a toll lawful instead of merely armed.</p>
              <blockquote>Her skill is keeping the Houses dependent enough that none can leave cleanly. Her danger is mistaking a system everyone uses for a system she controls alone.</blockquote>
            </div>
          </section>
        )}

        <section id="dependency-loop" class="political-section" aria-labelledby="failure-heading">
          <header class="political-heading">
            <p>Failure cascade</p>
            <h2 id="failure-heading">What happens when a House stops?</h2>
            <span>The system breaks in different places depending on which form of power is withdrawn.</span>
          </header>
          <div class="failure-cascade">
            <div class="failure-cascade__controls" role="group" aria-label="Select a House failure">
              {failureCascades.map((cascade, index) => (
                <button
                  type="button"
                  data-failure-button={cascade.id}
                  aria-pressed={index === 0 ? "true" : "false"}
                  style={`--house-accent:${cascade.accent}`}
                >
                  {cascade.label}
                </button>
              ))}
            </div>
            <div class="failure-cascade__result" aria-live="polite">
              {failureCascades.map((cascade, index) => (
                <article data-failure-panel={cascade.id} hidden={index !== 0} style={`--house-accent:${cascade.accent}`}>
                  <p class="political-kicker">System consequence</p>
                  <h3>{cascade.label}</h3>
                  <p>{cascade.result}</p>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="political-section evidence-orchard" aria-labelledby="evidence-orchard-heading">
          <header class="political-heading">
            <p>One orchard / four records</p>
            <h2 id="evidence-orchard-heading">The political system fits inside a harvest.</h2>
          </header>
          <ol>
            {courtDossiers.map((house) => (
              <li style={`--house-accent:${house.accent}`}>
                <span>{house.sigil}</span>
                <div><h3>{house.name}</h3><p>{house.evidenceObject}</p></div>
              </li>
            ))}
          </ol>
        </section>

        <section class="political-section disputes" aria-labelledby="disputes-heading">
          <header class="political-heading">
            <p>Active disputes</p>
            <h2 id="disputes-heading">The civics lesson ends where the stories start.</h2>
          </header>
          <ul>
            {regionPowerRecords.map((record) => <li><span>File opened</span><strong>{record.region}</strong><p>{record.activeDispute}</p></li>)}
          </ul>
          <a href={`${OTHER_ALICE_WEB_PATH}?layer=political`}>Open the political relationship web &rarr;</a>
        </section>
      </Wrapper>
    </ContentPanel>

    <script>
      const mapTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-map-tab]"));
      const mapPanels = Array.from(document.querySelectorAll<HTMLElement>("[data-map-panel]"));
      const mapCaption = document.querySelector<HTMLElement>("[data-map-caption]");

      const selectMapView = (button: HTMLButtonElement) => {
        const id = button.dataset.mapTab;
        mapTabs.forEach((tab) => {
          const selected = tab === button;
          tab.setAttribute("aria-selected", String(selected));
          tab.tabIndex = selected ? 0 : -1;
        });
        mapPanels.forEach((panel) => {
          panel.hidden = panel.dataset.mapPanel !== id;
        });
        const activePanel = mapPanels.find((panel) => panel.dataset.mapPanel === id);
        const title = activePanel?.querySelector("h3")?.textContent;
        if (mapCaption && title) mapCaption.textContent = title;
      };

      mapTabs.forEach((button, index) => {
        button.addEventListener("click", () => selectMapView(button));
        button.addEventListener("keydown", (event) => {
          if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
          event.preventDefault();
          const nextIndex = event.key === "Home" ? 0 : event.key === "End" ? mapTabs.length - 1 : event.key === "ArrowRight" ? (index + 1) % mapTabs.length : (index - 1 + mapTabs.length) % mapTabs.length;
          mapTabs[nextIndex].focus();
          selectMapView(mapTabs[nextIndex]);
        });
      });

      const failureButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-failure-button]"));
      const failurePanels = Array.from(document.querySelectorAll<HTMLElement>("[data-failure-panel]"));
      failureButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const id = button.dataset.failureButton;
          failureButtons.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button)));
          failurePanels.forEach((panel) => { panel.hidden = panel.dataset.failurePanel !== id; });
        });
      });
    </script>
  </section>
</BaseLayout>

<style>
  .political-page { background: #07060a; }
  .political-kicker, .political-heading > p { margin: 0; color: #d4b861; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .16em; text-transform: uppercase; }
  .political-hero { display: grid; margin-top: .75rem; overflow: hidden; border: 1px solid #4b343a; background: #140b10; }
  .political-hero > div { display: flex; flex-direction: column; justify-content: center; padding: clamp(1.5rem, 5vw, 4.5rem); }
  .political-hero h1 { max-width: 9ch; margin: .75rem 0 0; color: #f5f0df; font-family: var(--font-display); font-size: clamp(3.2rem, 6.4vw, 6.2rem); font-weight: 820; letter-spacing: -.075em; line-height: .84; }
  .political-hero blockquote { margin: 1.5rem 0 0; padding-left: 1rem; border-left: 5px solid #e23a4e; color: #fff1d6; font-family: var(--font-display); font-size: clamp(1.25rem, 2.4vw, 2rem); line-height: 1.25; }
  .political-hero > div > p:not(.political-kicker) { max-width: 40rem; margin: 1.25rem 0 0; color: #c2b8c1; line-height: 1.7; }
  .political-actions { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.6rem; }
  .political-actions a { padding: .75rem .9rem; border: 1px solid #d4b861; color: #f5f0df; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
  .political-actions a:first-child { background: #d4b861; color: #140b10; }
  .political-actions a:hover, .political-actions a:focus-visible { background: #f5f0df; color: #140b10; outline: none; }
  .political-hero figure, .map-switcher figure, .queen-government figure { position: relative; min-height: 32rem; margin: 0; background: #040305; }
  .political-hero figure img, .map-switcher figure img, .queen-government figure img { width: 100%; height: 100%; object-fit: cover; }
  .political-hero figcaption, .map-switcher figcaption, .queen-government figcaption { position: absolute; right: .75rem; bottom: .75rem; left: .75rem; padding: .65rem .75rem; background: rgb(7 6 10 / 90%); color: #d4b861; font-family: var(--font-mono); font-size: .57rem; letter-spacing: .08em; text-transform: uppercase; }
  .political-section { margin-top: clamp(4.5rem, 9vw, 8rem); scroll-margin-top: 6rem; }
  .political-heading { padding-bottom: 1.1rem; border-bottom: 4px solid #d4b861; }
  .political-heading h2, .queen-government h2 { max-width: 17ch; margin: .55rem 0 0; color: #f5f0df; font-family: var(--font-display); font-size: clamp(2.2rem, 5vw, 4.8rem); font-weight: 790; letter-spacing: -.055em; line-height: .92; }
  .political-heading > span { display: block; margin-top: .75rem; color: #9f98a7; line-height: 1.55; }
  .map-switcher { margin-top: 1.4rem; border: 1px solid #41384d; background: #0c0910; }
  .map-switcher__controls { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); border-bottom: 1px solid #41384d; }
  .map-switcher__controls button { display: grid; gap: .25rem; padding: .9rem; border: 0; border-right: 1px solid #41384d; background: #0c0910; color: #aaa4b2; font-family: var(--font-mono); font-size: .62rem; text-align: left; text-transform: uppercase; }
  .map-switcher__controls button:last-child { border-right: 0; }
  .map-switcher__controls button span { color: #655e69; font-size: .55rem; }
  .map-switcher__controls button:hover, .map-switcher__controls button:focus-visible, .map-switcher__controls button[aria-selected="true"] { background: #1a1117; color: #fff; outline: 2px solid #d4b861; outline-offset: -3px; }
  .map-switcher__plate { display: grid; }
  .map-switcher__record { padding: clamp(1.3rem, 4vw, 2.6rem); }
  .map-switcher__record h3, .failure-cascade h3 { margin: .6rem 0 0; color: #f5f0df; font-family: var(--font-display); font-size: clamp(1.7rem, 3vw, 2.8rem); line-height: 1; }
  .map-switcher__record article > p:not(.political-kicker), .failure-cascade article > p:not(.political-kicker) { margin: 1rem 0 0; color: #aaa4b2; line-height: 1.7; }
  .map-switcher__record h4 { margin: 1.3rem 0 0; color: #d4b861; font-family: var(--font-mono); font-size: .61rem; letter-spacing: .1em; text-transform: uppercase; }
  .map-switcher__record ul { margin: .65rem 0 0; padding-left: 1.2rem; color: #d0c8d1; line-height: 1.7; }
  .map-note { margin: 0; padding: .8rem 1rem; border-inline: 1px solid #41384d; border-bottom: 1px solid #41384d; color: #aaa4b2; font-family: var(--font-mono); font-size: .65rem; }
  .map-note strong { color: #e23a4e; text-transform: uppercase; }
  .regional-ledger { display: grid; gap: 1px; margin-top: 1.4rem; background: #41384d; border: 1px solid #41384d; }
  .regional-ledger article { padding: 1.2rem; background: #0c0910; scroll-margin-top: 6rem; }
  .regional-ledger header { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: .75rem; border-bottom: 1px solid #2b2631; }
  .regional-ledger h3 { margin: 0; color: #f5f0df; font-family: var(--font-display); font-size: 1.25rem; }
  .regional-ledger header span { color: #d4b861; font-family: var(--font-mono); font-size: .58rem; text-transform: uppercase; }
  .regional-ledger dl { margin: .8rem 0 0; }
  .regional-ledger dl div { display: grid; gap: .3rem; padding: .55rem 0; border-top: 1px solid #211d25; }
  .regional-ledger dt, .house-folio__copy dt { color: #6f6873; font-family: var(--font-mono); font-size: .55rem; letter-spacing: .08em; text-transform: uppercase; }
  .regional-ledger dd, .house-folio__copy dd { margin: 0; color: #aaa4b2; font-size: .78rem; line-height: 1.5; }
  .regional-ledger article > p { margin: 1rem 0 0; padding-top: .8rem; border-top: 1px solid #2b2631; color: #c8c0c9; font-size: .8rem; line-height: 1.55; }
  .regional-ledger article > p strong { color: #e23a4e; font-family: var(--font-mono); font-size: .57rem; text-transform: uppercase; }
  .house-folios { margin-top: 1.4rem; border-block: 1px solid #41384d; }
  .house-folios > article { display: grid; border-bottom: 1px solid #41384d; background: #0c0910; scroll-margin-top: 6rem; }
  .house-folios > article:last-child { border-bottom: 0; }
  .house-folio__stamp { display: flex; min-height: 19rem; flex-direction: column; justify-content: space-between; padding: 1.5rem; border-bottom: 1px solid #41384d; border-top: 7px solid var(--house-accent); background: #09070b; }
  .house-folio__stamp span, .house-folio__stamp p { color: var(--house-accent); font-family: var(--font-mono); font-size: .6rem; letter-spacing: .1em; text-transform: uppercase; }
  .house-folio__stamp strong { color: #f5f0df; font-family: var(--font-display); font-size: clamp(3.5rem, 8vw, 7rem); font-weight: 800; letter-spacing: -.06em; }
  .house-folio__stamp p { margin: 0; }
  .house-folio__copy { padding: clamp(1.4rem, 4vw, 3rem); }
  .house-folio__copy h3 { margin: .6rem 0 0; color: #f5f0df; font-family: var(--font-display); font-size: clamp(2.2rem, 5vw, 4.5rem); line-height: .9; }
  .house-folio__copy > span { display: block; margin-top: .5rem; color: var(--house-accent); font-family: var(--font-mono); font-size: .62rem; letter-spacing: .08em; text-transform: uppercase; }
  .house-folio__copy > p:not(.political-kicker) { max-width: 48rem; margin: 1rem 0 0; color: #aaa4b2; line-height: 1.7; }
  .house-folio__copy dl { display: grid; gap: 1px; margin: 1.3rem 0 0; background: #2b2631; border: 1px solid #2b2631; }
  .house-folio__copy dl div { padding: .75rem; background: #09070b; }
  .house-folio__copy aside { display: grid; gap: .4rem; margin-top: 1rem; padding: 1rem; border-left: 5px solid var(--house-accent); background: #171119; }
  .house-folio__copy aside b { color: var(--house-accent); font-family: var(--font-mono); font-size: .58rem; font-weight: 400; letter-spacing: .08em; text-transform: uppercase; }
  .house-folio__copy aside span { color: #d0c8d1; font-size: .84rem; line-height: 1.55; }
  .queen-government { display: grid; border-block: 1px solid #41384d; background: #100a0f; }
  .queen-government > div { padding: clamp(1.5rem, 5vw, 3.5rem); }
  .queen-government > div > p:not(.political-kicker) { color: #aaa4b2; line-height: 1.72; }
  .queen-government blockquote { margin: 1.4rem 0 0; padding-left: 1rem; border-left: 5px solid #e23a4e; color: #f5f0df; font-family: var(--font-display); font-size: 1.15rem; line-height: 1.45; }
  .failure-cascade { display: grid; margin-top: 1.4rem; border: 1px solid #41384d; background: #0c0910; }
  .failure-cascade__controls { display: grid; gap: 1px; background: #41384d; }
  .failure-cascade__controls button { padding: .9rem 1rem; border: 0; border-left: 5px solid var(--house-accent); background: #0c0910; color: #aaa4b2; font-family: var(--font-mono); font-size: .62rem; text-align: left; text-transform: uppercase; }
  .failure-cascade__controls button:hover, .failure-cascade__controls button:focus-visible, .failure-cascade__controls button[aria-pressed="true"] { background: #19131b; color: #fff; outline: 1px solid var(--house-accent); outline-offset: -2px; }
  .failure-cascade__result { display: flex; min-height: 18rem; align-items: center; padding: clamp(1.4rem, 4vw, 3rem); }
  .evidence-orchard ol, .disputes ul { display: grid; gap: 1px; margin: 1.4rem 0 0; padding: 0; background: #41384d; border: 1px solid #41384d; list-style: none; }
  .evidence-orchard li { display: grid; grid-template-columns: 6rem 1fr; gap: 1rem; align-items: center; padding: 1rem; background: #0c0910; }
  .evidence-orchard li > span { color: var(--house-accent); font-family: var(--font-display); font-size: 1.4rem; }
  .evidence-orchard h3, .disputes strong { margin: 0; color: #f5f0df; font-family: var(--font-display); font-size: 1.1rem; }
  .evidence-orchard p, .disputes p { margin: .35rem 0 0; color: #aaa4b2; font-size: .82rem; line-height: 1.55; }
  .disputes li { padding: 1rem; background: #0c0910; }
  .disputes li > span { display: block; margin-bottom: .5rem; color: #e23a4e; font-family: var(--font-mono); font-size: .55rem; letter-spacing: .08em; text-transform: uppercase; }
  .disputes > a { display: inline-flex; margin-top: 1.2rem; color: #8fd8ef; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .08em; text-transform: uppercase; }
  @media (min-width: 760px) {
    .regional-ledger { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .house-folio__copy dl { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .evidence-orchard ol { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .disputes ul { grid-template-columns: repeat(2,minmax(0,1fr)); }
  }
