---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { storySeries, storySeriesPath } from "@/data/story-series";
import {
  OTHER_ALICE_WORLD_GUIDE_PATH,
  affiliationLayers,
  aliceTimeline,
  courtDossiers,
  currentWorldCrisis,
  unsuitedDossiers,
  worldGuideTerms,
} from "@/data/other-alice-world-guide";

export function getStaticPaths() {
  const series = storySeries.find((entry) => entry.slug === "other-alice-adventures");
  return series
    ? [{ params: { series: series.slug }, props: { series } }]
    : [];
}

const { series } = Astro.props;
const regions = series.worldAtlas?.concepts ?? [];
const residents = series.residents?.entries ?? [];
const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const canonicalUrl = new URL(OTHER_ALICE_WORLD_GUIDE_PATH, siteOrigin).toString();
const indexEntries = [
  ...regions.map((entry) => ({
    id: entry.id,
    category: "regions",
    label: entry.title,
    eyebrow: entry.realm,
    description: entry.description,
  })),
  ...courtDossiers.map((entry) => ({
    id: entry.id,
    category: "courts",
    label: entry.name,
    eyebrow: entry.territory,
    description: entry.corePower,
  })),
  ...residents.map((entry) => ({
    id: entry.id,
    category: entry.category === "faction" ? "factions" : "characters",
    label: entry.name,
    eyebrow: entry.role,
    description: entry.summary[0],
  })),
  ...unsuitedDossiers.map((entry) => ({
    id: entry.id,
    category: "unsuited",
    label: entry.name,
    eyebrow: entry.domain,
    description: entry.summary[0],
  })),
  ...worldGuideTerms.map((entry) => ({
    id: `term-${entry.term.toLowerCase().replaceAll(/[^a-z0-9]+/g, "-")}`,
    category: "systems",
    label: entry.term,
    eyebrow: "World term",
    description: entry.definition,
  })),
];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${canonicalUrl}#world-guide`,
  name: "Other Alice World Guide",
  description:
    "A public field guide to HobFarm's Other Alice Adventures: Wonderland, Wasteland, the four courts, the Unsuited, characters, factions, timeline, and portal systems.",
  url: canonicalUrl,
  image: series.worldAtlas?.concepts[0]?.image ?? series.cover,
  isPartOf: {
    "@type": "CreativeWorkSeries",
    name: series.title,
    url: new URL(storySeriesPath(series.slug), siteOrigin).toString(),
  },
};
---

<BaseLayout
  title="Other Alice World Guide: Wonderland, Wasteland, Courts, and Characters"
  description="Explore the world of Other Alice Adventures: regions, courts, factions, Unsuited beings, characters, timeline, terminology, and the political ecology of Wonderland."
  canonical={OTHER_ALICE_WORLD_GUIDE_PATH}
  image={regions[0]?.image ?? series.cover}
  imageAlt={regions[0]?.imageAlt ?? series.coverAlt}
  structuredData={structuredData}
>
  <section class="world-guide">
    <ContentPanel>
      <Wrapper variant="standard" class="py-8 lg:py-14">
        <a href={storySeriesPath(series.slug)} class="guide-back">&larr; Return to {series.title}</a>

        <header class="guide-hero">
          <div class="guide-hero__copy">
            <p class="guide-kicker">HobFarm Presents / Series database 001</p>
            <h1>Other Alice<br />World Guide</h1>
            <p>
              A field index for the Wonderland that kept changing after Alice stayed: its regions, courts,
              political biology, Unsuited beings, characters, routes, time failures, and the Wasteland beyond.
            </p>
            <dl class="guide-hero__facts">
              <div><dt>Personal year</dt><dd>Alice, age 18</dd></div>
              <div><dt>Outside era</dt><dd>Approximately the 2060s</dd></div>
              <div><dt>Known powers</dt><dd>Four courts</dd></div>
              <div><dt>Outer condition</dt><dd>Cold advancing inward</dd></div>
            </dl>
          </div>
          {regions[0] && (
            <figure class="guide-hero__map">
              <img
                src={regions[0].image}
                alt={regions[0].imageAlt}
                width={regions[0].width}
                height={regions[0].height}
                decoding="async"
                fetchpriority="high"
              />
              <figcaption>
                <span>{regions[0].realm}</span>
                {regions[0].title}
              </figcaption>
            </figure>
          )}
        </header>

        <nav class="guide-jump" aria-label="World Guide sections">
          <a href="#database">Database</a>
          <a href="#world-system">World system</a>
          <a href="#regions">Regions</a>
          <a href="#courts">Courts</a>
          <a href="#residents">Characters</a>
          <a href="#unsuited">The Unsuited</a>
          <a href="#terms">Terms</a>
        </nav>

        <section id="database" class="guide-section" aria-labelledby="database-heading">
          <header class="guide-heading">
            <p>Index</p>
            <h2 id="database-heading">World database</h2>
            <span>Filter the known records, then open any entry for its field dossier.</span>
          </header>

          <div class="guide-filter" role="group" aria-label="Filter world records">
            {[
              ["all", "All records"],
              ["regions", "Regions"],
              ["courts", "Courts"],
              ["characters", "Characters"],
              ["factions", "Factions"],
              ["unsuited", "Unsuited"],
              ["systems", "Systems"],
            ].map(([value, label], index) => (
              <button
                type="button"
                data-guide-filter={value}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                {label}
              </button>
            ))}
          </div>

          <div class="guide-index" aria-live="polite">
            {indexEntries.map((entry, index) => (
              <a
                href={`#${entry.id}`}
                class="guide-index__card"
                data-guide-entry
                data-category={entry.category}
                style={`--entry-no:"${String(index + 1).padStart(2, "0")}"`}
              >
                <span>{entry.eyebrow}</span>
                <h3>{entry.label}</h3>
                <p>{entry.description}</p>
              </a>
            ))}
          </div>
          <p class="guide-filter__empty" data-guide-empty hidden>No records in this category yet.</p>
        </section>

        <section id="world-system" class="guide-section" aria-labelledby="world-system-heading">
          <header class="guide-heading">
            <p>System rule</p>
            <h2 id="world-system-heading">Species, suit, and territory are different layers</h2>
            <span>A resident can answer to several systems before a scene even begins.</span>
          </header>

          <div class="affiliation-grid">
            {affiliationLayers.map((layer, index) => (
              <article>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{layer.label}</h3>
                <p>{layer.description}</p>
              </article>
            ))}
          </div>

          <aside class="guide-example">
            <p class="guide-kicker">Example / divided loyalty</p>
            <h3>A panda hydraulic engineer</h3>
            <ul>
              <li>Bear by species.</li>
              <li>Club by suit.</li>
              <li>Resident of Diamond-controlled jungle territory.</li>
              <li>Possibly contracted to a Heart construction project.</li>
            </ul>
          </aside>

          <div class="timeline-grid">
            {aliceTimeline.map((entry) => (
              <article>
                <p>{entry.label}</p>
                <span>{entry.value}</span>
              </article>
            ))}
          </div>

          <aside class="crisis-card">
            <div>
              <p class="guide-kicker">Current world condition</p>
              <h3>{currentWorldCrisis.title}</h3>
              <p>{currentWorldCrisis.summary}</p>
            </div>
            <ul>{currentWorldCrisis.questions.map((question) => <li>{question}</li>)}</ul>
          </aside>
        </section>

        <section id="regions" class="guide-section" aria-labelledby="regions-heading">
          <header class="guide-heading">
            <p>Atlas</p>
            <h2 id="regions-heading">Regions and thresholds</h2>
            <span>The courts hold territory. The rabbit holes keep ignoring their borders.</span>
          </header>
          <div class="region-grid">
            {regions.map((region, index) => (
              <article id={region.id} class:list={["region-card", index === 0 && "region-card--wide"]}>
                <a href={region.image} target="_blank" rel="noopener noreferrer">
                  <img src={region.image} alt={region.imageAlt} width={region.width} height={region.height} loading="lazy" decoding="async" />
                </a>
                <div>
                  <p>{region.realm}</p>
                  <h3>{region.title}</h3>
                  <span>{region.description}</span>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="courts" class="guide-section" aria-labelledby="courts-heading">
          <header class="guide-heading">
            <p>Political ecology</p>
            <h2 id="courts-heading">The four courts</h2>
            <span>Every court keeps Wonderland alive. Every court also abuses the thing it controls.</span>
          </header>
          <div class="court-grid">
            {courtDossiers.map((court) => (
              <article id={court.id} class="court-card" style={`--court-accent:${court.accent}`}>
                <header>
                  <p>{court.territory}</p>
                  <h3>{court.name}</h3>
                  <span>{court.ruler}</span>
                </header>
                <dl>
                  <div><dt>Core power</dt><dd>{court.corePower}</dd></div>
                  <div><dt>Dominant bodies</dt><dd>{court.dominantBodies}</dd></div>
                  <div><dt>Necessary service</dt><dd>{court.necessaryService}</dd></div>
                  <div><dt>Political failure</dt><dd>{court.politicalFailure}</dd></div>
                </dl>
                <div class="court-card__copy">{court.summary.map((paragraph) => <p>{paragraph}</p>)}</div>
              </article>
            ))}
          </div>
        </section>

        <section id="residents" class="guide-section" aria-labelledby="residents-heading">
          <header class="guide-heading">
            <p>Character records</p>
            <h2 id="residents-heading">Residents and factions</h2>
            <span>Original figures and inherited Wonderland mythology share this branch of the holes.</span>
          </header>
          <div class="resident-grid">
            {residents.map((resident) => (
              <article id={resident.id} class="resident-card">
                <a href={resident.href ?? resident.image} class="resident-card__image">
                  <img src={resident.image} alt={resident.imageAlt} width="900" height="1200" loading="lazy" decoding="async" />
                </a>
                <div>
                  <p>{resident.category === "faction" ? "Faction record" : resident.role}</p>
                  <h3>{resident.name}</h3>
                  {resident.summary.map((paragraph) => <span>{paragraph}</span>)}
                  {resident.href && <a href={resident.href}>Open character guide &rarr;</a>}
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="unsuited" class="guide-section" aria-labelledby="unsuited-heading">
          <header class="guide-heading">
            <p>Outside the courts</p>
            <h2 id="unsuited-heading">The Unsuited</h2>
            <span>The courts rule society. The Unsuited belong to Wonderland itself.</span>
          </header>
          <p class="guide-intro">
            The Unsuited are not a fifth faction. They are individual beings whose identities predate, exceed,
            or refuse the suit system. Their abilities remain narrow but deep, and their presence changes the
            rules of a scene.
          </p>
          <div class="unsuited-grid">
            {unsuitedDossiers.map((entry) => (
              <article id={entry.id} class="unsuited-card">
                {entry.image && <img src={entry.image} alt={entry.imageAlt} width="900" height="1200" loading="lazy" decoding="async" />}
                <div>
                  <p>{entry.domain}</p>
                  <h3>{entry.name}</h3>
                  <small>{entry.source}</small>
                  {entry.summary.map((paragraph) => <span>{paragraph}</span>)}
                  <h4>Scene rules</h4>
                  <ul>{entry.sceneRules.map((rule) => <li>{rule}</li>)}</ul>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="terms" class="guide-section" aria-labelledby="terms-heading">
          <header class="guide-heading">
            <p>Reference</p>
            <h2 id="terms-heading">Terms and institutions</h2>
            <span>The repeated language that keeps the larger world readable.</span>
          </header>
          <dl class="term-grid">
            {worldGuideTerms.map((entry) => (
              <div id={`term-${entry.term.toLowerCase().replaceAll(/[^a-z0-9]+/g, "-")}`}>
                <dt>{entry.term}</dt>
                <dd>{entry.definition}</dd>
              </div>
            ))}
          </dl>
        </section>

        <footer class="guide-footer">
          <p class="guide-kicker">The database will keep growing</p>
          <h2>New stories establish new records.</h2>
          <p>
            Future Adventures can add characters, court houses, artifacts, routes, glossary terms, images,
            animated records, and recovered media without turning the story pages into exposition dumps.
          </p>
          <a href={storySeriesPath(series.slug)}>Return to the serial &rarr;</a>
        </footer>
      </Wrapper>
    </ContentPanel>
  </section>

  <script>
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-guide-filter]"));
    const guideEntries = Array.from(document.querySelectorAll<HTMLElement>("[data-guide-entry]"));
    const emptyState = document.querySelector<HTMLElement>("[data-guide-empty]");

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.guideFilter ?? "all";
        let visibleCount = 0;

        filterButtons.forEach((candidate) => {
          candidate.setAttribute("aria-pressed", String(candidate === button));
        });

        guideEntries.forEach((entry) => {
          const visible = filter === "all" || entry.dataset.category === filter;
          entry.hidden = !visible;
          if (visible) visibleCount += 1;
        });

        if (emptyState) emptyState.hidden = visibleCount > 0;
      });
    });
  </script>
</BaseLayout>

<style>
  .world-guide { background: #07060b; }
  .guide-back { color: #9b96ad; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .1em; text-decoration: none; text-transform: uppercase; }
  .guide-back:hover { color: #fff; }
  .guide-hero { display: grid; overflow: hidden; margin-top: 1.5rem; border: 1px solid #433559; background: #0e0b16; }
  .guide-hero__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(1.5rem, 5vw, 4.5rem); }
  .guide-kicker, .guide-heading > p, .court-card header > p, .resident-card > div > p, .unsuited-card > div > p, .region-card > div > p { margin: 0; color: #f0c96b; font-family: var(--font-mono); font-size: .65rem; letter-spacing: .17em; text-transform: uppercase; }
  .guide-hero h1 { margin: .8rem 0 0; color: #f5f0df; font-family: var(--font-display); font-size: clamp(3rem, 8vw, 7.5rem); font-weight: 820; letter-spacing: -.075em; line-height: .82; text-transform: uppercase; }
  .guide-hero__copy > p:not(.guide-kicker) { max-width: 43rem; margin: 1.5rem 0 0; color: #c8c6d4; line-height: 1.7; }
  .guide-hero__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin: 2rem 0 0; }
  .guide-hero__facts div { padding: .85rem; border: 1px solid #2c2440; background: #07060b; }
  .guide-hero__facts dt { color: #6b6580; font-family: var(--font-mono); font-size: .58rem; letter-spacing: .1em; text-transform: uppercase; }
  .guide-hero__facts dd { margin: .35rem 0 0; color: #ece9f5; font-size: .82rem; }
  .guide-hero__map { position: relative; min-height: 32rem; margin: 0; background: #07060b; }
  .guide-hero__map img { width: 100%; height: 100%; object-fit: cover; }
  .guide-hero__map figcaption { position: absolute; right: 1rem; bottom: 1rem; left: 1rem; padding: .9rem; background: rgb(7 6 11 / 90%); color: #ece9f5; font-family: var(--font-display); }
  .guide-hero__map figcaption span { display: block; margin-bottom: .2rem; color: #f0c96b; font-family: var(--font-mono); font-size: .58rem; letter-spacing: .12em; text-transform: uppercase; }
  .guide-jump { display: flex; gap: .5rem; margin-top: .75rem; overflow-x: auto; padding-bottom: .5rem; }
  .guide-jump a { flex: 0 0 auto; padding: .7rem .8rem; border: 1px solid #2c2440; color: #c8c6d4; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
  .guide-jump a:hover { border-color: #f0c96b; color: #fff; }
  .guide-section { margin-top: clamp(4rem, 9vw, 8rem); scroll-margin-top: 7rem; }
  .guide-heading { padding-bottom: 1.1rem; border-bottom: 4px solid #f0c96b; }
  .guide-heading h2, .guide-footer h2 { margin: .55rem 0 0; color: #f5f0df; font-family: var(--font-display); font-size: clamp(2.2rem, 5vw, 4.8rem); font-weight: 790; letter-spacing: -.055em; line-height: .92; }
  .guide-heading > span { display: block; margin-top: .75rem; color: #9b96ad; line-height: 1.5; }
  .guide-filter { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.5rem; }
  .guide-filter button { padding: .7rem .85rem; border: 1px solid #433559; background: #0e0b16; color: #9b96ad; font-family: var(--font-mono); font-size: .62rem; letter-spacing: .08em; text-transform: uppercase; }
  .guide-filter button:hover, .guide-filter button[aria-pressed="true"] { border-color: #19e3e3; color: #ece9f5; }
  .guide-index { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; margin-top: 1rem; }
  .guide-index__card { position: relative; min-height: 12rem; padding: 1.2rem; border: 1px solid #2c2440; background: #0e0b16; text-decoration: none; }
  .guide-index__card::after { position: absolute; top: 1rem; right: 1rem; color: #433559; content: var(--entry-no); font-family: var(--font-mono); font-size: .7rem; }
  .guide-index__card:hover { border-color: #f0c96b; }
  .guide-index__card > span { display: block; max-width: calc(100% - 2rem); color: #19e3e3; font-family: var(--font-mono); font-size: .58rem; letter-spacing: .1em; text-transform: uppercase; }
  .guide-index__card h3 { margin: .75rem 0 0; color: #ece9f5; font-family: var(--font-display); font-size: 1.2rem; }
  .guide-index__card p { margin: .7rem 0 0; color: #9b96ad; font-size: .78rem; line-height: 1.55; }
  .guide-filter__empty { margin: 1rem 0 0; color: #9b96ad; }
  .affiliation-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .affiliation-grid article { padding: 1.4rem; border: 1px solid #2c2440; background: #0e0b16; }
  .affiliation-grid article > span { color: #f0c96b; font-family: var(--font-mono); font-size: .65rem; }
  .affiliation-grid h3 { margin: .7rem 0 0; color: #ece9f5; font-family: var(--font-display); font-size: 1.25rem; }
  .affiliation-grid p { margin: .7rem 0 0; color: #9b96ad; font-size: .85rem; line-height: 1.6; }
  .guide-example { margin-top: 1rem; padding: clamp(1.4rem, 4vw, 2.5rem); border: 1px solid #433559; border-left: 5px solid #6b93ed; background: #15101f; }
  .guide-example h3, .crisis-card h3 { margin: .55rem 0 0; color: #ece9f5; font-family: var(--font-display); font-size: 1.7rem; }
  .guide-example ul, .crisis-card ul { margin: 1rem 0 0; padding-left: 1.2rem; color: #c8c6d4; line-height: 1.7; }
  .timeline-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin-top: 1rem; background: #2c2440; border: 1px solid #2c2440; }
  .timeline-grid article { padding: 1.2rem; background: #0e0b16; }
  .timeline-grid p { margin: 0; color: #19e3e3; font-family: var(--font-mono); font-size: .6rem; letter-spacing: .1em; text-transform: uppercase; }
  .timeline-grid span { display: block; margin-top: .65rem; color: #c8c6d4; font-size: .82rem; line-height: 1.55; }
  .crisis-card { display: grid; gap: 2rem; margin-top: 1rem; padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid #433559; background: #0e0b16; }
  .crisis-card > div > p:last-child { max-width: 45rem; margin: 1rem 0 0; color: #9b96ad; line-height: 1.7; }
  .region-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .region-card { overflow: hidden; border: 1px solid #2c2440; background: #0e0b16; scroll-margin-top: 7rem; }
  .region-card--wide { grid-column: span 2; }
  .region-card > a { display: block; height: 25rem; overflow: hidden; }
  .region-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 500ms ease; }
  .region-card:hover img { transform: scale(1.02); }
  .region-card > div { padding: 1.2rem; }
  .region-card h3 { margin: .55rem 0 0; color: #ece9f5; font-family: var(--font-display); font-size: 1.4rem; }
  .region-card > div > span { display: block; margin-top: .7rem; color: #9b96ad; font-size: .82rem; line-height: 1.6; }
  .court-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .court-card { padding: clamp(1.3rem, 3vw, 2rem); border: 1px solid #2c2440; border-top: 4px solid var(--court-accent); background: #0e0b16; scroll-margin-top: 7rem; }
  .court-card header > p { color: var(--court-accent); }
  .court-card h3 { margin: .65rem 0 0; color: #ece9f5; font-family: var(--font-display); font-size: 1.75rem; }
  .court-card header > span { display: block; margin-top: .35rem; color: #9b96ad; font-size: .82rem; }
  .court-card dl { margin: 1.2rem 0 0; }
  .court-card dl div { display: grid; grid-template-columns: 8rem 1fr; gap: 1rem; padding: .75rem 0; border-top: 1px solid #2c2440; }
  .court-card dt { color: #6b6580; font-family: var(--font-mono); font-size: .58rem; letter-spacing: .08em; text-transform: uppercase; }
  .court-card dd { margin: 0; color: #c8c6d4; font-size: .8rem; line-height: 1.5; }
  .court-card__copy p { margin: .9rem 0 0; color: #9b96ad; font-size: .84rem; line-height: 1.65; }
  .resident-grid, .unsuited-grid { display: grid; gap: 1rem; margin-top: 1.5rem; }
  .resident-card, .unsuited-card { display: grid; overflow: hidden; border: 1px solid #2c2440; background: #0e0b16; scroll-margin-top: 7rem; }
  .resident-card__image, .unsuited-card > img { min-height: 27rem; background: #07060b; }
  .resident-card img, .unsuited-card > img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .resident-card > div, .unsuited-card > div { padding: clamp(1.3rem, 4vw, 2.5rem); }
  .resident-card h3, .unsuited-card h3 { margin: .65rem 0 0; color: #ece9f5; font-family: var(--font-display); font-size: 1.8rem; }
