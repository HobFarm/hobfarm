---
import BaseLayout from "@/layouts/BaseLayout.astro";
import OaaProjectNav from "@/components/presents/other-alice/OaaProjectNav.astro";
import SectionNav from "@/components/presents/other-alice/living-world/SectionNav.astro";
import LivingAtlas from "@/components/presents/other-alice/living-world/LivingAtlas.astro";
import RouteAtlas from "@/components/presents/other-alice/living-world/RouteAtlas.astro";
import AccessSequence from "@/components/presents/other-alice/living-world/AccessSequence.astro";
import ThreeClocks from "@/components/presents/other-alice/living-world/ThreeClocks.astro";
import VisitorImprint from "@/components/presents/other-alice/living-world/VisitorImprint.astro";
import BoundaryRecord from "@/components/presents/other-alice/living-world/BoundaryRecord.astro";
import { storySeries } from "@/data/story-series";
import { OTHER_ALICE_WORLD_GUIDE_PATH, regions, microworlds, ecologyLoops, populationLayers, otherAliceResidents, visitorChannels } from "@/data/other-alice-world-guide";

export function getStaticPaths(){const series=storySeries.find((entry)=>entry.slug==="other-alice-adventures");return series?[{params:{series:series.slug},props:{series}}]:[]}
const canonicalUrl=new URL(OTHER_ALICE_WORLD_GUIDE_PATH,"https://hob.farm").toString();
const structuredData={"@context":"https://schema.org","@type":"CollectionPage",name:"Wonderland World Guide",description:"A public guide to Wonderland's regions, routes, access, time, visitors, ecology, residents, and incomplete boundary record.",url:canonicalUrl,hasPart:regions.map((region)=>({"@type":"Place",name:region.title,description:region.summary}))};
---
<BaseLayout title="Wonderland World Guide | Other Alice Adventures" description="Explore Wonderland as an inhabited country: regions, routes, access, time, visitors, ecology, residents, Houses, and its incomplete boundary record." canonical={OTHER_ALICE_WORLD_GUIDE_PATH} image="https://cdn.hob.farm/pages/other-alice-adventures/oaa-map-wonderland-living-atlas-v01-16x9.webp" imageAlt="Aerial atlas of circular Wonderland" structuredData={structuredData}>
 <div class="world-guide">
  <OaaProjectNav current="world-guide" />
  <header class="guide-hero"><p class="eyebrow">Public world record</p><h1>Wonderland World Guide</h1><p>Wonderland is a country before it is a mystery: inhabited, maintained, traded, taxed, repaired, traveled, and argued over.</p><SectionNav /></header>
  <section class="guide-section atlas" aria-labelledby="regions"><div class="heading"><p>01 / Geography</p><h2 id="regions">Regions</h2><span>The circular atlas moves from the Queen's central estate through city, highlands, forest, cold country, and a complete boundary mountain ring.</span></div><LivingAtlas />
   <div class="region-list">{regions.map((region)=><article><p class="eyebrow">{region.zone} · {region.canon}</p><h3>{region.title}</h3><p>{region.summary}</p><dl><div><dt>Position</dt><dd>{region.position}</dd></div><div><dt>Material behavior</dt><dd>{region.physicalLaw}</dd></div><div><dt>Practical power</dt><dd>{region.governance}</dd></div><div><dt>Work and exchange</dt><dd>{region.economy}</dd></div><div><dt>Ecology</dt><dd>{region.ecology}</dd></div><div><dt>Visible evidence</dt><dd>{region.evidence[0].label} · {region.evidence[0].certainty}</dd></div></dl></article>)}</div>
  </section>
  <section class="guide-section" aria-labelledby="routes"><div class="heading"><p>02 / Movement</p><h2 id="routes">Routes</h2><span>Registered roads and regional circuits share the map with discontinuous passages that refuse ordinary distance.</span></div><RouteAtlas /></section>
  <section class="guide-section" aria-labelledby="access"><div class="heading"><p>03 / Crossing</p><h2 id="access">Access</h2><span>A route begins before the opening. Resonance becomes a lure; access requires a choice; passage imposes a cost and leaves residue.</span></div><AccessSequence /></section>
  <section class="guide-section" aria-labelledby="time"><div class="heading"><p>04 / Three clocks</p><h2 id="time">Time</h2><span>Alice's body, Wonderland's civic systems, and connected outside worlds keep different records. No fixed conversion ratio is claimed.</span></div><ThreeClocks /></section>
  <section class="guide-section" aria-labelledby="visitors"><div class="heading"><p>05 / Accumulation</p><h2 id="visitors">Visitors</h2><span>Wonderland does not preserve arrivals intact. Local use determines whether residue becomes practice, institution, ecology, myth, or resistance.</span></div><VisitorImprint /><div class="channel-grid">{visitorChannels.map((channel)=><article><h3>{channel.title}</h3><p>{channel.text}</p></article>)}</div></section>
  <section class="guide-section" aria-labelledby="ecology"><div class="heading"><p>06 / Continuity</p><h2 id="ecology">Ecology</h2><span>Nothing is only decorative. Water, food, waste, roads, organisms, labor, markets, and repair form loops that keep settlements alive.</span></div><div class="loop-grid">{ecologyLoops.map((loop)=><article><h3>{loop.title}</h3><p>{loop.text}</p></article>)}</div><h3 class="subhead">Three local systems</h3><div class="microworlds">{microworlds.map((site)=><article><p class="eyebrow">{site.region}</p><h3>{site.title}</h3><p>{site.need}</p><ol>{site.siteBraid.map((layer: string)=><li>{layer}</li>)}</ol></article>)}</div></section>
  <section class="guide-section" aria-labelledby="residents"><div class="heading"><p>07 / Population lens</p><h2 id="residents">Residents</h2><span>Named characters are only the closest layer. Institutions, work populations, and living infrastructure make the world larger than its cast.</span></div><div class="population">{populationLayers.map((layer)=><article><h3>{layer.label}</h3><p>{layer.text}</p></article>)}</div><div class="resident-row">{otherAliceResidents.map((resident)=><article><h3>{resident.name}</h3><p class="eyebrow">{resident.role}</p><p>{resident.summary.join(" ")}</p></article>)}</div></section>
  <section id="boundary" class="guide-section"><BoundaryRecord /></section>
 </div>
</BaseLayout>
<style>
 .world-guide{background:#080a11;color:#eee7d6;min-height:100vh}.guide-hero,.guide-section{max-width:90rem;margin:auto;padding:clamp(3rem,7vw,7rem) clamp(1rem,4vw,4rem)}.guide-hero{padding-top:clamp(4rem,9vw,9rem)}.eyebrow,.heading>p{color:#9f7aea;font:600 .68rem/1 ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase}.guide-hero h1{max-width:13ch;margin:.7rem 0;font:400 clamp(3.8rem,9vw,9rem)/.84 Georgia,serif;letter-spacing:-.06em}.guide-hero>p:not(.eyebrow){max-width:47rem;color:#bdc1cb;font-size:1.18rem;line-height:1.65}.guide-section{border-top:1px solid rgba(255,255,255,.11)}.heading{display:grid;grid-template-columns:minmax(10rem,.3fr) minmax(0,.65fr) minmax(18rem,.65fr);gap:1rem 2rem;align-items:start;margin-bottom:3rem}.heading h2{margin:0;font:400 clamp(2.3rem,5vw,5rem)/1 Georgia,serif}.heading span{color:#adb2bf;line-height:1.7}.region-list{display:grid;grid-template-columns:1fr 1fr;margin-top:2rem;border:1px solid rgba(255,255,255,.13)}.region-list>article{padding:1.2rem;border-right:1px solid rgba(255,255,255,.11);border-bottom:1px solid rgba(255,255,255,.11)}.region-list h3,.channel-grid h3,.loop-grid h3,.microworlds h3,.population h3,.resident-row h3{color:#fff;font:400 1.25rem/1.15 Georgia,serif}.region-list>article>p:not(.eyebrow),dd,.channel-grid p,.loop-grid p,.microworlds p,.population p,.resident-row p{color:#b3b8c4;line-height:1.58}.region-list dl{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.region-list dt{color:#7f8797;font:600 .62rem/1 ui-monospace,monospace;text-transform:uppercase}.region-list dd{margin:.3rem 0 0;font-size:.83rem}.channel-grid,.loop-grid,.population{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.channel-grid article,.loop-grid article,.population article,.resident-row article{border-top:2px solid #9f7aea;padding:1rem;background:#0e121c}.loop-grid{grid-template-columns:repeat(3,1fr)}.subhead{margin:3rem 0 1rem;font:400 2rem/1 Georgia,serif}.microworlds{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.microworlds article{padding:1rem;border:1px solid rgba(255,255,255,.13)}.microworlds ol{display:flex;flex-wrap:wrap;gap:.35rem;padding:0;list-style:none}.microworlds li{border:1px solid #4c5362;border-radius:999px;padding:.35rem .5rem;color:#aeb3bf;font-size:.72rem}.resident-row{display:grid;grid-template-columns:repeat(5,1fr);gap:.6rem;margin-top:1rem}.resident-row article{border-top-color:#557c70}.resident-row .eyebrow{color:#7db59f}.resident-row p:last-child{font-size:.82rem}
 @media(max-width:850px){.heading{grid-template-columns:1fr}.region-list{grid-template-columns:1fr}.channel-grid,.population{grid-template-columns:1fr 1fr}.loop-grid,.microworlds{grid-template-columns:1fr}.resident-row{grid-template-columns:1fr 1fr}.region-list dl{grid-template-columns:1fr}}
 @media(max-width:520px){.guide-hero h1{font-size:3.7rem}.channel-grid,.population,.resident-row{grid-template-columns:1fr}.guide-section{padding-block:4rem}}
</style>
