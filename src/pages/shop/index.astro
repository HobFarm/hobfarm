---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Eyebrow from "@/components/sections/Eyebrow.astro";
import SectionHeader from "@/components/sections/SectionHeader.astro";
import Button from "@/components/fundations/elements/Button.astro";
import KofiCta from "@/components/KofiCta.astro";
import DropCard from "@/components/shop/DropCard.astro";
import { getPublicProducts } from "@/lib/products";

const ETSY = "https://www.etsy.com/shop/hobfarm";

// Real/planned drops only (live, coming-soon, sold-out). No fake product cards.
const drops = await getPublicProducts();

type Family = { title: string; body: string };

const families: Family[] = [
  {
    title: "Surreal desk mats",
    body: "Wide-format desk worlds: portal surfaces, cracked-wall illusions, haunted villages, and psychedelic office landscapes for desks that should not look like a supply catalog.",
  },
  {
    title: "Digital sticker + clip-art packs",
    body: "Low-cost downloadable sets: Halloween monsters, haunted objects, fictional warning labels, ravens, pumpkins, ghosts, and portal fragments for stickers, journals, and collage.",
  },
  {
    title: "Drinkware",
    body: "Mugs, tumblers, and pint glasses using simplified graphics, wrap concepts, haunted labels, and fictional souvenir-shop marks pulled from larger HobFarm worlds.",
  },
  {
    title: "Bags + laptop sleeves",
    body: "Totes, sleeves, and duffles with bold central graphics, pattern crops, fictional brand marks, and design fragments from larger collections.",
  },
  {
    title: "Handmade clay oddities",
    body: "Small polymer clay pieces: magnets, charms, ghost blobs, portal drips, signposts, relics, and ornaments. The handmade layer beyond print-on-demand.",
  },
  {
    title: "Vintage finds",
    body: "Odd, useful, and collectible pieces found through local hunting, estate sales, and auctions. One-off shelf items in the wider HobFarm gift-shop.",
  },
];
---

<BaseLayout
  title="Shop | HobFarm"
  description="Usable objects from the HobFarm visual system: desk mats, digital sticker packs, drinkware, handmade clay oddities, and vintage finds. On Etsy and Ko-fi."
>
  {/* ── Hero ── */}
  <section class="bg-noise border-b border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-20 lg:py-28">
        <Eyebrow text="HobFarm / Shop" />
        <Text tag="h1" variant="display2XL" class="mt-6 text-white font-display max-w-4xl text-balance">
          Shop
        </Text>
        <Text tag="p" variant="textBase" class="text-base-300 mt-6 max-w-2xl text-pretty leading-relaxed">
          The shop is where the visual experiments become things you can use, collect, download, or gift. Visual-system objects, built into small product worlds rather than random merch.
        </Text>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button isLink size="sm" variant="green" href={ETSY} target="_blank" rel="noopener noreferrer">Shop on Etsy</Button>
          <KofiCta variant="button" />
        </div>
        <Text tag="p" variant="textSM" class="text-base-500 mt-6 max-w-2xl text-pretty leading-relaxed">
          Etsy is the main storefront today. Ko-fi handles support and small drops. An on-site shop and eBay are later shelves, not open yet.
        </Text>
      </Wrapper>
    </ContentPanel>
  </section>

  {/* ── Drops (real/planned products only) ── */}
  {drops.length > 0 && (
    <section class="border-t border-base-800/50">
      <ContentPanel>
        <Wrapper variant="standard" class="py-12 lg:py-20">
          <SectionHeader
            eyebrow="Drops"
            heading="Character packs & drops"
            note="Preview the system here; full-resolution paid files live on the storefront."
          />
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {drops.map((product) => <DropCard product={product} />)}
          </div>
        </Wrapper>
      </ContentPanel>
    </section>
  )}

  {/* ── Product families ── */}
  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="01" heading="Product families" note="Built to become several useful things." />
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
          {families.map((family) => (
            <div class="rounded-lg border border-base-800 bg-base-900/40 p-6">
              <Text tag="h3" variant="textLG" class="text-white font-display">
                {family.title}
              </Text>
              <Text tag="p" variant="textSM" class="text-base-400 mt-3 text-pretty leading-relaxed">
                {family.body}
              </Text>
            </div>
          ))}
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  {/* ── Corrupted Craft Village feature ── */}
  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <SectionHeader eyebrow="02" heading="Corrupted Craft Village" note="Dark, tactile, product-focused." />
        <Text tag="p" variant="textBase" class="text-base-400 max-w-2xl text-pretty leading-relaxed">
          A product world built from souvenir-house nostalgia, antique shops, New England roads, ghost villages, and haunted windows, run through ooze, portals, and supernatural gift-shop logic. Call it corrupted cottagecore if you need a label. It shows up as desk mats, mugs, posters, sticker packs, digital art, and handmade clay add-ons.
        </Text>
      </Wrapper>
    </ContentPanel>
  </section>

  {/* ── CTA ── */}
  <section class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <Text tag="h2" variant="displaySM" class="text-white font-display">
          Want something specific?
        </Text>
        <Text tag="p" variant="textBase" class="text-base-400 mt-4 max-w-2xl text-pretty leading-relaxed">
          See where the designs come from in the visuals, or ask for a custom piece.
        </Text>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button isLink size="sm" variant="green" href={ETSY} target="_blank" rel="noopener noreferrer">Shop on Etsy</Button>
          <Button isLink size="sm" variant="muted" href="/gallery">See the visuals</Button>
          <Button isLink size="sm" variant="muted" href="/contact/">Custom request</Button>
        </div>
      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>
