---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Eyebrow from "@/components/sections/Eyebrow.astro";
import Button from "@/components/fundations/elements/Button.astro";
import { storefrontHasCta, storefronts } from "@/data/storefronts";

const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const shopDescription =
  "Find the verified HobFarm or marketplace shelf for direct products, digital packs, character and visual-world releases, and one-off physical finds.";
const shopJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${siteOrigin}/shop/#directory`,
  name: "HobFarm Shop",
  description: shopDescription,
  url: `${siteOrigin}/shop/`,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: storefronts.map((storefront, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: storefront.name,
      description: storefront.description,
      ...(storefront.href
        ? { url: new URL(storefront.href, siteOrigin).toString() }
        : {}),
    })),
  },
};
---

<BaseLayout
  title="Shop | HobFarm"
  description={shopDescription}
  canonical="/shop/"
  structuredData={shopJsonLd}
>
  <section class="bg-noise border-b border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-20 lg:py-28">
        <Eyebrow text="HobFarm Shop" />
        <Text tag="h1" variant="display2XL" class="mt-6 max-w-4xl text-balance font-display text-white">
          One clear shelf for each kind of work.
        </Text>
        <Text tag="p" variant="textBase" class="mt-6 max-w-2xl text-pretty leading-relaxed text-base-300">
          Shop is HobFarm's product directory and direct-commerce surface. DeviantArt carries character and collector-facing visual work, Etsy carries reusable digital packages, and eBay carries counted physical objects. Verified HobFarm products use direct checkout only when the product, price, fulfillment, and support path are real.
        </Text>
      </Wrapper>
    </ContentPanel>
  </section>

  <section aria-label="Marketplace storefronts">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
          {storefronts.map((storefront) => (
            <article
              id={storefront.id}
              class="flex min-h-full flex-col border border-base-800 bg-base-900/45 p-6 lg:p-7"
              style={`--storefront-accent:${storefront.accent}`}
            >
              <p class="font-mono text-[10px] uppercase tracking-[0.18em]" style="color:var(--storefront-accent)">
                {storefront.label}
              </p>
              <div class="mt-3 flex flex-col items-start gap-3 sm:flex-row sm:justify-between">
                <Text tag="h2" variant="displayXS" class="font-display text-white">
                  {storefront.name}
                </Text>
                <span class="border border-base-700 px-2 py-1 font-mono text-[10px] uppercase tracking-wider text-base-400">
                  <span class="sr-only">Status: </span>{storefront.statusLabel}
                </span>
              </div>
              <Text tag="p" variant="textSM" class="mt-4 text-pretty leading-relaxed text-base-400">
                {storefront.description}
              </Text>
              <div class="mt-auto pt-6">
                {storefrontHasCta(storefront) ? (
                  <Button
                    isLink
                    size="sm"
                    variant="muted"
                    href={storefront.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {storefront.cta} ↗
                    <span class="sr-only"> (opens in a new tab)</span>
                  </Button>
                ) : (
                  <p class="font-mono text-xs leading-relaxed text-base-500">
                    A storefront link will appear after the seller destination is verified.
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  <section aria-labelledby="shop-secondary-heading" class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-16">
        <Text id="shop-secondary-heading" tag="h2" variant="displaySM" class="font-display text-white">
          Looking for something else?
        </Text>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          <article class="border border-base-800 bg-base-900/30 p-6">
            <Text tag="h3" variant="displayXS" class="font-display text-white">How it was made</Text>
            <Text tag="p" variant="textSM" class="mt-3 leading-relaxed text-base-400">
              Follow the source, production system, and finished destination behind selected HobFarm work.
            </Text>
            <Button isLink size="sm" variant="muted" href="/workshop/projects/" class="mt-5">Browse Workshop Projects</Button>
          </article>
          <article class="border border-base-800 bg-base-900/30 p-6">
            <Text tag="h3" variant="displayXS" class="font-display text-white">Academy</Text>
            <Text tag="p" variant="textSM" class="mt-3 leading-relaxed text-base-400">
              Learn the methods behind the work.
            </Text>
            <Button isLink size="sm" variant="muted" href="/academy/" class="mt-5">Browse Academy</Button>
          </article>
          <article class="border border-base-800 bg-base-900/30 p-6">
            <Text tag="h3" variant="displayXS" class="font-display text-white">Support HobFarm</Text>
            <Text tag="p" variant="textSM" class="mt-3 leading-relaxed text-base-400">
              Fund the next article, experiment, or release.
            </Text>
            <Button isLink size="sm" variant="muted" href="/support/" class="mt-5">See support options</Button>
          </article>
        </div>
      </Wrapper>
    </ContentPanel>
  </section>

  <section aria-labelledby="shop-help-heading" class="border-t border-base-800/50">
    <ContentPanel>
      <Wrapper variant="standard" class="py-12 lg:py-20">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
          <div class="max-w-2xl">
            <Text id="shop-help-heading" tag="h2" variant="displaySM" class="font-display text-white">
              Need help with an order?
            </Text>
            <Text tag="p" variant="textBase" class="mt-4 text-pretty leading-relaxed text-base-400">
              Customer Help handles order, download, account, refund, and marketplace questions.
            </Text>
          </div>
          <Button isLink size="sm" variant="green" href="/helpcenter/">Customer Help</Button>
        </div>
      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>
