---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import SupportWays from "@/components/support/SupportWays.astro";
import { platformInfo } from "@/data/product-platforms";
import { previewImageUrl, mediaImageSrcset } from "@/lib/gallery";
import { getPublicProducts, isBuyable, productPath, type ProductEntry } from "@/lib/products";

export async function getStaticPaths() {
  const products = await getPublicProducts();
  return products.map((product) => ({
    params: { slug: product.id.replace(/\.(md|mdx)$/, "") },
    props: { product },
  }));
}

interface Props {
  product: ProductEntry;
}

const { product } = Astro.props;
const { Content } = await render(product);
const { data } = product;
const platform = platformInfo[data.platform];
const buyable = isBuyable(product);
const preview = previewImageUrl(data.previewImage.folder, data.previewImage.file);
const previewSrcset = mediaImageSrcset(
  data.previewImage.folder,
  data.previewImage.file,
  [480, 720, 960, 1280],
  { quality: 84, fit: "cover" },
);
const canonical = productPath(product);
const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `${siteOrigin}${canonical}#product`,
  name: data.title,
  description: data.shortDescription,
  image: preview,
  category: data.productType,
  sku: data.sku,
  brand: { "@type": "Brand", name: "HobFarm" },
  ...(buyable && data.externalUrl
    ? {
        offers: {
          "@type": "Offer",
          url: data.externalUrl,
          availability: "https://schema.org/InStock",
        },
      }
    : {}),
};
---

<BaseLayout
  title={`${data.title} | HobFarm Shop`}
  description={data.shortDescription}
  canonical={canonical}
  image={preview}
  imageAlt={data.previewImage.alt}
  structuredData={structuredData}
>
  <section class="product-page">
    <ContentPanel>
      <Wrapper variant="standard" class="py-10 lg:py-20">
        <a href="/shop/" class="product-page__back">&larr; Back to the shop</a>

        <div class="product-hero">
          <div class="product-hero__media">
            <img
              src={preview}
              srcset={previewSrcset}
              sizes="(min-width: 900px) 50vw, 100vw"
              alt={data.previewImage.alt}
              width="960"
              height="1200"
              decoding="async"
              fetchpriority="high"
            />
          </div>

          <div class="product-hero__copy">
            <p class="product-page__platform" style={`--platform:${platform.color}`}>
              {platform.label} / {data.productType.replaceAll("-", " ")}
            </p>
            <h1>{data.title}</h1>
            <p class="product-page__lede">{data.shortDescription}</p>

            {data.priceLabel && <p class="product-page__price">{data.priceLabel}</p>}

            {data.includedItems.length > 0 && (
              <div class="product-page__includes">
                <h2>Included</h2>
                <ul>{data.includedItems.map((item) => <li>{item}</li>)}</ul>
              </div>
            )}

            {data.variants.length > 0 && (
              <div class="product-page__includes">
                <h2>Available versions</h2>
                <ul>
                  {data.variants.filter((variant) => variant.available).map((variant) => (
                    <li>{variant.name}{variant.priceLabel ? ` — ${variant.priceLabel}` : ""}</li>
                  ))}
                </ul>
              </div>
            )}

            {buyable ? (
              <a
                class="product-page__buy"
                href={data.externalUrl}
                target="_blank"
                rel="noopener noreferrer"
                style={`--platform:${platform.color}`}
              >
                {platform.ctaLabel} &nearr;
              </a>
            ) : (
              <span class="product-page__unavailable">
                {data.status === "sold-out" ? "Sold out" : "Drop coming soon"}
              </span>
            )}
          </div>
        </div>

        <div class="product-body prose prose-invert prose-base max-w-3xl">
          <Content />
        </div>

        {data.relatedContent.length > 0 && (
          <section class="product-related">
            <h2>Related HobFarm work</h2>
            <div>
              {data.relatedContent.map((item) => <a href={item.href}>{item.label} &rarr;</a>)}
            </div>
          </section>
        )}

        <div class="product-support">
          <SupportWays
            compact
            heading="Not ready to buy? Follow the work"
            description="Join HobFarm, support a release on Ko-fi, or follow the separate Patreon community."
          />
        </div>
      </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>

<style>
  .product-page { background: #07060b; }
  .product-page__back { color: #9b96ad; font-family: var(--font-mono); font-size: .7rem; letter-spacing: .1em; text-decoration: none; text-transform: uppercase; }
  .product-page__back:hover { color: #fff; }
  .product-hero { display: grid; overflow: hidden; margin-top: 1.5rem; border: 1px solid #2c2440; background: #0e0b16; }
  .product-hero__media { min-height: 30rem; background: #07060b; }
  .product-hero__media img { width: 100%; height: 100%; object-fit: cover; }
  .product-hero__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(1.5rem, 5vw, 4rem); }
  .product-page__platform { margin: 0; color: var(--platform); font-family: var(--font-mono); font-size: .68rem; letter-spacing: .15em; text-transform: uppercase; }
  .product-hero h1 { margin: .75rem 0 0; color: #ece9f5; font-family: var(--font-display); font-size: clamp(2.4rem, 6vw, 5.2rem); font-weight: 780; letter-spacing: -.06em; line-height: .92; }
  .product-page__lede { margin: 1.3rem 0 0; color: #c8c6d4; line-height: 1.7; }
  .product-page__price { margin: 1rem 0 0; color: #f0c96b; font-family: var(--font-mono); font-size: 1rem; }
  .product-page__includes { margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px solid #2c2440; }
  .product-page__includes h2 { margin: 0; color: #ece9f5; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; }
  .product-page__includes ul { margin: .8rem 0 0; padding-left: 1.2rem; color: #9b96ad; font-size: .86rem; line-height: 1.7; }
  .product-page__buy, .product-page__unavailable { display: inline-flex; width: fit-content; margin-top: 1.8rem; padding: .85rem 1rem; border: 1px solid var(--platform, #433559); color: #ece9f5; font-family: var(--font-mono); font-size: .7rem; letter-spacing: .1em; text-decoration: none; text-transform: uppercase; }
  .product-page__buy:hover { background: color-mix(in srgb, var(--platform) 18%, transparent); }
  .product-page__unavailable { --platform: #433559; color: #6b6580; }
  .product-body { margin-top: clamp(3rem, 7vw, 6rem); color: #c8c6d4; }
  .product-related { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid #2c2440; }
  .product-related h2 { color: #ece9f5; font-family: var(--font-display); font-size: 1.8rem; }
  .product-related > div { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1rem; }
  .product-related a { padding: .7rem .9rem; border: 1px solid #2c2440; color: #c8c6d4; font-family: var(--font-mono); font-size: .68rem; text-decoration: none; text-transform: uppercase; }
  .product-related a:hover { border-color: #ece9f5; color: #fff; }
  .product-support { margin-top: 4rem; }
  @media (min-width: 900px) { .product-hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
</style>
