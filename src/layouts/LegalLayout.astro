---
// Fundations
import BaseLayout from "./BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import SupportEmailLink from "@/components/support/SupportEmailLink.astro";
const { frontmatter, slug } = Astro.props;
const description = frontmatter.description || "Legal policies for HobFarm products, accounts, payments, privacy, refunds, and support.";
const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const canonicalPath = `/legal/${slug}/`;
const legalJsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: frontmatter.title,
  description,
  url: `${siteOrigin}${canonicalPath}`,
  datePublished: frontmatter.publishedAt ? new Date(frontmatter.publishedAt).toISOString() : undefined,
  dateModified: frontmatter.updatedAt
    ? new Date(frontmatter.updatedAt).toISOString()
    : frontmatter.publishedAt
      ? new Date(frontmatter.publishedAt).toISOString()
      : undefined,
  publisher: {
    "@type": "Organization",
    name: "HobFarm",
    url: siteOrigin,
  },
};
---

<BaseLayout
  title={`${frontmatter.title} | HobFarm`}
  description={description}
  canonical={canonicalPath}
  structuredData={legalJsonLd}
>
  <section>
    <ContentPanel>
    <Wrapper variant="standard" class="py-12 lg:py-20">
      {/* Header */}
      <div class="max-w-3xl mx-auto mb-12">
        <Text
          tag="h1"
          variant="display2XL"
          class="text-white font-display"
        >
          {frontmatter.title}
        </Text>
        {frontmatter.publishedAt && (
          <Text tag="span" variant="textSM" class="text-base-500 mt-4 block">
            Last updated <time
              datetime={new Date(frontmatter.publishedAt).toISOString().slice(0, 10)}
            >
              {
                new Date(frontmatter.publishedAt).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                  timeZone: "UTC",
                })
              }</time
            >
          </Text>
        )}
      </div>

      {/* Content */}
      <div class="max-w-3xl mx-auto">
        <Wrapper variant="prose"><slot /></Wrapper>
      </div>

      {/* Contact CTA */}
      <div class="max-w-3xl mx-auto mt-12 pt-8 border-t border-base-800">
        <p class="mb-4 text-xs text-base-500">Questions about these terms, billing, an order, or your data</p>
        <SupportEmailLink id="legal-support-email" label="Email Customer Help" subject={`HobFarm: ${frontmatter.title}`} />
      </div>
    </Wrapper>
    </ContentPanel>
  </section>
</BaseLayout>
