---
// Fundations
import "../styles/global.css";
import BaseHead from "@/components/fundations/head/BaseHead.astro"; // Assets
import BottomBlurLine from "@/components/assets/BottomBlurLine.astro";
// Components
import Search from "@/components/global/Search.astro";
// Sections
import Footer from "@/components/global/Footer.astro";
import Navigation from "@/components/global/Navigation.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  structuredData?: Record<string, unknown>;
  palette?: "purple-green" | "magenta-cyan" | "blue-red";
  /** Keep this page out of search engines (e.g. planned/empty landing pages). */
  noindex?: boolean;
  feed?: {
    href: string;
    title: string;
  };
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  type,
  publishedTime,
  modifiedTime,
  tags,
  structuredData,
  palette = "purple-green",
  noindex = false,
  feed = {
    href: "/rss.xml",
    title: "HobFarm Articles",
  },
} = Astro.props;
---

<html
  lang="en"
  class="selection:text-white selection:bg-base-500 scroll-smooth"
>
  <head>
    <BaseHead
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      imageAlt={imageAlt}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      structuredData={structuredData}
      noindex={noindex}
    />
    {feed && <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />}
  </head>
  <body class="bg-base-950 flex flex-col min-h-svh" data-palette={palette}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Search />
    <Navigation />
    <main id="main-content" tabindex="-1" class="grow relative z-10 pt-20"><slot /></main>
    <Footer />
    <BottomBlurLine />
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2147483647;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    border: 0;
    white-space: nowrap;
  }

  .skip-link:focus-visible {
    width: auto;
    height: auto;
    padding: 0.8rem 1rem;
    overflow: visible;
    clip-path: none;
    border: 1px solid #dfff36;
    border-radius: 0.45rem;
    outline: 3px solid #5cf0f0;
    outline-offset: 3px;
    background: #0e0b16;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }
</style>
