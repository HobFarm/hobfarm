---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Breadcrumbs from "@/components/global/Breadcrumbs.astro";

interface Props {
  title: string;
  description: string;
  active: "terms" | "privacy" | "refunds" | "license";
}

const { title, description, active } = Astro.props;
const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const path = `/ezize/${active}/`;
const canonical = new URL(path, siteOrigin).toString();
const pages = [
  { slug: "terms", label: "Terms" },
  { slug: "privacy", label: "Privacy" },
  { slug: "refunds", label: "Refunds" },
  { slug: "license", label: "Output license" },
];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `${title} | EZIZE`,
  description,
  url: canonical,
  isPartOf: { "@type": "WebSite", name: "HobFarm", url: `${siteOrigin}/` },
  publisher: { "@type": "Organization", name: "HobFarm", url: `${siteOrigin}/` },
};
---

<BaseLayout title={`${title} | EZIZE`} description={description} canonical={canonical} structuredData={structuredData}>
  <div class="ezize-legal">
    <Wrapper class="crumb-wrap">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "EZIZE", href: "/ezize/" }, { label: title }]} />
    </Wrapper>
    <Wrapper class="legal-shell">
      <header>
        <p class="eyebrow">EZIZE legal</p>
        <h1>{title}</h1>
        <p>{description}</p>
        <span>Last updated August 15, 2026</span>
      </header>
      <nav aria-label="EZIZE legal pages">
        {pages.map((page) => (
          <a href={`/ezize/${page.slug}/`} aria-current={page.slug === active ? "page" : undefined}>{page.label}</a>
        ))}
      </nav>
      <article class="legal-copy">
        <slot />
      </article>
      <footer>
        <div><strong>Questions about these terms?</strong><p>Use HobFarm's contact page for account, billing, privacy, or licensing questions.</p></div>
        <div class="footer-actions"><a href="/contact/">Contact HobFarm</a><a href="https://ezize.hob.farm/">Open EZIZE</a></div>
      </footer>
    </Wrapper>
  </div>
</BaseLayout>

<style>
  :global(body) { background: #0b0b08; }
  .ezize-legal { --ink: #0b0b08; --paper: #f5f1de; --lime: #dfff36; --orange: #ff684d; color: var(--paper); }
  .crumb-wrap { padding-top: 1rem; padding-bottom: 1rem; }
  .legal-shell { padding-bottom: 7rem; }
  header { padding: clamp(3rem, 7vw, 7rem); border: 1px solid rgba(245,241,222,.18); background: radial-gradient(circle at 90% 20%, rgba(121,226,221,.16), transparent 28%), #071a31; }
  .eyebrow { margin: 0 0 .9rem; color: var(--lime); font: 700 .7rem/1.2 var(--font-mono); letter-spacing: .13em; text-transform: uppercase; }
  h1 { margin: 0; color: #fff; font: 800 clamp(3rem,8vw,7rem)/.88 var(--font-display); letter-spacing: -.06em; }
  header > p:not(.eyebrow) { max-width: 48rem; margin: 1.5rem 0 0; color: rgba(255,255,255,.72); font-size: 1.08rem; line-height: 1.7; }
  header > span { display: block; margin-top: 1.5rem; color: var(--orange); font: 700 .65rem/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  nav { display: grid; grid-template-columns: repeat(4,1fr); border-right: 1px solid rgba(245,241,222,.18); border-bottom: 1px solid rgba(245,241,222,.18); border-left: 1px solid rgba(245,241,222,.18); }
  nav a { padding: 1rem; border-right: 1px solid rgba(245,241,222,.18); color: rgba(255,255,255,.68); font: 700 .67rem/1.3 var(--font-mono); letter-spacing: .06em; text-align: center; text-decoration: none; text-transform: uppercase; }
  nav a:last-child { border-right: 0; }
  nav a:hover, nav a:focus-visible, nav a[aria-current="page"] { background: var(--lime); color: var(--ink); }
  .legal-copy { max-width: 52rem; margin: 0 auto; padding: clamp(3rem,7vw,7rem) 0; }
  .legal-copy :global(h2) { margin: 3.5rem 0 1rem; color: #fff; font: 700 clamp(1.7rem,3vw,2.6rem)/1.05 var(--font-display); letter-spacing: -.025em; }
  .legal-copy :global(h2:first-child) { margin-top: 0; }
  .legal-copy :global(h3) { margin: 2rem 0 .65rem; color: #fff; font: 700 1.15rem/1.2 var(--font-display); }
  .legal-copy :global(p), .legal-copy :global(li) { color: rgba(245,241,222,.72); font-size: .96rem; line-height: 1.78; }
  .legal-copy :global(ul) { padding-left: 1.25rem; }
  .legal-copy :global(li + li) { margin-top: .35rem; }
  .legal-copy :global(a) { color: #fff; text-underline-offset: .22em; }
  .legal-copy :global(strong) { color: #fff; }
  .legal-copy :global(.plain-summary) { margin: 0 0 3rem; padding: 1.4rem; border: 2px solid var(--ink); background: var(--lime); color: var(--ink); box-shadow: .4rem .4rem 0 var(--orange); font-weight: 700; }
  .legal-copy :global(.plain-summary strong) { color: var(--ink); }
  footer { display: flex; justify-content: space-between; gap: 2rem; align-items: center; padding: 2rem; border: 1px solid rgba(245,241,222,.18); background: #12120f; }
  footer strong { color: #fff; font: 700 1.3rem/1.1 var(--font-display); }
  footer p { margin: .45rem 0 0; color: rgba(245,241,222,.6); font-size: .84rem; }
  .footer-actions { display: flex; gap: .7rem; }
  .footer-actions a { padding: .8rem 1rem; border: 1px solid rgba(245,241,222,.3); color: #fff; font: 700 .65rem/1 var(--font-mono); text-decoration: none; text-transform: uppercase; }
  .footer-actions a:last-child { border-color: var(--lime); background: var(--lime); color: var(--ink); }
  @media (max-width: 720px) {
    nav { grid-template-columns: 1fr 1fr; }
    nav a:nth-child(2) { border-right: 0; }
    nav a:nth-child(-n+2) { border-bottom: 1px solid rgba(245,241,222,.18); }
    .legal-copy { padding-right: .25rem; padding-left: .25rem; }
    footer { align-items: stretch; flex-direction: column; }
    .footer-actions { flex-direction: column; }
  }
</style>
