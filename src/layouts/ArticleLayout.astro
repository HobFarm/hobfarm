---
import type { Article } from "@/lib/articles";
import {
  articlePath,
  articleTagPath,
  getArticleDate,
  getArticleDek,
  getArticleDepartment,
  getArticleDepartmentLabel,
  getArticleDescription,
  getArticleHero,
  getArticleImage,
  getArticleUpdatedDate,
  getPublishedArticles,
  getRelatedArticles,
} from "@/lib/articles";
import { departmentPath } from "@/data/departments";
import BaseLayout from "./BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import ShareButtons from "@/components/articles/ShareButtons.astro";
import ArticleCard from "@/components/articles/ArticleCard.astro";
import Lightbox from "@/components/gallery/Lightbox";
import Breadcrumbs from "@/components/global/Breadcrumbs.astro";

interface Props {
  article: Article;
  readingTime: string;
  previous: Article | null;
  next: Article | null;
}

const { article, readingTime, previous, next } = Astro.props;
const frontmatter = article.data;

const publishedAt = getArticleDate(article);
const updatedAt = getArticleUpdatedDate(article);
const description = getArticleDescription(frontmatter);
const dek = getArticleDek(frontmatter);
const hero = getArticleHero(frontmatter);
const seoImage = getArticleImage(frontmatter);
const departmentLabel = getArticleDepartmentLabel(frontmatter);
const department = getArticleDepartment(frontmatter);
const departmentHref = department === "magazine-time-machine"
  ? "/departments/magazine-time-machine/"
  : department === "workshop-notes"
    ? "/workshop/workshop-notes/"
    : department ? departmentPath(department) : undefined;
const formattedDate = publishedAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "2-digit",
  timeZone: "UTC",
});

const siteOrigin = Astro.site?.origin ?? "https://hob.farm";
const toAbsoluteUrl = (value: string) => new URL(value, siteOrigin).toString();
const canonicalPath = frontmatter.canonical ?? `${articlePath(article)}/`;
const canonicalUrl = toAbsoluteUrl(canonicalPath);

const cdnImageBase = "https://cdn.hob.farm/";

const getCdnImageVariant = (src: string, width: number) => {
  if (!src.startsWith(cdnImageBase) || src.includes("/cdn-cgi/image/")) return src;

  return src.replace(
    cdnImageBase,
    `${cdnImageBase}cdn-cgi/image/format=auto,quality=82,width=${width}/`
  );
};

const getCdnImageSrcset = (src: string, widths: number[]) => {
  if (!src.startsWith(cdnImageBase)) return undefined;

  return widths
    .map((width) => `${getCdnImageVariant(src, width)} ${width}w`)
    .join(", ");
};

const heroSrc = hero ? getCdnImageVariant(hero, 1280) : undefined;
const heroSrcset = hero ? getCdnImageSrcset(hero, [640, 960, 1280, 1600]) : undefined;

const allArticles = await getPublishedArticles();
const relatedArticles = getRelatedArticles(article, allArticles, 4);

const relatedLinks = [
  frontmatter.relatedGallery && {
    label: "Related visual",
    href: frontmatter.relatedGallery,
  },
  frontmatter.relatedProject && {
    label: "Related project",
    href: frontmatter.relatedProject,
  },
  frontmatter.relatedVideo && {
    label: "Related video",
    href: frontmatter.relatedVideo,
  },
].filter((link): link is { label: string; href: string } => Boolean(link));

const contextualCtas = [
  frontmatter.workshopCTA,
  frontmatter.academyCTA,
  frontmatter.supportCTA,
].filter((link): link is { label: string; href: string } => Boolean(link));

if (contextualCtas.length === 0) {
  if (department === "workshop-notes") {
    contextualCtas.push({ label: "Learn the workflow", href: "/academy/" });
  } else if (department === "magazine-time-machine") {
    contextualCtas.push({ label: "Support the magazine", href: "/support/" });
  }
}

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: frontmatter.title,
  description,
  image: seoImage ? [toAbsoluteUrl(seoImage)] : undefined,
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: {
    "@type": "Person",
    name: frontmatter.author,
  },
  publisher: {
    "@type": "Organization",
    name: "HobFarm",
    logo: {
      "@type": "ImageObject",
      url: `${siteOrigin}/favicon.svg`,
    },
  },
  mainEntityOfPage: canonicalUrl,
  keywords: frontmatter.tags,
};
---

<BaseLayout
  title={`${frontmatter.title} | HobFarm Articles`}
  description={description}
  canonical={canonicalUrl}
  image={seoImage}
  imageAlt={frontmatter.heroAlt || frontmatter.title}
  type="article"
  publishedTime={publishedAt.toISOString()}
  modifiedTime={(updatedAt ?? publishedAt).toISOString()}
  tags={frontmatter.tags}
  structuredData={articleJsonLd}
>
  <section>
    <ContentPanel>
      <Wrapper variant="standard" class="pt-5">
        <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Articles", href: "/articles/" }, { label: frontmatter.title }]} />
      </Wrapper>
      {hero && (
        <div class="relative overflow-hidden rounded-t-lg aspect-[4/3] sm:aspect-21/9">
          <img
            src={heroSrc}
            srcset={heroSrcset}
            sizes="(min-width: 1024px) 1024px, 100vw"
            alt={frontmatter.heroAlt || frontmatter.title}
            class="absolute inset-0 size-full object-cover object-top"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-base-950 via-base-950/80 to-base-950/20" />
          <div class="relative z-10 flex flex-col justify-end h-full p-6 sm:p-8 lg:p-12">
            <div class="flex flex-wrap items-center gap-3 text-xs uppercase text-base-400">
              <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
              <span>&middot;</span>
              <span>{readingTime}</span>
              {department && (
                <>
                  <span>&middot;</span>
                  <a
                    href={departmentHref}
                    class="font-mono text-accent-cyan hover:text-base-100 transition-colors"
                  >
                    {departmentLabel}
                  </a>
                </>
              )}
            </div>
            <h1 class="mt-3 sm:mt-4 text-2xl sm:text-3xl lg:text-4xl font-light tracking-tight text-base-100 text-balance">
              {frontmatter.title}
            </h1>
            <p class="mt-2 sm:mt-3 text-sm sm:text-base text-base-300 max-w-2xl text-balance">
              {dek}
            </p>
          </div>
        </div>
      )}

      {!hero && (
        <Wrapper variant="narrow" class="pt-12 lg:pt-16">
          <div class="flex flex-wrap items-center gap-3 text-xs uppercase text-base-400">
            <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
            <span>&middot;</span>
            <span>{readingTime}</span>
            <span>&middot;</span>
            <span class="font-mono text-accent-cyan">{departmentLabel}</span>
          </div>
          <h1 class="mt-4 text-3xl lg:text-4xl font-light tracking-tight text-base-100 text-balance">
            {frontmatter.title}
          </h1>
          <p class="mt-3 text-base text-base-300 max-w-2xl text-balance">
            {dek}
          </p>
        </Wrapper>
      )}

      <Wrapper variant="narrow" class="mt-6">
        <div class="flex flex-wrap gap-2">
          {frontmatter.series && (
            <span class="text-xs font-mono px-2 py-1 border border-accent-cyan/40 text-accent-cyan capitalize">
              {frontmatter.series}
            </span>
          )}
          {frontmatter.tags.map((tag: string) => (
            <a
              href={articleTagPath(tag)}
              class="text-xs font-mono px-2 py-1 border border-base-700 text-base-400 hover:text-base-100 hover:border-base-500 transition-colors capitalize"
            >
              {tag}
            </a>
          ))}
        </div>
      </Wrapper>

      <Wrapper variant="narrow" class="mt-8">
        <div class="border-y border-base-800 py-4">
          <p class="text-xs uppercase tracking-wider text-base-500 mb-3">Share this article</p>
          <ShareButtons title={frontmatter.title} text={description} url={canonicalUrl} tags={frontmatter.tags} />
        </div>
      </Wrapper>

      <Wrapper variant="narrow" class="mt-12">
        <Wrapper variant="prose">
          <slot />
        </Wrapper>
      </Wrapper>

      {(relatedLinks.length > 0 || contextualCtas.length > 0) && (
        <Wrapper variant="narrow" class="mt-12">
          <div class="grid grid-cols-1 gap-3 border border-base-800 bg-base-950/60 p-4 sm:grid-cols-2">
            {relatedLinks.map((link) => (
              <a
                href={link.href}
                class="rounded-md border border-base-800 bg-base-900/70 px-4 py-3 text-sm text-base-200 transition-colors hover:border-accent-cyan/50 hover:text-white"
              >
                <span class="block font-mono text-[10px] uppercase tracking-wider text-accent-cyan">Related</span>
                <span class="mt-1 block">{link.label}</span>
              </a>
            ))}
            {contextualCtas.map((link) => (
              <a
                href={link.href}
                class="rounded-md border border-base-800 bg-base-900/70 px-4 py-3 text-sm text-base-200 transition-colors hover:border-accent-magenta/50 hover:text-white"
              >
                <span class="block font-mono text-[10px] uppercase tracking-wider text-accent-magenta-bright">Next</span>
                <span class="mt-1 block">{link.label}</span>
              </a>
            ))}
          </div>
        </Wrapper>
      )}

      <Wrapper variant="narrow" class="mt-12">
        <div class="border-t border-base-700 pt-6">
          <p class="text-xs uppercase tracking-wider text-base-500 mb-3">Share this article</p>
          <ShareButtons title={frontmatter.title} text={description} url={canonicalUrl} tags={frontmatter.tags} />
        </div>
      </Wrapper>

      {(previous || next) && (
        <Wrapper variant="narrow" class="mt-12">
          <div class="border-t border-base-700 pt-8 grid grid-cols-2 gap-8">
            {previous ? (
              <a
                href={articlePath(previous)}
                class="group flex items-start gap-3 text-base-400 hover:text-base-100 transition-colors"
              >
                <svg class="size-5 mt-0.5 shrink-0 rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
                <div>
                  <p class="text-xs uppercase text-base-500">Previous</p>
                  <p class="text-sm mt-1 font-light">{previous.data.title}</p>
                </div>
              </a>
            ) : <div />}
            {next ? (
              <a
                href={articlePath(next)}
                class="group flex items-start gap-3 text-right text-base-400 hover:text-base-100 transition-colors ml-auto"
              >
                <div>
                  <p class="text-xs uppercase text-base-500">Next</p>
                  <p class="text-sm mt-1 font-light">{next.data.title}</p>
                </div>
                <svg class="size-5 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            ) : <div />}
          </div>
        </Wrapper>
      )}

      {relatedArticles.length > 0 && (
        <Wrapper variant="standard" class="mt-16 pb-12">
          <div class="border-t border-base-700 pt-8">
            <h2 class="text-xl font-light text-base-100">Related articles</h2>
            <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-12">
              {relatedArticles.map((post) => <ArticleCard post={post} />)}
            </div>
          </div>
        </Wrapper>
      )}
    </ContentPanel>
  </section>

  <Lightbox client:only="react" />

  <style is:global>
    .prose {
      overflow: visible !important;
    }
    .article-wide {
      position: relative !important;
      left: 50% !important;
      transform: translateX(-50%) !important;
      width: 42rem !important;
      max-width: 90vw !important;
      scroll-margin-top: 5rem;
    }
    .article-wide img,
    .article-wide video,
    .article-wide iframe {
      width: 100% !important;
      border-radius: 0.25rem;
    }
    .article-wide img,
    .article-wide video {
      height: auto !important;
    }
    .article-wide.article-compact {
      width: 28rem !important;
      max-width: 82vw !important;
    }
    .article-grid {
      position: relative !important;
      left: 50% !important;
      transform: translateX(-50%) !important;
      width: 42rem !important;
      max-width: 90vw !important;
      scroll-margin-top: 5rem;
      display: grid !important;
      align-items: start;
      gap: 0.5rem;
      grid-template-columns: repeat(2, 1fr);
      margin: 1.5rem auto;
    }
    .article-stack {
      position: relative !important;
      left: 50% !important;
      transform: translateX(-50%) !important;
      width: 36rem !important;
      max-width: 90vw !important;
      scroll-margin-top: 5rem;
      display: flex !important;
      flex-direction: column;
      gap: 0.75rem;
      margin: 1.5rem auto;
    }
    .article-stack img {
      width: 100% !important;
      height: auto !important;
      margin: 0 !important;
      border-radius: 0.25rem;
    }
    .article-sidecar {
      position: relative !important;
      left: 50% !important;
      transform: translateX(-50%) !important;
      width: 46rem !important;
      max-width: 90vw !important;
      scroll-margin-top: 5rem;
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) minmax(12rem, 16rem);
      align-items: center;
      gap: clamp(1rem, 3vw, 1.5rem);
      margin: 1.75rem auto;
    }
    .article-sidecar-copy p {
      margin: 0 !important;
    }
    .article-sidecar-media {
      width: 100% !important;
      max-width: 16rem !important;
      margin: 0 auto !important;
    }
    .article-sidecar-media img {
      width: 100% !important;
      height: auto !important;
      margin: 0 !important;
      border-radius: 0.25rem;
    }
    @media (max-width: 719px) {
      .article-sidecar {
        width: 32rem !important;
        grid-template-columns: 1fr;
        justify-items: center;
      }
      .article-sidecar-media {
        max-width: 18rem !important;
      }
    }
    .article-grid.cols-3,
    .article-grid.cols-4 {
      grid-template-columns: repeat(2, 1fr);
    }
    .article-grid.cols-5 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    @media (min-width: 640px) {
      .article-grid.cols-3 {
        grid-template-columns: repeat(3, 1fr);
      }
      .article-grid.cols-4 {
        grid-template-columns: repeat(4, 1fr);
      }
      .article-grid.cols-5 {
        grid-template-columns: repeat(5, minmax(0, 1fr));
      }
    }
    .article-grid.masonry {
      display: block !important;
      column-count: 2;
      column-gap: 0.5rem;
    }
    @media (min-width: 640px) {
      .article-grid.masonry {
        column-count: 4;
      }
    }
    .article-grid.masonry img {
      display: block !important;
      break-inside: avoid;
      margin-bottom: 0.5rem !important;
    }
    .article-grid img {
      width: 100% !important;
      height: auto !important;
      margin: 0 !important;
      border-radius: 0.25rem;
    }
    img[data-lightbox] {
      cursor: zoom-in;
    }
    .article-grid-caption {
      display: block;
      position: relative;
      left: 50%;
      transform: translateX(-50%);
      width: 42rem;
      max-width: 90vw;
      margin: 0.5rem auto 1.5rem;
      font-size: 0.8125rem;
      line-height: 1.5;
      color: var(--color-base-400, #a0a0a0);
      font-family: "IBM Plex Mono", monospace;
      text-align: center;
    }
    .prose figure,
    article figure {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      text-align: center !important;
      margin-left: auto !important;
      margin-right: auto !important;
    }
    .prose img,
    article figure img {
      display: block !important;
      margin-left: auto !important;
      margin-right: auto !important;
      max-width: 100% !important;
    }
    .prose figcaption,
    article figcaption {
      margin-top: 0.5rem;
      font-size: 0.8125rem;
      line-height: 1.5;
      color: var(--color-base-400, #a0a0a0);
      font-family: "IBM Plex Mono", monospace;
      text-align: center !important;
      width: 100%;
    }
    .prose video,
    article video {
      display: block !important;
      width: 100% !important;
      height: auto !important;
      border-radius: 0.25rem;
      margin-left: auto !important;
      margin-right: auto !important;
    }
    .article-embed {
      margin: 1.75rem auto !important;
      gap: 0.5rem;
    }
    .article-embed iframe {
      display: block !important;
      max-width: 100% !important;
      border: 0 !important;
      background: #111;
    }
    .article-embed--spotify iframe {
      min-height: 152px;
      border-radius: 0.75rem;
    }
    .article-embed--spotify-album iframe {
      min-height: 352px;
    }
    .article-embed--youtube .article-embed-frame {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      border-radius: 0.5rem;
      background: #111;
    }
    .article-embed--youtube iframe {
      position: absolute;
      inset: 0;
      width: 100% !important;
      height: 100% !important;
      border-radius: 0.5rem;
    }
    .article-media-stack {
      position: relative !important;
      left: 50% !important;
      transform: translateX(-50%) !important;
      width: 42rem !important;
      max-width: 90vw !important;
      display: grid !important;
      gap: 1rem;
      margin: 2rem auto !important;
    }
    .article-media-stack figure {
      margin: 0 !important;
    }
    .article-connection-map,
    .article-source-list {
      position: relative !important;
      left: 50% !important;
      transform: translateX(-50%) !important;
      width: 42rem !important;
      max-width: 90vw !important;
      margin: 2rem auto !important;
      border: 1px solid color-mix(in srgb, currentColor 16%, transparent);
      border-radius: 0.5rem;
      background: color-mix(in srgb, var(--color-base-900, #0e0b16) 72%, transparent);
      padding: 1rem;
    }
    .article-connection-map h2 {
      margin-top: 0 !important;
      font-size: 0.9rem !important;
      font-family: var(--font-mono);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .article-connection-map ol,
    .article-source-list ul {
      margin-bottom: 0 !important;
      padding-left: 1.25rem !important;
    }
    .article-connection-map li,
    .article-source-list li {
      margin: 0.45rem 0 !important;
    }
  </style>
</BaseLayout>
