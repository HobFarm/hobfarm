---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ContentPanel from "@/components/ContentPanel.astro";
import ShareButtons from "@/components/blog/ShareButtons.astro";
import ArticleCard from "@/components/blog/ArticleCard.astro";
import Lightbox from "@/components/gallery/Lightbox";

interface Props {
  frontmatter: CollectionEntry<"blog">["data"];
  readingTime: string;
  id: string;
  previous: CollectionEntry<"blog"> | null;
  next: CollectionEntry<"blog"> | null;
}

const { frontmatter, readingTime, id, previous, next } = Astro.props;

const formattedDate = new Date(frontmatter.publishedAt).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "2-digit",
});

// Related posts: match by tags, exclude current, max 4
const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).filter(
  (p) => p.id !== id
);
const relatedPosts = allPosts
  .filter((p) => p.data.tags.some((t) => frontmatter.tags.includes(t)))
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime())
  .slice(0, 4);

const currentUrl = Astro.url.href;
const cdnImageBase = "https://cdn.hob.farm/";

const getCdnImageVariant = (src: string, width: number) => {
  if (!src.startsWith(cdnImageBase) || src.includes("/cdn-cgi/image/")) return src;

  return src.replace(
    cdnImageBase,
    `${cdnImageBase}cdn-cgi/image/format=auto,quality=82,width=${width}/`
  );
};

const getCdnImageSrcset = (src: string, widths: number[]) => {
  if (!src.startsWith(cdnImageBase)) return undefined;

  return widths
    .map((width) => `${getCdnImageVariant(src, width)} ${width}w`)
    .join(", ");
};

const heroSrc = frontmatter.hero
  ? getCdnImageVariant(frontmatter.hero, 1280)
  : undefined;
const heroSrcset = frontmatter.hero
  ? getCdnImageSrcset(frontmatter.hero, [640, 960, 1280, 1600])
  : undefined;
---

<BaseLayout title={frontmatter.title} description={frontmatter.excerpt} image={frontmatter.hero}>
  <section>
    <ContentPanel>
      {/* Hero */}
      {frontmatter.hero && (
        <div class="relative overflow-hidden rounded-t-lg aspect-[4/3] sm:aspect-21/9">
          <img
            src={heroSrc}
            srcset={heroSrcset}
            sizes="(min-width: 1024px) 1024px, 100vw"
            alt={frontmatter.heroAlt || frontmatter.title}
            class="absolute inset-0 size-full object-cover object-top"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-base-950 via-base-950/80 to-base-950/20" />
          <div class="relative z-10 flex flex-col justify-end h-full p-6 sm:p-8 lg:p-12">
            <div class="flex items-center gap-3 text-xs uppercase text-base-400">
              <time datetime={frontmatter.publishedAt.toISOString()}>{formattedDate}</time>
              <span>&middot;</span>
              <span>{readingTime}</span>
              {frontmatter.category && (
                <>
                  <span>&middot;</span>
                  <a
                    href={`/blog/category/${frontmatter.category}/`}
                    class="font-mono text-accent-500 hover:text-base-100 transition-colors"
                  >
                    {frontmatter.category}
                  </a>
                </>
              )}
            </div>
            <h1 class="mt-3 sm:mt-4 text-2xl sm:text-3xl lg:text-4xl font-light tracking-tight text-base-100 text-balance">
              {frontmatter.title}
            </h1>
            <p class="mt-2 sm:mt-3 text-sm sm:text-base text-base-300 max-w-2xl text-balance">
              {frontmatter.excerpt}
            </p>
          </div>
        </div>
      )}

      {/* No hero fallback */}
      {!frontmatter.hero && (
        <Wrapper variant="narrow" class="pt-12 lg:pt-16">
          <div class="flex items-center gap-3 text-xs uppercase text-base-400">
            <time datetime={frontmatter.publishedAt.toISOString()}>{formattedDate}</time>
            <span>&middot;</span>
            <span>{readingTime}</span>
          </div>
          <h1 class="mt-4 text-3xl lg:text-4xl font-light tracking-tight text-base-100 text-balance">
            {frontmatter.title}
          </h1>
          <p class="mt-3 text-base text-base-300 max-w-2xl text-balance">
            {frontmatter.excerpt}
          </p>
        </Wrapper>
      )}

      {/* Tags */}
      <Wrapper variant="narrow" class="mt-6">
        <div class="flex flex-wrap gap-2">
          {frontmatter.tags.map((tag: string) => (
            <a
              href={`/blog/tags/${tag}`}
              class="text-xs font-mono px-2 py-1 border border-base-700 text-base-400 hover:text-base-100 hover:border-base-500 transition-colors capitalize"
            >
              {tag}
            </a>
          ))}
        </div>
      </Wrapper>

      {/* Article Content */}
      <Wrapper variant="narrow" class="mt-12">
        <Wrapper variant="prose">
          <slot />
        </Wrapper>
      </Wrapper>

      {/* Share */}
      <Wrapper variant="narrow" class="mt-12">
        <div class="border-t border-base-700 pt-6">
          <p class="text-xs uppercase text-base-500 mb-3">Share this article</p>
          <ShareButtons title={frontmatter.title} url={currentUrl} />
        </div>
      </Wrapper>

      {/* Prev / Next */}
      {(previous || next) && (
        <Wrapper variant="narrow" class="mt-12">
          <div class="border-t border-base-700 pt-8 grid grid-cols-2 gap-8">
            {previous ? (
              <a
                href={`/blog/posts/${previous.id}`}
                class="group flex items-start gap-3 text-base-400 hover:text-base-100 transition-colors"
              >
                <svg class="size-5 mt-0.5 shrink-0 rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
                <div>
                  <p class="text-xs uppercase text-base-500">Previous</p>
                  <p class="text-sm mt-1 font-light">{previous.data.title}</p>
                </div>
              </a>
            ) : <div />}
            {next ? (
              <a
                href={`/blog/posts/${next.id}`}
                class="group flex items-start gap-3 text-right text-base-400 hover:text-base-100 transition-colors ml-auto"
              >
                <div>
                  <p class="text-xs uppercase text-base-500">Next</p>
                  <p class="text-sm mt-1 font-light">{next.data.title}</p>
                </div>
                <svg class="size-5 mt-0.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            ) : <div />}
          </div>
        </Wrapper>
      )}

      {/* Related Posts */}
      {relatedPosts.length > 0 && (
        <Wrapper variant="standard" class="mt-16 pb-12">
          <div class="border-t border-base-700 pt-8">
            <h2 class="text-xl font-light text-base-100">Related articles</h2>
            <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-12">
              {relatedPosts.map((post) => <ArticleCard post={post} />)}
            </div>
          </div>
        </Wrapper>
      )}
    </ContentPanel>
  </section>

  <Lightbox client:only="react" />

  <style is:global>
    /* Prose container needs overflow visible for wide breakouts */
    .prose {
      overflow: visible !important;
    }
    /* Wide figures break out of prose max-width */
    .blog-wide {
      position: relative !important;
      left: 50% !important;
      transform: translateX(-50%) !important;
      width: 42rem !important;
      max-width: 90vw !important;
      scroll-margin-top: 5rem;
    }
    .blog-wide img,
    .blog-wide video {
      width: 100% !important;
      height: auto !important;
      border-radius: 0.25rem;
    }
    .blog-wide.blog-compact {
      width: 28rem !important;
      max-width: 82vw !important;
    }
    /* Wide image grids (break out of prose, multi-column). Use a div, not a
       figure, so the figure flex rule below does not override the grid. */
    .blog-grid {
      position: relative !important;
      left: 50% !important;
      transform: translateX(-50%) !important;
      width: 42rem !important;
      max-width: 90vw !important;
      scroll-margin-top: 5rem;
      display: grid !important;
      align-items: start;
      gap: 0.5rem;
      grid-template-columns: repeat(2, 1fr);
      margin: 1.5rem auto;
    }
    .blog-stack {
      position: relative !important;
      left: 50% !important;
      transform: translateX(-50%) !important;
      width: 36rem !important;
      max-width: 90vw !important;
      scroll-margin-top: 5rem;
      display: flex !important;
      flex-direction: column;
      gap: 0.75rem;
      margin: 1.5rem auto;
    }
    .blog-stack img {
      width: 100% !important;
      height: auto !important;
      margin: 0 !important;
      border-radius: 0.25rem;
    }
    .blog-sidecar {
      position: relative !important;
      left: 50% !important;
      transform: translateX(-50%) !important;
      width: 46rem !important;
      max-width: 90vw !important;
      scroll-margin-top: 5rem;
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) minmax(12rem, 16rem);
      align-items: center;
      gap: clamp(1rem, 3vw, 1.5rem);
      margin: 1.75rem auto;
    }
    .blog-sidecar-copy p {
      margin: 0 !important;
    }
    .blog-sidecar-media {
      width: 100% !important;
      max-width: 16rem !important;
      margin: 0 auto !important;
    }
    .blog-sidecar-media img {
      width: 100% !important;
      height: auto !important;
      margin: 0 !important;
      border-radius: 0.25rem;
    }
    @media (max-width: 719px) {
      .blog-sidecar {
        width: 32rem !important;
        grid-template-columns: 1fr;
        justify-items: center;
      }
      .blog-sidecar-media {
        max-width: 18rem !important;
      }
    }
    .blog-grid.cols-3,
    .blog-grid.cols-4 {
      grid-template-columns: repeat(2, 1fr);
    }
    .blog-grid.cols-5 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    @media (min-width: 640px) {
      .blog-grid.cols-3 {
        grid-template-columns: repeat(3, 1fr);
      }
      .blog-grid.cols-4 {
        grid-template-columns: repeat(4, 1fr);
      }
      .blog-grid.cols-5 {
        grid-template-columns: repeat(5, minmax(0, 1fr));
      }
    }
    .blog-grid.masonry {
      display: block !important;
      column-count: 2;
      column-gap: 0.5rem;
    }
    @media (min-width: 640px) {
      .blog-grid.masonry {
        column-count: 4;
      }
    }
    .blog-grid.masonry img {
      display: block !important;
      break-inside: avoid;
      margin-bottom: 0.5rem !important;
    }
    .blog-grid img {
      width: 100% !important;
      height: auto !important;
      margin: 0 !important;
      border-radius: 0.25rem;
    }
    img[data-lightbox] {
      cursor: zoom-in;
    }
    .blog-grid-caption {
      display: block;
      position: relative;
      left: 50%;
      transform: translateX(-50%);
      width: 42rem;
      max-width: 90vw;
      margin: 0.5rem auto 1.5rem;
      font-size: 0.8125rem;
      line-height: 1.5;
      color: var(--color-base-400, #a0a0a0);
      font-family: "IBM Plex Mono", monospace;
      text-align: center;
    }
    /* Center all figures in blog posts */
    .prose figure,
    article figure {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      text-align: center !important;
      margin-left: auto !important;
      margin-right: auto !important;
    }
    /* Center all images inside prose */
    .prose img,
    article figure img {
      display: block !important;
      margin-left: auto !important;
      margin-right: auto !important;
      max-width: 100% !important;
    }
    /* Figcaption styling */
    .prose figcaption,
    article figcaption {
      margin-top: 0.5rem;
      font-size: 0.8125rem;
      line-height: 1.5;
      color: var(--color-base-400, #a0a0a0);
      font-family: "IBM Plex Mono", monospace;
      text-align: center !important;
      width: 100%;
    }
    /* Video styling */
    .prose video,
    article video {
      display: block !important;
      width: 100% !important;
      height: auto !important;
      border-radius: 0.25rem;
      margin-left: auto !important;
      margin-right: auto !important;
    }
  </style>
</BaseLayout>
